 default theme) */\n  --color-accent: #fbbf24;\n  --color-accent-light: #fcd34d;\n  --gradient-accent: linear-gradient(135deg, #fbbf24 0%, #fcd34d 100%);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  font-size: var(--text-base);\n  line-height: 1.5;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}","newString":"/* Arctic Blue Theme — Shared base (backgrounds, borders, text, spacing, fonts, reset) */\n@import \"@the-canonry/shared-components/styles/arctic-theme-base\";\n\n/* Name Forge accent overrides (gold for identity) */\n:root {\n  --accent-color: #fbbf24;\n  --accent-hover: #fcd34d;\n  --gold-accent: #fbbf24;\n  --gold-dark: #f59e0b;\n\n  /* Buttons */\n  --button-primary: #58e;\n  --button-primary-hover: #69f;\n\n  /* Canonical overrides for shared-components (accent differs from default theme) */\n  --color-accent: #fbbf24;\n  --color-accent-light: #fcd34d;\n  --gradient-accent: linear-gradient(135deg, #fbbf24 0%, #fcd34d 100%);\n}","originalFile":"/* Arctic Blue Theme - Name Forge (with Gold accent for identity) */\n:root {\n  /* Backgrounds - Arctic deep blues */\n  --bg-primary: #0a1929;\n  --bg-secondary: #1e3a5f;\n  --bg-tertiary: #2d4a6f;\n  --bg-sidebar: #0c1f2e;\n\n  /* Borders - Blue tinted */\n  --border-color: rgb(59 130 246 / 30%);\n  --border-light: rgb(59 130 246 / 50%);\n\n  /* Text - Ice white tones */\n  --text-color: #fff;\n  --text-secondary: #93c5fd;\n  --text-muted: #60a5fa;\n\n  /* Name Forge accent (gold for identity within arctic theme) */\n  --accent-color: #fbbf24;\n  --accent-hover: #fcd34d;\n\n  /* Arctic theme variables */\n  --arctic-deep: #0a1929;\n  --arctic-dark: #1e3a5f;\n  --arctic-mid: #2d4a6f;\n  --arctic-ice: #3b82f6;\n  --arctic-frost: #60a5fa;\n  --arctic-light: #93c5fd;\n  --gold-accent: #fbbf24;\n  --gold-dark: #f59e0b;\n\n  /* Consistent spacing scale */\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 12px;\n  --space-lg: 16px;\n  --space-xl: 24px;\n\n  /* Consistent font sizes */\n  --text-xs: 11px;\n  --text-sm: 12px;\n  --text-base: 13px;\n  --text-lg: 14px;\n  --text-xl: 16px;\n  --text-2xl: 20px;\n\n  /* Component colors */\n  --card-bg: var(--bg-secondary);\n  --card-border: var(--border-color);\n  --input-bg: var(--bg-tertiary);\n\n  /* Semantic colors - consistent with theme.js */\n  --danger: #ef4444;\n  --success: #22c55e;\n  --warning: #f59e0b;\n\n  /* Buttons */\n  --button-primary: #58e;\n  --button-primary-hover: #69f;\n\n  /* Canonical overrides for shared-components (accent differs from default theme) */\n  --color-accent: #fbbf24;\n  --color-accent-light: #fcd34d;\n  --gradient-accent: linear-gradient(135deg, #fbbf24 0%, #fcd34d 100%);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  font-size: var(--text-base);\n  line-height: 1.5;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n/* App Layout */\n.app {\n  width: 100%;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  background: var(--bg-primary);\n}\n\n/* Header */\n.app-header {\n  position: relative;\n  background: var(--bg-sidebar);\n  padding: var(--space-sm) var(--space-lg);\n  box-shadow: 0 2px 4px rgb(0 0 0 / 20%);\n  border-bottom: 1px solid var(--border-color);\n  flex-shrink: 0;\n  overflow: hidden;\n}\n\n.header-content {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  position: relative;\n}\n\n.header-logo {\n  cursor: pointer;\n  transition:\n    transform 0.2s ease,\n    filter 0.2s ease;\n}\n\n.header-logo:hover {\n  transform: scale(1.02);\n  filter: brightness(1.1);\n}\n\n.logo-image {\n  height: 70px;\n  width: auto;\n  display: block;\n  filter: drop-shadow(0 2px 8px rgb(0 0 0 / 30%));\n\n  /* Soft fade at edges */\n  mask-image:\n    linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%),\n    linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);\n  mask-composite: intersect;\n}\n\n.header-actions {\n  position: absolute;\n  right: 0;\n  top: 50%;\n  transform: translateY(-50%);\n}\n\n/* Footer */\n.app-footer {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-xs);\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-primary);\n  border-top: 1px solid var(--border-color);\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  flex-shrink: 0;\n}\n\n.app-footer img {\n  vertical-align: middle;\n}\n\n/* API Key Dropdown */\n.api-key-dropdown {\n  position: absolute;\n  right: var(--space-lg);\n  top: 3.5rem;\n  background: var(--arctic-dark);\n  border: 1px solid var(--card-border);\n  border-radius: 4px;\n  padding: var(--space-md);\n  z-index: 100;\n  width: 260px;\n  box-shadow: 0 4px 12px rgb(0 0 0 / 40%);\n}\n\n/* Main Layout */\n.app-container {\n  display: flex;\n  flex: 1;\n  min-height: 0;\n  width: 100%;\n}\n\n/* Left Sidebar */\n.sidebar {\n  width: 240px;\n  min-width: 240px;\n  max-width: 240px;\n  background: var(--bg-sidebar);\n  border-right: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n  padding-left: var(--space-sm);\n}\n\n/* Main Content */\n.main-content {\n  flex: 1;\n  min-width: 0;\n  padding: var(--space-lg);\n  overflow: hidden auto;\n  background: var(--bg-primary);\n}\n\n.main-content > div {\n  width: 100%;\n  height: 100%;\n}\n\n.workshop-container {\n  display: flex;\n  height: 100%;\n  width: 100%;\n  overflow: hidden;\n}\n\n.workshop-sidebar {\n  width: 220px;\n  min-width: 220px;\n  max-width: 220px;\n  border-right: 1px solid var(--border-color);\n  background: var(--bg-sidebar);\n  overflow-y: auto;\n}\n\n.workshop-content {\n  flex: 1;\n  overflow-y: auto;\n  min-width: 0;\n}\n\n/* Right Sidebar (Guide) - responsive */\n.guide-sidebar {\n  width: 280px;\n  min-width: 280px;\n  max-width: 280px;\n  background: var(--bg-sidebar);\n  border-left: 1px solid var(--border-color);\n  overflow-y: auto;\n}\n\n.guide-content {\n  padding: var(--space-lg);\n}\n\n.guide-content h2 {\n  color: var(--arctic-light);\n  font-size: var(--text-lg);\n  font-weight: 600;\n  margin: 0 0 var(--space-xs) 0;\n}\n\n.guide-step {\n  background: var(--card-bg);\n  padding: var(--space-md);\n  border-radius: 4px;\n  margin-bottom: var(--space-md);\n  border: 1px solid var(--card-border);\n}\n\n.guide-step h3 {\n  margin: 0 0 var(--space-xs) 0;\n  color: var(--arctic-frost);\n  font-size: var(--text-sm);\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.guide-step p {\n  color: var(--arctic-light);\n  font-size: var(--text-sm);\n  margin: var(--space-xs) 0;\n}\n\n.guide-step ul {\n  color: var(--arctic-light);\n  font-size: var(--text-sm);\n  margin: var(--space-xs) 0;\n  padding-left: var(--space-lg);\n}\n\n.guide-step ul li {\n  margin: var(--space-xs) 0;\n}\n\n.guide-quickstart {\n  margin-top: var(--space-lg);\n  padding: var(--space-md);\n  background: rgb(59 130 246 / 10%);\n  border-radius: 4px;\n  border: 1px solid var(--arctic-ice);\n  color: var(--arctic-frost);\n  font-size: var(--text-sm);\n}\n\n/* Tab Navigation */\n.tab-nav {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n  padding: var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.tab-nav button {\n  padding: var(--space-sm) var(--space-md);\n  border: none;\n  background: transparent;\n  color: var(--arctic-light);\n  text-align: left;\n  cursor: pointer;\n  border-radius: 4px;\n  font-size: var(--text-base);\n  transition: all 0.15s ease;\n}\n\n.tab-nav button:hover {\n  background: rgb(59 130 246 / 15%);\n  color: var(--arctic-frost);\n}\n\n.tab-nav button.active {\n  background: linear-gradient(135deg, var(--arctic-ice) 0%, var(--arctic-frost) 100%);\n  color: var(--arctic-deep);\n  font-weight: 600;\n}\n\n/* Domain Stats */\n.domain-stats {\n  padding: var(--space-md);\n}\n\n.domain-stats h3 {\n  margin: 0 0 var(--space-md) 0;\n  font-size: var(--text-sm);\n  text-transform: uppercase;\n  color: var(--arctic-frost);\n  font-weight: 600;\n  letter-spacing: 0.03em;\n}\n\n.stat-item {\n  display: flex;\n  justify-content: space-between;\n  padding: var(--space-sm) 0;\n  border-bottom: 1px solid rgb(59 130 246 / 10%);\n  font-size: var(--text-sm);\n}\n\n.stat-label {\n  color: var(--arctic-light);\n}\n\n.stat-value {\n  font-weight: 600;\n  color: var(--gold-accent);\n}\n\n/* Forms and Inputs */\ninput,\ntextarea,\nselect {\n  padding: var(--space-sm) var(--space-md);\n  border: 1px solid var(--card-border);\n  border-radius: 4px;\n  font-size: var(--text-base);\n  font-family: inherit;\n  background: var(--input-bg);\n  color: var(--text-color);\n  transition:\n    border-color 0.15s,\n    box-shadow 0.15s;\n}\n\ninput:focus,\ntextarea:focus,\nselect:focus {\n  outline: none;\n  border-color: var(--arctic-ice);\n  box-shadow: 0 0 0 2px rgb(59 130 246 / 20%);\n}\n\ninput::placeholder,\ntextarea::placeholder {\n  color: rgb(147 197 253 / 40%);\n}\n\ninput[type=\"number\"] {\n  width: 70px;\n}\n\ninput[type=\"range\"] {\n  padding: 0;\n  background: transparent;\n}\n\n.form-group {\n  margin-bottom: var(--space-lg);\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: var(--space-xs);\n  font-weight: 600;\n  color: var(--arctic-light);\n  font-size: var(--text-sm);\n}\n\n.form-group input,\n.form-group textarea,\n.form-group select {\n  width: 100%;\n}\n\n.form-group textarea {\n  min-height: 80px;\n  resize: vertical;\n  font-family: \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", monospace;\n  font-size: var(--text-sm);\n}\n\n.form-group small {\n  display: block;\n  margin-top: var(--space-xs);\n  color: var(--text-muted);\n  font-size: var(--text-xs);\n}\n\n/* Buttons */\nbutton {\n  padding: var(--space-sm) var(--space-md);\n  border: none;\n  border-radius: 4px;\n  font-size: var(--text-sm);\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\nbutton.primary {\n  background: linear-gradient(135deg, var(--arctic-ice) 0%, var(--arctic-frost) 100%);\n  color: var(--arctic-deep);\n}\n\nbutton.primary:hover {\n  filter: brightness(1.1);\n}\n\nbutton.secondary {\n  background: rgb(45 74 111 / 60%);\n  color: var(--arctic-light);\n  border: 1px solid var(--card-border);\n}\n\nbutton.secondary:hover {\n  background: rgb(45 74 111 / 80%);\n  border-color: var(--arctic-ice);\n}\n\nbutton.danger {\n  background: rgb(239 68 68 / 80%);\n  color: white;\n}\n\nbutton.danger:hover {\n  background: rgb(239 68 68 / 100%);\n}\n\nbutton:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Cards - standardized to 16px padding */\n.card {\n  background: var(--card-bg);\n  border-radius: 6px;\n  padding: var(--space-lg);\n  margin-bottom: var(--space-md);\n  border: 1px solid var(--card-border);\n}\n\n.card h3 {\n  margin: 0 0 var(--space-md) 0;\n  color: var(--arctic-light);\n  font-size: var(--text-lg);\n}\n\n.card h4 {\n  margin: var(--space-lg) 0 var(--space-sm) 0;\n  color: var(--arctic-frost);\n  font-size: var(--text-base);\n  font-weight: 600;\n}\n\n/* Lists */\n.item-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.list-item {\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  border-radius: 4px;\n  padding: var(--space-md);\n  transition: all 0.15s;\n}\n\n.list-item:hover {\n  border-color: var(--arctic-ice);\n  background: rgb(30 58 95 / 60%);\n}\n\n.list-item.active {\n  border-color: var(--arctic-ice);\n  background: rgb(59 130 246 / 15%);\n}\n\n/* Code Display */\ncode {\n  background: rgb(10 25 41 / 60%);\n  padding: 0.1rem 0.3rem;\n  border-radius: 3px;\n  font-family: \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", monospace;\n  font-size: 0.9em;\n  color: var(--gold-accent);\n}\n\n.code-block {\n  background: rgb(10 25 41 / 80%);\n  color: var(--arctic-light);\n  padding: var(--space-md);\n  border-radius: 4px;\n  font-family: \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", monospace;\n  font-size: var(--text-sm);\n  overflow-x: auto;\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n  border: 1px solid var(--border-color);\n}\n\n/* Utility Classes */\n.text-muted {\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n/* Loading State */\n.loading {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-xl);\n  color: var(--arctic-light);\n  font-size: var(--text-sm);\n}\n\n.spinner {\n  border: 2px solid rgb(59 130 246 / 30%);\n  border-top: 2px solid var(--arctic-ice);\n  border-radius: 50%;\n  width: 24px;\n  height: 24px;\n  animation: spin 0.8s linear infinite;\n  margin-right: var(--space-sm);\n}\n\n@keyframes spin {\n  0% {\n    transform: rotate(0deg);\n  }\n\n  100% {\n    transform: rotate(360deg);\n  }\n}\n\n/* Error/Success States */\n.error {\n  background: rgb(239 68 68 / 15%);\n  color: #fca5a5;\n  padding: var(--space-md);\n  border-radius: 4px;\n  margin-bottom: var(--space-md);\n  border: 1px solid rgb(239 68 68 / 30%);\n  font-size: var(--text-sm);\n}\n\n.success {\n  background: rgb(34 197 94 / 15%);\n  color: #86efac;\n  padding: var(--space-md);\n  border-radius: 4px;\n  margin-bottom: var(--space-md);\n  border: 1px solid rgb(34 197 94 / 30%);\n  font-size: var(--text-sm);\n}\n\n/* Selection */\n::selection {\n  background: var(--arctic-frost);\n  color: var(--arctic-deep);\n}\n\n/* Scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--arctic-deep);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--arctic-dark);\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--arctic-mid);\n}\n\n/* Grid layouts */\n.form-grid-2 {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--space-md);\n}\n\n.form-grid-3 {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: var(--space-md);\n}\n\n.form-grid-4 {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr 1fr;\n  gap: var(--space-md);\n}\n\n/* Domain card summary grid */\n.domain-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: var(--space-md);\n  font-size: var(--text-sm);\n}\n\n/* Flex row that wraps on mobile */\n.flex-row-responsive {\n  display: flex;\n  gap: var(--space-md);\n}\n\n/* Header row with title and actions */\n.header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-md);\n  flex-wrap: wrap;\n  gap: var(--space-sm);\n}\n\n/* Button group */\n.button-group {\n  display: flex;\n  gap: var(--space-sm);\n  flex-wrap: wrap;\n}\n\n/* Generate tab two-column layout */\n.generate-layout {\n  display: flex;\n  gap: var(--space-xl);\n  flex: 1;\n  min-height: 0;\n}\n\n.generate-controls {\n  width: 350px;\n  flex-shrink: 0;\n}\n\n.generate-results {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n/* Collapsible sections */\n.collapsible-section {\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  border-radius: 4px;\n  margin-bottom: var(--space-md);\n  overflow: hidden;\n}\n\n.collapsible-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--space-md);\n  cursor: pointer;\n  user-select: none;\n  transition: background 0.15s;\n}\n\n.collapsible-header:hover {\n  background: rgb(59 130 246 / 10%);\n}\n\n.collapsible-header h4 {\n  margin: 0;\n  color: var(--arctic-frost);\n  font-size: var(--text-sm);\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.collapsible-content {\n  padding: 0 var(--space-md) var(--space-md);\n}\n\n/* Section headers - consistent styling */\nh2 {\n  font-size: var(--text-xl);\n  font-weight: 600;\n  color: var(--arctic-light);\n  margin: 0 0 var(--space-sm) 0;\n}\n\nh3 {\n  font-size: var(--text-lg);\n  font-weight: 600;\n  color: var(--arctic-light);\n  margin: 0 0 var(--space-sm) 0;\n}\n\nh4 {\n  font-size: var(--text-base);\n  font-weight: 600;\n  color: var(--arctic-frost);\n  margin: 0 0 var(--space-sm) 0;\n}\n\n/* Compact input for inline use */\ninput.compact,\nselect.compact {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-sm);\n}\n\n/* ============================================\n   NAME FORGE SPECIFIC STYLES\n   ============================================ */\n\n/* Name Forge accent colors (gold) */\n.nf-accent-gradient {\n  background: linear-gradient(135deg, #ffb366 0%, #ffc080 100%);\n}\n\n/* MFE Container Layout */\n.nf-container {\n  display: flex;\n  height: 100%;\n  background-color: var(--bg-primary);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\n/* MFE Sidebar */\n.nf-sidebar {\n  width: 200px;\n  background-color: var(--bg-sidebar);\n  border-right: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n\n/* Navigation Section */\n.nf-nav {\n  padding: var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.nf-nav-button {\n  display: block;\n  width: 100%;\n  padding: 10px 12px;\n  margin-bottom: var(--space-xs);\n  font-size: var(--text-base);\n  font-weight: 500;\n  text-align: left;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: inherit;\n  background-color: transparent;\n  color: var(--arctic-light);\n}\n\n.nf-nav-button:hover {\n  background: rgb(255 179 102 / 15%);\n  color: #ffb366;\n}\n\n.nf-nav-button.active {\n  background: linear-gradient(135deg, #ffb366 0%, #ffc080 100%);\n  color: var(--arctic-deep);\n  font-weight: 600;\n}\n\n/* API Section */\n.nf-api-section {\n  padding: var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.nf-api-button {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  font-size: var(--text-xs);\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  font-family: inherit;\n  background-color: var(--arctic-dark);\n  color: var(--arctic-light);\n}\n\n.nf-api-button.active {\n  background-color: #ffb366;\n  color: var(--arctic-deep);\n}\n\n.nf-api-dropdown {\n  margin-top: var(--space-sm);\n  padding: var(--space-md);\n  background-color: var(--arctic-dark);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.nf-api-dropdown-title {\n  margin-bottom: var(--space-sm);\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.nf-api-dropdown-hint {\n  font-size: var(--text-xs);\n  color: var(--arctic-light);\n  margin-bottom: var(--space-sm);\n}\n\n.nf-api-input {\n  width: 100%;\n  padding: var(--space-sm);\n  margin-bottom: var(--space-sm);\n  font-size: var(--text-sm);\n  background-color: var(--arctic-mid);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  box-sizing: border-box;\n}\n\n/* Culture Section (in sidebar) */\n.nf-culture-section {\n  flex: 1;\n  overflow: auto;\n}\n\n/* Main Content Area */\n.nf-main {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n.nf-content {\n  flex: 1;\n  overflow: auto;\n}\n\n/* Empty State */\n.nf-empty-state {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 40px;\n  text-align: center;\n  color: var(--arctic-frost);\n}\n\n.nf-empty-state-icon {\n  font-size: 48px;\n  margin-bottom: var(--space-lg);\n  opacity: 0.5;\n}\n\n.nf-empty-state-title {\n  font-size: var(--text-2xl);\n  font-weight: 500;\n  margin-bottom: var(--space-sm);\n  color: var(--text-color);\n}\n\n.nf-empty-state-desc {\n  font-size: var(--text-lg);\n  max-width: 400px;\n  color: var(--arctic-light);\n}\n\n/* Small button variant */\nbutton.sm {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n}\n\n/* ============================================\n   UTILITY CLASSES\n   ============================================ */\n\n/* Margin utilities */\n.mt-0 {\n  margin-top: 0;\n}\n\n.mt-xs {\n  margin-top: var(--space-xs);\n}\n\n.mt-sm {\n  margin-top: var(--space-sm);\n}\n\n.mt-md {\n  margin-top: var(--space-md);\n}\n\n.mt-lg {\n  margin-top: var(--space-lg);\n}\n\n.mb-0 {\n  margin-bottom: 0;\n}\n\n.mb-xs {\n  margin-bottom: var(--space-xs);\n}\n\n.mb-sm {\n  margin-bottom: var(--space-sm);\n}\n\n.mb-md {\n  margin-bottom: var(--space-md);\n}\n\n.mb-lg {\n  margin-bottom: var(--space-lg);\n}\n\n.ml-xs {\n  margin-left: var(--space-xs);\n}\n\n.ml-sm {\n  margin-left: var(--space-sm);\n}\n\n.ml-md {\n  margin-left: var(--space-md);\n}\n\n.mr-xs {\n  margin-right: var(--space-xs);\n}\n\n.mr-sm {\n  margin-right: var(--space-sm);\n}\n\n.mr-md {\n  margin-right: var(--space-md);\n}\n\n/* Flex utilities */\n.flex {\n  display: flex;\n}\n\n.flex-col {\n  flex-direction: column;\n}\n\n.flex-1 {\n  flex: 1;\n}\n\n.items-center {\n  align-items: center;\n}\n\n.justify-between {\n  justify-content: space-between;\n}\n\n.gap-xs {\n  gap: var(--space-xs);\n}\n\n.gap-sm {\n  gap: var(--space-sm);\n}\n\n.gap-md {\n  gap: var(--space-md);\n}\n\n/* Text utilities */\n.text-center {\n  text-align: center;\n}\n\n.font-bold {\n  font-weight: 600;\n}\n\n.font-mono {\n  font-family: monospace;\n}\n\n/* Display utilities */\n.block {\n  display: block;\n}\n\n.inline {\n  display: inline;\n}\n\n.inline-flex {\n  display: inline-flex;\n}\n\n/* Grid utilities */\n.grid {\n  display: grid;\n}\n\n.grid.gap-sm {\n  gap: var(--space-sm);\n}\n\n.grid.gap-md {\n  gap: var(--space-md);\n}\n\n/* ============================================\n   CONDITIONS MODAL\n   ============================================ */\n.conditions-modal {\n  max-width: 480px;\n}\n\n.conditions-preview {\n  background: rgb(212 175 55 / 10%);\n  border: 1px solid rgb(212 175 55 / 30%);\n  border-radius: 6px;\n  padding: var(--space-sm);\n  margin-top: var(--space-md);\n  font-size: var(--text-sm);\n}\n\n/* ============================================\n   RESPONSIVE DESIGN\n   ============================================ */\n\n/* Mobile toggle button for sidebars */\n.mobile-toggle {\n  display: none;\n  padding: var(--space-xs) var(--space-sm);\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  color: var(--arctic-light);\n  font-size: var(--text-xs);\n  cursor: pointer;\n  border-radius: 4px;\n}\n\n.mobile-toggle:hover {\n  background: rgb(59 130 246 / 20%);\n}\n\n/* Mobile menu overlay */\n.mobile-overlay {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 50%);\n  z-index: 99;\n}\n\n.mobile-overlay.visible {\n  display: block;\n}\n\n/* Desktop-only elements */\n.desktop-only {\n  display: block;\n}\n\n.mobile-only {\n  display: none;\n}\n\n/* Responsive utility classes */\n.hide-mobile {\n  display: block;\n}\n\n.show-mobile {\n  display: none;\n}\n\n/* ============================================\n   LARGE TABLET BREAKPOINT (1200px and below)\n   ============================================ */\n@media (width <= 1200px) {\n  /* Narrower guide sidebar */\n  .guide-sidebar {\n    width: 200px;\n    min-width: 200px;\n    max-width: 200px;\n  }\n\n  /* Narrower workshop sidebar */\n  .workshop-sidebar {\n    width: 160px;\n    min-width: 160px;\n    max-width: 160px;\n  }\n\n  /* Narrower left sidebar */\n  .sidebar {\n    width: 200px;\n    min-width: 200px;\n    max-width: 200px;\n  }\n}\n\n/* ============================================\n   TABLET BREAKPOINT (1024px and below)\n   ============================================ */\n@media (width <= 1024px) {\n  /* Hide guide sidebar on tablet */\n  .guide-sidebar {\n    display: none;\n  }\n\n  /* Narrower left sidebar */\n  .sidebar {\n    width: 180px;\n    min-width: 180px;\n    max-width: 180px;\n  }\n\n  /* Narrower workshop sidebar */\n  .workshop-sidebar {\n    width: 160px;\n    min-width: 160px;\n    max-width: 160px;\n  }\n\n  /* Adjust tab nav for smaller space */\n  .tab-nav button {\n    padding: var(--space-xs) var(--space-sm);\n    font-size: var(--text-sm);\n  }\n\n  /* Smaller form grids */\n  .form-grid-4 {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .form-grid-3 {\n    grid-template-columns: 1fr 1fr;\n  }\n}\n\n/* ============================================\n   SMALL TABLET / LARGE PHONE (768px and below)\n   ============================================ */\n@media (width <= 768px) {\n  /* Stack the main layout */\n  .app-container {\n    flex-direction: column;\n  }\n\n  /* Left sidebar becomes top bar with horizontal scroll */\n  .sidebar {\n    width: 100%;\n    min-width: 100%;\n    max-width: 100%;\n    flex-flow: row nowrap;\n    border-right: none;\n    border-bottom: 1px solid var(--border-color);\n    overflow: auto hidden;\n    max-height: none;\n  }\n\n  /* Tab navigation horizontal on mobile */\n  .tab-nav {\n    flex-flow: row nowrap;\n    padding: var(--space-sm);\n    overflow-x: auto;\n    border-bottom: none;\n    gap: var(--space-xs);\n  }\n\n  .tab-nav button {\n    white-space: nowrap;\n    flex-shrink: 0;\n  }\n\n  /* Hide domain stats on mobile */\n  .domain-stats {\n    display: none;\n  }\n\n  /* Main content takes remaining space */\n  .main-content {\n    flex: 1;\n    padding: var(--space-md);\n    min-height: 0;\n  }\n\n  /* Workshop container stacks vertically */\n  .workshop-container {\n    flex-direction: column;\n  }\n\n  /* Culture sidebar in workshop becomes collapsible top section */\n  .workshop-sidebar {\n    width: 100%;\n    min-width: 100%;\n    max-width: 100%;\n    max-height: 200px;\n    border-right: none;\n    border-bottom: 1px solid var(--border-color);\n    overflow-y: auto;\n  }\n\n  .workshop-content {\n    flex: 1;\n    min-height: 0;\n  }\n\n  /* All form grids stack on mobile */\n  .form-grid-2,\n  .form-grid-3,\n  .form-grid-4,\n  .domain-summary-grid {\n    grid-template-columns: 1fr;\n  }\n\n  /* Flex rows stack on mobile */\n  .flex-row-responsive {\n    flex-direction: column;\n  }\n\n  /* Generate tab stacks on mobile */\n  .generate-layout {\n    flex-direction: column;\n    gap: var(--space-md);\n  }\n\n  .generate-controls {\n    width: 100%;\n  }\n\n  .generate-results {\n    min-height: 300px;\n  }\n\n  /* Smaller header */\n  .app-header {\n    padding: var(--space-sm) var(--space-md);\n  }\n\n  .logo-image {\n    height: 50px;\n  }\n\n  .header-actions {\n    position: static;\n    transform: none;\n    margin-left: auto;\n  }\n\n  .header-content {\n    justify-content: space-between;\n  }\n\n  /* API key dropdown responsive */\n  .api-key-dropdown {\n    right: var(--space-sm);\n    left: var(--space-sm);\n    width: auto;\n    max-width: calc(100vw - 2rem);\n  }\n\n  /* Mobile toggles visible */\n  .mobile-toggle {\n    display: inline-flex;\n  }\n\n  .desktop-only {\n    display: none;\n  }\n\n  .mobile-only {\n    display: block;\n  }\n\n  .hide-mobile {\n    display: none;\n  }\n\n  .show-mobile {\n    display: block;\n  }\n\n  /* Smaller buttons on mobile */\n  button {\n    padding: var(--space-xs) var(--space-sm);\n  }\n\n  /* Full width inputs on mobile */\n  input[type=\"number\"] {\n    width: 100%;\n  }\n}\n\n/* ============================================\n   PHONE BREAKPOINT (480px and below)\n   ============================================ */\n@media (width <= 480px) {\n  /* Even smaller header */\n  .app-header {\n    padding: var(--space-xs) var(--space-sm);\n  }\n\n  .logo-image {\n    height: 36px;\n  }\n\n  /* Tighter main content padding */\n  .main-content {\n    padding: var(--space-sm);\n  }\n\n  /* Smaller tabs */\n  .tab-nav {\n    padding: var(--space-xs);\n  }\n\n  .tab-nav button {\n    padding: var(--space-xs) var(--space-sm);\n    font-size: var(--text-xs);\n  }\n\n  /* Compact form groups */\n  .form-group {\n    margin-bottom: var(--space-md);\n  }\n\n  .form-group label {\n    font-size: var(--text-xs);\n  }\n\n  /* Smaller spacing in cards */\n  .card {\n    padding: var(--space-md);\n  }\n\n  /* Collapsible sections more compact */\n  .collapsible-header {\n    padding: var(--space-sm);\n  }\n\n  .collapsible-content {\n    padding: 0 var(--space-sm) var(--space-sm);\n  }\n\n  /* Workshop culture section even smaller */\n  .workshop-sidebar {\n    max-height: 150px;\n  }\n}\n\n/* ============================================\n   RESPONSIVE HELPERS\n   ============================================ */\n\n/* Flex wrap for button groups on small screens */\n@media (width <= 768px) {\n  .button-group,\n  [style*=\"display: flex\"][style*=\"gap\"] {\n    flex-wrap: wrap;\n  }\n}\n\n/* Ensure modals/dropdowns don't overflow on mobile */\n@media (width <= 768px) {\n  [style*=\"position: absolute\"] {\n    max-width: calc(100vw - 2rem);\n  }\n}\n\n/* Touch-friendly tap targets */\n@media (width <= 768px) {\n  button,\n  .tab-nav button,\n  input,\n  select,\n  textarea {\n    min-height: 36px;\n  }\n\n  /* Larger touch targets for small buttons */\n  button.sm,\n  button.danger,\n  button.secondary {\n    min-height: 32px;\n    padding: var(--space-sm) var(--space-md);\n  }\n}\n\n/* Print styles - hide sidebars */\n@media print {\n  .sidebar,\n  .guide-sidebar,\n  .tab-nav {\n    display: none;\n  }\n\n  .main-content {\n    padding: 0;\n  }\n\n  .app-container {\n    display: block;\n  }\n}\n\n/* ============================================\n   CULTURE SIDEBAR STYLES\n   ============================================ */\n\n.culture-sidebar {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.culture-sidebar-header {\n  border-bottom: 1px solid var(--border-color);\n  padding: var(--space-md);\n}\n\n.culture-sidebar-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-sm);\n}\n\n.culture-sidebar-header-row h4 {\n  margin: 0;\n}\n\n.culture-form {\n  background: var(--card-bg);\n  padding: var(--space-md);\n  border-radius: 4px;\n  border: 1px solid var(--card-border);\n}\n\n.culture-form .form-group {\n  margin-bottom: var(--space-sm);\n}\n\n.culture-form-buttons {\n  display: flex;\n  gap: var(--space-sm);\n}\n\n.culture-form-buttons button {\n  flex: 1;\n}\n\n.culture-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-sm);\n}\n\n.culture-list-empty {\n  padding: var(--space-md);\n  text-align: center;\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n}\n\n.culture-card {\n  margin-bottom: var(--space-sm);\n  border: 1px solid var(--card-border);\n  border-radius: 4px;\n  background: var(--card-bg);\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.culture-card.selected {\n  border-color: var(--gold-accent);\n  background: rgb(251 191 36 / 10%);\n}\n\n.culture-card-content {\n  padding: var(--space-sm);\n}\n\n.culture-card-name {\n  font-weight: 600;\n  font-size: var(--text-sm);\n  margin-bottom: var(--space-xs);\n  color: var(--text-color);\n}\n\n.culture-card.selected .culture-card-name {\n  color: var(--gold-accent);\n}\n\n.culture-resource-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 2px;\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n  margin-bottom: var(--space-xs);\n}\n\n.culture-resource-item {\n  padding: 2px 4px;\n  background: rgb(0 0 0 / 20%);\n  border-radius: 2px;\n}\n\n.culture-resource-item.has-domains {\n  background: rgb(147 51 234 / 20%);\n}\n\n.culture-resource-item.has-lexemes {\n  background: rgb(59 130 246 / 20%);\n}\n\n.culture-resource-item.has-grammars {\n  background: rgb(34 197 94 / 20%);\n}\n\n.culture-resource-item.has-profiles {\n  background: rgb(251 191 36 / 20%);\n}\n\n.culture-progress-bar {\n  width: 100%;\n  height: 3px;\n  background: rgb(0 0 0 / 30%);\n  border-radius: 2px;\n  overflow: hidden;\n}\n\n.culture-progress-fill {\n  height: 100%;\n  background: var(--arctic-ice);\n  transition: width 0.2s;\n}\n\n.culture-progress-fill.complete {\n  background: var(--gold-accent);\n}\n\n/* ============================================\n   ENTITY WORKSPACE STYLES\n   ============================================ */\n\n.workspace {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.workspace-empty {\n  padding: var(--space-xl);\n  text-align: center;\n}\n\n.workspace-header {\n  border-bottom: 1px solid var(--border-color);\n  padding: var(--space-md) var(--space-lg);\n  background: rgb(30 58 95 / 20%);\n}\n\n.workspace-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.workspace-title {\n  margin: 0;\n}\n\n.workspace-title-name {\n  color: var(--gold-accent);\n}\n\n.workspace-title-label {\n  font-weight: normal;\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n  margin-left: var(--space-sm);\n}\n\n.workspace-autosave {\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n  opacity: 0.6;\n}\n\n.workspace-tabs {\n  border-bottom: 1px solid var(--border-color);\n  padding: 0 var(--space-lg);\n  background: rgb(30 58 95 / 10%);\n  display: flex;\n  gap: var(--space-xs);\n}\n\n.workspace-tab {\n  padding: var(--space-sm) var(--space-md);\n  border: none;\n  background: transparent;\n  color: var(--text-color);\n  border-bottom: 2px solid transparent;\n  cursor: pointer;\n  font-weight: normal;\n  font-size: var(--text-sm);\n  text-transform: capitalize;\n  transition: all 0.15s;\n}\n\n.workspace-tab:hover {\n  color: var(--arctic-frost);\n}\n\n.workspace-tab.active {\n  background: var(--card-bg);\n  color: var(--gold-accent);\n  border-bottom-color: var(--gold-accent);\n  font-weight: 600;\n}\n\n.workspace-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-lg);\n}\n\n/* ============================================\n   GENERATE TAB STYLES\n   ============================================ */\n\n.generate-container {\n  padding: var(--space-lg);\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n.generate-container h2 {\n  margin-top: 0;\n  margin-bottom: var(--space-sm);\n}\n\n.generate-container .intro {\n  margin-bottom: var(--space-lg);\n}\n\n.generate-section-divider {\n  border-top: 1px solid var(--border-color);\n  margin-top: var(--space-md);\n  padding-top: var(--space-md);\n}\n\n.generate-section-header {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  margin-bottom: var(--space-sm);\n  color: var(--arctic-frost);\n}\n\n.generate-section-header .hint {\n  font-weight: normal;\n  margin-left: var(--space-sm);\n  opacity: 0.7;\n}\n\n.generate-context-row {\n  display: flex;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n  align-items: center;\n}\n\n.generate-context-row input.key {\n  width: 100px;\n  font-size: var(--text-sm);\n}\n\n.generate-context-row input.value {\n  flex: 1;\n  font-size: var(--text-sm);\n}\n\n.generate-context-row .separator {\n  color: var(--arctic-frost);\n}\n\n.add-row-btn {\n  background: rgb(34 197 94 / 20%);\n  border: 1px solid rgb(34 197 94 / 40%);\n  color: rgb(134 239 172);\n  padding: 0.2rem 0.5rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: var(--text-xs);\n}\n\n.add-row-btn:hover {\n  background: rgb(34 197 94 / 30%);\n}\n\n.remove-row-btn {\n  background: rgb(239 68 68 / 20%);\n  border: 1px solid rgb(239 68 68 / 40%);\n  color: rgb(252 165 165);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: var(--text-xs);\n}\n\n.remove-row-btn:hover {\n  background: rgb(239 68 68 / 30%);\n}\n\n.generate-btn {\n  width: 100%;\n  margin-top: var(--space-sm);\n}\n\n.strategy-usage {\n  display: flex;\n  gap: var(--space-sm);\n  flex-wrap: wrap;\n}\n\n.strategy-badge {\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: var(--text-sm);\n}\n\n.strategy-badge.phonotactic {\n  background: rgb(96 165 250 / 20%);\n  border: 1px solid rgb(96 165 250 / 40%);\n}\n\n.strategy-badge.grammar {\n  background: rgb(167 139 250 / 20%);\n  border: 1px solid rgb(167 139 250 / 40%);\n}\n\n.strategy-badge.fallback {\n  background: rgb(74 222 128 / 20%);\n  border: 1px solid rgb(74 222 128 / 40%);\n}\n\n.culture-preview {\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n}\n\n.results-empty {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--arctic-frost);\n  text-align: center;\n}\n\n.results-empty p {\n  margin: 0;\n}\n\n.results-empty p:first-child {\n  font-size: 1.1rem;\n}\n\n.results-empty p:last-child {\n  font-size: var(--text-sm);\n  margin-top: var(--space-sm);\n}\n\n.results-grid {\n  flex: 1;\n  overflow-y: auto;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: var(--space-sm);\n  align-content: start;\n}\n\n.name-card {\n  background: rgb(20 45 75 / 50%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  font-family: monospace;\n  font-size: 1rem;\n  color: var(--gold-accent);\n  cursor: pointer;\n  transition: background 0.2s;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.name-card:hover {\n  background: rgb(30 58 95 / 70%);\n}\n\n.name-card.fallback {\n  border-left: 3px solid var(--warning-color, #f59e0b);\n}\n\n.name-card-badge {\n  font-size: 0.65rem;\n  padding: 0.15rem 0.4rem;\n  border-radius: 3px;\n  text-transform: uppercase;\n  font-weight: 600;\n  opacity: 0.8;\n}\n\n.name-card-badge.grammar {\n  background: rgb(147 51 234 / 30%);\n  color: #c4b5fd;\n}\n\n.name-card-badge.phonotactic {\n  background: rgb(59 130 246 / 30%);\n  color: #93c5fd;\n}\n\n.name-card-badge.markov {\n  background: rgb(16 185 129 / 30%);\n  color: #6ee7b7;\n}\n\n.name-card-badge.fallback {\n  background: rgb(245 158 11 / 30%);\n  color: #fcd34d;\n}\n\n/* ============================================\n   DOMAIN TAB STYLES\n   ============================================ */\n\n.tab-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-md);\n}\n\n.tab-header h3 {\n  margin: 0;\n}\n\n.tab-intro {\n  margin-bottom: var(--space-md);\n  font-size: var(--text-sm);\n}\n\n.domain-card {\n  background: rgb(30 58 95 / 30%);\n  border: 1px solid rgb(34 197 94 / 30%);\n  border-radius: 6px;\n  padding: var(--space-md);\n}\n\n.domain-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 0.75rem;\n}\n\n.domain-card-title {\n  color: rgb(134 239 172);\n}\n\n.domain-card-hint {\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n  margin-top: 0.25rem;\n}\n\n.domain-card-hint code {\n  background: rgb(0 0 0 / 30%);\n  padding: 0.1rem 0.3rem;\n  border-radius: 3px;\n}\n\n.domain-card-actions {\n  display: flex;\n  gap: var(--space-sm);\n}\n\n.icon-btn {\n  font-size: var(--text-xs);\n  padding: 0.25rem 0.5rem;\n}\n\n.icon-btn.danger {\n  color: #ef4444;\n}\n\n.domain-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: var(--space-md);\n  font-size: var(--text-sm);\n}\n\n.domain-summary-grid > div > div:first-child {\n  font-weight: bold;\n  margin-bottom: 0.25rem;\n}\n\n.domain-summary-grid > div > div:not(:first-child) {\n  color: var(--arctic-frost);\n}\n\n.empty-state-card {\n  background: rgb(59 130 246 / 10%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 6px;\n  padding: var(--space-lg);\n  text-align: center;\n  margin-top: var(--space-md);\n}\n\n.empty-state-card p {\n  margin: 0 0 var(--space-md) 0;\n}\n\n.copy-from-section {\n  margin-top: var(--space-lg);\n}\n\n.copy-from-section h4 {\n  margin-bottom: var(--space-sm);\n}\n\n.copy-item {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.copy-item-meta {\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n}\n\n.collapsible-header {\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.75rem;\n  background: rgb(30 58 95 / 30%);\n  border-radius: 6px;\n  margin-bottom: var(--space-sm);\n}\n\n.collapsible-header h4 {\n  margin: 0;\n}\n\n.collapsible-content {\n  padding: var(--space-md);\n  background: rgb(30 58 95 / 10%);\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n}\n\n.form-grid-2 {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--space-md);\n}\n\n.form-grid-3 {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: var(--space-md);\n}\n\n.flex-row-responsive {\n  display: flex;\n  gap: var(--space-md);\n}\n\n.flex-row-responsive .form-group {\n  flex: 1;\n}\n\n@media (width <= 768px) {\n  .form-grid-2,\n  .form-grid-3 {\n    grid-template-columns: 1fr;\n  }\n\n  .flex-row-responsive {\n    flex-direction: column;\n  }\n\n  .domain-summary-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ============================================\n   LEXEMES TAB STYLES\n   ============================================ */\n\n.spec-card {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.spec-card-meta {\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n  margin-top: 0.25rem;\n}\n\n.badge {\n  margin-left: var(--space-sm);\n  padding: 0.125rem 0.5rem;\n  border-radius: 4px;\n  font-size: var(--text-xs);\n}\n\n.badge.generated {\n  background: rgb(34 197 94 / 20%);\n  border: 1px solid rgb(34 197 94 / 40%);\n  color: rgb(134 239 172);\n}\n\n.badge.manual {\n  background: rgb(251 191 36 / 20%);\n  border: 1px solid rgb(251 191 36 / 40%);\n  color: rgb(253 224 71);\n}\n\n.badge.llm {\n  background: rgb(34 197 94 / 20%);\n  border: 1px solid rgb(34 197 94 / 40%);\n  color: rgb(134 239 172);\n}\n\n.list-item {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  cursor: pointer;\n}\n\n.list-item.selected {\n  background: rgb(212 175 55 / 10%);\n  border-color: var(--gold-accent);\n}\n\n.list-item-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.list-item-meta {\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n  margin-top: 0.25rem;\n}\n\n.list-viewer {\n  flex: 0 0 45%;\n  background: rgb(30 58 95 / 20%);\n  border-radius: 6px;\n  padding: var(--space-md);\n  border: 1px solid rgb(59 130 246 / 30%);\n  max-height: 500px;\n  overflow-y: auto;\n}\n\n.list-viewer-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-md);\n}\n\n.list-viewer-header h4 {\n  margin: 0;\n}\n\n.list-viewer-content {\n  background: rgb(0 0 0 / 20%);\n  padding: 0.75rem;\n  border-radius: 4px;\n  font-family: monospace;\n  font-size: var(--text-sm);\n  white-space: pre-wrap;\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n.api-key-warning {\n  display: block;\n  margin-top: var(--space-sm);\n  color: rgb(251 191 36);\n}\n\n.split-layout {\n  display: flex;\n  gap: var(--space-lg);\n}\n\n.split-layout-main {\n  flex: 1;\n}\n\n.split-layout-main.has-sidebar {\n  flex: 0 0 50%;\n}\n\n/* ============================================\n   GRAMMARS TAB STYLES\n   ============================================ */\n\n.grammar-card {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n.grammar-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n}\n\n.grammar-card-meta {\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n  margin-top: 0.25rem;\n}\n\n.rule-form {\n  background: rgb(30 58 95 / 40%);\n  padding: var(--space-md);\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n.rule-form-row {\n  display: flex;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n}\n\n.rule-form-row input.nonterminal {\n  flex: 0 0 120px;\n}\n\n.rule-form-row input.productions {\n  flex: 1;\n}\n\n.rule-form-row .arrow {\n  align-self: center;\n  color: var(--arctic-frost);\n}\n\n.rule-card {\n  padding: 0.75rem;\n  background: rgb(30 58 95 / 40%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  margin-bottom: var(--space-sm);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.rule-card-content {\n  font-family: monospace;\n  font-size: var(--text-sm);\n}\n\n.rule-card-content .key {\n  color: var(--gold-accent);\n}\n\n.rule-card-content .separator {\n  color: var(--arctic-frost);\n}\n\n.rule-card-content .production {\n  color: var(--arctic-light);\n}\n\n/* Click-to-insert panels */\n.insert-panel {\n  background: rgb(30 58 95 / 20%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 8px;\n  margin-bottom: var(--space-md);\n  overflow: hidden;\n}\n\n.insert-panel-header {\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.75rem 1rem;\n  background: rgb(30 58 95 / 40%);\n  border: none;\n  border-bottom: 1px solid rgb(59 130 246 / 30%);\n  color: var(--text-color);\n  cursor: pointer;\n  font-size: var(--text-sm);\n  font-weight: bold;\n}\n\n.insert-panel-content {\n  padding: 0.75rem;\n}\n\n.insert-section {\n  padding: 0.75rem;\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n}\n\n.insert-section-title {\n  font-size: var(--text-xs);\n  margin-bottom: var(--space-sm);\n}\n\n.insert-items {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-sm);\n}\n\n.insert-code {\n  background: rgb(10 25 41 / 80%);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: var(--text-xs);\n}\n\n.insert-code-small {\n  padding: 0.125rem 0.375rem;\n  border-radius: 3px;\n  font-size: 0.7rem;\n  margin-right: 0.25rem;\n}\n\n/* Modal overlay */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 80%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  padding: 2rem;\n}\n\n.modal-content {\n  background: var(--arctic-dark);\n  border-radius: 8px;\n  padding: 2rem;\n  max-width: 700px;\n  max-height: 80vh;\n  overflow-y: auto;\n  border: 2px solid var(--arctic-ice);\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-md);\n}\n\n.modal-header h3 {\n  margin: 0;\n}\n\n.modal-body {\n  line-height: 1.6;\n}\n\n.modal-body h4 {\n  margin-top: var(--space-md);\n  margin-bottom: var(--space-sm);\n}\n\n.code-block {\n  background: rgb(0 0 0 / 30%);\n  padding: var(--space-md);\n  border-radius: 4px;\n  font-family: monospace;\n  font-size: var(--text-sm);\n}\n\n/* ============================================\n   GRAMMARS TAB STYLES\n   ============================================ */\n\n/* Grammar card */\n.grammar-card {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n/* Grammar preview */\n.grammar-preview {\n  margin-top: 0.5rem;\n  padding-top: 0.5rem;\n  border-top: 1px solid rgb(59 130 246 / 20%);\n}\n\n.grammar-preview.empty {\n  opacity: 0.6;\n}\n\n.grammar-preview.error {\n  color: var(--danger);\n}\n\n.grammar-preview-names {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n\n.grammar-preview-name {\n  background: rgb(59 130 246 / 15%);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  font-size: var(--text-sm);\n  color: var(--arctic-aurora);\n  font-style: italic;\n}\n\n/* Copy Grammar Modal */\n.copy-modal {\n  max-width: 600px;\n  max-height: 80vh;\n  display: flex;\n  flex-direction: column;\n}\n\n.copy-modal-body {\n  flex: 1;\n  overflow-y: auto;\n  padding: 0 1rem;\n}\n\n.copy-preview {\n  margin-top: 1rem;\n  padding-top: 1rem;\n  border-top: 1px solid rgb(59 130 246 / 30%);\n}\n\n.copy-preview-section {\n  margin-top: 1rem;\n}\n\n.copy-preview-section h4 {\n  margin: 0 0 0.5rem;\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n}\n\n.copy-preview-rules {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.5rem;\n  padding: 1rem;\n  border-top: 1px solid rgb(59 130 246 / 30%);\n  margin-top: 1rem;\n}\n\n/* Copy list grid (for lexemes) */\n.copy-list-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  max-height: 300px;\n  overflow-y: auto;\n  padding: 0.5rem;\n  background: rgb(30 58 95 / 30%);\n  border-radius: 6px;\n}\n\n.copy-list-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.5rem;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: background-color 0.15s ease;\n}\n\n.copy-list-item:hover {\n  background: rgb(59 130 246 / 10%);\n}\n\n.copy-list-item input[type=\"checkbox\"] {\n  margin-top: 2px;\n}\n\n.copy-list-item-info {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.copy-list-item-info strong {\n  font-family: monospace;\n  font-size: var(--text-sm);\n}\n\n/* Dependency checkboxes for grammar copy */\n.dependency-section {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  background: rgb(30 58 95 / 30%);\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 20%);\n}\n\n.dependency-section h5 {\n  margin: 0 0 0.5rem;\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n}\n\n.dependency-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n}\n\n.dependency-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: var(--text-sm);\n}\n\n.dependency-item.missing {\n  color: var(--warning);\n}\n\n.dependency-item.exists {\n  color: var(--text-muted);\n}\n\n/* Collapsible panel */\n.collapsible-panel {\n  background: rgb(30 58 95 / 20%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 8px;\n  margin-bottom: var(--space-md);\n  overflow: hidden;\n}\n\n.collapsible-header {\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.75rem 1rem;\n  background: rgb(30 58 95 / 40%);\n  border: none;\n  border-bottom: none;\n  color: var(--text-color);\n  cursor: pointer;\n  font-size: var(--text-sm);\n  font-weight: bold;\n  text-align: left;\n}\n\n.collapsible-header.expanded {\n  border-bottom: 1px solid rgb(59 130 246 / 30%);\n}\n\n.collapsible-arrow {\n  transform: rotate(0deg);\n  transition: transform 0.2s;\n  font-size: var(--text-xs);\n}\n\n.collapsible-arrow.expanded {\n  transform: rotate(180deg);\n}\n\n.collapsible-content {\n  padding: 0.75rem;\n}\n\n/* Insert panel variants */\n.insert-panel {\n  padding: 0.75rem;\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n  border: 1px solid;\n}\n\n.insert-panel.gold {\n  background: rgb(59 130 246 / 15%);\n  border-color: rgb(59 130 246 / 30%);\n}\n\n.insert-panel.purple {\n  background: rgb(168 85 247 / 15%);\n  border-color: rgb(168 85 247 / 40%);\n}\n\n.insert-panel.muted {\n  background: rgb(30 58 95 / 30%);\n  border-color: rgb(59 130 246 / 20%);\n}\n\n.insert-panel.domain {\n  background: rgb(147 51 234 / 15%);\n  border-color: rgb(147 51 234 / 30%);\n}\n\n.insert-panel.green {\n  background: rgb(34 197 94 / 15%);\n  border-color: rgb(34 197 94 / 30%);\n}\n\n.insert-panel.cyan {\n  background: rgb(6 182 212 / 15%);\n  border-color: rgb(6 182 212 / 30%);\n}\n\n.insert-panel-title {\n  font-size: var(--text-xs);\n  color: var(--gold-accent);\n  margin-bottom: var(--space-sm);\n}\n\n/* Insert chip variants */\n.insert-chip {\n  background: rgb(10 25 41 / 80%);\n  padding: 0.25rem 0.5rem;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: var(--text-xs);\n  border: 1px solid;\n  font-family: \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", monospace;\n}\n\n.insert-chip.gold {\n  color: var(--gold-accent);\n  border-color: rgb(59 130 246 / 30%);\n}\n\n.insert-chip.purple {\n  color: #c084fc;\n  border-color: rgb(168 85 247 / 40%);\n}\n\n.insert-chip.muted {\n  color: var(--arctic-frost);\n  border-color: rgb(59 130 246 / 20%);\n}\n\n.insert-chip.green {\n  color: rgb(134 239 172);\n  border-color: rgb(34 197 94 / 40%);\n}\n\n.insert-chip.cyan {\n  color: rgb(103 232 249);\n  border-color: rgb(6 182 212 / 50%);\n}\n\n.insert-chip.domain-chip {\n  border-color: rgb(147 51 234 / 50%);\n}\n\n/* Morphology chip */\n.morph-chip {\n  background: rgb(10 25 41 / 80%);\n  padding: 0.125rem 0.375rem;\n  border-radius: 3px;\n  color: rgb(192 132 252);\n  cursor: pointer;\n  font-size: 0.7rem;\n  margin-right: 0.25rem;\n  font-family: \"SF Mono\", Monaco, Inconsolata, \"Roboto Mono\", monospace;\n}\n\n/* Rule form */\n.rule-form {\n  background: rgb(30 58 95 / 40%);\n  padding: var(--space-md);\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n.rule-key-input {\n  flex: 0 0 120px;\n}\n\n.rule-arrow {\n  align-self: center;\n  color: var(--arctic-frost);\n}\n\n/* Rule card */\n.rule-card {\n  padding: 0.75rem;\n  background: rgb(30 58 95 / 40%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  margin-bottom: var(--space-sm);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.rule-card.editing {\n  border-color: rgb(6 182 212 / 60%);\n  background: rgb(6 182 212 / 10%);\n}\n\n.rule-actions {\n  display: flex;\n  gap: var(--space-xs);\n  flex-shrink: 0;\n}\n\n.text-cyan {\n  color: rgb(103 232 249);\n}\n\n/* Help modal */\n.help-modal {\n  max-width: 700px;\n}\n\n.help-content {\n  line-height: 1.6;\n}\n\n.help-content h4 {\n  margin-top: var(--space-md);\n  margin-bottom: var(--space-sm);\n}\n\n/* Text color utilities */\n.text-gold {\n  color: var(--gold-accent);\n}\n\n.text-light {\n  color: var(--arctic-light);\n}\n\n.text-purple {\n  color: rgb(192 132 252);\n}\n\n.text-green {\n  color: rgb(134 239 172);\n}\n\n.text-xs {\n  font-size: var(--text-xs);\n}\n\n/* Button sizes */\n.btn-xs {\n  padding: 0.25rem 0.5rem;\n  font-size: var(--text-xs);\n}\n\n/* Additional flex utilities */\n.flex-wrap {\n  flex-wrap: wrap;\n}\n\n.flex-1 {\n  flex: 1;\n}\n\n.align-start {\n  align-items: flex-start;\n}\n\n.justify-between {\n  justify-content: space-between;\n}\n\n/* ============================================\n   PROFILE TAB STYLES\n   ============================================ */\n\n/* Profile card */\n.profile-card {\n  background: rgb(30 58 95 / 30%);\n  padding: 0.75rem 1rem;\n  border-radius: 6px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  cursor: pointer;\n}\n\n.profile-card.selected {\n  background: rgb(212 175 55 / 10%);\n  border-color: var(--gold-accent);\n}\n\n.profile-list-narrow {\n  flex: 0 0 55%;\n}\n\n/* Generator match badge */\n.generator-match-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.generator-match-badge.active {\n  background-color: rgb(245 158 11 / 15%);\n  border: 1px solid rgb(245 158 11 / 40%);\n  color: #f59e0b;\n}\n\n.generator-match-badge.inactive {\n  background-color: rgb(239 68 68 / 15%);\n  border: 1px solid rgb(239 68 68 / 40%);\n  color: #ef4444;\n}\n\n/* Strategy group */\n.strategy-group {\n  border-radius: 8px;\n  padding: var(--space-md);\n  margin-bottom: var(--space-md);\n}\n\n.strategy-group.default {\n  background: rgb(59 130 246 / 15%);\n  border: 1px solid rgb(59 130 246 / 40%);\n}\n\n.strategy-group.conditional {\n  background: rgb(147 51 234 / 15%);\n  border: 1px solid rgb(147 51 234 / 40%);\n}\n\n.input-group-name {\n  width: 150px;\n  font-weight: bold;\n}\n\n.input-priority {\n  width: 60px;\n  text-align: center;\n}\n\n/* Conditions panel */\n.conditions-panel {\n  background: rgb(147 51 234 / 10%);\n  border: 1px solid rgb(147 51 234 / 30%);\n  border-radius: 6px;\n  padding: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n.condition-label {\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n  margin-bottom: 0.25rem;\n  display: block;\n}\n\n.checkbox-label {\n  font-size: 0.65rem;\n  color: var(--arctic-frost);\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.checkbox-small {\n  width: 12px;\n  height: 12px;\n}\n\n/* Strategy card */\n.strategy-card {\n  border-radius: 6px;\n  padding: 0.75rem;\n  margin-bottom: var(--space-sm);\n}\n\n.strategy-card.phonotactic {\n  background: rgb(96 165 250 / 20%);\n  border: 1px solid rgb(96 165 250 / 40%);\n}\n\n.strategy-card.grammar {\n  background: rgb(168 85 247 / 20%);\n  border: 1px solid rgb(168 85 247 / 40%);\n}\n\n.weight-badge {\n  background: rgb(0 0 0 / 30%);\n  padding: 0.1rem 0.4rem;\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  color: var(--gold-accent);\n}\n\n.strategy-slider {\n  width: 100%;\n  margin-bottom: var(--space-sm);\n}\n\n.strategy-select {\n  width: 100%;\n  font-size: var(--text-sm);\n}\n\n/* Test panel */\n.test-panel {\n  flex: 0 0 40%;\n  background: rgb(30 58 95 / 30%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 8px;\n  padding: var(--space-md);\n}\n\n.strategy-usage-panel {\n  background: rgb(0 0 0 / 20%);\n  border-radius: 4px;\n  padding: var(--space-sm);\n  margin-bottom: 0.75rem;\n  font-size: var(--text-xs);\n}\n\n.test-names-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  max-height: 350px;\n  overflow-y: auto;\n}\n\n.test-name-item {\n  background: rgb(20 45 75 / 50%);\n  padding: 0.5rem 0.75rem;\n  border-radius: 4px;\n  font-family: monospace;\n  color: var(--gold-accent);\n}\n\n/* Pill button */\n.pill-button {\n  padding: 0.2rem 0.5rem;\n  font-size: 0.7rem;\n  border: 1px solid rgb(59 130 246 / 40%);\n  background: transparent;\n  color: var(--text-color);\n  border-radius: 12px;\n  cursor: pointer;\n  text-transform: capitalize;\n}\n\n.pill-button.selected-gold {\n  border-color: var(--gold-accent);\n  background: rgb(212 175 55 / 30%);\n  color: var(--gold-accent);\n}\n\n.pill-button.selected-green {\n  border-color: rgb(34 197 94 / 60%);\n  background: rgb(34 197 94 / 30%);\n  color: rgb(134 239 172);\n}\n\n/* Tags input */\n.tags-input-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem;\n  padding: 0.35rem;\n  background: rgb(0 0 0 / 20%);\n  border-radius: 4px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  min-height: 32px;\n  align-items: center;\n}\n\n.tag-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  padding: 0.15rem 0.4rem;\n  background: rgb(59 130 246 / 30%);\n  border: 1px solid rgb(59 130 246 / 50%);\n  border-radius: 10px;\n  font-size: 0.7rem;\n}\n\n.tag-remove-btn {\n  background: none;\n  border: none;\n  color: var(--arctic-frost);\n  cursor: pointer;\n  padding: 0 0.1rem;\n  font-size: 0.8rem;\n  line-height: 1;\n}\n\n.tags-input {\n  flex: 1;\n  min-width: 60px;\n  background: transparent;\n  border: none;\n  outline: none;\n  font-size: var(--text-xs);\n  color: var(--text-color);\n  padding: 0.1rem;\n}\n\n/* Additional utilities */\n.align-center {\n  align-items: center;\n}\n\n.font-normal {\n  font-weight: normal;\n}\n\n.capitalize {\n  text-transform: capitalize;\n}\n\n.gap-xs {\n  gap: var(--space-xs);\n}\n\n.gap-md {\n  gap: var(--space-md);\n}\n\n.gap-lg {\n  gap: var(--space-lg);\n}\n\n.mr-sm {\n  margin-right: var(--space-sm);\n}\n\n.ml-sm {\n  margin-left: var(--space-sm);\n}\n\n.mb-xs {\n  margin-bottom: var(--space-xs);\n}\n\n.mt-xs {\n  margin-top: var(--space-xs);\n}\n\n.font-bold {\n  font-weight: bold;\n}\n\n/* ============================================\n   PROFILE MODAL STYLES\n   ============================================ */\n\n/* Profile cards grid */\n.profile-cards-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: var(--space-md);\n}\n\n.profile-card-item {\n  background: rgb(30 58 95 / 40%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 8px;\n  padding: var(--space-md);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.profile-card-item:hover {\n  background: rgb(30 58 95 / 60%);\n  border-color: var(--gold-accent);\n  transform: translateY(-2px);\n}\n\n.profile-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-sm);\n}\n\n.profile-card-title {\n  color: var(--text-color);\n  font-size: var(--text-base);\n}\n\n.generator-match-pill {\n  background: rgb(245 158 11 / 20%);\n  border: 1px solid rgb(245 158 11 / 40%);\n  color: #f59e0b;\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: var(--text-xs);\n}\n\n.profile-badges {\n  display: flex;\n  gap: var(--space-xs);\n  align-items: center;\n}\n\n.profile-badge {\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: var(--text-xs);\n}\n\n.profile-badge.default {\n  background: rgb(34 197 94 / 20%);\n  border: 1px solid rgb(34 197 94 / 40%);\n  color: #22c55e;\n}\n\n.profile-badge.kinds {\n  background: rgb(139 92 246 / 20%);\n  border: 1px solid rgb(139 92 246 / 40%);\n  color: #a78bfa;\n}\n\n.profile-card-stats {\n  display: flex;\n  gap: var(--space-lg);\n}\n\n.profile-stat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.profile-stat .stat-num {\n  font-size: var(--text-lg);\n  font-weight: 600;\n  color: var(--gold-accent);\n}\n\n.profile-stat .stat-label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n/* Profile modal */\n.profile-modal {\n  max-width: 900px;\n  width: 90vw;\n}\n\n.profile-modal .modal-body {\n  min-height: 500px;\n}\n\n/* Overview tab */\n.profile-overview-tab .form-group {\n  margin-bottom: var(--space-lg);\n}\n\n.profile-overview-tab .form-group input {\n  width: 100%;\n  max-width: 400px;\n}\n\n.profile-stats {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: var(--space-md);\n  margin: var(--space-xl) 0;\n}\n\n.stat-card {\n  background: rgb(30 58 95 / 40%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 8px;\n  padding: var(--space-md);\n  text-align: center;\n}\n\n.stat-card .stat-value {\n  font-size: var(--text-2xl);\n  font-weight: 600;\n  color: var(--gold-accent);\n}\n\n.stat-card .stat-label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  margin-top: var(--space-xs);\n}\n\n.profile-actions {\n  margin-top: var(--space-lg);\n  padding-top: var(--space-md);\n  border-top: 1px solid rgb(59 130 246 / 20%);\n}\n\n.danger-zone {\n  margin-top: var(--space-xl);\n  padding-top: var(--space-lg);\n  border-top: 1px solid rgb(239 68 68 / 30%);\n}\n\n.danger-zone h4 {\n  color: #ef4444;\n  margin: 0 0 var(--space-md) 0;\n  font-size: var(--text-sm);\n}\n\n/* Groups Overview (drag-drop list) */\n.groups-overview {\n  margin-top: var(--space-lg);\n}\n\n.groups-header {\n  display: flex;\n  align-items: baseline;\n  gap: var(--space-md);\n  margin-bottom: var(--space-md);\n}\n\n.groups-header h4 {\n  margin: 0;\n  font-size: var(--text-md);\n}\n\n.empty-groups {\n  text-align: center;\n  padding: var(--space-xl);\n  color: var(--text-muted);\n  background: rgb(30 58 95 / 30%);\n  border-radius: 8px;\n  border: 1px dashed rgb(59 130 246 / 30%);\n}\n\n.groups-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.group-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) var(--space-md);\n  background: rgb(30 58 95 / 50%);\n  border: 1px solid rgb(59 130 246 / 20%);\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.group-row:hover {\n  background: rgb(45 74 111 / 60%);\n  border-color: rgb(59 130 246 / 40%);\n}\n\n.group-row.drag-over {\n  border-color: var(--gold-accent);\n  background: rgb(251 191 36 / 10%);\n  transform: translateY(2px);\n}\n\n.group-row.dragging {\n  opacity: 0.5;\n  border-style: dashed;\n}\n\n.drag-handle {\n  color: var(--text-muted);\n  cursor: grab;\n  font-size: var(--text-sm);\n  padding: 0 var(--space-xs);\n  user-select: none;\n}\n\n.drag-handle:active {\n  cursor: grabbing;\n}\n\n.group-info {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  min-width: 0;\n}\n\n.group-name {\n  font-weight: 500;\n  font-size: var(--text-sm);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.group-type-badge {\n  font-size: var(--text-xs);\n  padding: 2px 8px;\n  border-radius: 4px;\n  white-space: nowrap;\n}\n\n.group-type-badge.conditional {\n  background: rgb(251 191 36 / 20%);\n  color: var(--gold-accent);\n}\n\n.group-type-badge.default {\n  background: rgb(59 130 246 / 20%);\n  color: var(--arctic-frost);\n}\n\n.group-meta {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.priority-badge {\n  font-size: var(--text-xs);\n  font-weight: 600;\n  color: var(--text-muted);\n  background: rgb(0 0 0 / 30%);\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.strategy-count {\n  font-size: var(--text-xs);\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-weight: 500;\n}\n\n.strategy-count.phonotactic {\n  background: rgb(96 165 250 / 20%);\n  color: #60a5fa;\n}\n\n.strategy-count.grammar {\n  background: rgb(168 85 247 / 20%);\n  color: #a855f7;\n}\n\n.no-strategies {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n.group-arrow {\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n.group-row:hover .group-arrow {\n  color: var(--arctic-frost);\n}\n\n/* Groups tab */\n.profile-groups-tab {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.add-group-buttons {\n  display: flex;\n  gap: var(--space-sm);\n  margin-top: var(--space-md);\n}\n\n/* Test tab */\n.profile-test-tab {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.test-controls {\n  display: flex;\n  align-items: center;\n  gap: var(--space-md);\n}\n\n.test-count-control {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.test-count-control label {\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n.test-count-control input {\n  width: 60px;\n  text-align: center;\n}\n\n.error-box {\n  background: rgb(239 68 68 / 15%);\n  border: 1px solid rgb(239 68 68 / 40%);\n  color: #ef4444;\n  padding: var(--space-sm) var(--space-md);\n  border-radius: 6px;\n  font-size: var(--text-sm);\n}\n\n.strategy-usage-summary {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--space-sm);\n  background: rgb(30 58 95 / 40%);\n  padding: var(--space-sm) var(--space-md);\n  border-radius: 6px;\n}\n\n.usage-label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.usage-item {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-xs);\n  background: rgb(0 0 0 / 20%);\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.usage-strategy {\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  text-transform: capitalize;\n}\n\n.usage-count {\n  font-size: var(--text-xs);\n  color: var(--gold-accent);\n  font-weight: 600;\n}\n\n.test-results {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.results-header {\n  margin-bottom: var(--space-sm);\n}\n\n.results-count {\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n.test-names-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: var(--space-sm);\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.test-name-card {\n  background: rgb(20 45 75 / 50%);\n  padding: var(--space-sm) var(--space-md);\n  border-radius: 6px;\n  font-family: monospace;\n  color: var(--gold-accent);\n  text-align: center;\n}\n\n.empty-test-state {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 200px;\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n/* Profile modal footer (add group buttons) */\n.profile-modal-footer {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n  padding: var(--space-sm);\n  border-top: 1px solid var(--border-color);\n  margin-top: auto;\n}\n\n.add-group-btn {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n  border: 1px dashed var(--border-color);\n  background: transparent;\n  color: var(--text-muted);\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.add-group-btn:hover {\n  border-color: var(--gold-accent);\n  color: var(--gold-accent);\n  background: rgb(251 191 36 / 10%);\n}\n\n.add-group-btn.conditional:hover {\n  border-color: var(--arctic-frost);\n  color: var(--arctic-frost);\n  background: rgb(96 165 250 / 10%);\n}\n\n/* Single Group Tab */\n.single-group-tab {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-lg);\n}\n\n.group-header-section {\n  padding-bottom: var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.group-name-row {\n  display: flex;\n  gap: var(--space-md);\n  align-items: flex-end;\n}\n\n.group-name-row .form-group {\n  flex: 1;\n  margin-bottom: 0;\n}\n\n.group-name-row .priority-field {\n  flex: 0 0 100px;\n}\n\n.group-name-row input {\n  width: 100%;\n}\n\n.group-section {\n  background: rgb(30 58 95 / 20%);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  padding: var(--space-md);\n}\n\n.group-section .section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-md);\n}\n\n.group-section .section-header h4 {\n  margin: 0;\n  font-size: var(--text-base);\n  color: var(--text-color);\n}\n\n.toggle-btn {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n  border: 1px solid var(--border-color);\n  background: transparent;\n  color: var(--text-muted);\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.toggle-btn.active {\n  border-color: var(--arctic-frost);\n  background: rgb(96 165 250 / 20%);\n  color: var(--arctic-frost);\n}\n\n/* Conditions grid */\n.conditions-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--space-md);\n}\n\n.condition-field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n}\n\n.condition-field > label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.match-all-toggle {\n  font-size: 10px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--text-muted);\n}\n\n.match-all-toggle input {\n  width: 12px;\n  height: 12px;\n}\n\n/* Strategies */\n.add-strategy-buttons {\n  display: flex;\n  gap: var(--space-xs);\n}\n\n.add-btn {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n  border: 1px solid;\n  background: transparent;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.add-btn.phonotactic {\n  border-color: rgb(96 165 250 / 50%);\n  color: var(--arctic-frost);\n}\n\n.add-btn.phonotactic:hover {\n  background: rgb(96 165 250 / 20%);\n}\n\n.add-btn.grammar {\n  border-color: rgb(168 85 247 / 50%);\n  color: #a855f7;\n}\n\n.add-btn.grammar:hover {\n  background: rgb(168 85 247 / 20%);\n}\n\n.empty-strategies {\n  text-align: center;\n  padding: var(--space-xl);\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n.strategies-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.strategy-item {\n  border-radius: 6px;\n  padding: var(--space-sm);\n  border: 1px solid;\n}\n\n.strategy-item.phonotactic {\n  background: rgb(96 165 250 / 10%);\n  border-color: rgb(96 165 250 / 30%);\n}\n\n.strategy-item.grammar {\n  background: rgb(168 85 247 / 10%);\n  border-color: rgb(168 85 247 / 30%);\n}\n\n.strategy-header {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n}\n\n.strategy-type {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  text-transform: capitalize;\n  flex: 1;\n}\n\n.strategy-item.phonotactic .strategy-type {\n  color: var(--arctic-frost);\n}\n\n.strategy-item.grammar .strategy-type {\n  color: #a855f7;\n}\n\n.strategy-weight {\n  font-size: var(--text-xs);\n  color: var(--gold-accent);\n  background: rgb(0 0 0 / 30%);\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.remove-btn {\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  font-size: var(--text-lg);\n  cursor: pointer;\n  padding: 0 4px;\n  line-height: 1;\n}\n\n.remove-btn:hover {\n  color: #ef4444;\n}\n\n.strategy-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.weight-slider {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.weight-slider label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  min-width: 50px;\n}\n\n.weight-slider input[type=\"range\"] {\n  flex: 1;\n}\n\n.strategy-config {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.strategy-config label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  min-width: 50px;\n}\n\n.strategy-config select {\n  flex: 1;\n  font-size: var(--text-sm);\n}\n\n/* ============================================\n   OPTIMIZER STYLES\n   ============================================ */\n\n/* Container */\n.optimizer-container {\n  display: flex;\n  height: 100%;\n  overflow: hidden;\n}\n\n/* Sidebar */\n.optimizer-sidebar {\n  width: 300px;\n  border-right: 1px solid rgb(59 130 246 / 20%);\n  background: rgb(30 58 95 / 40%);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.optimizer-sidebar-header {\n  padding: var(--space-md);\n  border-bottom: 1px solid rgb(59 130 246 / 20%);\n  background: rgb(30 58 95 / 30%);\n}\n\n.optimizer-sidebar-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-sm);\n}\n\n.culture-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm);\n  background: rgb(45 74 111 / 50%);\n  border-radius: 4px;\n  cursor: pointer;\n  border: 1px solid rgb(59 130 246 / 15%);\n}\n\n.culture-row-label {\n  flex: 1;\n  font-weight: 500;\n  font-size: var(--text-sm);\n}\n\n.domain-list {\n  padding-left: 1.5rem;\n  margin-top: 0.25rem;\n}\n\n.domain-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: 0.35rem var(--space-sm);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  border-radius: 4px;\n  background: transparent;\n  color: var(--arctic-light);\n}\n\n.domain-row.selected {\n  background: rgb(251 191 36 / 15%);\n  color: var(--gold-accent);\n}\n\n.empty-message {\n  padding: 2rem;\n  text-align: center;\n  color: var(--arctic-frost);\n}\n\n/* Main panel */\n.optimizer-main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  background: rgb(10 25 41 / 30%);\n}\n\n.optimizer-settings-area {\n  padding: 1.25rem;\n  border-bottom: 1px solid rgb(59 130 246 / 20%);\n  overflow-y: auto;\n}\n\n.section-title {\n  margin: 0 0 0.75rem;\n  font-size: var(--text-sm);\n  color: var(--arctic-frost);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n/* Algorithm grid */\n.algorithm-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: var(--space-sm);\n}\n\n.algorithm-card {\n  padding: 0.75rem;\n  border-radius: 6px;\n  border: 2px solid rgb(59 130 246 / 30%);\n  background: rgb(30 58 95 / 40%);\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.algorithm-card.selected {\n  border-color: var(--gold-accent);\n  background: rgb(251 191 36 / 12%);\n}\n\n.algorithm-name {\n  font-weight: 600;\n  margin-bottom: 0.25rem;\n}\n\n.algorithm-name.selected {\n  color: var(--gold-accent);\n}\n\n.algorithm-desc {\n  font-size: var(--text-xs);\n  color: var(--arctic-frost);\n  line-height: 1.4;\n}\n\n/* Parameter grids */\n.optimizer-param-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 0.75rem;\n}\n\n.optimizer-param-grid-small {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n  gap: 0.75rem;\n}\n\n.fitness-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n  gap: 0.75rem;\n}\n\n.optimizer-input {\n  padding: var(--space-sm);\n  border-radius: 4px;\n  border: 1px solid rgb(59 130 246 / 30%);\n  background: rgb(30 58 95 / 50%);\n  color: #fff;\n}\n\n.optimizer-input.disabled {\n  opacity: 0.5;\n}\n\n/* Buttons */\n.optimize-button {\n  padding: 0.75rem 1.5rem;\n  font-size: 1rem;\n  font-weight: 600;\n  background: var(--gold-accent);\n  color: var(--arctic-deep);\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.optimize-button.disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.optimize-action-button {\n  padding: 0.75rem 1.5rem;\n}\n\n/* Status bar */\n.optimizer-status-bar {\n  padding: var(--space-md) 1.25rem;\n  background: rgb(30 58 95 / 50%);\n  border-top: 1px solid rgb(59 130 246 / 20%);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-md);\n}\n\n/* Modal */\n.optimizer-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(10 25 41 / 90%);\n  backdrop-filter: blur(4px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.optimizer-modal {\n  background: linear-gradient(135deg, var(--arctic-dark) 0%, var(--arctic-mid) 100%);\n  border-radius: 12px;\n  width: 90%;\n  max-width: 900px;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 25px 50px rgb(0 0 0 / 50%);\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n.optimizer-modal-header {\n  padding: 1.25rem 1.5rem;\n  border-bottom: 1px solid rgb(59 130 246 / 20%);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.modal-close-btn {\n  background: transparent;\n  border: none;\n  color: var(--arctic-frost);\n  font-size: 1.5rem;\n  cursor: pointer;\n  padding: 0.25rem 0.5rem;\n  line-height: 1;\n}\n\n.optimizer-progress-section {\n  padding: var(--space-md) 1.5rem;\n  border-bottom: 1px solid rgb(59 130 246 / 20%);\n}\n\n.progress-bar-track {\n  height: 8px;\n  background: rgb(10 25 41 / 50%);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.progress-bar-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--arctic-ice), var(--gold-accent));\n  border-radius: 4px;\n  transition: width 0.3s ease;\n}\n\n.optimizer-modal-body {\n  flex: 1;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.optimizer-log-section {\n  flex: 1;\n  padding: 1.5rem;\n  overflow-y: auto;\n  min-height: 0;\n}\n\n.optimizer-log {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n  font-size: var(--text-sm);\n  line-height: 1.7;\n  background: rgb(10 25 41 / 60%);\n  padding: var(--space-md);\n  border-radius: 8px;\n  border: 1px solid rgb(59 130 246 / 20%);\n  max-height: 250px;\n  overflow-y: auto;\n}\n\n.log-entry {\n  padding: 0.25rem 0;\n  color: var(--arctic-light);\n}\n\n.log-entry.error {\n  color: #f87171;\n}\n\n.log-entry.success {\n  color: #86efac;\n}\n\n.log-entry.warning {\n  color: #fde047;\n}\n\n/* Results table */\n.results-table-container {\n  background: rgb(10 25 41 / 60%);\n  border-radius: 8px;\n  border: 1px solid rgb(59 130 246 / 20%);\n  overflow: hidden;\n}\n\n.results-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n}\n\n.results-table th {\n  text-align: left;\n  padding: 0.75rem var(--space-md);\n  color: var(--arctic-frost);\n  font-weight: 600;\n  background: rgb(