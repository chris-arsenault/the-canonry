style: italic;\n}\n\n/* Image picker */\n\n.bie-picker {\n  margin-bottom: 8px;\n}\n\n.bie-section-label {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.bie-picker-grid {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.bie-none-btn {\n  width: 60px;\n  height: 60px;\n  border-radius: 6px;\n  padding: 0;\n  cursor: pointer;\n  background: rgb(255 255 255 / 5%);\n  font-size: 10px;\n  flex-shrink: 0;\n}\n\n.bie-none-btn-selected {\n  border: 2px solid #3b82f6;\n  color: #3b82f6;\n}\n\n.bie-none-btn-unselected {\n  border: 2px solid rgb(255 255 255 / 20%);\n  color: var(--text-muted);\n}\n\n/* Size + Alignment controls */\n\n.bie-controls {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.bie-control-label {\n  font-size: 10px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-right: 6px;\n}\n\n.bie-size-select {\n  background: rgb(255 255 255 / 10%);\n  border: 1px solid rgb(255 255 255 / 20%);\n  border-radius: 4px;\n  color: var(--text-primary);\n  padding: 4px 8px;\n  font-size: 12px;\n}\n\n.bie-align-btn {\n  color: var(--text-primary);\n  padding: 4px 10px;\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.bie-align-btn-left {\n  border-radius: 4px 0 0 4px;\n}\n\n.bie-align-btn-right {\n  border-radius: 0 4px 4px 0;\n}\n\n.bie-align-btn-active {\n  background: rgb(59 130 246 / 30%);\n  border: 1px solid rgb(59 130 246 / 50%);\n}\n\n.bie-align-btn-inactive {\n  background: rgb(255 255 255 / 10%);\n  border: 1px solid rgb(255 255 255 / 20%);\n}\n\n/* Legacy indicator */\n\n.bie-legacy-hint {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-top: 4px;\n  font-style: italic;\n}\n\n/* === BackrefImageEditor main === */\n\n.bie-wrapper {\n  margin-bottom: 16px;\n}\n\n.bie-rows-container-collapsed {\n  margin-top: 8px;\n}\n\n.bie-rows-container-expanded {\n  margin-top: 0;\n}\n\n.bie-heading {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.bie-toggle-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  background: rgb(255 255 255 / 5%);\n  border: 1px solid rgb(255 255 255 / 10%);\n  border-radius: 4px;\n  padding: 8px 10px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.bie-toggle-arrow {\n  font-size: 10px;\n  transition: transform 0.2s ease;\n}\n\n.bie-toggle-arrow-expanded {\n  transform: rotate(90deg);\n}\n\n.bie-toggle-arrow-collapsed {\n  transform: rotate(0deg);\n}\n\n.bie-toggle-label {\n  flex: 1;\n}\n","structuredPatch":[{"oldStart":30,"oldLines":7,"newStart":30,"newLines":7,"lines":["   display: flex;","   align-items: center;","   justify-content: center;","-  background: rgb(255 255 255 / 5%);","+  background: var(--bg-tertiary);","   font-size: 10px;","   color: var(--text-muted);"," }"]},{"oldStart":101,"oldLines":7,"newStart":101,"newLines":7,"lines":["   border-radius: 6px;","   padding: 0;","   cursor: pointer;","-  background: rgb(255 255 255 / 5%);","+  background: var(--bg-tertiary);","   font-size: 10px;","   flex-shrink: 0;"," }"]},{"oldStart":202,"oldLines":7,"newStart":202,"newLines":7,"lines":["   align-items: center;","   gap: 6px;","   width: 100%;","-  background: rgb(255 255 255 / 5%);","+  background: var(--bg-tertiary);","   border: 1px solid rgb(255 255 255 / 10%);","   border-radius: 4px;","   padding: 8px 10px;"]}],"userModified":false,"replaceAll":true}}
