{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wXB9yB7FFHhheG4fxr2Jb","type":"tool_result","content":"     1→/**\n     2→ * FinalDiagnostics - Tabbed view of simulation results\n     3→ */\n     4→\n     5→import React, { useState } from \"react\";\n     6→import PropTypes from \"prop-types\";\n     7→import \"./FinalDiagnostics.css\";\n     8→\n     9→const ACCENT_COLOR = \"#a78bfa\"; // Keep for JS template bar calculations\n    10→\n    11→export default function FinalDiagnostics({\n    12→  entityBreakdown,\n    13→  catalystStats,\n    14→  relationshipBreakdown,\n    15→  notableEntities,\n    16→}) {\n    17→  const [activeTab, setActiveTab] = useState(\"entities\");\n    18→\n    19→  const hasDiagnostics =\n    20→    entityBreakdown || catalystStats || relationshipBreakdown || notableEntities;\n    21→\n    22→  if (!hasDiagnostics) {\n    23→    return null;\n    24→  }\n    25→\n    26→  return (\n    27→    <div className=\"lw-panel\">\n    28→      <div className=\"lw-panel-header\">\n    29→        <div className=\"lw-panel-title\">\n    30→          <span>📋</span>\n    31→          Final Diagnostics\n    32→        </div>\n    33→      </div>\n    34→\n    35→      {/* Tab navigation */}\n    36→      <div className=\"lw-filter-tabs\">\n    37→        {[\"entities\", \"relationships\", \"agents\", \"notable\"].map((tab) => (\n    38→          <button\n    39→            key={tab}\n    40→            className={`lw-filter-tab ${activeTab === tab ? \"active\" : \"\"}`}\n    41→            onClick={() => setActiveTab(tab)}\n    42→          >\n    43→            {tab.charAt(0).toUpperCase() + tab.slice(1)}\n    44→          </button>\n    45→        ))}\n    46→      </div>\n    47→\n    48→      <div className=\"lw-panel-content\">\n    49→        {activeTab === \"entities\" && entityBreakdown && (\n    50→          <EntityBreakdownTab entityBreakdown={entityBreakdown} />\n    51→        )}\n    52→        {activeTab === \"relationships\" && relationshipBreakdown && (\n    53→          <RelationshipBreakdownTab relationshipBreakdown={relationshipBreakdown} />\n    54→        )}\n    55→        {activeTab === \"agents\" && catalystStats && <AgentsTab catalystStats={catalystStats} />}\n    56→        {activeTab === \"notable\" && notableEntities && (\n    57→          <NotableEntitiesTab notableEntities={notableEntities} />\n    58→        )}\n    59→      </div>\n    60→    </div>\n    61→  );\n    62→}\n    63→\n    64→function EntityBreakdownTab({ entityBreakdown }) {\n    65→  return (\n    66→    <div>\n    67→      <div className=\"fd-total-label\">\n    68→        Total: {entityBreakdown.totalEntities} entities\n    69→      </div>\n    70→      <div className=\"lw-flex-col lw-gap-sm\">\n    71→        {Object.entries(entityBreakdown.byKind).map(([kind, data]) => (\n    72→          <div key={kind} className=\"lw-metric-card\">\n    73→            <div className=\"fd-kind-header\">\n    74→              <span className=\"fd-kind-name\">{kind}</span>\n    75→              <span className=\"fd-kind-count\">{data.total}</span>\n    76→            </div>\n    77→            <div className=\"fd-subtype-list\">\n    78→              {Object.entries(data.bySubtype).map(([subtype, count]) => (\n    79→                <span\n    80→                  key={subtype}\n    81→                  className=\"lw-badge fd-subtype-badge\"\n    82→                >\n    83→                  {subtype}: {count}\n    84→                </span>\n    85→              ))}\n    86→            </div>\n    87→          </div>\n    88→        ))}\n    89→      </div>\n    90→    </div>\n    91→  );\n    92→}\n    93→\n    94→function RelationshipBreakdownTab({ relationshipBreakdown }) {\n    95→  return (\n    96→    <div>\n    97→      <div className=\"fd-total-label\">\n    98→        Total: {relationshipBreakdown.totalRelationships} relationships\n    99→      </div>\n   100→      <div className=\"lw-flex-col lw-gap-sm\">\n   101→        {relationshipBreakdown.byKind.map((rel) => (\n   102→          <div key={rel.kind} className=\"lw-pressure-gauge\">\n   103→            <span className=\"lw-pressure-name fd-rel-name\">\n   104→              {rel.kind}\n   105→            </span>\n   106→            <div className=\"lw-pressure-bar\">\n   107→              <div\n   108→                className=\"lw-pressure-fill fd-rel-fill\"\n   109→                style={{ '--fd-rel-fill-width': `${rel.percentage}%` }}\n   110→              />\n   111→            </div>\n   112→            <span className=\"lw-pressure-value\">\n   113→              {rel.count} ({rel.percentage.toFixed(1)}%)\n   114→            </span>\n   115→          </div>\n   116→        ))}\n   117→      </div>\n   118→    </div>\n   119→  );\n   120→}\n   121→\n   122→function AgentsTab({ catalystStats }) {\n   123→  const [showUnused, setShowUnused] = useState(false);\n   124→  const unusedCount = catalystStats.unusedActions?.length || 0;\n   125→\n   126→  return (\n   127→    <div>\n   128→      <div className=\"lw-metric-grid\">\n   129→        <div className=\"lw-metric-card\">\n   130→          <div className=\"lw-metric-name\">Total Agents</div>\n   131→          <div className=\"lw-metric-value\">{catalystStats.totalAgents}</div>\n   132→        </div>\n   133→        <div className=\"lw-metric-card\">\n   134→          <div className=\"lw-metric-name\">Active Agents</div>\n   135→          <div className=\"lw-metric-value\">{catalystStats.activeAgents}</div>\n   136→        </div>\n   137→        <div className=\"lw-metric-card\">\n   138→          <div className=\"lw-metric-name\">Total Actions</div>\n   139→          <div className=\"lw-metric-value\">{catalystStats.totalActions}</div>\n   140→        </div>\n   141→        <div className=\"lw-metric-card\">\n   142→          <div className=\"lw-metric-name\">Unique Actors</div>\n   143→          <div className=\"lw-metric-value\">{catalystStats.uniqueActors}</div>\n   144→        </div>\n   145→      </div>\n   146→\n   147→      {catalystStats.topAgents.length > 0 && (\n   148→        <div className=\"fd-section-spacer\">\n   149→          <div className=\"fd-section-label\">\n   150→            Top Agents by Actions\n   151→          </div>\n   152→          <div className=\"lw-flex-col lw-gap-sm\">\n   153→            {catalystStats.topAgents.map((agent, i) => (\n   154→              <div\n   155→                key={agent.id}\n   156→                className=\"lw-template-item fd-agent-item\"\n   157→                style={{\n   158→                  '--fd-agent-border-left': `3px solid ${i === 0 ? ACCENT_COLOR : \"var(--lw-border-color)\"}`,\n   159→                }}\n   160→              >\n   161→                <span className=\"lw-template-name fd-agent-name\">\n   162→                  {agent.name}\n   163→                  <span className=\"fd-agent-kind\">\n   164→                    ({agent.kind})\n   165→                  </span>\n   166→                </span>\n   167→                <span className=\"lw-template-count\">{agent.actionCount}×</span>\n   168→              </div>\n   169→            ))}\n   170→          </div>\n   171→        </div>\n   172→      )}\n   173→\n   174→      {unusedCount > 0 && (\n   175→        <div className=\"fd-section-spacer\">\n   176→          <div className=\"lw-unused-header\" onClick={() => setShowUnused(!showUnused)} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n   177→            <span className=\"lw-unused-toggle\">{showUnused ? \"▼\" : \"▶\"}</span>\n   178→            <span className=\"lw-unused-title\">Unused Actions ({unusedCount})</span>\n   179→          </div>\n   180→          {showUnused && (\n   181→            <div className=\"lw-unused-list\">\n   182→              {catalystStats.unusedActions.map((action) => (\n   183→                <div\n   184→                  key={action.actionId}\n   185→                  className=\"lw-template-item fd-unused-item\"\n   186→                >\n   187→                  <span className=\"lw-template-name fd-unused-name\">\n   188→                    {action.actionName}\n   189→                    <span className=\"fd-unused-kind\">\n   190→                      ({action.actionId})\n   191→                    </span>\n   192→                  </span>\n   193→                </div>\n   194→              ))}\n   195→            </div>\n   196→          )}\n   197→        </div>\n   198→      )}\n   199→    </div>\n   200→  );\n   201→}\n   202→\n   203→function NotableEntitiesTab({ notableEntities }) {\n   204→  return (\n   205→    <div>\n   206→      {notableEntities.mythic.length > 0 && (\n   207→        <div className=\"fd-mythic-section\">\n   208→          <div className=\"fd-mythic-label\">\n   209→            <span>⭐</span> Mythic ({notableEntities.mythic.length})\n   210→          </div>\n   211→          <div className=\"lw-flex-col lw-gap-sm\">\n   212→            {notableEntities.mythic.map((e) => (\n   213→              <div\n   214→                key={e.id}\n   215→                className=\"lw-template-item fd-mythic-item\"\n   216→              >\n   217→                <span className=\"fd-entity-name\">{e.name}</span>\n   218→                <span className=\"fd-entity-type\">\n   219→                  {e.kind}:{e.subtype}\n   220→                </span>\n   221→              </div>\n   222→            ))}\n   223→          </div>\n   224→        </div>\n   225→      )}\n   226→\n   227→      {notableEntities.renowned.length > 0 && (\n   228→        <div>\n   229→          <div className=\"fd-renowned-label\">\n   230→            <span>★</span> Renowned ({notableEntities.renowned.length})\n   231→          </div>\n   232→          <div className=\"lw-flex-col lw-gap-sm\">\n   233→            {notableEntities.renowned.slice(0, 10).map((e) => (\n   234→              <div\n   235→                key={e.id}\n   236→                className=\"lw-template-item fd-renowned-item\"\n   237→              >\n   238→                <span className=\"fd-entity-name\">{e.name}</span>\n   239→                <span className=\"fd-entity-type\">\n   240→                  {e.kind}:{e.subtype}\n   241→                </span>\n   242→              </div>\n   243→            ))}\n   244→            {notableEntities.renowned.length > 10 && (\n   245→              <div className=\"fd-more-label\">\n   246→                +{notableEntities.renowned.length - 10} more\n   247→              </div>\n   248→            )}\n   249→          </div>\n   250→        </div>\n   251→      )}\n   252→\n   253→      {notableEntities.mythic.length === 0 && notableEntities.renowned.length === 0 && (\n   254→        <div className=\"lw-empty-state\">\n   255→          <span className=\"lw-empty-icon\">🌟</span>\n   256→          <span>No notable entities yet</span>\n   257→        </div>\n   258→      )}\n   259→    </div>\n   260→  );\n   261→}\n   262→\n   263→FinalDiagnostics.propTypes = {\n   264→  entityBreakdown: PropTypes.object,\n   265→  catalystStats: PropTypes.object,\n   266→  relationshipBreakdown: PropTypes.object,\n   267→  notableEntities: PropTypes.object,\n   268→};\n   269→\n   270→EntityBreakdownTab.propTypes = {\n   271→  entityBreakdown: PropTypes.object,\n   272→};\n   273→\n   274→RelationshipBreakdownTab.propTypes = {\n   275→  relationshipBreakdown: PropTypes.object,\n   276→};\n   277→\n   278→AgentsTab.propTypes = {\n   279→  catalystStats: PropTypes.object,\n   280→};\n   281→\n   282→NotableEntitiesTab.propTypes = {\n   283→  notableEntities: PropTypes.object,\n   284→};\n   285→"}]},"parent_tool_use_id":null,"session_id":"d7d177e3-e480-46d9-92de-1155938b93f7","uuid":"64f9aa44-1d6c-4b6b-8283-e757fd0dab7d","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/lore-weave/webui/src/components/dashboard/FinalDiagnostics.jsx","content":"/**\n * FinalDiagnostics - Tabbed view of simulation results\n */\n\nimport React, { useState } from \"react\";\nimport PropTypes from \"prop-types\";\nimport \"./FinalDiagnostics.css\";\n\nconst ACCENT_COLOR = \"#a78bfa\"; // Keep for JS template bar calculations\n\nexport default function FinalDiagnostics({\n  entityBreakdown,\n  catalystStats,\n  relationshipBreakdown,\n  notableEntities,\n}) {\n  const [activeTab, setActiveTab] = useState(\"entities\");\n\n  const hasDiagnostics =\n    entityBreakdown || catalystStats || relationshipBreakdown || notableEntities;\n\n  if (!hasDiagnostics) {\n    return null;\n  }\n\n  return (\n    <div className=\"lw-panel\">\n      <div className=\"lw-panel-header\">\n        <div className=\"lw-panel-title\">\n          <span>📋</span>\n          Final Diagnostics\n        </div>\n      </div>\n\n      {/* Tab navigation */}\n      <div className=\"lw-filter-tabs\">\n        {[\"entities\", \"relationships\", \"agents\", \"notable\"].map((tab) => (\n          <button\n            key={tab}\n            className={`lw-filter-tab ${activeTab === tab ? \"active\" : \"\"}`}\n            onClick={() => setActiveTab(tab)}\n          >\n            {tab.charAt(0).toUpperCase() + tab.slice(1)}\n          </button>\n        ))}\n      </div>\n\n      <div className=\"lw-panel-content\">\n        {activeTab === \"entities\" && entityBreakdown && (\n          <EntityBreakdownTab entityBreakdown={entityBreakdown} />\n        )}\n        {activeTab === \"relationships\" && relationshipBreakdown && (\n          <RelationshipBreakdownTab relationshipBreakdown={relationshipBreakdown} />\n        )}\n        {activeTab === \"agents\" && catalystStats && <AgentsTab catalystStats={catalystStats} />}\n        {activeTab === \"notable\" && notableEntities && (\n          <NotableEntitiesTab notableEntities={notableEntities} />\n        )}\n      </div>\n    </div>\n  );\n}\n\nfunction EntityBreakdownTab({ entityBreakdown }) {\n  return (\n    <div>\n      <div className=\"fd-total-label\">\n        Total: {entityBreakdown.totalEntities} entities\n      </div>\n      <div className=\"lw-flex-col lw-gap-sm\">\n        {Object.entries(entityBreakdown.byKind).map(([kind, data]) => (\n          <div key={kind} className=\"lw-metric-card\">\n            <div className=\"fd-kind-header\">\n              <span className=\"fd-kind-name\">{kind}</span>\n              <span className=\"fd-kind-count\">{data.total}</span>\n            </div>\n            <div className=\"fd-subtype-list\">\n              {Object.entries(data.bySubtype).map(([subtype, count]) => (\n                <span\n                  key={subtype}\n                  className=\"lw-badge fd-subtype-badge\"\n                >\n                  {subtype}: {count}\n                </span>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction RelationshipBreakdownTab({ relationshipBreakdown }) {\n  return (\n    <div>\n      <div className=\"fd-total-label\">\n        Total: {relationshipBreakdown.totalRelationships} relationships\n      </div>\n      <div className=\"lw-flex-col lw-gap-sm\">\n        {relationshipBreakdown.byKind.map((rel) => (\n          <div key={rel.kind} className=\"lw-pressure-gauge\">\n            <span className=\"lw-pressure-name fd-rel-name\">\n              {rel.kind}\n            </span>\n            <div className=\"lw-pressure-bar\">\n              <div\n                className=\"lw-pressure-fill fd-rel-fill\"\n                style={{ '--fd-rel-fill-width': `${rel.percentage}%` }}\n              />\n            </div>\n            <span className=\"lw-pressure-value\">\n              {rel.count} ({rel.percentage.toFixed(1)}%)\n            </span>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n}\n\nfunction AgentsTab({ catalystStats }) {\n  const [showUnused, setShowUnused] = useState(false);\n  const unusedCount = catalystStats.unusedActions?.length || 0;\n\n  return (\n    <div>\n      <div className=\"lw-metric-grid\">\n        <div className=\"lw-metric-card\">\n          <div className=\"lw-metric-name\">Total Agents</div>\n          <div className=\"lw-metric-value\">{catalystStats.totalAgents}</div>\n        </div>\n        <div className=\"lw-metric-card\">\n          <div className=\"lw-metric-name\">Active Agents</div>\n          <div className=\"lw-metric-value\">{catalystStats.activeAgents}</div>\n        </div>\n        <div className=\"lw-metric-card\">\n          <div className=\"lw-metric-name\">Total Actions</div>\n          <div className=\"lw-metric-value\">{catalystStats.totalActions}</div>\n        </div>\n        <div className=\"lw-metric-card\">\n          <div className=\"lw-metric-name\">Unique Actors</div>\n          <div className=\"lw-metric-value\">{catalystStats.uniqueActors}</div>\n        </div>\n      </div>\n\n      {catalystStats.topAgents.length > 0 && (\n        <div className=\"fd-section-spacer\">\n          <div className=\"fd-section-label\">\n            Top Agents by Actions\n          </div>\n          <div className=\"lw-flex-col lw-gap-sm\">\n            {catalystStats.topAgents.map((agent, i) => (\n              <div\n                key={agent.id}\n                className=\"lw-template-item fd-agent-item\"\n                style={{\n                  '--fd-agent-border-left': `3px solid ${i === 0 ? ACCENT_COLOR : \"var(--lw-border-color)\"}`,\n                }}\n              >\n                <span className=\"lw-template-name fd-agent-name\">\n                  {agent.name}\n                  <span className=\"fd-agent-kind\">\n                    ({agent.kind})\n                  </span>\n                </span>\n                <span className=\"lw-template-count\">{agent.actionCount}×</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {unusedCount > 0 && (\n        <div className=\"fd-section-spacer\">\n          <div className=\"lw-unused-header\" onClick={() => setShowUnused(!showUnused)} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n            <span className=\"lw-unused-toggle\">{showUnused ? \"▼\" : \"▶\"}</span>\n            <span className=\"lw-unused-title\">Unused Actions ({unusedCount})</span>\n          </div>\n          {showUnused && (\n            <div className=\"lw-unused-list\">\n              {catalystStats.unusedActions.map((action) => (\n                <div\n                  key={action.actionId}\n                  className=\"lw-template-item fd-unused-item\"\n                >\n                  <span className=\"lw-template-name fd-unused-name\">\n                    {action.actionName}\n                    <span className=\"fd-unused-kind\">\n                      ({action.actionId})\n                    </span>\n                  </span>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n\nfunction NotableEntitiesTab({ notableEntities }) {\n  return (\n    <div>\n      {notableEntities.mythic.length > 0 && (\n        <div className=\"fd-mythic-section\">\n          <div className=\"fd-mythic-label\">\n            <span>⭐</span> Mythic ({notableEntities.mythic.length})\n          </div>\n          <div className=\"lw-flex-col lw-gap-sm\">\n            {notableEntities.mythic.map((e) => (\n              <div\n                key={e.id}\n                className=\"lw-template-item fd-mythic-item\"\n              >\n                <span className=\"fd-entity-name\">{e.name}</span>\n                <span className=\"fd-entity-type\">\n                  {e.kind}:{e.subtype}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {notableEntities.renowned.length > 0 && (\n        <div>\n          <div className=\"fd-renowned-label\">\n            <span>★</span> Renowned ({notableEntities.renowned.length})\n          </div>\n          <div className=\"lw-flex-col lw-gap-sm\">\n            {notableEntities.renowned.slice(0, 10).map((e) => (\n              <div\n                key={e.id}\n                className=\"lw-template-item fd-renowned-item\"\n              >\n                <span className=\"fd-entity-name\">{e.name}</span>\n                <span className=\"fd-entity-type\">\n                  {e.kind}:{e.subtype}\n                </span>\n              </div>\n            ))}\n            {notableEntities.renowned.length > 10 && (\n              <div className=\"fd-more-label\">\n                +{notableEntities.renowned.length - 10} more\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {notableEntities.mythic.length === 0 && notableEntities.renowned.length === 0 && (\n        <div className=\"lw-empty-state\">\n          <span className=\"lw-empty-icon\">🌟</span>\n          <span>No notable entities yet</span>\n        </div>\n      )}\n    </div>\n  );\n}\n\nFinalDiagnostics.propTypes = {\n  entityBreakdown: PropTypes.object,\n  catalystStats: PropTypes.object,\n  relationshipBreakdown: PropTypes.object,\n  notableEntities: PropTypes.object,\n};\n\nEntityBreakdownTab.propTypes = {\n  entityBreakdown: PropTypes.object,\n};\n\nRelationshipBreakdownTab.propTypes = {\n  relationshipBreakdown: PropTypes.object,\n};\n\nAgentsTab.propTypes = {\n  catalystStats: PropTypes.object,\n};\n\nNotableEntitiesTab.propTypes = {\n  notableEntities: PropTypes.object,\n};\n","numLines":285,"startLine":1,"totalLines":285}}}
