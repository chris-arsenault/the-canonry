{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TnuDxj6NU6SaVc5hSoWuzB","type":"tool_result","content":"     1→/**\n     2→ * Card component styles\n     3→ */\n     4→\n     5→/* Base card */\n     6→.card {\n     7→  background-color: var(--color-bg-card);\n     8→  border-radius: var(--radius-2xl);\n     9→  border: 1px solid var(--color-border);\n    10→  padding: 20px;\n    11→  transition: all var(--transition-normal);\n    12→  position: relative;\n    13→}\n    14→\n    15→.card-clickable {\n    16→  cursor: pointer;\n    17→}\n    18→\n    19→.card-clickable:hover {\n    20→  border-color: var(--color-accent);\n    21→  transform: translateY(-2px);\n    22→  box-shadow: var(--shadow-card-hover);\n    23→}\n    24→\n    25→.card-disabled {\n    26→  opacity: 0.5;\n    27→}\n    28→\n    29→/* Card header */\n    30→.card-header {\n    31→  display: flex;\n    32→  align-items: flex-start;\n    33→  justify-content: space-between;\n    34→  margin-bottom: var(--spacing-lg);\n    35→}\n    36→\n    37→.card-title {\n    38→  font-size: var(--font-size-xl);\n    39→  font-weight: var(--font-weight-semibold);\n    40→  color: var(--color-text);\n    41→  margin-bottom: var(--spacing-xs);\n    42→}\n    43→\n    44→.card-id {\n    45→  font-size: var(--font-size-sm);\n    46→  color: var(--color-text-dim);\n    47→  font-family: monospace;\n    48→  background-color: var(--color-bg-dark);\n    49→  padding: 2px 6px;\n    50→  border-radius: var(--radius-sm);\n    51→}\n    52→\n    53→.card-desc {\n    54→  font-size: var(--font-size-md);\n    55→  color: var(--color-text-muted);\n    56→  margin-top: var(--spacing-md);\n    57→  line-height: var(--line-height-snug);\n    58→}\n    59→\n    60→/* Add card (dashed border style) */\n    61→.add-card {\n    62→  background-color: transparent;\n    63→  border-radius: var(--radius-2xl);\n    64→  border: 2px dashed var(--color-border);\n    65→  padding: 40px 20px;\n    66→  cursor: pointer;\n    67→  transition: all var(--transition-normal);\n    68→  display: flex;\n    69→  flex-direction: column;\n    70→  align-items: center;\n    71→  justify-content: center;\n    72→  gap: var(--spacing-md);\n    73→  color: var(--color-text-dim);\n    74→  min-height: 140px;\n    75→}\n    76→\n    77→.add-card:hover {\n    78→  border-color: var(--color-accent);\n    79→  color: var(--color-accent);\n    80→}\n    81→\n    82→.add-card-icon {\n    83→  font-size: 24px;\n    84→}\n    85→\n    86→/* Item card (collapsible) */\n    87→.item-card {\n    88→  background-color: var(--color-bg-dark);\n    89→  border-radius: var(--radius-xl);\n    90→  border: 1px solid var(--color-border-light);\n    91→  margin-bottom: var(--spacing-lg);\n    92→  overflow: hidden;\n    93→}\n    94→\n    95→.item-card-header {\n    96→  display: flex;\n    97→  align-items: center;\n    98→  justify-content: space-between;\n    99→  padding: var(--spacing-lg) var(--spacing-xl);\n   100→  background-color: var(--color-bg-card);\n   101→  cursor: pointer;\n   102→  transition: background-color var(--transition-fast);\n   103→}\n   104→\n   105→.item-card-header:hover,\n   106→.item-card-header-hover {\n   107→  background-color: rgb(59 130 246 / 10%);\n   108→}\n   109→\n   110→.item-card-icon {\n   111→  width: 36px;\n   112→  height: 36px;\n   113→  border-radius: var(--radius-md);\n   114→  display: flex;\n   115→  align-items: center;\n   116→  justify-content: center;\n   117→  font-size: var(--font-size-xl);\n   118→  background-color: rgb(59 130 246 / 20%);\n   119→  flex-shrink: 0;\n   120→}\n   121→\n   122→.item-card-icon-variable {\n   123→  background-color: rgb(168 85 247 / 20%);\n   124→}\n   125→\n   126→.item-card-icon-relationship {\n   127→  background-color: rgb(20 184 166 / 20%);\n   128→}\n   129→\n   130→.item-card-icon-creation {\n   131→  background-color: rgb(245 158 11 / 20%);\n   132→}\n   133→\n   134→.item-card-info {\n   135→  flex: 1;\n   136→  min-width: 0;\n   137→  margin-left: var(--spacing-lg);\n   138→}\n   139→\n   140→.item-card-title {\n   141→  font-size: var(--font-size-lg);\n   142→  font-weight: var(--font-weight-medium);\n   143→  color: var(--color-text);\n   144→  display: flex;\n   145→  align-items: center;\n   146→  gap: var(--spacing-md);\n   147→}\n   148→\n   149→.item-card-subtitle {\n   150→  font-size: var(--font-size-sm);\n   151→  color: var(--color-text-dim);\n   152→  margin-top: var(--spacing-xs);\n   153→}\n   154→\n   155→.item-card-actions {\n   156→  display: flex;\n   157→  align-items: center;\n   158→  gap: var(--spacing-sm);\n   159→}\n   160→\n   161→.item-card-body {\n   162→  padding: var(--spacing-xl);\n   163→}\n   164→\n   165→/* Variable/entity references */\n   166→.variable-ref,\n   167→.entity-ref {\n   168→  font-family: monospace;\n   169→  font-size: var(--font-size-lg);\n   170→  color: var(--color-purple);\n   171→  background-color: rgb(168 85 247 / 15%);\n   172→  padding: 2px 8px;\n   173→  border-radius: var(--radius-sm);\n   174→}\n   175→\n   176→/* Relationship visualization */\n   177→.rel-visual {\n   178→  display: flex;\n   179→  align-items: center;\n   180→  gap: var(--spacing-md);\n   181→  flex: 1;\n   182→}\n   183→\n   184→.rel-ref {\n   185→  font-family: monospace;\n   186→  font-size: var(--font-size-md);\n   187→  color: var(--color-purple);\n   188→  background-color: rgb(168 85 247 / 15%);\n   189→  padding: 2px 8px;\n   190→  border-radius: var(--radius-sm);\n   191→}\n   192→\n   193→.rel-arrow {\n   194→  color: var(--color-text-dim);\n   195→  font-size: var(--font-size-lg);\n   196→}\n   197→\n   198→.rel-kind {\n   199→  font-size: var(--font-size-md);\n   200→  color: var(--color-teal);\n   201→  background-color: rgb(20 184 166 / 15%);\n   202→  padding: 2px 8px;\n   203→  border-radius: var(--radius-sm);\n   204→}\n   205→\n   206→.rel-bidirectional {\n   207→  font-size: var(--font-size-lg);\n   208→  color: var(--color-accent);\n   209→  margin-left: var(--spacing-sm);\n   210→}\n   211→\n   212→/* Add form (inline add) */\n   213→.add-form {\n   214→  background-color: var(--color-bg-card);\n   215→  padding: var(--spacing-xl);\n   216→}\n   217→\n   218→.add-form-fields {\n   219→  display: flex;\n   220→  align-items: flex-end;\n   221→  gap: var(--spacing-lg);\n   222→}\n   223→\n   224→\n   225→/* Card stats row */\n   226→.card-stats {\n   227→  display: flex;\n   228→  gap: var(--spacing-xl);\n   229→  margin: var(--spacing-lg) 0;\n   230→  flex-wrap: wrap;\n   231→}\n   232→\n   233→.card-stat {\n   234→  display: flex;\n   235→  align-items: center;\n   236→  gap: var(--spacing-sm);\n   237→  font-size: var(--font-size-sm);\n   238→  color: var(--color-text-muted);\n   239→}\n   240→\n   241→/* Card badges container */\n   242→.card-badges {\n   243→  display: flex;\n   244→  flex-wrap: wrap;\n   245→  gap: var(--spacing-sm);\n   246→  margin-top: var(--spacing-md);\n   247→}\n   248→\n   249→/* Card validation states */\n   250→.card-error {\n   251→  border-color: var(--color-danger);\n   252→}\n   253→\n   254→.card-warning {\n   255→  border-color: var(--color-warning);\n   256→}\n   257→\n   258→/* Card inline badges */\n   259→.card-error-badge {\n   260→  font-size: var(--font-size-xs);\n   261→  padding: 2px 8px;\n   262→  border-radius: var(--radius-pill);\n   263→  background-color: rgb(239 68 68 / 20%);\n   264→  color: #fca5a5;\n   265→}\n   266→\n   267→.card-usage-badge {\n   268→  font-size: var(--font-size-xs);\n   269→  padding: 2px 8px;\n   270→  border-radius: var(--radius-pill);\n   271→  background-color: rgb(59 130 246 / 20%);\n   272→  color: #93c5fd;\n   273→}\n   274→\n   275→.card-orphan-badge {\n   276→  font-size: var(--font-size-xs);\n   277→  padding: 2px 8px;\n   278→  border-radius: var(--radius-pill);\n   279→  background-color: rgb(156 163 175 / 20%);\n   280→  color: #d1d5db;\n   281→}\n   282→\n   283→/* Card footer */\n   284→.card-footer {\n   285→  margin-top: var(--spacing-2xl);\n   286→  padding-top: var(--spacing-xl);\n   287→  border-top: 1px solid var(--color-border-light);\n   288→}\n   289→\n   290→/* Stat total (secondary count display) */\n   291→.stat-total {\n   292→  font-size: var(--font-size-sm);\n   293→  font-weight: var(--font-weight-normal);\n   294→  color: var(--color-text-dim);\n   295→}\n   296→\n   297→/* Weights accordion (used in Eras for generator/system weights) */\n   298→.weights-accordion {\n   299→  margin-top: var(--spacing-xl);\n   300→  border: 1px solid var(--color-border-light);\n   301→  border-radius: var(--radius-lg);\n   302→  overflow: hidden;\n   303→}\n   304→\n   305→.weights-accordion-header {\n   306→  display: flex;\n   307→  align-items: center;\n   308→  gap: var(--spacing-md);\n   309→  padding: var(--spacing-md) var(--spacing-lg);\n   310→  background-color: var(--color-bg-dark);\n   311→  cursor: pointer;\n   312→  transition: background-color var(--transition-fast);\n   313→}\n   314→\n   315→.weights-accordion-header:hover {\n   316→  background-color: rgb(59 130 246 / 10%);\n   317→}\n   318→\n   319→.weights-accordion-header.expanded {\n   320→  border-bottom: 1px solid var(--color-border-light);\n   321→}\n   322→\n   323→.weights-accordion-icon {\n   324→  font-size: var(--font-size-xs);\n   325→  color: var(--color-text-dim);\n   326→  transition: transform var(--transition-fast);\n   327→}\n   328→\n   329→.weights-accordion-title {\n   330→  font-size: var(--font-size-md);\n   331→  font-weight: var(--font-weight-medium);\n   332→  color: var(--color-text);\n   333→}\n   334→\n   335→.weights-accordion-summary {\n   336→  margin-left: auto;\n   337→  font-size: var(--font-size-sm);\n   338→  color: var(--color-text-muted);\n   339→}\n   340→\n   341→.weights-accordion-content {\n   342→  padding: var(--spacing-lg);\n   343→  background-color: var(--color-bg-card);\n   344→}\n   345→\n   346→/* Transitions Grid - Two-column layout for entry/exit */\n   347→.transitions-grid {\n   348→  display: grid;\n   349→  grid-template-columns: 1fr auto 1fr;\n   350→  gap: var(--spacing-lg);\n   351→  margin-top: var(--spacing-xl);\n   352→}\n   353→\n   354→.transitions-column {\n   355→  background-color: var(--color-bg-dark);\n   356→  border-radius: var(--radius-lg);\n   357→  border: 1px solid var(--color-border-light);\n   358→  overflow: hidden;\n   359→}\n   360→\n   361→.transitions-column-header {\n   362→  display: flex;\n   363→  align-items: center;\n   364→  gap: var(--spacing-sm);\n   365→  padding: var(--spacing-md) var(--spacing-lg);\n   366→  background-color: var(--color-bg-card);\n   367→  border-bottom: 1px solid var(--color-border-light);\n   368→}\n   369→\n   370→.transitions-entry .transitions-column-header {\n   371→  border-left: 3px solid var(--color-success);\n   372→}\n   373→\n   374→.transitions-exit .transitions-column-header {\n   375→  border-left: 3px solid var(--color-accent);\n   376→}\n   377→\n   378→.transitions-column-icon {\n   379→  font-size: var(--font-size-lg);\n   380→}\n   381→\n   382→.transitions-column-title {\n   383→  font-size: var(--font-size-lg);\n   384→  font-weight: var(--font-weight-semibold);\n   385→  color: var(--color-text);\n   386→}\n   387→\n   388→.transitions-column-subtitle {\n   389→  font-size: var(--font-size-sm);\n   390→  color: var(--color-text-muted);\n   391→  margin-left: auto;\n   392→}\n   393→\n   394→.transitions-divider {\n   395→  display: flex;\n   396→  align-items: center;\n   397→  justify-content: center;\n   398→  padding: var(--spacing-lg) 0;\n   399→}\n   400→\n   401→.transitions-arrow {\n   402→  font-size: 24px;\n   403→  color: var(--color-text-dim);\n   404→}\n   405→\n   406→/* Mini sections within transitions columns */\n   407→.transitions-mini-section {\n   408→  padding: var(--spacing-md) var(--spacing-lg);\n   409→  border-bottom: 1px solid var(--color-border-light);\n   410→}\n   411→\n   412→.transitions-mini-section:last-child {\n   413→  border-bottom: none;\n   414→}\n   415→\n   416→.transitions-mini-header {\n   417→  display: flex;\n   418→  align-items: center;\n   419→  gap: var(--spacing-sm);\n   420→  margin-bottom: var(--spacing-sm);\n   421→}\n   422→\n   423→.transitions-mini-icon {\n   424→  font-size: var(--font-size-sm);\n   425→  color: var(--color-text-dim);\n   426→}\n   427→\n   428→.transitions-mini-title {\n   429→  font-size: var(--font-size-sm);\n   430→  font-weight: var(--font-weight-medium);\n   431→  color: var(--color-text-secondary);\n   432→  text-transform: uppercase;\n   433→  letter-spacing: 0.5px;\n   434→}\n   435→\n   436→.transitions-mini-count {\n   437→  margin-left: auto;\n   438→  font-size: var(--font-size-xs);\n   439→  color: var(--color-text-muted);\n   440→  background-color: var(--color-bg-card);\n   441→  padding: 2px 8px;\n   442→  border-radius: var(--radius-pill);\n   443→}\n   444→\n   445→.transitions-mini-content {\n   446→  padding-left: var(--spacing-sm);\n   447→}\n   448→\n   449→.transitions-mini-empty {\n   450→  font-size: var(--font-size-sm);\n   451→  color: var(--color-text-muted);\n   452→  font-style: italic;\n   453→  padding: var(--spacing-sm) 0;\n   454→}\n   455→\n   456→.transitions-add-effect {\n   457→  margin-top: var(--spacing-sm);\n   458→}\n   459→\n   460→/* Responsive: stack on smaller screens */\n   461→@media (width <= 900px) {\n   462→  .transitions-grid {\n   463→    grid-template-columns: 1fr;\n   464→    gap: var(--spacing-md);\n   465→  }\n   466→\n   467→  .transitions-divider {\n   468→    display: none;\n   469→  }\n   470→}\n   471→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"e3e54894-fac7-4749-9942-07ff8a22aa5c","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/card.css","content":"/**\n * Card component styles\n */\n\n/* Base card */\n.card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  padding: 20px;\n  transition: all var(--transition-normal);\n  position: relative;\n}\n\n.card-clickable {\n  cursor: pointer;\n}\n\n.card-clickable:hover {\n  border-color: var(--color-accent);\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-card-hover);\n}\n\n.card-disabled {\n  opacity: 0.5;\n}\n\n/* Card header */\n.card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: var(--spacing-lg);\n}\n\n.card-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-xs);\n}\n\n.card-id {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  font-family: monospace;\n  background-color: var(--color-bg-dark);\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n}\n\n.card-desc {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin-top: var(--spacing-md);\n  line-height: var(--line-height-snug);\n}\n\n/* Add card (dashed border style) */\n.add-card {\n  background-color: transparent;\n  border-radius: var(--radius-2xl);\n  border: 2px dashed var(--color-border);\n  padding: 40px 20px;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  color: var(--color-text-dim);\n  min-height: 140px;\n}\n\n.add-card:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.add-card-icon {\n  font-size: 24px;\n}\n\n/* Item card (collapsible) */\n.item-card {\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-xl);\n  border: 1px solid var(--color-border-light);\n  margin-bottom: var(--spacing-lg);\n  overflow: hidden;\n}\n\n.item-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--spacing-lg) var(--spacing-xl);\n  background-color: var(--color-bg-card);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.item-card-header:hover,\n.item-card-header-hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.item-card-icon {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-md);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-xl);\n  background-color: rgb(59 130 246 / 20%);\n  flex-shrink: 0;\n}\n\n.item-card-icon-variable {\n  background-color: rgb(168 85 247 / 20%);\n}\n\n.item-card-icon-relationship {\n  background-color: rgb(20 184 166 / 20%);\n}\n\n.item-card-icon-creation {\n  background-color: rgb(245 158 11 / 20%);\n}\n\n.item-card-info {\n  flex: 1;\n  min-width: 0;\n  margin-left: var(--spacing-lg);\n}\n\n.item-card-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.item-card-subtitle {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  margin-top: var(--spacing-xs);\n}\n\n.item-card-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.item-card-body {\n  padding: var(--spacing-xl);\n}\n\n/* Variable/entity references */\n.variable-ref,\n.entity-ref {\n  font-family: monospace;\n  font-size: var(--font-size-lg);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n/* Relationship visualization */\n.rel-visual {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 1;\n}\n\n.rel-ref {\n  font-family: monospace;\n  font-size: var(--font-size-md);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-arrow {\n  color: var(--color-text-dim);\n  font-size: var(--font-size-lg);\n}\n\n.rel-kind {\n  font-size: var(--font-size-md);\n  color: var(--color-teal);\n  background-color: rgb(20 184 166 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-bidirectional {\n  font-size: var(--font-size-lg);\n  color: var(--color-accent);\n  margin-left: var(--spacing-sm);\n}\n\n/* Add form (inline add) */\n.add-form {\n  background-color: var(--color-bg-card);\n  padding: var(--spacing-xl);\n}\n\n.add-form-fields {\n  display: flex;\n  align-items: flex-end;\n  gap: var(--spacing-lg);\n}\n\n\n/* Card stats row */\n.card-stats {\n  display: flex;\n  gap: var(--spacing-xl);\n  margin: var(--spacing-lg) 0;\n  flex-wrap: wrap;\n}\n\n.card-stat {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n/* Card badges container */\n.card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-md);\n}\n\n/* Card validation states */\n.card-error {\n  border-color: var(--color-danger);\n}\n\n.card-warning {\n  border-color: var(--color-warning);\n}\n\n/* Card inline badges */\n.card-error-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(239 68 68 / 20%);\n  color: #fca5a5;\n}\n\n.card-usage-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(59 130 246 / 20%);\n  color: #93c5fd;\n}\n\n.card-orphan-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(156 163 175 / 20%);\n  color: #d1d5db;\n}\n\n/* Card footer */\n.card-footer {\n  margin-top: var(--spacing-2xl);\n  padding-top: var(--spacing-xl);\n  border-top: 1px solid var(--color-border-light);\n}\n\n/* Stat total (secondary count display) */\n.stat-total {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-normal);\n  color: var(--color-text-dim);\n}\n\n/* Weights accordion (used in Eras for generator/system weights) */\n.weights-accordion {\n  margin-top: var(--spacing-xl);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n}\n\n.weights-accordion-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.weights-accordion-header:hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.weights-accordion-header.expanded {\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.weights-accordion-icon {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  transition: transform var(--transition-fast);\n}\n\n.weights-accordion-title {\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n}\n\n.weights-accordion-summary {\n  margin-left: auto;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n.weights-accordion-content {\n  padding: var(--spacing-lg);\n  background-color: var(--color-bg-card);\n}\n\n/* Transitions Grid - Two-column layout for entry/exit */\n.transitions-grid {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: var(--spacing-lg);\n  margin-top: var(--spacing-xl);\n}\n\n.transitions-column {\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-lg);\n  border: 1px solid var(--color-border-light);\n  overflow: hidden;\n}\n\n.transitions-column-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-card);\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.transitions-entry .transitions-column-header {\n  border-left: 3px solid var(--color-success);\n}\n\n.transitions-exit .transitions-column-header {\n  border-left: 3px solid var(--color-accent);\n}\n\n.transitions-column-icon {\n  font-size: var(--font-size-lg);\n}\n\n.transitions-column-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.transitions-column-subtitle {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  margin-left: auto;\n}\n\n.transitions-divider {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-lg) 0;\n}\n\n.transitions-arrow {\n  font-size: 24px;\n  color: var(--color-text-dim);\n}\n\n/* Mini sections within transitions columns */\n.transitions-mini-section {\n  padding: var(--spacing-md) var(--spacing-lg);\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.transitions-mini-section:last-child {\n  border-bottom: none;\n}\n\n.transitions-mini-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  margin-bottom: var(--spacing-sm);\n}\n\n.transitions-mini-icon {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n}\n\n.transitions-mini-title {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.transitions-mini-count {\n  margin-left: auto;\n  font-size: var(--font-size-xs);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-card);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n}\n\n.transitions-mini-content {\n  padding-left: var(--spacing-sm);\n}\n\n.transitions-mini-empty {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  font-style: italic;\n  padding: var(--spacing-sm) 0;\n}\n\n.transitions-add-effect {\n  margin-top: var(--spacing-sm);\n}\n\n/* Responsive: stack on smaller screens */\n@media (width <= 900px) {\n  .transitions-grid {\n    grid-template-columns: 1fr;\n    gap: var(--spacing-md);\n  }\n\n  .transitions-divider {\n    display: none;\n  }\n}\n","numLines":471,"startLine":1,"totalLines":471}}}
