{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012myYSKRr3HCJxEz6Nfj7gm","type":"tool_result","content":"     1→/**\n     2→ * BulkChronicleAnnotationModal - Progress display for bulk chronicle annotation operations\n     3→ *\n     4→ * Handles both \"Run Annotations\" and \"Clear Annotations\" workflows.\n     5→ * Three phases following BulkOperationShell pattern:\n     6→ * 1. Confirmation: chronicle list with tones and warning info\n     7→ * 2. Processing: progress bar, current chronicle, tone info\n     8→ * 3. Terminal: completion/cancellation/failure message\n     9→ */\n    10→\n    11→import React from \"react\";\n    12→import PropTypes from \"prop-types\";\n    13→import BulkOperationShell, {\n    14→  BulkProgressBar,\n    15→  BulkTerminalMessage,\n    16→  BulkFailedList,\n    17→  BulkCost,\n    18→} from \"./BulkOperationShell\";\n    19→import \"./BulkChronicleAnnotationModal.css\";\n    20→\n    21→function getStatusText(progress) {\n    22→  if (progress.status === \"confirming\") return `${progress.totalChronicles} chronicles`;\n    23→  if (progress.status === \"running\")\n    24→    return `${progress.processedChronicles}/${progress.totalChronicles}`;\n    25→  if (progress.status === \"complete\") return \"Complete\";\n    26→  if (progress.status === \"cancelled\") return \"Cancelled\";\n    27→  if (progress.status === \"failed\") return \"Failed\";\n    28→  return \"\";\n    29→}\n    30→\n    31→function getPillText(progress) {\n    32→  if (progress.status === \"running\")\n    33→    return `${progress.processedChronicles}/${progress.totalChronicles}`;\n    34→  if (progress.status === \"complete\") return \"Complete\";\n    35→  if (progress.status === \"failed\") return \"Failed\";\n    36→  if (progress.status === \"cancelled\") return \"Cancelled\";\n    37→  return \"\";\n    38→}\n    39→\n    40→export default function BulkChronicleAnnotationModal({ progress, onConfirm, onCancel, onClose }) {\n    41→  const isClear = progress?.operation === \"clear\";\n    42→  const title = isClear ? \"Clear Annotations\" : \"Run Annotations\";\n    43→  const isConfirming = progress?.status === \"confirming\";\n    44→  const isTerminal =\n    45→    progress?.status === \"complete\" ||\n    46→    progress?.status === \"cancelled\" ||\n    47→    progress?.status === \"failed\";\n    48→\n    49→  const withNotes = progress?.chronicles?.filter((c) => c.hasNotes).length || 0;\n    50→  const withTones = progress?.chronicles?.filter((c) => c.assignedTone).length || 0;\n    51→\n    52→  const confirmLabel = isClear\n    53→    ? `Clear (${progress?.totalChronicles || 0} chronicles)`\n    54→    : `Annotate (${progress?.totalChronicles || 0} chronicles)`;\n    55→\n    56→  return (\n    57→    <BulkOperationShell\n    58→      pillId=\"bulk-chronicle-annotation\"\n    59→      title={title}\n    60→      tabId=\"chronicle\"\n    61→      progress={progress}\n    62→      onConfirm={onConfirm}\n    63→      onCancel={onCancel}\n    64→      onClose={onClose}\n    65→      confirmLabel={confirmLabel}\n    66→      statusText={progress ? getStatusText(progress) : \"\"}\n    67→      pillStatusText={progress ? getPillText(progress) : \"\"}\n    68→    >\n    69→      {/* Confirmation screen */}\n    70→      {isConfirming && (\n    71→        <>\n    72→          <div className=\"bulk-info-box\">\n    73→            {isClear ? (\n    74→              <>\n    75→                This will clear all historian annotations from {progress.totalChronicles}{\" \"}\n    76→                chronicle{progress.totalChronicles !== 1 ? \"s\" : \"\"}. Annotations cannot be\n    77→                recovered after clearing.\n    78→              </>\n    79→            ) : (\n    80→              <>\n    81→                Each chronicle gets a historian review using its assigned tone. Results are\n    82→                auto-applied (no manual review step). Chronicles processed sequentially — one\n    83→                LLM call each.\n    84→                {withTones < progress.totalChronicles && (\n    85→                  <span className=\"bcam-warning-text\">\n    86→                    {\" \"}\n    87→                    {progress.totalChronicles - withTones} chronicle\n    88→                    {progress.totalChronicles - withTones !== 1 ? \"s\" : \"\"} have no assigned\n    89→                    tone and will default to &quot;weary&quot;.\n    90→                  </span>\n    91→                )}\n    92→                {withNotes > 0 && (\n    93→                  <span className=\"bcam-warning-text\">\n    94→                    {\" \"}\n    95→                    {withNotes} chronicle{withNotes !== 1 ? \"s\" : \"\"} already have annotations —\n    96→                    they will be replaced.\n    97→                  </span>\n    98→                )}\n    99→              </>\n   100→            )}\n   101→          </div>\n   102→\n   103→          {/* Chronicle list */}\n   104→          <div className=\"bulk-item-list-section\">\n   105→            <div className=\"bulk-section-label\">\n   106→              Chronicles ({progress.chronicles.length})\n   107→            </div>\n   108→\n   109→            <div className=\"bulk-item-list\">\n   110→              {progress.chronicles.map((chron) => (\n   111→                <div key={chron.chronicleId} className=\"bcam-chronicle-item\">\n   112→                  <span className=\"bcam-chronicle-title\">{chron.title}</span>\n   113→                  {!isClear && (\n   114→                    <span className=\"bcam-chronicle-tone\">\n   115→                      {chron.assignedTone || \"weary\"}\n   116→                      {chron.hasNotes ? \" ✎\" : \"\"}\n   117→                    </span>\n   118→                  )}\n   119→                </div>\n   120→              ))}\n   121→            </div>\n   122→          </div>\n   123→        </>\n   124→      )}\n   125→\n   126→      {/* Processing / Terminal screen */}\n   127→      {!isConfirming && progress?.status !== \"idle\" && (\n   128→        <>\n   129→          {progress.status === \"running\" && (\n   130→            <>\n   131→              <div className=\"bcam-current-title\">\n   132→                {progress.currentTitle || (isClear ? \"Clearing...\" : \"Annotating...\")}\n   133→              </div>\n   134→\n   135→              <BulkProgressBar\n   136→                processed={progress.processedChronicles}\n   137→                total={progress.totalChronicles}\n   138→                status={progress.status}\n   139→              />\n   140→\n   141→              <div className=\"bcam-progress-stats\">\n   142→                <span>\n   143→                  {progress.processedChronicles} / {progress.totalChronicles}{\" \"}\n   144→                  {isClear ? \"cleared\" : \"annotated\"}\n   145→                </span>\n   146→                {!isClear && progress.currentTone && (\n   147→                  <span>tone: {progress.currentTone}</span>\n   148→                )}\n   149→              </div>\n   150→            </>\n   151→          )}\n   152→\n   153→          {progress.status === \"complete\" && (\n   154→            <BulkTerminalMessage status=\"complete\">\n   155→              {isClear\n   156→                ? `Cleared annotations from ${progress.processedChronicles} chronicle${progress.processedChronicles !== 1 ? \"s\" : \"\"}.`\n   157→                : `Annotated ${progress.processedChronicles} of ${progress.totalChronicles} chronicles.`}\n   158→              {progress.failedChronicles.length > 0 &&\n   159→                ` (${progress.failedChronicles.length} failed)`}\n   160→            </BulkTerminalMessage>\n   161→          )}\n   162→\n   163→          {progress.status === \"cancelled\" && (\n   164→            <BulkTerminalMessage status=\"cancelled\">\n   165→              Cancelled after {progress.processedChronicles} of {progress.totalChronicles}{\" \"}\n   166→              chronicles.\n   167→            </BulkTerminalMessage>\n   168→          )}\n   169→\n   170→          {progress.status === \"failed\" && (\n   171→            <BulkTerminalMessage status=\"failed\">\n   172→              {progress.error || \"An unexpected error occurred.\"}\n   173→            </BulkTerminalMessage>\n   174→          )}\n   175→\n   176→          {isTerminal && (\n   177→            <BulkFailedList\n   178→              items={progress.failedChronicles}\n   179→              labelKey=\"title\"\n   180→              errorKey=\"error\"\n   181→            />\n   182→          )}\n   183→\n   184→          <BulkCost cost={progress.totalCost} />\n   185→        </>\n   186→      )}\n   187→    </BulkOperationShell>\n   188→  );\n   189→}\n   190→\n   191→BulkChronicleAnnotationModal.propTypes = {\n   192→  progress: PropTypes.object,\n   193→  onConfirm: PropTypes.func.isRequired,\n   194→  onCancel: PropTypes.func.isRequired,\n   195→  onClose: PropTypes.func.isRequired,\n   196→};\n   197→"}]},"parent_tool_use_id":null,"session_id":"32340847-edea-48f0-bd01-a0b1ba1c9fbd","uuid":"f7574127-3d09-4da1-97b1-6966dbccc2b3","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BulkChronicleAnnotationModal.jsx","content":"/**\n * BulkChronicleAnnotationModal - Progress display for bulk chronicle annotation operations\n *\n * Handles both \"Run Annotations\" and \"Clear Annotations\" workflows.\n * Three phases following BulkOperationShell pattern:\n * 1. Confirmation: chronicle list with tones and warning info\n * 2. Processing: progress bar, current chronicle, tone info\n * 3. Terminal: completion/cancellation/failure message\n */\n\nimport React from \"react\";\nimport PropTypes from \"prop-types\";\nimport BulkOperationShell, {\n  BulkProgressBar,\n  BulkTerminalMessage,\n  BulkFailedList,\n  BulkCost,\n} from \"./BulkOperationShell\";\nimport \"./BulkChronicleAnnotationModal.css\";\n\nfunction getStatusText(progress) {\n  if (progress.status === \"confirming\") return `${progress.totalChronicles} chronicles`;\n  if (progress.status === \"running\")\n    return `${progress.processedChronicles}/${progress.totalChronicles}`;\n  if (progress.status === \"complete\") return \"Complete\";\n  if (progress.status === \"cancelled\") return \"Cancelled\";\n  if (progress.status === \"failed\") return \"Failed\";\n  return \"\";\n}\n\nfunction getPillText(progress) {\n  if (progress.status === \"running\")\n    return `${progress.processedChronicles}/${progress.totalChronicles}`;\n  if (progress.status === \"complete\") return \"Complete\";\n  if (progress.status === \"failed\") return \"Failed\";\n  if (progress.status === \"cancelled\") return \"Cancelled\";\n  return \"\";\n}\n\nexport default function BulkChronicleAnnotationModal({ progress, onConfirm, onCancel, onClose }) {\n  const isClear = progress?.operation === \"clear\";\n  const title = isClear ? \"Clear Annotations\" : \"Run Annotations\";\n  const isConfirming = progress?.status === \"confirming\";\n  const isTerminal =\n    progress?.status === \"complete\" ||\n    progress?.status === \"cancelled\" ||\n    progress?.status === \"failed\";\n\n  const withNotes = progress?.chronicles?.filter((c) => c.hasNotes).length || 0;\n  const withTones = progress?.chronicles?.filter((c) => c.assignedTone).length || 0;\n\n  const confirmLabel = isClear\n    ? `Clear (${progress?.totalChronicles || 0} chronicles)`\n    : `Annotate (${progress?.totalChronicles || 0} chronicles)`;\n\n  return (\n    <BulkOperationShell\n      pillId=\"bulk-chronicle-annotation\"\n      title={title}\n      tabId=\"chronicle\"\n      progress={progress}\n      onConfirm={onConfirm}\n      onCancel={onCancel}\n      onClose={onClose}\n      confirmLabel={confirmLabel}\n      statusText={progress ? getStatusText(progress) : \"\"}\n      pillStatusText={progress ? getPillText(progress) : \"\"}\n    >\n      {/* Confirmation screen */}\n      {isConfirming && (\n        <>\n          <div className=\"bulk-info-box\">\n            {isClear ? (\n              <>\n                This will clear all historian annotations from {progress.totalChronicles}{\" \"}\n                chronicle{progress.totalChronicles !== 1 ? \"s\" : \"\"}. Annotations cannot be\n                recovered after clearing.\n              </>\n            ) : (\n              <>\n                Each chronicle gets a historian review using its assigned tone. Results are\n                auto-applied (no manual review step). Chronicles processed sequentially — one\n                LLM call each.\n                {withTones < progress.totalChronicles && (\n                  <span className=\"bcam-warning-text\">\n                    {\" \"}\n                    {progress.totalChronicles - withTones} chronicle\n                    {progress.totalChronicles - withTones !== 1 ? \"s\" : \"\"} have no assigned\n                    tone and will default to &quot;weary&quot;.\n                  </span>\n                )}\n                {withNotes > 0 && (\n                  <span className=\"bcam-warning-text\">\n                    {\" \"}\n                    {withNotes} chronicle{withNotes !== 1 ? \"s\" : \"\"} already have annotations —\n                    they will be replaced.\n                  </span>\n                )}\n              </>\n            )}\n          </div>\n\n          {/* Chronicle list */}\n          <div className=\"bulk-item-list-section\">\n            <div className=\"bulk-section-label\">\n              Chronicles ({progress.chronicles.length})\n            </div>\n\n            <div className=\"bulk-item-list\">\n              {progress.chronicles.map((chron) => (\n                <div key={chron.chronicleId} className=\"bcam-chronicle-item\">\n                  <span className=\"bcam-chronicle-title\">{chron.title}</span>\n                  {!isClear && (\n                    <span className=\"bcam-chronicle-tone\">\n                      {chron.assignedTone || \"weary\"}\n                      {chron.hasNotes ? \" ✎\" : \"\"}\n                    </span>\n                  )}\n                </div>\n              ))}\n            </div>\n          </div>\n        </>\n      )}\n\n      {/* Processing / Terminal screen */}\n      {!isConfirming && progress?.status !== \"idle\" && (\n        <>\n          {progress.status === \"running\" && (\n            <>\n              <div className=\"bcam-current-title\">\n                {progress.currentTitle || (isClear ? \"Clearing...\" : \"Annotating...\")}\n              </div>\n\n              <BulkProgressBar\n                processed={progress.processedChronicles}\n                total={progress.totalChronicles}\n                status={progress.status}\n              />\n\n              <div className=\"bcam-progress-stats\">\n                <span>\n                  {progress.processedChronicles} / {progress.totalChronicles}{\" \"}\n                  {isClear ? \"cleared\" : \"annotated\"}\n                </span>\n                {!isClear && progress.currentTone && (\n                  <span>tone: {progress.currentTone}</span>\n                )}\n              </div>\n            </>\n          )}\n\n          {progress.status === \"complete\" && (\n            <BulkTerminalMessage status=\"complete\">\n              {isClear\n                ? `Cleared annotations from ${progress.processedChronicles} chronicle${progress.processedChronicles !== 1 ? \"s\" : \"\"}.`\n                : `Annotated ${progress.processedChronicles} of ${progress.totalChronicles} chronicles.`}\n              {progress.failedChronicles.length > 0 &&\n                ` (${progress.failedChronicles.length} failed)`}\n            </BulkTerminalMessage>\n          )}\n\n          {progress.status === \"cancelled\" && (\n            <BulkTerminalMessage status=\"cancelled\">\n              Cancelled after {progress.processedChronicles} of {progress.totalChronicles}{\" \"}\n              chronicles.\n            </BulkTerminalMessage>\n          )}\n\n          {progress.status === \"failed\" && (\n            <BulkTerminalMessage status=\"failed\">\n              {progress.error || \"An unexpected error occurred.\"}\n            </BulkTerminalMessage>\n          )}\n\n          {isTerminal && (\n            <BulkFailedList\n              items={progress.failedChronicles}\n              labelKey=\"title\"\n              errorKey=\"error\"\n            />\n          )}\n\n          <BulkCost cost={progress.totalCost} />\n        </>\n      )}\n    </BulkOperationShell>\n  );\n}\n\nBulkChronicleAnnotationModal.propTypes = {\n  progress: PropTypes.object,\n  onConfirm: PropTypes.func.isRequired,\n  onCancel: PropTypes.func.isRequired,\n  onClose: PropTypes.func.isRequired,\n};\n","numLines":197,"startLine":1,"totalLines":197}}}
