{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bovk8hqJgRKvhMwgnQhciw","type":"tool_result","content":"     1→// drift-generated\n     2→/**\n     3→ * Bans per-component visualization overlay CSS class names that were unified\n     4→ * into the shared visualization-overlay.css pattern.\n     5→ *\n     6→ * The canonical approach uses `viz-*` classes (viz-container, viz-legend,\n     7→ * viz-controls, viz-no-webgl, etc.) with theme variants via viz-theme-blue\n     8→ * and viz-theme-golden.\n     9→ *\n    10→ * Old per-component prefixes (gv-wrapper, gv-legend, gv-controls, gv3d-*,\n    11→ * tv3d-container, tv3d-legend, tv3d-controls, tv3d-no-webgl) are banned.\n    12→ */\n    13→\n    14→// Banned class name patterns — old per-component overlay classes.\n    15→// Component-specific classes that DON'T overlap with shared patterns are allowed:\n    16→//   gv-cytoscape, gv-shape-*, tv3d-era-swatch, tv3d-era-link\n    17→const BANNED_PATTERNS = [\n    18→  // Old GraphView overlay classes (replaced by viz-*)\n    19→  /\\bgv-wrapper\\b/,\n    20→  /\\bgv-legend\\b/,\n    21→  /\\bgv-legend-header\\b/,\n    22→  /\\bgv-legend-footer\\b/,\n    23→  /\\bgv-legend-swatch\\b/,\n    24→  /\\bgv-controls\\b/,\n    25→  /\\bgv-controls-header\\b/,\n    26→  // Old GraphView3D overlay classes (replaced by viz-*)\n    27→  /\\bgv3d-/,\n    28→  // Old TimelineView3D overlay classes (replaced by viz-*)\n    29→  /\\btv3d-container\\b/,\n    30→  /\\btv3d-legend\\b/,\n    31→  /\\btv3d-legend-header\\b/,\n    32→  /\\btv3d-legend-footer\\b/,\n    33→  /\\btv3d-legend-swatch\\b/,\n    34→  /\\btv3d-controls\\b/,\n    35→  /\\btv3d-controls-header\\b/,\n    36→  /\\btv3d-no-webgl/,\n    37→];\n    38→\n    39→// Old per-component CSS custom property names\n    40→const BANNED_CSS_VARS = [\n    41→  \"--gv-swatch-color\",\n    42→  \"--gv3d-swatch-color\",\n    43→  \"--tv3d-swatch-color\",\n    44→];\n    45→\n    46→export default {\n    47→  meta: {\n    48→    type: \"suggestion\",\n    49→    docs: {\n    50→      description:\n    51→        \"Bans old per-component visualization overlay CSS classes. \" +\n    52→        \"Use the shared viz-* classes from visualization-overlay.css instead.\",\n    53→    },\n    54→    messages: {\n    55→      bannedClassName:\n    56→        \"CSS class '{{className}}' is a deprecated per-component overlay class. \" +\n    57→        \"Use the shared viz-* classes from visualization-overlay.css instead \" +\n    58→        \"(e.g., viz-container, viz-legend, viz-controls, viz-no-webgl). \" +\n    59→        \"See docs/adr/026-visualization-overlay-css.md\",\n    60→      bannedCssVar:\n    61→        \"CSS variable '{{varName}}' is deprecated. \" +\n    62→        \"Use '--viz-swatch-color' instead. \" +\n    63→        \"See docs/adr/026-visualization-overlay-css.md\",\n    64→    },\n    65→    schema: [],\n    66→  },\n    67→\n    68→  create(context) {\n    69→    const filename = context.filename || context.getFilename();\n    70→    // Only apply to archivist visualization components\n    71→    if (!filename.includes(\"archivist\")) return {};\n    72→\n    73→    function checkStringForBannedClasses(node, value) {\n    74→      for (const pattern of BANNED_PATTERNS) {\n    75→        const match = value.match(pattern);\n    76→        if (match) {\n    77→          context.report({\n    78→            node,\n    79→            messageId: \"bannedClassName\",\n    80→            data: { className: match[0] },\n    81→          });\n    82→          return; // one report per string is enough\n    83→        }\n    84→      }\n    85→    }\n    86→\n    87→    function checkStringForBannedVars(node, value) {\n    88→      for (const varName of BANNED_CSS_VARS) {\n    89→        if (value.includes(varName)) {\n    90→          context.report({\n    91→            node,\n    92→            messageId: \"bannedCssVar\",\n    93→            data: { varName },\n    94→          });\n    95→          return;\n    96→        }\n    97→      }\n    98→    }\n    99→\n   100→    return {\n   101→      // Check className=\"...\" string literals\n   102→      JSXAttribute(node) {\n   103→        if (node.name.name !== \"className\") return;\n   104→\n   105→        // className=\"literal string\"\n   106→        if (node.value && node.value.type === \"Literal\" && typeof node.value.value === \"string\") {\n   107→          checkStringForBannedClasses(node, node.value.value);\n   108→        }\n   109→\n   110→        // className={`template ${literal}`}\n   111→        if (node.value && node.value.type === \"JSXExpressionContainer\") {\n   112→          const expr = node.value.expression;\n   113→          if (expr.type === \"TemplateLiteral\") {\n   114→            for (const quasi of expr.quasis) {\n   115→              checkStringForBannedClasses(node, quasi.value.raw);\n   116→            }\n   117→          }\n   118→          // className={\"literal\"}\n   119→          if (expr.type === \"Literal\" && typeof expr.value === \"string\") {\n   120→            checkStringForBannedClasses(node, expr.value);\n   121→          }\n   122→        }\n   123→      },\n   124→\n   125→      // Check style={{ '--old-var': ... }} property names\n   126→      Property(node) {\n   127→        if (node.key.type === \"Literal\" && typeof node.key.value === \"string\") {\n   128→          checkStringForBannedVars(node, node.key.value);\n   129→        }\n   130→      },\n   131→    };\n   132→  },\n   133→};\n   134→"}]},"parent_tool_use_id":null,"session_id":"812a01ec-29f8-4366-9586-7e3a066a23eb","uuid":"2f7556f8-739a-4ef1-9d25-e3aa1937f4c6","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/eslint-rules/no-viz-overlay-drift.js","content":"// drift-generated\n/**\n * Bans per-component visualization overlay CSS class names that were unified\n * into the shared visualization-overlay.css pattern.\n *\n * The canonical approach uses `viz-*` classes (viz-container, viz-legend,\n * viz-controls, viz-no-webgl, etc.) with theme variants via viz-theme-blue\n * and viz-theme-golden.\n *\n * Old per-component prefixes (gv-wrapper, gv-legend, gv-controls, gv3d-*,\n * tv3d-container, tv3d-legend, tv3d-controls, tv3d-no-webgl) are banned.\n */\n\n// Banned class name patterns — old per-component overlay classes.\n// Component-specific classes that DON'T overlap with shared patterns are allowed:\n//   gv-cytoscape, gv-shape-*, tv3d-era-swatch, tv3d-era-link\nconst BANNED_PATTERNS = [\n  // Old GraphView overlay classes (replaced by viz-*)\n  /\\bgv-wrapper\\b/,\n  /\\bgv-legend\\b/,\n  /\\bgv-legend-header\\b/,\n  /\\bgv-legend-footer\\b/,\n  /\\bgv-legend-swatch\\b/,\n  /\\bgv-controls\\b/,\n  /\\bgv-controls-header\\b/,\n  // Old GraphView3D overlay classes (replaced by viz-*)\n  /\\bgv3d-/,\n  // Old TimelineView3D overlay classes (replaced by viz-*)\n  /\\btv3d-container\\b/,\n  /\\btv3d-legend\\b/,\n  /\\btv3d-legend-header\\b/,\n  /\\btv3d-legend-footer\\b/,\n  /\\btv3d-legend-swatch\\b/,\n  /\\btv3d-controls\\b/,\n  /\\btv3d-controls-header\\b/,\n  /\\btv3d-no-webgl/,\n];\n\n// Old per-component CSS custom property names\nconst BANNED_CSS_VARS = [\n  \"--gv-swatch-color\",\n  \"--gv3d-swatch-color\",\n  \"--tv3d-swatch-color\",\n];\n\nexport default {\n  meta: {\n    type: \"suggestion\",\n    docs: {\n      description:\n        \"Bans old per-component visualization overlay CSS classes. \" +\n        \"Use the shared viz-* classes from visualization-overlay.css instead.\",\n    },\n    messages: {\n      bannedClassName:\n        \"CSS class '{{className}}' is a deprecated per-component overlay class. \" +\n        \"Use the shared viz-* classes from visualization-overlay.css instead \" +\n        \"(e.g., viz-container, viz-legend, viz-controls, viz-no-webgl). \" +\n        \"See docs/adr/026-visualization-overlay-css.md\",\n      bannedCssVar:\n        \"CSS variable '{{varName}}' is deprecated. \" +\n        \"Use '--viz-swatch-color' instead. \" +\n        \"See docs/adr/026-visualization-overlay-css.md\",\n    },\n    schema: [],\n  },\n\n  create(context) {\n    const filename = context.filename || context.getFilename();\n    // Only apply to archivist visualization components\n    if (!filename.includes(\"archivist\")) return {};\n\n    function checkStringForBannedClasses(node, value) {\n      for (const pattern of BANNED_PATTERNS) {\n        const match = value.match(pattern);\n        if (match) {\n          context.report({\n            node,\n            messageId: \"bannedClassName\",\n            data: { className: match[0] },\n          });\n          return; // one report per string is enough\n        }\n      }\n    }\n\n    function checkStringForBannedVars(node, value) {\n      for (const varName of BANNED_CSS_VARS) {\n        if (value.includes(varName)) {\n          context.report({\n            node,\n            messageId: \"bannedCssVar\",\n            data: { varName },\n          });\n          return;\n        }\n      }\n    }\n\n    return {\n      // Check className=\"...\" string literals\n      JSXAttribute(node) {\n        if (node.name.name !== \"className\") return;\n\n        // className=\"literal string\"\n        if (node.value && node.value.type === \"Literal\" && typeof node.value.value === \"string\") {\n          checkStringForBannedClasses(node, node.value.value);\n        }\n\n        // className={`template ${literal}`}\n        if (node.value && node.value.type === \"JSXExpressionContainer\") {\n          const expr = node.value.expression;\n          if (expr.type === \"TemplateLiteral\") {\n            for (const quasi of expr.quasis) {\n              checkStringForBannedClasses(node, quasi.value.raw);\n            }\n          }\n          // className={\"literal\"}\n          if (expr.type === \"Literal\" && typeof expr.value === \"string\") {\n            checkStringForBannedClasses(node, expr.value);\n          }\n        }\n      },\n\n      // Check style={{ '--old-var': ... }} property names\n      Property(node) {\n        if (node.key.type === \"Literal\" && typeof node.key.value === \"string\") {\n          checkStringForBannedVars(node, node.key.value);\n        }\n      },\n    };\n  },\n};\n","numLines":134,"startLine":1,"totalLines":134}}}
