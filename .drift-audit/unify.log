{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TRCCQyN7os25m2sRmXwzFC","type":"tool_result","content":"     1→/**\n     2→ * TimelineBrush - Draggable range selection for timeline\n     3→ *\n     4→ * Allows users to select a time range by dragging handles or the selection itself.\n     5→ * Much faster than individual checkboxes for bulk selection.\n     6→ */\n     7→\n     8→import React, { useState, useCallback, useRef, useEffect } from \"react\";\n     9→import { tickToX, xToTick } from \"../../../lib/chronicle/timelineUtils\";\n    10→import \"./TimelineBrush.css\";\n    11→\n    12→interface TimelineBrushProps {\n    13→  width: number;\n    14→  height: number;\n    15→  extent: [number, number];\n    16→  padding?: number;\n    17→  /** Current selection range in ticks */\n    18→  selection: [number, number] | null;\n    19→  /** Called when selection changes */\n    20→  onSelectionChange: (range: [number, number] | null) => void;\n    21→  /** Minimum selection size in pixels */\n    22→  minSelectionWidth?: number;\n    23→}\n    24→\n    25→type DragMode = \"none\" | \"left\" | \"right\" | \"move\" | \"create\";\n    26→\n    27→export default function TimelineBrush({\n    28→  width,\n    29→  height,\n    30→  extent,\n    31→  padding = 40,\n    32→  selection,\n    33→  onSelectionChange,\n    34→  minSelectionWidth = 20,\n    35→}: Readonly<TimelineBrushProps>) {\n    36→  const svgRef = useRef<SVGSVGElement>(null);\n    37→  const [dragMode, setDragMode] = useState<DragMode>(\"none\");\n    38→  const [dragStart, setDragStart] = useState<{ x: number; selection: [number, number] | null }>({\n    39→    x: 0,\n    40→    selection: null,\n    41→  });\n    42→\n    43→  const handleSize = 8;\n    44→\n    45→  // Convert selection to pixel positions\n    46→  const selectionPx = selection\n    47→    ? {\n    48→        left: tickToX(selection[0], extent, width, padding),\n    49→        right: tickToX(selection[1], extent, width, padding),\n    50→      }\n    51→    : null;\n    52→\n    53→  const getMouseX = useCallback((e: React.MouseEvent | MouseEvent) => {\n    54→    if (!svgRef.current) return 0;\n    55→    const rect = svgRef.current.getBoundingClientRect();\n    56→    return e.clientX - rect.left;\n    57→  }, []);\n    58→\n    59→  const handleMouseDown = useCallback(\n    60→    (e: React.MouseEvent, mode: DragMode) => {\n    61→      e.preventDefault();\n    62→      e.stopPropagation();\n    63→      setDragMode(mode);\n    64→      setDragStart({ x: getMouseX(e), selection });\n    65→    },\n    66→    [selection, getMouseX]\n    67→  );\n    68→\n    69→  const handleBackgroundMouseDown = useCallback(\n    70→    (e: React.MouseEvent) => {\n    71→      const x = getMouseX(e);\n    72→      // If clicking outside selection, start creating new selection\n    73→      if (!selectionPx || x < selectionPx.left - handleSize || x > selectionPx.right + handleSize) {\n    74→        setDragMode(\"create\");\n    75→        const tick = xToTick(x, extent, width, padding);\n    76→        setDragStart({ x, selection: [tick, tick] });\n    77→        onSelectionChange([tick, tick]);\n    78→      }\n    79→    },\n    80→    [selectionPx, extent, width, padding, getMouseX, onSelectionChange, handleSize]\n    81→  );\n    82→\n    83→  useEffect(() => {\n    84→    if (dragMode === \"none\") return;\n    85→\n    86→    const handleMouseMove = (e: MouseEvent) => {\n    87→      const x = getMouseX(e);\n    88→      const dx = x - dragStart.x;\n    89→\n    90→      if (dragMode === \"create\") {\n    91→        const startTick = dragStart.selection[0];\n    92→        const currentTick = xToTick(x, extent, width, padding);\n    93→        const newSelection: [number, number] =\n    94→          currentTick >= startTick ? [startTick, currentTick] : [currentTick, startTick];\n    95→        onSelectionChange(newSelection);\n    96→        return;\n    97→      }\n    98→\n    99→      if (!dragStart.selection) return;\n   100→\n   101→      const [startTick, endTick] = dragStart.selection;\n   102→\n   103→      if (dragMode === \"left\") {\n   104→        const newLeft = xToTick(\n   105→          tickToX(startTick, extent, width, padding) + dx,\n   106→          extent,\n   107→          width,\n   108→          padding\n   109→        );\n   110→        const clamped = Math.min(newLeft, endTick - 1);\n   111→        onSelectionChange([Math.max(extent[0], clamped), endTick]);\n   112→      } else if (dragMode === \"right\") {\n   113→        const newRight = xToTick(\n   114→          tickToX(endTick, extent, width, padding) + dx,\n   115→          extent,\n   116→          width,\n   117→          padding\n   118→        );\n   119→        const clamped = Math.max(newRight, startTick + 1);\n   120→        onSelectionChange([startTick, Math.min(extent[1], clamped)]);\n   121→      } else if (dragMode === \"move\") {\n   122→        const tickDelta =\n   123→          xToTick(dragStart.x + dx, extent, width, padding) -\n   124→          xToTick(dragStart.x, extent, width, padding);\n   125→        let newStart = startTick + tickDelta;\n   126→        let newEnd = endTick + tickDelta;\n   127→\n   128→        // Clamp to extent\n   129→        if (newStart < extent[0]) {\n   130→          const shift = extent[0] - newStart;\n   131→          newStart = extent[0];\n   132→          newEnd += shift;\n   133→        }\n   134→        if (newEnd > extent[1]) {\n   135→          const shift = newEnd - extent[1];\n   136→          newEnd = extent[1];\n   137→          newStart -= shift;\n   138→        }\n   139→\n   140→        onSelectionChange([Math.max(extent[0], newStart), Math.min(extent[1], newEnd)]);\n   141→      }\n   142→    };\n   143→\n   144→    const handleMouseUp = () => {\n   145→      setDragMode(\"none\");\n   146→    };\n   147→\n   148→    document.addEventListener(\"mousemove\", handleMouseMove);\n   149→    document.addEventListener(\"mouseup\", handleMouseUp);\n   150→\n   151→    return () => {\n   152→      document.removeEventListener(\"mousemove\", handleMouseMove);\n   153→      document.removeEventListener(\"mouseup\", handleMouseUp);\n   154→    };\n   155→  }, [dragMode, dragStart, extent, width, padding, getMouseX, onSelectionChange]);\n   156→\n   157→  const getCursor = (mode: DragMode) => {\n   158→    switch (mode) {\n   159→      case \"left\":\n   160→      case \"right\":\n   161→        return \"ew-resize\";\n   162→      case \"move\":\n   163→        return \"grab\";\n   164→      case \"create\":\n   165→        return \"crosshair\";\n   166→      default:\n   167→        return \"crosshair\";\n   168→    }\n   169→  };\n   170→\n   171→  return (\n   172→    <svg\n   173→      ref={svgRef}\n   174→      width={width}\n   175→      height={height}\n   176→      className=\"tb-svg\"\n   177→      style={{\n   178→        '--tb-cursor': getCursor(dragMode === \"none\" ? \"create\" : dragMode),\n   179→      } as React.CSSProperties}\n   180→      onMouseDown={handleBackgroundMouseDown}\n   181→    >\n   182→      {/* Background track */}\n   183→      <rect\n   184→        x={padding}\n   185→        y={4}\n   186→        width={width - 2 * padding}\n   187→        height={height - 8}\n   188→        rx={4}\n   189→        fill=\"var(--bg-tertiary)\"\n   190→        stroke=\"var(--border-color)\"\n   191→        strokeWidth={1}\n   192→      />\n   193→\n   194→      {/* Selection */}\n   195→      {selectionPx && selectionPx.right - selectionPx.left >= minSelectionWidth && (\n   196→        <g>\n   197→          {/* Selection rect */}\n   198→          <rect\n   199→            x={selectionPx.left}\n   200→            y={4}\n   201→            width={selectionPx.right - selectionPx.left}\n   202→            height={height - 8}\n   203→            rx={4}\n   204→            fill=\"rgba(99, 102, 241, 0.3)\"\n   205→            stroke=\"var(--accent-color)\"\n   206→            strokeWidth={1}\n   207→            className=\"tb-grab\"\n   208→            onMouseDown={(e) => handleMouseDown(e, \"move\")}\n   209→          />\n   210→\n   211→          {/* Left handle */}\n   212→          <rect\n   213→            x={selectionPx.left - handleSize / 2}\n   214→            y={height / 2 - 12}\n   215→            width={handleSize}\n   216→            height={24}\n   217→            rx={2}\n   218→            fill=\"var(--accent-color)\"\n   219→            className=\"tb-ew-resize\"\n   220→            onMouseDown={(e) => handleMouseDown(e, \"left\")}\n   221→          />\n   222→\n   223→          {/* Right handle */}\n   224→          <rect\n   225→            x={selectionPx.right - handleSize / 2}\n   226→            y={height / 2 - 12}\n   227→            width={handleSize}\n   228→            height={24}\n   229→            rx={2}\n   230→            fill=\"var(--accent-color)\"\n   231→            className=\"tb-ew-resize\"\n   232→            onMouseDown={(e) => handleMouseDown(e, \"right\")}\n   233→          />\n   234→\n   235→          {/* Selection label */}\n   236→          {selection && (\n   237→            <text\n   238→              x={(selectionPx.left + selectionPx.right) / 2}\n   239→              y={height / 2 + 4}\n   240→              textAnchor=\"middle\"\n   241→              fontSize=\"10\"\n   242→              fontWeight=\"500\"\n   243→              fill=\"var(--accent-color)\"\n   244→              className=\"tb-no-pointer\"\n   245→            >\n   246→              {selection[0]} – {selection[1]}\n   247→            </text>\n   248→          )}\n   249→        </g>\n   250→      )}\n   251→\n   252→      {/* Instructions when no selection */}\n   253→      {!selectionPx && (\n   254→        <text\n   255→          x={width / 2}\n   256→          y={height / 2 + 4}\n   257→          textAnchor=\"middle\"\n   258→          fontSize=\"11\"\n   259→          fill=\"var(--text-muted)\"\n   260→          className=\"tb-no-pointer\"\n   261→        >\n   262→          Drag to select time range\n   263→        </text>\n   264→      )}\n   265→    </svg>\n   266→  );\n   267→}\n   268→"}]},"parent_tool_use_id":null,"session_id":"ee4ea11c-d389-40b8-aae4-dcc42ada4575","uuid":"ce134305-b641-4101-b8ab-b59cb5b62b38","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/ChronicleWizard/visualizations/TimelineBrush.tsx","content":"/**\n * TimelineBrush - Draggable range selection for timeline\n *\n * Allows users to select a time range by dragging handles or the selection itself.\n * Much faster than individual checkboxes for bulk selection.\n */\n\nimport React, { useState, useCallback, useRef, useEffect } from \"react\";\nimport { tickToX, xToTick } from \"../../../lib/chronicle/timelineUtils\";\nimport \"./TimelineBrush.css\";\n\ninterface TimelineBrushProps {\n  width: number;\n  height: number;\n  extent: [number, number];\n  padding?: number;\n  /** Current selection range in ticks */\n  selection: [number, number] | null;\n  /** Called when selection changes */\n  onSelectionChange: (range: [number, number] | null) => void;\n  /** Minimum selection size in pixels */\n  minSelectionWidth?: number;\n}\n\ntype DragMode = \"none\" | \"left\" | \"right\" | \"move\" | \"create\";\n\nexport default function TimelineBrush({\n  width,\n  height,\n  extent,\n  padding = 40,\n  selection,\n  onSelectionChange,\n  minSelectionWidth = 20,\n}: Readonly<TimelineBrushProps>) {\n  const svgRef = useRef<SVGSVGElement>(null);\n  const [dragMode, setDragMode] = useState<DragMode>(\"none\");\n  const [dragStart, setDragStart] = useState<{ x: number; selection: [number, number] | null }>({\n    x: 0,\n    selection: null,\n  });\n\n  const handleSize = 8;\n\n  // Convert selection to pixel positions\n  const selectionPx = selection\n    ? {\n        left: tickToX(selection[0], extent, width, padding),\n        right: tickToX(selection[1], extent, width, padding),\n      }\n    : null;\n\n  const getMouseX = useCallback((e: React.MouseEvent | MouseEvent) => {\n    if (!svgRef.current) return 0;\n    const rect = svgRef.current.getBoundingClientRect();\n    return e.clientX - rect.left;\n  }, []);\n\n  const handleMouseDown = useCallback(\n    (e: React.MouseEvent, mode: DragMode) => {\n      e.preventDefault();\n      e.stopPropagation();\n      setDragMode(mode);\n      setDragStart({ x: getMouseX(e), selection });\n    },\n    [selection, getMouseX]\n  );\n\n  const handleBackgroundMouseDown = useCallback(\n    (e: React.MouseEvent) => {\n      const x = getMouseX(e);\n      // If clicking outside selection, start creating new selection\n      if (!selectionPx || x < selectionPx.left - handleSize || x > selectionPx.right + handleSize) {\n        setDragMode(\"create\");\n        const tick = xToTick(x, extent, width, padding);\n        setDragStart({ x, selection: [tick, tick] });\n        onSelectionChange([tick, tick]);\n      }\n    },\n    [selectionPx, extent, width, padding, getMouseX, onSelectionChange, handleSize]\n  );\n\n  useEffect(() => {\n    if (dragMode === \"none\") return;\n\n    const handleMouseMove = (e: MouseEvent) => {\n      const x = getMouseX(e);\n      const dx = x - dragStart.x;\n\n      if (dragMode === \"create\") {\n        const startTick = dragStart.selection[0];\n        const currentTick = xToTick(x, extent, width, padding);\n        const newSelection: [number, number] =\n          currentTick >= startTick ? [startTick, currentTick] : [currentTick, startTick];\n        onSelectionChange(newSelection);\n        return;\n      }\n\n      if (!dragStart.selection) return;\n\n      const [startTick, endTick] = dragStart.selection;\n\n      if (dragMode === \"left\") {\n        const newLeft = xToTick(\n          tickToX(startTick, extent, width, padding) + dx,\n          extent,\n          width,\n          padding\n        );\n        const clamped = Math.min(newLeft, endTick - 1);\n        onSelectionChange([Math.max(extent[0], clamped), endTick]);\n      } else if (dragMode === \"right\") {\n        const newRight = xToTick(\n          tickToX(endTick, extent, width, padding) + dx,\n          extent,\n          width,\n          padding\n        );\n        const clamped = Math.max(newRight, startTick + 1);\n        onSelectionChange([startTick, Math.min(extent[1], clamped)]);\n      } else if (dragMode === \"move\") {\n        const tickDelta =\n          xToTick(dragStart.x + dx, extent, width, padding) -\n          xToTick(dragStart.x, extent, width, padding);\n        let newStart = startTick + tickDelta;\n        let newEnd = endTick + tickDelta;\n\n        // Clamp to extent\n        if (newStart < extent[0]) {\n          const shift = extent[0] - newStart;\n          newStart = extent[0];\n          newEnd += shift;\n        }\n        if (newEnd > extent[1]) {\n          const shift = newEnd - extent[1];\n          newEnd = extent[1];\n          newStart -= shift;\n        }\n\n        onSelectionChange([Math.max(extent[0], newStart), Math.min(extent[1], newEnd)]);\n      }\n    };\n\n    const handleMouseUp = () => {\n      setDragMode(\"none\");\n    };\n\n    document.addEventListener(\"mousemove\", handleMouseMove);\n    document.addEventListener(\"mouseup\", handleMouseUp);\n\n    return () => {\n      document.removeEventListener(\"mousemove\", handleMouseMove);\n      document.removeEventListener(\"mouseup\", handleMouseUp);\n    };\n  }, [dragMode, dragStart, extent, width, padding, getMouseX, onSelectionChange]);\n\n  const getCursor = (mode: DragMode) => {\n    switch (mode) {\n      case \"left\":\n      case \"right\":\n        return \"ew-resize\";\n      case \"move\":\n        return \"grab\";\n      case \"create\":\n        return \"crosshair\";\n      default:\n        return \"crosshair\";\n    }\n  };\n\n  return (\n    <svg\n      ref={svgRef}\n      width={width}\n      height={height}\n      className=\"tb-svg\"\n      style={{\n        '--tb-cursor': getCursor(dragMode === \"none\" ? \"create\" : dragMode),\n      } as React.CSSProperties}\n      onMouseDown={handleBackgroundMouseDown}\n    >\n      {/* Background track */}\n      <rect\n        x={padding}\n        y={4}\n        width={width - 2 * padding}\n        height={height - 8}\n        rx={4}\n        fill=\"var(--bg-tertiary)\"\n        stroke=\"var(--border-color)\"\n        strokeWidth={1}\n      />\n\n      {/* Selection */}\n      {selectionPx && selectionPx.right - selectionPx.left >= minSelectionWidth && (\n        <g>\n          {/* Selection rect */}\n          <rect\n            x={selectionPx.left}\n            y={4}\n            width={selectionPx.right - selectionPx.left}\n            height={height - 8}\n            rx={4}\n            fill=\"rgba(99, 102, 241, 0.3)\"\n            stroke=\"var(--accent-color)\"\n            strokeWidth={1}\n            className=\"tb-grab\"\n            onMouseDown={(e) => handleMouseDown(e, \"move\")}\n          />\n\n          {/* Left handle */}\n          <rect\n            x={selectionPx.left - handleSize / 2}\n            y={height / 2 - 12}\n            width={handleSize}\n            height={24}\n            rx={2}\n            fill=\"var(--accent-color)\"\n            className=\"tb-ew-resize\"\n            onMouseDown={(e) => handleMouseDown(e, \"left\")}\n          />\n\n          {/* Right handle */}\n          <rect\n            x={selectionPx.right - handleSize / 2}\n            y={height / 2 - 12}\n            width={handleSize}\n            height={24}\n            rx={2}\n            fill=\"var(--accent-color)\"\n            className=\"tb-ew-resize\"\n            onMouseDown={(e) => handleMouseDown(e, \"right\")}\n          />\n\n          {/* Selection label */}\n          {selection && (\n            <text\n              x={(selectionPx.left + selectionPx.right) / 2}\n              y={height / 2 + 4}\n              textAnchor=\"middle\"\n              fontSize=\"10\"\n              fontWeight=\"500\"\n              fill=\"var(--accent-color)\"\n              className=\"tb-no-pointer\"\n            >\n              {selection[0]} – {selection[1]}\n            </text>\n          )}\n        </g>\n      )}\n\n      {/* Instructions when no selection */}\n      {!selectionPx && (\n        <text\n          x={width / 2}\n          y={height / 2 + 4}\n          textAnchor=\"middle\"\n          fontSize=\"11\"\n          fill=\"var(--text-muted)\"\n          className=\"tb-no-pointer\"\n        >\n          Drag to select time range\n        </text>\n      )}\n    </svg>\n  );\n}\n","numLines":268,"startLine":1,"totalLines":268}}}
