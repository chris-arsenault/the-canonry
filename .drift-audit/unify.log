{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014UbudxWSWErTeBAMtEV3dP","type":"tool_result","content":"     1→// drift-generated\n     2→/**\n     3→ * ESLint rule: no-raw-error-div\n     4→ *\n     5→ * Bans creating ad-hoc error display divs with error/failed CSS classes.\n     6→ * All error display must use the shared <ErrorMessage> component from\n     7→ * @the-canonry/shared-components. See ADR 021.\n     8→ */\n     9→export default {\n    10→  meta: {\n    11→    type: \"suggestion\",\n    12→    docs: {\n    13→      description:\n    14→        \"Disallow ad-hoc error display divs. Use <ErrorMessage> from shared-components.\",\n    15→    },\n    16→    messages: {\n    17→      noRawErrorDiv:\n    18→        'Do not create ad-hoc error display divs with \"error\" or \"failed\" CSS classes. ' +\n    19→        'Use <ErrorMessage message={...}> from \"@the-canonry/shared-components\" instead. ' +\n    20→        \"See docs/patterns/error-display.md (ADR 021).\",\n    21→    },\n    22→    schema: [],\n    23→  },\n    24→\n    25→  create(context) {\n    26→    const filename = context.filename || context.getFilename();\n    27→\n    28→    // Exempt the ErrorMessage component itself\n    29→    if (/ErrorMessage\\.[jt]sx?$/.test(filename)) return {};\n    30→\n    31→    return {\n    32→      JSXOpeningElement(node) {\n    33→        // Only check <div> elements\n    34→        if (\n    35→          node.name.type !== \"JSXIdentifier\" ||\n    36→          node.name.name !== \"div\"\n    37→        )\n    38→          return;\n    39→\n    40→        // Find className attribute\n    41→        const classAttr = node.attributes.find(\n    42→          (attr) =>\n    43→            attr.type === \"JSXAttribute\" &&\n    44→            attr.name &&\n    45→            attr.name.name === \"className\",\n    46→        );\n    47→        if (!classAttr || !classAttr.value) return;\n    48→\n    49→        // Extract class string from various JSX patterns\n    50→        const classValue = extractClassString(classAttr.value);\n    51→        if (!classValue) return;\n    52→\n    53→        // Allow canonical shared-component classes\n    54→        if (/\\berror-message\\b/.test(classValue)) return;\n    55→        if (/\\berror-boundary\\b/.test(classValue)) return;\n    56→\n    57→        // Detect ad-hoc error display patterns:\n    58→        //   \"error\", \"error-box\", \"imod-error\", \"dgm-failed\",\n    59→        //   \"pp-error-item\", \"ap-error-detail\", etc.\n    60→        if (/\\b(error|failed)\\b/.test(classValue)) {\n    61→          context.report({\n    62→            node,\n    63→            messageId: \"noRawErrorDiv\",\n    64→          });\n    65→        }\n    66→      },\n    67→    };\n    68→  },\n    69→};\n    70→\n    71→/**\n    72→ * Extract a class name string from a JSX attribute value node.\n    73→ * Handles: className=\"foo\", className={\"foo\"}, className={`foo ${bar}`}\n    74→ */\n    75→function extractClassString(valueNode) {\n    76→  // String literal: className=\"error\"\n    77→  if (valueNode.type === \"Literal\" && typeof valueNode.value === \"string\") {\n    78→    return valueNode.value;\n    79→  }\n    80→  // Expression container: className={...}\n    81→  if (valueNode.type === \"JSXExpressionContainer\") {\n    82→    const expr = valueNode.expression;\n    83→    // className={\"error\"}\n    84→    if (expr.type === \"Literal\" && typeof expr.value === \"string\") {\n    85→      return expr.value;\n    86→    }\n    87→    // className={`error ${x}`} — check template quasis (static parts)\n    88→    if (expr.type === \"TemplateLiteral\") {\n    89→      return expr.quasis.map((q) => q.value.raw).join(\"\");\n    90→    }\n    91→  }\n    92→  return null;\n    93→}\n    94→"}]},"parent_tool_use_id":null,"session_id":"2a207061-1c30-40ba-a375-5d0443f621d8","uuid":"f6291c92-90e3-418d-b3f6-d08df02d6ad2","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/eslint-rules/no-raw-error-div.js","content":"// drift-generated\n/**\n * ESLint rule: no-raw-error-div\n *\n * Bans creating ad-hoc error display divs with error/failed CSS classes.\n * All error display must use the shared <ErrorMessage> component from\n * @the-canonry/shared-components. See ADR 021.\n */\nexport default {\n  meta: {\n    type: \"suggestion\",\n    docs: {\n      description:\n        \"Disallow ad-hoc error display divs. Use <ErrorMessage> from shared-components.\",\n    },\n    messages: {\n      noRawErrorDiv:\n        'Do not create ad-hoc error display divs with \"error\" or \"failed\" CSS classes. ' +\n        'Use <ErrorMessage message={...}> from \"@the-canonry/shared-components\" instead. ' +\n        \"See docs/patterns/error-display.md (ADR 021).\",\n    },\n    schema: [],\n  },\n\n  create(context) {\n    const filename = context.filename || context.getFilename();\n\n    // Exempt the ErrorMessage component itself\n    if (/ErrorMessage\\.[jt]sx?$/.test(filename)) return {};\n\n    return {\n      JSXOpeningElement(node) {\n        // Only check <div> elements\n        if (\n          node.name.type !== \"JSXIdentifier\" ||\n          node.name.name !== \"div\"\n        )\n          return;\n\n        // Find className attribute\n        const classAttr = node.attributes.find(\n          (attr) =>\n            attr.type === \"JSXAttribute\" &&\n            attr.name &&\n            attr.name.name === \"className\",\n        );\n        if (!classAttr || !classAttr.value) return;\n\n        // Extract class string from various JSX patterns\n        const classValue = extractClassString(classAttr.value);\n        if (!classValue) return;\n\n        // Allow canonical shared-component classes\n        if (/\\berror-message\\b/.test(classValue)) return;\n        if (/\\berror-boundary\\b/.test(classValue)) return;\n\n        // Detect ad-hoc error display patterns:\n        //   \"error\", \"error-box\", \"imod-error\", \"dgm-failed\",\n        //   \"pp-error-item\", \"ap-error-detail\", etc.\n        if (/\\b(error|failed)\\b/.test(classValue)) {\n          context.report({\n            node,\n            messageId: \"noRawErrorDiv\",\n          });\n        }\n      },\n    };\n  },\n};\n\n/**\n * Extract a class name string from a JSX attribute value node.\n * Handles: className=\"foo\", className={\"foo\"}, className={`foo ${bar}`}\n */\nfunction extractClassString(valueNode) {\n  // String literal: className=\"error\"\n  if (valueNode.type === \"Literal\" && typeof valueNode.value === \"string\") {\n    return valueNode.value;\n  }\n  // Expression container: className={...}\n  if (valueNode.type === \"JSXExpressionContainer\") {\n    const expr = valueNode.expression;\n    // className={\"error\"}\n    if (expr.type === \"Literal\" && typeof expr.value === \"string\") {\n      return expr.value;\n    }\n    // className={`error ${x}`} — check template quasis (static parts)\n    if (expr.type === \"TemplateLiteral\") {\n      return expr.quasis.map((q) => q.value.raw).join(\"\");\n    }\n  }\n  return null;\n}\n","numLines":94,"startLine":1,"totalLines":94}}}
