{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GWFNYzd8CvW2eQ4wwSz2di","type":"tool_result","content":"     1→/**\n     2→ * AxisRegistryEditor - Manage reusable semantic plane axis definitions.\n     3→ *\n     4→ * Axis definitions are shared across entity kinds. When an axis is created/updated,\n     5→ * its tags are automatically configured in the tag registry (isAxis: true, mutually exclusive).\n     6→ */\n     7→\n     8→import React, { useState, useMemo } from \"react\";\n     9→import PropTypes from \"prop-types\";\n    10→import { TagSelector } from \"@the-canonry/shared-components\";\n    11→import \"./AxisRegistry.css\";\n    12→\n    13→export default function AxisRegistryEditor({\n    14→  axisDefinitions = [],\n    15→  entityKinds = [],\n    16→  tagRegistry = [],\n    17→  onAxisDefinitionsChange,\n    18→  onTagRegistryChange,\n    19→}) {\n    20→  const [showModal, setShowModal] = useState(false);\n    21→  const [editingAxis, setEditingAxis] = useState(null);\n    22→  const [formData, setFormData] = useState({\n    23→    id: \"\",\n    24→    name: \"\",\n    25→    description: \"\",\n    26→    lowTag: \"\",\n    27→    highTag: \"\",\n    28→  });\n    29→\n    30→  // Compute which entity kinds use each axis\n    31→  const axisUsage = useMemo(() => {\n    32→    const usage = {};\n    33→    for (const axis of axisDefinitions) {\n    34→      usage[axis.id] = [];\n    35→    }\n    36→\n    37→    for (const ek of entityKinds) {\n    38→      const axes = ek.semanticPlane?.axes || {};\n    39→      for (const [axisKey, axisConfig] of Object.entries(axes)) {\n    40→        if (axisConfig.axisId && usage[axisConfig.axisId]) {\n    41→          usage[axisConfig.axisId].push({\n    42→            kind: ek.kind,\n    43→            description: ek.description,\n    44→            axis: axisKey.toUpperCase(),\n    45→          });\n    46→        }\n    47→      }\n    48→    }\n    49→\n    50→    return usage;\n    51→  }, [axisDefinitions, entityKinds]);\n    52→\n    53→  const openNewModal = () => {\n    54→    setEditingAxis(null);\n    55→    setFormData({\n    56→      id: \"\",\n    57→      name: \"\",\n    58→      description: \"\",\n    59→      lowTag: \"\",\n    60→      highTag: \"\",\n    61→    });\n    62→    setShowModal(true);\n    63→  };\n    64→\n    65→  const openEditModal = (axis) => {\n    66→    setEditingAxis(axis);\n    67→    setFormData({\n    68→      id: axis.id,\n    69→      name: axis.name,\n    70→      description: axis.description || \"\",\n    71→      lowTag: axis.lowTag,\n    72→      highTag: axis.highTag,\n    73→    });\n    74→    setShowModal(true);\n    75→  };\n    76→\n    77→  const closeModal = () => {\n    78→    setShowModal(false);\n    79→    setEditingAxis(null);\n    80→  };\n    81→\n    82→  const generateId = (name) => {\n    83→    return name\n    84→      .toLowerCase()\n    85→      .replace(/[^a-z0-9]+/g, \"_\")\n    86→      .replace(/^_|_$/g, \"\");\n    87→  };\n    88→\n    89→  const handleNameChange = (name) => {\n    90→    setFormData((prev) => ({\n    91→      ...prev,\n    92→      name,\n    93→      // Auto-generate ID only if creating new or ID hasn't been manually edited\n    94→      id: !editingAxis ? generateId(name) : prev.id,\n    95→    }));\n    96→  };\n    97→\n    98→  const ensureTagExists = (tagId, isAxis = true) => {\n    99→    const existing = tagRegistry.find((t) => t.tag === tagId);\n   100→    if (existing) {\n   101→      // Update existing tag to be an axis tag\n   102→      if (!existing.isAxis) {\n   103→        return { ...existing, isAxis: true };\n   104→      }\n   105→      return existing;\n   106→    }\n   107→    // Create new tag\n   108→    return {\n   109→      tag: tagId,\n   110→      description: \"\",\n   111→      category: \"trait\",\n   112→      isAxis: true,\n   113→    };\n   114→  };\n   115→\n   116→  const saveAxis = () => {\n   117→    if (!formData.name.trim() || !formData.lowTag.trim() || !formData.highTag.trim()) {\n   118→      return;\n   119→    }\n   120→\n   121→    if (!onAxisDefinitionsChange) {\n   122→      return;\n   123→    }\n   124→\n   125→    const axisId = formData.id || generateId(formData.name);\n   126→    const newAxis = {\n   127→      id: axisId,\n   128→      name: formData.name.trim(),\n   129→      description: formData.description.trim(),\n   130→      lowTag: formData.lowTag.trim(),\n   131→      highTag: formData.highTag.trim(),\n   132→    };\n   133→\n   134→    // Update axis definitions\n   135→    let newDefinitions;\n   136→    if (editingAxis) {\n   137→      newDefinitions = axisDefinitions.map((a) => (a.id === editingAxis.id ? newAxis : a));\n   138→    } else {\n   139→      newDefinitions = [...axisDefinitions, newAxis];\n   140→    }\n   141→\n   142→    onAxisDefinitionsChange(newDefinitions);\n   143→\n   144→    // Auto-manage tags if callback is provided\n   145→    if (onTagRegistryChange) {\n   146→      const lowTagEntry = ensureTagExists(newAxis.lowTag);\n   147→      const highTagEntry = ensureTagExists(newAxis.highTag);\n   148→\n   149→      // Set mutual exclusivity between the tags\n   150→      const lowWithExclusive = {\n   151→        ...lowTagEntry,\n   152→        mutuallyExclusiveWith: [\n   153→          ...new Set([...(lowTagEntry.mutuallyExclusiveWith || []), newAxis.highTag]),\n   154→        ],\n   155→      };\n   156→      const highWithExclusive = {\n   157→        ...highTagEntry,\n   158→        mutuallyExclusiveWith: [\n   159→          ...new Set([...(highTagEntry.mutuallyExclusiveWith || []), newAxis.lowTag]),\n   160→        ],\n   161→      };\n   162→\n   163→      // Update tag registry\n   164→      let newRegistry = [...tagRegistry];\n   165→\n   166→      // Update or add low tag\n   167→      const lowIdx = newRegistry.findIndex((t) => t.tag === newAxis.lowTag);\n   168→      if (lowIdx >= 0) {\n   169→        newRegistry[lowIdx] = lowWithExclusive;\n   170→      } else {\n   171→        newRegistry.push(lowWithExclusive);\n   172→      }\n   173→\n   174→      // Update or add high tag\n   175→      const highIdx = newRegistry.findIndex((t) => t.tag === newAxis.highTag);\n   176→      if (highIdx >= 0) {\n   177→        newRegistry[highIdx] = highWithExclusive;\n   178→      } else {\n   179→        newRegistry.push(highWithExclusive);\n   180→      }\n   181→\n   182→      onTagRegistryChange(newRegistry);\n   183→    }\n   184→\n   185→    closeModal();\n   186→  };\n   187→\n   188→  const deleteAxis = (axisId) => {\n   189→    const usage = axisUsage[axisId] || [];\n   190→    if (usage.length > 0) {\n   191→      const kindList = usage.map((u) => u.description || u.kind).join(\", \");\n   192→      if (!window.confirm(`This axis is used by: ${kindList}. Delete anyway?`)) {\n   193→        return;\n   194→      }\n   195→    }\n   196→\n   197→    const newDefinitions = axisDefinitions.filter((a) => a.id !== axisId);\n   198→    onAxisDefinitionsChange(newDefinitions);\n   199→  };\n   200→\n   201→  return (\n   202→    <div className=\"axr-container\">\n   203→      <div className=\"axr-header\">\n   204→        <div className=\"axr-title\">Axis Registry</div>\n   205→        <div className=\"axr-subtitle\">\n   206→          Define reusable semantic axes. Tags are auto-configured when you save.\n   207→        </div>\n   208→      </div>\n   209→\n   210→      <div className=\"axr-toolbar\">\n   211→        <span className=\"axr-count\">\n   212→          {axisDefinitions.length} {axisDefinitions.length === 1 ? \"axis\" : \"axes\"} defined\n   213→        </span>\n   214→        <button className=\"axr-add-button\" onClick={openNewModal}>\n   215→          + New Axis\n   216→        </button>\n   217→      </div>\n   218→\n   219→      {axisDefinitions.length === 0 ? (\n   220→        <div className=\"axr-empty-state\">\n   221→          No axes defined yet. Create your first axis to start building semantic planes.\n   222→        </div>\n   223→      ) : (\n   224→        <div className=\"axr-axis-list\">\n   225→          {axisDefinitions.map((axis) => {\n   226→            const usage = axisUsage[axis.id] || [];\n   227→            return (\n   228→              <div key={axis.id} className=\"axr-axis-card\">\n   229→                <div className=\"axr-axis-header\">\n   230→                  <div>\n   231→                    <div className=\"axr-axis-name\">{axis.name}</div>\n   232→                    {axis.description && (\n   233→                      <div className=\"axr-axis-description\">{axis.description}</div>\n   234→                    )}\n   235→                  </div>\n   236→                  <div className=\"axr-actions\">\n   237→                    <button className=\"axr-edit-button\" onClick={() => openEditModal(axis)}>\n   238→                      Edit\n   239→                    </button>\n   240→                    <button className=\"axr-delete-button\" onClick={() => deleteAxis(axis.id)}>\n   241→                      Delete\n   242→                    </button>\n   243→                  </div>\n   244→                </div>\n   245→\n   246→                <div className=\"axr-axis-range\">\n   247→                  <span className=\"axr-tag\">{axis.lowTag}</span>\n   248→                  <span className=\"axr-arrow\">←―――→</span>\n   249→                  <span className=\"axr-tag\">{axis.highTag}</span>\n   250→                </div>\n   251→\n   252→                {usage.length > 0 && (\n   253→                  <div className=\"axr-usage-info\">\n   254→                    Used in:{\" \"}\n   255→                    {usage.map((u, i) => (\n   256→                      <span key={u.kind}>\n   257→                        {i > 0 && \", \"}\n   258→                        <span className=\"axr-usage-kind\">\n   259→                          {u.description || u.kind} ({u.axis})\n   260→                        </span>\n   261→                      </span>\n   262→                    ))}\n   263→                  </div>\n   264→                )}\n   265→              </div>\n   266→            );\n   267→          })}\n   268→        </div>\n   269→      )}\n   270→\n   271→      {/* Create/Edit Modal */}\n   272→      {showModal && (\n   273→        <div className=\"axr-modal\" onClick={closeModal} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") closeModal(); }} >\n   274→          <div className=\"axr-modal-content\" onClick={(e) => e.stopPropagation()} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n   275→            <div className=\"axr-modal-title\">\n   276→              {editingAxis ? `Edit Axis: ${editingAxis.name}` : \"New Axis Definition\"}\n   277→            </div>\n   278→\n   279→            <div className=\"axr-form-group\">\n   280→              <label htmlFor=\"name\" className=\"axr-label\">Name</label>\n   281→              <input id=\"name\"\n   282→                className=\"axr-input\"\n   283→                placeholder=\"e.g., Power, Alignment, Element\"\n   284→                value={formData.name}\n   285→                onChange={(e) => handleNameChange(e.target.value)}\n   286→                // eslint-disable-next-line jsx-a11y/no-autofocus\n   287→                autoFocus\n   288→              />\n   289→            </div>\n   290→\n   291→            <div className=\"axr-form-group\">\n   292→              <label htmlFor=\"id\" className=\"axr-label\">ID</label>\n   293→              <input id=\"id\"\n   294→                className=\"axr-input\"\n   295→                placeholder=\"e.g., power, alignment, element\"\n   296→                value={formData.id}\n   297→                onChange={(e) => setFormData({ ...formData, id: e.target.value })}\n   298→                disabled={!!editingAxis}\n   299→              />\n   300→              <div className=\"axr-hint\">\n   301→                {editingAxis ? \"ID cannot be changed\" : \"Auto-generated from name\"}\n   302→              </div>\n   303→            </div>\n   304→\n   305→            <div className=\"axr-form-group\">\n   306→              <label htmlFor=\"description-optional\" className=\"axr-label\">Description (optional)</label>\n   307→              <input id=\"description-optional\"\n   308→                className=\"axr-input\"\n   309→                placeholder=\"Brief description of this axis\"\n   310→                value={formData.description}\n   311→                onChange={(e) => setFormData({ ...formData, description: e.target.value })}\n   312→              />\n   313→            </div>\n   314→\n   315→            <div className=\"axr-input-row\">\n   316→              <div className=\"axr-input-half\">\n   317→                <div className=\"axr-form-group\">\n   318→                  <label className=\"axr-label\">Low Tag (0)\n   319→                  <TagSelector\n   320→                    tagRegistry={tagRegistry}\n   321→                    value={formData.lowTag ? [formData.lowTag] : []}\n   322→                    onChange={(tags) => setFormData({ ...formData, lowTag: tags[0] || \"\" })}\n   323→                    onAddToRegistry={(newTag) => onTagRegistryChange([...tagRegistry, newTag])}\n   324→                    placeholder=\"Select or create tag...\"\n   325→                    singleSelect\n   326→                  />\n   327→                  </label>\n   328→                </div>\n   329→              </div>\n   330→              <div className=\"axr-input-half\">\n   331→                <div className=\"axr-form-group\">\n   332→                  <label className=\"axr-label\">High Tag (100)\n   333→                  <TagSelector\n   334→                    tagRegistry={tagRegistry}\n   335→                    value={formData.highTag ? [formData.highTag] : []}\n   336→                    onChange={(tags) => setFormData({ ...formData, highTag: tags[0] || \"\" })}\n   337→                    onAddToRegistry={(newTag) => onTagRegistryChange([...tagRegistry, newTag])}\n   338→                    placeholder=\"Select or create tag...\"\n   339→                    singleSelect\n   340→                  />\n   341→                  </label>\n   342→                </div>\n   343→              </div>\n   344→            </div>\n   345→\n   346→            <div className=\"axr-hint\">\n   347→              Tags will be auto-created in the registry with isAxis=true and set as mutually\n   348→              exclusive.\n   349→            </div>\n   350→\n   351→            <div className=\"axr-modal-actions\">\n   352→              <button className=\"axr-cancel-button\" onClick={closeModal}>\n   353→                Cancel\n   354→              </button>\n   355→              <button\n   356→                className=\"axr-save-button\"\n   357→                style={{ '--axr-save-opacity': formData.name && formData.lowTag && formData.highTag ? 1 : 0.5 }}\n   358→                onClick={saveAxis}\n   359→                disabled={!formData.name || !formData.lowTag || !formData.highTag}\n   360→              >\n   361→                {editingAxis ? \"Save Changes\" : \"Create Axis\"}\n   362→              </button>\n   363→            </div>\n   364→          </div>\n   365→        </div>\n   366→      )}\n   367→    </div>\n   368→  );\n   369→}\n   370→\n   371→AxisRegistryEditor.propTypes = {\n   372→  axisDefinitions: PropTypes.array,\n   373→  entityKinds: PropTypes.array,\n   374→  tagRegistry: PropTypes.array,\n   375→  onAxisDefinitionsChange: PropTypes.func,\n   376→  onTagRegistryChange: PropTypes.func,\n   377→};\n   378→"}]},"parent_tool_use_id":null,"session_id":"f18789e5-fb86-478f-adf1-eac13368c64f","uuid":"fd316691-fea3-48c0-9efc-38b932070e99","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/cosmographer/webui/src/components/AxisRegistry/index.jsx","content":"/**\n * AxisRegistryEditor - Manage reusable semantic plane axis definitions.\n *\n * Axis definitions are shared across entity kinds. When an axis is created/updated,\n * its tags are automatically configured in the tag registry (isAxis: true, mutually exclusive).\n */\n\nimport React, { useState, useMemo } from \"react\";\nimport PropTypes from \"prop-types\";\nimport { TagSelector } from \"@the-canonry/shared-components\";\nimport \"./AxisRegistry.css\";\n\nexport default function AxisRegistryEditor({\n  axisDefinitions = [],\n  entityKinds = [],\n  tagRegistry = [],\n  onAxisDefinitionsChange,\n  onTagRegistryChange,\n}) {\n  const [showModal, setShowModal] = useState(false);\n  const [editingAxis, setEditingAxis] = useState(null);\n  const [formData, setFormData] = useState({\n    id: \"\",\n    name: \"\",\n    description: \"\",\n    lowTag: \"\",\n    highTag: \"\",\n  });\n\n  // Compute which entity kinds use each axis\n  const axisUsage = useMemo(() => {\n    const usage = {};\n    for (const axis of axisDefinitions) {\n      usage[axis.id] = [];\n    }\n\n    for (const ek of entityKinds) {\n      const axes = ek.semanticPlane?.axes || {};\n      for (const [axisKey, axisConfig] of Object.entries(axes)) {\n        if (axisConfig.axisId && usage[axisConfig.axisId]) {\n          usage[axisConfig.axisId].push({\n            kind: ek.kind,\n            description: ek.description,\n            axis: axisKey.toUpperCase(),\n          });\n        }\n      }\n    }\n\n    return usage;\n  }, [axisDefinitions, entityKinds]);\n\n  const openNewModal = () => {\n    setEditingAxis(null);\n    setFormData({\n      id: \"\",\n      name: \"\",\n      description: \"\",\n      lowTag: \"\",\n      highTag: \"\",\n    });\n    setShowModal(true);\n  };\n\n  const openEditModal = (axis) => {\n    setEditingAxis(axis);\n    setFormData({\n      id: axis.id,\n      name: axis.name,\n      description: axis.description || \"\",\n      lowTag: axis.lowTag,\n      highTag: axis.highTag,\n    });\n    setShowModal(true);\n  };\n\n  const closeModal = () => {\n    setShowModal(false);\n    setEditingAxis(null);\n  };\n\n  const generateId = (name) => {\n    return name\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, \"_\")\n      .replace(/^_|_$/g, \"\");\n  };\n\n  const handleNameChange = (name) => {\n    setFormData((prev) => ({\n      ...prev,\n      name,\n      // Auto-generate ID only if creating new or ID hasn't been manually edited\n      id: !editingAxis ? generateId(name) : prev.id,\n    }));\n  };\n\n  const ensureTagExists = (tagId, isAxis = true) => {\n    const existing = tagRegistry.find((t) => t.tag === tagId);\n    if (existing) {\n      // Update existing tag to be an axis tag\n      if (!existing.isAxis) {\n        return { ...existing, isAxis: true };\n      }\n      return existing;\n    }\n    // Create new tag\n    return {\n      tag: tagId,\n      description: \"\",\n      category: \"trait\",\n      isAxis: true,\n    };\n  };\n\n  const saveAxis = () => {\n    if (!formData.name.trim() || !formData.lowTag.trim() || !formData.highTag.trim()) {\n      return;\n    }\n\n    if (!onAxisDefinitionsChange) {\n      return;\n    }\n\n    const axisId = formData.id || generateId(formData.name);\n    const newAxis = {\n      id: axisId,\n      name: formData.name.trim(),\n      description: formData.description.trim(),\n      lowTag: formData.lowTag.trim(),\n      highTag: formData.highTag.trim(),\n    };\n\n    // Update axis definitions\n    let newDefinitions;\n    if (editingAxis) {\n      newDefinitions = axisDefinitions.map((a) => (a.id === editingAxis.id ? newAxis : a));\n    } else {\n      newDefinitions = [...axisDefinitions, newAxis];\n    }\n\n    onAxisDefinitionsChange(newDefinitions);\n\n    // Auto-manage tags if callback is provided\n    if (onTagRegistryChange) {\n      const lowTagEntry = ensureTagExists(newAxis.lowTag);\n      const highTagEntry = ensureTagExists(newAxis.highTag);\n\n      // Set mutual exclusivity between the tags\n      const lowWithExclusive = {\n        ...lowTagEntry,\n        mutuallyExclusiveWith: [\n          ...new Set([...(lowTagEntry.mutuallyExclusiveWith || []), newAxis.highTag]),\n        ],\n      };\n      const highWithExclusive = {\n        ...highTagEntry,\n        mutuallyExclusiveWith: [\n          ...new Set([...(highTagEntry.mutuallyExclusiveWith || []), newAxis.lowTag]),\n        ],\n      };\n\n      // Update tag registry\n      let newRegistry = [...tagRegistry];\n\n      // Update or add low tag\n      const lowIdx = newRegistry.findIndex((t) => t.tag === newAxis.lowTag);\n      if (lowIdx >= 0) {\n        newRegistry[lowIdx] = lowWithExclusive;\n      } else {\n        newRegistry.push(lowWithExclusive);\n      }\n\n      // Update or add high tag\n      const highIdx = newRegistry.findIndex((t) => t.tag === newAxis.highTag);\n      if (highIdx >= 0) {\n        newRegistry[highIdx] = highWithExclusive;\n      } else {\n        newRegistry.push(highWithExclusive);\n      }\n\n      onTagRegistryChange(newRegistry);\n    }\n\n    closeModal();\n  };\n\n  const deleteAxis = (axisId) => {\n    const usage = axisUsage[axisId] || [];\n    if (usage.length > 0) {\n      const kindList = usage.map((u) => u.description || u.kind).join(\", \");\n      if (!window.confirm(`This axis is used by: ${kindList}. Delete anyway?`)) {\n        return;\n      }\n    }\n\n    const newDefinitions = axisDefinitions.filter((a) => a.id !== axisId);\n    onAxisDefinitionsChange(newDefinitions);\n  };\n\n  return (\n    <div className=\"axr-container\">\n      <div className=\"axr-header\">\n        <div className=\"axr-title\">Axis Registry</div>\n        <div className=\"axr-subtitle\">\n          Define reusable semantic axes. Tags are auto-configured when you save.\n        </div>\n      </div>\n\n      <div className=\"axr-toolbar\">\n        <span className=\"axr-count\">\n          {axisDefinitions.length} {axisDefinitions.length === 1 ? \"axis\" : \"axes\"} defined\n        </span>\n        <button className=\"axr-add-button\" onClick={openNewModal}>\n          + New Axis\n        </button>\n      </div>\n\n      {axisDefinitions.length === 0 ? (\n        <div className=\"axr-empty-state\">\n          No axes defined yet. Create your first axis to start building semantic planes.\n        </div>\n      ) : (\n        <div className=\"axr-axis-list\">\n          {axisDefinitions.map((axis) => {\n            const usage = axisUsage[axis.id] || [];\n            return (\n              <div key={axis.id} className=\"axr-axis-card\">\n                <div className=\"axr-axis-header\">\n                  <div>\n                    <div className=\"axr-axis-name\">{axis.name}</div>\n                    {axis.description && (\n                      <div className=\"axr-axis-description\">{axis.description}</div>\n                    )}\n                  </div>\n                  <div className=\"axr-actions\">\n                    <button className=\"axr-edit-button\" onClick={() => openEditModal(axis)}>\n                      Edit\n                    </button>\n                    <button className=\"axr-delete-button\" onClick={() => deleteAxis(axis.id)}>\n                      Delete\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"axr-axis-range\">\n                  <span className=\"axr-tag\">{axis.lowTag}</span>\n                  <span className=\"axr-arrow\">←―――→</span>\n                  <span className=\"axr-tag\">{axis.highTag}</span>\n                </div>\n\n                {usage.length > 0 && (\n                  <div className=\"axr-usage-info\">\n                    Used in:{\" \"}\n                    {usage.map((u, i) => (\n                      <span key={u.kind}>\n                        {i > 0 && \", \"}\n                        <span className=\"axr-usage-kind\">\n                          {u.description || u.kind} ({u.axis})\n                        </span>\n                      </span>\n                    ))}\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Create/Edit Modal */}\n      {showModal && (\n        <div className=\"axr-modal\" onClick={closeModal} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") closeModal(); }} >\n          <div className=\"axr-modal-content\" onClick={(e) => e.stopPropagation()} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n            <div className=\"axr-modal-title\">\n              {editingAxis ? `Edit Axis: ${editingAxis.name}` : \"New Axis Definition\"}\n            </div>\n\n            <div className=\"axr-form-group\">\n              <label htmlFor=\"name\" className=\"axr-label\">Name</label>\n              <input id=\"name\"\n                className=\"axr-input\"\n                placeholder=\"e.g., Power, Alignment, Element\"\n                value={formData.name}\n                onChange={(e) => handleNameChange(e.target.value)}\n                // eslint-disable-next-line jsx-a11y/no-autofocus\n                autoFocus\n              />\n            </div>\n\n            <div className=\"axr-form-group\">\n              <label htmlFor=\"id\" className=\"axr-label\">ID</label>\n              <input id=\"id\"\n                className=\"axr-input\"\n                placeholder=\"e.g., power, alignment, element\"\n                value={formData.id}\n                onChange={(e) => setFormData({ ...formData, id: e.target.value })}\n                disabled={!!editingAxis}\n              />\n              <div className=\"axr-hint\">\n                {editingAxis ? \"ID cannot be changed\" : \"Auto-generated from name\"}\n              </div>\n            </div>\n\n            <div className=\"axr-form-group\">\n              <label htmlFor=\"description-optional\" className=\"axr-label\">Description (optional)</label>\n              <input id=\"description-optional\"\n                className=\"axr-input\"\n                placeholder=\"Brief description of this axis\"\n                value={formData.description}\n                onChange={(e) => setFormData({ ...formData, description: e.target.value })}\n              />\n            </div>\n\n            <div className=\"axr-input-row\">\n              <div className=\"axr-input-half\">\n                <div className=\"axr-form-group\">\n                  <label className=\"axr-label\">Low Tag (0)\n                  <TagSelector\n                    tagRegistry={tagRegistry}\n                    value={formData.lowTag ? [formData.lowTag] : []}\n                    onChange={(tags) => setFormData({ ...formData, lowTag: tags[0] || \"\" })}\n                    onAddToRegistry={(newTag) => onTagRegistryChange([...tagRegistry, newTag])}\n                    placeholder=\"Select or create tag...\"\n                    singleSelect\n                  />\n                  </label>\n                </div>\n              </div>\n              <div className=\"axr-input-half\">\n                <div className=\"axr-form-group\">\n                  <label className=\"axr-label\">High Tag (100)\n                  <TagSelector\n                    tagRegistry={tagRegistry}\n                    value={formData.highTag ? [formData.highTag] : []}\n                    onChange={(tags) => setFormData({ ...formData, highTag: tags[0] || \"\" })}\n                    onAddToRegistry={(newTag) => onTagRegistryChange([...tagRegistry, newTag])}\n                    placeholder=\"Select or create tag...\"\n                    singleSelect\n                  />\n                  </label>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"axr-hint\">\n              Tags will be auto-created in the registry with isAxis=true and set as mutually\n              exclusive.\n            </div>\n\n            <div className=\"axr-modal-actions\">\n              <button className=\"axr-cancel-button\" onClick={closeModal}>\n                Cancel\n              </button>\n              <button\n                className=\"axr-save-button\"\n                style={{ '--axr-save-opacity': formData.name && formData.lowTag && formData.highTag ? 1 : 0.5 }}\n                onClick={saveAxis}\n                disabled={!formData.name || !formData.lowTag || !formData.highTag}\n              >\n                {editingAxis ? \"Save Changes\" : \"Create Axis\"}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nAxisRegistryEditor.propTypes = {\n  axisDefinitions: PropTypes.array,\n  entityKinds: PropTypes.array,\n  tagRegistry: PropTypes.array,\n  onAxisDefinitionsChange: PropTypes.func,\n  onTagRegistryChange: PropTypes.func,\n};\n","numLines":378,"startLine":1,"totalLines":378}}}
