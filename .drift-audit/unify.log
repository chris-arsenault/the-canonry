-secondary);\n}\n\n.ecp-prominence-dot-empty {\n  background: rgb(148 163 184 / 25%);\n}\n\n.ecp-prominence-wrap {\n  display: inline-flex;\n  align-items: center;\n}\n\n/* ── Ratio indicator ── */\n.ecp-ratio-muted {\n  color: var(--text-muted);\n  font-size: 10px;\n}\n\n.ecp-ratio-value {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--ecp-ratio-color);\n}\n\n/* ── Significance stars ── */\n.ecp-sig-stars {\n  font-size: 10px;\n  color: #f59e0b;\n  letter-spacing: -1px;\n}\n\n/* ── Coverage indicator ── */\n.ecp-coverage-covered {\n  color: #22c55e;\n  font-size: 11px;\n}\n\n.ecp-coverage-uncovered {\n  color: #ef4444;\n  font-size: 11px;\n}\n\n/* ── Status dot ── */\n.ecp-status-dot {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n\n.ecp-status-dot-active {\n  background: #22c55e;\n  border: none;\n}\n\n.ecp-status-dot-inactive {\n  background: rgb(148 163 184 / 30%);\n  border: 1px solid rgb(148 163 184 / 40%);\n}\n\n/* ── Section toolbar ── */\n.ecp-section-toolbar {\n  display: flex;\n  gap: 8px;\n  padding: 8px 16px;\n  border-bottom: 1px solid var(--border-color);\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n/* ── Filter select ── */\n.ecp-filter-select {\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  padding: 3px 6px;\n  font-size: 11px;\n}\n\n/* ── Section header ── */\n.ecp-section-header {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 10px 16px;\n  cursor: pointer;\n  user-select: none;\n}\n\n.ecp-section-arrow {\n  font-size: 10px;\n  color: var(--text-muted);\n  flex-shrink: 0;\n}\n\n.ecp-section-label {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--text-color);\n  flex-shrink: 0;\n}\n\n.ecp-section-underutil {\n  font-size: 10px;\n  color: #f59e0b;\n  flex-shrink: 0;\n}\n\n.ecp-section-desc {\n  font-size: 11px;\n  color: var(--text-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* ── Auto count / summary text ── */\n.ecp-auto-count {\n  margin-left: auto;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* ── Checkbox label (filter rows) ── */\n.ecp-checkbox-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n/* ── Suggestion action detail ── */\n.ecp-detail-wrap {\n  background: var(--bg-secondary);\n  border-top: 1px solid var(--border-color);\n}\n\n.ecp-detail-inner {\n  padding: 8px 16px 8px 32px;\n}\n\n.ecp-detail-heading {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-secondary);\n  margin-bottom: 6px;\n}\n\n.ecp-detail-covered-note {\n  color: var(--text-muted);\n  font-weight: 400;\n}\n\n/* ── Suggestion event card ── */\n.ecp-event-card {\n  margin-bottom: 8px;\n  padding: 6px 8px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-primary);\n}\n\n.ecp-event-headline-row {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.ecp-event-headline {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-color);\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.ecp-event-era {\n  font-size: 10px;\n  color: var(--text-muted);\n  flex-shrink: 0;\n}\n\n.ecp-entity-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 10px;\n}\n\n.ecp-entity-chip {\n  font-size: 11px;\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.ecp-entity-icon-subject {\n  color: #60a5fa;\n  font-size: 9px;\n}\n\n.ecp-entity-icon-participant {\n  color: var(--text-muted);\n  font-size: 9px;\n}\n\n.ecp-entity-name {\n  color: var(--text-color);\n}\n\n.ecp-entity-kind {\n  color: var(--text-muted);\n  font-size: 10px;\n}\n\n.ecp-entity-new {\n  color: #a855f7;\n  font-size: 9px;\n}\n\n.ecp-entity-appearances {\n  color: var(--text-muted);\n  font-size: 9px;\n}\n\n/* ── Suggestion expand toggle td ── */\n.ecp-expand-td {\n  width: 16px;\n  text-align: center;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.ecp-row-clickable {\n  cursor: pointer;\n}\n\n/* ── Table cell expand detail ── */\n.ecp-expand-detail-td {\n  padding: 0;\n}\n\n/* ── Color classes for inline values ── */\n.ecp-color-green {\n  color: #22c55e;\n}\n\n.ecp-color-red {\n  color: #ef4444;\n}\n\n.ecp-color-amber {\n  color: #f59e0b;\n}\n\n.ecp-color-muted {\n  color: var(--text-muted);\n}\n\n.ecp-color-blue {\n  color: #60a5fa;\n}\n\n.ecp-color-purple {\n  color: #a855f7;\n}\n\n.ecp-font-bold {\n  font-weight: 600;\n}\n\n/* ── Divergence and gap value styling ── */\n.ecp-divergence-warning {\n  color: #f59e0b;\n  font-weight: 600;\n}\n\n/* ── Status dot row (integration section) ── */\n.ecp-status-dot-row {\n  display: inline-flex;\n  gap: 6px;\n  align-items: center;\n}\n\n/* ── Potential rating ── */\n.ecp-potential-stars {\n  color: #f59e0b;\n  letter-spacing: -1px;\n}\n\n.ecp-never-primary {\n  font-size: 9px;\n  color: #a855f7;\n  margin-left: 4px;\n}\n\n/* ── Era chronicle count ── */\n.ecp-era-completed {\n  color: var(--text-muted);\n  margin-left: 4px;\n}\n\n/* ── Pre-calculation panel ── */\n.ecp-pre-calc {\n  margin-top: 16px;\n}\n\n.ecp-pre-calc-inner {\n  padding: 16px;\n}\n\n.ecp-pre-calc-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.ecp-pre-calc-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.ecp-pre-calc-desc {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin: 8px 0 12px;\n}\n\n.ecp-btn-pad-sm {\n  padding: 8px 16px;\n  font-size: 12px;\n}\n\n/* ── Post-calculation wrapper ── */\n.ecp-wrapper {\n  margin-top: 16px;\n}\n\n.ecp-header-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 16px;\n}\n\n.ecp-header-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.ecp-header-stats {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.ecp-recalc-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n  margin-left: auto;\n}\n\n/* ── Frequency view: rare count highlight ── */\n.ecp-rare-count {\n  font-weight: 600;\n  color: #f59e0b;\n}\n\n/* ── Card with bottom margin ── */\n.ecp-header-card {\n  margin-bottom: 8px;\n}\n","numLines":390,"startLine":1,"totalLines":390}}}
