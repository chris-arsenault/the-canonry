},"parent_tool_use_id":null,"session_id":"b63bbfa3-8e9b-4041-b254-e9bba5dedd64","uuid":"a6e790bc-931f-493e-baf9-137167037f8b","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/GraphView.css","content":"/* GraphView Component Styles */\n\n/* Outer wrapper */\n.gv-wrapper {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n}\n\n/* Cytoscape container */\n.gv-cytoscape {\n  width: 100%;\n  height: 100%;\n}\n\n/* Legend panel */\n.gv-legend {\n  background: linear-gradient(135deg, rgba(30, 58, 95, 0.95) 0%, rgba(10, 25, 41, 0.95) 100%);\n}\n\n.gv-legend-header {\n  background: rgba(59, 130, 246, 0.1);\n}\n\n.gv-legend-footer {\n  background: rgba(59, 130, 246, 0.05);\n}\n\n/* Legend swatch with dynamic color and shape */\n.gv-legend-swatch {\n  background-color: var(--gv-swatch-color);\n}\n\n/* Shape variants for legend swatches */\n.gv-shape-ellipse {\n  border-radius: 50%;\n}\n\n.gv-shape-diamond {\n  transform: rotate(45deg);\n}\n\n.gv-shape-hexagon {\n  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);\n}\n\n.gv-shape-star {\n  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);\n}\n\n.gv-shape-triangle {\n  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);\n}\n\n.gv-shape-octagon {\n  clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);\n}\n\n/* Controls hint panel */\n.gv-controls {\n  background: linear-gradient(135deg, rgba(30, 58, 95, 0.95) 0%, rgba(10, 25, 41, 0.95) 100%);\n}\n\n.gv-controls-header {\n  background: rgba(59, 130, 246, 0.1);\n}\n","numLines":67,"startLine":1,"totalLines":67}}}
