{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019vYMfyLyUQfRMfAt5ryWAR","type":"tool_result","content":"     1→/**\n     2→ * useBulkHistorian - Sequential bulk historian annotation and copy-edit for entities\n     3→ *\n     4→ * Follows the useBulkBackport pattern:\n     5→ * 1. prepareBulkHistorian() — build entity summary, enter 'confirming' state\n     6→ * 2. User reviews entity list in BulkHistorianModal and clicks Confirm\n     7→ * 3. confirmBulkHistorian() — processes all entities sequentially, auto-accepting results\n     8→ *\n     9→ * Handles three operation types:\n    10→ * - 'review': Historian annotations (margin notes). Tones cycle through all 5 per entity.\n    11→ * - 'edition': Historian copy-edit (full description rewrite). Single user-selected tone.\n    12→ * - 'clear': Remove all historian annotations from selected entities.\n    13→ */\n    14→\n    15→import { useState, useCallback, useRef, useEffect } from \"react\";\n    16→import type { EnrichmentType } from \"../lib/enrichmentTypes\";\n    17→import { getEnqueue } from \"../lib/db/enrichmentQueueBridge\";\n    18→import type { EntityNavItem } from \"../lib/db/entityNav\";\n    19→import type { HistorianTone, HistorianNote } from \"../lib/historianTypes\";\n    20→import type { HistorianReviewConfig } from \"./useHistorianReview\";\n    21→import type { HistorianEditionConfig } from \"./useHistorianEdition\";\n    22→import type { SummaryRevisionPatch } from \"../lib/summaryRevisionTypes\";\n    23→import { createHistorianRun, generateHistorianRunId } from \"../lib/db/historianRepository\";\n    24→import {\n    25→  createRevisionRun,\n    26→  getRevisionRun,\n    27→  generateRevisionRunId,\n    28→  deleteRevisionRun,\n    29→} from \"../lib/db/summaryRevisionRepository\";\n    30→import {\n    31→  dispatchReviewTask as sharedDispatchReview,\n    32→  pollReviewCompletion as sharedPollReview,\n    33→  sleep,\n    34→  POLL_INTERVAL_MS,\n    35→} from \"../lib/db/historianRunHelpers\";\n    36→\n    37→// ============================================================================\n    38→// Types\n    39→// ============================================================================\n    40→\n    41→export type BulkHistorianOperation = \"review\" | \"edition\" | \"clear\";\n    42→\n    43→export interface BulkHistorianEntitySummary {\n    44→  entityId: string;\n    45→  entityName: string;\n    46→  entityKind: string;\n    47→  entitySubtype: string;\n    48→  tone?: HistorianTone;\n    49→  tokenEstimate?: number; // estimated output tokens based on current description word count\n    50→}\n    51→\n    52→export interface BulkHistorianProgress {\n    53→  status: \"idle\" | \"confirming\" | \"running\" | \"complete\" | \"cancelled\" | \"failed\";\n    54→  operation: BulkHistorianOperation;\n    55→  tone: HistorianTone;\n    56→  entities: BulkHistorianEntitySummary[];\n    57→  totalEntities: number;\n    58→  processedEntities: number;\n    59→  currentEntityName: string;\n    60→  currentEntityTone?: HistorianTone;"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"4dc69225-45e2-4757-85c8-b4f722a2d831"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017c6ABc3JGixH899kQCT8A7","type":"tool_result","content":"     1→/**\n     2→ * useDataSync - Hook for data synchronization between hard state and Dexie\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Manages:\n     5→ * - Hard state import (overwrite / patch modes)\n     6→ * - Entity update handling from enrichment queue\n     7→ * - Era summary refresh\n     8→ * - Store initialization from Dexie\n     9→ * - Entity/event reload helpers\n    10→ */\n    11→\n    12→import { useState, useCallback, useEffect } from \"react\";\n    13→import * as entityRepo from \"../lib/db/entityRepository\";\n    14→import * as eventRepo from \"../lib/db/eventRepository\";\n    15→import * as relationshipRepo from \"../lib/db/relationshipRepository\";\n    16→import * as slotRepo from \"../lib/db/slotRepository\";\n    17→import * as schemaRepo from \"../lib/db/schemaRepository\";\n    18→import * as coordinateStateRepo from \"../lib/db/coordinateStateRepository\";\n    19→import { useEntityStore } from \"../lib/db/entityStore\";\n    20→import { useIndexStore } from \"../lib/db/indexStore\";\n    21→import { useNarrativeEventStore } from \"../lib/db/narrativeEventStore\";\n    22→import { useRelationshipStore } from \"../lib/db/relationshipStore\";\n    23→import { useChronicleStore } from \"../lib/db/chronicleStore\";\n    24→import { refreshEraSummariesInChronicles } from \"../lib/db/chronicleRepository\";\n    25→import { computeRunIndexes } from \"../lib/db/indexComputation\";\n    26→import { upsertRunIndexes } from \"../lib/db/indexRepository\";\n    27→\n    28→// --- Extracted helpers for handleDataSync (cognitive complexity reduction) ---\n    29→\n    30→function resolveFinalEraIdFromHardState(hardState, eraValue) {\n    31→  if (!eraValue) return null;\n    32→  const eraEntity = (hardState || []).find(\n    33→    (entity) =>\n    34→      entity.kind === \"era\" &&\n    35→      (entity.id === eraValue || entity.eraId === eraValue || entity.name === eraValue)\n    36→  );\n    37→  return eraEntity ? eraEntity.eraId || eraEntity.id || eraValue : eraValue;\n    38→}\n    39→\n    40→function validateHardStateAvailable(worldData, hasHardState) {\n    41→  const hardRunId = worldData?.metadata?.simulationRunId;\n    42→  if (!hardRunId) return { error: \"Missing simulation run ID in hard state.\" };\n    43→  const hasData = hasHardState && worldData?.hardState?.length > 0;\n    44→  if (!hasData) return { error: \"No hard state available to import.\" };\n    45→  return { hardRunId };\n    46→}\n    47→\n    48→function validateDataSyncPreconditions(mode, worldData, hasHardState, slotRecord) {\n    49→  const result = validateHardStateAvailable(worldData, hasHardState);\n    50→  if (result.error) return result;\n    51→  const { hardRunId } = result;\n    52→  if (slotRecord?.simulationRunId && slotRecord.simulationRunId !== hardRunId) {\n    53→    const ok = window.confirm(\n    54→      `Hard state run ID (${hardRunId}) does not match this slot's run (${slotRecord.simulationRunId}). Importing will switch this slot to the hard state run. Continue?`\n    55→    );\n    56→    if (!ok) return { cancelled: true };\n    57→  }\n    58→  if (mode === \"overwrite\") {\n    59→    const ok = window.confirm(\n    60→      \"Overwrite will replace ALL Dexie entities, events, and relationships for this run with hard state. This can delete local enrichment. Continue?\"\n    61→    );\n    62→    if (!ok) return { cancelled: true };\n    63→  }\n    64→  return { hardRunId };\n    65→}\n    66→\n    67→async function syncAncillaryData(hardRunId, projectId, worldData) {\n    68→  if (projectId && worldData?.schema) {\n    69→    await schemaRepo.upsertSchema(projectId, worldData.schema);\n    70→  }\n    71→  if (worldData?.coordinateState) {\n    72→    await coordinateStateRepo.upsertCoordinateState(hardRunId, worldData.coordinateState);\n    73→  }\n    74→}\n    75→\n    76→function resolveSlotLabel(slotRecord, activeSlotIndex) {\n    77→  if (slotRecord?.label) return slotRecord.label;\n    78→  return activeSlotIndex === 0 ? \"Scratch\" : `Slot ${activeSlotIndex}`;\n    79→}\n    80→\n    81→function resolveFinalTick(metadata) {\n    82→  return Number.isFinite(metadata?.tick) ? metadata.tick : null;\n    83→}\n    84→\n    85→function buildNextSlotRecord(hardRunId, projectId, activeSlotIndex, worldData, slotRecord) {\n    86→  return {\n    87→    projectId,\n    88→    slotIndex: activeSlotIndex,\n    89→    simulationRunId: hardRunId,\n    90→    finalTick: resolveFinalTick(worldData?.metadata),\n    91→    finalEraId: resolveFinalEraIdFromHardState(worldData.hardState, worldData?.metadata?.era),\n    92→    label: resolveSlotLabel(slotRecord, activeSlotIndex),\n    93→    isTemporary: slotRecord?.isTemporary ?? activeSlotIndex === 0,\n    94→    updatedAt: Date.now(),\n    95→  };\n    96→}\n    97→\n    98→async function performOverwriteSync(hardRunId, worldData) {\n    99→  await Promise.all([\n   100→    entityRepo.deleteEntitiesForRun(hardRunId),\n   101→    eventRepo.deleteEventsForRun(hardRunId),\n   102→    relationshipRepo.deleteRelationshipsForRun(hardRunId),\n   103→  ]);\n   104→  await entityRepo.seedEntities(hardRunId, worldData.hardState);\n   105→  if (worldData.narrativeHistory?.length) {\n   106→    await eventRepo.seedNarrativeEvents(hardRunId, worldData.narrativeHistory);\n   107→  }\n   108→  if (worldData.relationships?.length) {\n   109→    await relationshipRepo.seedRelationships(hardRunId, worldData.relationships);\n   110→  }\n   111→  return \"Overwrite complete. Dexie now matches hard state for this run.\";\n   112→}\n   113→\n   114→async function performPatchSync(hardRunId, worldData) {\n   115→  const { added, patched } = await entityRepo.patchEntitiesFromHardState(\n   116→    hardRunId,\n   117→    worldData.hardState\n   118→  );\n   119→  const eventsAdded = await eventRepo.patchNarrativeEvents(\n   120→    hardRunId,\n   121→    worldData.narrativeHistory || []\n   122→  );\n   123→  const relationshipsAdded = await relationshipRepo.patchRelationships(\n   124→    hardRunId,\n   125→    worldData.relationships || []\n   126→  );\n   127→  return `Patch complete. Entities added: ${added}, patched: ${patched}. Events added: ${eventsAdded}. Relationships added: ${relationshipsAdded}.`;\n   128→}\n   129→\n   130→async function reinitializeStoresAfterSync(hardRunId) {\n   131→  const store = useEntityStore.getState();\n   132→  store.reset();\n   133→  await store.initialize(hardRunId);\n   134→\n   135→  const allEntities = await entityRepo.getEntitiesForRun(hardRunId);\n   136→  const indexRecord = computeRunIndexes(hardRunId, allEntities);\n   137→  await upsertRunIndexes(indexRecord);\n   138→  const indexStore = useIndexStore.getState();\n   139→  indexStore.reset();\n   140→  await indexStore.initialize(hardRunId);\n   141→\n   142→  useNarrativeEventStore.getState().reset();\n   143→  await useNarrativeEventStore.getState().initialize(hardRunId);\n   144→  useRelationshipStore.getState().reset();\n   145→  await useRelationshipStore.getState().initialize(hardRunId);\n   146→\n   147→  window.dispatchEvent(\n   148→    new CustomEvent(\"illuminator:worlddata-changed\", {\n   149→      detail: { simulationRunId: hardRunId, scope: \"all\" },\n   150→    })\n   151→  );\n   152→}\n   153→\n   154→// --- Entity update dispatch helpers ---\n   155→\n   156→async function applyEntityEnrichment(entityId, output) {\n   157→  if (output.enrichment?.image) {\n   158→    await entityRepo.applyImageResult(entityId, output.enrichment.image);\n   159→    return;\n   160→  }\n   161→  if (output.enrichment?.entityChronicle) {\n   162→    await entityRepo.applyEntityChronicleResult(entityId, output.enrichment.entityChronicle);\n   163→    return;\n   164→  }\n   165→  if (output.enrichment?.text && !output.description) {\n   166→    await entityRepo.applyVisualThesisResult(\n   167→      entityId,\n   168→      output.enrichment.text.visualThesis,\n   169→      output.enrichment.text.visualTraits || [],\n   170→      {\n   171→        generatedAt: output.enrichment.text.generatedAt,\n   172→        model: output.enrichment.text.model,\n   173→        estimatedCost: output.enrichment.text.estimatedCost,\n   174→        actualCost: output.enrichment.text.actualCost,\n   175→        inputTokens: output.enrichment.text.inputTokens,\n   176→        outputTokens: output.enrichment.text.outputTokens,\n   177→        chainDebug: output.enrichment.text.chainDebug,\n   178→      }\n   179→    );\n   180→    return;\n   181→  }\n   182→  await entityRepo.applyDescriptionResult(\n   183→    entityId,\n   184→    output.enrichment,\n   185→    output.summary,\n   186→    output.description\n   187→  );\n   188→}\n   189→\n   190→// --- Reload helpers (module-level to reduce hook body) ---\n   191→\n   192→function createReloadEntities(simulationRunId) {\n   193→  return async (invalidateIds, overrideRunId) => {\n   194→    const runId = overrideRunId ?? simulationRunId;\n   195→    if (!runId) return;\n   196→    const store = useEntityStore.getState();\n   197→    if (invalidateIds?.length) {\n   198→      await store.refreshEntities(invalidateIds);\n   199→    } else {\n   200→      await store.refreshAll();\n   201→    }\n   202→    window.dispatchEvent(\n   203→      new CustomEvent(\"illuminator:worlddata-changed\", {\n   204→        detail: { simulationRunId: runId, scope: \"entities\" },\n   205→      })\n   206→    );\n   207→  };\n   208→}\n   209→\n   210→function createReloadEntitiesAndEvents(simulationRunId) {\n   211→  return async (invalidateIds, overrideRunId) => {\n   212→    const runId = overrideRunId ?? simulationRunId;\n   213→    if (!runId) return;\n   214→    const entityStore = useEntityStore.getState();\n   215→    if (invalidateIds?.length) {\n   216→      await entityStore.refreshEntities(invalidateIds);\n   217→    } else {\n   218→      await entityStore.refreshAll();\n   219→    }\n   220→    await useNarrativeEventStore.getState().refreshAll();\n   221→    window.dispatchEvent(\n   222→      new CustomEvent(\"illuminator:worlddata-changed\", {\n   223→        detail: { simulationRunId: runId, scope: \"entities+events\" },\n   224→      })\n   225→    );\n   226→  };\n   227→}\n   228→\n   229→async function initializeStoresForRun(simulationRunId) {\n   230→  await useEntityStore.getState().initialize(simulationRunId);\n   231→  await useIndexStore.getState().initialize(simulationRunId);\n   232→  await useNarrativeEventStore.getState().initialize(simulationRunId);\n   233→  await useRelationshipStore.getState().initialize(simulationRunId);\n   234→}\n   235→\n   236→// --- Main hook ---\n   237→\n   238→export function useDataSync({\n   239→  projectId,\n   240→  activeSlotIndex,\n   241→  worldData,\n   242→  hasHardState,\n   243→  slotRecord,\n   244→  setSlotRecord,\n   245→  simulationRunId,\n   246→  eraTemporalInfo,\n   247→}) {\n   248→  const [dataSyncStatus, setDataSyncStatus] = useState(null);\n   249→  const [isDataSyncing, setIsDataSyncing] = useState(false);\n   250→\n   251→  const reloadEntities = useCallback(\n   252→    (invalidateIds, overrideRunId) =>\n   253→      createReloadEntities(simulationRunId)(invalidateIds, overrideRunId),\n   254→    [simulationRunId]\n   255→  );\n   256→  const reloadEntitiesAndEvents = useCallback(\n   257→    (invalidateIds, overrideRunId) =>\n   258→      createReloadEntitiesAndEvents(simulationRunId)(invalidateIds, overrideRunId),\n   259→    [simulationRunId]\n   260→  );\n   261→\n   262→  const handleDataSync = useCallback(\n   263→    async (mode) => {\n   264→      const result = validateDataSyncPreconditions(mode, worldData, hasHardState, slotRecord);\n   265→      if (result.error) {\n   266→        setDataSyncStatus({ type: \"error\", message: result.error });\n   267→        return;\n   268→      }\n   269→      if (result.cancelled) return;\n   270→      setIsDataSyncing(true);\n   271→      setDataSyncStatus(null);\n   272→      try {\n   273→        const message =\n   274→          mode === \"overwrite\"\n   275→            ? await performOverwriteSync(result.hardRunId, worldData)\n   276→            : await performPatchSync(result.hardRunId, worldData);\n   277→        setDataSyncStatus({ type: \"success\", message });\n   278→        await syncAncillaryData(result.hardRunId, projectId, worldData);\n   279→        const nextSlot = buildNextSlotRecord(\n   280→          result.hardRunId,\n   281→          projectId,\n   282→          activeSlotIndex,\n   283→          worldData,\n   284→          slotRecord\n   285→        );\n   286→        await slotRepo.upsertSlot(nextSlot);\n   287→        setSlotRecord(nextSlot);\n   288→        await reinitializeStoresAfterSync(result.hardRunId);\n   289→      } catch (err) {\n   290→        setDataSyncStatus({\n   291→          type: \"error\",\n   292→          message: err instanceof Error ? err.message : String(err),\n   293→        });\n   294→      } finally {\n   295→        setIsDataSyncing(false);\n   296→      }\n   297→    },\n   298→    [activeSlotIndex, hasHardState, projectId, slotRecord, worldData, setSlotRecord]\n   299→  );\n   300→\n   301→  const handleEntityUpdate = useCallback(\n   302→    async (entityId, output) => {\n   303→      await applyEntityEnrichment(entityId, output);\n   304→      await reloadEntities([entityId]);\n   305→    },\n   306→    [reloadEntities]\n   307→  );\n   308→\n   309→  const handleRefreshEraSummaries = useCallback(async () => {\n   310→    if (!simulationRunId || !eraTemporalInfo.length) return 0;\n   311→    const count = await refreshEraSummariesInChronicles(simulationRunId, eraTemporalInfo);\n   312→    if (count > 0) await useChronicleStore.getState().refreshAll();\n   313→    return count;\n   314→  }, [simulationRunId, eraTemporalInfo]);\n   315→\n   316→  useEffect(() => {\n   317→    const handler = (event) => {\n   318→      if (!simulationRunId) return;\n   319→      reloadEntities(event?.detail?.entityIds);\n   320→    };\n   321→    window.addEventListener(\"entities-updated\", handler);\n   322→    return () => window.removeEventListener(\"entities-updated\", handler);\n   323→  }, [reloadEntities, simulationRunId]);\n   324→\n   325→  useEffect(() => {\n   326→    if (!simulationRunId) return;\n   327→    initializeStoresForRun(simulationRunId).catch((err) =>\n   328→      console.warn(\"[Illuminator] DAL load failed:\", err)\n   329→    );\n   330→  }, [simulationRunId]);\n   331→\n   332→  return {\n   333→    dataSyncStatus,\n   334→    isDataSyncing,\n   335→    handleDataSync,\n   336→    handleEntityUpdate,\n   337→    handleRefreshEraSummaries,\n   338→    reloadEntities,\n   339→    reloadEntitiesAndEvents,\n   340→  };\n   341→}\n   342→"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"764bb5d2-8759-4628-8c77-c3738074b7d9"}
