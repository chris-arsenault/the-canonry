{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GMcfN7ydmWDjLdChiY6zdY","type":"tool_result","content":"     1→import React, { useState, useEffect } from \"react\";\n     2→import PropTypes from \"prop-types\";\n     3→import \"./ChronicleVersionSelector.css\";\n     4→\n     5→export default function ChronicleVersionSelector({\n     6→  versions,\n     7→  selectedVersionId,\n     8→  activeVersionId,\n     9→  compareToVersionId,\n    10→  onSelectVersion,\n    11→  onSelectCompareVersion,\n    12→  onSetActiveVersion,\n    13→  onDeleteVersion,\n    14→  disabled,\n    15→}) {\n    16→  const isActive = selectedVersionId === activeVersionId;\n    17→  const canDelete = versions.length > 1 && onDeleteVersion;\n    18→  const [confirmingDeleteId, setConfirmingDeleteId] = useState(null);\n    19→  const confirmingDelete = confirmingDeleteId === selectedVersionId;\n    20→\n    21→  useEffect(() => {\n    22→    if (!confirmingDeleteId) return;\n    23→    const stillExists = versions.some((v) => v.id === confirmingDeleteId);\n    24→    if (!stillExists || confirmingDeleteId !== selectedVersionId || disabled) {\n    25→      setConfirmingDeleteId(null);\n    26→    }\n    27→  }, [confirmingDeleteId, selectedVersionId, versions, disabled]);\n    28→\n    29→  const handleDeleteClick = () => {\n    30→    if (confirmingDelete) {\n    31→      onDeleteVersion(selectedVersionId);\n    32→      setConfirmingDeleteId(null);\n    33→    } else {\n    34→      setConfirmingDeleteId(selectedVersionId);\n    35→    }\n    36→  };\n    37→\n    38→  return (\n    39→    <div className=\"cvs-container\">\n    40→      <select\n    41→        value={selectedVersionId}\n    42→        onChange={(e) => {\n    43→          onSelectVersion(e.target.value);\n    44→          setConfirmingDeleteId(null);\n    45→        }}\n    46→        disabled={disabled}\n    47→        className=\"illuminator-select cvs-select-version\"\n    48→      >\n    49→        {versions.map((version) => (\n    50→          <option key={version.id} value={version.id}>\n    51→            {version.label}\n    52→          </option>\n    53→        ))}\n    54→      </select>\n    55→      <select\n    56→        value={compareToVersionId}\n    57→        onChange={(e) => onSelectCompareVersion(e.target.value)}\n    58→        disabled={disabled}\n    59→        className=\"illuminator-select cvs-select-compare\"\n    60→        title=\"Select a version to diff against\"\n    61→      >\n    62→        <option value=\"\">Compare to...</option>\n    63→        {versions\n    64→          .filter((v) => v.id !== selectedVersionId)\n    65→          .map((version) => (\n    66→            <option key={version.id} value={version.id}>\n    67→              {version.shortLabel || version.label}\n    68→            </option>\n    69→          ))}\n    70→      </select>\n    71→      {isActive ? (\n    72→        <span className=\"cvs-active-badge\">Active</span>\n    73→      ) : (\n    74→        <button\n    75→          onClick={() => onSetActiveVersion?.(selectedVersionId)}\n    76→          disabled={disabled || !onSetActiveVersion}\n    77→          className=\"cvs-btn-make-active\"\n    78→        >\n    79→          Make Active\n    80→        </button>\n    81→      )}\n    82→      {canDelete && (\n    83→        <button\n    84→          onClick={handleDeleteClick}\n    85→          onBlur={() => setConfirmingDeleteId(null)}\n    86→          disabled={disabled}\n    87→          title={confirmingDelete ? \"Click again to confirm deletion\" : \"Delete this version\"}\n    88→          className={`cvs-btn-delete${confirmingDelete ? \" cvs-btn-delete-confirming\" : \"\"}`}\n    89→        >\n    90→          {confirmingDelete ? \"Confirm Delete\" : \"Delete\"}\n    91→        </button>\n    92→      )}\n    93→    </div>\n    94→  );\n    95→}\n    96→\n    97→ChronicleVersionSelector.propTypes = {\n    98→  versions: PropTypes.array,\n    99→  selectedVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   100→  activeVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   101→  compareToVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   102→  onSelectVersion: PropTypes.func,\n   103→  onSelectCompareVersion: PropTypes.func,\n   104→  onSetActiveVersion: PropTypes.func,\n   105→  onDeleteVersion: PropTypes.func,\n   106→  disabled: PropTypes.bool,\n   107→};\n   108→"}]},"parent_tool_use_id":null,"session_id":"012353ca-34db-4cb3-82b9-4cf23efde1ac","uuid":"ccd149f4-1ab9-469d-adac-9e6d7e300f24","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/chronicle-workspace/ChronicleVersionSelector.jsx","content":"import React, { useState, useEffect } from \"react\";\nimport PropTypes from \"prop-types\";\nimport \"./ChronicleVersionSelector.css\";\n\nexport default function ChronicleVersionSelector({\n  versions,\n  selectedVersionId,\n  activeVersionId,\n  compareToVersionId,\n  onSelectVersion,\n  onSelectCompareVersion,\n  onSetActiveVersion,\n  onDeleteVersion,\n  disabled,\n}) {\n  const isActive = selectedVersionId === activeVersionId;\n  const canDelete = versions.length > 1 && onDeleteVersion;\n  const [confirmingDeleteId, setConfirmingDeleteId] = useState(null);\n  const confirmingDelete = confirmingDeleteId === selectedVersionId;\n\n  useEffect(() => {\n    if (!confirmingDeleteId) return;\n    const stillExists = versions.some((v) => v.id === confirmingDeleteId);\n    if (!stillExists || confirmingDeleteId !== selectedVersionId || disabled) {\n      setConfirmingDeleteId(null);\n    }\n  }, [confirmingDeleteId, selectedVersionId, versions, disabled]);\n\n  const handleDeleteClick = () => {\n    if (confirmingDelete) {\n      onDeleteVersion(selectedVersionId);\n      setConfirmingDeleteId(null);\n    } else {\n      setConfirmingDeleteId(selectedVersionId);\n    }\n  };\n\n  return (\n    <div className=\"cvs-container\">\n      <select\n        value={selectedVersionId}\n        onChange={(e) => {\n          onSelectVersion(e.target.value);\n          setConfirmingDeleteId(null);\n        }}\n        disabled={disabled}\n        className=\"illuminator-select cvs-select-version\"\n      >\n        {versions.map((version) => (\n          <option key={version.id} value={version.id}>\n            {version.label}\n          </option>\n        ))}\n      </select>\n      <select\n        value={compareToVersionId}\n        onChange={(e) => onSelectCompareVersion(e.target.value)}\n        disabled={disabled}\n        className=\"illuminator-select cvs-select-compare\"\n        title=\"Select a version to diff against\"\n      >\n        <option value=\"\">Compare to...</option>\n        {versions\n          .filter((v) => v.id !== selectedVersionId)\n          .map((version) => (\n            <option key={version.id} value={version.id}>\n              {version.shortLabel || version.label}\n            </option>\n          ))}\n      </select>\n      {isActive ? (\n        <span className=\"cvs-active-badge\">Active</span>\n      ) : (\n        <button\n          onClick={() => onSetActiveVersion?.(selectedVersionId)}\n          disabled={disabled || !onSetActiveVersion}\n          className=\"cvs-btn-make-active\"\n        >\n          Make Active\n        </button>\n      )}\n      {canDelete && (\n        <button\n          onClick={handleDeleteClick}\n          onBlur={() => setConfirmingDeleteId(null)}\n          disabled={disabled}\n          title={confirmingDelete ? \"Click again to confirm deletion\" : \"Delete this version\"}\n          className={`cvs-btn-delete${confirmingDelete ? \" cvs-btn-delete-confirming\" : \"\"}`}\n        >\n          {confirmingDelete ? \"Confirm Delete\" : \"Delete\"}\n        </button>\n      )}\n    </div>\n  );\n}\n\nChronicleVersionSelector.propTypes = {\n  versions: PropTypes.array,\n  selectedVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  activeVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  compareToVersionId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  onSelectVersion: PropTypes.func,\n  onSelectCompareVersion: PropTypes.func,\n  onSetActiveVersion: PropTypes.func,\n  onDeleteVersion: PropTypes.func,\n  disabled: PropTypes.bool,\n};\n","numLines":108,"startLine":1,"totalLines":108}}}
