in-top: 4px;\n   480→}\n   481→\n   482→.crv-notes-section {\n   483→  margin-bottom: 16px;\n   484→}\n   485→\n   486→.crv-notes-label {\n   487→  font-size: 12px;\n   488→  color: var(--text-muted);\n   489→  margin-bottom: 4px;\n   490→}\n   491→\n   492→.crv-notes-text {\n   493→  font-size: 13px;\n   494→  color: var(--text-secondary);\n   495→  line-height: 1.5;\n   496→}\n   497→\n   498→/* Checks tab */\n   499→.crv-checks-panel {\n   500→  background: var(--bg-secondary);\n   501→  border-radius: 8px;\n   502→  border: 1px solid var(--border-color);\n   503→  overflow: hidden;\n   504→}\n   505→\n   506→.crv-section-goals-header {\n   507→  padding: 12px;\n   508→  background: var(--bg-tertiary);\n   509→  font-weight: 500;\n   510→  font-size: 13px;\n   511→}\n   512→\n   513→.crv-section-goal-row {\n   514→  display: flex;\n   515→  align-items: center;\n   516→}\n   517→\n   518→.crv-section-goal-check {\n   519→  flex: 1;\n   520→}\n   521→\n   522→.crv-section-goal-label {\n   523→  margin-right: 12px;\n   524→  font-size: 11px;\n   525→  color: var(--text-muted);\n   526→}\n   527→\n   528→/* Issues tab */\n   529→.crv-no-issues {\n   530→  padding: 48px;\n   531→  text-align: center;\n   532→  background: var(--bg-secondary);\n   533→  border-radius: 8px;\n   534→  border: 1px solid var(--border-color);\n   535→}\n   536→\n   537→.crv-no-issues-icon {\n   538→  font-size: 24px;\n   539→  margin-bottom: 8px;\n   540→}\n   541→\n   542→.crv-no-issues-text {\n   543→  color: var(--text-muted);\n   544→}\n   545→\n   546→.crv-issues-group {\n   547→  margin-bottom: 16px;\n   548→}\n   549→\n   550→.crv-issues-heading {\n   551→  margin: 0 0 12px;\n   552→  font-size: 14px;\n   553→}\n   554→\n   555→.crv-issues-heading-critical {\n   556→  color: #ef4444;\n   557→}\n   558→\n   559→.crv-issues-heading-minor {\n   560→  color: #f59e0b;\n   561→}\n   562→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"6f2b293d-ae1d-4182-bb63-ee791649686d","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/CohesionReportViewer.css","content":"/* CohesionReportViewer.css - Extracted from inline styles */\n\n/* ==========================================================================\n   ScoreGauge\n   ========================================================================== */\n\n.crv-gauge {\n  position: relative;\n  width: 120px;\n  height: 120px;\n}\n\n.crv-gauge-progress {\n  transition: stroke-dashoffset 0.5s ease;\n}\n\n.crv-gauge-label {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  text-align: center;\n}\n\n.crv-gauge-score {\n  font-size: 28px;\n  font-weight: 700;\n}\n\n.crv-gauge-score-excellent {\n  color: #10b981;\n}\n\n.crv-gauge-score-good {\n  color: #3b82f6;\n}\n\n.crv-gauge-score-acceptable {\n  color: #f59e0b;\n}\n\n.crv-gauge-score-needs-revision {\n  color: #ef4444;\n}\n\n.crv-gauge-max {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* ==========================================================================\n   CheckItem\n   ========================================================================== */\n\n.crv-check {\n  padding: 12px;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.crv-check-fail {\n  background: rgb(239 68 68 / 5%);\n}\n\n.crv-check-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.crv-check-header-clickable {\n  cursor: pointer;\n}\n\n.crv-check-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.crv-check-icon {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n}\n\n.crv-check-icon-pass {\n  background: #10b98120;\n  color: #10b981;\n}\n\n.crv-check-icon-fail {\n  background: #ef444420;\n  color: #ef4444;\n}\n\n.crv-check-label {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.crv-check-label-section {\n  font-weight: 400;\n}\n\n.crv-check-toggle {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.crv-check-notes {\n  margin-top: 8px;\n  margin-left: 30px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n/* ==========================================================================\n   IssueCard\n   ========================================================================== */\n\n.crv-issue {\n  padding: 12px 16px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  margin-bottom: 8px;\n  background: var(--bg-primary);\n}\n\n.crv-issue-critical {\n  background: rgb(239 68 68 / 8%);\n  border-color: #ef444440;\n}\n\n.crv-issue-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.crv-issue-severity {\n  padding: 3px 8px;\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  border-radius: 4px;\n  color: white;\n}\n\n.crv-issue-severity-critical {\n  background: #ef4444;\n}\n\n.crv-issue-severity-minor {\n  background: #f59e0b;\n}\n\n.crv-issue-meta {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.crv-issue-description {\n  font-size: 13px;\n  color: var(--text-primary);\n  margin-bottom: 8px;\n}\n\n.crv-issue-suggestion {\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 8px 12px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  border-left: 3px solid var(--accent-primary);\n}\n\n/* ==========================================================================\n   Main component - CohesionReportViewer\n   ========================================================================== */\n\n.crv {\n  max-width: 900px;\n}\n\n.crv-empty {\n  padding: 48px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n/* Header */\n.crv-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n  padding: 24px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n}\n\n.crv-header-left {\n  display: flex;\n  align-items: center;\n  gap: 24px;\n}\n\n.crv-status-badge {\n  display: inline-block;\n  padding: 6px 14px;\n  border-radius: 6px;\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.crv-status-badge-excellent {\n  background: #10b98120;\n  color: #10b981;\n}\n\n.crv-status-badge-good {\n  background: #3b82f620;\n  color: #3b82f6;\n}\n\n.crv-status-badge-acceptable {\n  background: #f59e0b20;\n  color: #f59e0b;\n}\n\n.crv-status-badge-needs_revision {\n  background: #ef444420;\n  color: #ef4444;\n}\n\n.crv-issue-count {\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n.crv-edit-version {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n\n.crv-failed-checks {\n  font-size: 12px;\n  color: #ef4444;\n  margin-top: 4px;\n}\n\n.crv-actions {\n  display: flex;\n  gap: 12px;\n}\n\n/* Shared button styles */\n.crv-btn {\n  font-size: 13px;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.crv-btn-secondary {\n  padding: 10px 20px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  color: var(--text-secondary);\n}\n\n.crv-btn-primary {\n  padding: 10px 20px;\n  border: none;\n  color: white;\n  font-weight: 500;\n}\n\n.crv-btn-accept-ready {\n  background: var(--accent-primary);\n}\n\n.crv-btn-accept-warning {\n  background: #f59e0b;\n}\n\n.crv-btn-disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.crv-btn-small {\n  padding: 8px 14px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n}\n\n.crv-btn-generate {\n  padding: 8px 14px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  font-size: 12px;\n  height: 32px;\n  align-self: center;\n}\n\n/* Stale warning */\n.crv-stale-warning {\n  margin-bottom: 16px;\n  padding: 12px 16px;\n  background: rgb(245 158 11 / 8%);\n  border: 1px solid rgb(245 158 11 / 40%);\n  border-radius: 6px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n}\n\n.crv-stale-text {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n/* Refinements panel */\n.crv-refinements {\n  margin-bottom: 24px;\n  padding: 16px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n}\n\n.crv-refinements-title {\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 12px;\n}\n\n.crv-refinements-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.crv-refinement-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.crv-refinement-content {\n  flex: 1;\n}\n\n.crv-refinement-name {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.crv-refinement-desc {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.crv-refinement-status {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n\n.crv-refinement-status-tight {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n.crv-image-panel-wrap {\n  margin-top: 4px;\n}\n\n/* Tabs */\n.crv-tabs {\n  display: flex;\n  border-bottom: 1px solid var(--border-color);\n  margin-bottom: 16px;\n}\n\n.crv-tab {\n  padding: 12px 20px;\n  border: none;\n  background: transparent;\n  cursor: pointer;\n  font-size: 13px;\n  text-transform: capitalize;\n  border-bottom: 2px solid transparent;\n  color: var(--text-muted);\n  font-weight: 400;\n}\n\n.crv-tab-active {\n  border-bottom-color: var(--accent-primary);\n  color: var(--text-primary);\n  font-weight: 600;\n}\n\n.crv-tab-badge {\n  margin-left: 8px;\n  padding: 2px 6px;\n  border-radius: 10px;\n  font-size: 10px;\n  color: white;\n}\n\n.crv-tab-badge-critical {\n  background: #ef4444;\n}\n\n.crv-tab-badge-minor {\n  background: #f59e0b;\n}\n\n/* Summary tab */\n.crv-panel {\n  padding: 24px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n}\n\n.crv-panel-title {\n  margin: 0 0 16px;\n  font-size: 16px;\n}\n\n.crv-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n  margin-bottom: 24px;\n}\n\n.crv-summary-card {\n  padding: 16px;\n  background: var(--bg-primary);\n  border-radius: 6px;\n  text-align: center;\n}\n\n.crv-summary-card-icon {\n  font-size: 24px;\n  font-weight: 700;\n}\n\n.crv-summary-card-icon-pass {\n  color: #10b981;\n}\n\n.crv-summary-card-icon-fail {\n  color: #ef4444;\n}\n\n.crv-summary-card-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n\n.crv-notes-section {\n  margin-bottom: 16px;\n}\n\n.crv-notes-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.crv-notes-text {\n  font-size: 13px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n/* Checks tab */\n.crv-checks-panel {\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n  overflow: hidden;\n}\n\n.crv-section-goals-header {\n  padding: 12px;\n  background: var(--bg-tertiary);\n  font-weight: 500;\n  font-size: 13px;\n}\n\n.crv-section-goal-row {\n  display: flex;\n  align-items: center;\n}\n\n.crv-section-goal-check {\n  flex: 1;\n}\n\n.crv-section-goal-label {\n  margin-right: 12px;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Issues tab */\n.crv-no-issues {\n  padding: 48px;\n  text-align: center;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n}\n\n.crv-no-issues-icon {\n  font-size: 24px;\n  margin-bottom: 8px;\n}\n\n.crv-no-issues-text {\n  color: var(--text-muted);\n}\n\n.crv-issues-group {\n  margin-bottom: 16px;\n}\n\n.crv-issues-heading {\n  margin: 0 0 12px;\n  font-size: 14px;\n}\n\n.crv-issues-heading-critical {\n  color: #ef4444;\n}\n\n.crv-issues-heading-minor {\n  color: #f59e0b;\n}\n","numLines":562,"startLine":1,"totalLines":562}}}
