{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SbkWyakT1eEF6vfdpBzwLc","type":"tool_result","content":"     1→/**\n     2→ * useIlluminatorSetup - Secondary state and derived values for Illuminator\n     3→ *\n     4→ * Wraps: style library, image settings, world schema resolution,\n     5→ * derived state, subtypes, era entities, queue setup, config store sync,\n     6→ * and entity CRUD callbacks.\n     7→ */\n     8→\n     9→import { useState, useMemo, useEffect, useCallback } from \"react\";\n    10→import { useStyleLibrary } from \"./useStyleLibrary\";\n    11→import { useImageGenSettings } from \"./useImageGenSettings\";\n    12→import { useEnrichmentQueue } from \"./useEnrichmentQueue\";\n    13→import { useChronicleQueueWatcher } from \"./useChronicleQueueWatcher\";\n    14→import { useEntityStore } from \"../lib/db/entityStore\";\n    15→import { useIndexStore } from \"../lib/db/indexStore\";\n    16→import { useIlluminatorModals } from \"../lib/db/modalStore\";\n    17→import { useIlluminatorConfigStore } from \"../lib/db/illuminatorConfigStore\";\n    18→import { useEnrichmentQueueStore } from \"../lib/db/enrichmentQueueStore\";\n    19→import { registerQueue } from \"../lib/db/enrichmentQueueBridge\";\n    20→import { getResolvedLLMCallSettings } from \"../lib/llmModelSettings\";\n    21→import { computeRunIndexes } from \"../lib/db/indexComputation\";\n    22→import { upsertRunIndexes } from \"../lib/db/indexRepository\";\n    23→import * as entityRepo from \"../lib/db/entityRepository\";\n    24→import * as eventRepo from \"../lib/db/eventRepository\";\n    25→\n    26→// --- Module-level helpers ---\n    27→\n    28→function computeSubtypesByKind(worldSchema) {\n    29→  const map = {};\n    30→  for (const kindDef of worldSchema?.entityKinds || []) {\n    31→    if (kindDef.kind && kindDef.subtypes?.length > 0) {\n    32→      map[kindDef.kind] = kindDef.subtypes.map((st) => st.id);\n    33→    }\n    34→  }\n    35→  return map;\n    36→}\n    37→\n    38→function computeWorldSchema(worldData, schema) {\n    39→  if (worldData?.schema) return worldData.schema;\n    40→  return schema || { entityKinds: [], relationshipKinds: [], cultures: [], tagRegistry: [] };\n    41→}\n    42→\n    43→function computeSimulationMetadata(slotRecord, currentEra) {\n    44→  if (!slotRecord) return undefined;\n    45→  return {\n    46→    currentTick: typeof slotRecord.finalTick === \"number\" ? slotRecord.finalTick : undefined,\n    47→    currentEra: currentEra || undefined,\n    48→  };\n    49→}\n    50→\n    51→function arrayLen(arr) {\n    52→  return arr ? arr.length : 0;\n    53→}\n    54→\n    55→function computeHardStateSummary(worldData) {\n    56→  const entityCount = arrayLen(worldData?.hardState);\n    57→  const eventCount = arrayLen(worldData?.narrativeHistory);\n    58→  const relCount = arrayLen(worldData?.relationships);\n    59→  if (entityCount === 0) return \"No hard state available for import.\";\n    60→  return `Hard state: ${entityCount} entities, ${eventCount} events, ${relCount} relationships.`;\n    61→}\n    62→\n    63→async function handleRenameApply(\n    64→  args,\n    65→  simulationRunId,\n    66→  reloadEntitiesAndEvents,\n    67→  setChronicleRefreshTrigger\n    68→) {\n    69→  try {\n    70→    const updatedIds = await entityRepo.applyRename(\n    71→      args.targetEntityId,\n    72→      args.newName,\n    73→      args.entityPatches,\n    74→      simulationRunId,\n    75→      args.addOldNameAsAlias\n    76→    );\n    77→    if (args.eventPatches.length > 0) {\n    78→      await eventRepo.applyEventPatches(args.eventPatches, simulationRunId);\n    79→    }\n    80→    const allEntities = await entityRepo.getEntitiesForRun(simulationRunId);\n    81→    const indexRecord = computeRunIndexes(simulationRunId, allEntities);\n    82→    await upsertRunIndexes(indexRecord);\n    83→    await useIndexStore.getState().refreshAll();\n    84→    await reloadEntitiesAndEvents(updatedIds);\n    85→  } catch (err) {\n    86→    console.error(\"[Illuminator] Rename persist failed:\", err);\n    87→  }\n    88→  useIlluminatorModals.getState().closeRename();\n    89→  setChronicleRefreshTrigger((n) => n + 1);\n    90→}\n    91→\n    92→async function handleCreateApply(entityData, simulationRunId, reloadEntities) {\n    93→  if (!simulationRunId) return;\n    94→  try {\n    95→    const created = await entityRepo.createEntity(simulationRunId, entityData);\n    96→    const allEntities = await entityRepo.getEntitiesForRun(simulationRunId);\n    97→    const indexRecord = computeRunIndexes(simulationRunId, allEntities);\n    98→    await upsertRunIndexes(indexRecord);\n    99→    await useIndexStore.getState().refreshAll();\n   100→    await reloadEntities([created.id]);\n   101→  } catch (err) {\n   102→    console.error(\"[Illuminator] Create entity failed:\", err);\n   103→  }\n   104→  useIlluminatorModals.getState().closeCreateEntity();\n   105→}\n   106→\n   107→async function handleEditApply(entityData, editEntityModal, reloadEntities) {\n   108→  if (!editEntityModal) return;\n   109→  try {\n   110→    await entityRepo.updateEntityFields(editEntityModal.id, {\n   111→      ...entityData,\n   112→      updatedAt: Date.now(),\n   113→    });\n   114→    await reloadEntities([editEntityModal.id]);\n   115→  } catch (err) {\n   116→    console.error(\"[Illuminator] Edit entity failed:\", err);\n   117→  }\n   118→  useIlluminatorModals.getState().closeEditEntity();\n   119→}\n   120→\n   121→function buildWorkerConfig(apiKeys, config, imageGenSettings) {\n   122→  return {\n   123→    anthropicApiKey: apiKeys.anthropicApiKey,\n   124→    openaiApiKey: apiKeys.openaiApiKey,\n   125→    imageModel: config.imageModel,\n   126→    imageSize: imageGenSettings.imageSize,\n   127→    imageQuality: imageGenSettings.imageQuality,\n   128→    useClaudeForImagePrompt: config.useClaudeForImagePrompt,\n   129→    claudeImagePromptTemplate: config.claudeImagePromptTemplate,\n   130→    globalImageRules: config.globalImageRules,\n   131→    llmCallSettings: getResolvedLLMCallSettings(),\n   132→  };\n   133→}\n   134→\n   135→// --- Main hook ---\n   136→\n   137→export function useIlluminatorSetup({\n   138→  projectId,\n   139→  worldData,\n   140→  schema,\n   141→  onStyleSelectionChange,\n   142→  config,\n   143→  apiKeys,\n   144→  slotRecord,\n   145→  currentEra,\n   146→  simulationRunId,\n   147→  handleEntityUpdate,\n   148→  reloadEntities,\n   149→  reloadEntitiesAndEvents,\n   150→  worldContext,\n   151→  historianConfig,\n   152→  entityGuidance,\n   153→  cultureIdentities,\n   154→  navEntities,\n   155→  setChronicleRefreshTrigger,\n   156→}) {\n   157→  // Style library\n   158→  const styleLib = useStyleLibrary();\n   159→\n   160→  // Image gen settings\n   161→  const [imageGenSettings, updateImageGenSettings] = useImageGenSettings(\n   162→    onStyleSelectionChange\n   163→      ? (s) =>\n   164→          onStyleSelectionChange({\n   165→            artisticStyleId: s.artisticStyleId,\n   166→            compositionStyleId: s.compositionStyleId,\n   167→            colorPaletteId: s.colorPaletteId,\n   168→          })\n   169→      : undefined\n   170→  );\n   171→  const styleSelection = useMemo(\n   172→    () => ({\n   173→      artisticStyleId: imageGenSettings.artisticStyleId,\n   174→      compositionStyleId: imageGenSettings.compositionStyleId,\n   175→      colorPaletteId: imageGenSettings.colorPaletteId,\n   176→    }),\n   177→    [\n   178→      imageGenSettings.artisticStyleId,\n   179→      imageGenSettings.compositionStyleId,\n   180→      imageGenSettings.colorPaletteId,\n   181→    ]\n   182→  );\n   183→\n   184→  // World schema + simulation metadata\n   185→  const worldSchema = useMemo(() => computeWorldSchema(worldData, schema), [worldData, schema]);\n   186→  const simulationMetadata = useMemo(\n   187→    () => computeSimulationMetadata(slotRecord, currentEra),\n   188→    [slotRecord, currentEra]\n   189→  );\n   190→\n   191→  // Derived state\n   192→  const hasHardState = Boolean(worldData?.hardState?.length);\n   193→  const hardStateSummary = useMemo(() => computeHardStateSummary(worldData), [worldData]);\n   194→  const canImport = hasHardState;\n   195→  const hasWorldData = navEntities.length > 0;\n   196→  const isTemporarySlot = slotRecord?.isTemporary ?? false;\n   197→\n   198→  // Subtypes\n   199→  const subtypesByKind = useMemo(() => computeSubtypesByKind(worldSchema), [worldSchema]);\n   200→\n   201→  // Era entities (wrapped in async IIFE to satisfy set-state-in-effect rule)\n   202→  const [eraEntities, setEraEntities] = useState([]);\n   203→  useEffect(() => {\n   204→    (async () => {\n   205→      const eraNavs = navEntities.filter((e) => e.kind === \"era\");\n   206→      if (eraNavs.length === 0) {\n   207→        setEraEntities([]);\n   208→        return;\n   209→      }\n   210→      const full = await useEntityStore.getState().loadEntities(eraNavs.map((e) => e.id));\n   211→      setEraEntities(full.map((e) => ({ id: e.id, name: e.name, description: e.description })));\n   212→    })();\n   213→  }, [navEntities]);\n   214→\n   215→  // Queue\n   216→  const {\n   217→    queue,\n   218→    isWorkerReady,\n   219→    stats,\n   220→    initialize: initializeWorker,\n   221→    enqueue,\n   222→    cancel,\n   223→    cancelAll,\n   224→    retry,\n   225→    clearCompleted,\n   226→  } = useEnrichmentQueue(handleEntityUpdate, projectId, simulationRunId);\n   227→  registerQueue(enqueue, cancel);\n   228→  useEffect(() => {\n   229→    useEnrichmentQueueStore.getState().setQueue(queue, stats);\n   230→  }, [queue, stats]);\n   231→  useChronicleQueueWatcher(queue);\n   232→  useEffect(() => {\n   233→    if (apiKeys.anthropicApiKey || apiKeys.openaiApiKey)\n   234→      initializeWorker(buildWorkerConfig(apiKeys, config, imageGenSettings));\n   235→  }, [apiKeys, config, imageGenSettings, initializeWorker]);\n   236→\n   237→  // Config store sync\n   238→  useEffect(() => {\n   239→    useIlluminatorConfigStore.getState().setConfig({\n   240→      projectId: projectId || null,\n   241→      simulationRunId: simulationRunId || null,\n   242→      worldContext,\n   243→      historianConfig,\n   244→      entityGuidance,\n   245→      cultureIdentities,\n   246→    });\n   247→  }, [\n   248→    projectId,\n   249→    simulationRunId,\n   250→    worldContext,\n   251→    historianConfig,\n   252→    entityGuidance,\n   253→    cultureIdentities,\n   254→  ]);\n   255→\n   256→  // Entity CRUD\n   257→  const editEntityModal = useIlluminatorModals((s) => s.editEntityModal);\n   258→  const handleRenameApplied = useCallback(\n   259→    (args) =>\n   260→      handleRenameApply(args, simulationRunId, reloadEntitiesAndEvents, setChronicleRefreshTrigger),\n   261→    [simulationRunId, reloadEntitiesAndEvents, setChronicleRefreshTrigger]\n   262→  );\n   263→  const handleCreateEntity = useCallback(\n   264→    (entityData) => handleCreateApply(entityData, simulationRunId, reloadEntities),\n   265→    [simulationRunId, reloadEntities]\n   266→  );\n   267→  const handleEditEntity = useCallback(\n   268→    (entityData) => handleEditApply(entityData, editEntityModal, reloadEntities),\n   269→    [editEntityModal, reloadEntities]\n   270→  );\n   271→\n   272→  return {\n   273→    ...styleLib,\n   274→    imageGenSettings,\n   275→    updateImageGenSettings,\n   276→    styleSelection,\n   277→    worldSchema,\n   278→    simulationMetadata,\n   279→    hasHardState,\n   280→    hardStateSummary,\n   281→    canImport,\n   282→    hasWorldData,\n   283→    isTemporarySlot,\n   284→    subtypesByKind,\n   285→    eraEntities,\n   286→    queue,\n   287→    isWorkerReady,\n   288→    stats,\n   289→    enqueue,\n   290→    cancel,\n   291→    cancelAll,\n   292→    retry,\n   293→    clearCompleted,\n   294→    handleRenameApplied,\n   295→    handleCreateEntity,\n   296→    handleEditEntity,\n   297→  };\n   298→}\n   299→"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"7b7eb375-899b-4567-b198-100af0b3ac54"}
