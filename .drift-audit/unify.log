{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W8VeHeaxUN6vKjrVqWinar","type":"tool_result","content":"     1→import { useState, useCallback, useEffect, useRef } from \"react\";\n     2→\n     3→const DEFAULT_IMAGE_PROMPT_TEMPLATE = `Transform the structured prompt below into a single, coherent image prompt for {{modelName}}. Do NOT simply reformat—actively synthesize and reshape:\n     4→\n     5→Honor the VISUAL THESIS: This is the primary visual signal. The thesis describes the dominant silhouette feature that makes this entity instantly recognizable. Build the entire image around it.\n     6→\n     7→Synthesize, don't list:\n     8→- Merge SUBJECT + CONTEXT + CULTURAL IDENTITY into a unified visual\n     9→- Apply STYLE (artistic approach) and COMPOSITION (framing/perspective) to shape the rendering\n    10→- Translate SUPPORTING TRAITS into concrete visual details that reinforce the thesis\n    11→- Incorporate COLOR PALETTE if provided\n    12→\n    13→Establish clear composition and perspective:\n    14→- Honor the COMPOSITION directive for framing and vantage point\n    15→- Use environmental storytelling (objects, weathering, traces) to convey history\n    16→- The SETTING provides world context but the subject is the focus\n    17→\n    18→Create specific visual instructions: Rather than listing adjectives, use concrete visual language: \"weathered by decades of X,\" \"visible scars of Y,\" \"rendered in the style of Z\"\n    19→\n    20→Respect the AVOID list: These are hard constraints—elements that break the visual language.\n    21→\n    22→Condense to a single, authoritative prompt: Output should be 150-300 words, reading as clear artistic direction that could be handed to a concept artist—not a bulleted list.\n    23→{{globalImageRules}}\n    24→Original prompt:\n    25→{{prompt}}`;\n    26→\n    27→const DEFAULT_CONFIG = {\n    28→  imageModel: \"gpt-image-1.5\",\n    29→  minProminenceForImage: \"mythic\",\n    30→  numWorkers: 4,\n    31→  requireDescription: false,\n    32→  useClaudeForImagePrompt: false,\n    33→  claudeImagePromptTemplate: DEFAULT_IMAGE_PROMPT_TEMPLATE,\n    34→  globalImageRules: \"\",\n    35→  minEventSignificance: 0.25,\n    36→};\n    37→\n    38→const LEGACY_MODEL_FIELDS = [\n    39→  \"textModel\",\n    40→  \"chronicleModel\",\n    41→  \"textModal\",\n    42→  \"chronicleModal\",\n    43→  \"thinkingModel\",\n    44→  \"thinkingBudget\",\n    45→  \"useThinkingForDescriptions\",\n    46→];\n    47→\n    48→const normalizeEnrichmentConfig = (config) => {\n    49→  if (!config) return null;\n    50→  const cleaned = Object.fromEntries(\n    51→    Object.entries(config).filter(([key]) => !LEGACY_MODEL_FIELDS.includes(key))\n    52→  );\n    53→  return { ...DEFAULT_CONFIG, ...cleaned };\n    54→};\n    55→\n    56→function initializeEnrichmentConfig(externalConfig) {\n    57→  if (externalConfig) return normalizeEnrichmentConfig(externalConfig) || DEFAULT_CONFIG;\n    58→  try {\n    59→    const saved = localStorage.getItem(\"illuminator:config\");\n    60→    if (saved) return normalizeEnrichmentConfig(JSON.parse(saved)) || DEFAULT_CONFIG;\n    61→  } catch {\n    62→    /* ignored */\n    63→  }\n    64→  return DEFAULT_CONFIG;\n    65→}\n    66→\n    67→export default function useConfigSync({ externalEnrichmentConfig, onEnrichmentConfigChange }) {\n    68→  const [localConfig, setLocalConfig] = useState(() =>\n    69→    initializeEnrichmentConfig(externalEnrichmentConfig)\n    70→  );\n    71→  const pendingConfigSyncRef = useRef(null);\n    72→  const skipConfigSyncRef = useRef(false);\n    73→\n    74→  // Detect external config changes during render (no ref access)\n    75→  const [prevExternalConfig, setPrevExternalConfig] = useState(externalEnrichmentConfig);\n    76→  if (externalEnrichmentConfig !== prevExternalConfig) {\n    77→    setPrevExternalConfig(externalEnrichmentConfig);\n    78→    if (externalEnrichmentConfig) {\n    79→      setLocalConfig(normalizeEnrichmentConfig(externalEnrichmentConfig) || DEFAULT_CONFIG);\n    80→    }\n    81→  }\n    82→\n    83→  // Mark skip flag in effect (runs before sync effect due to declaration order)\n    84→  useEffect(() => {\n    85→    if (externalEnrichmentConfig) {\n    86→      skipConfigSyncRef.current = true;\n    87→      pendingConfigSyncRef.current = null;\n    88→    }\n    89→  }, [externalEnrichmentConfig]);\n    90→\n    91→  const config = localConfig;\n    92→\n    93→  const setConfig = useCallback((updater) => {\n    94→    setLocalConfig((prev) => {\n    95→      const next = typeof updater === \"function\" ? updater(prev) : updater;\n    96→      pendingConfigSyncRef.current = next;\n    97→      return next;\n    98→    });\n    99→  }, []);\n   100→\n   101→  // Sync local changes to parent (or localStorage)\n   102→  useEffect(() => {\n   103→    if (skipConfigSyncRef.current) {\n   104→      skipConfigSyncRef.current = false;\n   105→      pendingConfigSyncRef.current = null;\n   106→      return;\n   107→    }\n   108→    const pending = pendingConfigSyncRef.current;\n   109→    if (!pending) return;\n   110→    pendingConfigSyncRef.current = null;\n   111→    if (onEnrichmentConfigChange) {\n   112→      onEnrichmentConfigChange(pending);\n   113→    } else {\n   114→      try {\n   115→        localStorage.setItem(\"illuminator:config\", JSON.stringify(pending));\n   116→      } catch {\n   117→        /* ignored */\n   118→      }\n   119→    }\n   120→  }, [localConfig, onEnrichmentConfigChange]);\n   121→\n   122→  const updateConfig = useCallback(\n   123→    (updates) => {\n   124→      setConfig((prev) => ({ ...prev, ...updates }));\n   125→    },\n   126→    [setConfig]\n   127→  );\n   128→\n   129→  return { config, setConfig, updateConfig };\n   130→}\n   131→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"b57226df-4bfe-48c6-a3e2-fad5f75fcb5b"}
