 utilities to panel-utilities.css","status":"completed","activeForm":"Adding hint text utilities to panel-utilities.css"},{"content":"Refactor BulkChronicleAnnotationModal CSS+JSX to use shared utilities","status":"completed","activeForm":"Refactoring BulkChronicleAnnotationModal to use shared utilities"},{"content":"Refactor ConfigPanel CSS+JSX to use shared utilities","status":"completed","activeForm":"Refactoring ConfigPanel to use shared utilities"},{"content":"Refactor CostsPanel CSS+JSX to use shared utilities","status":"in_progress","activeForm":"Refactoring CostsPanel to use shared utilities"},{"content":"Refactor IlluminatorTabContent CSS+JSX to use shared utilities","status":"pending","activeForm":"Refactoring IlluminatorTabContent to use shared utilities"},{"content":"Refactor StyleSelector CSS+JSX to use shared utilities","status":"pending","activeForm":"Refactoring StyleSelector to use shared utilities"},{"content":"Append entry to UNIFICATION_LOG.md","status":"pending","activeForm":"Appending entry to UNIFICATION_LOG.md"},{"content":"Create ESLint guard rule","status":"pending","activeForm":"Creating ESLint guard rule"},{"content":"Wire ESLint rule into config","status":"pending","activeForm":"Wiring ESLint rule into config"},{"content":"Create ADR document","status":"pending","activeForm":"Creating ADR document"},{"content":"Create pattern documentation","status":"pending","activeForm":"Creating pattern documentation"}]}}
