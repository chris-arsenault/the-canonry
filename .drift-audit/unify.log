--radius-pill);\n   283→  background-color: rgb(156 163 175 / 20%);\n   284→  color: #d1d5db;\n   285→}\n   286→\n   287→/* Card footer */\n   288→.card-footer {\n   289→  margin-top: var(--spacing-xl);\n   290→  padding-top: var(--spacing-lg);\n   291→  border-top: 1px solid var(--color-border-light);\n   292→}\n   293→\n   294→/* Stat total (secondary count display) */\n   295→.stat-total {\n   296→  font-size: var(--font-size-sm);\n   297→  font-weight: var(--font-weight-normal);\n   298→  color: var(--color-text-dim);\n   299→}\n   300→"}]},"parent_tool_use_id":null,"session_id":"4f674cf0-9f5a-4696-8008-0664523e53e2","uuid":"0843dc82-c914-42bd-8f3c-85b3c03fb286","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/styles/components/card.css","content":"/**\n * Card component styles\n */\n\n/* Base card */\n.card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  padding: 16px;\n  transition: all var(--transition-normal);\n  position: relative;\n}\n\n.card-clickable {\n  cursor: pointer;\n}\n\n.card-clickable:hover {\n  border-color: var(--color-accent);\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-card-hover);\n}\n\n.card-disabled {\n  opacity: 0.5;\n}\n\n/* Card header */\n.card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: var(--spacing-lg);\n}\n\n.card-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-xs);\n}\n\n.card-id {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  font-family: monospace;\n  background-color: var(--color-bg-dark);\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n}\n\n.card-desc {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin-top: var(--spacing-md);\n  line-height: var(--line-height-snug);\n}\n\n/* Add card (dashed border style) */\n.add-card {\n  background-color: transparent;\n  border-radius: var(--radius-2xl);\n  border: 2px dashed var(--color-border);\n  padding: 40px 20px;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  color: var(--color-text-dim);\n  min-height: 140px;\n}\n\n.add-card:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.add-card-icon {\n  font-size: 24px;\n}\n\n/* Item card (collapsible) */\n.item-card {\n  background-color: var(--color-bg-nested);\n  border-radius: var(--radius-lg);\n  border: 1px solid var(--color-border-light);\n  margin-bottom: var(--spacing-md);\n\n  /* overflow: visible to allow dropdowns to extend outside card bounds */\n}\n\n.item-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: transparent;\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.item-card-header:hover,\n.item-card-header-hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.item-card-icon {\n  width: 28px;\n  height: 28px;\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-base);\n  background-color: rgb(59 130 246 / 20%);\n  flex-shrink: 0;\n  line-height: 1;\n}\n\n.item-card-icon-variable {\n  background-color: rgb(168 85 247 / 20%);\n}\n\n.item-card-icon-relationship {\n  background-color: rgb(20 184 166 / 20%);\n}\n\n.item-card-icon-creation {\n  background-color: rgb(245 158 11 / 20%);\n}\n\n.item-card-info {\n  flex: 1;\n  min-width: 0;\n  margin-left: var(--spacing-md);\n}\n\n.item-card-title {\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.item-card-subtitle {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  margin-top: 2px;\n}\n\n.item-card-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.item-card-body {\n  padding: var(--spacing-lg);\n\n  /* Allow dropdowns to extend outside card bounds */\n  overflow: visible;\n}\n\n/* Variable/entity references */\n.variable-ref,\n.entity-ref {\n  font-family: monospace;\n  font-size: var(--font-size-lg);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n/* Relationship visualization */\n.rel-visual {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 1;\n}\n\n.rel-ref {\n  font-family: monospace;\n  font-size: var(--font-size-md);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-arrow {\n  color: var(--color-text-dim);\n  font-size: var(--font-size-lg);\n}\n\n.rel-kind {\n  font-size: var(--font-size-md);\n  color: var(--color-teal);\n  background-color: rgb(20 184 166 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-bidirectional {\n  font-size: var(--font-size-lg);\n  color: var(--color-accent);\n  margin-left: var(--spacing-sm);\n}\n\n/* Add form (inline add) */\n.add-form {\n  background-color: var(--color-bg-card);\n  padding: var(--spacing-xl);\n}\n\n.add-form-fields {\n  display: flex;\n  align-items: flex-end;\n  gap: var(--spacing-lg);\n}\n\n/* Card stats row */\n.card-stats {\n  display: flex;\n  gap: var(--spacing-xl);\n  margin: var(--spacing-lg) 0;\n  flex-wrap: wrap;\n}\n\n.card-stat {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n/* Card badges container */\n.card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-md);\n}\n\n/* Card validation states */\n.card-error {\n  border-color: var(--color-danger);\n}\n\n.card-warning {\n  border-color: var(--color-warning);\n}\n\n/* Card inline badges */\n.card-error-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(239 68 68 / 20%);\n  color: #fca5a5;\n}\n\n.card-usage-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(59 130 246 / 20%);\n  color: #93c5fd;\n}\n\n.card-orphan-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(156 163 175 / 20%);\n  color: #d1d5db;\n}\n\n/* Card footer */\n.card-footer {\n  margin-top: var(--spacing-xl);\n  padding-top: var(--spacing-lg);\n  border-top: 1px solid var(--color-border-light);\n}\n\n/* Stat total (secondary count display) */\n.stat-total {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-normal);\n  color: var(--color-text-dim);\n}\n","numLines":300,"startLine":1,"totalLines":300}}}
