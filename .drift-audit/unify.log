{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RTiLhH7GXzbeDBtLiMtRcR","type":"tool_result","content":"The file /home/tsonu/src/the-canonry/apps/lore-weave/webui/src/App.css has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"d7d177e3-e480-46d9-92de-1155938b93f7","uuid":"5fd7712f-02d8-4695-a044-23400b06b563","tool_use_result":{"filePath":"/home/tsonu/src/the-canonry/apps/lore-weave/webui/src/App.css","oldString":".lw-gap-lg {\n  gap: var(--lw-space-lg);\n}\n\n/* ========================================\n   Modal Components\n   ======================================== */","newString":".lw-gap-lg {\n  gap: var(--lw-space-lg);\n}\n\n/* Dashboard section utilities (shared across dashboard panels) */\n\n.lw-section-spacer {\n  margin-top: 16px;\n}\n\n.lw-section-label {\n  font-size: 12px;\n  color: var(--lw-text-muted);\n  margin-bottom: 8px;\n}\n\n/* ========================================\n   Modal Components\n   ======================================== */","originalFile":"/* Arctic Blue Theme - Lore Weave (with Purple accent for simulation) */\n:root {\n  /* Backgrounds - Arctic deep blues */\n  --lw-bg-primary: #0a1929;\n  --lw-bg-secondary: #1e3a5f;\n  --lw-bg-tertiary: #2d4a6f;\n  --lw-bg-sidebar: #0c1f2e;\n\n  /* Borders - Blue tinted */\n  --lw-border-color: rgb(59 130 246 / 30%);\n  --lw-border-light: rgb(59 130 246 / 15%);\n\n  /* Text - Ice white tones */\n  --lw-text-primary: #fff;\n  --lw-text-secondary: #93c5fd;\n  --lw-text-muted: #60a5fa;\n\n  /* Lore Weave accent (purple for simulation) */\n  --lw-accent: #a78bfa;\n  --lw-accent-light: #c4b5fd;\n  --lw-accent-dark: #6d28d9;\n  --lw-accent-gradient: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 100%);\n\n  /* Semantic colors */\n  --lw-success: #22c55e;\n  --lw-warning: #f59e0b;\n  --lw-danger: #ef4444;\n  --lw-info: #3b82f6;\n\n  /* Spacing scale */\n  --lw-space-xs: 4px;\n  --lw-space-sm: 8px;\n  --lw-space-md: 12px;\n  --lw-space-lg: 16px;\n  --lw-space-xl: 24px;\n\n  /* Font sizes */\n  --lw-text-xs: 11px;\n  --lw-text-sm: 12px;\n  --lw-text-base: 13px;\n  --lw-text-lg: 14px;\n  --lw-text-xl: 16px;\n  --lw-text-2xl: 18px;\n  --lw-text-3xl: 20px;\n  --lw-text-4xl: 24px;\n\n  /* Border radius */\n  --lw-radius-sm: 4px;\n  --lw-radius-md: 6px;\n  --lw-radius-lg: 8px;\n  --lw-radius-xl: 12px;\n  --lw-radius-full: 20px;\n}\n\n/* ========================================\n   Layout Components\n   ======================================== */\n\n.lw-container {\n  max-width: 1200px;\n}\n\n.lw-header {\n  margin-bottom: var(--lw-space-xl);\n}\n\n.lw-title {\n  font-size: var(--lw-text-4xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n  margin-bottom: var(--lw-space-sm);\n}\n\n.lw-subtitle {\n  font-size: var(--lw-text-lg);\n  color: var(--lw-text-secondary);\n}\n\n/* ========================================\n   Card Components\n   ======================================== */\n\n.lw-card {\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-xl);\n  border: 1px solid var(--lw-border-color);\n  margin-bottom: var(--lw-space-xl);\n}\n\n.lw-card-compact {\n  padding: var(--lw-space-lg);\n}\n\n.lw-card-title {\n  font-size: var(--lw-text-xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n  margin-bottom: var(--lw-space-lg);\n}\n\n.lw-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--lw-space-lg);\n}\n\n/* ========================================\n   Panel Components (Dashboard)\n   ======================================== */\n\n.lw-panel {\n  background-color: var(--lw-bg-tertiary);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-lg);\n  display: flex;\n  flex-direction: column;\n}\n\n.lw-panel-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--lw-space-md);\n  padding-bottom: var(--lw-space-md);\n  border-bottom: 1px solid var(--lw-border-color);\n}\n\n.lw-panel-title {\n  font-size: var(--lw-text-lg);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n}\n\n.lw-panel-content {\n  flex: 1;\n  overflow: auto;\n}\n\n/* ========================================\n   Dashboard Layout\n   ======================================== */\n\n.lw-dashboard {\n  display: flex;\n  flex-direction: column;\n  gap: var(--lw-space-lg);\n  padding: var(--lw-space-lg);\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-xl);\n  border: 1px solid var(--lw-border-color);\n}\n\n.lw-overview-bar {\n  display: grid;\n  grid-template-columns: 1fr 2fr 1fr;\n  gap: var(--lw-space-lg);\n  align-items: center;\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  background-color: var(--lw-bg-tertiary);\n  border-radius: var(--lw-radius-lg);\n}\n\n.lw-main-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--lw-space-lg);\n  min-height: 400px;\n}\n\n/* ========================================\n   Status Badge\n   ======================================== */\n\n.lw-status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  padding: var(--lw-space-sm) var(--lw-space-lg);\n  border-radius: var(--lw-radius-full);\n  font-size: var(--lw-text-lg);\n  font-weight: 600;\n}\n\n/* ========================================\n   Progress Bar\n   ======================================== */\n\n.lw-progress-section {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.lw-progress-bar {\n  height: 8px;\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-sm);\n  overflow: hidden;\n}\n\n.lw-progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, var(--lw-accent) 0%, var(--lw-accent-light) 100%);\n  border-radius: var(--lw-radius-sm);\n  transition: width 0.3s ease;\n}\n\n.lw-progress-text {\n  display: flex;\n  justify-content: space-between;\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-muted);\n}\n\n/* ========================================\n   Stats Display\n   ======================================== */\n\n.lw-stats-row {\n  display: flex;\n  gap: var(--lw-space-xl);\n  justify-content: flex-end;\n}\n\n.lw-stat-item {\n  text-align: right;\n}\n\n.lw-stat-value {\n  font-size: var(--lw-text-2xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-stat-label {\n  font-size: var(--lw-text-xs);\n  color: var(--lw-text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* ========================================\n   Timeline Components\n   ======================================== */\n\n.lw-timeline {\n  display: flex;\n  flex-direction: column;\n  gap: var(--lw-space-sm);\n}\n\n.lw-timeline-item {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: 10px var(--lw-space-md);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-md);\n  border-left: 3px solid var(--lw-border-color);\n}\n\n.lw-timeline-item.active {\n  border-left-color: var(--lw-accent);\n}\n\n.lw-timeline-icon {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--lw-text-lg);\n  background-color: var(--lw-bg-tertiary);\n  color: var(--lw-text-muted);\n}\n\n.lw-timeline-icon.active {\n  background-color: rgb(167 139 250 / 30%);\n  color: var(--lw-accent);\n}\n\n.lw-timeline-content {\n  flex: 1;\n}\n\n.lw-timeline-title {\n  font-size: var(--lw-text-base);\n  font-weight: 500;\n  color: var(--lw-text-primary);\n}\n\n.lw-timeline-subtitle {\n  font-size: var(--lw-text-xs);\n  color: var(--lw-text-muted);\n}\n\n/* ========================================\n   Metric Components\n   ======================================== */\n\n.lw-metric-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--lw-space-md);\n}\n\n.lw-metric-card {\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-md);\n}\n\n.lw-metric-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--lw-space-sm);\n}\n\n.lw-metric-name {\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-muted);\n}\n\n.lw-metric-value {\n  font-size: var(--lw-text-3xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-metric-bar {\n  height: 4px;\n  background-color: var(--lw-bg-tertiary);\n  border-radius: 2px;\n  overflow: hidden;\n  margin-top: var(--lw-space-sm);\n}\n\n/* ========================================\n   Pressure Gauge\n   ======================================== */\n\n.lw-pressure-gauge {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-md);\n}\n\n.lw-pressure-name {\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-secondary);\n  width: 120px;\n}\n\n.lw-pressure-bar {\n  flex: 1;\n  height: 8px;\n  background-color: var(--lw-bg-tertiary);\n  border-radius: var(--lw-radius-sm);\n  overflow: hidden;\n  position: relative;\n}\n\n.lw-pressure-fill {\n  height: 100%;\n  border-radius: var(--lw-radius-sm);\n  transition: width 0.3s ease;\n}\n\n.lw-pressure-value {\n  font-size: var(--lw-text-sm);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n  width: 50px;\n  text-align: right;\n}\n\n/* ========================================\n   Template List\n   ======================================== */\n\n.lw-template-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.lw-template-item {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-md);\n}\n\n.lw-template-name {\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-secondary);\n  width: 180px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.lw-template-bar {\n  flex: 1;\n  height: 6px;\n  background-color: var(--lw-bg-tertiary);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.lw-template-fill {\n  height: 100%;\n  border-radius: 3px;\n  transition: width 0.3s ease;\n}\n\n.lw-template-count {\n  font-size: var(--lw-text-sm);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n  width: 40px;\n  text-align: right;\n}\n\n/* ========================================\n   Unused Templates Section\n   ======================================== */\n\n.lw-unused-section {\n  margin-top: var(--lw-space-lg);\n  border-top: 1px solid var(--lw-border-color);\n  padding-top: var(--lw-space-md);\n}\n\n.lw-unused-header {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  cursor: pointer;\n  padding: var(--lw-space-sm) 0;\n  color: var(--lw-warning);\n  font-size: var(--lw-text-sm);\n  font-weight: 500;\n}\n\n.lw-unused-header:hover {\n  color: var(--lw-text-primary);\n}\n\n.lw-unused-toggle {\n  font-size: 10px;\n  width: 12px;\n}\n\n.lw-unused-title {\n  flex: 1;\n}\n\n.lw-unused-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  margin-top: var(--lw-space-sm);\n}\n\n.lw-unused-template {\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-md);\n  border: 1px solid var(--lw-border-color);\n  overflow: hidden;\n}\n\n.lw-unused-template-header {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  cursor: pointer;\n  font-size: var(--lw-text-sm);\n}\n\n.lw-unused-template-header:hover {\n  background-color: var(--lw-bg-tertiary);\n}\n\n.lw-unused-icon {\n  font-size: 12px;\n}\n\n.lw-unused-name {\n  color: var(--lw-text-primary);\n  font-weight: 500;\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.lw-unused-summary {\n  color: var(--lw-text-muted);\n  font-size: 11px;\n}\n\n.lw-unused-expand {\n  color: var(--lw-text-muted);\n  font-size: 10px;\n  width: 12px;\n  text-align: center;\n}\n\n.lw-unused-details {\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  padding-top: 0;\n  background-color: var(--lw-bg-primary);\n  border-top: 1px solid var(--lw-border-color);\n}\n\n.lw-failed-rules {\n  margin: 0;\n  padding: var(--lw-space-sm) 0;\n  padding-left: var(--lw-space-lg);\n  list-style: none;\n}\n\n.lw-failed-rules li {\n  font-size: 11px;\n  color: var(--lw-text-secondary);\n  padding: 2px 0;\n  font-family: var(--lw-font-mono);\n}\n\n.lw-failed-rules li::before {\n  content: \"•\";\n  color: var(--lw-danger);\n  margin-right: var(--lw-space-sm);\n}\n\n.lw-no-targets {\n  font-size: 11px;\n  color: var(--lw-text-muted);\n  padding: var(--lw-space-sm) 0;\n}\n\n/* Selection Breakdown (inside unused templates) */\n.lw-selection-breakdown {\n  padding: var(--lw-space-sm) 0;\n}\n\n.lw-selection-header {\n  font-size: 11px;\n  color: var(--lw-text-muted);\n  font-family: var(--lw-font-mono);\n  margin-bottom: var(--lw-space-xs);\n}\n\n.lw-filter-steps {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.lw-filter-steps li {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 11px;\n  padding: 3px var(--lw-space-sm);\n  border-left: 2px solid var(--lw-border-color);\n  margin-left: var(--lw-space-sm);\n}\n\n.lw-filter-steps li.lw-blocked-step {\n  border-left-color: var(--lw-danger);\n  background-color: rgb(239 68 68 / 10%);\n}\n\n.lw-step-desc {\n  color: var(--lw-text-secondary);\n  font-family: var(--lw-font-mono);\n}\n\n.lw-step-count {\n  color: var(--lw-text-muted);\n  font-family: var(--lw-font-mono);\n  white-space: nowrap;\n}\n\n.lw-eliminated {\n  color: var(--lw-warning);\n  font-size: 10px;\n}\n\n.lw-blocked-marker {\n  color: var(--lw-danger);\n  font-size: 10px;\n  font-weight: 600;\n}\n\n/* Variable Breakdown (inside unused templates) */\n.lw-variable-breakdown {\n  padding: var(--lw-space-sm) 0;\n}\n\n.lw-variable-diagnosis {\n  margin-bottom: var(--lw-space-sm);\n}\n\n.lw-variable-diagnosis:last-child {\n  margin-bottom: 0;\n}\n\n.lw-variable-header {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-xs);\n  font-size: 11px;\n  margin-bottom: var(--lw-space-xs);\n}\n\n.lw-variable-icon {\n  font-size: 12px;\n}\n\n.lw-variable-name {\n  color: var(--lw-accent);\n  font-family: var(--lw-font-mono);\n  font-weight: 600;\n}\n\n.lw-variable-source {\n  color: var(--lw-text-muted);\n  font-family: var(--lw-font-mono);\n  font-size: 10px;\n}\n\n.lw-targets-found {\n  font-size: 11px;\n  color: var(--lw-text-muted);\n  margin-bottom: var(--lw-space-sm);\n  padding-left: var(--lw-space-sm);\n}\n\n/* ========================================\n   Log Panel\n   ======================================== */\n\n.lw-log-panel {\n  background-color: var(--lw-bg-tertiary);\n  border-radius: var(--lw-radius-lg);\n  overflow: hidden;\n}\n\n.lw-log-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--lw-space-md) var(--lw-space-lg);\n  background-color: var(--lw-bg-secondary);\n  cursor: pointer;\n}\n\n.lw-log-content {\n  max-height: 200px;\n  overflow: auto;\n  padding: var(--lw-space-md) var(--lw-space-lg);\n  font-family: monospace;\n  font-size: var(--lw-text-sm);\n}\n\n.lw-log-entry {\n  padding: 2px 0;\n  color: var(--lw-text-secondary);\n}\n\n.lw-log-entry.error {\n  color: var(--lw-danger);\n}\n\n.lw-log-entry.warn {\n  color: var(--lw-warning);\n}\n\n.lw-log-entry.debug {\n  color: var(--lw-text-muted);\n}\n\n/* ========================================\n   Filter Tabs\n   ======================================== */\n\n.lw-filter-tabs {\n  display: flex;\n  gap: var(--lw-space-xs);\n  margin-bottom: var(--lw-space-md);\n}\n\n.lw-filter-tab {\n  padding: 6px var(--lw-space-md);\n  font-size: var(--lw-text-sm);\n  background-color: transparent;\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-sm);\n  color: var(--lw-text-muted);\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.lw-filter-tab:hover {\n  background-color: var(--lw-bg-tertiary);\n}\n\n.lw-filter-tab.active {\n  background-color: var(--lw-accent);\n  border-color: var(--lw-accent);\n  color: white;\n}\n\n/* ========================================\n   Health Indicator\n   ======================================== */\n\n.lw-health-indicator {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  padding: var(--lw-space-md) var(--lw-space-lg);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-lg);\n}\n\n.lw-health-dot {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n}\n\n.lw-health-dot.stable {\n  background-color: var(--lw-success);\n}\n\n.lw-health-dot.functional {\n  background-color: var(--lw-warning);\n}\n\n.lw-health-dot.degraded {\n  background-color: var(--lw-danger);\n}\n\n.lw-health-text {\n  font-size: var(--lw-text-lg);\n  color: var(--lw-text-primary);\n}\n\n/* ========================================\n   Empty State\n   ======================================== */\n\n.lw-empty-state {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: var(--lw-text-muted);\n  font-size: var(--lw-text-lg);\n  gap: var(--lw-space-sm);\n}\n\n.lw-empty-icon {\n  font-size: 32px;\n  opacity: 0.5;\n}\n\n.lw-empty-title {\n  font-size: var(--lw-text-xl);\n  font-weight: 600;\n  margin-bottom: var(--lw-space-sm);\n  color: var(--lw-text-secondary);\n}\n\n.lw-empty-text {\n  font-size: var(--lw-text-lg);\n  margin-bottom: var(--lw-space-lg);\n}\n\n/* ========================================\n   Form Components\n   ======================================== */\n\n.lw-form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n  gap: var(--lw-space-lg);\n}\n\n.lw-form-group {\n  margin-bottom: 0;\n}\n\n.lw-label {\n  display: block;\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-secondary);\n  margin-bottom: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.lw-input {\n  width: 100%;\n  padding: 10px var(--lw-space-md);\n  font-size: var(--lw-text-lg);\n  background-color: var(--lw-bg-primary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-md);\n  color: var(--lw-text-primary);\n  box-sizing: border-box;\n  outline: none;\n}\n\n.lw-input:focus {\n  border-color: var(--lw-accent);\n}\n\n.lw-input-small {\n  width: 80px;\n  padding: 6px 10px;\n  font-size: var(--lw-text-base);\n  background-color: var(--lw-bg-primary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-sm);\n  color: var(--lw-text-primary);\n  outline: none;\n}\n\n/* ========================================\n   Button Components\n   ======================================== */\n\n.lw-button-row {\n  display: flex;\n  gap: var(--lw-space-md);\n  margin-top: var(--lw-space-xl);\n}\n\n.lw-button-group {\n  display: flex;\n  gap: var(--lw-space-sm);\n}\n\n.lw-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  padding: var(--lw-space-md) var(--lw-space-xl);\n  font-size: 15px;\n  font-weight: 500;\n  border: none;\n  border-radius: var(--lw-radius-lg);\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.lw-btn-primary {\n  background: var(--lw-accent-gradient);\n  color: white;\n  font-weight: 600;\n}\n\n.lw-btn-primary:hover {\n  filter: brightness(1.1);\n}\n\n.lw-btn-primary:disabled {\n  background: var(--lw-bg-secondary);\n  color: var(--lw-text-muted);\n  cursor: not-allowed;\n}\n\n.lw-btn-secondary {\n  background-color: transparent;\n  color: var(--lw-text-secondary);\n  border: 1px solid var(--lw-border-color);\n}\n\n.lw-btn-secondary:hover {\n  background-color: var(--lw-bg-tertiary);\n}\n\n.lw-btn-danger {\n  background-color: var(--lw-danger);\n  color: white;\n}\n\n.lw-btn-danger:hover {\n  background-color: #dc2626;\n}\n\n.lw-btn-success {\n  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);\n  color: white;\n  font-weight: 600;\n}\n\n.lw-btn-step {\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\n  color: white;\n}\n\n.lw-btn-reset {\n  background-color: transparent;\n  color: var(--lw-warning);\n  border: 1px solid var(--lw-warning);\n}\n\n.lw-btn-archivist {\n  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\n  color: white;\n}\n\n.lw-btn-debug {\n  padding: var(--lw-space-sm) var(--lw-space-lg);\n  font-size: var(--lw-text-base);\n  background-color: transparent;\n  color: var(--lw-text-secondary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-md);\n}\n\n.lw-btn-debug.active {\n  background-color: rgb(109 40 217 / 20%);\n  border-color: var(--lw-accent-dark);\n  color: var(--lw-accent-light);\n}\n\n.lw-btn-copy {\n  padding: var(--lw-space-xs) var(--lw-space-md);\n  font-size: var(--lw-text-sm);\n  background-color: var(--lw-bg-secondary);\n  color: var(--lw-text-secondary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-sm);\n  cursor: pointer;\n  margin-left: var(--lw-space-sm);\n}\n\n/* ========================================\n   Alert Boxes\n   ======================================== */\n\n.lw-warning-box {\n  background-color: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-lg);\n  margin-bottom: var(--lw-space-xl);\n  color: var(--lw-warning);\n  font-size: var(--lw-text-lg);\n}\n\n.lw-error-box {\n  background-color: rgb(239 68 68 / 10%);\n  border: 1px solid rgb(239 68 68 / 30%);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-lg);\n  margin-bottom: var(--lw-space-xl);\n  color: var(--lw-danger);\n  font-size: var(--lw-text-lg);\n}\n\n.lw-info-box {\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  background-color: rgb(167 139 250 / 15%);\n  border-radius: var(--lw-radius-md);\n  font-size: var(--lw-text-sm);\n  color: var(--lw-accent);\n}\n\n/* ========================================\n   Config Output\n   ======================================== */\n\n.lw-config-toggle {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  margin-top: var(--lw-space-lg);\n  padding: var(--lw-space-sm) 0;\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n  cursor: pointer;\n  border-top: 1px solid var(--lw-border-color);\n}\n\n.lw-config-output {\n  margin-top: var(--lw-space-lg);\n  background-color: #0c1f2e;\n  border-radius: var(--lw-radius-md);\n  padding: var(--lw-space-lg);\n  font-family: monospace;\n  font-size: var(--lw-text-xs);\n  color: var(--lw-text-secondary);\n  overflow: auto;\n  max-height: 300px;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n/* ========================================\n   Step Indicator\n   ======================================== */\n\n.lw-step-indicator {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-sm) var(--lw-space-lg);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-md);\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n}\n\n/* Validity badge */\n.lw-validity-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--lw-space-xs);\n  padding: var(--lw-space-xs) var(--lw-space-md);\n  border-radius: var(--lw-radius-md);\n  font-size: var(--lw-text-sm);\n  font-weight: 600;\n  cursor: default;\n}\n\n.lw-validity-valid {\n  background-color: rgb(34 197 94 / 15%);\n  color: #22c55e;\n  border: 1px solid rgb(34 197 94 / 30%);\n}\n\n.lw-validity-invalid {\n  background-color: rgb(239 68 68 / 15%);\n  color: #ef4444;\n  border: 1px solid rgb(239 68 68 / 30%);\n}\n\n/* ========================================\n   Tabs\n   ======================================== */\n\n.lw-tabs {\n  display: flex;\n  gap: var(--lw-space-xs);\n  margin-bottom: var(--lw-space-xl);\n  border-bottom: 1px solid var(--lw-border-color);\n  padding-bottom: var(--lw-space-md);\n}\n\n.lw-tab {\n  padding: var(--lw-space-sm) var(--lw-space-lg);\n  font-size: var(--lw-text-base);\n  font-weight: 500;\n  background-color: transparent;\n  color: var(--lw-text-secondary);\n  border: none;\n  border-radius: var(--lw-radius-md);\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.lw-tab:hover {\n  background-color: var(--lw-bg-tertiary);\n}\n\n.lw-tab.active {\n  background: var(--lw-accent-gradient);\n  color: white;\n}\n\n/* ========================================\n   Row Components\n   ======================================== */\n\n.lw-row {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-sm) 0;\n  border-bottom: 1px solid var(--lw-border-light);\n}\n\n.lw-row-label {\n  flex: 1;\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n}\n\n.lw-row-value {\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-primary);\n  font-family: monospace;\n}\n\n/* ========================================\n   Percentage Display\n   ======================================== */\n\n.lw-percentage {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--lw-space-xs);\n}\n\n.lw-percentage-bar {\n  width: 60px;\n  height: 6px;\n  background-color: var(--lw-bg-primary);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.lw-percentage-fill {\n  height: 100%;\n  background-color: var(--lw-accent);\n  border-radius: 3px;\n}\n\n/* ========================================\n   Comments\n   ======================================== */\n\n.lw-comment {\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-muted);\n  font-style: italic;\n  margin-top: var(--lw-space-xs);\n}\n\n/* ========================================\n   Section Components\n   ======================================== */\n\n.lw-section {\n  margin-bottom: 32px;\n}\n\n.lw-section-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: var(--lw-space-lg);\n}\n\n.lw-section-title {\n  font-size: var(--lw-text-2xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-section-description {\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-muted);\n  margin-bottom: var(--lw-space-lg);\n}\n\n/* ========================================\n   Badge Components\n   ======================================== */\n\n.lw-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--lw-space-xs);\n  padding: 2px var(--lw-space-sm);\n  font-size: var(--lw-text-xs);\n  border-radius: 10px;\n}\n\n.lw-badge-error {\n  background-color: rgb(239 68 68 / 20%);\n  color: var(--lw-danger);\n}\n\n.lw-badge-warn {\n  background-color: rgb(245 158 11 / 20%);\n  color: var(--lw-warning);\n}\n\n.lw-badge-success {\n  background-color: rgb(34 197 94 / 20%);\n  color: var(--lw-success);\n}\n\n.lw-badge-info {\n  background-color: rgb(59 130 246 / 20%);\n  color: var(--lw-info);\n}\n\n/* ========================================\n   Grid Utilities\n   ======================================== */\n\n.lw-grid-2 {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: var(--lw-space-md);\n}\n\n.lw-flex-col {\n  display: flex;\n  flex-direction: column;\n}\n\n.lw-gap-sm {\n  gap: var(--lw-space-sm);\n}\n\n.lw-gap-md {\n  gap: var(--lw-space-md);\n}\n\n.lw-gap-lg {\n  gap: var(--lw-space-lg);\n}\n\n/* ========================================\n   Modal Components\n   ======================================== */\n\n.lw-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background-color: rgb(0 0 0 / 60%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.lw-modal {\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-xl);\n  border: 1px solid var(--lw-border-color);\n  max-width: 500px;\n  width: 90%;\n  max-height: 80vh;\n  overflow: auto;\n}\n\n.lw-modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  border-bottom: 1px solid var(--lw-border-color);\n}\n\n.lw-modal-title {\n  font-size: var(--lw-text-xl);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-modal-close {\n  background: none;\n  border: none;\n  color: var(--lw-text-muted);\n  font-size: var(--lw-text-3xl);\n  cursor: pointer;\n  padding: var(--lw-space-xs);\n  line-height: 1;\n}\n\n.lw-modal-close:hover {\n  color: var(--lw-text-primary);\n}\n\n.lw-modal-body {\n  padding: var(--lw-space-xl);\n}\n\n.lw-modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  border-top: 1px solid var(--lw-border-color);\n}\n\n/* ========================================\n   Checkbox\n   ======================================== */\n\n.lw-checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-sm);\n  padding: var(--lw-space-sm) 0;\n}\n\n.lw-checkbox {\n  width: 16px;\n  height: 16px;\n  accent-color: var(--lw-accent);\n}\n\n.lw-checkbox-label {\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n}\n\n/* ========================================\n   Scrollbar styling\n   ======================================== */\n\n.lw-panel-content::-webkit-scrollbar,\n.lw-log-content::-webkit-scrollbar,\n.lw-config-output::-webkit-scrollbar {\n  width: 8px;\n}\n\n.lw-panel-content::-webkit-scrollbar-track,\n.lw-log-content::-webkit-scrollbar-track,\n.lw-config-output::-webkit-scrollbar-track {\n  background: var(--lw-bg-primary);\n  border-radius: 4px;\n}\n\n.lw-panel-content::-webkit-scrollbar-thumb,\n.lw-log-content::-webkit-scrollbar-thumb,\n.lw-config-output::-webkit-scrollbar-thumb {\n  background: var(--lw-bg-tertiary);\n  border-radius: 4px;\n}\n\n.lw-panel-content::-webkit-scrollbar-thumb:hover,\n.lw-log-content::-webkit-scrollbar-thumb:hover,\n.lw-config-output::-webkit-scrollbar-thumb:hover {\n  background: var(--lw-accent);\n}\n\n/* ========================================\n   Toggle Switch\n   ======================================== */\n\n.lw-toggle {\n  position: relative;\n  width: 44px;\n  height: 24px;\n  background-color: var(--lw-bg-primary);\n  border-radius: 12px;\n  cursor: pointer;\n  transition: background-color 0.2s;\n  border: 1px solid var(--lw-border-color);\n}\n\n.lw-toggle.active {\n  background-color: var(--lw-accent-dark);\n  border-color: var(--lw-accent);\n}\n\n.lw-toggle-knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 18px;\n  height: 18px;\n  background-color: var(--lw-text-primary);\n  border-radius: 50%;\n  transition: transform 0.2s;\n}\n\n.lw-toggle.active .lw-toggle-knob {\n  transform: translateX(20px);\n}\n\n/* ========================================\n   Stat Cards\n   ======================================== */\n\n.lw-stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n  gap: var(--lw-space-lg);\n  margin-bottom: var(--lw-space-xl);\n}\n\n.lw-stat-card {\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  border: 1px solid var(--lw-border-color);\n}\n\n.lw-stat-card-label {\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-muted);\n  margin-bottom: var(--lw-space-xs);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.lw-stat-card-value {\n  font-size: 28px;\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-stat-card-value.zero {\n  color: var(--lw-danger);\n}\n\n/* ========================================\n   Validation Boxes\n   ======================================== */\n\n.lw-validation-box {\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  border-radius: var(--lw-radius-lg);\n  margin-bottom: var(--lw-space-xl);\n}\n\n.lw-validation-box.valid {\n  background-color: rgb(34 197 94 / 10%);\n  border: 1px solid rgb(34 197 94 / 30%);\n}\n\n.lw-validation-box.invalid {\n  background-color: rgb(239 68 68 / 10%);\n  border: 1px solid rgb(239 68 68 / 30%);\n}\n\n.lw-validation-title {\n  font-size: var(--lw-text-xl);\n  font-weight: 600;\n  margin-bottom: var(--lw-space-sm);\n}\n\n.lw-validation-title.valid {\n  color: var(--lw-success);\n}\n\n.lw-validation-title.invalid {\n  color: var(--lw-danger);\n}\n\n.lw-validation-list {\n  margin: 0;\n  padding-left: 20px;\n  font-size: var(--lw-text-lg);\n}\n\n.lw-validation-item.error {\n  color: var(--lw-danger);\n  margin-bottom: var(--lw-space-xs);\n}\n\n.lw-validation-item.warning {\n  color: var(--lw-warning);\n  margin-bottom: var(--lw-space-xs);\n}\n\n/* ========================================\n   Item List / Badges\n   ======================================== */\n\n.lw-item-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--lw-space-sm);\n}\n\n.lw-item-badge {\n  padding: 6px var(--lw-space-md);\n  background-color: var(--lw-bg-primary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-md);\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n}\n\n/* ========================================\n   Detail Cards\n   ======================================== */\n\n.lw-detail-card {\n  background-color: var(--lw-bg-secondary);\n  border-radius: var(--lw-radius-lg);\n  padding: var(--lw-space-lg) var(--lw-space-xl);\n  border: 1px solid var(--lw-border-color);\n  margin-bottom: var(--lw-space-md);\n}\n\n.lw-detail-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--lw-space-sm);\n}\n\n.lw-detail-name {\n  font-size: var(--lw-text-lg);\n  font-weight: 600;\n  color: var(--lw-text-primary);\n}\n\n.lw-detail-id {\n  font-size: var(--lw-text-xs);\n  color: var(--lw-text-muted);\n  background-color: #0c1f2e;\n  padding: 2px 6px;\n  border-radius: var(--lw-radius-sm);\n  font-family: monospace;\n}\n\n.lw-detail-description {\n  font-size: var(--lw-text-base);\n  color: var(--lw-text-secondary);\n}\n\n/* ========================================\n   Code Block\n   ======================================== */\n\n.lw-code-block {\n  background-color: #0c1f2e;\n  border-radius: var(--lw-radius-md);\n  padding: var(--lw-space-lg);\n  font-family: monospace;\n  font-size: var(--lw-text-sm);\n  color: var(--lw-text-secondary);\n  overflow: auto;\n  max-height: 400px;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n/* ========================================\n   Category Item (Debug Modal)\n   ======================================== */\n\n.lw-category-item {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: 10px var(--lw-space-md);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-md);\n  cursor: pointer;\n  transition: background-color 0.15s;\n}\n\n.lw-category-item:hover {\n  background-color: var(--lw-bg-tertiary);\n}\n\n.lw-category-item.disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.lw-category-checkbox {\n  width: 18px;\n  height: 18px;\n  border-radius: var(--lw-radius-sm);\n  border: 2px solid var(--lw-accent-dark);\n  background-color: transparent;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.lw-category-checkbox.checked {\n  background-color: var(--lw-accent-dark);\n}\n\n.lw-category-checkbox .checkmark {\n  color: var(--lw-text-primary);\n  font-size: var(--lw-text-sm);\n  font-weight: bold;\n}\n\n.lw-category-info {\n  flex: 1;\n}\n\n.lw-category-label {\n  font-size: var(--lw-text-base);\n  font-weight: 500;\n  color: var(--lw-text-primary);\n  margin-bottom: 2px;\n}\n\n.lw-category-desc {\n  font-size: var(--lw-text-xs);\n  color: var(--lw-text-secondary);\n}\n\n/* ========================================\n   Master Toggle Row\n   ======================================== */\n\n.lw-master-toggle {\n  display: flex;\n  align-items: center;\n  gap: var(--lw-space-md);\n  padding: var(--lw-space-md) var(--lw-space-lg);\n  background-color: var(--lw-bg-primary);\n  border-radius: var(--lw-radius-lg);\n  margin-bottom: var(--lw-space-lg);\n}\n\n.lw-master-label {\n  font-size: var(--lw-text-lg);\n  font-weight: 500;\n  color: var(--lw-text-primary);\n  flex: 1;\n}\n\n/* ========================================\n   Category List\n   ======================================== */\n\n.lw-category-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--lw-space-sm);\n}\n\n/* ========================================\n   App Shell / Layout\n   ======================================== */\n\n.lw-app-container {\n  display: flex;\n  height: 100%;\n  background-color: var(--lw-bg-primary);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\n.lw-sidebar {\n  width: 200px;\n  background-color: var(--lw-bg-sidebar);\n  border-right: 1px solid var(--lw-border-color);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n\n.lw-sidebar-nav {\n  padding: var(--lw-space-md);\n}\n\n.lw-nav-button {\n  display: block;\n  width: 100%;\n  padding: 10px var(--lw-space-md);\n  margin-bottom: var(--lw-space-xs);\n  font-size: var(--lw-text-base);\n  font-weight: 500;\n  text-align: left;\n  border: none;\n  border-radius: var(--lw-radius-md);\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: inherit;\n  background-color: transparent;\n  color: var(--lw-text-secondary);\n}\n\n.lw-nav-button:hover {\n  background-color: rgb(109 40 217 / 15%);\n  color: var(--lw-accent-dark);\n}\n\n.lw-nav-button.active {\n  background: var(--lw-accent-gradient);\n  color: white;\n  font-weight: 600;\n}\n\n.lw-main-area {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n.lw-content-area {\n  flex: 1;\n  padding: var(--lw-space-xl);\n  overflow-y: auto;\n}\n\n.lw-nav-badge {\n  margin-left: var(--lw-space-sm);\n  background-color: rgb(34 197 94 / 20%);\n  color: var(--lw-success);\n  font-size: 10px;\n  padding: 2px 6px;\n  border-radius: var(--lw-radius-sm);\n}\n\n/* ========================================\n   Pressure Tooltip\n   ======================================== */\n\n.lw-pressure-tooltip {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  z-index: 1000;\n  min-width: 320px;\n  max-width: 400px;\n  margin-top: 8px;\n  padding: var(--lw-space-md);\n  background-color: var(--lw-bg-secondary);\n  border: 1px solid var(--lw-border-color);\n  border-radius: var(--lw-radius-md);\n  box-shadow: 0 8px 24px rgb(0 0 0 / 40%);\n  font-size: 12px;\n}\n\n.lw-tooltip-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--lw-space-sm);\n  padding-bottom: var(--lw-space-sm);\n  border-bottom: 1px solid var(--lw-border-color);\n}\n\n.lw-tooltip-value {\n  font-family: monospace;\n  color: var(--lw-text-secondary);\n}\n\n.lw-tooltip-section {\n  margin-top: var(--lw-space-sm);\n  padding-top: var(--lw-space-sm);\n  border-top: 1px dashed rgb(255 255 255 / 10%);\n}\n\n.lw-tooltip-section:first-of-type {\n  border-top: none;\n  padding-top: 0;\n}\n\n.lw-tooltip-subtitle {\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: var(--lw-text-muted);\n  margin-bottom: 6px;\n}\n\n.lw-tooltip-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 3px 0;\n}\n\n.lw-tooltip-row span:first-child {\n  color: var(--lw-text-secondary);\n  max-width: 200px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.lw-tooltip-row span:last-child {\n  font-family: monospace;\n  font-weight: 500;\n}\n\n.lw-tooltip-row .positive {\n  color: var(--lw-success);\n}\n\n.lw-tooltip-row .negative {\n  color: var(--lw-danger);\n}\n\n.lw-tooltip-subtotal {\n  margin-top: 4px;\n  padding-top: 4px;\n  border-top: 1px solid rgb(255 255 255 / 10%);\n  font-weight: 600;\n}\n\n.lw-tooltip-final {\n  background-color: rgb(0 0 0 / 20%);\n  margin: var(--lw-space-sm) calc(-1 * var(--lw-space-md)) calc(-1 * var(--lw-space-md));\n  padding: var(--lw-space-sm) var(--lw-space-md);\n  border-radius: 0 0 var(--lw-radius-md) var(--lw-radius-md);\n}\n\n.lw-pressure-delta {\n  font-size: 10px;\n  margin-left: 4px;\n}\n\n.lw-pressure-delta.positive {\n  color: var(--lw-success);\n}\n\n.lw-pressure-delta.negative {\n  color: var(--lw-danger);\n}\n\n/* Additional tooltip styles for cumulative epoch display */\n.lw-tooltip-epoch-info {\n  font-size: 10px;\n  color: var(--lw-text-muted);\n  padding: 4px 0;\n  border-bottom: 1px solid rgb(255 255 255 / 10%);\n  margin-bottom: 4px;\n}\n\n.lw-tooltip-empty {\n  color: var(--lw-text-muted);\n  font-style: italic;\n}\n\n.lw-tooltip-mod-group {\n  margin-bottom: 6px;\n}\n\n.lw-tooltip-mod-header {\n  font-weight: 600;\n  background-color: rgb(255 255 255 / 5%);\n  margin: 0 -8px;\n  padding: 2px 8px;\n}\n\n.lw-tooltip-mod-detail {\n  font-size: 11px;\n  padding-left: 12px;\n  color: var(--lw-text-muted);\n}\n\n.lw-tooltip-actual-change {\n  margin-top: 4px;\n  padding-top: 4px;\n  border-top: 1px solid rgb(255 255 255 / 20%);\n  font-size: 13px;\n}\n","structuredPatch":[{"oldStart":1236,"oldLines":6,"newStart":1236,"newLines":18,"lines":["   gap: var(--lw-space-lg);"," }"," ","+/* Dashboard section utilities (shared across dashboard panels) */","+","+.lw-section-spacer {","+  margin-top: 16px;","+}","+","+.lw-section-label {","+  font-size: 12px;","+  color: var(--lw-text-muted);","+  margin-bottom: 8px;","+}","+"," /* ========================================","    Modal Components","    ======================================== */"]}],"userModified":false,"replaceAll":false}}
