adge {\n  margin-left: 4px;\n  font-size: 9px;\n}\n\n.eke-status-list {\n  flex-direction: column;\n  align-items: stretch;\n}\n\n.eke-status-chip {\n  flex-direction: column;\n  align-items: stretch;\n  padding: 8px;\n}\n\n.eke-status-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.eke-status-polarity {\n  padding: 2px 4px;\n  font-size: 10px;\n  width: 50px;\n}\n\n.eke-status-verb-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 4px;\n}\n\n.eke-verb-label {\n  width: 40px;\n}\n\n.eke-verb-input {\n  flex: 1;\n  font-size: 11px;\n  padding: 2px 6px;\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
