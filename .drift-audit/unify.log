; to generate some.\n                    </div>\n                  ) : (\n                    <div className=\"tps-palette-list\">\n                      {palette.items.map((item: PaletteItem) => (\n                        <div\n                          key={item.id}\n                          className=\"tps-palette-item\"\n                        >","numLines":20,"startLine":335,"totalLines":420}}}
