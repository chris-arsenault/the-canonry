{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_019Yt7rfwXohuyfHoVcw1V6v","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q72PbQkMAeKTKTZycjDQ1f","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/remote-shell.css","content":"/* Shared remote app shell layout\n *\n * Used by Module Federation remote entry points (CoherenceEngineRemote,\n * CosmographerRemote, etc.) that share an identical sidebar + content layout.\n *\n * Customisation:\n *   --rs-active-from / --rs-active-to  : active-button gradient endpoints\n *   --rs-hover-bg                       : inactive-button hover background\n *   --rs-hover-color                    : inactive-button hover text color\n */\n\n.rs-container {\n  display: flex;\n  height: 100%;\n  background-color: #0a1929;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\n.rs-sidebar {\n  width: 200px;\n  background-color: #0c1f2e;\n  border-right: 1px solid rgba(59, 130, 246, 0.3);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n\n.rs-nav {\n  padding: 12px;\n}\n\n.rs-nav-button {\n  display: block;\n  width: 100%;\n  padding: 10px 12px;\n  margin-bottom: 4px;\n  font-size: 13px;\n  font-weight: 500;\n  text-align: left;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  font-family: inherit;\n}\n\n.rs-nav-button-inactive {\n  background-color: transparent;\n  color: #93c5fd;\n}\n\n.rs-nav-button-inactive:hover {\n  background-color: var(--rs-hover-bg, rgba(59, 130, 246, 0.15));\n  color: var(--rs-hover-color, #60a5fa);\n}\n\n.rs-nav-button-active {\n  background: linear-gradient(\n    135deg,\n    var(--rs-active-from, #60a5fa) 0%,\n    var(--rs-active-to, #93c5fd) 100%\n  );\n  color: #0a1929;\n  font-weight: 600;\n}\n\n.rs-nav-button-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.rs-status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.rs-main {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n.rs-content {\n  flex: 1;\n  padding: 24px;\n  overflow-y: auto;\n}\n\n.rs-placeholder {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: #60a5fa;\n  text-align: center;\n}\n\n.rs-placeholder-icon {\n  font-size: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n.rs-placeholder-title {\n  font-size: 18px;\n  font-weight: 500;\n  margin-bottom: 8px;\n  color: #ffffff;\n}\n\n.rs-placeholder-desc {\n  font-size: 14px;\n  color: #93c5fd;\n  max-width: 400px;\n}\n\n/* \"No schema\" variant — full-bleed centered message */\n.rs-no-data {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  color: #60a5fa;\n  text-align: center;\n  padding: 40px;\n}\n\n.rs-no-data-title {\n  font-size: 18px;\n  font-weight: 500;\n  margin-bottom: 8px;\n  color: #ffffff;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1544,"cache_read_input_tokens":59712,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1544},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"812a01ec-29f8-4366-9586-7e3a066a23eb","uuid":"728c0c92-bce4-4e5b-a4b2-75c5b3f41692"}
