);\n}\n\n.ipm-card-current {\n  border-color: var(--success);\n  opacity: 0.7;\n}\n\n.ipm-current-badge {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  z-index: 1;\n  padding: 2px 6px;\n  background: var(--success);\n  color: white;\n  border-radius: 3px;\n  font-size: 9px;\n  font-weight: 600;\n}\n\n.ipm-thumbnail-wrapper {\n  width: 100%;\n  padding-top: 100%;\n  position: relative;\n}\n\n.ipm-card-info {\n  padding: 8px;\n}\n\n.ipm-card-name {\n  font-size: 11px;\n  font-weight: 500;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.ipm-card-meta {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.ipm-card-prompt {\n  margin-top: 6px;\n  padding: 4px 6px;\n  background: rgb(0 0 0 / 20%);\n  border-radius: 4px;\n  font-size: 9px;\n  color: var(--text-muted);\n  overflow: hidden;\n  cursor: pointer;\n  transition: max-height 0.2s ease;\n}\n\n.ipm-card-prompt-collapsed {\n  max-height: 40px;\n}\n\n.ipm-card-prompt-expanded {\n  max-height: 200px;\n}\n\n/* Footer */\n.ipm-footer {\n  padding: 16px;\n  border-top: 1px solid var(--border-color);\n}\n","structuredPatch":[{"oldStart":56,"oldLines":8,"newStart":56,"newLines":6,"lines":[" .ipm-loading,"," .ipm-empty {","   padding: 40px;","-  text-align: center;","-  color: var(--text-muted);"," }"," "," .ipm-grid {"]}],"userModified":false,"replaceAll":false}}
