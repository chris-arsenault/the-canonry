order-color 0.15s;"," }"," ","-.matrix-search:focus {","-  border-color: #f59e0b;","-}","-","-.matrix-search::placeholder {","-  color: #64748b;","-}","-"," /* Bulk Actions */"," .bulk-actions {","   display: flex;"]},{"oldStart":136,"oldLines":41,"newStart":112,"newLines":6,"lines":["   border-radius: 4px;"," }"," ","-/* Matrix Container */","-.matrix-container {","-  flex: 1;","-  overflow: auto;","-  background: rgb(15 23 42 / 40%);","-  border: 1px solid rgb(59 130 246 / 20%);","-  border-radius: 12px;","-}","-","-/* Matrix Table */","-.matrix-table {","-  width: 100%;","-  border-collapse: collapse;","-  font-size: 13px;","-}","-","-.matrix-table th,","-.matrix-table td {","-  padding: 10px 12px;","-  text-align: left;","-  border-bottom: 1px solid rgb(59 130 246 / 10%);","-}","-","-.matrix-table th {","-  position: sticky;","-  top: 0;","-  background: #0c1f2e;","-  font-weight: 600;","-  color: #93c5fd;","-  text-transform: uppercase;","-  font-size: 11px;","-  letter-spacing: 0.5px;","-  z-index: 10;","-}","-"," /* Column Widths */"," .checkbox-col {","   width: 40px;"]},{"oldStart":201,"oldLines":15,"newStart":142,"newLines":7,"lines":["   text-align: right !important;"," }"," ","-/* Row Styles */","-.matrix-row {","-  transition: background-color 0.1s;","-}","-","-.matrix-row:hover {","-  background: rgb(59 130 246 / 5%);","-}","-","+/* Row Styles — extends mat-row */"," .matrix-row.unused {","   opacity: 0.6;"," }"]},{"oldStart":371,"oldLines":16,"newStart":304,"newLines":9,"lines":["   padding: 40px !important;"," }"," ","-/* Legend */","+/* Legend — extends mat-legend with tighter gap */"," .matrix-legend {","-  display: flex;","-  align-items: center;","   gap: 12px;","-  margin-top: 16px;","-  padding: 12px 16px;","-  background: rgb(15 23 42 / 40%);","-  border: 1px solid rgb(59 130 246 / 15%);","-  border-radius: 8px;"," }"," "," .legend-label {"]}],"originalFile":"/**\n * WeightMatrixEditor Styles\n */\n\n.weight-matrix-editor {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  max-width: 100%;\n}\n\n.weight-matrix-editor .header {\n  margin-bottom: 20px;\n}\n\n.weight-matrix-editor .title {\n  font-size: 24px;\n  font-weight: 600;\n  color: #fff;\n  margin: 0 0 8px;\n}\n\n.weight-matrix-editor .subtitle {\n  font-size: 14px;\n  color: #93c5fd;\n  margin: 0;\n}\n\n/* Toolbar */\n.matrix-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n  margin-bottom: 16px;\n  flex-wrap: wrap;\n}\n\n.toolbar-left {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.toolbar-right {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n/* View Toggle */\n.view-toggle {\n  display: flex;\n  background: rgb(15 23 42 / 60%);\n  border-radius: 8px;\n  padding: 4px;\n  border: 1px solid rgb(59 130 246 / 20%);\n}\n\n.view-toggle .toggle-btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  background: transparent;\n  color: #93c5fd;\n}\n\n.view-toggle .toggle-btn:hover {\n  background: rgb(245 158 11 / 15%);\n  color: #f59e0b;\n}\n\n.view-toggle .toggle-btn.active {\n  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);\n  color: #0a1929;\n}\n\n/* Search */\n.matrix-search {\n  padding: 8px 12px;\n  font-size: 13px;\n  background: rgb(15 23 42 / 60%);\n  border: 1px solid rgb(59 130 246 / 20%);\n  border-radius: 6px;\n  color: #fff;\n  width: 200px;\n  outline: none;\n  transition: border-color 0.15s;\n}\n\n.matrix-search:focus {\n  border-color: #f59e0b;\n}\n\n.matrix-search::placeholder {\n  color: #64748b;\n}\n\n/* Bulk Actions */\n.bulk-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: 8px;\n}\n\n.selection-count {\n  font-size: 13px;\n  font-weight: 500;\n  color: #fbbf24;\n}\n\n.quick-set-input {\n  width: 60px;\n  padding: 6px 8px;\n  font-size: 13px;\n  background: rgb(15 23 42 / 80%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  color: #fff;\n  text-align: center;\n}\n\n.copied-indicator {\n  font-size: 12px;\n  color: #22c55e;\n  padding: 4px 8px;\n  background: rgb(34 197 94 / 10%);\n  border-radius: 4px;\n}\n\n/* Matrix Container */\n.matrix-container {\n  flex: 1;\n  overflow: auto;\n  background: rgb(15 23 42 / 40%);\n  border: 1px solid rgb(59 130 246 / 20%);\n  border-radius: 12px;\n}\n\n/* Matrix Table */\n.matrix-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 13px;\n}\n\n.matrix-table th,\n.matrix-table td {\n  padding: 10px 12px;\n  text-align: left;\n  border-bottom: 1px solid rgb(59 130 246 / 10%);\n}\n\n.matrix-table th {\n  position: sticky;\n  top: 0;\n  background: #0c1f2e;\n  font-weight: 600;\n  color: #93c5fd;\n  text-transform: uppercase;\n  font-size: 11px;\n  letter-spacing: 0.5px;\n  z-index: 10;\n}\n\n/* Column Widths */\n.checkbox-col {\n  width: 40px;\n  text-align: center !important;\n}\n\n.name-col {\n  min-width: 200px;\n  max-width: 300px;\n}\n\n.status-col {\n  width: 60px;\n  text-align: center !important;\n}\n\n.era-col {\n  min-width: 80px;\n  max-width: 120px;\n  text-align: center !important;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.actions-col {\n  width: 180px;\n  text-align: right !important;\n}\n\n/* Row Styles */\n.matrix-row {\n  transition: background-color 0.1s;\n}\n\n.matrix-row:hover {\n  background: rgb(59 130 246 / 5%);\n}\n\n.matrix-row.unused {\n  opacity: 0.6;\n}\n\n.matrix-row.unused:hover {\n  opacity: 1;\n}\n\n.matrix-row.selected {\n  background: rgb(245 158 11 / 8%);\n}\n\n/* Item Name */\n.item-name {\n  color: #fff;\n  font-weight: 500;\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.item-type {\n  display: inline-block;\n  margin-top: 2px;\n  font-size: 10px;\n  color: #64748b;\n  background: rgb(100 116 139 / 20%);\n  padding: 2px 6px;\n  border-radius: 3px;\n  text-transform: uppercase;\n}\n\n/* Era Count */\n.era-count {\n  display: inline-block;\n  padding: 2px 8px;\n  font-size: 11px;\n  font-weight: 600;\n  border-radius: 10px;\n  background: rgb(34 197 94 / 20%);\n  color: #22c55e;\n}\n\n.era-count.zero {\n  background: rgb(239 68 68 / 20%);\n  color: #f87171;\n}\n\n/* Weight Cells */\n.weight-cell {\n  text-align: center !important;\n  cursor: pointer;\n  transition: all 0.15s;\n  position: relative;\n  min-width: 60px;\n}\n\n.weight-cell:hover {\n  outline: 2px solid rgb(245 158 11 / 50%);\n  outline-offset: -2px;\n}\n\n.weight-cell.empty {\n  background: transparent !important;\n}\n\n.weight-cell-none {\n  background-color: transparent;\n}\n\n.weight-cell-low {\n  background-color: rgb(245 158 11 / 30%);\n}\n\n.weight-cell-mid {\n  background-color: rgb(245 158 11 / 45%);\n}\n\n.weight-cell-high {\n  background-color: rgb(245 158 11 / 60%);\n}\n\n.weight-cell-max {\n  background-color: rgb(245 158 11 / 75%);\n}\n\n.cell-value {\n  font-weight: 600;\n  font-size: 13px;\n}\n\n.cell-value-muted {\n  color: #64748b;\n}\n\n.cell-value-active {\n  color: #fbbf24;\n}\n\n.cell-input {\n  width: 50px;\n  padding: 4px;\n  font-size: 13px;\n  font-weight: 600;\n  text-align: center;\n  background: rgb(15 23 42 / 90%);\n  border: 2px solid #f59e0b;\n  border-radius: 4px;\n  color: #fff;\n  outline: none;\n}\n\n/* Row Actions */\n.row-actions {\n  display: flex;\n  gap: 4px;\n  justify-content: flex-end;\n  opacity: 0.5;\n  transition: opacity 0.15s;\n}\n\n.matrix-row:hover .row-actions {\n  opacity: 1;\n}\n\n.action-btn {\n  padding: 4px 8px;\n  font-size: 11px;\n  font-weight: 500;\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  background: rgb(15 23 42 / 60%);\n  color: #93c5fd;\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.action-btn:hover {\n  background: rgb(59 130 246 / 20%);\n  border-color: rgb(59 130 246 / 50%);\n}\n\n.action-btn.danger {\n  color: #f87171;\n  border-color: rgb(239 68 68 / 30%);\n}\n\n.action-btn.danger:hover {\n  background: rgb(239 68 68 / 20%);\n  border-color: rgb(239 68 68 / 50%);\n}\n\n/* Empty Row */\n.empty-row {\n  text-align: center !important;\n  color: #64748b;\n  font-style: italic;\n  padding: 40px !important;\n}\n\n/* Legend */\n.matrix-legend {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-top: 16px;\n  padding: 12px 16px;\n  background: rgb(15 23 42 / 40%);\n  border: 1px solid rgb(59 130 246 / 15%);\n  border-radius: 8px;\n}\n\n.legend-label {\n  font-size: 12px;\n  font-weight: 600;\n  color: #93c5fd;\n  text-transform: uppercase;\n}\n\n.legend-scale {\n  display: flex;\n  gap: 2px;\n}\n\n.legend-item {\n  width: 40px;\n  height: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 11px;\n  font-weight: 600;\n  color: #fbbf24;\n  border: 1px solid rgb(59 130 246 / 20%);\n}\n\n.legend-item:first-child {\n  border-radius: 4px 0 0 4px;\n  color: #64748b;\n}\n\n.legend-item:last-child {\n  border-radius: 0 4px 4px 0;\n}\n\n.legend-note {\n  font-size: 12px;\n  color: #64748b;\n  margin-left: auto;\n}\n\n/* Buttons */\n.btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  border: none;\n}\n\n.btn-secondary {\n  background: rgb(59 130 246 / 20%);\n  color: #60a5fa;\n  border: 1px solid rgb(59 130 246 / 30%);\n}\n\n.btn-secondary:hover {\n  background: rgb(59 130 246 / 30%);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: #93c5fd;\n}\n\n.btn-ghost:hover {\n  background: rgb(59 130 246 / 10%);\n}\n\n/* Checkbox styling */\n.matrix-table input[type=\"checkbox\"] {\n  width: 16px;\n  height: 16px;\n  accent-color: #f59e0b;\n  cursor: pointer;\n}\n\n/* Orphaned References Warning */\n.orphan-warning {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 16px;\n  margin-bottom: 16px;\n  background: rgb(239 68 68 / 10%);\n  border: 1px solid rgb(239 68 68 / 30%);\n  border-radius: 8px;\n  gap: 16px;\n}\n\n.orphan-warning-content {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.orphan-warning-icon {\n  font-size: 20px;\n}\n\n.orphan-warning-text {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.orphan-warning-text strong {\n  color: #f87171;\n  font-size: 14px;\n}\n\n.orphan-warning-details {\n  font-size: 12px;\n  color: #fca5a5;\n}\n\n.btn-warning {\n  background: rgb(239 68 68 / 20%);\n  color: #f87171;\n  border: 1px solid rgb(239 68 68 / 40%);\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  white-space: nowrap;\n}\n\n.btn-warning:hover {\n  background: rgb(239 68 68 / 30%);\n  border-color: rgb(239 68 68 / 60%);\n}\n\n/* Orphan badge on toggle buttons */\n.orphan-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 18px;\n  height: 18px;\n  padding: 0 5px;\n  margin-left: 6px;\n  font-size: 10px;\n  font-weight: 700;\n  background: #ef4444;\n  color: #fff;\n  border-radius: 9px;\n}\n"}}
