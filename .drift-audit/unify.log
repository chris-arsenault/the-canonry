 import shared base and remove duplicated styles","status":"pending","activeForm":"Refactoring CoverageMatrix CSS"},{"content":"Update UNIFICATION_LOG.md","status":"pending","activeForm":"Updating unification log"},{"content":"Create ESLint guard rule","status":"pending","activeForm":"Creating ESLint guard rule"},{"content":"Create ADR and pattern doc","status":"pending","activeForm":"Creating ADR and pattern doc"},{"content":"Wire rule into eslint.config.js","status":"pending","activeForm":"Wiring rule into ESLint config"}]}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01MircnSPE4XbL8sKpFBk7P2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015GEbDxrMtv7sKz5GpnRbJF","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/matrix-base.css","content":"/**\n * Matrix base utility classes — shared structural patterns for data matrix components.\n *\n * These classes extract the most commonly duplicated CSS patterns across\n * matrix/spreadsheet-style table components. Components should compose these\n * alongside their prefixed component-specific classes.\n *\n * Usage:  className=\"mat-layout weight-matrix-editor\"\n *   The mat-* class provides the base structural pattern.\n *   The component-prefixed class adds/overrides unique properties.\n *\n * Canonical reference: apps/coherence-engine/webui/src/components/weight-matrix/WeightMatrixEditor.css\n * ADR: docs/adr/037-matrix-css-consolidation.md\n */\n\n/* ── Layout container ──\n * Full-height flex column for the overall matrix page/panel.\n * Used by: weight-matrix-editor, coverage-matrix.\n */\n.mat-layout {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  max-width: 100%;\n}\n\n/* ── Scrollable area ──\n * Flex-growing scrollable container wrapping the table.\n * Used by: matrix-container, cm-container.\n */\n.mat-scroll-area {\n  flex: 1;\n  overflow: auto;\n  background: rgb(15 23 42 / 40%);\n  border: 1px solid rgb(59 130 246 / 20%);\n  border-radius: 12px;\n}\n\n/* ── Table ──\n * Full-width collapsed table with sticky uppercase headers.\n * Used by: matrix-table, cm-table.\n */\n.mat-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 13px;\n}\n\n.mat-table th,\n.mat-table td {\n  padding: 10px 12px;\n  text-align: left;\n  border-bottom: 1px solid rgb(59 130 246 / 10%);\n}\n\n.mat-table th {\n  position: sticky;\n  top: 0;\n  background: #0c1f2e;\n  font-weight: 600;\n  color: #93c5fd;\n  text-transform: uppercase;\n  font-size: 11px;\n  letter-spacing: 0.5px;\n  z-index: 10;\n}\n\n/* ── Row hover ──\n * Subtle background transition on row hover.\n * Used by: matrix-row, cm-row.\n */\n.mat-row {\n  transition: background-color 0.1s;\n}\n\n.mat-row:hover {\n  background: rgb(59 130 246 / 5%);\n}\n\n/* ── Toolbar ──\n * Horizontal flex toolbar above the matrix.\n * Used by: matrix-toolbar, cm-toolbar.\n */\n.mat-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 16px;\n  flex-wrap: wrap;\n}\n\n/* ── Search input ──\n * Dark-themed search input with focus accent.\n * Used by: matrix-search, cm-search.\n */\n.mat-search {\n  padding: 8px 12px;\n  font-size: 13px;\n  background: rgb(15 23 42 / 60%);\n  border: 1px solid rgb(59 130 246 / 20%);\n  border-radius: 6px;\n  color: #fff;\n  outline: none;\n  transition: border-color 0.15s;\n}\n\n.mat-search:focus {\n  border-color: #f59e0b;\n}\n\n.mat-search::placeholder {\n  color: #64748b;\n}\n\n/* ── Legend bar ──\n * Horizontal legend strip below the matrix.\n * Used by: matrix-legend, cm-legend.\n */\n.mat-legend {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  margin-top: 16px;\n  padding: 12px 16px;\n  background: rgb(15 23 42 / 40%);\n  border: 1px solid rgb(59 130 246 / 15%);\n  border-radius: 8px;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":9251,"cache_read_input_tokens":90036,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9251},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"1e25f0ac-8e93-4dfd-8fc9-5da30702dc9f","uuid":"190dd2ac-4abb-43e6-815f-cb70545fd800"}
