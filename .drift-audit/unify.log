);\n    77→  border-radius: 6px;\n    78→  border-left: 3px solid var(--warning-color, #f59e0b);\n    79→  font-size: 12px;\n    80→  color: var(--text-secondary);\n    81→}\n    82→\n    83→/* Footer button sizing (layout provided by modal-footer) */\n    84→.rfm-footer-btn {\n    85→  padding: 6px 16px;\n    86→  font-size: 12px;\n    87→}\n    88→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"0183afcb-0e7c-44cf-be50-65fae5a96f4c","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/RevisionFilterModal.css","content":"/* RevisionFilterModal — rfm- prefix */\n/* Overlay, header, close button, scroll lock, and Escape are provided by ModalShell */\n\n.modal.rfm-dialog {\n  width: 440px;\n  max-width: 95vw;\n  height: auto;\n  max-height: 90vh;\n}\n\n.rfm-subtitle {\n  margin: 0 0 12px;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.rfm-counts-grid {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 6px 16px;\n  font-size: 12px;\n  margin-bottom: 16px;\n}\n\n.rfm-count-label {\n  color: var(--text-secondary);\n}\n\n.rfm-count-value {\n  font-family: monospace;\n  font-weight: 600;\n}\n\n.rfm-count-value-warning {\n  color: var(--warning-color, #f59e0b);\n}\n\n.rfm-count-value-muted {\n  color: var(--text-muted);\n}\n\n.rfm-count-label-total {\n  font-weight: 600;\n}\n\n/* Chronicle filter toggle */\n.rfm-filter-toggle {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  padding: 10px 12px;\n  background: var(--bg-secondary);\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 12px;\n}\n\n.rfm-filter-checkbox {\n  margin-top: 2px;\n}\n\n.rfm-filter-title {\n  font-weight: 600;\n}\n\n.rfm-filter-description {\n  color: var(--text-muted);\n  font-size: 11px;\n  margin-top: 2px;\n}\n\n/* No-entities warning */\n.rfm-warning {\n  margin-top: 12px;\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border-left: 3px solid var(--warning-color, #f59e0b);\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n/* Footer button sizing (layout provided by modal-footer) */\n.rfm-footer-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","numLines":88,"startLine":1,"totalLines":88}}}
