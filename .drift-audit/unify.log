{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VohQ9P57dpRViFoxcdPRrE","type":"tool_result","content":"     1→/**\n     2→ * SectionHeader - Section title with optional count badge and description\n     3→ */\n     4→\n     5→import React from 'react';\n     6→import PropTypes from 'prop-types';\n     7→\n     8→/**\n     9→ * @param {Object} props\n    10→ * @param {string} props.title - Section title\n    11→ * @param {string} [props.description] - Optional description text\n    12→ * @param {string} [props.icon] - Optional emoji icon\n    13→ * @param {string} [props.count] - Optional count badge text (e.g. \"3 active / 5 total\")\n    14→ * @param {React.ReactNode} [props.actions] - Optional action buttons on the right\n    15→ * @param {string} [props.className] - Optional additional class names\n    16→ */\n    17→export function SectionHeader({\n    18→  title,\n    19→  description,\n    20→  icon,\n    21→  count,\n    22→  actions,\n    23→  className = '',\n    24→}) {\n    25→  return (\n    26→    <>\n    27→      <div className={`flex-between mb-lg ${className}`.trim()}>\n    28→        <div className=\"section-title mb-0\">\n    29→          {icon && <span className=\"section-title-icon\">{icon}</span>}\n    30→          {title}\n    31→          {count && <span className=\"badge-count\">{count}</span>}\n    32→        </div>\n    33→        {actions}\n    34→      </div>\n    35→      {description && <div className=\"section-desc\">{description}</div>}\n    36→    </>\n    37→  );\n    38→}\n    39→\n    40→export default SectionHeader;\n    41→\n    42→SectionHeader.propTypes = {\n    43→  title: PropTypes.string.isRequired,\n    44→  description: PropTypes.string,\n    45→  icon: PropTypes.string,\n    46→  count: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n    47→  actions: PropTypes.node,\n    48→  className: PropTypes.string,\n    49→};\n    50→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"55ca2778-d3ad-46b7-b37e-37873a3f68a6"}
