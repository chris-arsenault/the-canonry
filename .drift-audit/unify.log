{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016MPwUSqz5sybhmrsRhymKa","type":"tool_result","content":"     1→/**\n     2→ * ModalShell - Shared modal container with overlay, header, optional tabs, and close button\n     3→ *\n     4→ * Supports two modes:\n     5→ * - Simple mode: Just renders children in the body\n     6→ * - Tabbed mode: Renders a sidebar with tabs when `tabs` prop is provided\n     7→ */\n     8→\n     9→import React, { useRef, useEffect, useCallback } from 'react';\n    10→import PropTypes from 'prop-types';\n    11→\n    12→/**\n    13→ * @param {Object} props\n    14→ * @param {Function} props.onClose - Called when overlay or close button is clicked\n    15→ * @param {string} props.icon - Icon to show in header\n    16→ * @param {string} props.title - Modal title\n    17→ * @param {boolean} [props.disabled] - Whether to show disabled badge\n    18→ * @param {Array<{id: string, icon: string, label: string}>} [props.tabs] - Tab definitions (optional)\n    19→ * @param {string} [props.activeTab] - Currently active tab ID\n    20→ * @param {Function} [props.onTabChange] - Called when tab changes\n    21→ * @param {Function} [props.renderTabBadge] - Optional function to render badge for each tab: (tabId) => ReactNode\n    22→ * @param {React.ReactNode} [props.sidebarFooter] - Optional content to render at bottom of sidebar\n    23→ * @param {React.ReactNode} props.children - Modal content (tab content if tabs provided, otherwise full body)\n    24→ * @param {string} [props.className] - Additional class for modal container\n    25→ * @param {boolean} [props.preventOverlayClose] - Disable overlay click and Escape key close\n    26→ * @param {React.ReactNode} [props.footer] - Optional footer content\n    27→ */\n    28→export function ModalShell({\n    29→  onClose,\n    30→  icon,\n    31→  title,\n    32→  disabled,\n    33→  tabs,\n    34→  activeTab,\n    35→  onTabChange,\n    36→  renderTabBadge,\n    37→  sidebarFooter,\n    38→  children,\n    39→  className = '',\n    40→  preventOverlayClose = false,\n    41→  footer,\n    42→}) {\n    43→  const hasTabs = tabs && tabs.length > 0;\n    44→  const mouseDownOnOverlay = useRef(false);\n    45→\n    46→  // Escape key handler\n    47→  const handleKeyDown = useCallback((e) => {\n    48→    if (e.key === 'Escape' && !preventOverlayClose) {\n    49→      onClose();\n    50→    }\n    51→  }, [onClose, preventOverlayClose]);\n    52→\n    53→  useEffect(() => {\n    54→    document.addEventListener('keydown', handleKeyDown);\n    55→    return () => document.removeEventListener('keydown', handleKeyDown);\n    56→  }, [handleKeyDown]);\n    57→\n    58→  // Body scroll lock\n    59→  useEffect(() => {\n    60→    const prev = document.body.style.overflow;\n    61→    document.body.style.overflow = 'hidden';\n    62→    return () => { document.body.style.overflow = prev; };\n    63→  }, []);\n    64→\n    65→  const handleOverlayMouseDown = (e) => {\n    66→    mouseDownOnOverlay.current = e.target === e.currentTarget;\n    67→  };\n    68→\n    69→  const handleOverlayClick = (e) => {\n    70→    if (!preventOverlayClose && mouseDownOnOverlay.current && e.target === e.currentTarget) {\n    71→      onClose();\n    72→    }\n    73→  };\n    74→\n    75→  return (\n    76→    <div className=\"modal-overlay\" onMouseDown={handleOverlayMouseDown} onClick={handleOverlayClick} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }} >\n    77→      <div className={`modal ${className}`.trim()} onClick={(e) => e.stopPropagation()} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n    78→        <div className=\"modal-header\">\n    79→          <div className=\"modal-title\">\n    80→            {icon && <span className=\"modal-title-icon\">{icon}</span>}\n    81→            <span>{title}</span>\n    82→            {disabled && <span className=\"badge badge-orphan\">Disabled</span>}\n    83→          </div>\n    84→          <button className=\"btn-close\" onClick={onClose}>×</button>\n    85→        </div>\n    86→        <div className=\"modal-body\">\n    87→          {hasTabs ? (\n    88→            <>\n    89→              <div className=\"modal-sidebar\">\n    90→                {tabs.map((tab) => (\n    91→                  <button\n    92→                    key={tab.id}\n    93→                    className={`btn-tab ${activeTab === tab.id ? 'btn-tab-active' : ''}`}\n    94→                    onClick={() => onTabChange?.(tab.id)}\n    95→                  >\n    96→                    <span className=\"btn-tab-icon\">{tab.icon}</span>\n    97→                    <span>{tab.label}</span>\n    98→                    {renderTabBadge?.(tab.id)}\n    99→                  </button>\n   100→                ))}\n   101→                {sidebarFooter}\n   102→              </div>\n   103→              <div className=\"modal-content\">{children}</div>\n   104→            </>\n   105→          ) : (\n   106→            children\n   107→          )}\n   108→        </div>\n   109→        {footer && <div className=\"modal-footer\">{footer}</div>}\n   110→      </div>\n   111→    </div>\n   112→  );\n   113→}\n   114→\n   115→ModalShell.propTypes = {\n   116→  onClose: PropTypes.func.isRequired,\n   117→  icon: PropTypes.string,\n   118→  title: PropTypes.string.isRequired,\n   119→  disabled: PropTypes.bool,\n   120→  tabs: PropTypes.arrayOf(\n   121→    PropTypes.shape({\n   122→      id: PropTypes.string.isRequired,\n   123→      icon: PropTypes.string,\n   124→      label: PropTypes.string.isRequired,\n   125→    })\n   126→  ),\n   127→  activeTab: PropTypes.string,\n   128→  onTabChange: PropTypes.func,\n   129→  renderTabBadge: PropTypes.func,\n   130→  sidebarFooter: PropTypes.node,\n   131→  children: PropTypes.node,\n   132→  className: PropTypes.string,\n   133→  preventOverlayClose: PropTypes.bool,\n   134→  footer: PropTypes.node,\n   135→};\n   136→"}]},"parent_tool_use_id":null,"session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"150976f5-35b5-487e-9a8c-04a77b99a830","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/ModalShell.jsx","content":"/**\n * ModalShell - Shared modal container with overlay, header, optional tabs, and close button\n *\n * Supports two modes:\n * - Simple mode: Just renders children in the body\n * - Tabbed mode: Renders a sidebar with tabs when `tabs` prop is provided\n */\n\nimport React, { useRef, useEffect, useCallback } from 'react';\nimport PropTypes from 'prop-types';\n\n/**\n * @param {Object} props\n * @param {Function} props.onClose - Called when overlay or close button is clicked\n * @param {string} props.icon - Icon to show in header\n * @param {string} props.title - Modal title\n * @param {boolean} [props.disabled] - Whether to show disabled badge\n * @param {Array<{id: string, icon: string, label: string}>} [props.tabs] - Tab definitions (optional)\n * @param {string} [props.activeTab] - Currently active tab ID\n * @param {Function} [props.onTabChange] - Called when tab changes\n * @param {Function} [props.renderTabBadge] - Optional function to render badge for each tab: (tabId) => ReactNode\n * @param {React.ReactNode} [props.sidebarFooter] - Optional content to render at bottom of sidebar\n * @param {React.ReactNode} props.children - Modal content (tab content if tabs provided, otherwise full body)\n * @param {string} [props.className] - Additional class for modal container\n * @param {boolean} [props.preventOverlayClose] - Disable overlay click and Escape key close\n * @param {React.ReactNode} [props.footer] - Optional footer content\n */\nexport function ModalShell({\n  onClose,\n  icon,\n  title,\n  disabled,\n  tabs,\n  activeTab,\n  onTabChange,\n  renderTabBadge,\n  sidebarFooter,\n  children,\n  className = '',\n  preventOverlayClose = false,\n  footer,\n}) {\n  const hasTabs = tabs && tabs.length > 0;\n  const mouseDownOnOverlay = useRef(false);\n\n  // Escape key handler\n  const handleKeyDown = useCallback((e) => {\n    if (e.key === 'Escape' && !preventOverlayClose) {\n      onClose();\n    }\n  }, [onClose, preventOverlayClose]);\n\n  useEffect(() => {\n    document.addEventListener('keydown', handleKeyDown);\n    return () => document.removeEventListener('keydown', handleKeyDown);\n  }, [handleKeyDown]);\n\n  // Body scroll lock\n  useEffect(() => {\n    const prev = document.body.style.overflow;\n    document.body.style.overflow = 'hidden';\n    return () => { document.body.style.overflow = prev; };\n  }, []);\n\n  const handleOverlayMouseDown = (e) => {\n    mouseDownOnOverlay.current = e.target === e.currentTarget;\n  };\n\n  const handleOverlayClick = (e) => {\n    if (!preventOverlayClose && mouseDownOnOverlay.current && e.target === e.currentTarget) {\n      onClose();\n    }\n  };\n\n  return (\n    <div className=\"modal-overlay\" onMouseDown={handleOverlayMouseDown} onClick={handleOverlayClick} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }} >\n      <div className={`modal ${className}`.trim()} onClick={(e) => e.stopPropagation()} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n        <div className=\"modal-header\">\n          <div className=\"modal-title\">\n            {icon && <span className=\"modal-title-icon\">{icon}</span>}\n            <span>{title}</span>\n            {disabled && <span className=\"badge badge-orphan\">Disabled</span>}\n          </div>\n          <button className=\"btn-close\" onClick={onClose}>×</button>\n        </div>\n        <div className=\"modal-body\">\n          {hasTabs ? (\n            <>\n              <div className=\"modal-sidebar\">\n                {tabs.map((tab) => (\n                  <button\n                    key={tab.id}\n                    className={`btn-tab ${activeTab === tab.id ? 'btn-tab-active' : ''}`}\n                    onClick={() => onTabChange?.(tab.id)}\n                  >\n                    <span className=\"btn-tab-icon\">{tab.icon}</span>\n                    <span>{tab.label}</span>\n                    {renderTabBadge?.(tab.id)}\n                  </button>\n                ))}\n                {sidebarFooter}\n              </div>\n              <div className=\"modal-content\">{children}</div>\n            </>\n          ) : (\n            children\n          )}\n        </div>\n        {footer && <div className=\"modal-footer\">{footer}</div>}\n      </div>\n    </div>\n  );\n}\n\nModalShell.propTypes = {\n  onClose: PropTypes.func.isRequired,\n  icon: PropTypes.string,\n  title: PropTypes.string.isRequired,\n  disabled: PropTypes.bool,\n  tabs: PropTypes.arrayOf(\n    PropTypes.shape({\n      id: PropTypes.string.isRequired,\n      icon: PropTypes.string,\n      label: PropTypes.string.isRequired,\n    })\n  ),\n  activeTab: PropTypes.string,\n  onTabChange: PropTypes.func,\n  renderTabBadge: PropTypes.func,\n  sidebarFooter: PropTypes.node,\n  children: PropTypes.node,\n  className: PropTypes.string,\n  preventOverlayClose: PropTypes.bool,\n  footer: PropTypes.node,\n};\n","numLines":136,"startLine":1,"totalLines":136}}}
