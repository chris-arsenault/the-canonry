{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wvhLX6eXSXaEzMCAz9Tr6","type":"tool_result","content":"The file /home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/actions.css has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"32287e93-604d-418a-8354-e377e7fb06c1","uuid":"a1c55f90-78cd-4900-8a91-752cea0cb1c4","tool_use_result":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/actions.css","oldString":"/* Enable toggle */\n.enable-toggle {\n  width: 36px;\n  height: 20px;\n  border-radius: 10px;\n  background-color: #374151;\n  cursor: pointer;\n  position: relative;\n  transition: background-color var(--transition-normal);\n  flex-shrink: 0;\n}\n\n.enable-toggle-on {\n  background-color: var(--color-success);\n}\n\n.enable-toggle-knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: var(--radius-full);\n  background-color: #fff;\n  transition: transform var(--transition-normal);\n}\n\n.enable-toggle-on .enable-toggle-knob {\n  transform: translateX(16px);\n}\n\n/* Add card (dashed border style) */","newString":"/* Add card (dashed border style) */","originalFile":"/**\n * Actions editor specific styles\n */\n\n/* Editor container */\n.actions-editor {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: var(--spacing-2xl);\n}\n\n/* Header section */\n.actions-header {\n  margin-bottom: var(--spacing-3xl);\n}\n\n.actions-title {\n  font-size: 32px;\n  font-weight: var(--font-weight-semibold);\n  background: var(--gradient-accent);\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n  margin-bottom: var(--spacing-md);\n}\n\n.actions-subtitle {\n  font-size: var(--font-size-lg);\n  color: var(--color-text-muted);\n  margin-bottom: var(--spacing-xl);\n  line-height: var(--line-height-normal);\n}\n\n/* Stats section */\n.actions-stats {\n  display: flex;\n  gap: var(--spacing-2xl);\n}\n\n.actions-stat {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.actions-stat-label {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.actions-stat-value {\n  font-size: 24px;\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-accent);\n}\n\n/* Action grid */\n.actions-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n  gap: var(--spacing-xl);\n  margin-bottom: var(--spacing-2xl);\n}\n\n/* Action card */\n.action-card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  padding: 20px;\n  transition: all var(--transition-normal);\n  cursor: pointer;\n  position: relative;\n}\n\n.action-card:hover {\n  border-color: var(--color-accent);\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgb(0 0 0 / 30%);\n}\n\n.action-card-disabled {\n  opacity: 0.5;\n}\n\n/* Card badges */\n.action-card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-lg);\n}\n\n/* Enable toggle */\n.enable-toggle {\n  width: 36px;\n  height: 20px;\n  border-radius: 10px;\n  background-color: #374151;\n  cursor: pointer;\n  position: relative;\n  transition: background-color var(--transition-normal);\n  flex-shrink: 0;\n}\n\n.enable-toggle-on {\n  background-color: var(--color-success);\n}\n\n.enable-toggle-knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: var(--radius-full);\n  background-color: #fff;\n  transition: transform var(--transition-normal);\n}\n\n.enable-toggle-on .enable-toggle-knob {\n  transform: translateX(16px);\n}\n\n/* Add card (dashed border style) */\n.actions-add-card {\n  background-color: transparent;\n  border-radius: var(--radius-2xl);\n  border: 2px dashed var(--color-border);\n  padding: 40px 20px;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  color: var(--color-text-dim);\n  min-height: 140px;\n}\n\n.actions-add-card:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n  background-color: rgb(245 158 11 / 5%);\n}\n\n/* Validation borders for action cards */\n.action-card-invalid {\n  border-color: var(--color-danger);\n  box-shadow: 0 0 0 1px var(--color-danger);\n}\n\n.action-card-warning {\n  border-color: var(--color-warning);\n  box-shadow: 0 0 0 1px var(--color-warning);\n}\n","structuredPatch":[{"oldStart":92,"oldLines":37,"newStart":92,"newLines":6,"lines":["   margin-top: var(--spacing-lg);"," }"," ","-/* Enable toggle */","-.enable-toggle {","-  width: 36px;","-  height: 20px;","-  border-radius: 10px;","-  background-color: #374151;","-  cursor: pointer;","-  position: relative;","-  transition: background-color var(--transition-normal);","-  flex-shrink: 0;","-}","-","-.enable-toggle-on {","-  background-color: var(--color-success);","-}","-","-.enable-toggle-knob {","-  position: absolute;","-  top: 2px;","-  left: 2px;","-  width: 16px;","-  height: 16px;","-  border-radius: var(--radius-full);","-  background-color: #fff;","-  transition: transform var(--transition-normal);","-}","-","-.enable-toggle-on .enable-toggle-knob {","-  transform: translateX(16px);","-}","-"," /* Add card (dashed border style) */"," .actions-add-card {","   background-color: transparent;"]}],"userModified":false,"replaceAll":false}}
