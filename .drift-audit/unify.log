n}\n\n.cfr-match-row-rejected {\n  background: var(--bg-secondary);\n  opacity: 0.5;\n}\n\n.cfr-match-checkbox {\n  margin-top: 3px;\n  cursor: pointer;\n  flex-shrink: 0;\n}\n\n.cfr-match-body {\n  font-size: 11px;\n  line-height: 1.7;\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n  flex: 1;\n}\n\n.cfr-match-body-mono {\n  font-family: monospace;\n}\n\n.cfr-diff-context {\n  color: var(--text-muted);\n  font-size: 10px;\n}\n\n.cfr-diff-old {\n  padding: 1px 2px;\n  border-radius: 2px;\n}\n\n.cfr-diff-old-accepted {\n  background: rgb(239 68 68 / 15%);\n  text-decoration: line-through;\n}\n\n.cfr-diff-old-rejected {\n  background: rgb(139 115 85 / 15%);\n  text-decoration: none;\n}\n\n.cfr-diff-new {\n  background: rgb(34 197 94 / 20%);\n  padding: 1px 2px;\n  border-radius: 2px;\n}\n\n.cfr-literal-context {\n  color: var(--text-muted);\n}\n\n.cfr-literal-old {\n  background: rgb(239 68 68 / 20%);\n  text-decoration: line-through;\n  padding: 0 1px;\n  border-radius: 2px;\n}\n\n.cfr-literal-new {\n  background: rgb(34 197 94 / 20%);\n  padding: 0 1px;\n  border-radius: 2px;\n}\n\n/* ── Source group ── */\n.cfr-source-group {\n  margin-bottom: 4px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.cfr-source-header {\n  padding: 8px 12px;\n  background: var(--bg-secondary);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  user-select: none;\n}\n\n.cfr-source-arrow {\n  font-size: 10px;\n  color: var(--text-muted);\n  width: 10px;\n  flex-shrink: 0;\n}\n\n.cfr-source-label {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--text-primary);\n}\n\n.cfr-source-count {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-left: auto;\n}\n\n.cfr-source-accept-count {\n  font-size: 10px;\n  color: #22c55e;\n}\n\n.cfr-source-reject-count {\n  font-size: 10px;\n  color: #ef4444;\n}\n\n.cfr-source-btn {\n  background: none;\n  border: none;\n  font-size: 10px;\n  cursor: pointer;\n  p