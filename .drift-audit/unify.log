{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_016Rh5x58AAHuMtKY4sgc2LL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Nk7UXta2idaH9h9jXqU1Ly","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/apps/cosmographer/webui/src/styles/cosmographer-editor.css","content":"/**\n * Shared CSS for cosmographer editor components.\n *\n * Canonical source for modal, form, button, and empty-state patterns\n * used across AxisRegistry, RelationshipEditor, and similar editors.\n * See docs/patterns/cosmographer-editor-css.md for usage.\n */\n\n/* --- Modal overlay --- */\n.cosmo-modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-color: rgba(0, 0, 0, 0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.cosmo-modal-content {\n  background-color: #0c1f2e;\n  padding: 24px;\n  border-radius: 8px;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n}\n\n.cosmo-modal-title {\n  font-size: 16px;\n  font-weight: 600;\n  margin-bottom: 16px;\n  color: #93c5fd;\n}\n\n.cosmo-modal-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  margin-top: 20px;\n}\n\n/* --- Form elements --- */\n.cosmo-form-group {\n  margin-bottom: 14px;\n}\n\n.cosmo-label {\n  font-size: 12px;\n  color: #888;\n  margin-bottom: 4px;\n  display: block;\n}\n\n.cosmo-input {\n  width: 100%;\n  padding: 8px 10px;\n  font-size: 14px;\n  background-color: #0a1929;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n  border-radius: 4px;\n  color: #eee;\n  box-sizing: border-box;\n}\n\n.cosmo-select {\n  width: 100%;\n  padding: 8px 10px;\n  font-size: 14px;\n  background-color: #0a1929;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n  border-radius: 4px;\n  color: #eee;\n}\n\n.cosmo-hint {\n  font-size: 11px;\n  color: #666;\n  margin-top: 4px;\n}\n\n/* --- Buttons --- */\n.cosmo-add-btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  background-color: #60a5fa;\n  color: #0a1929;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  font-weight: 500;\n}\n\n.cosmo-cancel-btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  background-color: rgba(96, 165, 250, 0.1);\n  color: #93c5fd;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.cosmo-save-btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  background-color: #60a5fa;\n  color: #0a1929;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  font-weight: 500;\n}\n\n.cosmo-delete-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n  background-color: transparent;\n  color: #f87171;\n  border: 1px solid #f87171;\n  border-radius: 3px;\n  cursor: pointer;\n}\n\n.cosmo-edit-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n  background-color: rgba(96, 165, 250, 0.2);\n  color: #93c5fd;\n  border: none;\n  border-radius: 3px;\n  cursor: pointer;\n}\n\n/* --- Empty state --- */\n.cosmo-empty-state {\n  color: #666;\n  font-size: 14px;\n  text-align: center;\n  padding: 60px 20px;\n}\n\n/* --- Layout --- */\n.cosmo-editor-container {\n  max-width: 1000px;\n}\n\n.cosmo-editor-header {\n  margin-bottom: 16px;\n}\n\n.cosmo-editor-title {\n  font-size: 20px;\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n\n.cosmo-editor-subtitle {\n  color: #888;\n  font-size: 13px;\n}\n\n.cosmo-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n}\n\n.cosmo-actions {\n  display: flex;\n  gap: 6px;\n}\n\n.cosmo-count {\n  color: #888;\n  font-size: 13px;\n}\n\n.cosmo-arrow {\n  color: #60a5fa;\n  font-size: 14px;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":128,"cache_read_input_tokens":74448,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":128},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"f18789e5-fb86