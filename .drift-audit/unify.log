{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01XqGZRhWaFA7oq6X2itmabb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0121bVayLnRKY6ud7je8ryei","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/components/weight-matrix/WeightMatrixEditor.css","content":"/**\n * WeightMatrixEditor Styles\n *\n * Structural base provided by mat-* classes from @the-canonry/shared-components.\n * This file contains only WeightMatrixEditor-specific rules.\n */\n\n.weight-matrix-editor .header {\n  margin-bottom: 20px;\n}\n\n.weight-matrix-editor .title {\n  font-size: 24px;\n  font-weight: 600;\n  color: #fff;\n  margin: 0 0 8px;\n}\n\n.weight-matrix-editor .subtitle {\n  font-size: 14px;\n  color: #93c5fd;\n  margin: 0;\n}\n\n/* Toolbar — extends mat-toolbar with space-between and wider gap */\n.matrix-toolbar {\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.toolbar-left {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.toolbar-right {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n/* View Toggle */\n.view-toggle {\n  display: flex;\n  background: rgb(15 23 42 / 60%);\n  border-radius: 8px;\n  padding: 4px;\n  border: 1px solid rgb(59 130 246 / 20%);\n}\n\n.view-toggle .toggle-btn {\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  transition: all 0.15s;\n  background: transparent;\n  color: #93c5fd;\n}\n\n.view-toggle .toggle-btn:hover {\n  background: rgb(245 158 11 / 15%);\n  color: #f59e0b;\n}\n\n.view-toggle .toggle-btn.active {\n  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);\n  color: #0a1929;\n}\n\n/* Search — extends mat-search with fixed width */\n.matrix-search {\n  width: 200px;\n}\n\n/* Bulk Actions */\n.bulk-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: 8px;\n}\n\n.selection-count {\n  font-size: 13px;\n  font-weight: 500;\n  color: #fbbf24;\n}\n\n.quick-set-input {\n  width: 60px;\n  padding: 6px 8px;\n  font-size: 13px;\n  background: rgb(15 23 42 / 80%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  color: #fff;\n  text-align: center;\n}\n\n.copied-indicator {\n  font-size: 12px;\n  color: #22c55e;\n  padding: 4px 8px;\n  background: rgb(34 197 94 / 10%);\n  border-radius: 4px;\n}\n\n/* Column Widths */\n.checkbox-col {\n  width: 40px;\n  text-align: center !important;\n}\n\n.name-col {\n  min-width: 200px;\n  max-width: 300px;\n}\n\n.status-col {\n  width: 60px;\n  text-align: center !important;\n}\n\n.era-col {\n  min-width: 80px;\n  max-width: 120px;\n  text-align: center !important;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.actions-col {\n  width: 180px;\n  text-align: right !important;\n}\n\n/* Row Styles — extends mat-row */\n.matrix-row.unused {\n  opacity: 0.6;\n}\n\n.matrix-row.unused:hover {\n  opacity: 1;\n}\n\n.matrix-row.selected {\n  background: rgb(245 158 11 / 8%);\n}\n\n/* Item Name */\n.item-name {\n  color: #fff;\n  font-weight: 500;\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.item-type {\n  display: inline-block;\n  margin-top: 2px;\n  font-size: 10px;\n  color: #64748b;\n  background: rgb(100 116 139 / 20%);\n  padding: 2px 6px;\n  border-radius: 3px;\n  text-transform: uppercase;\n}\n\n/* Era Count */\n.era-count {\n  display: inline-block;\n  padding: 2px 8px;\n  font-size: 11px;\n  font-weight: 600;\n  border-radius: 10px;\n  background: rgb(34 197 94 / 20%);\n  color: #22c55e;\n}\n\n.era-count.zero {\n  background: rgb(239 68 68 / 20%);\n  color: #f87171;\n}\n\n/* Weight Cells */\n.weight-cell {\n  text-align: center !important;\n  cursor: pointer;\n  transition: all 0.15s;\n  position: relative;\n  min-width: 60px;\n}\n\n.weight-cell:hover {\n  outline: 2px solid rgb(245 158 11 / 50%);\n  outline-offset: -2px;\n}\n\n.weight-cell.empty {\n  background: transparent !important;\n}\n\n.weight-cell-none {\n  background-color: transparent;\n}\n\n.weight-cell-low {\n  background-color: rgb(245 158 11 / 30%);\n}\n\n.weight-cell-mid {\n  background-color: rgb(245 158 11 / 45%);\n}\n\n.weight-cell-high {\n  background-color: rgb(245 158 11 / 60%);\n}\n\n.weight-cell-max {\n  background-color: rgb(245 158 11 / 75%);\n}\n\n.cell-value {\n  font-weight: 600;\n  font-size: 13px;\n}\n\n.cell-value-muted {\n  color: #64748b;\n}\n\n.cell-value-active {\n  color: #fbbf24;\n}\n\n.cell-input {\n  width: 50px;\n  padding: 4px;\n  font-size: 13px;\n  font-weight: 600;\n  text-align: center;\n  background: rgb(15 23 42 / 90%);\n  border: 2px solid #f59e0b;\n  border-radius: 4px;\n  color: #fff;\n  outline: none;\n}\n\n/* Row Actions */\n.row-actions {\n  display: flex;\n  gap: 4px;\n  justify-content: flex-end;\n  opacity: 0.5;\n  transition: opacity 0.15s;\n}\n\n.matrix-row:hover .row-actions {\n  opacity: 1;\n}\n\n.action-btn {\n  padding: 4px 8px;\n  font-size: 11px;\n  font-weight: 500;\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: 4px;\n  background: rgb(15 23 42 / 60%);\n  color: #93c5fd;\n  cursor: pointer;\n  transition: all 0.15s;\n}\n\n.action-btn:hover {\n  background: rgb(59 130 246 / 20%);\n  border-color: rgb(59 130 246 / 50%);\n}\n\n.action-btn.danger {\n  color: #f87171;\n  border-color: rgb(239 68 68 / 30%);\n}\n\n.action-btn.danger:hover {\n  background: rgb(239 68 68 / 20%);\n  border-color: rgb(239 68 68 / 50%);\n}\n\n/* Empty Row */\n.empty-row {\n  text-align: center !important;\n  color: #64748b;\n  font-style: italic;\n  padding: 40px !important;\n}\n\n/* Legend — extends mat-legend with tighter gap */\n.matrix-legend {\n  gap: 12px;\n}\n\n.legend-label {\n  font-size: 12px;\n  font-weight: 600;\n  color: #93c5fd;\n  text-transform: uppercase;\n}\n\n.legend-scale {\n  