{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T9BCUQNJjEaMHUrE2oCWFQ","type":"tool_result","content":"    48→\n    49→export interface UseSummaryRevisionReturn {\n    50→  /** Current run state */\n    51→  run: SummaryRevisionRun | null;\n    52→  /** Whether a revision session is active */\n    53→  isActive: boolean;\n    54→  /** Start a new revision session */\n    55→  startRevision: (config: SummaryRevisionConfig) => Promise<void>;\n    56→  /** Continue to next batch after reviewing current one */\n    57→  continueToNextBatch: () => Promise<void>;\n    58→  /** Auto-continue all remaining batches without per-batch review */\n    59→  autoContineAll: () => Promise<void>;\n    60→  /** Toggle accept/reject for a specific entity patch */\n    61→  togglePatchDecision: (entityId: string, accepted: boolean) => Promise<void>;\n    62→  /** Apply all accepted patches and close the session */\n    63→  applyAccepted: () => SummaryRevisionPatch[];\n    64→  /** Cancel the current session */\n    65→  cancelRevision: () => void;\n    66→}\n    67→\n    68→// ============================================================================\n    69→// Constants\n    70→// ============================================================================\n    71→\n    72→const POLL_INTERVAL_MS = 1500;\n    73→const BATCH_SIZE = 18; // Target 15-20, use 18 as default\n    74→\n    75→// ============================================================================\n    76→// Batch Grouping\n    77→// ============================================================================"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"1d01d869-3955-4b2a-8c4e-b024be6242cc"}
