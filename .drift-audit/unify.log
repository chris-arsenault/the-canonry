{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011gCwQWfdvymwQHmmacaPNk","type":"tool_result","content":"     1→/**\n     2→ * CategorySection - Collapsible section for grouping items by category\n     3→ */\n     4→\n     5→import React from 'react';\n     6→import PropTypes from 'prop-types';\n     7→\n     8→/**\n     9→ * @param {Object} props\n    10→ * @param {string} [props.id] - Optional category identifier\n    11→ * @param {string} props.icon - Emoji icon for the category\n    12→ * @param {string} props.label - Category label\n    13→ * @param {Array} props.items - Items in this category\n    14→ * @param {boolean} props.expanded - Whether the section is expanded\n    15→ * @param {Function} props.onToggleExpand - Callback to toggle expansion\n    16→ * @param {boolean} props.allEnabled - Whether all items are enabled\n    17→ * @param {Function} props.onToggleAll - Callback to toggle all items\n    18→ * @param {Function} props.renderItem - Render function for each item\n    19→ * @param {string} [props.gridClassName] - Custom grid class name\n    20→ * @param {string} [props.className] - Additional class names\n    21→ */\n    22→export function CategorySection({\n    23→  id: _id,\n    24→  icon,\n    25→  label,\n    26→  items,\n    27→  expanded,\n    28→  onToggleExpand,\n    29→  allEnabled,\n    30→  onToggleAll,\n    31→  renderItem,\n    32→  gridClassName = 'list-grid',\n    33→  className = '',\n    34→}) {\n    35→  return (\n    36→    <div className={`category-section ${className}`.trim()}>\n    37→      <div className=\"category-header\" onClick={onToggleExpand} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") onToggleExpand(e); }} >\n    38→        <span className={`category-expand ${expanded ? 'category-expand-open' : ''}`}>\n    39→          &gt;\n    40→        </span>\n    41→        <span className=\"category-icon\">{icon}</span>\n    42→        <span className=\"category-title\">{label}</span>\n    43→        <span className=\"badge-count\">{items.length}</span>\n    44→        <button\n    45→          className={`btn-toggle-category ${allEnabled ? 'btn-toggle-category-active' : ''}`}\n    46→          onClick={(e) => {\n    47→            e.stopPropagation();\n    48→            onToggleAll();\n    49→          }}\n    50→        >\n    51→          {allEnabled ? 'All On' : 'All Off'}\n    52→        </button>\n    53→      </div>\n    54→      {expanded && (\n    55→        <div className={gridClassName}>\n    56→          {items.map(renderItem)}\n    57→        </div>\n    58→      )}\n    59→    </div>\n    60→  );\n    61→}\n    62→\n    63→export default CategorySection;\n    64→\n    65→CategorySection.propTypes = {\n    66→  id: PropTypes.string,\n    67→  icon: PropTypes.string,\n    68→  label: PropTypes.string.isRequired,\n    69→  items: PropTypes.array.isRequired,\n    70→  expanded: PropTypes.bool.isRequired,\n    71→  onToggleExpand: PropTypes.func.isRequired,\n    72→  allEnabled: PropTypes.bool,\n    73→  onToggleAll: PropTypes.func,\n    74→  renderItem: PropTypes.func.isRequired,\n    75→  gridClassName: PropTypes.string,\n    76→  className: PropTypes.string,\n    77→};\n    78→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"c4ce4d44-2467-4b13-9940-ec8d7fc3d29b"}
