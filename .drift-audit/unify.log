{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013CqUqZWaFeoAoQvy3n7KJ1","type":"tool_result","content":"     1→import { defineConfig } from 'vite';\n     2→import react from '@vitejs/plugin-react';\n     3→import { federation } from '@module-federation/vite';\n     4→import { copyFileSync, mkdirSync, readdirSync } from 'node:fs';\n     5→import { join, resolve } from 'node:path';\n     6→import { federationOnWarn, sharedDeps } from '../../../config/federation.js';\n     7→\n     8→// Lore Weave is an MFE remote for The Canonry shell.\n     9→// To use Lore Weave, run The Canonry (apps/canonry/webui).\n    10→\n    11→export default defineConfig({\n    12→  resolve: {\n    13→    alias: {\n    14→      '@lib': resolve(__dirname, '../lib'),\n    15→    },\n    16→  },\n    17→  plugins: [\n    18→    react(),\n    19→    federation({\n    20→      name: 'loreWeave',\n    21→      filename: 'remoteEntry.js',\n    22→      manifest: true,\n    23→      exposes: {\n    24→        './LoreWeaveRemote': './src/LoreWeaveRemote.jsx',\n    25→        './SimulationTraceVisx': './src/components/dashboard/trace/SimulationTraceVisx.jsx',\n    26→      },\n    27→      shared: sharedDeps(),\n    28→    }),\n    29→    {\n    30→      name: 'copy-lore-weave-schemas',\n    31→      apply: 'build',\n    32→      closeBundle() {\n    33→        const sourceDir = resolve(__dirname, '../lib/schemas');\n    34→        const targetDir = resolve(__dirname, 'dist/schemas');\n    35→        mkdirSync(targetDir, { recursive: true });\n    36→        for (const file of readdirSync(sourceDir)) {\n    37→          if (!file.endsWith('.schema.json')) continue;\n    38→          copyFileSync(join(sourceDir, file), join(targetDir, file));\n    39→        }\n    40→      },\n    41→    },\n    42→  ],\n    43→  // Base path - use /lore-weave/ in dev (via proxy) and production\n    44→  base: '/lore-weave/',\n    45→  build: {\n    46→    target: 'esnext',\n    47→    minify