{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012CVn9JPxfhMPzZnnpKxRAr","type":"tool_result","content":"     1→import { useState, useCallback, useEffect, useRef } from \"react\";\n     2→\n     3→const DEFAULT_WORLD_CONTEXT = {\n     4→  name: \"\",\n     5→  description: \"\",\n     6→  toneFragments: { core: \"\" },\n     7→  canonFactsWithMetadata: [],\n     8→  factSelection: {},\n     9→  worldDynamics: [],\n    10→};\n    11→\n    12→export default function useWorldContextSync({ externalWorldContext, onWorldContextChange }) {\n    13→  const [localWorldContext, setLocalWorldContext] = useState(DEFAULT_WORLD_CONTEXT);\n    14→  const worldContext = localWorldContext;\n    15→  const worldContextSyncTimeoutRef = useRef(null);\n    16→  const worldContextDirtyRef = useRef(false);\n    17→  const pendingWorldContextRef = useRef(localWorldContext);\n    18→\n    19→  // Detect external context changes during render (no ref access)\n    20→  const [prevExternalContext, setPrevExternalContext] = useState(externalWorldContext);\n    21→  if (externalWorldContext !== prevExternalContext) {\n    22→    setPrevExternalContext(externalWorldContext);\n    23→    if (externalWorldContext !== undefined) {\n    24→      const nextContext = externalWorldContext || DEFAULT_WORLD_CONTEXT;\n    25→      setLocalWorldContext(nextContext);\n    26→    }\n    27→  }\n    28→\n    29→  // Ref side effects when external changes (clear timeout, update refs)\n    30→  useEffect(() => {\n    31→    if (externalWorldContext === undefined) return;\n    32→    if (worldContextSyncTimeoutRef.current) {\n    33→      clearTimeout(worldContextSyncTimeoutRef.current);\n    34→      worldContextSyncTimeoutRef.current = null;\n    35→    }\n    36→    worldContextDirtyRef.current = false;\n    37→    pendingWorldContextRef.current = externalWorldContext || DEFAULT_WORLD_CONTEXT;\n    38→  }, [externalWorldContext]);\n    39→\n    40→  const updateWorldContext = useCallback(\n    41→    (updates) => {\n    42→      setLocalWorldContext((prev) => {\n    43→        const merged = { ...prev, ...updates };\n    44→        pendingWorldContextRef.current = merged;\n    45→        if (onWorldContextChange) {\n    46→          worldContextDirtyRef.current = true;\n    47→          if (worldContextSyncTimeoutRef.current) {\n    48→            clearTimeout(worldContextSyncTimeoutRef.current);\n    49→          }\n    50→          worldContextSyncTimeoutRef.current = setTimeout(() => {\n    51→            if (!worldContextDirtyRef.current) return;\n    52→            worldContextDirtyRef.current = false;\n    53→            onWorldContextChange(pendingWorldContextRef.current);\n    54→            worldContextSyncTimeoutRef.current = null;\n    55→          }, 300);\n    56→        }\n    57→        return merged;\n    58→      });\n    59→    },\n    60→    [onWorldContextChange]\n    61→  );\n    62→\n    63→  useEffect(() => {\n    64→    return () => {\n    65→      if (worldContextSyncTimeoutRef.current) {\n    66→        clearTimeout(worldContextSyncTimeoutRef.current);\n    67→        worldContextSyncTimeoutRef.current = null;\n    68→      }\n    69→      if (worldContextDirtyRef.current && onWorldContextChange) {\n    70→        onWorldContextChange(pendingWorldContextRef.current);\n    71→      }\n    72→    };\n    73→  }, [onWorldContextChange]);\n    74→\n    75→  return { worldContext, updateWorldContext };\n    76→}\n    77→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"9f62beb4-0885-4839-be08-ca67173ef700"}
