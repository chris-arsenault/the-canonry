cursor: pointer;\n}\n\n.cip-filter-count {\n  margin-left: auto;\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Image grid area */\n.cip-grid-area {\n  padding: 16px;\n  max-height: 450px;\n  overflow-y: auto;\n}\n\n.cip-empty-state {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.cip-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\n  gap: 12px;\n}\n\n/* Image card */\n.cip-image-card {\n  position: relative;\n  aspect-ratio: 1;\n  border-radius: 8px;\n  overflow: hidden;\n  cursor: pointer;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n}\n\n.cip-image-card-selected {\n  border: 3px solid #3b82f6;\n}\n\n.cip-image-card-current {\n  border: 3px solid #10b981;\n}\n\n.cip-current-badge {\n  position: absolute;\n  top: 4px;\n  left: 4px;\n  padding: 2px 6px;\n  background: #10b981;\n  color: white;\n  font-size: 9px;\n  font-weight: 600;\n  border-radius: 4px;\n}\n\n.cip-date-overlay {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 4px 6px;\n  background: linear-gradient(transparent, rgb(0 0 0 / 70%));\n  font-size: 10px;\n  color: white;\n}\n\n/* Load more */\n.cip-load-more-wrapper {\n  text-align: center;\n  margin-top: 16px;\n}\n\n.cip-load-more-btn {\n  padding: 8px 20px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  font-size: 12px;\n}\n\n.cip-load-more-btn:not(:disabled) {\n  cursor: pointer;\n  opacity: 1;\n}\n\n.cip-load-more-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n/* Footer */\n.cip-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 12px 16px;\n  border-top: 1px solid var(--border-color);\n}\n\n.cip-cancel-btn {\n  padding: 8px 16px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-size: 12px;\n}\n\n.cip-select-btn {\n  padding: 8px 16px;\n  border: none;\n  border-radius: 6px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.cip-select-btn-active {\n  background: #3b82f6;\n  color: white;\n  cursor: pointer;\n}\n\n.cip-select-btn-disabled {\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n  cursor: not-allowed;\n}\n","numLines":192,"startLine":1,"totalLines":192}}}
