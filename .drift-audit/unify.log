{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014cNvXEqKE7orsBaaXBV4Yd","type":"tool_result","content":"     1→/**\n     2→ * ModalShell - Shared modal container with overlay, header, optional tabs, and close button\n     3→ *\n     4→ * Supports two modes:\n     5→ * - Simple mode: Just renders children in the body\n     6→ * - Tabbed mode: Renders a sidebar with tabs when `tabs` prop is provided\n     7→ */\n     8→\n     9→import React, { useRef, useEffect, useCallback } from 'react';\n    10→\n    11→interface ModalShellTab {\n    12→  id: string;\n    13→  icon?: string;\n    14→  label: string;\n    15→}\n    16→\n    17→interface ModalShellProps {\n    18→  onClose: () => void;\n    19→  icon?: string;\n    20→  title: string;\n    21→  disabled?: boolean;\n    22→  tabs?: ModalShellTab[];\n    23→  activeTab?: string;\n    24→  onTabChange?: (tabId: string) => void;\n    25→  renderTabBadge?: (tabId: string) => React.ReactNode;\n    26→  sidebarFooter?: React.ReactNode;\n    27→  children?: React.ReactNode;\n    28→  className?: string;\n    29→  preventOverlayClose?: boolean;\n    30→  footer?: React.ReactNode;\n    31→}\n    32→\n    33→/**\n    34→ * @param {Object} props\n    35→ * @param {Function} props.onClose - Called when overlay or close button is clicked\n    36→ * @param {string} props.icon - Icon to show in header\n    37→ * @param {string} props.title - Modal title\n    38→ * @param {boolean} [props.disabled] - Whether to show disabled badge\n    39→ * @param {Array<{id: string, icon: string, label: string}>} [props.tabs] - Tab definitions (optional)\n    40→ * @param {string} [props.activeTab] - Currently active tab ID\n    41→ * @param {Function} [props.onTabChange] - Called when tab changes\n    42→ * @param {Function} [props.renderTabBadge] - Optional function to render badge for each tab: (tabId) => ReactNode\n    43→ * @param {React.ReactNode} [props.sidebarFooter] - Optional content to render at bottom of sidebar\n    44→ * @param {React.ReactNode} props.children - Modal content (tab content if tabs provided, otherwise full body)\n    45→ * @param {string} [props.className] - Additional class for modal container\n    46→ * @param {boolean} [props.preventOverlayClose] - Disable overlay click and Escape key close\n    47→ * @param {React.ReactNode} [props.footer] - Optional footer content\n    48→ */\n    49→export function ModalShell({\n    50→  onClose,\n    51→  icon,\n    52→  title,\n    53→  disabled,\n    54→  tabs,\n    55→  activeTab,\n    56→  onTabChange,\n    57→  renderTabBadge,\n    58→  sidebarFooter,\n    59→  children,\n    60→  className = '',\n    61→  preventOverlayClose = false,\n    62→  footer,\n    63→}: ModalShellProps) {\n    64→  const hasTabs = tabs && tabs.length > 0;\n    65→  const mouseDownOnOverlay = useRef(false);\n    66→\n    67→  // Escape key handler\n    68→  const handleKeyDown = useCallback((e) => {\n    69→    if (e.key === 'Escape' && !preventOverlayClose) {\n    70→      onClose();\n    71→    }\n    72→  }, [onClose, preventOverlayClose]);\n    73→\n    74→  useEffect(() => {\n    75→    document.addEventListener('keydown', handleKeyDown);\n    76→    return () => document.removeEventListener('keydown', handleKeyDown);\n    77→  }, [handleKeyDown]);\n    78→\n    79→  // Body scroll lock\n    80→  useEffect(() => {\n    81→    const prev = document.body.style.overflow;\n    82→    document.body.style.overflow = 'hidden';\n    83→    return () => { document.body.style.overflow = prev; };\n    84→  }, []);\n    85→\n    86→  const handleOverlayMouseDown = (e) => {\n    87→    mouseDownOnOverlay.current = e.target === e.currentTarget;\n    88→  };\n    89→\n    90→  const handleOverlayClick = (e) => {\n    91→    if (!preventOverlayClose && mouseDownOnOverlay.current && e.target === e.currentTarget) {\n    92→      onClose();\n    93→    }\n    94→  };\n    95→\n    96→  return (\n    97→    <div className=\"modal-overlay\" onMouseDown={handleOverlayMouseDown} onClick={handleOverlayClick} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }} >\n    98→      <div className={`modal ${className}`.trim()} onClick={(e) => e.stopPropagation()} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }} >\n    99→        <div className=\"modal-header\">\n   100→          <div className=\"modal-title\">\n   101→            {icon && <span className=\"modal-title-icon\">{icon}</span>}\n   102→            <span>{title}</span>\n   103→            {disabled && <span className=\"badge badge-orphan\">Disabled</span>}\n   104→          </div>\n   105→          <button className=\"btn-close\" onClick={onClose}>×</button>\n   106→        </div>\n   107→        <div className=\"modal-body\">\n   108→          {hasTabs ? (\n   109→            <>\n   110→              <div className=\"modal-sidebar\">\n   111→                {tabs.map((tab) => (\n   112→                  <button\n   113→                    key={tab.id}\n   114→                    className={`btn-tab ${activeTab === tab.id ? 'btn-tab-active' : ''}`}\n   115→                    onClick={() => onTabChange?.(tab.id)}\n   116→                  >\n   117→                    <span className=\"btn-tab-icon\">{tab.icon}</span>\n   118→                    <span>{tab.label}</span>\n   119→                    {renderTabBadge?.(tab.id)}\n   120→                  </button>\n   121→                ))}\n   122→                {sidebarFooter}\n   123→              </div>\n   124→              <div className=\"modal-content\">{children}</div>\n   125→            </>\n   126→          ) : (\n   127→            children\n   128→          )}\n   129→        </div>\n   130→        {footer && <div className=\"modal-footer\">{footer}</div>}\n   131→      </div>\n   132→    </div>\n   133→  );\n   134→}\n   135→\n   136→"}]},"parent_tool_use_id":"t