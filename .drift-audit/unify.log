{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01LkA9SZ4YeZ4xDMMD2ufquR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FLTnkeSzpw1sU31ZFbDEYG","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/eslint-rules/no-archivist-section-drift.js","content":"// drift-generated\n/**\n * ESLint rule: no-archivist-section-drift\n *\n * Detects archivist component TSX files that import a component CSS file\n * but do NOT import archivist-section.css. This prevents new archivist\n * content-section components from re-declaring structural properties\n * that should come from the shared base.\n *\n * Also warns if archivist section components don't use the shared class names.\n *\n * See docs/adr/032-archivist-section-css-consolidation.md\n */\nexport default {\n  meta: {\n    type: \"suggestion\",\n    docs: {\n      description:\n        \"Archivist content-section components must import archivist-section.css \" +\n        \"and use shared structural classes instead of re-declaring header/icon/title/narrative styles.\",\n    },\n    messages: {\n      missingBaseImport:\n        \"This archivist component imports a component CSS file but not archivist-section.css. \" +\n        \"Content-section components should import './archivist-section.css' and use shared \" +\n        \"structural classes (.archivist-section, .archivist-section-hdr, .archivist-section-icon, \" +\n        \".archivist-section-title, .archivist-narrative). \" +\n        \"See docs/patterns/archivist-section.md\",\n      missingSharedClass:\n        \"This archivist component uses a component-specific class '{{className}}' that duplicates \" +\n        \"a shared structural class. Use '{{sharedClass}}' instead (alongside any component-specific class). \" +\n        \"See docs/patterns/archivist-section.md\",\n    },\n    schema: [],\n  },\n\n  create(context) {\n    const filename = context.filename || context.getFilename();\n\n    // Only applies to archivist component files\n    if (!filename.includes(\"archivist\") || !filename.includes(\"/components/\")) return {};\n    // Skip the shared base file itself\n    if (filename.endsWith(\"archivist-section.css\") || filename.endsWith(\"archivist-section.tsx\")) {\n      return {};\n    }\n    // Only check TSX/JSX files\n    if (!filename.endsWith(\".tsx\") && !filename.endsWith(\".jsx\")) return {};\n\n    let hasComponentCssImport = false;\n    let hasBaseImport = false;\n\n    // Patterns that indicate a content-section component (imports a local CSS file)\n    const componentCssPattern = /^\\.\\/\\w+\\.css$/;\n\n    // Shared class names that should NOT be re-invented\n    const sharedClassMap = {\n      // Common patterns where component-specific names duplicate shared structure\n      header: \"archivist-section-hdr\",\n      icon: \"archivist-section-icon\",\n      title: \"archivist-section-title\",\n    };\n\n    return {\n      ImportDeclaration(node) {\n        const source = node.source.value;\n        if (source === \"./archivist-section.css\") {\n          hasBaseImport = true;\n        }\n        if (componentCssPattern.test(source) && source !== \"./archivist-section.css\") {\n          hasComponentCssImport = true;\n        }\n      },\n\n      \"Program:exit\"(node) {\n        // If the file imports a component CSS but not the shared base, warn\n        if (hasComponentCssImport && !hasBaseImport) {\n          // Find the component CSS import to attach the warning to\n          const imports = node.body.filter(\n            (n) =>\n              n.type === \"ImportDeclaration\" &&\n              n.source.value.endsWith(\".css\") &&\n              n.source.value !== \"./archivist-section.css\",\n          );\n          if (imports.length > 0) {\n            context.report({\n              node: imports[0],\n              messageId: \"missingBaseImport\",\n            });\n          }\n        }\n      },\n    };\n  },\n};\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":508,"cache_read_input_tokens":107033,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":508},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"5237472e-f21f-4be0-8cab-158913d649d2"}
