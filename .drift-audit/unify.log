{\n   610→  font-size: 12px;\n   611→  line-height: 1.6;\n   612→  color: var(--text-secondary);\n   613→  padding: 10px 12px;\n   614→  background: var(--bg-tertiary);\n   615→  border-radius: 6px;\n   616→  border-left: 3px solid #06b6d4;\n   617→  white-space: pre-wrap;\n   618→}\n   619→\n   620→/* Temporal check report */\n   621→.ref-tab-temporal-report {\n   622→  margin-top: 12px;\n   623→  background: var(--bg-tertiary);\n   624→  border: 1px solid var(--border-color);\n   625→  border-radius: 8px;\n   626→  overflow: hidden;\n   627→}\n   628→\n   629→.ref-tab-temporal-report-header {\n   630→  padding: 10px 12px;\n   631→  border-bottom: 1px solid var(--border-color);\n   632→  display: flex;\n   633→  justify-content: space-between;\n   634→  align-items: center;\n   635→}\n   636→\n   637→.ref-tab-temporal-report-title {\n   638→  font-size: 12px;\n   639→  font-weight: 500;\n   640→}\n   641→\n   642→.ref-tab-temporal-report-actions {\n   643→  display: flex;\n   644→  gap: 8px;\n   645→  align-items: center;\n   646→}\n   647→\n   648→.ref-tab-temporal-report-date {\n   649→  font-size: 10px;\n   650→  color: var(--text-muted);\n   651→}\n   652→\n   653→.ref-tab-temporal-export-btn {\n   654→  padding: 2px 6px;\n   655→  background: var(--bg-secondary);\n   656→  border: 1px solid var(--border-color);\n   657→  border-radius: 4px;\n   658→  color: var(--text-muted);\n   659→  cursor: pointer;\n   660→  font-size: 10px;\n   661→}\n   662→\n   663→.ref-tab-temporal-report-body {\n   664→  padding: 12px;\n   665→  max-height: 300px;\n   666→  overflow-y: auto;\n   667→  font-size: 12px;\n   668→  line-height: 1.7;\n   669→  white-space: pre-wrap;\n   670→  color: var(--text-primary);\n   671→}\n   672→\n   673→.ref-tab-rating-symbol {\n   674→  font-weight: 600;\n   675→}\n   676→\n   677→.ref-tab-rating-integral {\n   678→  color: #10b981;\n   679→}\n   680→\n   681→.ref-tab-rating-prevalent {\n   682→  color: #3b82f6;\n   683→}\n   684→\n   685→.ref-tab-rating-mentioned {\n   686→  color: #f59e0b;\n   687→}\n   688→\n   689→.ref-tab-rating-missing {\n   690→  color: var(--text-muted);\n   691→}\n   692→\n   693→.ref-tab-fcg-entry-highlight {\n   694→  background: rgba(59, 130, 246, 0.12);\n   695→  border-radius: 3px;\n   696→}\n   697→\n   698→.ref-tab-fcg-included-yes {\n   699→  color: #10b981;\n   700→}\n   701→\n   702→.ref-tab-fcg-included-no {\n   703→  color: var(--text-muted);\n   704→}\n   705→\n   706→.ref-tab-fcg-legend-symbol {\n   707→  font-weight: 600;\n   708→  color: var(--ref-legend-color, var(--text-muted));\n   709→}\n   710→\n   711→.ref-tab-fcg-legend-yes {\n   712→  color: #10b981;\n   713→}\n   714→\n   715→.ref-tab-fcg-legend-no {\n   716→  color: var(--text-muted);\n   717→}\n   718→\n   719→.ref-tab-fcg-entry-dynamic {\n   720→  background: var(--ref-entry-bg);\n   721→  border-radius: var(--ref-entry-radius);\n   722→}\n   723→\n   724→.ref-tab-fcg-symbol-dynamic {\n   725→  color: var(--ref-symbol-color, var(--text-muted));\n   726→}\n   727→\n   728→.ref-tab-fcv-symbol-dynamic {\n   729→  color: var(--ref-symbol-color, var(--text-muted));\n   730→}\n   731→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"d1ef7390-49bf-49f9-9440-7b608d8160e3","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/chronicle-workspace/ReferenceTab.css","content":"/* ReferenceTab.css — co-located styles for ReferenceTab.jsx */\n\n/* ============================================================================\n * PerspectiveSynthesisViewer\n * ============================================================================ */\n\n.ref-tab-synth {\n  margin-bottom: 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.ref-tab-synth-header {\n  padding: 12px 16px;\n  background: var(--bg-tertiary);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n}\n\n.ref-tab-synth-header-expanded {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.ref-tab-synth-toggle {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.ref-tab-synth-title {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.ref-tab-synth-meta {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-left: auto;\n}\n\n.ref-tab-synth-body {\n  padding: 16px;\n}\n\n/* Tabs */\n.ref-tab-synth-tabs {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n\n.ref-tab-synth-tab-btn {\n  padding: 6px 14px;\n  font-size: 12px;\n  font-weight: 400;\n  background: var(--bg-tertiary);\n  color: var(--text-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.ref-tab-synth-tab-btn-active {\n  font-weight: 600;\n  background: var(--accent-primary);\n  color: white;\n}\n\n/* Section heading (reused across many sections) */\n.ref-tab-section-heading {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.ref-tab-section-heading-mb8 {\n  margin-bottom: 8px;\n}\n\n/* Section wrapper */\n.ref-tab-section {\n  margin-bottom: 16px;\n}\n\n/* Text blocks */\n.ref-tab-text {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.ref-tab-text-brief {\n  font-size: 12px;\n  line-height: 1.6;\n  color: var(--text-primary);\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  white-space: pre-wrap;\n}\n\n/* Vertical list */\n.ref-tab-vlist {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.ref-tab-vlist-tight {\n  gap: 6px;\n}\n\n/* Card items (facets, directives, voice entries, entities, facts, dynamics, cultures) */\n.ref-tab-card {\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n}\n\n.ref-tab-card-accent-left {\n  border-left: 3px solid var(--accent-color);\n}\n\n.ref-tab-card-accent-secondary {\n  border-left: 3px solid var(--accent-secondary, #8b5cf6);\n}\n\n.ref-tab-card-accent-tertiary {\n  border-left: 3px solid var(--accent-tertiary, #f59e0b);\n}\n\n.ref-tab-card-accent-green {\n  border-left: 3px solid #10b981;\n}\n\n.ref-tab-card-accent-cyan {\n  border-left: 3px solid #06b6d4;\n}\n\n.ref-tab-card-id {\n  font-size: 11px;\n  font-family: monospace;\n  color: var(--accent-color);\n  margin-bottom: 4px;\n}\n\n.ref-tab-card-body {\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n.ref-tab-card-heading {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--accent-secondary, #8b5cf6);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n}\n\n.ref-tab-card-heading-tertiary {\n  color: var(--accent-tertiary, #f59e0b);\n}\n\n.ref-tab-card-heading-cyan {\n  color: #06b6d4;\n}\n\n/* Motifs */\n.ref-tab-motifs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.ref-tab-motif {\n  padding: 4px 10px;\n  background: var(--bg-tertiary);\n  border-radius: 12px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  font-style: italic;\n}\n\n/* Metadata footer */\n.ref-tab-synth-footer {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n  border-top: 1px solid var(--border-color);\n  padding-top: 12px;\n  margin-top: 8px;\n}\n\n/* Input tab specific */\n.ref-tab-card-style {\n  font-size: 12px;\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border-left: 3px solid var(--accent-secondary, #8b5cf6);\n}\n\n.ref-tab-card-name {\n  font-weight: 500;\n}\n\n.ref-tab-card-inline-meta {\n  margin-left: 8px;\n  font-size: 11px;\n  color: var(--text-muted);\n  font-family: monospace;\n}\n\n.ref-tab-card-sub {\n  margin-top: 6px;\n  font-size: 11px;\n  color: var(--text-secondary);\n}\n\n/* Entity entry */\n.ref-tab-entity {\n  padding: 8px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.ref-tab-entity-name {\n  font-weight: 500;\n  color: var(--text-primary);\n}\n\n.ref-tab-entity-meta {\n  font-weight: 400;\n  color: var(--text-muted);\n}\n\n.ref-tab-entity-summary {\n  color: var(--text-secondary);\n  margin-top: 4px;\n  font-size: 11px;\n}\n\n/* Fact entry */\n.ref-tab-fact {\n  padding: 8px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.ref-tab-fact-constraint {\n  border-left: 3px solid #f59e0b;\n}\n\n.ref-tab-fact-normal {\n  border-left: 3px solid var(--accent-color);\n}\n\n.ref-tab-fact-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 4px;\n}\n\n.ref-tab-fact-id {\n  font-family: monospace;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.ref-tab-fact-badge {\n  padding: 2px 6px;\n  background: rgb(245 158 11 / 15%);\n  color: #f59e0b;\n  font-size: 10px;\n  border-radius: 4px;\n}\n\n.ref-tab-fact-text {\n  color: var(--text-secondary);\n}\n\n/* Culture identity */\n.ref-tab-culture {\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n}\n\n.ref-tab-culture-name {\n  font-weight: 500;\n  font-size: 12px;\n  margin-bottom: 6px;\n  color: var(--text-primary);\n}\n\n.ref-tab-culture-traits {\n  font-size: 11px;\n  color: var(--text-secondary);\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.ref-tab-culture-trait-key {\n  color: var(--text-muted);\n}\n\n/* Constellation analysis */\n.ref-tab-constellation {\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.ref-tab-constellation-row {\n  margin-bottom: 8px;\n}\n\n.ref-tab-constellation-row:last-child {\n  margin-bottom: 0;\n}\n\n/* ============================================================================\n * FactCoverageGrid\n * ============================================================================ */\n\n.ref-tab-fcg {\n  margin-bottom: 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  padding: 12px 16px;\n}\n\n.ref-tab-fcg-header {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.ref-tab-fcg-title {\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.ref-tab-fcg-legend {\n  font-size: 10px;\n  color: var(--text-muted);\n  display: flex;\n  gap: 10px;\n}\n\n.ref-tab-fcg-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 0 16px;\n}\n\n.ref-tab-fcg-entry {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 4px;\n  font-size: 11px;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.ref-tab-fcg-symbol {\n  font-weight: 600;\n  flex-shrink: 0;\n}\n\n.ref-tab-fcg-fact-id {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.ref-tab-fcg-included {\n  flex-shrink: 0;\n  font-size: 10px;\n}\n\n/* ============================================================================\n * FactCoverageViewer\n * ============================================================================ */\n\n.ref-tab-fcv {\n  margin-bottom: 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.ref-tab-fcv-header {\n  padding: 12px 16px;\n  background: var(--bg-tertiary);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n}\n\n.ref-tab-fcv-header-expanded {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.ref-tab-fcv-body {\n  padding: 12px 16px;\n}\n\n.ref-tab-fcv-entry {\n  padding: 6px 0;\n  border-bottom: 1px solid var(--border-color);\n  font-size: 12px;\n}\n\n.ref-tab-fcv-entry-row {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n}\n\n.ref-tab-fcv-symbol {\n  font-weight: 600;\n  flex-shrink: 0;\n}\n\n.ref-tab-fcv-fact-text {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  flex: 1;\n}\n\n.ref-tab-fcv-faceted {\n  color: #8b7355;\n  font-size: 11px;\n  flex-shrink: 0;\n}\n\n.ref-tab-fcv-evidence {\n  font-size: 11px;\n  color: var(--text-muted);\n  font-style: italic;\n  margin-top: 2px;\n  margin-left: 20px;\n}\n\n.ref-tab-fcv-meta {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-top: 8px;\n  text-align: right;\n}\n\n/* ============================================================================\n * TemporalContextEditor\n * ============================================================================ */\n\n.ref-tab-temporal {\n  margin-bottom: 16px;\n  padding: 16px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 1px solid var(--border-color);\n}\n\n.ref-tab-temporal-title {\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 12px;\n}\n\n.ref-tab-temporal-empty {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.ref-tab-temporal-controls {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  align-items: center;\n}\n\n.ref-tab-temporal-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.ref-tab-temporal-select {\n  padding: 6px 10px;\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  font-size: 12px;\n  min-width: 200px;\n}\n\n.ref-tab-temporal-update-btn {\n  padding: 6px 12px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n}\n\n.ref-tab-temporal-update-btn-disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.ref-tab-temporal-update-btn-enabled {\n  cursor: pointer;\n  opacity: 1;\n}\n\n.ref-tab-temporal-info {\n  margin-top: 10px;\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.ref-tab-temporal-info-label {\n  color: var(--text-muted);\n}\n\n/* Timeline area */\n.ref-tab-temporal-timeline {\n  margin-top: 16px;\n}\n\n.ref-tab-temporal-timeline-heading {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--text-muted);\n 