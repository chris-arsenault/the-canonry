{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qp3LXeT82Uod6UbLECBsrV","type":"tool_result","content":"     1→/**\n     2→ * ItemRow - Flexible row layout for list items with remove button\n     3→ *\n     4→ * Provides consistent styling for rows in item lists with:\n     5→ * - Name/label on left\n     6→ * - Custom controls in middle (passed as children)\n     7→ * - Remove button on right\n     8→ */\n     9→\n    10→import React from 'react';\n    11→import PropTypes from 'prop-types';\n    12→\n    13→/**\n    14→ * @param {Object} props\n    15→ * @param {string} props.name - Display name\n    16→ * @param {boolean} [props.muted] - Apply muted styling to name\n    17→ * @param {Function} [props.onRemove] - Called when remove button clicked\n    18→ * @param {string} [props.removeTitle] - Tooltip for remove button\n    19→ * @param {React.ReactNode} props.children - Controls to render between name and remove\n    20→ * @param {string} [props.className] - Additional class names\n    21→ */\n    22→export function ItemRow({\n    23→  name,\n    24→  muted,\n    25→  onRemove,\n    26→  removeTitle = 'Remove',\n    27→  children,\n    28→  className = '',\n    29→}) {\n    30→  return (\n    31→    <div className={`item-row ${className}`.trim()}>\n    32→      <span className={`item-row-name ${muted ? 'item-row-name-muted' : ''}`}>\n    33→        {name}\n    34→      </span>\n    35→      {children}\n    36→      {onRemove && (\n    37→        <button\n    38→          className=\"item-row-remove\"\n    39→          onClick={onRemove}\n    40→          title={removeTitle}\n    41→        >\n    42→          ×\n    43→        </button>\n    44→      )}\n    45→    </div>\n    46→  );\n    47→}\n    48→\n    49→ItemRow.propTypes = {\n    50→  name: PropTypes.string.isRequired,\n    51→  muted: PropTypes.bool,\n    52→  onRemove: PropTypes.func,\n    53→  removeTitle: PropTypes.string,\n    54→  children: PropTypes.node,\n    55→  className: PropTypes.string,\n    56→};\n    57→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"321fa8d3-e864-4a86-acef-e68043889b21"}
