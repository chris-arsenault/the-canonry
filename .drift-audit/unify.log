{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BZkQkWGwWSqWheEdeGdaUC","type":"tool_result","content":"     1→import React, { useState, useRef } from \"react\";\n     2→import type { DiscoveryEventLore } from \"../types/world.ts\";\n     3→import \"./DiscoveryStory.css\";\n     4→\n     5→interface DiscoveryStoryProps {\n     6→  lore: DiscoveryEventLore;\n     7→  onExplorerClick?: (explorerId: string) => void;\n     8→  onClose?: () => void; // Optional close handler for modal mode\n     9→  isModal?: boolean; // Whether to render as modal\n    10→}\n    11→\n    12→export default function DiscoveryStory({\n    13→  lore,\n    14→  onExplorerClick,\n    15→  onClose,\n    16→  isModal = false,\n    17→}: Readonly<DiscoveryStoryProps>) {\n    18→  const [expandedSection, setExpandedSection] = useState<\"discovery\" | \"significance\" | null>(\n    19→    \"discovery\"\n    20→  );\n    21→  const mouseDownOnOverlay = useRef(false);\n    22→\n    23→  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    24→    mouseDownOnOverlay.current = e.target === e.currentTarget;\n    25→  };\n    26→\n    27→  const handleOverlayClick = (e: React.MouseEvent) => {\n    28→    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n    29→      onClose?.();\n    30→    }\n    31→  };\n    32→\n    33→  const toggleSection = (section: \"discovery\" | \"significance\") => {\n    34→    setExpandedSection(expandedSection === section ? null : section);\n    35→  };\n    36→\n    37→  // Check if explorer is an entity ID (starts with known prefixes)\n    38→  const isEntityId = lore.metadata.explorer.match(/^(npc_|faction_|location_)/);\n    39→\n    40→  const content = (\n    41→    <div className={`discovery-story ${isModal ? \"discovery-story-modal-content\" : \"\"}`}>\n    42→      <div className=\"discovery-story-header\">\n    43→        <span className=\"discovery-story-icon\">🧭</span>\n    44→        <span className=\"discovery-story-title\">Discovery Story</span>\n    45→      </div>\n    46→\n    47→      <div className=\"discovery-story-meta\">\n    48→        <div className=\"discovery-story-meta-row\">\n    49→          <span className=\"discovery-story-meta-label\">Discovered by:</span>\n    50→          {isEntityId && onExplorerClick ? (\n    51→            <button\n    52→              onClick={() => onExplorerClick(lore.metadata.explorer)}\n    53→              className=\"discovery-story-explorer-link\"\n    54→            >\n    55→              {lore.metadata.explorer}\n    56→            </button>\n    57→          ) : (\n    58→            <span className=\"discovery-story-meta-value\">{lore.metadata.explorer}</span>\n    59→          )}\n    60→        </div>\n    61→        <div className=\"discovery-story-meta-row\">\n    62→          <span className=\"discovery-story-meta-label\">When:</span>\n    63→          <span className=\"discovery-story-meta-value\">Tick {lore.metadata.tick}</span>\n    64→        </div>\n    65→        <div className=\"discovery-story-meta-row\">\n    66→          <span className=\"discovery-story-meta-label\">Method:</span>\n    67→          <span\n    68→            className={`discovery-story-type-badge discovery-story-type-${lore.metadata.discoveryType}`}\n    69→          >\n    70→            {lore.metadata.discoveryType}\n    71→          </span>\n    72→        </div>\n    73→      </div>\n    74→\n    75→      {/* The Discovery */}\n    76→      <div className=\"discovery-story-section\">\n    77→        <button\n    78→          onClick={() => toggleSection(\"discovery\")}\n    79→          className=\"discovery-story-section-header\"\n    80→        >\n    81→          <span className=\"discovery-story-section-icon\">\n    82→            {expandedSection === \"discovery\" ? \"▼\" : \"▶\"}\n    83→          </span>\n    84→          <span className=\"discovery-story-section-title\">The Discovery</span>\n    85→        </button>\n    86→        {expandedSection === \"discovery\" && (\n    87→          <div className=\"discovery-story-section-content\">{lore.text}</div>\n    88→        )}\n    89→      </div>\n    90→\n    91→      {/* Why It Matters */}\n    92→      <div className=\"discovery-story-section\">\n    93→        <button\n    94→          onClick={() => toggleSection(\"significance\")}\n    95→          className=\"discovery-story-section-header\"\n    96→        >\n    97→          <span className=\"discovery-story-section-icon\">\n    98→            {expandedSection === \"significance\" ? \"▼\" : \"▶\"}\n    99→          </span>\n   100→          <span className=\"discovery-story-section-title\">Why It Matters</span>\n   101→        </button>\n   102→        {expandedSection === \"significance\" && (\n   103→          <div className=\"discovery-story-section-content\">{lore.metadata.significance}</div>\n   104→        )}\n   105→      </div>\n   106→\n   107→      {/* Close button for modal mode */}\n   108→      {isModal && onClose && (\n   109→        <div className=\"discovery-story-footer\">\n   110→          <button onClick={onClose} className=\"discovery-story-close\">\n   111→            Close\n   112→          </button>\n   113→        </div>\n   114→      )}\n   115→    </div>\n   116→  );\n   117→\n   118→  // Wrap in modal overlay if in modal mode\n   119→  if (isModal && onClose) {\n   120→    return (\n   121→      <div\n   122→        className=\"discovery-story-overlay\"\n   123→        onMouseDown={handleOverlayMouseDown}\n   124→        onClick={handleOverlayClick}\n   125→        role=\"button\"\n   126→        tabIndex={0}\n   127→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n   128→      >\n   129→        <div>{content}</div>\n   130→      </div>\n   131→    );\n   132→  }\n   133→\n   134→  return content;\n   135→}\n   136→"}]},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"5953f371-a443-455d-8ffa-9dbc38e98265","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/DiscoveryStory.tsx","content":"import React, { useState, useRef } from \"react\";\nimport type { DiscoveryEventLore } from \"../types/world.ts\";\nimport \"./DiscoveryStory.css\";\n\ninterface DiscoveryStoryProps {\n  lore: DiscoveryEventLore;\n  onExplorerClick?: (explorerId: string) => void;\n  onClose?: () => void; // Optional close handler for modal mode\n  isModal?: boolean; // Whether to render as modal\n}\n\nexport default function DiscoveryStory({\n  lore,\n  onExplorerClick,\n  onClose,\n  isModal = false,\n}: Readonly<DiscoveryStoryProps>) {\n  const [expandedSection, setExpandedSection] = useState<\"discovery\" | \"significance\" | null>(\n    \"discovery\"\n  );\n  const mouseDownOnOverlay = useRef(false);\n\n  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    mouseDownOnOverlay.current = e.target === e.currentTarget;\n  };\n\n  const handleOverlayClick = (e: React.MouseEvent) => {\n    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n      onClose?.();\n    }\n  };\n\n  const toggleSection = (section: \"discovery\" | \"significance\") => {\n    setExpandedSection(expandedSection === section ? null : section);\n  };\n\n  // Check if explorer is an entity ID (starts with known prefixes)\n  const isEntityId = lore.metadata.explorer.match(/^(npc_|faction_|location_)/);\n\n  const content = (\n    <div className={`discovery-story ${isModal ? \"discovery-story-modal-content\" : \"\"}`}>\n      <div className=\"discovery-story-header\">\n        <span className=\"discovery-story-icon\">🧭</span>\n        <span className=\"discovery-story-title\">Discovery Story</span>\n      </div>\n\n      <div className=\"discovery-story-meta\">\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"discovery-story-meta-label\">Discovered by:</span>\n          {isEntityId && onExplorerClick ? (\n            <button\n              onClick={() => onExplorerClick(lore.metadata.explorer)}\n              className=\"discovery-story-explorer-link\"\n            >\n              {lore.metadata.explorer}\n            </button>\n          ) : (\n            <span className=\"discovery-story-meta-value\">{lore.metadata.explorer}</span>\n          )}\n        </div>\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"discovery-story-meta-label\">When:</span>\n          <span className=\"discovery-story-meta-value\">Tick {lore.metadata.tick}</span>\n        </div>\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"discovery-story-meta-label\">Method:</span>\n          <span\n            className={`discovery-story-type-badge discovery-story-type-${lore.metadata.discoveryType}`}\n          >\n            {lore.metadata.discoveryType}\n          </span>\n        </div>\n      </div>\n\n      {/* The Discovery */}\n      <div className=\"discovery-story-section\">\n        <button\n          onClick={() => toggleSection(\"discovery\")}\n          className=\"discovery-story-section-header\"\n        >\n          <span className=\"discovery-story-section-icon\">\n            {expandedSection === \"discovery\" ? \"▼\" : \"▶\"}\n          </span>\n          <span className=\"discovery-story-section-title\">The Discovery</span>\n        </button>\n        {expandedSection === \"discovery\" && (\n          <div className=\"discovery-story-section-content\">{lore.text}</div>\n        )}\n      </div>\n\n      {/* Why It Matters */}\n      <div className=\"discovery-story-section\">\n        <button\n          onClick={() => toggleSection(\"significance\")}\n          className=\"discovery-story-section-header\"\n        >\n          <span className=\"discovery-story-section-icon\">\n            {expandedSection === \"significance\" ? \"▼\" : \"▶\"}\n          </span>\n          <span className=\"discovery-story-section-title\">Why It Matters</span>\n        </button>\n        {expandedSection === \"significance\" && (\n          <div className=\"discovery-story-section-content\">{lore.metadata.significance}</div>\n        )}\n      </div>\n\n      {/* Close button for modal mode */}\n      {isModal && onClose && (\n        <div className=\"discovery-story-footer\">\n          <button onClick={onClose} className=\"discovery-story-close\">\n            Close\n          </button>\n        </div>\n      )}\n    </div>\n  );\n\n  // Wrap in modal overlay if in modal mode\n  if (isModal && onClose) {\n    return (\n      <div\n        className=\"discovery-story-overlay\"\n        onMouseDown={handleOverlayMouseDown}\n        onClick={handleOverlayClick}\n        role=\"button\"\n        tabIndex={0}\n        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n      >\n        <div>{content}</div>\n      </div>\n    );\n  }\n\n  return content;\n}\n","numLines":136,"startLine":1,"totalLines":136}}}
