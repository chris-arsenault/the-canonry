 168→\n   169→.cued-empty-state {\n   170→  color: #666;\n   171→  font-size: 14px;\n   172→  text-align: center;\n   173→  padding: 40px;\n   174→}\n   175→\n   176→.cued-no-kinds-warning {\n   177→  color: #f0a500;\n   178→  font-size: 12px;\n   179→  padding: 12px;\n   180→  background-color: rgba(240, 165, 0, 0.1);\n   181→  border-radius: 4px;\n   182→}\n   183→\n   184→.cued-framework-badge {\n   185→  font-size: 10px;\n   186→  color: #94a3b8;\n   187→}\n   188→"}]},"parent_tool_use_id":null,"session_id":"f18789e5-fb86-478f-adf1-eac13368c64f","uuid":"c9f946c5-a30f-4330-9e54-a9d586bd05c8","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/cosmographer/webui/src/components/CultureEditor/CultureEditor.css","content":".cued-container {\n  max-width: 1200px;\n}\n\n.cued-header {\n  margin-bottom: 16px;\n}\n\n.cued-title {\n  font-size: 20px;\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n\n.cued-subtitle {\n  color: #888;\n  font-size: 13px;\n}\n\n.cued-culture-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.cued-culture-card {\n  background-color: #16213e;\n  border-radius: 6px;\n  border: 1px solid #0f3460;\n  overflow: hidden;\n}\n\n.cued-culture-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 14px;\n  cursor: pointer;\n}\n\n.cued-culture-header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.cued-expand-icon {\n  font-size: 10px;\n  color: #888;\n  transition: transform 0.2s;\n  width: 14px;\n  transform: var(--cued-expand-rotation, rotate(0deg));\n}\n\n.cued-color-dot {\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  border: 2px solid #0f3460;\n  background-color: var(--cued-color-dot-bg);\n}\n\n.cued-culture-name {\n  font-weight: 500;\n  font-size: 14px;\n}\n\n.cued-culture-id {\n  color: #666;\n  font-size: 11px;\n}\n\n.cued-culture-summary {\n  font-size: 11px;\n  color: #666;\n}\n\n.cued-culture-body {\n  padding: 12px;\n  border-top: 1px solid #0f3460;\n}\n\n.cued-kinds-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n  gap: 8px;\n}\n\n.cued-kind-card {\n  background-color: #1a1a2e;\n  border-radius: 4px;\n  padding: 10px 12px;\n}\n\n.cued-kind-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n\n.cued-kind-name {\n  font-size: 12px;\n  font-weight: 500;\n  color: #ccc;\n}\n\n.cued-kind-summary {\n  font-size: 10px;\n  color: #666;\n}\n\n.cued-axis-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 4px;\n}\n\n.cued-axis-label {\n  width: 14px;\n  font-size: 10px;\n  font-weight: 600;\n  color: #e94560;\n}\n\n.cued-tag-label {\n  font-size: 9px;\n  color: #666;\n  width: 50px;\n  text-align: right;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.cued-tag-label-right {\n  font-size: 9px;\n  color: #666;\n  width: 50px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.cued-slider {\n  flex: 1;\n  height: 4px;\n  -webkit-appearance: none;\n  background: linear-gradient(to right, #0f3460, #e94560);\n  border-radius: 2px;\n  outline: none;\n  cursor: pointer;\n}\n\n.cued-slider-disabled {\n  opacity: 0.5;\n  pointer-events: none;\n}\n\n.cued-axis-value {\n  width: 24px;\n  text-align: right;\n  font-size: 10px;\n  color: #888;\n  font-family: monospace;\n}\n\n.cued-empty-state {\n  color: #666;\n  font-size: 14px;\n  text-align: center;\n  padding: 40px;\n}\n\n.cued-no-kinds-warning {\n  color: #f0a500;\n  font-size: 12px;\n  padding: 12px;\n  background-color: rgba(240, 165, 0, 0.1);\n  border-radius: 4px;\n}\n\n.cued-framework-badge {\n  font-size: 10px;\n  color: #94a3b8;\n}\n","numLines":188,"startLine":1,"totalLines":188}}}
