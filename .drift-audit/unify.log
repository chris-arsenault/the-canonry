-text-primary);","-  transform: translateY(-1px);","-  box-shadow: var(--shadow-md);"," }"]}],"originalFile":"/* EraNarrative Component Styles */\n\n.era-narrative-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 85%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: var(--z-modal-above);\n  padding: var(--spacing-2xl);\n  animation: fade-in 0.3s ease-out;\n}\n\n@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n.era-narrative-modal {\n  background: var(--gradient-bg-header);\n  border: 3px solid var(--color-bg-gold-border);\n  border-radius: var(--radius-2xl);\n  max-width: 800px;\n  width: 100%;\n  max-height: 85vh;\n  overflow-y: auto;\n  box-shadow: var(--shadow-2xl), var(--shadow-glow-gold);\n  animation: slide-in 0.4s ease-out;\n}\n\n@keyframes slide-in {\n  from {\n    opacity: 0;\n    transform: translateY(-30px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.era-narrative-header {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-xl);\n  padding: var(--spacing-3xl) var(--spacing-4xl);\n  background: var(--color-bg-gold-15);\n  border-bottom: 2px solid var(--color-bg-gold-40);\n}\n\n.era-narrative-icon {\n  font-size: var(--font-size-4xl);\n  line-height: 1;\n  filter: drop-shadow(0 0 8px rgb(251 191 36 / 60%));\n}\n\n.era-narrative-title {\n  font-size: var(--font-size-3xl);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-gold-400);\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  text-align: center;\n  text-shadow: 0 0 20px rgb(251 191 36 / 50%);\n  margin: 0;\n}\n\n.era-narrative-transition {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-xl);\n  padding: var(--spacing-xl) var(--spacing-4xl);\n  background: var(--color-bg-blue-10);\n  border-bottom: 1px solid var(--color-bg-blue-20);\n}\n\n.era-narrative-era {\n  padding: var(--spacing-md) var(--spacing-xl);\n  border-radius: var(--radius-lg);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.era-narrative-era-from {\n  background: var(--color-bg-red-20);\n  border: 1px solid var(--color-bg-red-border);\n  color: var(--color-red-300);\n}\n\n.era-narrative-era-to {\n  background: var(--color-bg-green-20);\n  border: 1px solid var(--color-bg-green-border);\n  color: var(--color-green-300);\n}\n\n.era-narrative-arrow {\n  font-size: var(--font-size-3xl);\n  color: var(--color-blue-400);\n  font-weight: var(--font-weight-bold);\n}\n\n.era-narrative-content {\n  padding: var(--spacing-4xl);\n  font-family: var(--font-serif);\n  font-size: var(--font-size-lg);\n  line-height: 1.9;\n  color: var(--color-indigo-200);\n  font-style: italic;\n  text-align: justify;\n}\n\n.era-narrative-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--spacing-xl) var(--spacing-4xl);\n  border-top: 1px solid var(--color-bg-blue-20);\n  background: var(--color-bg-blue-5);\n}\n\n.era-narrative-tick {\n  font-size: var(--font-size-sm);\n  color: var(--color-blue-400);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.era-narrative-close {\n  padding: var(--spacing-md) var(--spacing-3xl);\n  background: var(--gradient-accent-blue);\n  border: 1px solid var(--color-border-strong);\n  border-radius: var(--radius-md);\n  color: var(--color-blue-200);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n}\n\n.era-narrative-close:hover {\n  background: linear-gradient(135deg, var(--color-bg-blue-40) 0%, var(--color-bg-blue-40) 100%);\n  border-color: var(--color-blue-400);\n  color: var(--color-text-primary);\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-md);\n}\n"}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_0134K9Wu1gSRDLddssBWHZui","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XXyo83KzEvFA12Ew162E12","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/EraNarrative.tsx","content":"import React, { useRef } from \"react\";\nimport type { EraNarrativeLore } from \"../types/world.ts\";\nimport \"./archivist-section.css\";\nimport \"./EraNarrative.css\";\n\ninterface EraNarrativeProps {\n  lore: EraNarrativeLore;\n  onClose: () => void;\n}\n\nexport default function EraNarrative({ lore, onClose }: Readonly<EraNarrativeProps>) {\n  const mouseDownOnOverlay = useRef(false);\n\n  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    mouseDownOnOverlay.current = e.target === e.currentTarget;\n  };\n\n  const handleOverlayClick = (e: React.MouseEvent) => {\n    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n      onClose();\n    }\n  };\n  // Extract title from the text (first sentence or before colon)\n  const titleMatch = lore.text.match(/^([^:.]+)[:.]/) || lore.text.match(/^(.{0,50})/);\n  const title = titleMatch ? titleMatch[1].trim() : \"Era Transition\";\n  const narrative = lore.text;\n\n  return (\n    <div\n      className=\"archivist-modal-overlay era-narrative-overlay\"\n      onMouseDown={handleOverlayMouseDown}\n      onClick={handleOverlayClick}\n      role=\"button\"\n      tabIndex={0}\n      onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n    >\n      <div className=\"era-narrative-modal\">\n        <div className=\"era-narrative-header\">\n          <div className=\"era-narrative-icon\">⚔️</div>\n          <h2 className=\"era-narrative-title\">{title}</h2>\n          <div className=\"era-narrative-icon\">⚔️</div>\n        </div>\n\n        <div className=\"era-narrative-transition\">\n          <span className=\"era-narrative-era era-narrative-era-from\">{lore.metadata.from}</span>\n          <span className=\"era-narrative-arrow\">→</span>\n          <span className=\"era-narrative-era era-narrative-era-to\">{lore.metadata.to}</span>\n        </div>\n\n        <div className=\"archivist-narrative era-narrative-content\">{narrative}</div>\n\n        <div className=\"archivist-section-footer era-narrative-footer\">\n          <span className=\"era-narrative-tick\">Tick {lore.metadata.tick}</span>\n          <button onClick={onClose} className=\"archivist-close-btn era-narrative-close\">\n            Close\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3636,"cache_read_input_tokens":93501,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3636},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"0f101740-0e26-4a02-ae6f-02ce323391f5"}
