4fc;\n    60→\n    61→  /* Canonical overrides for shared-components (accent differs from default theme) */\n    62→  --color-accent: #a855f7;\n    63→  --color-accent-light: #c084fc;\n    64→  --gradient-accent: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);\n    65→}\n    66→\n    67→/* Reset & Base */\n    68→* {\n    69→  margin: 0;\n    70→  padding: 0;\n    71→  box-sizing: border-box;\n    72→}\n    73→\n    74→body {\n    75→  font-family:\n    76→    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    77→    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n    78→  font-size: var(--text-base);\n    79→  line-height: 1.5;\n    80→  background: var(--bg-primary);\n    81→  color: var(--text-color);\n    82→}\n    83→\n    84→/* Illuminator Container */\n    85→.illuminator-container {\n    86→  display: flex;\n    87→  height: 100%;\n    88→  background: var(--bg-primary);\n    89→}\n    90→\n    91→/* Sidebar */\n    92→.illuminator-sidebar {\n    93→  width: 200px;\n    94→  min-width: 200px;\n    95→  background: var(--bg-sidebar);\n    96→  border-right: 1px solid var(--border-color);\n    97→  display: flex;\n    98→  flex-direction: column;\n    99→  padding: var(--space-md);\n   100→}"}]},"parent_tool_use_id":null,"session_id":"f96e591f-9951-4599-91ca-4e5e08bd5234","uuid":"72d25ff7-02bc-445f-aef3-75001d124c3f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/App.css","content":"/* Arctic Blue Theme - Illuminator (with Purple accent for enrichment) */\n:root {\n  /* Backgrounds - Arctic deep blues */\n  --bg-primary: #0a1929;\n  --bg-secondary: #1e3a5f;\n  --bg-tertiary: #2d4a6f;\n  --bg-sidebar: #0c1f2e;\n\n  /* Borders - Blue tinted */\n  --border-color: rgb(59 130 246 / 30%);\n  --border-light: rgb(59 130 246 / 50%);\n\n  /* Text - Ice white tones */\n  --text-color: #fff;\n  --text-secondary: #93c5fd;\n  --text-muted: #60a5fa;\n\n  /* Illuminator accent (purple for enrichment/magic within arctic theme) */\n  --accent-color: #a855f7;\n  --accent-hover: #c084fc;\n\n  /* Arctic theme variables */\n  --arctic-deep: #0a1929;\n  --arctic-dark: #1e3a5f;\n  --arctic-mid: #2d4a6f;\n  --arctic-ice: #3b82f6;\n  --arctic-frost: #60a5fa;\n  --arctic-light: #93c5fd;\n  --purple-accent: #a855f7;\n  --purple-dark: #9333ea;\n\n  /* Consistent spacing scale */\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 12px;\n  --space-lg: 16px;\n  --space-xl: 24px;\n\n  /* Consistent font sizes */\n  --text-xs: 11px;\n  --text-sm: 12px;\n  --text-base: 13px;\n  --text-lg: 14px;\n  --text-xl: 16px;\n  --text-2xl: 20px;\n\n  /* Component colors */\n  --card-bg: var(--bg-secondary);\n  --card-border: var(--border-color);\n  --input-bg: var(--bg-tertiary);\n\n  /* Semantic colors */\n  --danger: #ef4444;\n  --success: #22c55e;\n  --warning: #f59e0b;\n\n  /* Buttons */\n  --button-primary: #a855f7;\n  --button-primary-hover: #c084fc;\n\n  /* Canonical overrides for shared-components (accent differs from default theme) */\n  --color-accent: #a855f7;\n  --color-accent-light: #c084fc;\n  --gradient-accent: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  font-size: var(--text-base);\n  line-height: 1.5;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n/* Illuminator Container */\n.illuminator-container {\n  display: flex;\n  height: 100%;\n  background: var(--bg-primary);\n}\n\n/* Sidebar */\n.illuminator-sidebar {\n  width: 200px;\n  min-width: 200px;\n  background: var(--bg-sidebar);\n  border-right: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  padding: var(--space-md);\n}","numLines":100,"startLine"