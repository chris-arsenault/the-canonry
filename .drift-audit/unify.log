{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ErEuwHtciWVM4q8piM79j","type":"tool_result","content":"     1→/**\n     2→ * EnsembleConstellation - Force-directed graph for role assignment\n     3→ *\n     4→ * Displays candidates as nodes with the entry point at center.\n     5→ * Nodes can be clicked to select, then assigned to roles.\n     6→ * Visual encoding: node color = kind, line thickness = strength,\n     7→ * ring color = era, red glow = overused.\n     8→ */\n     9→\n    10→import React, { useState, useMemo, useCallback, useRef } from \"react\";\n    11→import type { EntityContext, RelationshipContext } from \"../../../lib/chronicleTypes\";\n    12→import type { EntitySelectionMetrics } from \"../../../lib/chronicle/selectionWizard\";\n    13→import \"./EnsembleConstellation.css\";\n    14→\n    15→interface ConstellationNode {\n    16→  id: string;\n    17→  name: string;\n    18→  kind: string;\n    19→  x: number;\n    20→  y: number;\n    21→  isEntryPoint: boolean;\n    22→  isAssigned: boolean;\n    23→  metrics?: EntitySelectionMetrics;\n    24→  eraColor: string;\n    25→}\n    26→\n    27→interface ConstellationEdge {\n    28→  source: string;\n    29→  target: string;\n    30→  strength: number;\n    31→  kind: string;\n    32→}\n    33→\n    34→interface EnsembleConstellationProps {\n    35→  entryPointId: string;\n    36→  candidates: EntityContext[];\n    37→  relationships: RelationshipContext[];\n    38→  assignedEntityIds: Set<string>;\n    39→  metricsMap: Map<string, EntitySelectionMetrics>;\n    40→  /** Currently selected entity (for assignment) */\n    41→  selectedEntityId: string | null;\n    42→  /** Callback when entity is selected */\n    43→  onSelectEntity: (entityId: string | null) => void;\n    44→  width?: number;\n    45→  height?: number;\n    46→  /** Era ID -> color mapping for era rings on nodes */\n    47→  eraColorMap?: Map<string, string>;\n    48→}\n    49→\n    50→// Color mapping for entity kinds\n    51→const KIND_COLORS: Record<string, string> = {\n    52→  person: \"#6366f1\",\n    53→  faction: \"#8b5cf6\",\n    54→  location: \"#10b981\",\n    55→  artifact: \"#f59e0b\",\n    56→  creature: \"#ec4899\",\n    57→  event: \"#06b6d4\",\n    58→  concept: \"#84cc16\",\n    59→  organization: \"#f97316\",\n    60→};\n    61→\n    62→/**\n    63→ * Simple force simulation - positions nodes in concentric circles by distance\n    64→ */\n    65→type LayoutNode = Omit<ConstellationNode, \"isAssigned\" | \"eraColor\">;\n    66→\n    67→function computeLayout(\n    68→  entryPointId: string,\n    69→  candidates: EntityContext[],\n    70→  metricsMap: Map<string, EntitySelectionMetrics>,\n    71→  width: number,\n    72→  height: number\n    73→): LayoutNode[] {\n    74→  const cx = width / 2;\n    75→  const cy = height / 2;\n    76→  const nodes: LayoutNode[] = [];\n    77→\n    78→  // Group candidates by distance\n    79→  const byDistance = new Map<number, EntityContext[]>();\n    80→  byDistance.set(0, []); // Entry point\n    81→  byDistance.set(1, []);\n    82→  byDistance.set(2, []);\n    83→\n    84→  for (const entity of candidates) {\n    85→    const metrics = metricsMap.get(entity.id);\n    86→    const distance = metrics?.distance ?? 2;\n    87→\n    88→    if (entity.id === entryPointId) {\n    89→      byDistance.get(0).push(entity);\n    90→    } else if (distance === 1) {\n    91→      byDistance.get(1).push(entity);\n    92→    } else {\n    93→      byDistance.get(2).push(entity);\n    94→    }\n    95→  }\n    96→\n    97→  // Orbit radii\n    98→  const radii = {\n    99→    0: 0, // Entry point at center\n   100→    1: Math.min(width, height) * 0.25, // Direct connections\n   101→    2: Math.min(width, height) * 0.42, // 2-hop connections\n   102→  };\n   103→\n   104→  // Place nodes in circles\n   105→  for (const [distance, entities] of byDistance) {\n   106→    const radius = radii[distance as 0 | 1 | 2];\n   107→    const count = entities.length;\n   108→\n   109→    if (count === 0) continue;\n   110→\n   111→    const angleStep = (2 * Math.PI) / count;\n   112→    const startAngle = -Math.PI / 2; // Start from top\n   113→\n   114→    entities.forEach((entity, i) => {\n   115→      const angle = startAngle + i * angleStep;\n   116→      // Add slight jitter for 2-hop to avoid exact circles\n   117→      // eslint-disable-next-line sonarjs/pseudo-random -- visual jitter for constellation layout\n   118→      const jitter = distance === 2 ? (Math.random() - 0.5) * 15 : 0;\n   119→\n   120→      nodes.push({\n   121→        id: entity.id,\n   122→        name: entity.name,\n   123→        kind: entity.kind,\n   124→        x: cx + (radius + jitter) * Math.cos(angle),\n   125→        y: cy + (radius + jitter) * Math.sin(angle),\n   126→        isEntryPoint: entity.id === entryPointId,\n   127→        metrics: metricsMap.get(entity.id),\n   128→      });\n   129→    });\n   130→  }\n   131→\n   132→  return nodes;\n   133→}\n   134→\n   135→/**\n   136→ * Extract edges from relationships\n   137→ */\n   138→function computeEdges(\n   139→  relationships: RelationshipContext[],\n   140→  nodeIds: Set<string>\n   141→): ConstellationEdge[] {\n   142→  const edges: ConstellationEdge[] = [];\n   143→  const seen = new Set<string>();\n   144→\n   145→  for (const rel of relationships) {\n   146→    // Only include edges where both nodes exist\n   147→    if (!nodeIds.has(rel.src) || !nodeIds.has(rel.dst)) continue;\n   148→\n   149→    // Deduplicate\n   150→    const key = [rel.src, rel.dst].sort((a, b) => a.localeCompare(b)).join(\":\");\n   151→    if (seen.has(key)) continue;\n   152→    seen.add(key);\n   153→\n   154→    edges.push({\n   155→      source: rel.src,\n   156→      target: rel.dst,\n   157→      strength: rel.strength ?? 0.5,\n   158→      kind: rel.kind,\n   159→    });\n   160→  }\n   161→\n   162→  return edges;\n   163→}\n   164→\n   165→export default function EnsembleConstellation({\n   166→  entryPointId,\n   167→  candidates,\n   168→  relationships,\n   169→  assignedEntityIds,\n   170→  metricsMap,\n   171→  selectedEntityId,\n   172→  onSelectEntity,\n   173→  width = 400,\n   174→  height = 350,\n   175→  eraColorMap,\n   176→}: Readonly<EnsembleConstellationProps>) {\n   177→  const svgRef = useRef<SVGSVGElement>(null);\n   178→  const [hoveredNodeId, setHoveredNodeId] = useState<string | null>(null);\n   179→\n   180→  // Compute layout\n   181→  const nodes = useMemo(() => {\n   182→    const layout = computeLayout(entryPointId, candidates, metricsMap, width, height);\n   183→    const candidateMap = new Map(candidates.map((c) => [c.id, c]));\n   184→    return layout.map((node) => {\n   185→      const candidate = candidateMap.get(node.id);\n   186→      const eraId = candidate?.eraId && candidate.eraId.length > 0 ? candidate.eraId : undefined;\n   187→      return {\n   188→        ...node,\n   189→        isAssigned: assignedEntityIds.has(node.id),\n   190→        eraColor: eraId ? (eraColorMap?.get(eraId) ?? \"#6b7280\") : \"#6b7280\",\n   191→      };\n   192→    });\n   193→  }, [entryPointId, candidates, metricsMap, width, height, assignedEntityIds, eraColorMap]);\n   194→\n   195→  const nodeMap = useMemo(() => {\n   196→    return new Map(nodes.map((n) => [n.id, n]));\n   197→  }, [nodes]);\n   198→\n   199→  // Compute edges\n   200→  const edges = useMemo(() => {\n   201→    const nodeIds = new Set(nodes.map((n) => n.id));\n   202→    return computeEdges(relationships, nodeIds);\n   203→  }, [relationships, nodes]);\n   204→\n   205→  // Compute bridge nodes (unassigned nodes connected to 2+ unique assigned entities)\n   206→  const bridgeNodeIds = useMemo(() => {\n   207→    // Map entity ID -> set of unique assigned entity IDs it connects to\n   208→    const connectedToAssigned = new Map<string, Set<string>>();\n   209→\n   210→    for (const rel of relationships) {\n   211→      const srcAssigned = assignedEntityIds.has(rel.src);\n   212→      const dstAssigned = assignedEntityIds.has(rel.dst);\n   213→\n   214→      if (srcAssigned && !dstAssigned) {\n   215→        if (!connectedToAssigned.has(rel.dst)) connectedToAssigned.set(rel.dst, new Set());\n   216→        connectedToAssigned.get(rel.dst).add(rel.src);\n   217→      }\n   218→      if (dstAssigned && !srcAssigned) {\n   219→        if (!connectedToAssigned.has(rel.src)) connectedToAssigned.set(rel.src, new Set());\n   220→        connectedToAssigned.get(rel.src).add(rel.dst);\n   221→      }\n   222→    }\n   223→\n   224→    const bridges = new Set<string>();\n   225→    for (const [id, assignedConnections] of connectedToAssigned) {\n   226→      if (assignedConnections.size >= 2) bridges.add(id);\n   227→    }\n   228→    return bridges;\n   229→  }, [relationships, assignedEntityIds]);\n   230→\n   231→  const getKindColor = (kind: string): string => {\n   232→    return KIND_COLORS[kind.toLowerCase()] || \"var(--text-muted)\";\n   233→  };\n   234→\n   235→  const handleNodeClick = useCallback(\n   236→    (nodeId: string) => {\n   237→      if (selectedEntityId === nodeId) {\n   238→        onSelectEntity(null);\n   239→      } else {\n   240→        onSelectEntity(nodeId);\n   241→      }\n   242→    },\n   243→    [selectedEntityId, onSelectEntity]\n   244→  );\n   245→\n   246→  // Determine node visual properties\n   247→  const getNodeStyle = (node: ConstellationNode) => {\n   248→    const isSelected = selectedEntityId === node.id;\n   249→    const isHovered = hoveredNodeId === node.id;\n   250→    const metrics = node.metrics;\n   251→\n   252→    // Base size\n   253→    let radius = node.isEntryPoint ? 18 : 12;\n   254→    if (isSelected || isHovered) radius += 2;\n   255→\n   256→    // Overused indicator\n   257→    const isOverused = metrics && metrics.usageCount >= 5;\n   258→\n   259→    return { radius, isOverused, isSelected, isHovered };\n   260→  };\n   261→\n   262→  return (\n   263→    <svg\n   264→      ref={svgRef}\n   265→      width={width}\n   266→      height={height}\n   267→      className=\"ec-svg\"\n   268→    >\n   269→      {/* Orbit guides */}\n   270→      <circle\n   271→        cx={width / 2}\n   272→        cy={height / 2}\n   273→        r={Math.min(width, height) * 0.25}\n   274→        fill=\"none\"\n   275→        stroke=\"var(--border-color)\"\n   276→        strokeWidth={1}\n   277→        strokeDasharray=\"4,4\"\n   278→        opacity={0.5}\n   279→      />\n   280→      <circle\n   281→        cx={width / 2}\n   282→        cy={height / 2}\n   283→        r={Math.min(width, height) * 0.42}\n   284→        fill=\"none\"\n   285→        stroke=\"var(--border-color)\"\n   286→        strokeWidth={1}\n   287→        strokeDasharray=\"4,4\"\n   288→        opacity={0.3}\n   289→      />\n   290→\n   291→      {/* Edges */}\n   292→      {edges.map((edge, i) => {\n   293→        const source = nodeMap.get(edge.source);\n   294→        const target = nodeMap.get(edge.target);\n   295→        if (!source || !target) return null;\n   296→\n   297→        const sourceAssigned = assignedEntityIds.has(edge.source);\n   298→        const targetAssigned = assignedEntityIds.has(edge.target);\n   299→        const sourceSelected = selectedEntityId === edge.source || hoveredNodeId === edge.source;\n   300→        const targetSelected = selectedEntityId === edge.target || hoveredNodeId === edge.target;\n   301→\n   302→        // Determine edge color and style based on node states\n   303→        let strokeColor = \"var(--border-color)\";\n   304→        let strokeOpacity = 0.2;\n   305→        let strokeWidth = 1 + edge.strength * 1.5;\n   306→\n   307→        if (sourceAssigned && targetAssigned) {\n   308→          // Both assigned - green, prominent\n   309→          strokeColor = \"var(--success)\";\n   310→          strokeOpacity = 0.7;\n   311→          strokeWidth = 2 + edge.strength * 2;\n   312→        } else if ((sourceAssigned && targetSelected) || (targetAssigned && sourceSelected)) {\n   313→          // One assigned, one selected - orange/gold\n   314→          strokeColor = \"var(--warning)\";\n   315→          strokeOpacity = 0.8;\n   316→          strokeWidth = 2 + edge.strength * 2;\n   317→        } else if (sourceSelected || targetSelected) {\n   318→          // One selected, neither assigned - purple\n   319→          strokeColor = \"var(--accent-color)\";\n   320→          strokeOpacity = 0.8;\n   321→          strokeWidth = 2 + edge.strength * 2;\n   322→        } else if (sourceAssigned || targetAssigned) {\n   323→          // One assigned, not selected - cyan to show potential ensemble connections\n   324→          strokeColor = \"#06b6d4\"; // cyan\n   325→          strokeOpacity = 0.5;\n   326→          strokeWidth = 1.5 + edge.strength * 1.5;\n   327→        }\n   328→\n   329→        return (\n   330→          <line\n   331→            key={i}\n   332→            x1={source.x}\n   333→            y1={source.y}\n   334→            x2={target.x}\n   335→            y2={target.y}\n   336→            stroke={strokeColor}\n   337→            strokeWidth={strokeWidth}\n   338→            strokeOpacity={strokeOpacity}\n   339→          />\n   340→        );\n   341→      })}\n   342→\n   343→      {/* Nodes */}\n   344→      {nodes.map((node) => {\n   345→        const style = getNodeStyle(node);\n   346→        const color = getKindColor(node.kind);\n   347→\n   348→        return (\n   349→          <g\n   350→            key={node.id}\n   351→            className=\"ec-cursor-pointer\"\n   352→            onClick={() => handleNodeClick(node.id)}\n   353→            onMouseEnter={() => setHoveredNodeId(node.id)}\n   354→            onMouseLeave={() => setHoveredNodeId(null)}\n   355→          >\n   356→            {/* Overused glow */}\n   357→            {style.isOverused && (\n   358→              <circle\n   359→                cx={node.x}\n   360→                cy={node.y}\n   361→                r={style.radius + 4}\n   362→                fill=\"none\"\n   363→                stroke=\"var(--error)\"\n   364→                strokeWidth={2}\n   365→                opacity={0.6}\n   366→              />\n   367→            )}\n   368→\n   369→            {/* Selection ring */}\n   370→            {style.isSelected && (\n   371→              <circle\n   372→                cx={node.x}\n   373→                cy={node.y}\n   374→                r={style.radius + 3}\n   375→                fill=\"none\"\n   376→                stroke=\"var(--accent-color)\"\n   377→                strokeWidth={2}\n   378→              />\n   379→            )}\n   380→\n   381→            {/* Bridge indicator (unassigned node connected to 2+ assigned) */}\n   382→            {!node.isAssigned && !node.isEntryPoint && bridgeNodeIds.has(node.id) && (\n   383→              <circle\n   384→                cx={node.x}\n   385→                cy={node.y}\n   386→                r={style.radius + 2}\n   387→                fill=\"none\"\n   388→                stroke=\"#f59e0b\"\n   389→                strokeWidth={2}\n   390→                strokeDasharray=\"2,2\"\n   391→              />\n   392→            )}\n   393→\n   394→            {/* Assigned indicator */}\n   395→            {node.isAssigned && !node.isEntryPoint && (\n   396→              <circle\n   397→                cx={node.x}\n   398→                cy={node.y}\n   399→                r={style.radius + 2}\n   400→                fill=\"none\"\n   401→                stroke=\"var(--success)\"\n   402→                strokeWidth={2}\n   403→                strokeDasharray=\"3,2\"\n   404→              />\n   405→            )}\n   406→\n   407→            {/* Node circle with era-colored ring */}\n   408→            <circle\n   409→              cx={node.x}\n   410→              cy={node.y}\n   411→              r={style.radius}\n   412→              fill={node.isEntryPoint ? \"var(--accent-color)\" : color}\n   413→              stroke={style.isHovered ? \"white\" : node.eraColor}\n   414→              strokeWidth={2}\n   415→            />\n   416→\n   417→            {/* Entry point star */}\n   418→            {node.isEntryPoint && (\n   419→              <text\n   420→                x={node.x}\n   421→                y={node.y}\n   422→                textAnchor=\"middle\"\n   423→                dy={5}\n   424→                fontSize=\"14\"\n   425→                fill=\"white\"\n   426→                fontWeight=\"bold\"\n   427→                className=\"ec-no-pointer\"\n   428→              >\n   429→                ★\n   430→              </text>\n   431→            )}\n   432→\n   433→            {/* Kind initial for non-entry-point nodes */}\n   434→            {!node.isEntryPoint && (\n   435→              <text\n   436→                x={node.x}\n   437→                y={node.y}\n   438→                textAnchor=\"middle\"\n   439→                dy={4}\n   440→                fontSize=\"9\"\n   441→                fill=\"white\"\n   442→                fontWeight=\"500\"\n   443→                className=\"ec-no-pointer\"\n   444→              >\n   445→                {node.kind.charAt(0).toUpperCase()}\n   446→              </text>\n   447→            )}\n   448→          </g>\n   449→        );\n   450→      })}\n   451→\n   452→      {/* Tooltip layer - rendered on top of all nodes */}\n   453→      {(() => {\n   454→        const tooltipNodeId = hoveredNodeId || selectedEntityId;\n   455→        const tooltipNode = tooltipNodeId ? nodeMap.get(tooltipNodeId) : null;\n   456→        if (!tooltipNode) return null;\n   457→\n   458→        const style = getNodeStyle(tooltipNode);\n   459→        const metrics = tooltipNode.metrics;\n   460→        const usageCount = metrics?.usageCount ?? 0;\n   461→        const linksToEnsemble = (() => {\n   462→          if (tooltipNode.isAssigned) return null; // Don't show for assigned\n   463→          let count = 0;\n   464→          for (const rel of relationships) {\n   465→            if (rel.src === tooltipNode.id && assignedEntityIds.has(rel.dst)) count++;\n   466→            if (rel.dst === tooltipNode.id && assignedEntityIds.has(rel.src)) count++;\n   467→          }\n   468→          return count;\n   469→        })();\n   470→\n   471→        // Build info line\n   472→        const infoParts: string[] = [];\n   473→        if (usageCount > 0) {\n   474→          infoParts.push(`${usageCount}× used`);\n   475→        } else {\n   476→          infoParts.push(\"unused\");\n   477→        }\n   478→        if (linksToEnsemble !== null) {\n   479→          infoParts.push(\n   480→            (() => {\n   481→              if (linksToEnsemble <= 0) return \"no links\";\n   482→              const plural = linksToEnsemble > 1 ? \"s\" : \"\";\n   483→              return `${linksToEnsemble} link${plural}`;\n   484→            })()\n   485→          );\n   486→        }\n   487→\n   488→        return (\n   489→          <g className=\"ec-no-pointer\">\n   490→            <rect\n   491→              x={tooltipNode.x - 52}\n   492→              y={tooltipNode.y + style.radius + 4}\n   493→              width={104}\n   494→              height={28}\n   495→              rx={4}\n   496→              fill=\"#1e1e2e\"\n   497→              stroke=\"#45475a\"\n   498→              strokeWidth={1}\n   499→            />\n   500→            <text\n   501→              x={tooltipNode.x}\n   502→              y={tooltipNode.y + style.radius + 16}\n   503→              textAnchor=\"middle\"\n   504→              fontSize=\"10\"\n   505→              fill=\"#cdd6f4\"\n   506→              fontWeight=\"500\"\n   507→            >\n   508→              {tooltipNode.name.length > 14\n   509→                ? tooltipNode.name.slice(0, 14) + \"…\"\n   510→                : tooltipNode.name}\n   511→            </text>\n   512→            <text\n   513→              x={tooltipNode.x}\n   514→              y={tooltipNode.y + style.radius + 27}\n   515→              textAnchor=\"middle\"\n   516→              fontSize=\"9\"\n   517→              fill=\"#a6adc8\"\n   518→            >\n   519→              {infoParts.join(\" · \")}\n   520→            </text>\n   521→          </g>\n   522→        );\n   523→      })()}\n   524→\n   525→      {/* Legend */}\n   526→      <g transform={`translate(8, ${height - 24})`}>\n   527→        <text fontSize=\"9\" fill=\"var(--text-muted)\">\n   528→          <tspan fill=\"var(--success)\">―</tspan>\n   529→          <tspan dx=\"2\">ensemble</tspan>\n   530→          <tspan dx=\"6\" fill=\"#06b6d4\">\n   531→            ―\n   532→          </tspan>\n   533→          <tspan dx=\"2\">to ensemble</tspan>\n   534→          <tspan dx=\"6\" fill=\"#f59e0b\">\n   535→            ◌\n   536→          </tspan>\n   537→          <tspan dx=\"2\">bridge</tspan>\n   538→          <tspan dx=\"6\" fill=\"var(--error)\">\n   539→            ◯\n   540→          </tspan>\n   541→          <tspan dx=\"2\">overused</tspan>\n   542→        </text>\n   543→      </g>\n   544→    </svg>\n   545→  );\n   546→}\n   547→"}]},"parent_tool_use_id":null,"session_id":"ee4ea11c-d389-40b8-aae4-dcc42ada4575","uuid":"ff801332-3374-4c5d-aa6e-7a3731a4edb3","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/ChronicleWizard/visualizations/EnsembleConstellation.tsx","content":"/**\n * EnsembleConstellation - Force-directed graph for role assignment\n *\n * Displays candidates as nodes with the entry point at center.\n * Nodes can be clicked to select, then assigned to roles.\n * Visual encoding: node color = kind, line thickness = strength,\n * ring color = era, red glow = overused.\n */\n\nimport React, { useState, useMemo, useCallback, useRef } from \"react\";\nimport type { EntityContext, RelationshipContext } from \"../../../lib/chronicleTypes\";\nimport type { EntitySelectionMetrics } from \"../../../lib/chronicle/selectionWizard\";\nimport \"./EnsembleConstellation.css\";\n\ninterface ConstellationNode {\n  id: string;\n  name: string;\n  kind: string;\n  x: number;\n  y: number;\n  isEntryPoint: boolean;\n  isAssigned: boolean;\n  metrics?: EntitySelectionMetrics;\n  eraColor: string;\n}\n\ninterface ConstellationEdge {\n  source: string;\n  target: string;\n  strength: number;\n  kind: string;\n}\n\ninterface EnsembleConstellationProps {\n  entryPointId: string;\n  candidates: EntityContext[];\n  relationships: RelationshipContext[];\n  assignedEntityIds: Set<string>;\n  metricsMap: Map<string, EntitySelectionMetrics>;\n  /** Currently selected entity (for assignment) */\n  selectedEntityId: string | null;\n  /** Callback when entity is selected */\n  onSelectEntity: (entityId: string | null) => void;\n  width?: number;\n  height?: number;\n  /** Era ID -> color mapping for era rings on nodes */\n  eraColorMap?: Map<string, string>;\n}\n\n// Color mapping for entity kinds\nconst KIND_COLORS: Record<string, string> = {\n  person: \"#6366f1\",\n  faction: \"#8b5cf6\",\n  location: \"#10b981\",\n  artifact: \"#f59e0b\",\n  creature: \"#ec4899\",\n  event: \"#06b6d4\",\n  concept: \"#84cc16\",\n  organization: \"#f97316\",\n};\n\n/**\n * Simple force simulation - positions nodes in concentric circles by distance\n */\ntype LayoutNode = Omit<ConstellationNode, \"isAssigned\" | \"eraColor\">;\n\nfunction computeLayout(\n  entryPointId: string,\n  candidates: EntityContext[],\n  metricsMap: Map<string, EntitySelectionMetrics>,\n  width: number,\n  height: number\n): LayoutNode[] {\n  const cx = width / 2;\n  const cy = height / 2;\n  const nodes: LayoutNode[] = [];\n\n  // Group candidates by distance\n  const byDistance = new Map<number, EntityContext[]>();\n  byDistance.set(0, []); // Entry point\n  byDistance.set(1, []);\n  byDistance.set(2, []);\n\n  for (const entity of candidates) {\n    const metrics = metricsMap.get(entity.id);\n    const distance = metrics?.distance ?? 2;\n\n    if (entity.id === entryPointId) {\n      byDistance.get(0).push(entity);\n    } else if (distance === 1) {\n      byDistance.get(1).push(entity);\n    } else {\n      byDistance.get(2).push(entity);\n    }\n  }\n\n  // Orbit radii\n  const radii = {\n    0: 0, // Entry point at center\n    1: Math.min(width, height) * 0.25, // Direct connections\n    2: Math.min(width, height) * 0.42, // 2-hop connections\n  };\n\n  // Place nodes in circles\n  for (const [distance, entities] of byDistance) {\n    const radius = radii[distance as 0 | 1 | 2];\n    const count = entities.length;\n\n    if (count === 0) continue;\n\n    const angleStep = (2 * Math.PI) / count;\n    const startAngle = -Math.PI / 2; // Start from top\n\n    entities.forEach((entity, i) => {\n      const angle = startAngle + i * angleStep;\n      // Add slight jitter for 2-hop to avoid exact circles\n      // eslint-disable-next-line sonarjs/pseudo-random -- visual jitter for constellation layout\n      const jitter = distance === 2 ? (Math.random() - 0.5) * 15 : 0;\n\n      nodes.push({\n        id: entity.id,\n        name: entity.name,\n        kind: entity.kind,\n        x: cx + (radius + jitter) * Math.cos(angle),\n        y: cy + (radius + jitter) * Math.sin(angle),\n        isEntryPoint: entity.id === entryPointId,\n        metrics: metricsMap.get(entity.id),\n      });\n    });\n  }\n\n  return nodes;\n}\n\n/**\n * Extract edges from relationships\n */\nfunction computeEdges(\n  relationships: RelationshipContext[],\n  nodeIds: Set<string>\n): ConstellationEdge[] {\n  const edges: ConstellationEdge[] = [];\n  const seen = new Set<string>();\n\n  for (const rel of relationships) {\n    // Only include edges where both nodes exist\n    if (!nodeIds.has(rel.src) || !nodeIds.has(rel.dst)) continue;\n\n    // Deduplicate\n    const key = [rel.src, rel.dst].sort((a, b) => a.localeCompare(b)).join(\":\");\n    if (seen.has(key)) continue;\n    seen.add(key);\n\n    edges.push({\n      source: rel.src,\n      target: rel.dst,\n      strength: rel.strength ?? 0.5,\n      kind: rel.kind,\n    });\n  }\n\n  return edges;\n}\n\nexport default function EnsembleConstellation({\n  entryPointId,\n  candidates,\n  relationships,\n  assignedEntityIds,\n  metricsMap,\n  selectedEntityId,\n  onSelectEntity,\n  width = 400,\n  height = 350,\n  eraColorMap,\n}: Readonly<EnsembleConstellationProps>) {\n  const svgRef = useRef<SVGSVGElement>(null);\n  const [hoveredNodeId, setHoveredNodeId] = useState<string | null>(null);\n\n  // Compute layout\n  const nodes = useMemo(() => {\n    const layout = computeLayout(entryPointId, candidates, metricsMap, width, height);\n    const candidateMap = new Map(candidates.map((c) => [c.id, c]));\n    return layout.map((node) => {\n      const candidate = candidateMap.get(node.id);\n      const eraId = candidate?.eraId && candidate.eraId.length > 0 ? candidate.eraId : undefined;\n      return {\n        ...node,\n        isAssigned: assignedEntityIds.has(node.id),\n        eraColor: eraId ? (eraColorMap?.get(eraId) ?? \"#6b7280\") : \"#6b7280\",\n      };\n    });\n  }, [entryPointId, candidates, metricsMap, width, height, assignedEntityIds, eraColorMap]);\n\n  const nodeMap = useMemo(() => {\n    return new Map(nodes.map((n) => [n.id, n]));\n  }, [nodes]);\n\n  // Compute edges\n  const edges = useMemo(() => {\n    const nodeIds = new Set(nodes.map((n) => n.id));\n    return computeEdges(relationships, nodeIds);\n  }, [relationships, nodes]);\n\n  // Compute bridge nodes (unassigned nodes connected to 2+ unique assigned entities)\n  const bridgeNodeIds = useMemo(() => {\n    // Map entity ID -> set of unique assigned entity IDs it connects to\n    const connectedToAssigned = new Map<string, Set<string>>();\n\n    for (const rel of relationships) {\n      const srcAssigned = assignedEntityIds.has(rel.src);\n      const dstAssigned = assignedEntityIds.has(rel.dst);\n\n      if (srcAssigned && !dstAssigned) {\n        if (!connectedToAssigned.has(rel.dst)) connectedToAssigned.set(rel.dst, new Set());\n        connectedToAssigned.get(rel.dst).add(rel.src);\n      }\n      if (dstAssigned && !srcAssigned) {\n        if (!connectedToAssigned.has(rel.src)) connectedToAssigned.set(rel.src, new Set());\n        connectedToAssigned.get(rel.src).add(rel.dst);\n      }\n    }\n\n    const bridges = new Set<string>();\n    for (const [id, assignedConnections] of connectedToAssigned) {\n      if (assignedConnections.size >= 2) bridges.add(id);\n    }\n    return bridges;\n  }, [relationships, assignedEntityIds]);\n\n  const getKindColor = (kind: string): string => {\n    return KIND_COLORS[kind.toLowerCase()] || \"var(--text-muted)\";\n  };\n\n  const handleNodeClick = useCallback(\n    (nodeId: string) => {\n      if (selectedEntityId === nodeId) {\n        onSelectEntity(null);\n      } else {\n        onSelectEntity(nodeId);\n      }\n    },\n    [selectedEntityId, onSelectEntity]\n  );\n\n  // Determine node visual properties\n  const getNodeStyle = (node: ConstellationNode) => {\n    const isSelected = selectedEntityId === node.id;\n    const isHovered = hoveredNodeId === node.id;\n    const metrics = node.metrics;\n\n    // Base size\n    let radius = node.isEntryPoint ? 18 : 12;\n    if (isSelected || isHovered) radius += 2;\n\n    // Overused indicator\n    const isOverused = metrics && metrics.usageCount >= 5;\n\n    return { radius, isOverused, isSelected, isHovered };\n  };\n\n  return (\n    <svg\n      ref={svgRef}\n      width={width}\n      height={height}\n      className=\"ec-svg\"\n    >\n      {/* Orbit guides */}\n      <circle\n        cx={width / 2}\n        cy={height / 2}\n        r={Math.min(width, height) * 0.25}\n        fill=\"none\"\n        stroke=\"var(--border-color)\"\n        strokeWidth={1}\n        strokeDasharray=\"4,4\"\n        opacity={0.5}\n      />\n      <circle\n        cx={width / 2}\n        cy={height / 2}\n        r={Math.min(width, height) * 0.42}\n        fill=\"none\"\n        stroke=\"var(--border-color)\"\n        strokeWidth={1}\n        strokeDasharray=\"4,4\"\n        opacity={0.3}\n      />\n\n      {/* Edges */}\n      {edges.map((edge, i) => {\n        const source = nodeMap.get(edge.source);\n        const target = nodeMap.get(edge.target);\n        if (!source || !target) return null;\n\n        const sourceAssigned = assignedEntityIds.has(edge.source);\n        const targetAssigned = assignedEntityIds.has(edge.target);\n        const sourceSelected = selectedEntityId === edge.source || hoveredNodeId === edge.source;\n        const targetSelected = selectedEntityId === edge.target || hoveredNodeId === edge.target;\n\n        // Determine edge color and style based on node states\n        let strokeColor = \"var(--border-color)\";\n        let strokeOpacity = 0.2;\n        let strokeWidth = 1 + edge.strength * 1.5;\n\n        if (sourceAssigned && targetAssigned) {\n          // Both assigned - green, prominent\n          strokeColor = \"var(--success)\";\n          strokeOpacity = 0.7;\n          strokeWidth = 2 + edge.strength * 2;\n        } else if ((sourceAssigned && targetSelected) || (targetAssigned && sourceSelected)) {\n          // One assigned, one selected - orange/gold\n          strokeColor = \"var(--warning)\";\n          strokeOpacity = 0.8;\n          strokeWidth = 2 + edge.strength * 2;\n        } else if (sourceSelected || targetSelected) {\n          // One selected, neither assigned - purple\n          strokeColor = \"var(--accent-color)\";\n          strokeOpacity = 0.8;\n          strokeWidth = 2 + edge.strength * 2;\n        } else if (sourceAssigned || targetAssigned) {\n          // One assigned, not selected - cyan to show potential ensemble connections\n          strokeColor = \"#06b6d4\"; // cyan\n          strokeOpacity = 0.5;\n          strokeWidth = 1.5 + edge.strength * 1.5;\n        }\n\n        return (\n          <line\n            key={i}\n            x1={source.x}\n            y1={source.y}\n            x2={target.x}\n            y2={target.y}\n            stroke={strokeColor}\n            strokeWidth={strokeWidth}\n            strokeOpacity={strokeOpacity}\n          />\n        );\n      })}\n\n      {/* Nodes */}\n      {nodes.map((node) => {\n        const style = getNodeStyle(node);\n        const color = getKindColor(node.kind);\n\n        return (\n          <g\n            key={node.id}\n            className=\"ec-cursor-pointer\"\n            onClick={() => handleNodeClick(node.id)}\n            onMouseEnter={() => setHoveredNodeId(node.id)}\n            onMouseLeave={() => setHoveredNodeId(null)}\n          >\n            {/* Overused glow */}\n            {style.isOverused && (\n              <circle\n                cx={node.x}\n                cy={node.y}\n                r={style.radius + 4}\n                fill=\"none\"\n                stroke=\"var(--error)\"\n                strokeWidth={2}\n                opacity={0.6}\n              />\n            )}\n\n            {/* Selection ring */}\n            {style.isSelected && (\n              <circle\n                cx={node.x}\n                cy={node.y}\n                r={style.radius + 3}\n                fill=\"none\"\n                stroke=\"var(--accent-color)\"\n                strokeWidth={2}\n              />\n            )}\n\n            {/* Bridge indicator (unassigned node connected to 2+ assigned) */}\n            {!node.isAssigned && !node.isEntryPoint && bridgeNodeIds.has(node.id) && (\n              <circle\n                cx={node.x}\n                cy={node.y}\n                r={style.radius + 2}\n                fill=\"none\"\n                stroke=\"#f59e0b\"\n                strokeWidth={2}\n                strokeDasharray=\"2,2\"\n              />\n            )}\n\n            {/* Assigned indicator */}\n            {node.isAssigned && !node.isEntryPoint && (\n              <circle\n                cx={node.x}\n                cy={node.y}\n                r={style.radius + 2}\n                fill=\"none\"\n                stroke=\"var(--success)\"\n                strokeWidth={2}\n                strokeDasharray=\"3,2\"\n              />\n            )}\n\n            {/* Node circle with era-colored ring */}\n            <circle\n              cx={node.x}\n              cy={node.y}\n              r={style.radius}\n              fill={node.isEntryPoint ? \"var(--accent-color)\" : color}\n              stroke={style.isHovered ? \"white\" : node.eraColor}\n              strokeWidth={2}\n            />\n\n            {/* Entry point star */}\n            {node.isEntryPoint && (\n              <text\n                x={node.x}\n                y={node.y}\n                textAnchor=\"middle\"\n                dy={5}\n                fontSize=\"14\"\n                fill=\"white\"\n                fontWeight=\"bold\"\n                className=\"ec-no-pointer\"\n              >\n                ★\n              </text>\n            )}\n\n            {/* Kind initial for non-entry-point nodes */}\n            {!node.isEntryPoint && (\n              <text\n                x={node.x}\n                y={node.y}\n                textAnchor=\"middle\"\n                dy={4}\n                fontSize=\"9\"\n                fill=\"white\"\n                fontWeight=\"500\"\n                className=\"ec-no-pointer\"\n              >\n                {node.kind.charAt(0).toUpperCase()}\n              </text>\n            )}\n          </g>\n        );\n      })}\n\n      {/* Tooltip layer - rendered on top of all nodes */}\n      {(() => {\n        const tooltipNodeId = hoveredNodeId || selectedEntityId;\n        const tooltipNode = tooltipNodeId ? nodeMap.get(tooltipNodeId) : null;\n        if (!tooltipNode) return null;\n\n        const style = getNodeStyle(tooltipNode);\n        const metrics = tooltipNode.metrics;\n        const usageCount = metrics?.usageCount ?? 0;\n        const linksToEnsemble = (() => {\n          if (tooltipNode.isAssigned) return null; // Don't show for assigned\n          let count = 0;\n          for (const rel of relationships) {\n            if (rel.src === tooltipNode.id && assignedEntityIds.has(rel.dst)) count++;\n            if (rel.dst === tooltipNode.id && assignedEntityIds.has(rel.src)) count++;\n          }\n          return count;\n        })();\n\n        // Build info line\n        const infoParts: string[] = [];\n        if (usageCount > 0) {\n          infoParts.push(`${usageCount}× used`);\n        } else {\n          infoParts.push(\"unused\");\n        }\n        if (linksToEnsemble !== null) {\n          infoParts.push(\n            (() => {\n              if (linksToEnsemble <= 0) return \"no links\";\n              const plural = linksToEnsemble > 1 ? \"s\" : \"\";\n              return `${linksToEnsemble} link${plural}`;\n            })()\n          );\n        }\n\n        return (\n          <g className=\"ec-no-pointer\">\n            <rect\n              x={tooltipNode.x - 52}\n              y={tooltipNode.y + style.radius + 4}\n              width={104}\n              height={28}\n              rx={4}\n              fill=\"#1e1e2e\"\n              stroke=\"#45475a\"\n              strokeWidth={1}\n            />\n            <text\n              x={tooltipNode.x}\n              y={tooltipNode.y + style.radius + 16}\n              textAnchor=\"middle\"\n              fontSize=\"10\"\n              fill=\"#cdd6f4\"\n              fontWeight=\"500\"\n            >\n              {tooltipNode.name.length > 14\n                ? tooltipNode.name.slice(0, 14) + \"…\"\n                : tooltipNode.name}\n            </text>\n            <text\n              x={tooltipNode.x}\n              y={tooltipNode.y + style.radius + 27}\n              textAnchor=\"middle\"\n              fontSize=\"9\"\n              fill=\"#a6adc8\"\n            >\n              {infoParts.join(\" · \")}\n            </text>\n          </g>\n        );\n      })()}\n\n      {/* Legend */}\n      <g transform={`translate(8, ${height - 24})`}>\n        <text fontSize=\"9\" fill=\"var(--text-muted)\">\n          <tspan fill=\"var(--success)\">―</tspan>\n          <tspan dx=\"2\">ensemble</tspan>\n          <tspan dx=\"6\" fill=\"#06b6d4\">\n            ―\n          </tspan>\n          <tspan dx=\"2\">to ensemble</tspan>\n          <tspan dx=\"6\" fill=\"#f59e0b\">\n            ◌\n          </tspan>\n          <tspan dx=\"2\">bridge</tspan>\n          <tspan dx=\"6\" fill=\"var(--error)\">\n            ◯\n          </tspan>\n          <tspan dx=\"2\">overused</tspan>\n        </text>\n      </g>\n    </svg>\n  );\n}\n","numLines":547,"startLine":1,"totalLines":547}}}
