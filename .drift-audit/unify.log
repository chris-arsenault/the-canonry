.style-editor-badge-story {\n  background: var(--accent-primary);\n  color: white;\n}\n\n.style-editor-instructions-preview {\n  margin-top: 8px;\n  font-size: 11px;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n.style-editor-tags-row {\n  margin-top: 8px;\n}\n\n/* =========================================================================\n   CoverImageConfigSection\n   ========================================================================= */\n\n.style-editor-cover-section {\n  margin-bottom: 16px;\n}\n\n.style-editor-cover-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n\n.style-editor-cover-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n\n.style-editor-cover-card {\n  padding: 10px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.style-editor-cover-card-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.style-editor-cover-card-value {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n/* =========================================================================\n   DocumentStyleViewModal\n   ========================================================================= */\n\n.style-editor-modal-wide {\n  max-width: 700px;\n  max-height: 80vh;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n.style-editor-modal-body-scroll {\n  flex: 1;\n  overflow: auto;\n}\n\n.style-editor-detail-section {\n  margin-bottom: 16px;\n}\n\n.style-editor-detail-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.style-editor-detail-label-mb8 {\n  margin-bottom: 8px;\n}\n\n.style-editor-preformatted {\n  font-size: 13px;\n  background: var(--bg-tertiary);\n  padding: 12px;\n  border-radius: 6px;\n  white-space: pre-wrap;\n  max-height: 300px;\n  overflow: auto;\n}\n\n.style-editor-preformatted-compact {\n  max-height: none;\n}\n\n/* Roles list in document view */\n.style-editor-roles-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.style-editor-role-card {\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.style-editor-role-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 4px;\n}\n\n.style-editor-role-name {\n  font-weight: 500;\n}\n\n.style-editor-role-count {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.style-editor-role-desc {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n/* Tags row in document view */\n.style-editor-tags-flex {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n/* Read-only notice */\n.style-editor-readonly-notice {\n  margin-top: 24px;\n  padding: 12px;\n  background: rgb(234 179 8 / 10%);\n  border: 1px solid rgb(234 179 8 / 30%);\n  border-radius: 6px;\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n/* =========================================================================\n   NarrativeStyleEditModal\n   ========================================================================= */\n\n.style-editor-modal-extra-wide {\n  max-width: 800px;\n  max-height: 85vh;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Tab bar */\n.style-editor-tab-bar {\n  display: flex;\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n}\n\n.style-editor-tab {\n  padding: 8px 16px;\n  border: none;\n  background: transparent;\n  border-bottom: 2px solid transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  font-size: 12px;\n  font-weight: 400;\n}\n\n.style-editor-tab-active {\n  background: var(--bg-primary);\n  border-bottom-color: var(--accent-primary);\n  color: var(--text-primary);\n  font-weight: 600;\n}\n\n/* Form layout in modal */\n.style-editor-form-scroll {\n  flex: 1;\n  overflow: auto;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Pacing grid */\n.st