{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LjZm68fsyGQvBeKp4ZvzEU","type":"tool_result","content":"     1→/**\n     2→ * LocalTextArea - Textarea with cursor-jumping prevention\n     3→ *\n     4→ * When editing textareas bound to external state, React can cause cursor jumping\n     5→ * because the input value gets reset on every keystroke. This component maintains\n     6→ * a local copy of the value that syncs on blur, preventing cursor jumping.\n     7→ * Tracks focus state to prevent parent re-renders from disrupting user input.\n     8→ *\n     9→ * @param {Object} props\n    10→ * @param {string} props.value - The value from external state\n    11→ * @param {Function} props.onChange - Callback when value changes (called on blur)\n    12→ * @param {string} [props.className] - CSS class name\n    13→ * @param {string} [props.placeholder] - Placeholder text\n    14→ * @param {number} [props.rows] - Number of rows\n    15→ *\n    16→ * @example\n    17→ * <LocalTextArea\n    18→ *   value={item.description || ''}\n    19→ *   onChange={(value) => updateItem('description', value || undefined)}\n    20→ *   className=\"textarea\"\n    21→ *   placeholder=\"Enter description...\"\n    22→ *   rows={3}\n    23→ * />\n    24→ */\n    25→\n    26→import React, { useState, useCallback } from 'react';\n    27→import PropTypes from 'prop-types';\n    28→\n    29→export function LocalTextArea({\n    30→  value,\n    31→  onChange,\n    32→  className = 'textarea',\n    33→  placeholder,\n    34→  rows,\n    35→  ...rest\n    36→}) {\n    37→  const externalValue = value || '';\n    38→  const [localValue, setLocalValue] = useState(externalValue);\n    39→  // Track focus in state so render can safely choose between local draft vs external value\n    40→  const [isFocused, setIsFocused] = useState(false);\n    41→\n    42→  const handleFocus = useCallback(() => {\n    43→    setLocalValue(externalValue);\n    44→    setIsFocused(true);\n    45→  }, [externalValue]);\n    46→\n    47→  // Call onChange on blur if value changed\n    48→  const handleBlur = useCallback(() => {\n    49→    setIsFocused(false);\n    50→    if (localValue !== externalValue) {\n    51→      onChange(localValue);\n    52→    }\n    53→  }, [externalValue, localValue, onChange]);\n    54→\n    55→  return (\n    56→    <textarea\n    57→      value={isFocused ? localValue : externalValue}\n    58→      onChange={(e) => setLocalValue(e.target.value)}\n    59→      onFocus={handleFocus}\n    60→      onBlur={handleBlur}\n    61→      className={className}\n    62→      placeholder={placeholder}\n    63→      rows={rows}\n    64→      {...rest}\n    65→    />\n    66→  );\n    67→}\n    68→\n    69→LocalTextArea.propTypes = {\n    70→  value: PropTypes.string,\n    71→  onChange: PropTypes.func.isRequired,\n    72→  className: PropTypes.string,\n    73→  placeholder: PropTypes.string,\n    74→  rows: PropTypes.number,\n    75→};\n    76→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"cfeb2855-cacc-44fa-8599-52b790412d2e"}
