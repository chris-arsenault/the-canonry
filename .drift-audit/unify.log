{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JaaV3HRgdxtyqMis7YkyM7","type":"tool_result","content":"     1→/**\n     2→ * LevelSelector - Visual level selector with configurable levels\n     3→ *\n     4→ * Supports:\n     5→ * - Click-to-select levels (for both string and numeric values)\n     6→ * - Optional numeric input for precise values (numeric mode only)\n     7→ * - Partial fill visualization for intermediate values (numeric mode)\n     8→ */\n     9→\n    10→import React, { useState } from 'react';\n    11→import PropTypes from 'prop-types';\n    12→\n    13→/**\n    14→ * @param {Object} props\n    15→ * @param {number|string} props.value - Current value\n    16→ * @param {Function} props.onChange - Called when value changes\n    17→ * @param {Array<{value: number|string, label: string, color: string}>} props.levels - Level definitions\n    18→ * @param {boolean} [props.showNumeric] - Show numeric input (default false, only for numeric values)\n    19→ * @param {number} [props.min] - Minimum value for numeric input (default 0)\n    20→ * @param {number} [props.max] - Maximum value for numeric input (default 10)\n    21→ * @param {number} [props.step] - Step for numeric input (default 0.1)\n    22→ * @param {string} [props.className] - Additional class names\n    23→ */\n    24→export function LevelSelector({\n    25→  value,\n    26→  onChange,\n    27→  levels,\n    28→  showNumeric = false,\n    29→  min = 0,\n    30→  max = 10,\n    31→  step = 0.1,\n    32→  className = '',\n    33→}) {\n    34→  const [hoveredLevel, setHoveredLevel] = useState(null);\n    35→\n    36→  // Detect if using numeric or string mode\n    37→  const isNumeric = typeof levels[0]?.value === 'number';\n    38→\n    39→  // Get level index based on value\n    40→  const getLevelIndex = (val) => {\n    41→    if (isNumeric) {\n    42→      for (let i = levels.length - 1; i >= 0; i--) {\n    43→        if (val >= levels[i].value) return i;\n    44→      }\n    45→      return 0;\n    46→    } else {\n    47→      const idx = levels.findIndex(l => l.value === val);\n    48→      return idx >= 0 ? idx : 0;\n    49→    }\n    50→  };\n    51→\n    52→  const levelIndex = getLevelIndex(value);\n    53→  const currentLevel = levels[levelIndex];\n    54→  const hoverLevel = hoveredLevel !== null ? levels[hoveredLevel] : null;\n    55→\n    56→  // Calculate partial fill for each dot (only meaningful for numeric mode)\n    57→  const getPartialFill = (idx) => {\n    58→    if (!isNumeric) {\n    59→      // String mode: full fill up to and including current level\n    60→      return idx <= levelIndex ? 1 : 0;\n    61→    }\n    62→    if (idx < levelIndex) return 1;\n    63→    if (idx > levelIndex) return 0;\n    64→    // Current level - calculate partial based on value position\n    65→    const levelStart = levels[idx].value;\n    66→    const levelEnd = idx < levels.length - 1 ? levels[idx + 1].value : max;\n    67→    const progress = (value - levelStart) / (levelEnd - levelStart);\n    68→    return Math.max(0, Math.min(1, progress));\n    69→  };\n    70→\n    71→  return (\n    72→    <div className={`level-selector ${className}`.trim()}>\n    73→      <div className=\"level-selector-dots\">\n    74→        {levels.map((level, idx) => {\n    75→          const isHovered = hoveredLevel !== null && idx <= hoveredLevel;\n    76→          const fill = getPartialFill(idx);\n    77→          const baseColor = isHovered ? hoverLevel.color : currentLevel.color;\n    78→\n    79→          return (\n    80→            <div\n    81→              key={idx}\n    82→              className={`level-selector-dot ${hoveredLevel === idx ? 'level-selector-dot-active' : ''}`.trim()}\n    83→              onClick={() => onChange(level.value)}\n    84→              onMouseEnter={() => setHoveredLevel(idx)}\n    85→              onMouseLeave={() => setHoveredLevel(null)}\n    86→              title={`${level.label}`}\n    87→              role=\"button\"\n    88→              tabIndex={0}\n    89→              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n    90→            >\n    91→              <svg className=\"level-selector-dot-fill-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    92→                <rect\n    93→                  x=\"0\"\n    94→                  y={100 - (fill * 100)}\n    95→                  width=\"100\"\n    96→                  height={fill * 100}\n    97→                  fill={baseColor}\n    98→                />\n    99→              </svg>\n   100→            </div>\n   101→          );\n   102→        })}\n   103→      </div>\n   104→      {showNumeric && isNumeric && (\n   105→        <input\n   106→          type=\"number\"\n   107→          className=\"level-selector-input\"\n   108→          value={value}\n   109→          onChange={(e) => {\n   110→            const newVal = parseFloat(e.target.value);\n   111→            if (!isNaN(newVal)) {\n   112→              onChange(Math.max(min, Math.min(max, newVal)));\n   113→            }\n   114→          }}\n   115→          step={step}\n   116→          min={min}\n   117→          max={max}\n   118→        />\n   119→      )}\n   120→    </div>\n   121→  );\n   122→}\n   123→\n   124→// Common level presets\n   125→export const STRENGTH_LEVELS = [\n   126→  { value: 0, label: 'Off', color: '#475569' },\n   127→  { value: 1, label: 'Low', color: '#3b82f6' },\n   128→  { value: 2, label: 'Medium', color: '#22c55e' },\n   129→  { value: 3, label: 'High', color: '#f59e0b' },\n   130→  { value: 4, label: 'Max', color: '#ef4444' },\n   131→];\n   132→\n   133→export const PROMINENCE_LEVELS = [\n   134→  { value: 'forgotten', label: 'Forgotten', color: '#6b7280' },\n   135→  { value: 'marginal', label: 'Marginal', color: '#60a5fa' },\n   136→  { value: 'recognized', label: 'Recognized', color: '#34d399' },\n   137→  { value: 'renowned', label: 'Renowned', color: '#fbbf24' },\n   138→  { value: 'mythic', label: 'Mythic', color: '#a855f7' },\n   139→];\n   140→\n   141→LevelSelector.propTypes = {\n   142→  value: PropTypes.oneOfType([PropTypes.number, PropTypes.string]).isRequired,\n   143→  onChange: PropTypes.func.isRequired,\n   144→  levels: PropTypes.array.isRequired,\n   145→  showNumeric: PropTypes.bool,\n   146→  min: PropTypes.number,\n   147→  max: PropTypes.number,\n   148→  step: PropTypes.number,\n   149→  className: PropTypes.string,\n   150→};\n   151→"}]},"parent_tool_use_id":null,"session_id":"a13268b0-3558-4a8f-abab-805b852d788c","uuid":"7546fc5e-19bf-42bb-99c6-c1d3b1950d8b","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/LevelSelector.jsx","content":"/**\n * LevelSelector - Visual level selector with configurable levels\n *\n * Supports:\n * - Click-to-select levels (for both string and numeric values)\n * - Optional numeric input for precise values (numeric mode only)\n * - Partial fill visualization for intermediate values (numeric mode)\n */\n\nimport React, { useState } from 'react';\nimport PropTypes from 'prop-types';\n\n/**\n * @param {Object} props\n * @param {number|string} props.value - Current value\n * @param {Function} props.onChange - Called when value changes\n * @param {Array<{value: number|string, label: string, color: string}>} props.levels - Level definitions\n * @param {boolean} [props.showNumeric] - Show numeric input (default false, only for numeric values)\n * @param {number} [props.min] - Minimum value for numeric input (default 0)\n * @param {number} [props.max] - Maximum value for numeric input (default 10)\n * @param {number} [props.step] - Step for numeric input (default 0.1)\n * @param {string} [props.className] - Additional class names\n */\nexport function LevelSelector({\n  value,\n  onChange,\n  levels,\n  showNumeric = false,\n  min = 0,\n  max = 10,\n  step = 0.1,\n  className = '',\n}) {\n  const [hoveredLevel, setHoveredLevel] = useState(null);\n\n  // Detect if using numeric or string mode\n  const isNumeric = typeof levels[0]?.value === 'number';\n\n  // Get level index based on value\n  const getLevelIndex = (val) => {\n    if (isNumeric) {\n      for (let i = levels.length - 1; i >= 0; i--) {\n        if (val >= levels[i].value) return i;\n      }\n      return 0;\n    } else {\n      const idx = levels.findIndex(l => l.value === val);\n      return idx >= 0 ? idx : 0;\n    }\n  };\n\n  const levelIndex = getLevelIndex(value);\n  const currentLevel = levels[levelIndex];\n  const hoverLevel = hoveredLevel !== null ? levels[hoveredLevel] : null;\n\n  // Calculate partial fill for each dot (only meaningful for numeric mode)\n  const getPartialFill = (idx) => {\n    if (!isNumeric) {\n      // String mode: full fill up to and including current level\n      return idx <= levelIndex ? 1 : 0;\n    }\n    if (idx < levelIndex) return 1;\n    if (idx > levelIndex) return 0;\n    // Current level - calculate partial based on value position\n    const levelStart = levels[idx].value;\n    const levelEnd = idx < levels.length - 1 ? levels[idx + 1].value : max;\n    const progress = (value - levelStart) / (levelEnd - levelStart);\n    return Math.max(0, Math.min(1, progress));\n  };\n\n  return (\n    <div className={`level-selector ${className}`.trim()}>\n      <div className=\"level-selector-dots\">\n        {levels.map((level, idx) => {\n          const isHovered = hoveredLevel !== null && idx <= hoveredLevel;\n          const fill = getPartialFill(idx);\n          const baseColor = isHovered ? hoverLevel.color : currentLevel.color;\n\n          return (\n            <div\n              key={idx}\n              className={`level-selector-dot ${hoveredLevel === idx ? 'level-selector-dot-active' : ''}`.trim()}\n              onClick={() => onChange(level.value)}\n              onMouseEnter={() => setHoveredLevel(idx)}\n              onMouseLeave={() => setHoveredLevel(null)}\n              title={`${level.label}`}\n              role=\"button\"\n              tabIndex={0}\n              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n            >\n              <svg className=\"level-selector-dot-fill-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n                <rect\n                  x=\"0\"\n                  y={100 - (fill * 100)}\n                  width=\"100\"\n                  height={fill * 100}\n                  fill={baseColor}\n                />\n              </svg>\n            </div>\n          );\n        })}\n      </div>\n      {showNumeric && isNumeric && (\n        <input\n          type=\"number\"\n          className=\"level-selector-input\"\n          value={value}\n          onChange={(e) => {\n            const newVal = parseFloat(e.target.value);\n            if (!isNaN(newVal)) {\n              onChange(Math.max(min, Math.min(max, newVal)));\n            }\n          }}\n          step={step}\n          min={min}\n          max={max}\n        />\n      )}\n    </div>\n  );\n}\n\n// Common level presets\nexport const STRENGTH_LEVELS = [\n  { value: 0, label: 'Off', color: '#475569' },\n  { value: 1, label: 'Low', color: '#3b82f6' },\n  { value: 2, label: 'Medium', color: '#22c55e' },\n  { value: 3, label: 'High', color: '#f59e0b' },\n  { value: 4, label: 'Max', color: '#ef4444' },\n];\n\nexport const PROMINENCE_LEVELS = [\n  { value: 'forgotten', label: 'Forgotten', color: '#6b7280' },\n  { value: 'marginal', label: 'Marginal', color: '#60a5fa' },\n  { value: 'recognized', label: 'Recognized', color: '#34d399' },\n  { value: 'renowned', label: 'Renowned', color: '#fbbf24' },\n  { value: 'mythic', label: 'Mythic', color: '#a855f7' },\n];\n\nLevelSelector.propTypes = {\n  value: PropTypes.oneOfType([PropTypes.number, PropTypes.string]).isRequired,\n  onChange: PropTypes.func.isRequired,\n  levels: PropTypes.array.isRequired,\n  showNumeric: PropTypes.bool,\n  min: PropTypes.number,\n  max: PropTypes.number,\n  step: PropTypes.number,\n  className: PropTypes.string,\n};\n","numLines":151,"startLine":1,"totalLines":151}}}
