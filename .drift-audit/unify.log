.jsx */\n\n/* ─── EventKindBadge ─── */\n.events-panel-kind-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  font-size: 11px;\n  font-weight: 500;\n  border-radius: 4px;\n  background: var(--badge-bg);\n  color: var(--badge-text);\n}\n\n/* ─── SignificanceBar ─── */\n.events-panel-significance-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.events-panel-significance-track {\n  width: 60px;\n  height: 6px;\n  background: var(--bg-tertiary);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.events-panel-significance-fill {\n  height: 100%;\n  border-radius: 3px;\n  width: var(--sig-width);\n  background: var(--sig-color);\n}\n\n.events-panel-significance-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  min-width: 32px;\n}\n\n/* ─── NarrativeTag ─── */\n.events-panel-narrative-tag {\n  display: inline-block;\n  padding: 2px 6px;\n  font-size: 10px;\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n  border-radius: 3px;\n}\n\n/* ─── StateChangeItem ─── */\n.events-panel-state-change {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 4px 0;\n}\n\n.events-panel-state-entity-name {\n  color: var(--text-muted);\n}\n\n.events-panel-state-field {\n  font-family: monospace;\n}\n\n.events-panel-state-old-value {\n  text-decoration: line-through;\n  color: var(--text-muted);\n}\n\n.events-panel-state-arrow {\n  color: var(--text-muted);\n}\n\n.events-panel-state-new-value {\n  font-weight: 500;\n}\n\n/* ─── EventCard ─── */\n.events-panel-card {\n  padding: 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  margin-bottom: 12px;\n}\n\n.events-panel-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.events-panel-card-header-left {\n  flex: 1;\n}\n\n.events-panel-card-meta-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 6px;\n}\n\n.events-panel-card-tick {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.events-panel-card-headline {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n/* Subject/Object row */\n.events-panel-card-subject {\n  margin-top: 8px;\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n.events-panel-card-entity-name {\n  font-weight: 500;\n}\n\n.events-panel-card-entity-kind {\n  color: var(--text-muted);\n  margin-left: 4px;\n}\n\n.events-panel-card-arrow {\n  color: var(--text-muted);\n  margin: 0 8px;\n}\n\n/* Tags row */\n.events-panel-card-tags {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n  margin-top: 10px;\n}\n\n/* Expanded section */\n.events-panel-card-expanded {\n  margin-top: 12px;\n  padding-top: 12px;\n  border-top: 1px solid var(--border-color);\n}\n\n.events-panel-card-description {\n  margin: 0 0 12px;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.events-panel-card-state-changes {\n  margin-bottom: 12px;\n}\n\n.events-panel-card-state-changes-label {\n  font-size: 12px;\n  font-weight: 500;\n  margin-bottom: 6px;\n  color: var(--text-muted);\n}\n\n.events-panel-card-causality {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.events-panel-card-causality-label {\n  font-weight: 500;\n}\n\n/* Toggle button */\n.events-panel-card-toggle {\n  margin-top: 8px;\n  padding: 4px 8px;\n  font-size: 11px;\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n}\n\n/* ─── Empty state ─── */\n.events-panel-empty {\n  padding: 48px;\n  text-align: center;\n}\n\n.events-panel-empty-icon {\n  font-size: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n.events-panel-empty-title {\n  margin: 0 0 8px;\n  font-size: 18px;\n}\n\n.events-panel-empty-text {\n  color: var(--text-muted);\n  max-width: 400px;\n  margin: 0 auto;\n  line-height: 1.6;\n}\n\n.events-panel-empty-instructions {\n  padding: 16px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  max-width: 400px;\n  margin: 24px auto 0;\n  text-align: left;\n}\n\n.events-panel-empty-instructions-title {\n  font-size: 13px;\n  font-weight: 500;\n  margin-bottom: 8px;\n}\n\n.events-panel-empty-instructions-list {\n  margin: 0;\n  padding-left: 20px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.8;\n}\n\n/* ─── Main panel layout ─── */\n.events-panel-root {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Filter bar */\n.events-panel-filter-bar {\n  padding: 16px;\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n}\n\n.events-panel-filter-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.events-panel-filter-count {\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.events-panel-filter-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.events-panel-filter-sort-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.events-panel-export-btn {\n  padding: 6px 12px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.events-panel-export-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n/* Filters row */\n.events-panel-filters-row {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.events-panel-significance-filter {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.events-panel-filter-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.events-panel-significance-slider {\n  width: 100px;\n}\n\n.events-panel-significance-value {\n  font-size: 12px;\n  font-family: monospace;\n  min-width: 32px;\n}\n\n.events-panel-filter-select {\n  padding: 6px 10px;\n  font-size: 12px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-primary);\n}\n\n.events-panel-clear-filters-btn {\n  padding: 6px 12px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  cursor: pointer;\n  color: var(--text-secondary);\n}\n\n/* Events list */\n.events-panel-list {\n  flex: 1;\n  overflow: auto;\n  padding: 16px;\n}\n\n.events-panel-no-match {\n  text-align: center;\n  padding: 32px;\n  color: var(--text-muted);\n}\n\n/* Load more */\n.events-panel-load-more-row {\n  text-align: center;\n  padding: 16px;\n}\n\n.events-panel-load-more-btn {\n  padding: 10px 24px;\n  font-size: 13px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  cursor: pointer;\n  color: var(--text-primary);\n}\n\n.events-panel-load-more-remaining {\n  color: var(--text-muted);\n  margin-left: 8px;\n}\n","numLines":375,"startLine":1,"totalLines":375}}}
