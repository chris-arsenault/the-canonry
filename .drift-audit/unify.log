"2a207061-1c30-40ba-a375-5d0443f621d8","uuid":"7b68d4d2-bb9c-4da0-a8c7-c2401b77f22f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/error-boundary.css","content":"/**\n * ErrorBoundary styles\n */\n\n.error-boundary {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-4xl);\n  color: var(--color-text-dim);\n  text-align: center;\n  height: 100%;\n  min-height: 200px;\n}\n\n.error-boundary-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: var(--radius-full);\n  background: rgb(239 68 68 / 15%);\n  color: var(--color-danger);\n  font-size: 24px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: var(--spacing-xl);\n}\n\n.error-boundary-title {\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-medium);\n  margin-bottom: var(--spacing-md);\n  color: var(--color-text);\n}\n\n.error-boundary-message {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  max-width: 400px;\n  margin-bottom: var(--spacing-2xl);\n  word-break: break-word;\n}\n\n.error-boundary-retry {\n  padding: var(--spacing-md) var(--spacing-xl);\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: transparent;\n  color: var(--color-text);\n  cursor: pointer;\n  transition: background var(--transition-fast);\n}\n\n.error-boundary-retry:hover {\n  background: rgb(255 255 255 / 5%);\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
