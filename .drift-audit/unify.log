ies","+ * already defined in empty-state.css.","+ */","+","+.error-boundary {","+  height: 100%;","+  min-height: 200px;","+}","+","+.error-boundary-icon {","+  width: 48px;","+  height: 48px;","+  border-radius: var(--radius-full);","+  background: rgb(239 68 68 / 15%);","+  color: var(--color-danger);","+  font-size: 24px;","+  font-weight: 700;","+  display: flex;","+  align-items: center;","+  justify-content: center;","+  margin-bottom: var(--spacing-xl);","+}","+","+.error-boundary-message {","+  font-size: var(--font-size-md);","+  word-break: break-word;","+}","+","+.error-boundary-retry {","+  padding: var(--spacing-md) var(--spacing-xl);","+  font-size: var(--font-size-md);","+  font-weight: var(--font-weight-medium);","+  border: 1px solid var(--color-border);","+  border-radius: var(--radius-lg);","+  background: transparent;","+  color: var(--color-text);","+  cursor: pointer;","+  transition: background var(--transition-fast);","+}","+","+.error-boundary-retry:hover {","+  background: rgb(255 255 255 / 5%);","+}"]}],"originalFile":"/**\r\n * ErrorBoundary styles\r\n */\r\n\r\n.error-boundary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: var(--spacing-4xl);\r\n  color: var(--color-text-dim);\r\n  text-align: center;\r\n  height: 100%;\r\n  min-height: 200px;\r\n}\r\n\r\n.error-boundary-icon {\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: var(--radius-full);\r\n  background: rgb(239 68 68 / 15%);\r\n  color: var(--color-danger);\r\n  font-size: 24px;\r\n  font-weight: 700;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: var(--spacing-xl);\r\n}\r\n\r\n.error-boundary-title {\r\n  font-size: var(--font-size-2xl);\r\n  font-weight: var(--font-weight-medium);\r\n  margin-bottom: var(--spacing-md);\r\n  color: var(--color-text);\r\n}\r\n\r\n.error-boundary-message {\r\n  font-size: var(--font-size-md);\r\n  color: var(--color-text-muted);\r\n  max-width: 400px;\r\n  margin-bottom: var(--spacing-2xl);\r\n  word-break: break-word;\r\n}\r\n\r\n.error-boundary-retry {\r\n  padding: var(--spacing-md) var(--spacing-xl);\r\n  font-size: var(--font-size-md);\r\n  font-weight: var(--font-weight-medium);\r\n  border: 1px solid var(--color-border);\r\n  border-radius: var(--radius-lg);\r\n  background: transparent;\r\n  color: var(--color-text);\r\n  cursor: pointer;\r\n  transition: background var(--transition-fast);\r\n}\r\n\r\n.error-boundary-retry:hover {\r\n  background: rgb(255 255 255 / 5%);\r\n}\r\n"}}
