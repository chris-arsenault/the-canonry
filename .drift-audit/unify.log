xt-secondary);\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.htab-annotate-btn:not(:disabled) {\n  cursor: pointer;\n}\n\n.htab-annotate-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.htab-annotate-btn-symbol {\n  font-size: 14px;\n}\n\n.htab-annotate-hint {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Margin notes wrapper */\n.htab-margin-notes {\n  margin-bottom: 20px;\n}\n\n/* Historian Prep */\n.htab-prep-description {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 12px;\n}\n\n.htab-prep-actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.htab-prep-btn {\n  padding: 8px 16px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n}\n\n.htab-prep-btn:not(:disabled) {\n  cursor: pointer;\n}\n\n.htab-prep-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.htab-prep-date {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.htab-prep-content {\n  margin-top: 12px;\n  padding: 12px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  font-size: 13px;\n  line-height: 1.6;\n  color: var(--text-secondary);\n  white-space: pre-wrap;\n  max-height: 300px;\n  overflow: auto;\n}\n\n/* Lore Integration */\n.htab-lore-title {\n  font-size: 14px;\n  font-weight: 600;\n  margin-bottom: 12px;\n}\n\n/* BackportLoreButton */\n.htab-backport-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.htab-backport-btn {\n  padding: 8px 16px;\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n}\n\n.htab-backport-btn:not(:disabled) {\n  cursor: pointer;\n}\n\n.htab-backport-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.htab-backport-status {\n  font-size: 11px;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.htab-backport-status-complete {\n  color: #10b981;\n}\n\n.htab-backport-status-partial {\n  color: #f59e0b;\n}\n\n/* Empty state */\n.htab-empty {\n  font-size: 13px;\n  color: var(--text-muted);\n  padding: 24px;\n  text-align: center;\n}\n\n/* Section title with bottom margin */\n.htab-section-title-mb8 {\n  margin-bottom: 8px;\n}\n\n.htab-section-title-mb12 {\n  margin-bottom: 12px;\n}\n","numLines":236,"startLine":1,"totalLines":236}}}
