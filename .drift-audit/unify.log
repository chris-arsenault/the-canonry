{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KtZaUhd75dkzcoAFN9ThDo","type":"tool_result","content":"     1→import type { Dispatch, SetStateAction } from \"react\";\n     2→import { useState, useEffect } from \"react\";\n     3→\n     4→export interface UseApiKeysReturn {\n     5→  persistApiKeys: boolean;\n     6→  setPersistApiKeys: Dispatch<SetStateAction<boolean>>;\n     7→  anthropicApiKey: string;\n     8→  setAnthropicApiKey: Dispatch<SetStateAction<string>>;\n     9→  openaiApiKey: string;\n    10→  setOpenaiApiKey: Dispatch<SetStateAction<string>>;\n    11→  showApiKeyInput: boolean;\n    12→  setShowApiKeyInput: Dispatch<SetStateAction<boolean>>;\n    13→  hasAnthropicKey: boolean;\n    14→  hasRequiredKeys: boolean;\n    15→}\n    16→\n    17→function readPersistedFlag(key: string): boolean {\n    18→  try {\n    19→    return localStorage.getItem(key) === \"true\";\n    20→  } catch {\n    21→    return false;\n    22→  }\n    23→}\n    24→\n    25→function readPersistedApiKey(keyName: string): string {\n    26→  try {\n    27→    if (localStorage.getItem(\"illuminator:persistApiKeys\") === \"true\") {\n    28→      return localStorage.getItem(keyName) || \"\";\n    29→    }\n    30→  } catch {\n    31→    /* ignored */\n    32→  }\n    33→  return \"\";\n    34→}\n    35→\n    36→export default function useApiKeys(): UseApiKeysReturn {\n    37→  const [persistApiKeys, setPersistApiKeys] = useState<boolean>(() =>\n    38→    readPersistedFlag(\"illuminator:persistApiKeys\")\n    39→  );\n    40→  const [anthropicApiKey, setAnthropicApiKey] = useState<string>(() =>\n    41→    readPersistedApiKey(\"illuminator:anthropicApiKey\")\n    42→  );\n    43→  const [openaiApiKey, setOpenaiApiKey] = useState<string>(() =>\n    44→    readPersistedApiKey(\"illuminator:openaiApiKey\")\n    45→  );\n    46→  const [showApiKeyInput, setShowApiKeyInput] = useState<boolean>(false);\n    47→\n    48→  // Persist API keys when enabled\n    49→  useEffect(() => {\n    50→    try {\n    51→      localStorage.setItem(\"illuminator:persistApiKeys\", persistApiKeys ? \"true\" : \"false\");\n    52→      if (persistApiKeys) {\n    53→        localStorage.setItem(\"illuminator:anthropicApiKey\", anthropicApiKey);\n    54→        localStorage.setItem(\"illuminator:openaiApiKey\", openaiApiKey);\n    55→      } else {\n    56→        localStorage.removeItem(\"illuminator:anthropicApiKey\");\n    57→        localStorage.removeItem(\"illuminator:openaiApiKey\");\n    58→      }\n    59→    } catch {\n    60→      /* ignored */\n    61→    }\n    62→  }, [persistApiKeys, anthropicApiKey, openaiApiKey]);\n    63→\n    64→  const hasAnthropicKey: boolean = anthropicApiKey.length > 0;\n    65→  const hasRequiredKeys: boolean = hasAnthropicKey;\n    66→\n    67→  return {\n    68→    persistApiKeys,\n    69→    setPersistApiKeys,\n    70→    anthropicApiKey,\n    71→    setAnthropicApiKey,\n    72→    openaiApiKey,\n    73→    setOpenaiApiKey,\n    74→    showApiKeyInput,\n    75→    setShowApiKeyInput,\n    76→    hasAnthropicKey,\n    77→    hasRequiredKeys,\n    78→  };\n    79→}\n    80→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"213a0d9d-f16d-4dff-a775-26f9cf7fed0e"}
