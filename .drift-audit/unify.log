border-radius: 8px;\n  background: var(--bg-secondary);\n  font-size: 11px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n.bhm-tone-cycle-label {\n  font-weight: 600;\n  color: var(--text-primary);\n  margin-right: 6px;\n}\n\n.bhm-tone-cycle-arrow {\n  margin: 0 4px;\n  color: var(--text-muted);\n}\n\n.bhm-tone-cycle-symbol {\n  color: #8b7355;\n}\n\n/* Tone picker (edition mode) */\n.bhm-tone-picker {\n  margin-bottom: 12px;\n}\n\n.bhm-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.bhm-tone-options {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.bhm-tone-btn {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  padding: 4px 10px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 11px;\n}\n\n.bhm-tone-btn-default {\n  border: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n  color: var(--text-secondary);\n  font-weight: 400;\n}\n\n.bhm-tone-btn-selected {\n  border: 1px solid #8b7355;\n  background: rgb(139 115 85 / 15%);\n  color: #8b7355;\n  font-weight: 600;\n}\n\n.bhm-tone-btn-symbol {\n  font-size: 12px;\n}\n\n/* Entity list section */\n.bhm-entity-section {\n  margin-bottom: 12px;\n}\n\n.bhm-entity-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.bhm-entity-list {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.bhm-entity-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 12px;\n  font-size: 12px;\n}\n\n.bhm-entity-row-bordered {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.bhm-entity-row-info {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n}\n\n.bhm-entity-tone-symbol {\n  font-size: 11px;\n  color: #8b7355;\n  flex-shrink: 0;\n}\n\n.bhm-entity-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bhm-entity-kind {\n  font-size: 10px;\n  color: var(--text-muted);\n  flex-shrink: 0;\n}\n\n.bhm-entity-tokens {\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n  flex-shrink: 0;\n  color: var(--text-muted);\n}\n\n.bhm-entity-tokens-over {\n  color: #ef4444;\n}\n\n/* Token estimate summary */\n.bhm-token-summary {\n  padding: 8px 12px;\n  border-radius: 6px;\n  font-size: 11px;\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n.bhm-token-summary-ok {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n}\n\n.bhm-token-summary-over {\n  background: rgb(239 68 68 / 8%);\n  border: 1px solid rgb(239 68 68 / 20%);\n}\n\n.bhm-token-limit-note {\n  margin-left: 8px;\n}\n\n.bhm-token-over-warning {\n  color: #ef4444;\n  margin-top: 2px;\n}\n\n/* Processing screen — entity counts detail */\n.bhm-progress-counts {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 16px;\n}\n\n.bhm-progress-failed-count {\n  color: #ef4444;\n  margin-left: 8px;\n}\n\n/* Current entity detail */\n.bhm-current-entity {\n  padding: 12px;\n  border-radius: 8px;\n  background: var(--bg-secondary);\n  margin-bottom: 16px;\n}\n\n.bhm-current-entity-name {\n  font-size: 12px;\n  font-weight: 500;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.bhm-current-entity-tone {\n  color: #8b7355;\n  font-size: 13px;\n}\n\n.bhm-current-entity-status {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n","numLines":215,"startLine":1,"totalLines":215}}}
