{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SREr4xFKqyZuHfo1NKkpkG","type":"tool_result","content":"     1→import { useState, useCallback, useEffect, useRef } from \"react\";\n     2→import { createDefaultEntityGuidance, createDefaultCultureIdentities } from \"../lib/promptBuilders\";\n     3→\n     4→export default function useEntityGuidanceSync({\n     5→  externalEntityGuidance,\n     6→  onEntityGuidanceChange,\n     7→  externalCultureIdentities,\n     8→  onCultureIdentitiesChange,\n     9→}) {\n    10→  const [localEntityGuidance, setLocalEntityGuidance] = useState(createDefaultEntityGuidance);\n    11→  const [localCultureIdentities, setLocalCultureIdentities] = useState(\n    12→    createDefaultCultureIdentities\n    13→  );\n    14→  const pendingEntityGuidanceRef = useRef(localEntityGuidance);\n    15→  const pendingCultureIdentitiesRef = useRef(localCultureIdentities);\n    16→\n    17→  // Detect external changes during render (no ref access)\n    18→  const [prevGuidance, setPrevGuidance] = useState(externalEntityGuidance);\n    19→  if (externalEntityGuidance !== prevGuidance) {\n    20→    setPrevGuidance(externalEntityGuidance);\n    21→    if (externalEntityGuidance !== undefined) {\n    22→      setLocalEntityGuidance(externalEntityGuidance || createDefaultEntityGuidance());\n    23→    }\n    24→  }\n    25→  const [prevIdentities, setPrevIdentities] = useState(externalCultureIdentities);\n    26→  if (externalCultureIdentities !== prevIdentities) {\n    27→    setPrevIdentities(externalCultureIdentities);\n    28→    if (externalCultureIdentities !== undefined) {\n    29→      setLocalCultureIdentities(externalCultureIdentities || createDefaultCultureIdentities());\n    30→    }\n    31→  }\n    32→\n    33→  // Sync refs in effects\n    34→  useEffect(() => {\n    35→    if (externalEntityGuidance !== undefined) {\n    36→      pendingEntityGuidanceRef.current = externalEntityGuidance || createDefaultEntityGuidance();\n    37→    }\n    38→  }, [externalEntityGuidance]);\n    39→  useEffect(() => {\n    40→    if (externalCultureIdentities !== undefined) {\n    41→      pendingCultureIdentitiesRef.current =\n    42→        externalCultureIdentities || createDefaultCultureIdentities();\n    43→    }\n    44→  }, [externalCultureIdentities]);\n    45→\n    46→  const entityGuidanceSyncTimeoutRef = useRef(null);\n    47→  const updateEntityGuidance = useCallback(\n    48→    (nextGuidance) => {\n    49→      setLocalEntityGuidance(nextGuidance);\n    50→      pendingEntityGuidanceRef.current = nextGuidance;\n    51→      if (!onEntityGuidanceChange) return;\n    52→      if (entityGuidanceSyncTimeoutRef.current) clearTimeout(entityGuidanceSyncTimeoutRef.current);\n    53→      entityGuidanceSyncTimeoutRef.current = setTimeout(() => {\n    54→        onEntityGuidanceChange(pendingEntityGuidanceRef.current);\n    55→        entityGuidanceSyncTimeoutRef.current = null;\n    56→      }, 300);\n    57→    },\n    58→    [onEntityGuidanceChange]\n    59→  );\n    60→\n    61→  const cultureIdentitiesSyncTimeoutRef = useRef(null);\n    62→  const updateCultureIdentities = useCallback(\n    63→    (nextIdentities) => {\n    64→      setLocalCultureIdentities(nextIdentities);\n    65→      pendingCultureIdentitiesRef.current = nextIdentities;\n    66→      if (!onCultureIdentitiesChange) return;\n    67→      if (cultureIdentitiesSyncTimeoutRef.current)\n    68→        clearTimeout(cultureIdentitiesSyncTimeoutRef.current);\n    69→      cultureIdentitiesSyncTimeoutRef.current = setTimeout(() => {\n    70→        onCultureIdentitiesChange(pendingCultureIdentitiesRef.current);\n    71→        cultureIdentitiesSyncTimeoutRef.current = null;\n    72→      }, 300);\n    73→    },\n    74→    [onCultureIdentitiesChange]\n    75→  );\n    76→\n    77→  useEffect(\n    78→    () => () => {\n    79→      if (entityGuidanceSyncTimeoutRef.current) clearTimeout(entityGuidanceSyncTimeoutRef.current);\n    80→      if (cultureIdentitiesSyncTimeoutRef.current)\n    81→        clearTimeout(cultureIdentitiesSyncTimeoutRef.current);\n    82→    },\n    83→    []\n    84→  );\n    85→\n    86→  return {\n    87→    entityGuidance: localEntityGuidance,\n    88→    updateEntityGuidance,\n    89→    cultureIdentities: localCultureIdentities,\n    90→    updateCultureIdentities,\n    91→  };\n    92→}\n    93→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"a6f0ea8c-60b9-443e-a725-70dac17b5739"}
