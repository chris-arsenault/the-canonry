ic styles (prefix: bcam-)\n * Overlay, dialog, header, footer, progress bar, terminal, failed list, and cost\n * styles are provided by BulkOperationShell.css. */\n\n.bcam-warning-text {\n  color: #f59e0b;\n}\n\n/* Chronicle list items — two-column layout with tone */\n.bcam-chronicle-item {\n  padding: 6px 12px;\n  border-bottom: 1px solid var(--border-color);\n  font-size: 12px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.bcam-chronicle-item:last-child {\n  border-bottom: none;\n}\n\n.bcam-chronicle-title {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  flex: 1;\n}\n\n.bcam-chronicle-tone {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-left: 8px;\n  flex-shrink: 0;\n}\n\n/* Processing screen — current title and stats */\n.bcam-current-title {\n  font-size: 13px;\n  font-weight: 500;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  margin-bottom: 6px;\n}\n\n.bcam-progress-stats {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: flex;\n  justify-content: space-between;\n}\n","numLines":53,"startLine":1,"totalLines":53}}}
