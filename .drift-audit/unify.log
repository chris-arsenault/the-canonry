{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_013cTXEF9LETRWCAxdWdU16d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UUnhGKTodueU2jKxSSuKjM","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/hooks/useKeyboardNavigation.js","content":"import { useCallback } from \"react\";\n\n/**\n * Reusable keyboard navigation for search dropdowns.\n *\n * Handles ArrowDown/ArrowUp to move selection, Enter to confirm,\n * and Escape with a caller-supplied callback.\n *\n * @param {object} opts\n * @param {Array}    opts.results        - The current result set (Fuse-style objects with `.item.id`).\n * @param {number}   opts.selectedIndex  - Currently highlighted index.\n * @param {Function} opts.setSelectedIndex - State setter for the index.\n * @param {Function} opts.onSelect       - Called with the selected item's id on Enter.\n * @param {Function} opts.onEscape       - Called when Escape is pressed.\n * @returns {Function} A stable onKeyDown handler (memoised via useCallback).\n */\nexport function useKeyboardNavigation({\n  results,\n  selectedIndex,\n  setSelectedIndex,\n  onSelect,\n  onEscape,\n}) {\n  return useCallback(\n    (e) => {\n      if (results.length === 0) return;\n\n      switch (e.key) {\n        case \"ArrowDown\":\n          e.preventDefault();\n          setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n          break;\n        case \"ArrowUp\":\n          e.preventDefault();\n          setSelectedIndex((i) => Math.max(i - 1, 0));\n          break;\n        case \"Enter\":\n          e.preventDefault();\n          if (results[selectedIndex]) onSelect(results[selectedIndex].item.id);\n          break;\n        case \"Escape\":\n          onEscape();\n          break;\n      }\n    },\n    [results, selectedIndex, setSelectedIndex, onSelect, onEscape]\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1600,"cache_read_input_tokens":60111,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1600},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b581011f-7823-4110-9748-054ecf96699a","uuid":"64ac336f-3c1a-43da-8c14-e5a7736951b5"}
