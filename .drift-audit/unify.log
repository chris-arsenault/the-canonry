{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WQd5QZdZmzJcAo1MFVai21","type":"tool_result","content":"  1300→  (systems || []).forEach(sys => {\n  1301→    const config = sys.config;\n  1302→    collectTagsFromFilters(config.selection?.filters, 'systems');\n  1303→    collectTagsFromFilters(config.multiSource?.sourceSelection?.filters, 'systems');\n  1304→    (config.phaseTransitions || []).forEach((transition) => collectTagsFromFilters(transition.selection?.filters, 'systems'));\n  1305→    collectSystemTagsByType(sys, config, addTagUsage, collectTagsFromCondition, collectTagsFromMutations);\n  1306→  });\n  1307→}\n  1308→\n  1309→function scanFeedbackFactorTags(factors, ensureTag, usage) {\n  1310→  (factors || []).forEach(factor => {\n  1311→    if (factor.tag) {\n  1312→      ensureTag(factor.tag);\n  1313→      usage[factor.tag].pressures = (usage[factor.tag].pressures || 0) + 1;\n  1314→    }\n  1315→    if (factor.tags && Array.isArray(factor.tags)) {\n  1316→      factor.tags.forEach(tag => {\n  1317→        ensureTag(tag);\n  1318→        usage[tag].pressures = (usage[tag].pressures || 0) + 1;\n  1319→      });\n  1320→    }\n  1321→  });\n  1322→}\n  1323→\n  1324→function collectPressureTags(pressures, ensureTag, usage) {\n  1325→  (pressures || []).forEach(pressure => {\n  1326→    scanFeedbackFactorTags(pressure.growth?.positiveFeedback, ensureTag, usage);\n  1327→    scanFeedbackFactorTags(pressure.growth?.negativeFeedback, ensureTag, usage);\n  1328→  });\n  1329→}\n  1330→\n  1331→function collectAxisTags(entityKinds, axisDefinitions, ensureTag, usage) {\n  1332→  const axisById = new Map((axisDefinitions || []).map(axis => [axis.id, axis]));\n  1333→  (entityKinds || []).forEach(ek => {\n  1334→    Object.values(ek.semanticPlane?.axes || {}).forEach(axisRef => {\n  1335→      if (!axisRef?.axisId) return;\n  1336→      const axis = axisById.get(axisRef.axisId);\n  1337→      if (!axis) return;\n  1338→      if (axis.lowTag) { ensureTag(axis.lowTag); usage[axis.lowTag].axis = (usage[axis.lowTag].axis || 0) + 1; }\n  1339→      if (axis.highTag) { ensureTag(axis.highTag); usage[axis.highTag].axis = (usage[axis.highTag].axis || 0) + 1; }\n  1340→    });\n  1341→  });\n  1342→}\n  1343→\n  1344→export function computeTagUsage({ cultures, seedEntities, generators, systems, pressures, entityKinds, axisDefinitions } = {}) {\n  1345→  const usage = {};\n  1346→\n  1347→  const ensureTag = (tag) => {\n  1348→    if (!usage[tag]) {\n  1349→      usage[tag] = {};\n  1350→    }\n  1351→  };\n  1352→\n  1353→  const addTagUsage = (tag, section) => {\n  1354→    if (!tag) return;\n  1355→    ensureTag(tag);\n  1356→    usage[tag][section] = (usage[tag][section] || 0) + 1;\n  1357→  };\n  1358→\n  1359→  const collectTagsFromFilters = (filters, section) => {\n  1360→    (filters || []).forEach((filter) => {\n  1361→      switch (filter.type) {\n  1362→        case 'has_tag':\n  1363→        case 'lacks_tag':\n  1364→          addTagUsage(filter.tag, section);\n  1365→          break;\n  1366→        case 'has_tags':\n  1367→        case 'has_any_tag':\n  1368→        case 'lacks_any_tag':\n  1369→          (filter.tags || []).forEach((tag) => addTagUsage(tag, section));\n  1370→          break;\n  1371→        default:\n  1372→          break;\n  1373→      }\n  1374→    });\n  1375→  };\n  1376→\n  1377→  const collectTagsFromCondition = (condition, section) => {\n  1378→    if (!condition) return;\n  1379→    switch (condition.type) {\n  1380→      case 'tag_exists':\n  1381→      case 'tag_absent':\n  1382→        addTagUsage(condition.tag, section);\n  1383→        break;\n  1384→      case 'and':\n  1385→      case 'or':\n  1386→        (condition.conditions || []).forEach((child) => collectTagsFromCondition(child, section));\n  1387→        break;\n  1388→      default:\n  1389→        break;\n  1390→    }\n  1391→  };\n  1392→\n  1393→  const collectTagsFromMutations = (mutations, section) => {\n  1394→    (mutations || []).forEach((mutation) => {\n  1395→      if (mutation.type === 'set_tag' || mutation.type === 'remove_tag') {\n  1396→        addTagUsage(mutation.tag, section);\n  1397→      }\n  1398→    });\n  1399→  };\n  1400→\n  1401→  collectCultureTags(cultures, ensureTag, usage);\n  1402→  collectSeedEntityTags(seedEntities, ensureTag, usage);\n  1403→  collectGeneratorTags(generators, addTagUsage, collectTagsFromCondition, collectTagsFromFilters, collectTagsFromMutations);\n  1404→  collectSystemTags(systems, addTagUsage, collectTagsFromFilters, collectTagsFromCondition, collectTagsFromMutations);\n  1405→  collectPressureTags(pressures, ensureTag, usage);\n  1406→  collectAxisTags(entityKinds, axisDefinitions, ensureTag, usage);\n  1407→\n  1408→  return usage;\n  1409→}\n  1410→\n  1411→/**\n  1412→ * Get a summary of usage for an entity kind (for cross-tool badges)\n  1413→ * @param {Object} schemaUsage - Output from computeSchemaUsage or usageMap.entityKinds\n  1414→ * @param {string} kind - Entity kind ID\n  1415→ * @returns {Object} - { coherence: number, seed: number } for ToolUsageBadges component\n  1416→ */\n  1417→export function getEntityKindUsageSummary(schemaUsage, kind) {\n  1418→  const usage = schemaUsage?.entityKinds?.[kind];\n  1419→  if (!usage) return { coherence: 0 };\n  1420→\n  1421→  const coherenceTotal =\n  1422→    (usage.generators?.length || 0) +\n  1423→    (usage.systems?.length || 0) +\n  1424→    (usage.actions?.length || 0) +\n  1425→    (usage.pressures?.length || 0);\n  1426→\n  1427→  const seedTotal = usage.seeds?.length || 0;\n  1428→\n  1429→  return {\n  1430→    coherence: coherenceTotal,\n  1431→    ...(seedTotal > 0 && { seed: seedTotal }),\n  1432→  };\n  1433→}\n  1434→\n  1435→/**\n  1436→ * Get a summary of usage for a relationship kind (for cross-tool badges)\n  1437→ * @param {Object} schemaUsage - Output from computeSchemaUsage or usageMap.relationshipKinds\n  1438→ * @param {string} kind - Relationship kind ID\n  1439→ * @returns {Object} - { coherence: number } for ToolUsageBadges component\n  1440→ */\n  1441→export function getRelationshipKindUsageSummary(schemaUsage, kind) {\n  1442→  const usage = schemaUsage?.relationshipKinds?.[kind];\n  1443→  if (!usage) return { coherence: 0 };\n  1444→\n  1445→  const total =\n  1446→    (usage.generators?.length || 0) +\n  1447→    (usage.systems?.length || 0) +\n  1448→    (usage.actions?.length || 0);\n  1449→\n  1450→  return { coherence: total };\n  1451→}\n  1452→\n  1453→/**\n  1454→ * Compute schema element usage (simpler version for badge display)\n  1455→ *\n  1456→ * Unlike computeUsageMap which focuses on validation, this function tracks\n  1457→ * usage counts including seed entities for display in Canonry's schema editors.\n  1458→ *\n  1459→ * @param {Object} params\n  1460→ * @param {Array} params.generators - Array of generator configs\n  1461→ * @param {Array} params.systems - Array of system configs\n  1462→ * @param {Array} params.actions - Array of action configs\n  1463→ * @param {Array} params.pressures - Array of pressure configs\n  1464→ * @param {Array} params.seedEntities - Array of seed entities\n  1465→ * @returns {Object} - {\n  1466→ *   entityKinds: { [kindId]: { generators: [], systems: [], actions: [], pressures: [], seeds: [] } },\n  1467→ *   relationshipKinds: { [kindId]: { generators: [], systems: [], actions: [] } },\n  1468→ *   subtypes: { [kindId]: { [subtypeId]: { generators: [], systems: [], seeds: [] } } },\n  1469→ *   statuses: { [kindId]: { [statusId]: { generators: [], systems: [] } } }\n  1470→ * }\n  1471→ */\n  1472→function analyzeSystemSchemaUsage(sys, recordSelectionUsage, addRelationshipKindUsage, addEntityKindUsage, recordConditionUsage, recordMutationUsage) {\n  1473→  const cfg = sys.config;\n  1474→  const sysId = cfg.id;\n  1475→  recordSelectionUsage(cfg.selection, 'systems', sysId);\n  1476→\n  1477→  if (sys.systemType === 'graphContagion') {\n  1478→    if (cfg.contagion?.relationshipKind) addRelationshipKindUsage(cfg.contagion.relationshipKind, 'systems', sysId);\n  1479→    (cfg.vectors || []).forEach((vector) => {\n  1480→      if (vector.relationshipKind) addRelationshipKindUsage(vector.relationshipKind, 'systems', sysId);\n  1481→    });\n  1482→    recordMutationUsage(cfg.infectionAction, 'systems', sysId);\n  1483→    if (cfg.multiSource?.sourceSelection) recordSelectionUsage(cfg.multiSource.sourceSelection, 'systems', sysId);\n  1484→    (cfg.phaseTransitions || []).forEach((transition) => recordSelectionUsage(transition.selection, 'systems', sysId));\n  1485→    return;\n  1486→  }\n  1487→  if (sys.systemType === 'thresholdTrigger') {\n  1488→    (cfg.conditions || []).forEach((condition) => recordConditionUsage(condition, 'systems', sysId));\n  1489→    (cfg.actions || []).forEach((mutation) => recordMutationUsage(mutation, 'systems', sysId));\n  1490→    if (cfg.clusterRelationshipKind) addRelationshipKindUsage(cfg.clusterRelationshipKind, 'systems', sysId);\n  1491→    return;\n  1492→  }\n  1493→  if (sys.systemType === 'connectionEvolution') {\n  1494→    if (cfg.metric?.relationshipKinds) cfg.metric.relationshipKinds.forEach((kind) => addRelationshipKindUsage(kind, 'systems', sysId));\n  1495→    if (cfg.metric?.sharedRelationshipKind) addRelationshipKindUsage(cfg.metric.sharedRelationshipKind, 'systems', sysId);\n  1496→    (cfg.rules || []).forEach((rule) => recordMutationUsage(rule?.action, 'systems', sysId));\n  1497→    return;\n  1498→  }\n  1499→  if (sys.systemType === 'tagDiffusion') {\n  1500→    if (cfg.connectionKind) addRelationshipKindUsage(cfg.connectionKind, 'systems', sysId);\n  1501→    return;\n  1502→  }\n  1503→  if (sys.systemType === 'clusterFormation') {\n  1504→    if (cfg.metaEntity?.kind) addEntityKindUsage(cfg.metaEntity.kind, 'systems', sysId);\n  1505→    (cfg.clustering?.criteria || []).forEach((criterion) => {\n  1506→      if (criterion.type === 'shared_relationship') addRelationshipKindUsage(criterion.relationshipKind, 'systems', sysId);\n  1507→    });\n  1508→  }\n  1509→}\n  1510→\n  1511→export function computeSchemaUsage({\n  1512→  generators = [],\n  1513→  systems = [],\n  1514→  actions = [],\n  1515→  pressures: _pressures = [],\n  1516→  seedEntities = [],\n  1517→}) {\n  1518→  const usage = {\n  1519→    entityKinds: {},\n  1520→    relationshipKinds: {},\n  1521→    subtypes: {},\n  1522→    statuses: {},\n  1523→  };\n  1524→\n  1525→  // Helper to ensure usage entry exists\n  1526→  const ensureEntityKind = (kind) => {\n  1527→    if (!usage.entityKinds[kind]) {\n  1528→      usage.entityKinds[kind] = { generators: [], systems: [], actions: [], pressures: [], seeds: [] };\n  1529→    }\n  1530→  };\n  1531→\n  1532→  const ensureRelationshipKind = (kind) => {\n  1533→    if (!usage.relationshipKinds[kind]) {\n  1534→      usage.relationshipKinds[kind] = { generators: [], systems: [], actions: [] };\n  1535→    }\n  1536→  };\n  1537→\n  1538→  const ensureSubtype = (entityKind, subtype) => {\n  1539→    if (!usage.subtypes[entityKind]) {\n  1540→      usage.subtypes[entityKind] = {};\n  1541→    }\n  1542→    if (!usage.subtypes[entityKind][subtype]) {\n  1543→      usage.subtypes[entityKind][subtype] = { generators: [], systems: [], seeds: [] };\n  1544→    }\n  1545→  };\n  1546→\n  1547→  const ensureStatus = (entityKind, status) => {\n  1548→    if (!usage.statuses[entityKind]) {\n  1549→      usage.statuses[entityKind] = {};\n  1550→    }\n  1551→    if (!usage.statuses[entityKind][status]) {\n  1552→      usage.statuses[entityKind][status] = { generators: [], systems: [] };\n  1553→    }\n  1554→  };\n  1555→\n  1556→  const addEntityKindUsage = (kind, section, id) => {\n  1557→    if (!kind || kind === 'any') return;\n  1558→    ensureEntityKind(kind);\n  1559→    usage.entityKinds[kind][section].push(id);\n  1560→  };\n  1561→\n  1562→  const addRelationshipKindUsage = (kind, section, id) => {\n  1563→    if (!kind) return;\n  1564→    ensureRelationshipKind(kind);\n  1565→    usage.relationshipKinds[kind][section].push(id);\n  1566→  };\n  1567→\n  1568→  const addSubtypeUsage = (kind, subtype, section, id) => {\n  1569→    if (!kind || !subtype) return;\n  1570→    ensureSubtype(kind, subtype);\n  1571→    usage.subtypes[kind][subtype][section].push(id);\n  1572→  };\n  1573→\n  1574→  const addStatusUsage = (kind, status, section, id) => {\n  1575→    if (!kind || !status) return;\n  1576→    ensureStatus(kind, status);\n  1577→    usage.statuses[kind][status][section].push(id);\n  1578→  };\n  1579→\n  1580→  const recordSelectionUsage = (selection, section, id) => {\n  1581→    if (!selection) return;\n  1582→    if (selection.kind) addEntityKindUsage(selection.kind, section, id);\n  1583→    (selection.kinds || []).forEach((kind) => addEntityKindUsage(kind, section, id));\n  1584→  };\n  1585→\n  1586→  const recordConditionUsage = (condition, section, id) => {\n  1587→    if (!condition) return;\n  1588→    switch (condition.type) {\n  1589→      case 'entity_count':\n  1590→        addEntityKindUsage(condition.kind, section, id);\n  1591→        if (condition.subtype) addSubtypeUsage(condition.kind, condition.subtype, section, id);\n  1592→        if (condition.status) addStatusUsage(condition.kind, condition.status, section, id);\n  1593→        break;\n  1594→      case 'relationship_count':\n  1595→      case 'relationship_exists':\n  1596→      case 'entity_has_relationship':\n  1597→        addRelationshipKindUsage(condition.relationshipKind, section, id);\n  1598→        break;\n  1599→      case 'and':"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"c8f38b51-0881-4b0d-8bb3-1fdc58d9598b"}
