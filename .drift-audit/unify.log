viewer-title {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.dependency-viewer-legend {\n  display: flex;\n  gap: var(--spacing-xl);\n  align-items: center;\n}\n\n.dependency-legend-item {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n.dependency-legend-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n\n.dependency-legend-dot-generators {\n  background-color: #60a5fa;\n}\n\n.dependency-legend-dot-systems {\n  background-color: #a855f7;\n}\n\n.dependency-legend-dot-actions {\n  background-color: #22c55e;\n}\n\n.dependency-legend-dot-eras {\n  background-color: #ec4899;\n}\n\n.dependency-viewer-section {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  margin-bottom: var(--spacing-xl);\n  overflow: hidden;\n}\n\n.dependency-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--spacing-lg) var(--spacing-xl);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.dependency-section-header:hover {\n  background-color: rgb(59 130 246 / 5%);\n}\n\n.dependency-section-title {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.dependency-section-count {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-dark);\n  padding: 2px 8px;\n  border-radius: 10px;\n  margin-left: var(--spacing-sm);\n}\n\n.dependency-expand-icon {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  transition: transform var(--transition-fast);\n}\n\n.dependency-expand-icon-open {\n  transform: rotate(180deg);\n}\n\n.dependency-section-content {\n  padding: var(--spacing-md) var(--spacing-xl) var(--spacing-xl);\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n}\n\n.dependency-item-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--color-border-light);\n}\n\n.dependency-item-name {\n  font-size: var(--font-size-md);\n  color: var(--color-text-dim);\n  font-weight: var(--font-weight-medium);\n}\n\n.dependency-used-by-list {\n  display: flex;\n  gap: var(--spacing-sm);\n  flex-wrap: wrap;\n}\n\n.dependency-badge {\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n  text-transform: lowercase;\n}\n\n.dependency-badge-generator {\n  background-color: rgb(96 165 250 / 20%);\n  color: #60a5fa;\n}\n\n.dependency-badge-system {\n  background-color: rgb(168 85 247 / 20%);\n  color: #a855f7;\n}\n\n.dependency-badge-action {\n  background-color: rgb(34 197 94 / 20%);\n  color: #22c55e;\n}\n\n.dependency-badge-pressure {\n  background-color: rgb(245 158 11 / 20%);\n  color: #fbbf24;\n}\n\n.dependency-badge-era {\n  background-color: rgb(236 72 153 / 20%);\n  color: #ec4899;\n}\n\n.dependency-orphan-badge {\n  font-size: var(--font-size-xs);\n  color: var(--color-gray);\n  font-style: italic;\n}\n\n.dependency-empty-state {\n  text-align: center;\n  padding: var(--spacing-4xl);\n  color: var(--color-text-muted);\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
