{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_0178tb8dMRsRnMdKNggBULaA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W9KXSSzTVyrcSMMN6uZTRY","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/ExpandableCard.tsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1400,"cache_read_input_tokens":44921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1400},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"d6b56db1-2a4a-4fb8-b984-0f7d0828303e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W9KXSSzTVyrcSMMN6uZTRY","type":"tool_result","content":"     1→/**\n     2→ * ExpandableCard - A collapsible card with header and body sections\n     3→ *\n     4→ * Used for list items that expand to show detailed content.\n     5→ */\n     6→\n     7→import React, { useCallback } from 'react';\n     8→\n     9→interface ExpandableCardProps {\n    10→  expanded: boolean;\n    11→  onToggle: (id?: string) => void;\n    12→  toggleId?: string;\n    13→  title: React.ReactNode;\n    14→  subtitle?: React.ReactNode;\n    15→  actions?: React.ReactNode;\n    16→  children?: React.ReactNode;\n    17→  className?: string;\n    18→}\n    19→\n    20→/**\n    21→ * @param {Object} props\n    22→ * @param {boolean} props.expanded - Whether the card is expanded\n    23→ * @param {Function} props.onToggle - Called when header is clicked. If toggleId is provided, calls onToggle(toggleId).\n    24→ * @param {string} [props.toggleId] - Optional ID passed back to onToggle, enabling stable callbacks in list renders\n    25→ * @param {React.ReactNode} props.title - Main title content\n    26→ * @param {React.ReactNode} [props.subtitle] - Optional subtitle/ID display\n    27→ * @param {React.ReactNode} [props.actions] - Right-side header content (badges, summary)\n    28→ * @param {React.ReactNode} props.children - Body content (shown when expanded)\n    29→ * @param {string} [props.className] - Additional class for the container\n    30→ */\n    31→export function ExpandableCard({\n    32→  expanded,\n    33→  onToggle,\n    34→  toggleId,\n    35→  title,\n    36→  subtitle,\n    37→  actions,\n    38→  children,\n    39→  className = '',\n    40→}: ExpandableCardProps) {\n    41→  const handleToggle = useCallback(() => {\n    42→    if (toggleId !== undefined) {\n    43→      onToggle(toggleId);\n    44→    } else {\n    45→      onToggle();\n    46→    }\n    47→  }, [onToggle, toggleId]);\n    48→\n    49→  return (\n    50→    <div className={`expandable-card ${className}`.trim()}>\n    51→      <div className=\"expandable-card-header\" onClick={handleToggle} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleToggle(); }} >\n    52→        <div className=\"expandable-card-left\">\n    53→          <span\n    54→            className={`expand-icon ${expanded ? 'expand-icon-expanded' : 'expand-icon-collapsed'}`}\n    55→          >\n    56→            ▶\n    57→          </span>\n    58→          <div className=\"expandable-card-title\">\n    59→            <span className=\"expandable-card-name\">{title}</span>\n    60→            {subtitle && <span className=\"expandable-card-id\">{subtitle}</span>}\n    61→          </div>\n    62→        </div>\n    63→        {actions && <div className=\"expandable-card-actions\">{actions}</div>}\n    64→      </div>\n    65→      {expanded && (\n    66→        <div className=\"expandable-card-content\">\n    67→          {children}\n    68→        </div>\n    69→      )}\n    70→    </div>\n    71→  );\n    72→}\n    73→\n    74→export default ExpandableCard;\n    75→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"5cd00f88-31c0-420b-8b42-c5c208811d7f"}
