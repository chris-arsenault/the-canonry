  gap: 4px;\n  margin-bottom: 8px;\n  align-items: center;\n}\n\n.isd-special-toggle-btn {\n  padding: 3px 10px;\n  font-size: 11px;\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  background: transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n}\n\n.isd-special-toggle-btn[data-selected=\"true\"] {\n  border-color: var(--accent-color);\n  background: rgb(168 85 247 / 20%);\n  color: var(--accent-color);\n}\n\n.isd-pool-info {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-left: 4px;\n}\n\n/* ─── CollapsibleSection ─── */\n.isd-section {\n  margin-bottom: 4px;\n}\n\n.isd-section-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  padding: 8px 0;\n  background: none;\n  border: none;\n  color: var(--text-color);\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  text-align: left;\n}\n\n.isd-section-chevron {\n  display: inline-block;\n  width: 12px;\n  font-size: 10px;\n  color: var(--text-muted);\n  transition: transform 0.15s ease;\n}\n\n.isd-section-chevron[data-collapsed=\"false\"] {\n  transform: rotate(90deg);\n}\n\n.isd-section-badge {\n  margin-left: auto;\n  font-size: 10px;\n  color: var(--accent-color);\n  padding: 1px 6px;\n  background: rgb(168 85 247 / 15%);\n  border-radius: 3px;\n}\n\n.isd-section-content {\n  padding-left: 18px;\n  padding-bottom: 8px;\n}\n\n/* ─── SwatchStrip ─── */\n.isd-swatch-strip {\n  display: flex;\n  gap: 2px;\n}\n\n.isd-swatch {\n  width: 14px;\n  height: 14px;\n  border-radius: 3px;\n  border: 1px solid rgb(255 255 255 / 15%);\n  background: var(--swatch-bg);\n}\n\n/* ─── Backdrop ─── */\n.isd-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 40%);\n  z-index: 9998;\n}\n\n/* ─── Drawer ─── */\n.isd-drawer {\n  position: fixed;\n  top: 0;\n  left: 200px;\n  bottom: 0;\n  width: 380px;\n  background: var(--bg-primary);\n  border-right: 1px solid var(--border-color);\n  z-index: 9999;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 4px 0 24px rgb(0 0 0 / 30%);\n  overflow: hidden;\n}\n\n/* Header */\n.isd-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border-color);\n  flex-shrink: 0;\n}\n\n.isd-header-title {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.isd-close-btn {\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  font-size: 18px;\n  cursor: pointer;\n  padding: 0 4px;\n  line-height: 1;\n}\n\n/* Scrollable content */\n.isd-scroll {\n  flex: 1;\n  overflow-y: auto;\n  padding: 12px 16px;\n}\n\n.isd-loading {\n  color: var(--text-muted);\n  font-size: 12px;\n  padding: 12px 0;\n}\n\n/* Category tab strip */\n.isd-category-tabs {\n  display: flex;\n  gap: 2px;\n  margin-bottom: 8px;\n  flex-wrap: wrap;\n}\n\n.isd-category-tab {\n  padding: 3px 8px;\n  font-size: 10px;\n  border-radius: 3px;\n  border: 1px solid var(--border-color);\n  background: transparent;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n  font-weight: 400;\n}\n\n.isd-category-tab[data-active=\"true\"] {\n  border-color: var(--accent-color);\n  background: rgb(168 85 247 / 15%);\n  color: var(--accent-color);\n  font-weight: 600;\n}\n\n/* Style/composition list */\n.isd-item-list {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.isd-item-btn {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 5px 8px;\n  border-radius: 4px;\n  border: 1px solid transparent;\n  background: transparent;\n  cursor: pointer;\n  text-align: left;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n  width: 100%;\n}\n\n.isd-item-btn[data-selected=\"true\"] {\n  border-color: var(--accent-color);\n  background: rgb(168 85 247 / 12%);\n}\n\n.isd-item-name {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--text-color);\n  flex-shrink: 0;\n}\n\n.isd-item-btn[data-selected=\"true\"] .isd-item-name {\n  color: var(--accent-color);\n}\n\n.isd-item-name-composition {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--text-color);\n  flex-shrink: 0;\n  min-width: 0;\n}\n\n.isd-item-btn[data-selected=\"true\"] .isd-item-name-composition {\n  color: var(--accent-color);\n}\n\n.isd-item-desc {\n  font-size: 10px;\n  color: var(--text-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n/* Section divider */\n.isd-divider {\n  border-top: 1px solid var(--border-color);\n  margin: 4px 0;\n}\n\n/* Palette group */\n.isd-palette-group {\n  margin-bottom: 8px;\n}\n\n.isd-palette-group-label {\n  font-size: 10px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: 4px;\n}\n\n.isd-palette-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 4px;\n}\n\n.isd-palette-btn {\n  padding: 6px;\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  background: var(--bg-tertiary);\n  cursor: pointer;\n  text-align: left;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n}\n\n.isd-palette-btn[data-selected=\"true\"] {\n  border-color: var(--accent-color);\n  background: rgb(168 85 247 / 12%);\n}\n\n.isd-palette-swatch-row {\n  margin-bottom: 4px;\n}\n\n.isd-palette-name {\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--text-color);\n  line-height: 1.2;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.isd-palette-btn[data-selected=\"true\"] .isd-palette-name {\n  color: var(--accent-color);\n}\n\n/* Output section */\n.isd-output-group {\n  margin-bottom: 10px;\n}\n\n.isd-output-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.isd-output-btns {\n  display: flex;\n  gap: 3px;\n  flex-wrap: wrap;\n}\n\n.isd-output-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n  font-weight: 400;\n}\n\n.isd-output-btn[data-selected=\"true\"] {\n  border-color: var(--accent-color);\n  background: rgb(168 85 247 / 20%);\n  color: var(--accent-color);\n  font-weight: 600;\n}\n\n.isd-culture-select {\n  width: 100%;\n}\n\n/* ─── ImageSettingsSummary ─── */\n.isd-summary {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  margin-bottom: 12px;\n  flex-wrap: wrap;\n}\n\n.isd-summary-label {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.isd-summary-value {\n  font-size: 11px;\n  color: var(--text-secondary);\n}\n\n.isd-summary-settings-btn {\n  margin-left: auto;\n  padding: 2px 8px;\n  font-size: 10px;\n  border-radius: 3px;\n  border: 1px solid var(--border-color);\n  background: transparent;\n  color: var(--accent-color);\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n}\n\n/* ─── ImageSettingsTrigger ─── */\n.isd-trigger {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  width: 100%;\n  padding: 8px 10px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: 11px;\n  cursor: pointer;\n  transition:\n    border-color 0.15s ease,\n    background 0.15s ease,\n    color 0.15s ease;\n  text-align: left;\n}\n\n.isd-trigger-header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n}\n\n.isd-trigger-title {\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.isd-trigger-detail {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n  color: var(--text-muted);\n  overflow: hidden;\n}\n\n.isd-trigger-text {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n","numLines":438,"startLine":1,"totalLines":438}}}
