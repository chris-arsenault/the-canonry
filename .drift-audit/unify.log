{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F7B1CJ33M6UBzqAayHmu1o","type":"tool_result","content":"     1→/**\n     2→ * IconButton - Small icon-only button\n     3→ */\n     4→\n     5→import React from 'react';\n     6→import PropTypes from 'prop-types';\n     7→\n     8→/**\n     9→ * @param {Object} props\n    10→ * @param {string} props.icon - Icon content (emoji or text)\n    11→ * @param {Function} props.onClick - Callback when button is clicked\n    12→ * @param {boolean} [props.danger] - Apply danger styling\n    13→ * @param {string} [props.title] - Tooltip text\n    14→ * @param {string} [props.className] - Optional additional class names\n    15→ */\n    16→export function IconButton({ icon, onClick, danger, title, className = '' }) {\n    17→  const classes = [\n    18→    'btn-icon',\n    19→    danger ? 'btn-icon-danger' : '',\n    20→    className,\n    21→  ].filter(Boolean).join(' ');\n    22→\n    23→  return (\n    24→    <button\n    25→      type=\"button\"\n    26→      className={classes}\n    27→      onClick={onClick}\n    28→      title={title}\n    29→    >\n    30→      {icon}\n    31→    </button>\n    32→  );\n    33→}\n    34→\n    35→export default IconButton;\n    36→\n    37→IconButton.propTypes = {\n    38→  icon: PropTypes.string.isRequired,\n    39→  onClick: PropTypes.func.isRequired,\n    40→  danger: PropTypes.bool,\n    41→  title: PropTypes.string,\n    42→  className: PropTypes.string,\n    43→};\n    44→"}]},"parent_tool_use_id":"toolu_01MSjwERvzq8tWa6PqUQiEqU","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"f609aaa9-000c-43aa-a810-0112f40629df"}
