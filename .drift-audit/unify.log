.tps-header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.tps-header-btn {\n  padding: 4px 8px;\n  font-size: 11px;\n}\n\n.tps-description {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 16px;\n}\n\n.tps-stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n.tps-stat-card {\n  padding: 10px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  text-align: center;\n}\n\n.tps-stat-value {\n  font-size: 20px;\n  font-weight: 600;\n}\n\n.tps-stat-label {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.tps-kind-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.tps-kind-card {\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.tps-kind-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 12px;\n  background: var(--bg-secondary);\n  cursor: pointer;\n}\n\n.tps-kind-header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.tps-kind-badge {\n  font-weight: 600;\n  font-size: 13px;\n  padding: 2px 8px;\n  background: var(--accent-color);\n  color: white;\n  border-radius: 4px;\n}\n\n.tps-category-count {\n  font-size: 11px;\n  padding: 2px 6px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  color: var(--text-muted);\n}\n\n.tps-kind-header-right {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.tps-expand-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n}\n\n.tps-expand-icon {\n  font-size: 14px;\n  color: var(--text-muted);\n  transition: transform 0.2s;\n}\n\n.tps-expand-icon-open {\n  transform: rotate(180deg);\n}\n\n.tps-expand-icon-closed {\n  transform: rotate(0deg);\n}\n\n.tps-kind-body {\n  padding: 12px;\n}\n\n.tps-kind-empty {\n  padding: 20px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n.tps-palette-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.tps-palette-item {\n  padding: 10px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n}\n\n.tps-palette-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 6px;\n}\n\n.tps-palette-category {\n  font-weight: 500;\n  font-size: 13px;\n}\n\n.tps-usage-badge {\n  font-size: 10px;\n  padding: 2px 5px;\n  border-radius: 3px;\n}\n\n.tps-usage-badge-used {\n  background: var(--accent-color);\n  color: white;\n}\n\n.tps-usage-badge-unused {\n  background: var(--bg-secondary);\n  color: var(--text-muted);\n}\n\n.tps-palette-description {\n  font-size: 12px;\n  color: var(--text-secondary);\n  margin-bottom: 6px;\n}\n\n.tps-palette-examples {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.tps-binding-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  margin-top: 8px;\n}\n\n.tps-era-tag {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: rgba(168, 85, 247, 0.2);\n  color: #a855f7;\n  border-radius: 3px;\n  border: 1px solid rgba(168, 85, 247, 0.3);\n}\n\n.tps-subtype-tag {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: rgba(59, 130, 246, 0.2);\n  color: #3b82f6;\n  border-radius: 3px;\n  border: 1px solid rgba(59, 130, 246, 0.3);\n}\n\n/* Errors */\n.tps-error-section {\n  margin-top: 16px;\n  padding: 12px;\n  border-radius: 6px;\n  background: rgba(239, 68, 68, 0.1);\n  border: 1px solid rgba(239, 68, 68, 0.3);\n}\n\n.tps-error-content {\n  font-size: 12px;\n  color: #ef4444;\n}\n\n.tps-error-item {\n  margin-top: 4px;\n}\n","numLines":228,"startLine":1,"totalLines":228}}}
