{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019dqzaFrHLTcxAgLgDuRqbb","type":"tool_result","content":"     1→/**\n     2→ * LevelSelector - Visual level selector with configurable levels\n     3→ *\n     4→ * Supports:\n     5→ * - Click-to-select levels (for both string and numeric values)\n     6→ * - Optional numeric input for precise values (numeric mode only)\n     7→ * - Partial fill visualization for intermediate values (numeric mode)\n     8→ */\n     9→\n    10→import React, { useState } from 'react';\n    11→\n    12→interface LevelDefinition {\n    13→  value: number | string;\n    14→  label: string;\n    15→  color: string;\n    16→}\n    17→\n    18→interface LevelSelectorProps {\n    19→  value: number | string;\n    20→  onChange: (value: number | string) => void;\n    21→  levels: LevelDefinition[];\n    22→  showNumeric?: boolean;\n    23→  min?: number;\n    24→  max?: number;\n    25→  step?: number;\n    26→  className?: string;\n    27→}\n    28→\n    29→/**\n    30→ * @param {Object} props\n    31→ * @param {number|string} props.value - Current value\n    32→ * @param {Function} props.onChange - Called when value changes\n    33→ * @param {Array<{value: number|string, label: string, color: string}>} props.levels - Level definitions\n    34→ * @param {boolean} [props.showNumeric] - Show numeric input (default false, only for numeric values)\n    35→ * @param {number} [props.min] - Minimum value for numeric input (default 0)\n    36→ * @param {number} [props.max] - Maximum value for numeric input (default 10)\n    37→ * @param {number} [props.step] - Step for numeric input (default 0.1)\n    38→ * @param {string} [props.className] - Additional class names\n    39→ */\n    40→export function LevelSelector({\n    41→  value,\n    42→  onChange,\n    43→  levels,\n    44→  showNumeric = false,\n    45→  min = 0,\n    46→  max = 10,\n    47→  step = 0.1,\n    48→  className = '',\n    49→}: LevelSelectorProps) {\n    50→  const [hoveredLevel, setHoveredLevel] = useState(null);\n    51→\n    52→  // Detect if using numeric or string mode\n    53→  const isNumeric = typeof levels[0]?.value === 'number';\n    54→\n    55→  // Get level index based on value\n    56→  const getLevelIndex = (val) => {\n    57→    if (isNumeric) {\n    58→      for (let i = levels.length - 1; i >= 0; i--) {\n    59→        if (val >= levels[i].value) return i;\n    60→      }\n    61→      return 0;\n    62→    } else {\n    63→      const idx = levels.findIndex(l => l.value === val);\n    64→      return idx >= 0 ? idx : 0;\n    65→    }\n    66→  };\n    67→\n    68→  const levelIndex = getLevelIndex(value);\n    69→  const currentLevel = levels[levelIndex];\n    70→  const hoverLevel = hoveredLevel !== null ? levels[hoveredLevel] : null;\n    71→\n    72→  // Calculate partial fill for each dot (only meaningful for numeric mode)\n    73→  const getPartialFill = (idx) => {\n    74→    if (!isNumeric) {\n    75→      // String mode: full fill up to and including current level\n    76→      return idx <= levelIndex ? 1 : 0;\n    77→    }\n    78→    if (idx < levelIndex) return 1;\n    79→    if (idx > levelIndex) return 0;\n    80→    // Current level - calculate partial based on value position\n    81→    const levelStart = levels[idx].value;\n    82→    const levelEnd = idx < levels.length - 1 ? levels[idx + 1].value : max;\n    83→    const progress = (value - levelStart) / (levelEnd - levelStart);\n    84→    return Math.max(0, Math.min(1, progress));\n    85→  };\n    86→\n    87→  return (\n    88→    <div className={`level-selector ${className}`.trim()}>\n    89→      <div className=\"level-selector-dots\">\n    90→        {levels.map((level, idx) => {\n    91→          const isHovered = hoveredLevel !== null && idx <= hoveredLevel;\n    92→          const fill = getPartialFill(idx);\n    93→          const baseColor = isHovered ? hoverLevel.color : currentLevel.color;\n    94→\n    95→          return (\n    96→            <div\n    97→              key={idx}\n    98→              className={`level-selector-dot ${hoveredLevel === idx ? 'level-selector-dot-active' : ''}`.trim()}\n    99→              onClick={() => onChange(level.value)}\n   100→              onMouseEnter={() => setHoveredLevel(idx)}\n   101→              onMouseLeave={() => setHoveredLevel(null)}\n   102→              title={`${level.label}`}\n   103→              role=\"button\"\n   104→              tabIndex={0}\n   105→              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n   106→            >\n   107→              <svg className=\"level-selector-dot-fill-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n   108→                <rect\n   109→                  x=\"0\"\n   110→                  y={100 - (fill * 100)}\n   111→                  width=\"100\"\n   112→                  height={fill * 100}\n   113→                  fill={baseColor}\n   114→                />\n   115→              </svg>\n   116→            </div>\n   117→          );\n   118→        })}\n   119→      </div>\n   120→      {showNumeric && isNumeric && (\n   121→        <input\n   122→          type=\"number\"\n   123→          className=\"level-selector-input\"\n   124→          value={value}\n   125→          onChange={(e) => {\n   126→            const newVal = parseFloat(e.target.value);\n   127→            if (!isNaN(newVal)) {\n   128→              onChange(Math.max(min, Math.min(max, newVal)));\n   129→            }\n   130→          }}\n   131→          step={step}\n   132→          min={min}\n   133→          max={max}\n   134→        />\n   135→      )}\n   136→    </div>\n   137→  );\n   138→}\n   139→\n   140→// Common level presets\n   141→export const STRENGTH_LEVELS = [\n   142→  { value: 0, label: 'Off', color: '#475569' },\n   143→  { value: 1, label: 'Low', color: '#3b82f6' },\n   144→  { value: 2, label: 'Medium', color: '#22c55e' },\n   145→  { value: 3, label: 'High', color: '#f59e0b' },\n   146→  { value: 4, label: 'Max', color: '#ef4444' },\n   147→];\n   148→\n   149→export const PROMINENCE_LEVELS = [\n   150→  { value: 'forgotten', label: 'Forgotten', color: '#6b7280' },\n   151→  { value: 'marginal', label: 'Marginal', color: '#60a5fa' },\n   152→  { value: 'recognized', label: 'Recognized', color: '#34d399' },\n   153→  { value: 'renowned', label: 'Renowned', color: '#fbbf24' },\n   154→  { value: 'mythic', label: 'Mythic', color: '#a855f7' },\n   155→];\n   156→"}]},"parent_tool_use_id":"toolu_01FzRVY2V2nJRXov651T5ucP","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"d8a5bc1e-e7ff-42b4-bf8c-c529ec70dce0"}
