  color: var(--color-orange-200);\n  font-weight: var(--font-weight-semibold);\n  font-family: var(--font-mono);\n  text-decoration: underline;\n  cursor: pointer;\n  transition: color var(--transition-normal);\n}\n\n.discovery-story-explorer-link:hover {\n  color: var(--color-text-primary);\n}\n\n.discovery-story-type-badge {\n  padding: 2px var(--spacing-md);\n  border-radius: var(--radius-2xl);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  font-size: var(--font-size-2xs);\n}\n\n.discovery-story-type-pressure {\n  background: var(--color-bg-red-20);\n  border: 1px solid var(--color-bg-red-border);\n  color: var(--color-red-300);\n}\n\n.discovery-story-type-chain {\n  background: var(--color-bg-purple-20);\n  border: 1px solid var(--color-bg-purple-border);\n  color: var(--color-purple-300);\n}\n\n.discovery-story-section {\n  border-bottom: 1px solid rgb(217 119 6 / 15%);\n}\n\n.discovery-story-section:last-child {\n  border-bottom: none;\n}\n\n.discovery-story-section-header {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background: rgb(217 119 6 / 5%);\n  border: none;\n  cursor: pointer;\n  transition: background var(--transition-normal);\n  text-align: left;\n}\n\n.discovery-story-section-header:hover {\n  background: rgb(217 119 6 / 10%);\n}\n\n.discovery-story-section-icon {\n  color: var(--color-orange-300);\n  font-size: var(--font-size-2xs);\n  width: 12px;\n  font-weight: var(--font-weight-bold);\n}\n\n.discovery-story-section-title {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-orange-300);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.discovery-story-section-content {\n  padding: var(--spacing-lg);\n  font-family: var(--font-serif);\n  font-size: var(--font-size-base);\n  line-height: var(--line-height-loose);\n  color: var(--color-orange-200);\n  font-style: italic;\n  background: var(--color-bg-deep-80);\n}\n\n/* Modal Mode */\n.discovery-story-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 75%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: var(--z-modal-overlay);\n  padding: var(--spacing-2xl);\n}\n\n.discovery-story-modal-content {\n  max-width: 700px;\n  width: 100%;\n  max-height: 80vh;\n  overflow-y: auto;\n  box-shadow: var(--shadow-2xl);\n  background: var(--gradient-bg-header);\n}\n\n.discovery-story-footer {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  padding: var(--spacing-xl) var(--spacing-lg);\n  border-top: 1px solid rgb(217 119 6 / 20%);\n  background: rgb(217 119 6 / 5%);\n}\n\n.discovery-story-close {\n  padding: var(--spacing-md) var(--spacing-3xl);\n  background: linear-gradient(135deg, rgb(217 119 6 / 30%) 0%, rgb(180 83 9 / 30%) 100%);\n  border: 1px solid rgb(217 119 6 / 50%);\n  border-radius: var(--radius-md);\n  color: var(--color-orange-300);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n}\n\n.discovery-story-close:hover {\n  background: linear-gradient(135deg, rgb(217 119 6 / 40%) 0%, rgb(180 83 9 / 40%) 100%);\n  border-color: rgb(217 119 6 / 70%);\n  color: var(--color-text-primary);\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-md);\n}\n"}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01CEmnQxvp92e5XsKywdKPox","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KA9hhef6791McAJJCJdHJK","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/DiscoveryStory.tsx","content":"import React, { useState, useRef } from \"react\";\nimport type { DiscoveryEventLore } from \"../types/world.ts\";\nimport \"./archivist-section.css\";\nimport \"./DiscoveryStory.css\";\n\ninterface DiscoveryStoryProps {\n  lore: DiscoveryEventLore;\n  onExplorerClick?: (explorerId: string) => void;\n  onClose?: () => void; // Optional close handler for modal mode\n  isModal?: boolean; // Whether to render as modal\n}\n\nexport default function DiscoveryStory({\n  lore,\n  onExplorerClick,\n  onClose,\n  isModal = false,\n}: Readonly<DiscoveryStoryProps>) {\n  const [expandedSection, setExpandedSection] = useState<\"discovery\" | \"significance\" | null>(\n    \"discovery\"\n  );\n  const mouseDownOnOverlay = useRef(false);\n\n  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    mouseDownOnOverlay.current = e.target === e.currentTarget;\n  };\n\n  const handleOverlayClick = (e: React.MouseEvent) => {\n    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n      onClose?.();\n    }\n  };\n\n  const toggleSection = (section: \"discovery\" | \"significance\") => {\n    setExpandedSection(expandedSection === section ? null : section);\n  };\n\n  // Check if explorer is an entity ID (starts with known prefixes)\n  const isEntityId = lore.metadata.explorer.match(/^(npc_|faction_|location_)/);\n\n  const content = (\n    <div className={`archivist-section discovery-story ${isModal ? \"discovery-story-modal-content\" : \"\"}`}>\n      <div className=\"archivist-section-hdr\">\n        <span className=\"archivist-section-icon\">🧭</span>\n        <span className=\"archivist-section-title\">Discovery Story</span>\n      </div>\n\n      <div className=\"discovery-story-meta\">\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"archivist-label discovery-story-meta-label\">Discovered by:</span>\n          {isEntityId && onExplorerClick ? (\n            <button\n              onClick={() => onExplorerClick(lore.metadata.explorer)}\n              className=\"discovery-story-explorer-link\"\n            >\n              {lore.metadata.explorer}\n            </button>\n          ) : (\n            <span className=\"discovery-story-meta-value\">{lore.metadata.explorer}</span>\n          )}\n        </div>\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"archivist-label discovery-story-meta-label\">When:</span>\n          <span className=\"discovery-story-meta-value\">Tick {lore.metadata.tick}</span>\n        </div>\n        <div className=\"discovery-story-meta-row\">\n          <span className=\"archivist-label discovery-story-meta-label\">Method:</span>\n          <span\n            className={`discovery-story-type-badge discovery-story-type-${lore.metadata.discoveryType}`}\n          >\n            {lore.metadata.discoveryType}\n          </span>\n        </div>\n      </div>\n\n      {/* The Discovery */}\n      <div className=\"discovery-story-section\">\n        <button\n          onClick={() => toggleSection(\"discovery\")}\n          className=\"discovery-story-section-header\"\n        >\n          <span className=\"discovery-story-section-icon\">\n            {expandedSection === \"discovery\" ? \"▼\" : \"▶\"}\n          </span>\n          <span className=\"archivist-section-title\">The Discovery</span>\n        </button>\n        {expandedSection === \"discovery\" && (\n          <div className=\"archivist-narrative discovery-story-section-content\">{lore.text}</div>\n        )}\n      </div>\n\n      {/* Why It Matters */}\n      <div className=\"discovery-story-section\">\n        <button\n          onClick={() => toggleSection(\"significance\")}\n          className=\"discovery-story-section-header\"\n        >\n          <span className=\"discovery-story-section-icon\">\n            {expandedSection === \"significance\" ? \"▼\" : \"▶\"}\n          </span>\n          <span className=\"archivist-section-title\">Why It Matters</span>\n        </button>\n        {expandedSection === \"significance\" && (\n          <div className=\"archivist-narrative discovery-story-section-content\">{lore.metadata.significance}</div>\n        )}\n      </div>\n\n      {/* Close button for modal mode */}\n      {isModal && onClose && (\n        <div className=\"archivist-section-footer discovery-story-footer\">\n          <button onClick={onClose} className=\"archivist-close-btn discovery-story-close\">\n            Close\n          </button>\n        </div>\n      )}\n    </div>\n  );\n\n  // Wrap in modal overlay if in modal mode\n  if (isModal && onClose) {\n    return (\n      <div\n        className=\"archivist-modal-overlay discovery-story-overlay\"\n        onMouseDown={handleOverlayMouseDown}\n        onClick={handleOverlayClick}\n        role=\"button\"\n        tabIndex={0}\n        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n      >\n        <div>{content}</div>\n      </div>\n    );\n  }\n\n  return content;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1934,"cache_read_input_tokens":91567,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1934},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"dbc9a4ee-ffa3-429e-a88a-df963ee40d31"}
