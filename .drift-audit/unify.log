========================================================= */\n   455→\n   456→.danger-zone {\n   457→  margin-top: var(--spacing-2xl);\n   458→  padding-top: var(--spacing-xl);\n   459→  border-top: 1px solid rgb(239 68 68 / 30%);\n   460→  display: flex;\n   461→  gap: var(--spacing-lg);\n   462→}\n   463→\n   464→/* ==========================================================================\n   465→   Path constraint card (compact inline constraint editor)\n   466→   ========================================================================== */\n   467→\n   468→.path-constraint-card {\n   469→  background-color: var(--color-bg-nested);\n   470→  border: 1px solid var(--color-border-light);\n   471→  border-radius: var(--radius-md);\n   472→  padding: var(--spacing-md);\n   473→  display: flex;\n   474→  flex-direction: column;\n   475→  gap: var(--spacing-sm);\n   476→}\n   477→\n   478→.path-constraint-header {\n   479→  display: flex;\n   480→  align-items: center;\n   481→  justify-content: space-between;\n   482→}\n   483→\n   484→.path-constraint-label {\n   485→  font-size: var(--font-size-sm);\n   486→  font-weight: var(--font-weight-medium);\n   487→  color: var(--color-accent);\n   488→}\n   489→\n   490→.constraint-fields-grid {\n   491→  display: grid;\n   492→  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n   493→  gap: var(--spacing-md);\n   494→}\n   495→"}]},"parent_tool_use_id":null,"session_id":"4f674cf0-9f5a-4696-8008-0664523e53e2","uuid":"2fac4c6a-7f72-461d-8c18-b7db392622c2","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/styles/components/editor.css","content":"/**\n * Editor layout styles - common patterns across all editors\n */\n\n/* Main editor container */\n.editor-container {\n  padding: var(--spacing-2xl);\n  color: var(--color-text);\n}\n\n/* Editor header */\n.header {\n  margin-bottom: var(--spacing-2xl);\n}\n\n.title {\n  font-size: var(--font-size-3xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin: 0 0 var(--spacing-md) 0;\n}\n\n.subtitle {\n  font-size: var(--font-size-lg);\n  color: var(--color-text-muted);\n  margin: 0;\n}\n\n/* ==========================================================================\n   List layouts\n   ========================================================================== */\n\n/* Multi-column responsive grid for clickable cards */\n.list-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));\n  gap: var(--spacing-xl);\n}\n\n/* Single column stack for expandable cards */\n.list-stack {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-lg);\n}\n\n/* Items grid (vertical stack for nested items) */\n.items-grid {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n/* Add container */\n.add-container {\n  margin-top: var(--spacing-lg);\n}\n\n/* Tab content area */\n.tab-content {\n  padding: var(--spacing-xl);\n}\n\n/* Input grid layouts */\n.input-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 10px;\n}\n\n/* ==========================================================================\n   Stat displays\n   ========================================================================== */\n\n.stat {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.stat-label {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.stat-value {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-accent);\n}\n\n.stat-bar {\n  width: 60px;\n  height: 4px;\n  background-color: var(--color-bg-dark);\n  border-radius: 2px;\n  margin-top: var(--spacing-xs);\n  overflow: hidden;\n}\n\n.stat-bar-fill {\n  height: 100%;\n  border-radius: 2px;\n  transition: width var(--transition-normal);\n}\n\n/* ==========================================================================\n   Expandable card - cards that expand inline to show content\n   ========================================================================== */\n\n.expandable-card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  overflow: hidden;\n}\n\n.expandable-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--spacing-xl);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.expandable-card-header:hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.expandable-card-left {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-lg);\n}\n\n.expandable-card-title {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.expandable-card-name {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.expandable-card-id {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  font-family: monospace;\n}\n\n.expandable-card-desc {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin-top: var(--spacing-md);\n}\n\n.expandable-card-stats {\n  display: flex;\n  gap: var(--spacing-xl);\n}\n\n.expandable-card-content {\n  padding: var(--spacing-lg) var(--spacing-xl);\n  border-top: 1px solid var(--color-border-light);\n  background-color: var(--color-bg-elevated);\n}\n\n.expand-icon {\n  font-size: var(--font-size-lg);\n  color: var(--color-text-muted);\n  transition: transform var(--transition-normal);\n}\n\n/* ==========================================================================\n   Nested card - small inline cards for nested items (factors, etc)\n   ========================================================================== */\n\n.nested-card {\n  background-color: var(--color-bg-nested);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--color-border-light);\n  padding: var(--spacing-md) var(--spacing-lg);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  transition: all var(--transition-fast);\n}\n\n.nested-card:hover {\n  border-color: var(--color-accent);\n}\n\n.nested-card-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 1;\n}\n\n.nested-card-icon {\n  width: 24px;\n  height: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-lg);\n  flex-shrink: 0;\n  line-height: 1;\n}\n\n.nested-card-info {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n  flex: 1;\n}\n\n.nested-card-type {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n}\n\n.nested-card-summary {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n}\n\n.nested-card-coefficient {\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-semibold);\n  white-space: nowrap;\n}\n\n.nested-card-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.nested-card-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n.nested-card-empty {\n  padding: var(--spacing-md) var(--spacing-lg);\n  text-align: center;\n  color: var(--color-text-dim);\n  font-size: var(--font-size-sm);\n  background-color: var(--color-bg-nested);\n  border-radius: var(--radius-md);\n  border: 1px dashed var(--color-border-light);\n}\n\n/* ==========================================================================\n   Condition card - for filters, rules, conditions\n   ========================================================================== */\n\n.condition-card {\n  background-color: var(--color-bg-nested);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  margin-bottom: var(--spacing-sm);\n  transition: border-color var(--transition-fast);\n\n  /* Allow dropdowns to extend outside card bounds */\n  overflow: visible;\n}\n\n.condition-card:hover {\n  border-color: var(--color-border);\n}\n\n.condition-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: var(--spacing-sm);\n}\n\n.condition-card-type {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.condition-card-icon {\n  width: 24px;\n  height: 24px;\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-sm);\n  flex-shrink: 0;\n  line-height: 1;\n}\n\n.condition-card-label {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n}\n\n.condition-card-summary {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  margin-top: 1px;\n}\n\n.condition-card-fields {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-lg);\n}\n\n.condition-card-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.condition-card-nested {\n  margin-top: var(--spacing-lg);\n  padding-left: var(--spacing-xl);\n  border-left: 2px solid var(--color-border-light);\n}\n\n.condition-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n\n  /* Allow dropdowns to extend outside list bounds */\n  overflow: visible;\n}\n\n/* Inline add button for conditions */\n.btn-add-inline {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n  padding: 6px 10px;\n  background-color: transparent;\n  border: 1px dashed var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-text-dim);\n  font-size: var(--font-size-sm);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.btn-add-inline:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n/* Filter fields layout - still used within condition cards */\n.filter-fields {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-lg);\n}\n\n/* ==========================================================================\n   Icon buttons for cards\n   ========================================================================== */\n\n.icon-button {\n  background: none;\n  border: none;\n  color: var(--color-text-dim);\n  cursor: pointer;\n  padding: var(--spacing-sm);\n  border-radius: var(--radius-md);\n  transition: all var(--transition-fast);\n}\n\n.icon-button:hover {\n  color: var(--color-text);\n  background-color: rgb(255 255 255 / 10%);\n}\n\n.delete-button:hover {\n  color: var(--color-danger);\n  background-color: rgb(239 68 68 / 10%);\n}\n\n/* ==========================================================================\n   Compact empty state\n   ========================================================================== */\n\n.empty-state-compact {\n  padding: var(--spacing-md);\n  text-align: center;\n  color: var(--color-text-dim);\n  font-size: var(--font-size-sm);\n  background-color: var(--color-bg-nested);\n  border: 1px dashed var(--color-border-light);\n  border-radius: var(--radius-md);\n}\n\n/* ==========================================================================\n   Summary stats grid\n   ========================================================================== */\n\n.summary-stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\n  gap: var(--spacing-lg);\n}\n\n.summary-stat {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-nested);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-md);\n  text-align: center;\n}\n\n.summary-stat-icon {\n  font-size: var(--font-size-2xl);\n  margin-bottom: var(--spacing-sm);\n}\n\n.summary-stat-value {\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-accent);\n}\n\n.summary-stat-label {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  margin-top: var(--spacing-xs);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* ==========================================================================\n   Danger zone\n   ========================================================================== */\n\n.danger-zone {\n  margin-top: var(--spacing-2xl);\n  padding-top: var(--spacing-xl);\n  border-top: 1px solid rgb(239 68 68 / 30%);\n  display: flex;\n  gap: var(--spacing-lg);\n}\n\n/* ==========================================================================\n   Path constraint card (compact inline constraint editor)\n   ========================================================================== */\n\n.path-constraint-card {\n  background-color: var(--color-bg-nested);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-md);\n  padding: var(--spacing-md);\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n}\n\n.path-constraint-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.path-constraint-label {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-accent);\n}\n\n.constraint-fields-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));\n  gap: var(--spacing-md);\n}\n","numLines":495,"startLine":1,"totalLines":495}}}
