-danger:hover:not(:disabled) {\n  background-color: rgb(239 68 68 / 20%);\n}\n\n/* Icon button */\n.btn-icon {\n  padding: var(--spacing-sm);\n  font-size: var(--font-size-lg);\n  background-color: transparent;\n  border: none;\n  border-radius: var(--radius-md);\n  color: var(--color-text-dim);\n}\n\n.btn-icon:hover:not(:disabled) {\n  background-color: rgb(96 165 250 / 15%);\n  color: var(--color-text-muted);\n}\n\n.btn-icon-danger {\n  color: var(--color-danger);\n}\n\n.btn-icon-danger:hover:not(:disabled) {\n  background-color: rgb(239 68 68 / 15%);\n  color: var(--color-danger);\n}\n\n/* Add item button (dashed border) */\n.btn-add {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  width: 100%;\n  padding: 14px;\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 2px dashed var(--color-border);\n  border-radius: var(--radius-xl);\n  color: var(--color-text-dim);\n}\n\n.btn-add:hover:not(:disabled) {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n  background-color: rgb(245 158 11 / 5%);\n}\n\n/* Close button */\n.btn-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--color-text-dim);\n  padding: 4px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.btn-close:hover {\n  color: var(--color-text);\n  background-color: rgb(255 255 255 / 10%);\n}\n\n/* Tab button */\n.btn-tab {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 14px;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-medium);\n  border: none;\n  border-radius: var(--radius-lg);\n  text-align: left;\n  width: 100%;\n  background-color: transparent;\n  color: var(--color-text-muted);\n}\n\n.btn-tab:hover:not(.btn-tab-active) {\n  background-color: rgb(245 158 11 / 15%);\n  color: var(--color-accent);\n}\n\n.btn-tab-active {\n  background: var(--gradient-accent);\n  color: var(--color-bg-dark);\n}\n\n.btn-tab-icon {\n  font-size: var(--font-size-xl);\n}\n\n/* Category toggle button */\n.btn-toggle-category {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  padding: 4px 10px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--color-border);\n  background-color: transparent;\n}\n\n.btn-toggle-category:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.btn-toggle-category-active {\n  background-color: rgb(34 197 94 / 15%);\n  border-color: var(--color-success);\n  color: var(--color-success);\n}\n\n/* Remove button (text style) */\n.button-remove {\n  padding: 4px 10px;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 1px solid rgb(239 68 68 / 30%);\n  border-radius: var(--radius-md);\n  color: #fca5a5;\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.button-remove:hover {\n  background-color: rgb(239 68 68 / 15%);\n  border-color: var(--color-danger);\n  color: var(--color-danger);\n}\n\n/* Micro remove button (for compact constraint cards) */\n.button,\n.button-remove-micro {\n  padding: 2px 8px;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  color: var(--color-text-dim);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.button-remove-micro:hover {\n  background-color: rgb(239 68 68 / 15%);\n  border-color: var(--color-danger);\n  color: var(--color-danger);\n}\n","numLines":215,"startLine":1,"totalLines":215}}}
