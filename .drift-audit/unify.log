-normal);\n   132→}\n   133→\n   134→.category-expand-open {\n   135→  transform: rotate(90deg);\n   136→}\n   137→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"57e7b01d-2cac-4955-b867-d2f575fea032","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/section.css","content":"/**\n * Section component styles\n */\n\n/* Section container */\n.section {\n  margin-bottom: var(--spacing-3xl);\n}\n\n/* Section header */\n.section-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: var(--spacing-lg);\n}\n\n.section-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.section-icon {\n  font-size: var(--font-size-xl);\n}\n\n.section-count {\n  font-size: var(--font-size-sm);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(59 130 246 / 20%);\n  color: var(--color-text-muted);\n}\n\n.section-title-icon {\n  font-size: var(--font-size-xl);\n}\n\n/* Nested section */\n.nested-section {\n  padding: var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-lg);\n  border: 1px solid var(--color-border-light);\n  margin-top: var(--spacing-lg);\n}\n\n.nested-title {\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-md);\n}\n\n.section-desc {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin-bottom: var(--spacing-xl);\n  line-height: var(--line-height-normal);\n}\n\n/* Info box */\n.info-box {\n  background-color: rgb(59 130 246 / 10%);\n  border: 1px solid rgb(59 130 246 / 30%);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-lg) var(--spacing-xl);\n  margin-bottom: var(--spacing-xl);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  line-height: var(--line-height-normal);\n}\n\n.info-box-placement {\n  margin-bottom: var(--spacing-md);\n}\n\n.info-box-title {\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text-dim);\n  margin-bottom: var(--spacing-xs);\n}\n\n.info-box-text {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  line-height: var(--line-height-normal);\n}\n\n/* Category section */\n.category-section {\n  margin-bottom: var(--spacing-2xl);\n}\n\n.category-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-lg);\n  padding: var(--spacing-lg) var(--spacing-xl);\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-lg);\n  border: 1px solid var(--color-border);\n  cursor: pointer;\n  margin-bottom: var(--spacing-lg);\n  transition: all var(--transition-fast);\n}\n\n.category-header:hover {\n  border-color: var(--color-accent);\n}\n\n.category-icon {\n  font-size: var(--font-size-2xl);\n}\n\n.category-title {\n  flex: 1;\n  font-size: 15px;\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.category-expand {\n  font-size: var(--font-size-base);\n  color: var(--color-text-muted);\n  transition: transform var(--transition-normal);\n}\n\n.category-expand-open {\n  transform: rotate(90deg);\n}\n","numLines":137,"startLine":1,"totalLines":137}}}
