   \"@typescript-eslint/no-unused-vars\": [\"warn\", { argsIgnorePattern: \"^_\", varsIgnorePattern: \"^_\" }],\n   150→      \"no-unused-vars\": \"off\",\n   151→      \"react-perf/jsx-no-new-object-as-prop\": [\"warn\", { nativeAllowList: \"all\" }],\n   152→      \"react-perf/jsx-no-new-array-as-prop\": [\"warn\", { nativeAllowList: \"all\" }],\n   153→      \"react-perf/jsx-no-new-function-as-prop\": [\"warn\", { nativeAllowList: \"all\" }],\n   154→      \"react-perf/jsx-no-jsx-as-prop\": [\"warn\", { nativeAllowList: \"all\" }],\n   155→      \"react/jsx-no-constructed-context-values\": \"warn\",\n   156→      \"local/max-jsx-props\": [\"warn\", { max: 12 }],\n   157→      \"local/no-inline-styles\": \"warn\",\n   158→      \"local/no-raw-error-div\": \"warn\",\n   159→      \"local/no-inline-id-generation\": \"warn\",\n   160→      \"local/no-duplicate-component-css\": \"warn\",\n   161→      \"local/no-tab-companion-css\": \"warn\",\n   162→      \"local/no-viz-overlay-drift\": \"warn\",\n   163→    },\n   164→  },\n   165→\n   166→  // Vite config files: guard against non-standard alias patterns\n   167→  {\n   168→    files: [\"apps/**/webui/vite.config.{js,ts}\"],\n   169→    plugins: {\n   170→      local: localPlugin,\n   171→    },\n   172→    rules: {\n   173→      \"local/no-cross-app-alias\": \"warn\",\n   174→    },\n   175→  },\n   176→\n   177→  // Test files: exempt from complexity/size limits\n   178→  {\n   179→    files: [\"**/*.test.ts\", \"**/*.test.tsx\"],\n   180→    rules: {\n   181→      \"max-lines-per-function\": \"off\",\n   182→      \"max-lines\": \"off\",\n   183→      \"sonarjs/no-duplicate-string\": \"off\",\n   184→    },\n   185→  },\n   186→\n   187→  // SonarJS: full recommended config\n   188→  sonarjs.configs.recommended,\n   189→\n   190→  // TypeScript-specific rule overrides\n   191→  {\n   192→    files: [\"**/*.{ts,tsx}\"],\n   193→    rules: {\n   194→      \"sonarjs/deprecation\": \"warn\",\n   195→      \"sonarjs/p