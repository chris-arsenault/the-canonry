ector\n   601→ * ============================================================================ */\n   602→\n   603→.era-narr-version-row {\n   604→  margin-bottom: 12px;\n   605→  display: flex;\n   606→  align-items: center;\n   607→  gap: 8px;\n   608→  flex-wrap: wrap;\n   609→}\n   610→\n   611→.era-narr-version-select {\n   612→  width: auto;\n   613→  min-width: 240px;\n   614→  font-size: 12px;\n   615→  padding: 4px 6px;\n   616→}\n   617→\n   618→.era-narr-version-active-badge {\n   619→  font-size: 11px;\n   620→  padding: 2px 8px;\n   621→  background: rgb(16 185 129 / 15%);\n   622→  color: #10b981;\n   623→  border-radius: 999px;\n   624→  font-weight: 500;\n   625→}\n   626→\n   627→.era-narr-version-make-active-btn {\n   628→  padding: 2px 8px;\n   629→  font-size: 11px;\n   630→}\n   631→\n   632→.era-narr-version-delete-btn {\n   633→  padding: 2px 8px;\n   634→  font-size: 11px;\n   635→}\n   636→\n   637→.era-narr-version-delete-btn-confirming {\n   638→  background: #ef4444;\n   639→  color: #fff;\n   640→  border-color: #ef4444;\n   641→}\n   642→\n   643→.era-narr-version-delete-btn-normal {\n   644→  color: var(--text-muted);\n   645→}\n   646→\n   647→/* ============================================================================\n   648→ * Footer\n   649→ * ============================================================================ */\n   650→\n   651→.era-narr-footer {\n   652→  padding: 12px 20px;\n   653→  border-top: 1px solid var(--border-color);\n   654→  display: flex;\n   655→  justify-content: space-between;\n   656→  align-items: center;\n   657→}\n   658→\n   659→.era-narr-footer-cost {\n   660→  font-size: 11px;\n   661→  color: var(--text-muted);\n   662→}\n   663→\n   664→.era-narr-footer-actions {\n   665→  display: flex;\n   666→  gap: 8px;\n   667→}\n   668→\n   669→.era-narr-footer-primary-btn {\n   670→  background: var(--accent-primary);\n   671→  color: #fff;\n   672→  font-weight: 600;\n   673→}\n   674→\n   675→.era-narr-footer-rerun-btn {\n   676→  font-weight: 500;\n   677→}\n   678→"}]},"parent_tool_use_id":null,"session_id":"9f489ea2-964b-4b12-9123-73dad996ade9","uuid":"62227dc9-553b-420b-b1fb-300e55ea6671","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/EraNarrativeModal.css","content":"/* EraNarrativeModal.css — co-located styles for EraNarrativeModal.jsx */\n\n/* ============================================================================\n * Modal overlay & container\n * ============================================================================ */\n\n.era-narr-overlay {\n  position: fixed;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  background: rgb(0 0 0 / 50%);\n}\n\n.era-narr-modal {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 12px;\n  width: 700px;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* ============================================================================\n * Header\n * ============================================================================ */\n\n.era-narr-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.era-narr-header-title {\n  font-weight: 600;\n  font-size: 15px;\n}\n\n.era-narr-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.era-narr-header-minimize-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.era-narr-header-close-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 18px;\n  color: var(--text-muted);\n  padding: 4px;\n}\n\n/* ============================================================================\n * Body\n * ============================================================================ */\n\n.era-narr-body {\n  padding: 20px;\n  overflow: auto;\n  flex: 1;\n}\n\n/* ============================================================================\n * Setup form fields\n * ============================================================================ */\n\n.era-narr-field {\n  margin-bottom: 16px;\n}\n\n.era-narr-field-lg {\n  margin-bottom: 20px;\n}\n\n.era-narr-label {\n  display: block;\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 6px;\n}\n\n.era-narr-label-optional {\n  font-style: italic;\n}\n\n.era-narr-select-full {\n  width: 100%;\n  font-size: 13px;\n}\n\n/* Warnings */\n.era-narr-warning {\n  padding: 10px;\n  margin-bottom: 16px;\n  background: #fef3c7;\n  border-radius: 6px;\n  font-size: 12px;\n  color: #92400e;\n}\n\n/* Thesis link */\n.era-narr-thesis-link {\n  padding: 10px;\n  margin-bottom: 16px;\n  background: rgb(59 130 246 / 8%);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.era-narr-thesis-link-label {\n  color: var(--text-muted);\n  margin-bottom: 4px;\n  font-size: 11px;\n}\n\n.era-narr-thesis-link-text {\n  color: var(--text-secondary);\n  font-style: italic;\n  line-height: 1.5;\n}\n\n/* Chronicle list */\n.era-narr-chronicle-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  max-height: 200px;\n  overflow: auto;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  padding: 4px;\n}\n\n.era-narr-chronicle-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 6px;\n  font-size: 12px;\n  background: var(--bg-primary);\n  border-radius: 4px;\n}\n\n.era-narr-chronicle-item-unprepped {\n  opacity: 0.5;\n}\n\n.era-narr-chronicle-item-weight {\n  font-size: 10px;\n  width: 14px;\n  text-align: center;\n  color: var(--era-narr-weight-color);\n}\n\n.era-narr-chronicle-item-title {\n  flex: 1;\n  color: var(--text-secondary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.era-narr-chronicle-item-year {\n  color: var(--text-muted);\n  font-size: 11px;\n}\n\n.era-narr-chronicle-item-style {\n  color: var(--text-muted);\n  font-size: 11px;\n  font-style: italic;\n  max-width: 100px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.era-narr-chronicle-item-prep {\n  font-size: 11px;\n  width: 14px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.era-narr-chronicle-item-prep-yes {\n  color: #8b7355;\n}\n\n/* Existing narratives list */\n.era-narr-existing-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.era-narr-existing-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.era-narr-existing-item-status {\n  font-weight: 600;\n  color: var(--era-narr-status-color);\n}\n\n.era-narr-existing-item-step {\n  flex: 1;\n  color: var(--text-secondary);\n}\n\n.era-narr-existing-item-time {\n  color: var(--text-muted);\n  font-size: 11px;\n}\n\n.era-narr-existing-item-cost {\n  color: var(--text-muted);\n  font-size: 11px;\n}\n\n.era-narr-existing-item-resume-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.era-narr-existing-item-view-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.era-narr-existing-item-delete-btn {\n  padding: 2px 6px;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Tone buttons */\n.era-narr-tone-row {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.era-narr-tone-btn {\n  font-size: 12px;\n  padding: 4px 10px;\n}\n\n.era-narr-tone-btn-active {\n  background: var(--accent-primary);\n  color: #fff;\n}\n\n/* Arc direction */\n.era-narr-textarea {\n  width: 100%;\n  min-height: 60px;\n  max-height: 120px;\n  padding: 8px;\n  font-size: 12px;\n  line-height: 1.5;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  resize: vertical;\n  font-family: inherit;\n}\n\n/* Start buttons */\n.era-narr-start-row {\n  display: flex;\n  gap: 8px;\n}\n\n.era-narr-start-btn {\n  flex: 1;\n  padding: 10px;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.era-narr-start-btn-primary {\n  background: var(--accent-primary);\n  color: #fff;\n}\n\n.era-narr-headless-btn {\n  padding: 10px 16px;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.era-narr-start-btn-dimmed {\n  opacity: 0.5;\n}\n\n/* ============================================================================\n * Generating state\n * ============================================================================ */\n\n.era-narr-generating {\n  text-align: center;\n  padding: 40px 0;\n}\n\n.era-narr-generating-status {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-bottom: 8px;\n}\n\n.era-narr-generating-era {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ============================================================================\n * Failed state\n * ============================================================================ */\n\n.era-narr-failed {\n  text-align: center;\n  padding: 20px 0;\n}\n\n.era-narr-failed-title {\n  font-size: 14px;\n  color: #ef4444;\n  margin-bottom: 8px;\n}\n\n.era-narr-failed-error {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 16px;\n}\n\n/* ============================================================================\n * Thread Synthesis Review\n * ============================================================================ */\n\n.era-narr-review-section {\n  margin-bottom: 16px;\n}\n\n.era-narr-review-heading {\n  font-size: 13px;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.era-narr-thesis-text {\n  font-size: 13px;\n  color: var(--text-secondary);\n  font-style: italic;\n}\n\n.era-narr-thread-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.era-narr-thread-card {\n  padding: 8px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n}\n\n.era-narr-thread-card-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.era-narr-thread-card-name {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.era-narr-thread-card-actors {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.era-narr-thread-card-register {\n  font-size: 11px;\n  color: #8b7355;\n  font-style: italic;\n}\n\n.era-narr-thread-card-desc {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n.era-narr-thread-card-material {\n  margin-top: 6px;\n}\n\n.era-narr-thread-card-material-summary {\n  font-size: 11px;\n  color: var(--text-muted);\n  cursor: pointer;\n}\n\n.era-narr-thread-card-material-body {\n  font-size: 11px;\n  color: var(--text-secondary);\n  margin-top: 4px;\n  line-height: 1.5;\n  padding-left: 8px;\n  border-left: 2px solid var(--border-color);\n}\n\n/* Movement plan */\n.era-narr-movement-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.era-narr-movement-card {\n  padding: 8px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.era-narr-movement-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.era-narr-movement-card-index {\n  font-weight: 500;\n}\n\n.era-narr-movement-card-range {\n  color: var(--text-muted);\n}\n\n.era-narr-movement-card-threads {\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n.era-narr-movement-card-world-state {\n  color: var(--text-secondary);\n  margin-top: 4px;\n  font-size: 11px;\n}\n\n.era-narr-movement-card-beats {\n  color: var(--text-secondary);\n  margin-top: 4px;\n  font-style: italic;\n}\n\n/* Counterweight */\n.era-narr-counterweight {\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n/* Strategic dynamics */\n.era-narr-dynamics-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.era-narr-dynamic-card {\n  padding: 6px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.era-narr-dynamic-card-interaction {\n  font-weight: 600;\n  color: var(--text-primary);\n}\n\n.era-narr-dynamic-card-actors {\n  font-weight: 400;\n  color: var(--text-muted);\n}\n\n.era-narr-dynamic-card-text {\n  color: var(--text-secondary);\n  margin-top: 2px;\n  line-height: 1.5;\n}\n\n/* Quotes */\n.era-narr-quotes-list {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.era-narr-quote-card {\n  padding: 6px 10px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.era-narr-quote-card-text {\n  font-style: italic;\n  color: var(--text-primary);\n}\n\n.era-narr-quote-card-origin {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n/* Motifs */\n.era-narr-motifs {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ============================================================================\n * Narrative / Edit Review\n * ============================================================================ */\n\n.era-narr-content-header {\n  margin-bottom: 12px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.era-narr-content-header-mb8 {\n  margin-bottom: 8px;\n}\n\n.era-narr-content-title {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.era-narr-content-meta {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.era-narr-content-viewer {\n  padding: 16px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  font-size: 13px;\n  line-height: 1.7;\n  white-space: pre-wrap;\n  max-height: 400px;\n  overflow: auto;\n  color: var(--text-secondary);\n}\n\n.era-narr-no-content {\n  padding: 20px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 13px;\n}\n\n/* ============================================================================\n * Complete: Version selector\n * ============================================================================ */\n\n.era-narr-version-row {\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.era-narr-version-select {\n  width: auto;\n  min-width: 240px;\n  font-size: 12px;\n  padding: 4px 6px;\n}\n\n.era-narr-version-active-badge {\n  font-size: 11px;\n  padding: 2px 8px;\n  background: rgb(16 185 129 / 15%);\n  color: #10b981;\n  border-radius: 999px;\n  font-weight: 500;\n}\n\n.era-narr-version-make-active-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.era-narr-version-delete-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n.era-narr-version-delete-btn-confirming {\n  background: #ef4444;\n  color: #fff;\n  border-color: #ef4444;\n}\n\n.era-narr-version-delete-btn-normal {\n  color: var(--text-muted);\n}\n\n/* ============================================================================\n * Footer\n * ============================================================================ */\n\n.era-narr-footer {\n  padding: 12px 20px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.era-narr-footer-cost {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.era-narr-footer-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.era-narr-footer-primary-btn {\n  background: var(--accent-primary);\n  color: #fff;\n  font-weight: 600;\n}\n\n.era-narr-footer-rerun-btn {\n  font-weight: 500;\n}\n","numLines":678,"startLine":1,"totalLines":678}}}
