{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DKx5px3JTwavSdti5VrY5o","type":"tool_result","content":"     1→/**\n     2→ * ErrorMessage - Inline error display for operation failures\n     3→ */\n     4→\n     5→import React from 'react';\n     6→\n     7→interface ErrorMessageProps {\n     8→  message: string;\n     9→  title?: string;\n    10→  className?: string;\n    11→}\n    12→\n    13→/**\n    14→ * @param {Object} props\n    15→ * @param {string} props.message - Error message text\n    16→ * @param {string} [props.title] - Optional title above the message\n    17→ * @param {string} [props.className] - Optional additional class names\n    18→ */\n    19→export function ErrorMessage({ message, title, className = '' }: ErrorMessageProps) {\n    20→  return (\n    21→    <div className={`error-message ${className}`.trim()} role=\"alert\">\n    22→      {title && <div className=\"error-message-title\">{title}</div>}\n    23→      <div className=\"error-message-text\">{message}</div>\n    24→    </div>\n    25→  );\n    26→}\n    27→\n    28→export default ErrorMessage;\n    29→\n    30→"}]},"parent_tool_use_id":"toolu_01MSjwERvzq8tWa6PqUQiEqU","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"2619fda2-0115-42c5-ab9b-0dbf2cae05e0"}
