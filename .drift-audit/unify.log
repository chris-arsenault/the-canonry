{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Td8hUVBBABfdGVtgwSP6Ki","type":"tool_result","content":"     1→import { useState, useCallback, useEffect, useRef } from \"react\";\n     2→\n     3→// ============================================================================\n     4→// Types\n     5→// ============================================================================\n     6→\n     7→export interface LocalWorldContext {\n     8→  name: string;\n     9→  description: string;\n    10→  toneFragments: { core: string; [key: string]: string };\n    11→  canonFactsWithMetadata: Array<{ text: string; [key: string]: unknown }>;\n    12→  factSelection: Record<string, unknown>;\n    13→  worldDynamics: Array<{ text: string; [key: string]: unknown }>;\n    14→  [key: string]: unknown;\n    15→}\n    16→\n    17→export interface UseWorldContextSyncProps {\n    18→  externalWorldContext?: LocalWorldContext;\n    19→  onWorldContextChange?: (context: LocalWorldContext) => void;\n    20→}\n    21→\n    22→export interface UseWorldContextSyncReturn {\n    23→  worldContext: LocalWorldContext;\n    24→  updateWorldContext: (updates: Partial<LocalWorldContext>) => void;\n    25→}\n    26→\n    27→// ============================================================================\n    28→// Constants\n    29→// ============================================================================\n    30→\n    31→const DEFAULT_WORLD_CONTEXT: LocalWorldContext = {\n    32→  name: \"\",\n    33→  description: \"\",\n    34→  toneFragments: { core: \"\" },\n    35→  canonFactsWithMetadata: [],\n    36→  factSelection: {},\n    37→  worldDynamics: [],\n    38→};\n    39→\n    40→// ============================================================================\n    41→// Hook\n    42→// ============================================================================\n    43→\n    44→export default function useWorldContextSync({ externalWorldContext, onWorldContextChange }: UseWorldContextSyncProps): UseWorldContextSyncReturn {\n    45→  const [localWorldContext, setLocalWorldContext] = useState<LocalWorldContext>(DEFAULT_WORLD_CONTEXT);\n    46→  const worldContext = localWorldContext;\n    47→  const worldContextSyncTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n    48→  const worldContextDirtyRef = useRef<boolean>(false);\n    49→  const pendingWorldContextRef = useRef<LocalWorldContext>(localWorldContext);\n    50→\n    51→  // Detect external context changes during render (no ref access)\n    52→  const [prevExternalContext, setPrevExternalContext] = useState<LocalWorldContext | undefined>(externalWorldContext);\n    53→  if (externalWorldContext !== prevExternalContext) {\n    54→    setPrevExternalContext(externalWorldContext);\n    55→    if (externalWorldContext !== undefined) {\n    56→      const nextContext = externalWorldContext || DEFAULT_WORLD_CONTEXT;\n    57→      setLocalWorldContext(nextContext);\n    58→    }\n    59→  }\n    60→\n    61→  // Ref side effects when external changes (clear timeout, update refs)\n    62→  useEffect(() => {\n    63→    if (externalWorldContext === undefined) return;\n    64→    if (worldContextSyncTimeoutRef.current) {\n    65→      clearTimeout(worldContextSyncTimeoutRef.current);\n    66→      worldContextSyncTimeoutRef.current = null;\n    67→    }\n    68→    worldContextDirtyRef.current = false;\n    69→    pendingWorldContextRef.current = externalWorldContext || DEFAULT_WORLD_CONTEXT;\n    70→  }, [externalWorldContext]);\n    71→\n    72→  const updateWorldContext = useCallback(\n    73→    (updates: Partial<LocalWorldContext>) => {\n    74→      setLocalWorldContext((prev: LocalWorldContext) => {\n    75→        const merged = { ...prev, ...updates };\n    76→        pendingWorldContextRef.current = merged;\n    77→        if (onWorldContextChange) {\n    78→          worldContextDirtyRef.current = true;\n    79→          if (worldContextSyncTimeoutRef.current) {\n    80→            clearTimeout(worldContextSyncTimeoutRef.current);\n    81→          }\n    82→          worldContextSyncTimeoutRef.current = setTimeout(() => {\n    83→            if (!worldContextDirtyRef.current) return;\n    84→            worldContextDirtyRef.current = false;\n    85→            onWorldContextChange(pendingWorldContextRef.current);\n    86→            worldContextSyncTimeoutRef.current = null;\n    87→          }, 300);\n    88→        }\n    89→        return merged;\n    90→      });\n    91→    },\n    92→    [onWorldContextChange]\n    93→  );\n    94→\n    95→  useEffect(() => {\n    96→    return () => {\n    97→      if (worldContextSyncTimeoutRef.current) {\n    98→        clearTimeout(worldContextSyncTimeoutRef.current);\n    99→        worldContextSyncTimeoutRef.current = null;\n   100→      }\n   101→      if (worldContextDirtyRef.current && onWorldContextChange) {\n   102→        onWorldContextChange(pendingWorldContextRef.current);\n   103→      }\n   104→    };\n   105→  }, [onWorldContextChange]);\n   106→\n   107→  return { worldContext, updateWorldContext };\n   108→}\n   109→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"57948034-0492-4248-8ceb-159dc6cc7d73"}
