50→  const hasAnthropicKey = anthropicApiKey.length > 0;\n    51→  const hasRequiredKeys = hasAnthropicKey;\n    52→\n    53→  return {\n    54→    persistApiKeys,\n    55→    setPersistApiKeys,\n    56→    anthropicApiKey,\n    57→    setAnthropicApiKey,\n    58→    openaiApiKey,\n    59→    setOpenaiApiKey,\n    60→    showApiKeyInput,\n    61→    setShowApiKeyInput,\n    62→    hasAnthropicKey,\n    63→    hasRequiredKeys,\n    64→  };\n    65→}\n    66→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"f4b82818-75d0-47fe-91d0-8db169fab312"}
