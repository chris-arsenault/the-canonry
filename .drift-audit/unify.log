{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019KRDkGU9cn4Xh4rThzgzhJ","type":"tool_result","content":"  1000→    }\n  1001→  });\n  1002→}\n  1003→\n  1004→function detectOrphans(usageMap, schema, pressures, _generators, _systems) {\n  1005→  // Check for unused entity kinds\n  1006→  Object.entries(usageMap.entityKinds).forEach(([kind, usage]) => {\n  1007→    const totalUsage = usage.generators.length + usage.systems.length + usage.actions.length + usage.pressures.length;\n  1008→    if (totalUsage === 0) {\n  1009→      usageMap.validation.orphans.push({\n  1010→        type: 'entityKind',\n  1011→        id: kind,\n  1012→        reason: 'Not referenced by any generator, system, action, or pressure',\n  1013→      });\n  1014→    }\n  1015→  });\n  1016→\n  1017→  // Check for unused relationship kinds\n  1018→  Object.entries(usageMap.relationshipKinds).forEach(([kind, usage]) => {\n  1019→    const totalUsage = usage.generators.length + usage.systems.length + usage.actions.length + usage.pressures.length;\n  1020→    if (totalUsage === 0) {\n  1021→      usageMap.validation.orphans.push({\n  1022→        type: 'relationshipKind',\n  1023→        id: kind,\n  1024→        reason: 'Not referenced by any generator, system, action, or pressure',\n  1025→      });\n  1026→    }\n  1027→  });\n  1028→\n  1029→  // Check for unused pressures\n  1030→  Object.entries(usageMap.pressures).forEach(([pressureId, usage]) => {\n  1031→    const totalUsage = usage.generators.length + usage.systems.length + usage.actions.length;\n  1032→    if (totalUsage === 0) {\n  1033→      usageMap.validation.orphans.push({\n  1034→        type: 'pressure',\n  1035→        id: pressureId,\n  1036→        reason: 'Not referenced by any generator, system, or action',\n  1037→      });\n  1038→    }\n  1039→  });\n  1040→\n  1041→  // Check for generators not used in any era\n  1042→  Object.entries(usageMap.generators).forEach(([genId, usage]) => {\n  1043→    if (usage.eras.length === 0) {\n  1044→      usageMap.validation.orphans.push({\n  1045→        type: 'generator',\n  1046→        id: genId,\n  1047→        reason: 'Not included in any era',\n  1048→      });\n  1049→    }\n  1050→  });\n  1051→\n  1052→  // Check for systems not used in any era\n  1053→  Object.entries(usageMap.systems).forEach(([sysId, usage]) => {\n  1054→    if (usage.eras.length === 0) {\n  1055→      usageMap.validation.orphans.push({\n  1056→        type: 'system',\n  1057→        id: sysId,\n  1058→        reason: 'Not included in any era',\n  1059→      });\n  1060→    }\n  1061→  });\n  1062→\n  1063→  // Check for pressures with no feedback (will monotonically change)\n  1064→  Object.entries(usageMap.pressures).forEach(([pressureId, usage]) => {\n  1065→    if (usage.feedbackSources.length === 0 && usage.feedbackSinks.length === 0) {\n  1066→      const pressure = pressures.find(p => p.id === pressureId);\n  1067→      if (pressure && (pressure.homeostasis ?? 0) === 0) {\n  1068→        usageMap.validation.orphans.push({\n  1069→          type: 'pressure',\n  1070→          id: pressureId,\n  1071→          reason: 'No feedback or homeostasis defined - pressure will remain static',\n  1072→        });\n  1073→      }\n  1074→    }\n  1075→  });\n  1076→}\n  1077→\n  1078→function checkRelationshipCompatibility(usageMap, generators, actions, schema) {\n  1079→  const relationshipKinds = {};\n  1080→  (schema?.relationshipKinds || []).forEach(rk => {\n  1081→    relationshipKinds[rk.kind] = {\n  1082→      srcKinds: rk.srcKinds || [],\n  1083→      dstKinds: rk.dstKinds || [],\n  1084→    };\n  1085→  });\n  1086→\n  1087→  // Check generator relationship compatibility\n  1088→  (generators || []).forEach(gen => {\n  1089→    (gen.relationships || []).forEach((rel) => {\n  1090→      const rkDef = relationshipKinds[rel.kind];\n  1091→      if (!rkDef) return; // Already flagged as invalid ref\n  1092→\n  1093→      // Check if src/dst are compatible\n  1094→      // This is a simplified check - in reality we'd need to resolve $target, $created, etc.\n  1095→      if (rkDef.srcKinds.length > 0 || rkDef.dstKinds.length > 0) {\n  1096→        // If the relationship has constraints, note it for review\n  1097→        // Full compatibility checking would require runtime context\n  1098→      }\n  1099→    });\n  1100→  });\n  1101→\n  1102→  // Check action outcome relationship compatibility\n  1103→  (actions || []).forEach(action => {\n  1104→    const actorSelection = action.actor?.selection || {};\n  1105→    const actorKinds = [\n  1106→      ...(actorSelection.kind ? [actorSelection.kind] : []),\n  1107→      ...(actorSelection.kinds || []),\n  1108→    ];\n  1109→    const instigatorSelection = action.actor?.instigator || {};\n  1110→    const instigatorKinds = [\n  1111→      ...(instigatorSelection.kind ? [instigatorSelection.kind] : []),\n  1112→      ...(instigatorSelection.kinds || []),\n  1113→    ];\n  1114→    const targetSelection = action.targeting || {};\n  1115→    const targetKinds = [\n  1116→      ...(targetSelection.kind ? [targetSelection.kind] : []),\n  1117→      ...(targetSelection.kinds || []),\n  1118→    ];\n  1119→\n  1120→    const kindsForRef = (ref) => {\n  1121→      if (ref === '$actor') return actorKinds;\n  1122→      if (ref === '$instigator') return instigatorKinds;\n  1123→      if (ref === '$target' || ref === '$target2') return targetKinds;\n  1124→      return [];\n  1125→    };\n  1126→\n  1127→    (action.outcome?.mutations || []).forEach((mutation, idx) => {\n  1128→      if (mutation.type !== 'create_relationship' && mutation.type !== 'adjust_relationship_strength') {\n  1129→        return;\n  1130→      }\n  1131→      const rkDef = relationshipKinds[mutation.kind];\n  1132→      if (!rkDef) return;\n  1133→\n  1134→      const srcKinds = kindsForRef(mutation.src);\n  1135→      const dstKinds = kindsForRef(mutation.dst);\n  1136→\n  1137→      if (rkDef.srcKinds.length > 0 && srcKinds.length > 0) {\n  1138→        const compatible = srcKinds.some(k => rkDef.srcKinds.includes(k));\n  1139→        if (!compatible) {\n  1140→          usageMap.validation.compatibility.push({\n  1141→            type: 'action',\n  1142→            id: action.id,\n  1143→            field: `outcome.mutations[${idx}]`,\n  1144→            issue: `Relationship \"${mutation.kind}\" requires src to be one of [${rkDef.srcKinds.join(', ')}], but ${mutation.src} kinds are [${srcKinds.join(', ')}]`,\n  1145→          });\n  1146→        }\n  1147→      }\n  1148→\n  1149→      if (rkDef.dstKinds.length > 0 && dstKinds.length > 0) {\n  1150→        const compatible = dstKinds.some(k => rkDef.dstKinds.includes(k));\n  1151→        if (!compatible) {\n  1152→          usageMap.validation.compatibility.push({\n  1153→            type: 'action',\n  1154→            id: action.id,\n  1155→            field: `outcome.mutations[${idx}]`,\n  1156→            issue: `Relationship \"${mutation.kind}\" requires dst to be one of [${rkDef.dstKinds.join(', ')}], but ${mutation.dst} kinds are [${dstKinds.join(', ')}]`,\n  1157→          });\n  1158→        }\n  1159→      }\n  1160→    });\n  1161→  });\n  1162→}\n  1163→\n  1164→/**\n  1165→ * Get validation status for a specific element\n  1166→ */\n  1167→export function getElementValidation(usageMap, type, id) {\n  1168→  const invalidRefs = usageMap.validation.invalidRefs.filter(\n  1169→    ref => ref.type === type && ref.id === id\n  1170→  );\n  1171→  const compatibility = usageMap.validation.compatibility.filter(\n  1172→    c => c.type === type && c.id === id\n  1173→  );\n  1174→  const isOrphan = usageMap.validation.orphans.some(\n  1175→    o => o.type === type && o.id === id\n  1176→  );\n  1177→\n  1178→  return {\n  1179→    isValid: invalidRefs.length === 0 && compatibility.length === 0,\n  1180→    invalidRefs,\n  1181→    compatibility,\n  1182→    isOrphan,\n  1183→  };\n  1184→}\n  1185→\n  1186→/**\n  1187→ * Get usage summary for display\n  1188→ */\n  1189→export function getUsageSummary(usage) {\n  1190→  const parts = [];\n  1191→  if (usage.generators?.length > 0) {\n  1192→    parts.push(`${usage.generators.length} generator${usage.generators.length !== 1 ? 's' : ''}`);\n  1193→  }\n  1194→  if (usage.systems?.length > 0) {\n  1195→    parts.push(`${usage.systems.length} system${usage.systems.length !== 1 ? 's' : ''}`);\n  1196→  }\n  1197→  if (usage.actions?.length > 0) {\n  1198→    parts.push(`${usage.actions.length} action${usage.actions.length !== 1 ? 's' : ''}`);\n  1199→  }\n  1200→  if (usage.pressures?.length > 0) {\n  1201→    parts.push(`${usage.pressures.length} pressure${usage.pressures.length !== 1 ? 's' : ''}`);\n  1202→  }\n  1203→  if (usage.eras?.length > 0) {\n  1204→    parts.push(`${usage.eras.length} era${usage.eras.length !== 1 ? 's' : ''}`);\n  1205→  }\n  1206→  return parts.length > 0 ? parts.join(', ') : 'Not used';\n  1207→}\n  1208→\n  1209→// =============================================================================\n  1210→// Helper functions from Canonry for cross-tool usage display\n  1211→// =============================================================================\n  1212→\n  1213→/**\n  1214→ * Utility function to compute tag usage across tools\n  1215→ *\n  1216→ * @param {Object} params - All sources that reference tags\n  1217→ * @param {Array} params.cultures - Array of culture objects with naming.profiles\n  1218→ * @param {Array} params.seedEntities - Array of seed entities with tags\n  1219→ * @param {Array} params.generators - Array of generator configs\n  1220→ * @param {Array} params.systems - Array of system configs\n  1221→ * @param {Array} params.pressures - Array of pressure configs\n  1222→ * @param {Array} params.entityKinds - Array of entity kind definitions (with semantic planes)\n  1223→ * @param {Array} params.axisDefinitions - Axis definitions referenced by semantic planes\n  1224→ * @returns {Object} - Map of tag -> { nameforge, seed, generators, systems, pressures, axis }\n  1225→ */\n  1226→function collectStrategyGroupTags(group, ensureTag, usage) {\n  1227→  (group.conditions?.tags || []).forEach(tag => {\n  1228→    ensureTag(tag);\n  1229→    usage[tag].nameforge = (usage[tag].nameforge || 0) + 1;\n  1230→  });\n  1231→}\n  1232→\n  1233→function collectCultureTags(cultures, ensureTag, usage) {\n  1234→  (cultures || []).forEach(culture => {\n  1235→    (culture.naming?.profiles || []).forEach(profile => {\n  1236→      (profile.strategyGroups || []).forEach(group => collectStrategyGroupTags(group, ensureTag, usage));\n  1237→    });\n  1238→  });\n  1239→}\n  1240→\n  1241→function collectSeedEntityTags(seedEntities, ensureTag, usage) {\n  1242→  (seedEntities || []).forEach(entity => {\n  1243→    Object.keys(entity.tags || {}).forEach(tag => {\n  1244→      ensureTag(tag);\n  1245→      usage[tag].seed = (usage[tag].seed || 0) + 1;\n  1246→    });\n  1247→  });\n  1248→}\n  1249→\n  1250→function collectApplyTagUsage(tags, addTagUsage, contextKey) {\n  1251→  if (!tags || typeof tags !== 'object') return;\n  1252→  Object.entries(tags).forEach(([_ref, tagMap]) => {\n  1253→    Object.keys(tagMap).forEach(tag => addTagUsage(tag, contextKey));\n  1254→  });\n  1255→}\n  1256→\n  1257→function collectGeneratorTags(generators, addTagUsage, collectTagsFromCondition, collectTagsFromFilters, collectTagsFromMutations) {\n  1258→  (generators || []).forEach(gen => {\n  1259→    (gen.creation || []).forEach(creation => {\n  1260→      if (creation.tags && typeof creation.tags === 'object') {\n  1261→        Object.keys(creation.tags).forEach(tag => addTagUsage(tag, 'generators'));\n  1262→      }\n  1263→    });\n  1264→    (gen.applicability || []).forEach((rule) => collectTagsFromCondition(rule, 'generators'));\n  1265→    collectTagsFromFilters(gen.selection?.filters, 'generators');\n  1266→    collectTagsFromMutations(gen.stateUpdates || [], 'generators');\n  1267→    (gen.variants?.options || []).forEach(variant => {\n  1268→      collectTagsFromCondition(variant.when, 'generators');\n  1269→      collectApplyTagUsage(variant.apply?.tags, addTagUsage, 'generators');\n  1270→      collectTagsFromMutations(variant.apply?.stateUpdates || [], 'generators');\n  1271→    });\n  1272→  });\n  1273→}\n  1274→\n  1275→function collectSystemTagsByType(sys, config, addTagUsage, collectTagsFromCondition, collectTagsFromMutations) {\n  1276→  if (sys.systemType === 'tagDiffusion') {\n  1277→    (config.convergence?.tags || []).forEach(tag => addTagUsage(tag, 'systems'));\n  1278→    (config.divergence?.tags || []).forEach(tag => addTagUsage(tag, 'systems'));\n  1279→  } else if (sys.systemType === 'thresholdTrigger') {\n  1280→    (config.conditions || []).forEach((cond) => collectTagsFromCondition(cond, 'systems'));\n  1281→    collectTagsFromMutations(config.actions || [], 'systems');\n  1282→  } else if (sys.systemType === 'graphContagion') {\n  1283→    if (config.contagion?.type === 'tag' && config.contagion.tagPattern) addTagUsage(config.contagion.tagPattern, 'systems');\n  1284→    collectTagsFromMutations(config.infectionAction ? [config.infectionAction] : [], 'systems');\n  1285→  } else if (sys.systemType === 'connectionEvolution') {\n  1286→    (config.rules || []).forEach((rule) => collectTagsFromMutations(rule?.action ? [rule.action] : [], 'systems'));\n  1287→  } else if (sys.systemType === 'clusterFormation') {\n  1288→    (config.metaEntity?.additionalTags || []).forEach((tag) => addTagUsage(tag, 'systems'));\n  1289→  } else if (sys.systemType === 'planeDiffusion') {\n  1290→    if (config.sources?.tagFilter) addTagUsage(config.sources.tagFilter, 'systems');\n  1291→    if (config.sources?.strengthTag) addTagUsage(config.sources.strengthTag, 'systems');\n  1292→    if (config.sinks?.tagFilter) addTagUsage(config.sinks.tagFilter, 'systems');\n  1293→    if (config.sinks?.strengthTag) addTagUsage(config.sinks.strengthTag, 'systems');\n  1294→    (config.outputTags || []).forEach((tagConfig) => addTagUsage(tagConfig.tag, 'systems'));\n  1295→    if (config.valueTag) addTagUsage(config.valueTag, 'systems');\n  1296→  }\n  1297→}\n  1298→\n  1299→function collectSystemTags(systems, addTagUsage, collectTagsFromFilters, collectTagsFromCondition, collectTagsFromMutations) {"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"5d817b4c-9bb3-47e4-a954-e5b8841177c2"}
