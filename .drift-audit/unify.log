{\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.edv-expandable-content {\n  margin-top: 6px;\n  padding: 10px;\n  background: var(--bg-primary);\n  border-radius: 4px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n/* ==========================================================================\n   VisualTraitsList\n   ========================================================================== */\n\n.edv-traits {\n  margin-bottom: 16px;\n}\n\n.edv-traits-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.edv-traits-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.edv-traits-tag {\n  padding: 4px 10px;\n  background: rgb(59 130 246 / 15%);\n  border: 1px solid rgb(59 130 246 / 25%);\n  border-radius: 12px;\n  font-size: 12px;\n  color: var(--text-primary);\n}\n\n/* ==========================================================================\n   AliasesList\n   ========================================================================== */\n\n.edv-aliases {\n  margin-bottom: 16px;\n}\n\n.edv-aliases-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.edv-aliases-add-btn {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  color: var(--text-secondary);\n  font-size: 10px;\n  padding: 1px 6px;\n  border-radius: 3px;\n  cursor: pointer;\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.edv-aliases-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  align-items: center;\n}\n\n.edv-aliases-edit-wrap {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n}\n\n.edv-aliases-edit-input {\n  padding: 3px 8px;\n  background: var(--bg-primary);\n  border: 1px solid var(--accent-color);\n  border-radius: 12px;\n  font-size: 12px;\n  color: var(--text-primary);\n  outline: none;\n  width: var(--edv-input-width);\n}\n\n.edv-aliases-tag {\n  padding: 4px 10px;\n  background: var(--bg-tertiary);\n  border-radius: 12px;\n  font-size: 12px;\n  color: var(--text-secondary);\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.edv-aliases-tag-editable {\n  cursor: pointer;\n}\n\n.edv-aliases-remove {\n  cursor: pointer;\n  color: var(--text-muted);\n  font-size: 10px;\n  margin-left: 2px;\n  line-height: 1;\n}\n\n.edv-aliases-empty {\n  font-size: 12px;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* ==========================================================================\n   EntityDetailView - Main layout\n   ========================================================================== */\n\n.edv {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-height: 0;\n}\n\n/* Header bar */\n.edv-header {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 12px 16px;\n  background: var(--bg-secondary);\n  border-bottom: 1px solid var(--border-color);\n  flex-shrink: 0;\n}\n\n.edv-back-btn {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  padding: 6px 12px;\n  cursor: pointer;\n  font-size: 12px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.edv-header-info {\n  flex: 1;\n}\n\n.edv-entity-name {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--text-primary);\n}\n\n.edv-entity-meta {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n.edv-esc-hint {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Two-column body */\n.edv-body {\n  display: flex;\n  flex: 1;\n  min-height: 0;\n}\n\n/* Main content */\n.edv-main {\n  flex: 1;\n  overflow-y: auto;\n  padding: 20px 24px;\n  min-width: 0;\n}\n\n/* Section label (shared across Summary, Visual Thesis, Full Description) */\n.edv-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.edv-section-label-wrap {\n  flex-wrap: wrap;\n}\n\n.edv-section-label-visual-thesis {\n  color: rgb(139 92 246 / 80%);\n}\n\n/* Small inline button (Edit, Undo, Rename, Patch Events, Add, Clear Notes) */\n.edv-inline-btn {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  color: var(--text-secondary);\n  font-size: 10px;\n  padding: 1px 6px;\n  border-radius: 3px;\n  cursor: pointer;\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.edv-inline-btn-ghost {\n  background: none;\n  border: 1px solid var(--border-color);\n  color: var(--text-muted);\n  font-size: 10px;\n  padding: 1px 6px;\n  border-radius: 3px;\n  cursor: pointer;\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.edv-margin-notes-spaced {\n  margin-top: 12px;\n}\n\n/* Version hint */\n.edv-version-hint {\n  text-transform: none;\n  letter-spacing: normal;\n  font-size: 10px;\n  opacity: 0.7;\n}\n\n/* Section spacing */\n.edv-section {\n  margin-bottom: 20px;\n}\n\n/* Summary text */\n.edv-summary-text {\n  font-size: 15px;\n  color: var(--text-primary);\n  line-height: 1.6;\n  margin: 0;\n}\n\n.edv-placeholder {\n  font-style: italic;\n  color: var(--text-muted);\n}\n\n/* Summary textarea */\n.edv-summary-textarea {\n  width: 100%;\n  min-height: 80px;\n  font-size: 15px;\n  color: var(--text-primary);\n  line-height: 1.6;\n  margin: 0;\n  padding: 8px;\n  background: var(--bg-primary);\n  border: 1px solid var(--accent-color);\n  border-radius: 4px;\n  resize: vertical;\n  font-family: inherit;\n  outline: none;\n  box-sizing: border-box;\n}\n\n/* Visual Thesis */\n.edv-visual-thesis {\n  font-size: 14px;\n  color: var(--text-primary);\n  line-height: 1.6;\n  margin: 0;\n  padding: 12px 16px;\n  background: rgb(139 92 246 / 8%);\n  border: 1px solid rgb(139 92 246 / 20%);\n  border-radius: 8px;\n  font-style: italic;\n}\n\n/* Description textarea */\n.edv-desc-textarea {\n  width: 100%;\n  min-height: 200px;\n  font-size: 14px;\n  color: var(--text-secondary);\n  line-height: 1.7;\n  margin: 0;\n  padding: 8px;\n  background: var(--bg-primary);\n  border: 1px solid var(--accent-color);\n  border-radius: 4px;\n  resize: vertical;\n  font-family: inherit;\n  white-space: pre-wrap;\n  outline: none;\n  box-sizing: border-box;\n}\n\n/* Description rendered */\n.edv-description {\n  font-size: 14px;\n  color: var(--text-secondary);\n  line-height: 1.7;\n}\n\n/* Markdown heading overrides */\n.edv-description h2,\n.edv-md-h2 {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--text-primary);\n  margin: 16px 0 6px;\n  border-bottom: 1px solid var(--border-color);\n  padding-bottom: 3px;\n}\n\n.edv-description h3,\n.edv-md-h3 {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-primary);\n  margin: 12px 0 4px;\n}\n\n.edv-description p,\n.edv-md-p {\n  margin: 0 0 8px;\n}\n\n.edv-description ul,\n.edv-md-ul {\n  margin: 4px 0 8px;\n  padding-left: 20px;\n}\n\n.edv-description ol,\n.edv-md-ol {\n  margin: 4px 0 8px;\n  padding-left: 20px;\n}\n\n.edv-description li,\n.edv-md-li {\n  margin-bottom: 2px;\n}\n\n.edv-description table,\n.edv-md-table {\n  border-collapse: collapse;\n  margin: 8px 0;\n  font-size: 13px;\n  width: 100%;\n}\n\n.edv-description th,\n.edv-md-th {\n  border: 1px solid var(--border-color);\n  padding: 4px 8px;\n  text-align: left;\n  font-weight: 600;\n  background: var(--bg-tertiary);\n}\n\n.edv-description td,\n.edv-md-td {\n  border: 1px solid var(--border-color);\n  padding: 4px 8px;\n}\n\n.edv-no-desc {\n  font-style: italic;\n  color: var(--text-muted);\n  margin: 0;\n}\n\n/* Backref separator */\n.edv-separator {\n  border-top: 1px solid var(--border-color);\n  margin: 8px 0 16px;\n}\n\n/* No enrichment fallback */\n.edv-no-enrichment {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n/* Sidebar */\n.edv-sidebar {\n  width: 320px;\n  flex-shrink: 0;\n  border-left: 1px solid var(--border-color);\n  overflow-y: auto;\n  padding: 20px 16px;\n  background: var(--bg-secondary);\n}\n\n.edv-sidebar-title {\n  margin: 0 0 16px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-primary);\n  border-bottom: 1px solid var(--border-color);\n  padding-bottom: 10px;\n}\n\n.edv-sidebar-divider {\n  border-top: 1px solid var(--border-color);\n  margin: 12px 0;\n}\n\n.edv-sidebar-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* Debug chain step labels */\n.edv-debug-step {\n  margin-bottom: 8px;\n}\n\n.edv-debug-step-label {\n  font-size: 10px;\n  margin-bottom: 4px;\n  font-weight: 500;\n}\n\n.edv-debug-step-label-narrative {\n  color: rgb(59 130 246 / 80%);\n}\n\n.edv-debug-step-label-thesis {\n  color: rgb(139 92 246 / 80%);\n}\n\n.edv-debug-step-label-traits {\n  color: rgb(34 197 94 / 80%);\n}\n\n/* No debug info */\n.edv-no-debug {\n  font-size: 12px;\n  color: var(--text-muted);\n  font-style: italic;\n  margin-top: 12px;\n}\n\n/* Historian margin notes spacing */\n.edv-margin-notes {\n  margin-top: 12px;\n}\n","structuredPatch":[{"oldStart":474,"oldLines":8,"newStart":474,"newLines":6,"lines":[" /* No enrichment fallback */"," .edv-no-enrichment {","   padding: 40px;","-  text-align: center;","-  color: var(--text-muted);"," }"," "," /* Sidebar */"]}],"userModified":false,"replaceAll":false}}
