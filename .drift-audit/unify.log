d;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgb(0 0 0 / 60%);\n}\n\n.dgm-dialog {\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  width: 700px;\n  max-width: 90vw;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* Header */\n.dgm-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-shrink: 0;\n}\n\n.dgm-title {\n  margin: 0;\n  font-size: 16px;\n}\n\n.dgm-subtitle {\n  margin: 4px 0 0;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.dgm-header-actions {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.dgm-cost {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.dgm-cancel-btn {\n  padding: 4px 12px;\n  font-size: 12px;\n}\n\n/* Scrollable content */\n.dgm-content {\n  flex: 1;\n  overflow: auto;\n  padding: 16px 20px;\n  min-height: 0;\n}\n\n/* MessageBubble */\n.dgm-bubble-system {\n  padding: 8px 12px;\n  font-size: 11px;\n  color: var(--text-muted);\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  margin-bottom: 8px;\n  max-height: 100px;\n  overflow: hidden;\n  position: relative;\n}\n\n.dgm-bubble-system-heading {\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n\n.dgm-bubble-system-preview {\n  opacity: 0.7;\n}\n\n.dgm-bubble {\n  padding: 10px 12px;\n  font-size: 12px;\n  border-radius: 6px;\n  margin-bottom: 8px;\n}\n\n.dgm-bubble-assistant {\n  background: var(--bg-tertiary);\n  border-left: 3px solid var(--accent-color);\n}\n\n.dgm-bubble-user {\n  background: transparent;\n  border-left: 3px solid var(--success-color, #22c55e);\n}\n\n.dgm-bubble-role {\n  font-weight: 600;\n  margin-bottom: 4px;\n  font-size: 11px;\n}\n\n.dgm-bubble-role-assistant {\n  color: var(--accent-color);\n}\n\n.dgm-bubble-role-user {\n  color: var(--success-color, #22c55e);\n}\n\n.dgm-bubble-content {\n  line-height: 1.5;\n  color: var(--text-primary);\n}\n\n/* Generating / failed states */\n.dgm-generating {\n  padding: 12px;\n  font-size: 12px;\n  color: var(--text-muted);\n  text-align: center;\n}\n\n.dgm-failed {\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border-left: 3px solid var(--danger);\n  font-size: 12px;\n  color: var(--danger);\n  margin-bottom: 8px;\n}\n\n/* Proposed dynamics */\n.dgm-proposed {\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--accent-color);\n  padding: 12px;\n  margin-bottom: 12px;\n}\n\n.dgm-proposed-heading {\n  font-weight: 600;\n  margin-bottom: 8px;\n  font-size: 13px;\n}\n\n.dgm-proposed-item {\n  padding: 8px 10px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  margin-bottom: 6px;\n  font-size: 12px;\n}\n\n.dgm-proposed-meta {\n  margin-top: 4px;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.dgm-proposed-overrides {\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid var(--border-color);\n}\n\n.dgm-proposed-override-item {\n  font-size: 10px;\n  color: var(--text-secondary);\n  margin-bottom: 2px;\n}\n\n.dgm-proposed-override-label {\n  color: var(--text-muted);\n}\n\n/* Footer */\n.dgm-footer {\n  padding: 12px 20px 16px;\n  border-top: 1px solid var(--border-color);\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.dgm-feedback-row {\n  display: flex;\n  gap: 8px;\n}\n\n.dgm-feedback-input {\n  flex: 1;\n  resize: vertical;\n  min-height: 60px;\n  max-height: 120px;\n  font-size: 12px;\n}\n\n.dgm-actions {\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n  align-items: center;\n}\n\n.dgm-action-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","numLines":225,"startLine":1,"totalLines":225}}}
