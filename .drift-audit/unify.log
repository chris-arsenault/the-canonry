{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_0153DRiQn5TPjs3znVtU89Yt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015BQ9GpXd8yy3ZAC7cuNK2b","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/eslint-rules/no-inline-keyboard-nav.js","content":"// drift-generated\nexport default {\n  meta: {\n    type: \"suggestion\",\n    docs: {\n      description:\n        \"Disallow inline keyboard navigation switch blocks that duplicate useKeyboardNavigation\",\n    },\n    messages: {\n      inlineKeyboardNav:\n        \"Inline keyboard navigation switch block detected (handles ArrowDown/ArrowUp/Enter/Escape). \" +\n        \"Use the shared useKeyboardNavigation hook from @the-canonry/shared-components instead. \" +\n        \"See docs/patterns/keyboard-navigation.md\",\n    },\n    schema: [],\n  },\n\n  create(context) {\n    const filename = context.filename || context.getFilename();\n    // Allow the hook implementation itself\n    if (/shared-components/.test(filename)) return {};\n\n    const NAV_KEYS = new Set([\"ArrowDown\", \"ArrowUp\", \"Enter\", \"Escape\"]);\n    const THRESHOLD = 3; // at least 3 of the 4 keys → almost certainly navigation\n\n    return {\n      SwitchStatement(node) {\n        const caseKeys = new Set();\n        for (const c of node.cases) {\n          if (\n            c.test &&\n            c.test.type === \"Literal\" &&\n            typeof c.test.value === \"string\" &&\n            NAV_KEYS.has(c.test.value)\n          ) {\n            caseKeys.add(c.test.value);\n          }\n        }\n        if (caseKeys.size >= THRESHOLD) {\n          context.report({ node, messageId: \"inlineKeyboardNav\" });\n        }\n      },\n    };\n  },\n};\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3967,"cache_read_input_tokens":70788,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3967},"output_tokens":10,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b581011f-7823-4110-9748-054ecf96699a","uuid":"fcc7e2b2-09c3-432b-ac41-5dc761887e54"}
