{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X6phUo1mYFZVSnDTjzF72N","type":"tool_result","content":"     1→/**\n     2→ * useHistorianReview - Hook for historian annotation of entities and chronicles\n     3→ *\n     4→ * Follows the useCopyEdit pattern:\n     5→ * 1. Create run in IndexedDB with target context\n     6→ * 2. Dispatch worker task\n     7→ * 3. Monitor IndexedDB for status changes (polling)\n     8→ * 4. User reviews notes via HistorianReviewModal\n     9→ * 5. Apply accepted notes to entity enrichment or chronicle record\n    10→ */\n    11→\n    12→import { useState, useCallback, useRef, useEffect } from \"react\";\n    13→import type { EnrichmentType } from \"../lib/enrichmentTypes\";\n    14→import { getEnqueue } from \"../lib/db/enrichmentQueueBridge\";\n    15→import type {\n    16→  HistorianRun,\n    17→  HistorianNote,\n    18→  HistorianConfig,\n    19→  HistorianTargetType,\n    20→  HistorianTone,\n    21→} from \"../lib/historianTypes\";\n    22→import {\n    23→  createHistorianRun,\n    24→  getHistorianRun,\n    25→  updateHistorianRun,\n    26→  deleteHistorianRun,\n    27→  generateHistorianRunId,\n    28→} from \"../lib/db/historianRepository\";\n    29→\n    30→// ============================================================================\n    31→// Types\n    32→// ============================================================================\n    33→\n    34→export interface HistorianReviewConfig {\n    35→  projectId: string;\n    36→  simulationRunId: string;\n    37→  targetType: HistorianTargetType;\n    38→  targetId: string;\n    39→  targetName: string;\n    40→  sourceText: string;\n    41→  /** Serialized entity/chronicle metadata + neighbor summaries + world context */\n    42→  contextJson: string;\n    43→  /** Serialized sample of historian's prior annotations */\n    44→  previousNotesJson: string;\n    45→  /** The historian persona config */\n    46→  historianConfig: HistorianConfig;\n    47→  /** Tone/mood for this review session */\n    48→  tone: HistorianTone;\n    49→}\n    50→\n    51→export interface UseHistorianReviewReturn {\n    52→  /** Current run state */\n    53→  run: HistorianRun | null;\n    54→  /** Whether a historian review session is active */\n    55→  isActive: boolean;\n    56→  /** Start a new historian review session */\n    57→  startReview: (config: HistorianReviewConfig) => Promise<void>;\n    58→  /** Toggle accept/reject for a note */\n    59→  toggleNoteDecision: (noteId: string, accepted: boolean) => Promise<void>;\n    60→  /** Apply accepted notes and close the session */"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"41906533-7b52-4305-b0ae-16a6ca5b9f14"}
