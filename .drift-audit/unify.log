{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019QV8og6i1W5FwY6AZpAh21","type":"tool_result","content":"     1→/**\n     2→ * Schema Usage Map - Computes bidirectional reference tracking across all config elements\n     3→ *\n     4→ * This utility analyzes the relationships between:\n     5→ * - Schema (entity kinds, relationship kinds, statuses, subtypes, tags)\n     6→ * - Pressures (and their feedback factors)\n     7→ * - Eras (and their generator/system weights)\n     8→ * - Generators (and their entity/relationship references)\n     9→ * - Systems (and their entity/relationship/pressure references)\n    10→ * - Actions (and their actor/target/outcome references)\n    11→ *\n    12→ * Returns a comprehensive map showing:\n    13→ * 1. Where each element is used (forward references)\n    14→ * 2. What each element references (backward references)\n    15→ * 3. Validation status for each reference\n    16→ */\n    17→\n    18→// ---------------------------------------------------------------------------\n    19→// Internal convenience type aliases for domain JSON config objects.\n    20→// These are intentionally loose (Record-based) because the data comes from\n    21→// user-authored JSON and the shapes are defined by world-schema, not here.\n    22→// ---------------------------------------------------------------------------\n    23→\n    24→/* eslint-disable @typescript-eslint/no-explicit-any */\n    25→type AnyRecord = Record<string, any>;\n    26→/* eslint-enable @typescript-eslint/no-explicit-any */\n    27→\n    28→/** A reference entry stored in usage tracking arrays (e.g. { id, name }). */\n    29→interface Ref {\n    30→  id: string;\n    31→  name?: string;\n    32→  [key: string]: unknown;\n    33→}\n    34→\n    35→/** Context passed alongside invalid-reference recording. */\n    36→interface RefInfo {\n    37→  type: string;\n    38→  id: string;\n    39→  field: string;\n    40→  location?: string;\n    41→}\n    42→\n    43→/** A single invalid reference found during scanning. */\n    44→export interface InvalidRef {\n    45→  type: string;\n    46→  id: string;\n    47→  field: string;\n    48→  refType: string;\n    49→  refId: string;\n    50→  location?: string;\n    51→}\n    52→\n    53→/** An orphaned element (unused). */\n    54→export interface Orphan {\n    55→  type: string;\n    56→  id: string;\n    57→  reason: string;\n    58→}\n    59→\n    60→/** A compatibility issue found during checking. */\n    61→export interface CompatibilityIssue {\n    62→  type: string;\n    63→  id: string;\n    64→  field: string;\n    65→  issue: string;\n    66→}\n    67→\n    68→export interface ValidationResults {\n    69→  invalidRefs: InvalidRef[];\n    70→  orphans: Orphan[];\n    71→  compatibility: CompatibilityIssue[];\n    72→}\n    73→\n    74→export interface ElementUsage {\n    75→  generators: Ref[];\n    76→  systems: Ref[];\n    77→  actions: Ref[];\n    78→  pressures: Ref[];\n    79→  [key: string]: Ref[] | string[];\n    80→}\n    81→\n    82→export interface UsageMap {\n    83→  entityKinds: Record<string, ElementUsage>;\n    84→  subtypes: Record<string, { generators: Ref[]; systems: Ref[]; actions: Ref[] }>;\n    85→  statuses: Record<string, { generators: Ref[]; systems: Ref[]; actions: Ref[] }>;\n    86→  relationshipKinds: Record<string, ElementUsage & { srcKinds: string[]; dstKinds: string[] }>;\n    87→  tags: Record<string, Record<string, Ref[]>>;\n    88→  pressures: Record<string, { generators: Ref[]; systems: Ref[]; actions: Ref[]; eras: Ref[]; feedbackSources: AnyRecord[]; feedbackSinks: AnyRecord[] }>;\n    89→  generators: Record<string, { eras: Ref[] }>;\n    90→  systems: Record<string, { eras: Ref[] }>;\n    91→  validation: ValidationResults;\n    92→}\n    93→\n    94→export interface ElementValidationResult {\n    95→  isValid: boolean;\n    96→  invalidRefs: InvalidRef[];\n    97→  compatibility: CompatibilityIssue[];\n    98→  isOrphan: boolean;\n    99→}\n   100→\n   101→/**\n   102→ * Compute complete usage map for all schema elements\n   103→ */\n   104→export function computeUsageMap(\n   105→  schema: AnyRecord,\n   106→  pressures: AnyRecord[],\n   107→  eras: AnyRecord[],\n   108→  generators: AnyRecord[],\n   109→  systems: AnyRecord[],\n   110→  actions: AnyRecord[],\n   111→): UsageMap {\n   112→  const usageMap = {\n   113→    // Schema element usage tracking\n   114→    entityKinds: {},      // { kindId: { generators: [], systems: [], actions: [], pressures: [] } }\n   115→    subtypes: {},         // { subtype: { generators: [], systems: [], actions: [] } }\n   116→    statuses: {},         // { status: { generators: [], systems: [], actions: [] } }\n   117→    relationshipKinds: {},// { kindId: { generators: [], systems: [], actions: [], pressures: [] } }\n   118→    tags: {},             // { tag: { pressures: [], systems: [], generators: [], actions: [] } }\n   119→\n   120→    // Cross-tab reference tracking"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"fab6ead0-4bc1-45a1-b5cc-5662ff25e8db"}
