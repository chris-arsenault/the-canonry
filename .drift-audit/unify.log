figSync({\n  externalHistorianConfig,\n  onHistorianConfigChange,\n}: UseHistorianConfigSyncProps): UseHistorianConfigSyncReturn {\n  const [localHistorianConfig, setLocalHistorianConfig] = useState<HistorianConfig>(() =>\n    resolveInitialHistorianConfig(externalHistorianConfig)\n  );\n  const [hasMigrated, setHasMigrated] = useState<boolean>(false);\n  const pendingHistorianConfigRef = useRef<HistorianConfig>(localHistorianConfig);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1324,"cache_read_input_tokens":81988,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1324},"output_tokens":24,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"e16ccaf3-5815-4752-ae67-6c5ed994e71a"}
