{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YSWo6MaVCoLopBVQ12e6CF","type":"tool_result","content":"     1→/**\n     2→ * Utility exports from shared-components\n     3→ */\n     4→\n     5→export {\n     6→  computeUsageMap,\n     7→  getElementValidation,\n     8→  getUsageSummary,\n     9→  computeTagUsage,\n    10→  getEntityKindUsageSummary,\n    11→  getRelationshipKindUsageSummary,\n    12→  computeSchemaUsage,\n    13→} from './schemaUsageMap';\n    14→\n    15→export type {\n    16→  UsageMap,\n    17→  ElementUsage,\n    18→  ElementValidationResult,\n    19→  InvalidRef,\n    20→  Orphan,\n    21→  CompatibilityIssue,\n    22→  ValidationResults,\n    23→  ComputeTagUsageParams,\n    24→  ComputeSchemaUsageParams,\n    25→  SchemaUsage,\n    26→} from './schemaUsageMap';\n    27→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"75a6001a-316b-41d9-978b-e55b4a3dc6ac"}
