{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012i5wKhLYHDxNtrCWhQzwhv","type":"tool_result","content":"     1→/**\n     2→ * EnableToggle - Toggle switch component\n     3→ */\n     4→\n     5→import React from 'react';\n     6→\n     7→interface EnableToggleProps {\n     8→  enabled: boolean;\n     9→  onChange?: (value: boolean) => void;\n    10→  onClick?: (e: React.MouseEvent | React.KeyboardEvent) => void;\n    11→  label?: string;\n    12→  className?: string;\n    13→}\n    14→\n    15→/**\n    16→ * @param {Object} props\n    17→ * @param {boolean} props.enabled - Current toggle state\n    18→ * @param {Function} props.onChange - Callback when toggle changes (receives new value)\n    19→ * @param {Function} [props.onClick] - Optional raw click handler (receives event, takes priority)\n    20→ * @param {string} [props.label] - Optional label beside the toggle\n    21→ * @param {string} [props.className] - Optional additional class names\n    22→ */\n    23→export function EnableToggle({ enabled, onChange, onClick, label, className = '' }: EnableToggleProps) {\n    24→  const handleClick = (e) => {\n    25→    if (onClick) {\n    26→      onClick(e);\n    27→    } else if (onChange) {\n    28→      onChange(!enabled);\n    29→    }\n    30→  };\n    31→\n    32→  return (\n    33→    <div className={`flex items-center gap-lg ${className}`.trim()}>\n    34→      <div\n    35→        onClick={handleClick}\n    36→        className={`toggle ${enabled ? 'toggle-on' : ''}`}\n    37→        role=\"button\"\n    38→        tabIndex={0}\n    39→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleClick(e); }}\n    40→      >\n    41→        <div className=\"toggle-knob\" />\n    42→      </div>\n    43→      {label && (\n    44→        <span className=\"text-md text-muted\">{label}</span>\n    45→      )}\n    46→    </div>\n    47→  );\n    48→}\n    49→\n    50→export default EnableToggle;\n    51→\n    52→"}]},"p