  border-radius: var(--radius-2xl);\n    70→  border: 1px solid var(--color-border);\n    71→  padding: 20px;\n    72→  transition: all var(--transition-normal);\n    73→  cursor: pointer;\n    74→  position: relative;\n    75→}\n    76→\n    77→.action-card:hover {\n    78→  border-color: var(--color-accent);\n    79→  transform: translateY(-2px);\n    80→  box-shadow: 0 4px 12px rgb(0 0 0 / 30%);\n    81→}\n    82→\n    83→.action-card-disabled {\n    84→  opacity: 0.5;\n    85→}\n    86→\n    87→/* Card badges */\n    88→.action-card-badges {\n    89→  display: flex;\n    90→  flex-wrap: wrap;\n    91→  gap: var(--spacing-sm);\n    92→  margin-top: var(--spacing-lg);\n    93→}\n    94→\n    95→/* Enable toggle */\n    96→.enable-toggle {\n    97→  width: 36px;\n    98→  height: 20px;\n    99→  border-radius: 10px;\n   100→  background-color: #374151;\n   101→  cursor: pointer;\n   102→  position: relative;\n   103→  transition: background-color var(--transition-normal);\n   104→  flex-shrink: 0;\n   105→}\n   106→\n   107→.enable-toggle-on {\n   108→  background-color: var(--color-success);\n   109→}\n   110→\n   111→.enable-toggle-knob {\n   112→  position: absolute;\n   113→  top: 2px;\n   114→  left: 2px;\n   115→  width: 16px;\n   116→  height: 16px;\n   117→  border-radius: var(--radius-full);\n   118→  background-color: #fff;\n   119→  transition: transform var(--transition-normal);\n   120→}\n   121→\n   122→.enable-toggle-on .enable-toggle-knob {\n   123→  transform: translateX(16px);\n   124→}\n   125→\n   126→/* Add card (dashed border style) */\n   127→.actions-add-card {\n   128→  background-color: transparent;\n   129→  border-radius: var(--radius-2xl);\n   130→  border: 2px dashed var(--color-border);\n   131→  padding: 40px 20px;\n   132→  cursor: pointer;\n   133→  transition: all var(--transition-normal);\n   134→  display: flex;\n   135→  flex-direction: column;\n   136→  align-items: center;\n   137→  justify-content: center;\n   138→  gap: var(--spacing-md);\n   139→  color: var(--color-text-dim);\n   140→  min-height: 140px;\n   141→}\n   142→\n   143→.actions-add-card:hover {\n   144→  border-color: var(--color-accent);\n   145→  color: var(--color-accent);\n   146→  background-color: rgb(245 158 11 / 5%);\n   147→}\n   148→\n   149→/* Validation borders for action cards */\n   150→.action-card-invalid {\n   151→  border-color: var(--color-danger);\n   152→  box-shadow: 0 0 0 1px var(--color-danger);\n   153→}\n   154→\n   155→.action-card-warning {\n   156→  border-color: var(--color-warning);\n   157→  box-shadow: 0 0 0 1px var(--color-warning);\n   158→}\n   159→"}]},"parent_tool_use_id":null,"session_id":"32287e93-604d-418a-8354-e377e7fb06c1","uuid":"580df953-1bb3-46dc-b6bd-298ef90d4de9","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/actions.css","content":"/**\n * Actions editor specific styles\n */\n\n/* Editor container */\n.actions-editor {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: var(--spacing-2xl);\n}\n\n/* Header section */\n.actions-header {\n  margin-bottom: var(--spacing-3xl);\n}\n\n.actions-title {\n  font-size: 32px;\n  font-weight: var(--font-weight-semibold);\n  background: var(--gradient-accent);\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n  margin-bottom: var(--spacing-md);\n}\n\n.actions-subtitle {\n  font-size: var(--font-size-lg);\n  color: var(--color-text-muted);\n  margin-bottom: var(--spacing-xl);\n  line-height: var(--line-height-normal);\n}\n\n/* Stats section */\n.actions-stats {\n  display: flex;\n  gap: var(--spacing-2xl);\n}\n\n.actions-stat {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-xs);\n}\n\n.actions-stat-label {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.actions-stat-value {\n  font-size: 24px;\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-accent);\n}\n\n/* Action grid */\n.actions-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\n  gap: var(--spacing-xl);\n  margin-bottom: var(--spacing-2xl);\n}\n\n/* Action card */\n.action-card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  padding: 20px;\n  transition: all var(--transition-normal);\n  cursor: pointer;\n  position: relative;\n}\n\n.action-card:hover {\n  border-color: var(--color-accent);\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgb(0 0 0 / 30%);\n}\n\n.action-card-disabled {\n  opacity: 0.5;\n}\n\n/* Card badges */\n.action-card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-lg);\n}\n\n/* Enable toggle */\n.enable-toggle {\n  width: 36px;\n  height: 20px;\n  border-radius: 10px;\n  background-color: #374151;\n  cursor: pointer;\n  position: relative;\n  transition: background-color var(--transition-normal);\n  flex-shrink: 0;\n}\n\n.enable-toggle-on {\n  background-color: var(--color-success);\n}\n\n.enable-toggle-knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: var(--radius-full);\n  background-color: #fff;\n  transition: transform var(--transition-normal);\n}\n\n.enable-toggle-on .enable-toggle-knob {\n  transform: translateX(16px);\n}\n\n/* Add card (dashed border style) */\n.actions-add-card {\n  background-color: transparent;\n  border-radius: var(--radius-2xl);\n  border: 2px dashed var(--color-border);\n  padding: 40px 20px;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  color: var(--color-text-dim);\n  min-height: 140px;\n}\n\n.actions-add-card:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n  background-color: rgb(245 158 11 / 5%);\n}\n\n/* Validation borders for action cards */\n.action-card-invalid {\n  border-color: var(--color-danger);\n  box-shadow: 0 0 0 1px var(--color-danger);\n}\n\n.action-card-warning {\n  border-color: var(--color-warning);\n  box-shadow: 0 0 0 1px var(--color-warning);\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
