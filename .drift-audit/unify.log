hivist-narrative {\n  font-family: var(--font-serif);\n  font-style: italic;\n  color: var(--_section-text);\n}\n\n/* Uppercase label (meta labels, sub-section labels) */\n.archivist-label {\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--_section-accent);\n}\n\n/* Modal overlay */\n.archivist-modal-overlay {\n  position: fixed;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-2xl);\n}\n\n/* Modal close button */\n.archivist-close-btn {\n  padding: var(--spacing-md) var(--spacing-3xl);\n  border-radius: var(--radius-md);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n}\n\n.archivist-close-btn:hover {\n  color: var(--color-text-primary);\n  transform: translateY(-1px);\n  box-shadow: var(--shadow-md);\n}\n\n/* Footer bar */\n.archivist-section-footer {\n  display: flex;\n  align-items: center;\n  border-top: 1px solid var(--_section-separator);\n}\n","structuredPatch":[],"originalFile":null}}
