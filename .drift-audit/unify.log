{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012VGR3J3Z1dwBPFXPTA2ctt","type":"tool_result","content":"     1→/**\n     2→ * SectionHeader - Section title with optional count badge and description\n     3→ */\n     4→\n     5→import React from 'react';\n     6→\n     7→interface SectionHeaderProps {\n     8→  title: string;\n     9→  description?: string;\n    10→  icon?: string;\n    11→  count?: string | number;\n    12→  actions?: React.ReactNode;\n    13→  className?: string;\n    14→}\n    15→\n    16→/**\n    17→ * @param {Object} props\n    18→ * @param {string} props.title - Section title\n    19→ * @param {string} [props.description] - Optional description text\n    20→ * @param {string} [props.icon] - Optional emoji icon\n    21→ * @param {string} [props.count] - Optional count badge text (e.g. \"3 active / 5 total\")\n    22→ * @param {React.ReactNode} [props.actions] - Optional action buttons on the right\n    23→ * @param {string} [props.className] - Optional additional class names\n    24→ */\n    25→export function SectionHeader({\n    26→  title,\n    27→  description,\n    28→  icon,\n    29→  count,\n    30→  actions,\n    31→  className = '',\n    32→}: SectionHeaderProps) {\n    33→  return (\n    34→    <>\n    35→      <div className={`flex-between mb-lg ${className}`.trim()}>\n    36→        <div className=\"section-title mb-0\">\n    37→          {icon && <span className=\"section-title-icon\">{icon}</span>}\n    38→          {title}\n    39→          {count && <span className=\"badge-count\">{count}</span>}\n    40→        </div>\n    41→        {actions}\n    42→      </div>\n    43→      {description && <div className=\"section-desc\">{description}</div>}\n    44→    </>\n    45→  );\n    46→}\n    47→\n    48→export default SectionHeader;\n    49→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"248ce93f-5615-4668-b0df-9cceef2c952f"}
