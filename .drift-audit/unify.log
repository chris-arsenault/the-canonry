{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DVvnN4syCMwab9qHN4TFCu","type":"tool_result","content":"     1→/**\n     2→ * EnableToggle - Toggle switch component\n     3→ */\n     4→\n     5→import React from 'react';\n     6→import PropTypes from 'prop-types';\n     7→\n     8→/**\n     9→ * @param {Object} props\n    10→ * @param {boolean} props.enabled - Current toggle state\n    11→ * @param {Function} props.onChange - Callback when toggle changes (receives new value)\n    12→ * @param {Function} [props.onClick] - Optional raw click handler (receives event, takes priority)\n    13→ * @param {string} [props.label] - Optional label beside the toggle\n    14→ * @param {string} [props.className] - Optional additional class names\n    15→ */\n    16→export function EnableToggle({ enabled, onChange, onClick, label, className = '' }) {\n    17→  const handleClick = (e) => {\n    18→    if (onClick) {\n    19→      onClick(e);\n    20→    } else if (onChange) {\n    21→      onChange(!enabled);\n    22→    }\n    23→  };\n    24→\n    25→  return (\n    26→    <div className={`flex items-center gap-lg ${className}`.trim()}>\n    27→      <div\n    28→        onClick={handleClick}\n    29→        className={`toggle ${enabled ? 'toggle-on' : ''}`}\n    30→        role=\"button\"\n    31→        tabIndex={0}\n    32→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleClick(e); }}\n    33→      >\n    34→        <div className=\"toggle-knob\" />\n    35→      </div>\n    36→      {label && (\n    37→        <span className=\"text-md text-muted\">{label}</span>\n    38→      )}\n    39→    </div>\n    40→  );\n    41→}\n    42→\n    43→export default EnableToggle;\n    44→\n    45→EnableToggle.propTypes = {\n    46→  enabled: PropTypes.bool.isRequired,\n    47→  onChange: PropTypes.func,\n    48→  onClick: PropTypes.func,\n    49→  label: PropTypes.string,\n    50→  className: PropTypes.string,\n    51→};\n    52→"}]},"parent_tool_use_id":"toolu_014qHrcVwQsLwB8UKUVYXMFD","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"8459925b-f0e5-49cb-b1a1-45a2af3435ba"}
