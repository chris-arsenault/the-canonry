{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_0197eEGMLHxuhNmfuNN32pqs","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PY8miJcoFSgYQPE4ZrHdDq","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/error-boundary.css","content":"/**\n * ErrorBoundary styles\n *\n * Extends the empty-state base layout pattern with error-specific visual\n * treatment. The ErrorBoundary component applies both `.empty-state` and\n * `.error-boundary` classes on the container, inheriting the centered\n * flex-column layout from empty-state.css.\n *\n * Only OVERRIDES and ADDITIONS belong here — do not duplicate properties\n * already defined in empty-state.css.\n */\n\n.error-boundary {\n  height: 100%;\n  min-height: 200px;\n}\n\n.error-boundary-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: var(--radius-full);\n  background: rgb(239 68 68 / 15%);\n  color: var(--color-danger);\n  font-size: 24px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: var(--spacing-xl);\n}\n\n.error-boundary-message {\n  font-size: var(--font-size-md);\n  word-break: break-word;\n}\n\n.error-boundary-retry {\n  padding: var(--spacing-md) var(--spacing-xl);\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  background: transparent;\n  color: var(--color-text);\n  cursor: pointer;\n  transition: background var(--transition-fast);\n}\n\n.error-boundary-retry:hover {\n  background: rgb(255 255 255 / 5%);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2087,"cache_read_input_tokens":62580,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2087},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"2a207061-1c30-40ba-a375-5d0443f621d8","uuid":"1003604a-ff65-42ed-8cc2-56f7b5f00801"}
