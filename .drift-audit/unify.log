ld: 'exitEffects.mutations',\n   676→        location: `Era \"${era.name || era.id}\"`,\n   677→      });\n   678→    });\n   679→  });\n   680→}\n   681→\n   682→function scanVariantApplyTags(tags, usageMap, contextKey, ref) {\n   683→  if (!tags) return;\n   684→  Object.values(tags).forEach((tagMap) => {\n   685→    if (!tagMap || typeof tagMap !== 'object') return;\n   686→    Object.keys(tagMap).forEach((tag) => recordTagRef(usageMap, tag, contextKey, ref));\n   687→  });\n   688→}\n   689→\n   690→function scanGeneratorReferences(usageMap, generators, schema, pressures) {\n   691→  const pressureIds = new Set((pressures || []).map(p => p.id));\n   692→\n   693→  (generators || []).forEach(gen => {\n   694→    const genRef = { id: gen.id, name: gen.name };\n   695→    const location = `Generator \"${gen.name || gen.id}\"`;\n   696→\n   697→    (gen.applicability || []).forEach((rule, idx) => {\n   698→      scanCondition(rule, usageMap, pressureIds, 'generators', genRef, {\n   699→        type: 'generator',"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"1df3029b-4a91-4d76-b73d-d3a8a525f385"}
