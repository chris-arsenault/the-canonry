{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01NYK5ik5c9oJH2ZgiwsphzR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ELqnMHqy3WxbC4QjMni8AP","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/visualization-overlay.css","content":"/* Visualization overlay panels — shared styles for graph and timeline views.\n * Theme via CSS custom properties: set --viz-panel-start, --viz-panel-end,\n * --viz-accent-10, --viz-accent-05 on a parent using .viz-theme-blue or\n * .viz-theme-golden.\n */\n\n/* Full-bleed container */\n.viz-container {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n}\n\n/* WebGL fallback */\n.viz-no-webgl {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #0a1929;\n  color: #93c5fd;\n}\n\n.viz-no-webgl-inner {\n  text-align: center;\n  max-width: 400px;\n}\n\n.viz-no-webgl-icon {\n  font-size: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n.viz-no-webgl-title {\n  font-size: 16px;\n  font-weight: 500;\n  color: #fff;\n  margin-bottom: 8px;\n}\n\n.viz-no-webgl-message {\n  font-size: 13px;\n}\n\n/* Overlay panel backgrounds */\n.viz-legend {\n  background: linear-gradient(135deg, var(--viz-panel-start) 0%, var(--viz-panel-end) 100%);\n}\n\n.viz-legend-header {\n  background: var(--viz-accent-10);\n}\n\n.viz-legend-footer {\n  background: var(--viz-accent-05);\n}\n\n.viz-legend-swatch {\n  background-color: var(--viz-swatch-color);\n}\n\n.viz-controls {\n  background: linear-gradient(135deg, var(--viz-panel-start) 0%, var(--viz-panel-end) 100%);\n}\n\n.viz-controls-header {\n  background: var(--viz-accent-10);\n}\n\n/* Blue theme — graph views */\n.viz-theme-blue {\n  --viz-panel-start: rgba(30, 58, 95, 0.95);\n  --viz-panel-end: rgba(10, 25, 41, 0.95);\n  --viz-accent-10: rgba(59, 130, 246, 0.1);\n  --viz-accent-05: rgba(59, 130, 246, 0.05);\n}\n\n/* Golden theme — timeline views */\n.viz-theme-golden {\n  --viz-panel-start: rgba(50, 40, 20, 0.95);\n  --viz-panel-end: rgba(20, 15, 5, 0.95);\n  --viz-accent-10: rgba(255, 215, 0, 0.1);\n  --viz-accent-05: rgba(255, 215, 0, 0.05);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4041,"cache_read_input_tokens":68040,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4041},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b63bbfa3-8e9b-4041-b254-e9bba5dedd64","uuid":"e914bb55-d7c6-45d9-a3fd-f35b0edf361f"}
