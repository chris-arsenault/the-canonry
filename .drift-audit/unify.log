{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017P3Tc5ha16eMUJp1DWkXSF","type":"tool_result","content":"     1→/**\n     2→ * HistorianEditionComparison — Compare pre-historian baseline and all historian edition versions.\n     3→ *\n     4→ * Shows when an entity has at least one historian edition. Versions include the pre-historian\n     5→ * baseline plus each historian output, allowing word count and diff comparison across all.\n     6→ * Reuses InlineDiff pattern from SummaryRevisionModal and version selector pattern from\n     7→ * ChronicleVersionSelector.\n     8→ */\n     9→\n    10→import React, { useState, useMemo } from \"react\";\n    11→import { diffWords } from \"diff\";\n    12→import \"./HistorianEditionComparison.css\";\n    13→import type { HistorianNote } from \"../lib/historianTypes\";\n    14→\n    15→interface HistoryEntry {\n    16→  description: string;\n    17→  source?: string;\n    18→  replacedAt?: number;\n    19→}\n    20→\n    21→interface EditionVersion {\n    22→  label: string;\n    23→  description: string;\n    24→  historyIndex: number; // -1 = current entity.description\n    25→  isCurrent: boolean;\n    26→  wordCount: number;\n    27→  date?: string;\n    28→}\n    29→\n    30→interface HistorianEditionComparisonProps {\n    31→  entityId: string;\n    32→  currentDescription: string;\n    33→  descriptionHistory: HistoryEntry[];\n    34→  historianNotes?: HistorianNote[];\n    35→  onRestoreVersion: (entityId: string, historyIndex: number) => void;\n    36→}\n    37→\n    38→export default function HistorianEditionComparison({\n    39→  entityId,\n    40→  currentDescription,\n    41→  descriptionHistory,\n    42→  historianNotes,\n    43→  onRestoreVersion,\n    44→}: Readonly<HistorianEditionComparisonProps>) {\n    45→  const [expanded, setExpanded] = useState(false);\n    46→\n    47→  const versions = useMemo(() => {\n    48→    // Find all historian-edition and legacy-copy-edit entries with their original indices\n    49→    const editionSources = new Set([\"historian-edition\", \"legacy-copy-edit\"]);\n    50→    const historianEntries = descriptionHistory\n    51→      .map((entry, index) => ({ ...entry, historyIndex: index }))\n    52→      .filter((entry) => editionSources.has(entry.source || \"\"));\n    53→\n    54→    if (historianEntries.length === 0) return [];\n    55→\n    56→    const editionVersions: EditionVersion[] = [];\n    57→\n    58→    // First entry = pre-historian baseline\n    59→    const baseline = historianEntries[0];\n    60→    editionVersions.push({\n    61→      label: \"Pre-Historian\",\n    62→      description: baseline.description,\n    63→      historyIndex: baseline.historyIndex,\n    64→      isCurrent: false,\n    65→      wordCount: baseline.description.split(/\\s+/).length,\n    66→      date: baseline.replacedAt ? new Date(baseline.replacedAt).toLocaleDateString() : undefined,\n    67→    });\n    68→\n    69→    // Subsequent entries = prior historian/legacy outputs pushed to history when replaced\n    70→    for (let i = 1; i < historianEntries.length; i++) {\n    71→      const entry = historianEntries[i];\n    72→      const isLegacy = entry.source === \"legacy-copy-edit\";\n    73→      editionVersions.push({\n    74→        label: `Edition ${i}${isLegacy ? \" (legacy)\" : \"\"}`,\n    75→        description: entry.description,\n    76→        historyIndex: entry.historyIndex,\n    77→        isCurrent: false,\n    78→        wordCount: entry.description.split(/\\s+/).length,\n    79→        date: entry.replacedAt ? new Date(entry.replacedAt).toLocaleDateString() : undefined,\n    80→      });\n    81→    }\n    82→\n    83→    // Current description = latest edition\n    84→    editionVersions.push({\n    85→      label: `Edition ${historianEntries.length} (active)`,\n    86→      description: currentDescription,\n    87→      historyIndex: -1,\n    88→      isCurrent: true,\n    89→      wordCount: currentDescription.split(/\\s+/).length,\n    90→    });\n    91→\n    92→    return editionVersions;\n    93→  }, [descriptionHistory, currentDescription]);\n    94→\n    95→  // Exportable when we have 3+ versions: pre-historian baseline, at least one prior edition, and active.\n    96→  // versions[0] = pre-historian, versions[last] = active, everything in between = prior editions.\n    97→  const exportData = useMemo(() => {\n    98→    if (versions.length < 3) return null;\n    99→    const active = versions[versions.length - 1];\n   100→    if (!active?.isCurrent) return null;\n   101→    const data: Record<string, unknown> = {\n   102→      preHistorian: versions[0].description,\n   103→      legacyCopyEdit: versions[versions.length - 2].description,\n   104→      active: active.description,\n   105→    };\n   106→    // Include non-disabled annotations when present\n   107→    const activeNotes = historianNotes?.filter((n) => n.display !== \"disabled\");\n   108→    if (activeNotes && activeNotes.length > 0) {\n   109→      data.annotations = activeNotes.map((n) => ({\n   110→        type: n.type,\n   111→        display: n.display || \"full\",\n   112→        anchorPhrase: n.anchorPhrase,\n   113→        text: n.text,\n   114→      }));\n   115→    }\n   116→    return data;\n   117→  }, [versions, historianNotes]);\n   118→\n   119→  const [selectedIdx, setSelectedIdx] = useState(() => versions.length - 1);\n   120→  const [compareIdx, setCompareIdx] = useState(() =>\n   121→    versions.length > 1 ? versions.length - 2 : -1\n   122→  );\n   123→\n   124→  if (versions.length < 2) return null;\n   125→\n   126→  const selected = versions[selectedIdx] || versions[versions.length - 1];\n   127→  const compare = compareIdx >= 0 ? versions[compareIdx] : null;\n   128→\n   129→  const wordDelta = compare ? selected.wordCount - compare.wordCount : 0;\n   130→  const deltaSign = wordDelta >= 0 ? \"+\" : \"\";\n   131→\n   132→  return (\n   133→    <div className=\"hec