{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0187QG5XicdnE4191XvBzeKJ","type":"tool_result","content":"     1→/**\n     2→ * useLocalInputState - Hook for managing local input state with cursor-jumping prevention\n     3→ *\n     4→ * When editing text inputs bound to external state, React can cause cursor jumping\n     5→ * because the input value gets reset on every keystroke. This hook maintains a local\n     6→ * copy of the value that syncs on blur, preventing cursor jumping while keeping\n     7→ * the external state in sync.\n     8→ *\n     9→ * @example\n    10→ * const [localName, setLocalName, handleNameBlur] = useLocalInputState(\n    11→ *   item.name,\n    12→ *   (value) => updateItem('name', value)\n    13→ * );\n    14→ *\n    15→ * <input\n    16→ *   value={localName}\n    17→ *   onChange={(e) => setLocalName(e.target.value)}\n    18→ *   onBlur={handleNameBlur}\n    19→ * />\n    20→ */\n    21→\n    22→import { useState, useCallback, useEffect, type Dispatch, type SetStateAction } from 'react';\n    23→\n    24→export function useLocalInputState(\n    25→  externalValue: string | undefined,\n    26→  onUpdate: (value: string) => void,\n    27→): [string, Dispatch<SetStateAction<string>>, () => void] {\n    28→  const [localValue, setLocalValue] = useState(externalValue || '');\n    29→\n    30→  // Sync local value when external value changes\n    31→  useEffect(() => {\n    32→    // eslint-disable-next-line react-hooks/set-state-in-effect -- intentional prop->draft sync for controlled inputs\n    33→    setLocalValue(externalValue || '');\n    34→  }, [externalValue]);\n    35→\n    36→  // Call onUpdate if value changed\n    37→  const handleBlur = useCallback(() => {\n    38→    if (localValue !== externalValue) {\n    39→      onUpdate(localValue);\n    40→    }\n    41→  }, [localValue, externalValue, onUpdate]);\n    42→\n    43→  return [localValue, setLocalValue, handleBlur];\n    44→}\n    45→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"459d5c21-16f4-437b-9d23-88d17c995c1d"}
