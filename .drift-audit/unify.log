{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BrQr5YbwPZ2xSJqdstPpfb","type":"tool_result","content":"     1→/**\n     2→ * ErrorBoundary - Catches render errors in child component trees\n     3→ *\n     4→ * Displays a recovery UI with the error message and a retry button.\n     5→ * Intended for wrapping MFE remote entry points so a single module\n     6→ * failure doesn't crash the entire host application.\n     7→ */\n     8→\n     9→import React from \"react\";\n    10→import PropTypes from \"prop-types\";\n    11→\n    12→export class ErrorBoundary extends React.Component {\n    13→  constructor(props) {\n    14→    super(props);\n    15→    this.state = { error: null };\n    16→  }\n    17→\n    18→  static getDerivedStateFromError(error) {\n    19→    return { error };\n    20→  }\n    21→\n    22→  handleRetry = () => {\n    23→    this.setState({ error: null });\n    24→  };\n    25→\n    26→  render() {\n    27→    if (this.state.error) {\n    28→      return (\n    29→        <div className={`empty-state error-boundary ${this.props.className || \"\"}`.trim()}>\n    30→          <div className=\"error-boundary-icon\">!</div>\n    31→          <div className=\"empty-state-title\">\n    32→            {this.props.title || \"Something went wrong\"}\n    33→          </div>\n    34→          <div className=\"empty-state-desc error-boundary-message\">\n    35→            {this.state.error.message || \"An unexpected error occurred.\"}\n    36→          </div>\n    37→          <button\n    38→            className=\"error-boundary-retry\"\n    39→            onClick={this.handleRetry}\n    40→          >\n    41→            Retry\n    42→          </button>\n    43→        </div>\n    44→      );\n    45→    }\n    46→    return this.props.children;\n    47→  }\n    48→}\n    49→\n    50→export default ErrorBoundary;\n    51→\n    52→ErrorBoundary.propTypes = {\n    53→  children: PropTypes.node.isRequired,\n    54→  title: PropTypes.string,\n    55→  className: PropTypes.string,\n    56→};\n    57→"}]},"parent_tool_use_id":"toolu_01MSjwERvzq8tWa6PqUQiEqU","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"d466bc02-8064-4aab-b870-92ee7c36db58"}
