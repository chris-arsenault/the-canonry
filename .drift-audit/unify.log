{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156rSghY7LVUh9Q912DinFH","type":"tool_result","content":"     1→/**\n     2→ * TagSelector - Registry-aware tag selection component\n     3→ */\n     4→\n     5→import React, { useState, useRef, useEffect, useMemo } from 'react';\n     6→import './TagSelector.css';\n     7→\n     8→interface TagDefinition {\n     9→  tag: string;\n    10→  category: string;\n    11→  rarity: string;\n    12→  description?: string;\n    13→  isAxis?: boolean;\n    14→}\n    15→\n    16→interface TagSelectorProps {\n    17→  value?: string[];\n    18→  onChange: (value: string[]) => void;\n    19→  tagRegistry?: TagDefinition[];\n    20→  onAddToRegistry?: (tagDef: TagDefinition) => void;\n    21→  placeholder?: string;\n    22→  matchAllEnabled?: boolean;\n    23→  matchAll?: boolean;\n    24→  onMatchAllChange?: (value: boolean) => void;\n    25→  singleSelect?: boolean;\n    26→}\n    27→\n    28→const CATEGORY_CLASS: Record<string, string> = {\n    29→  status: 'tag-selector-category-status',\n    30→  trait: 'tag-selector-category-trait',\n    31→  affiliation: 'tag-selector-category-affiliation',\n    32→  behavior: 'tag-selector-category-behavior',\n    33→  theme: 'tag-selector-category-theme',\n    34→  location: 'tag-selector-category-location',\n    35→};\n    36→\n    37→const RARITY_DOTS: Record<string, number> = {\n    38→  common: 1,\n    39→  uncommon: 2,\n    40→  rare: 3,\n    41→  legendary: 4,\n    42→};\n    43→\n    44→function getCategoryClass(category: string): string {\n    45→  return CATEGORY_CLASS[category] || CATEGORY_CLASS.trait;\n    46→}\n    47→\n    48→function getRarityClass(rarity: string): string {\n    49→  return `tag-selector-rarity-dot-${rarity || 'common'}`;\n    50→}\n    51→\n    52→export default function TagSelector({\n    53→  value = [],\n    54→  onChange,\n    55→  tagRegistry = [],\n    56→  onAddToRegistry,\n    57→  placeholder = 'Select tags...',\n    58→  matchAllEnabled = false,\n    59→  matchAll = false,\n    60→  onMatchAllChange,\n    61→  singleSelect = false,\n    62→}: TagSelectorProps) {\n    63→  const [isOpen, setIsOpen] = useState(false);\n    64→  const [searchQuery, setSearchQuery] = useState('');\n    65→  const [highlightedIndex, setHighlightedIndex] = useState(0);\n    66→  const [hoveredInvalidTag, setHoveredInvalidTag] = useState<string | null>(null);\n    67→  const hoverTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n    68→  const containerRef = useRef<HTMLDivElement>(null);\n    69→  const inputRef = useRef<HTMLInputElement>(null);\n    70→\n    71→  const tagLookup = useMemo(() => {\n    72→    const lookup: Record<string, TagDefinition> = {};\n    73→    tagRegistry.forEach((tagDef) => {\n    74→      lookup[tagDef.tag] = tagDef;\n    75→    });\n    76→    return lookup;\n    77→  }, [tagRegistry]);\n    78→\n    79→  const groupedTags = useMemo(() => {\n    80→    const groups: Record<string, TagDefinition[]> = {};\n    81→    const filtered = tagRegistry.filter((tagDef) => {\n    82→      const normalizedQuery = searchQuery.toLowerCase();\n    83→      const matchesSearch =\n    84→        !searchQuery ||\n    85→        tagDef.tag.toLowerCase().includes(normalizedQuery) ||\n    86→        tagDef.description?.toLowerCase().includes(normalizedQuery);\n    87→      return matchesSearch && !value.includes(tagDef.tag);\n    88→    });\n    89→\n    90→    filtered.forEach((tagDef) => {\n    91→      if (!groups[tagDef.category]) {\n    92→        groups[tagDef.category] = [];\n    93→      }\n    94→      groups[tagDef.category].push(tagDef);\n    95→    });\n    96→\n    97→    return groups;\n    98→  }, [searchQuery, tagRegistry, value]);\n    99→\n   100→  const canCreateTag = useMemo(() => {\n   101→    if (!searchQuery.trim()) return false;\n   102→    const normalized = searchQuery.trim().toLowerCase().replace(/[^a-z0-9-_]/g, '');\n   103→    if (!normalized) return false;\n   104→    if (tagLookup[normalized]) return false;\n   105→    if (value.includes(normalized)) return false;\n   106→    return normalized;\n   107→  }, [searchQuery, tagLookup, value]);\n   108→\n   109→  const flatOptions = useMemo(() => {\n   110→    const result: Array<{ type: string; tag: string; [key: string]: unknown }> = [];\n   111→    Object.entries(groupedTags).forEach(([_category, tags]) => {\n   112→      tags.forEach((tagDef) => result.push({ type: 'existing', ...tagDef }));\n   113→    });\n   114→    if (canCreateTag) {\n   115→      result.push({ type: 'create', tag: canCreateTag });\n   116→    }\n   117→    return result;\n   118→  }, [groupedTags, canCreateTag]);\n   119→\n   120→  useEffect(() => {\n   121→    const handleClickOutside = (event: MouseEvent) => {\n   122→      if (containerRef.current && !containerRef.current.contains(event.target)) {\n   123→        setIsOpen(false);\n   124→        setHoveredInvalidTag(null);\n   125→      }\n   126→    };\n   127→\n   128→    document.addEventListener('mousedown', handleClickOutside);\n   129→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   130→  }, []);\n   131→\n   132→  const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {\n   133→    if (!isOpen) {\n   134→      if (event.key === 'Enter' || event.key === 'ArrowDown') {\n   135→        event.preventDefault();\n   136→        setIsOpen(true);\n   137→      }\n   138→      return;\n   139→    }\n   140→\n   141→    switch (event.key) {\n   142→      case 'ArrowDown':\n   143→        event.preventDefault();\n   144→        setHighlightedIndex((index) => Math.min(index + 1, flatOptions.length - 1));\n   145→        break;\n   146→      case 'ArrowUp':\n   147→        event.preventDefault();\n   148→        setHighlightedIndex((index) => Math.max(index - 1, 0));\n   149→        break;\n   150→      case 'Enter':\n   151→        event.preventDefault();\n   152→        if (!flatOptions[highlightedIndex]) return;\n   153→        if (flatOptions[highlightedIndex].type === 'create') {\n   154→          handleCreateAndSelect(flatOptions[highlightedIndex].tag);\n   155→        } else {\n   156→          handleSelectTag(flatOptions[highlightedIndex].tag);\n   157→        }\n   158→        break;\n   159→      case 'Escape':\n   160→        event.preventDefault();\n   161→        setIsOpen(false);\n   162→        break;\n   163→      case 'Backspace':\n   164→        if (searchQuery === '' && value.length > 0) {\n   165→          handleRemoveTag(value[value.length - 1]);\n   166→        }\n   167→        break;\n   168→      default:\n   169→        break;\n   170→    }\n   171→  };\n   172→\n   173→  const handleSelectTag = (tag: string) => {\n   174→    if (singleSelect) {\n   175→      onChange([tag]);\n   176→      setIsOpen(false);\n   177→    } else if (!value.includes(tag)) {\n   178→      onChange([...value, tag]);\n   179→    }\n   180→\n   181→    setSearchQuery('');\n   182→    inputRef.current?.focus();\n   183→  };\n   184→\n   185→  const handleRemoveTag = (tag: string) => {\n   186→    onChange(value.filter((item) => item !== tag));\n   187→  };\n   188→\n   189→  const handleCreateAndSelect = (tag: string) => {\n   190→    if (onAddToRegistry) {\n   191→      onAddToRegistry({ tag, category: 'trait', rarity: 'common', description: '' });\n   192→    }\n   193→\n   194→    if (singleSelect) {\n   195→      onChange([tag]);\n   196→      setIsOpen(false);\n   197→    } else if (!value.includes(tag)) {\n   198→      onChange([...value, tag]);\n   199→    }\n   200→\n   201→    setSearchQuery('');\n   202→    inputRef.current?.focus();\n   203→  };\n   204→\n   205→  const handleInvalidTagMouseEnter = (tag: string) => {\n   206→    if (hoverTimeoutRef.current) {\n   207→      clearTimeout(hoverTimeoutRef.current);\n   208→      hoverTimeoutRef.current = null;\n   209→    }\n   210→    setHoveredInvalidTag(tag);\n   211→  };\n   212→\n   213→  const handleInvalidTagMouseLeave = () => {\n   214→    hoverTimeoutRef.current = setTimeout(() => {\n   215→      setHoveredInvalidTag(null);\n   216→    }, 150);\n   217→  };\n   218→\n   219→  const handlePopupMouseEnter = () => {\n   220→    if (hoverTimeoutRef.current) {\n   221→      clearTimeout(hoverTimeoutRef.current);\n   222→      hoverTimeoutRef.current = null;\n   223→    }\n   224→  };\n   225→\n   226→  const renderRarityDots = (rarity: string) => {\n   227→    const count = RARITY_DOTS[rarity] || RARITY_DOTS.common;\n   228→    return (\n   229→      <span className=\"tag-selector-rarity-dots\">\n   230→        {Array.from({ length: count }).map((_, index) => (\n   231→          <span key={index} className={`tag-selector-rarity-dot ${getRarityClass(rarity)}`} />\n   232→        ))}\n   233→      </span>\n   234→    );\n   235→  };\n   236→\n   237→  return (\n   238→    <div ref={containerRef} className=\"tag-selector\">\n   239→      <div\n   240→        className={`tag-selector-input-wrapper ${isOpen ? 'tag-selector-input-wrapper-open' : 'tag-selector-input-wrapper-closed'}`}\n   241→        onClick={() => {\n   242→          setIsOpen(true);\n   243→          inputRef.current?.focus();\n   244→        }}\n   245→        role=\"button\"\n   246→        tabIndex={0}\n   247→        onKeyDown={(event) => {\n   248→          if (event.key === 'Enter' || event.key === ' ') {\n   249→            event.currentTarget.click();\n   250→          }\n   251→        }}\n   252→      >\n   253→        {value.map((tag) => {\n   254→          const tagMeta = tagLookup[tag];\n   255→          const isInvalid = !tagMeta;\n   256→          const categoryClass = isInvalid ? 'tag-selector-category-invalid' : getCategoryClass(tagMeta.category);\n   257→\n   258→          return (\n   259→            <span\n   260→              key={tag}\n   261→              className={`tag-selector-chip ${categoryClass}`}\n   262→              title={isInvalid ? 'Tag not in registry - hover to add' : tagMeta?.description}\n   263→              onMouseEnter={() => isInvalid && onAddToRegistry && handleInvalidTagMouseEnter(tag)}\n   264→              onMouseLeave={() => isInvalid && handleInvalidTagMouseLeave()}\n   265→            >\n   266→              {isInvalid && <span className=\"tag-selector-invalid-warning\">⚠</span>}\n   267→              {tag}\n   268→              {tagMeta?.isAxis && <span title=\"Semantic plane axis label\" className=\"tag-selector-axis-indicator\">↔</span>}\n   269→              {tagMeta && renderRarityDots(tagMeta.rarity)}\n   270→              <button\n   271→                type=\"button\"\n   272→                className=\"tag-selector-remove-button\"\n   273→                onClick={(event) => {\n   274→                  event.stopPropagation();\n   275→                  handleRemoveTag(tag);\n   276→                }}\n   277→              >\n   278→                ×\n   279→              </button>\n   280→              {isInvalid && hoveredInvalidTag === tag && onAddToRegistry && (\n   281→                <div\n   282→                  className=\"tag-selector-invalid-popup\"\n   283→                  onClick={(event) => {\n   284→                    event.stopPropagation();\n   285→                    onAddToRegistry({ tag, category: 'trait', rarity: 'common', description: '' });\n   286→                    setHoveredInvalidTag(null);\n   287→                  }}\n   288→                  onMouseEnter={handlePopupMouseEnter}\n   289→                  onMouseLeave={() => setHoveredInvalidTag(null)}\n   290→                  role=\"button\"\n   291→                  tabIndex={0}\n   292→                  onKeyDown={(event) => {\n   293→                    if (event.key === 'Enter' || event.key === ' ') {\n   294→                      event.currentTarget.click();\n   295→                    }\n   296→                  }}\n   297→                >\n   298→                  + Add to registry\n   299→                </div>\n   300→              )}\n   301→            </span>\n   302→          );\n   303→        })}\n   304→\n   305→        <input\n   306→          ref={inputRef}\n   307→          type=\"text\"\n   308→          className=\"tag-selector-search-input\"\n   309→          value={searchQuery}\n   310→          onChange={(event) => {\n   311→            setSearchQuery(event.target.value);\n   312→            setHighlightedIndex(0);\n   313→          }}\n   314→          onKeyDown={handleKeyDown}\n   315→          onFocus={() => setIsOpen(true)}\n   316→          placeholder={value.length === 0 ? placeholder : ''}\n   317→        />\n   318→      </div>\n   319→\n   320→      {matchAllEnabled && value.length > 1 && (\n   321→        <div className=\"tag-selector-match-all\">\n   322→          <label className=\"tag-selector-match-all-label\">\n   323→            <input\n   324→              type=\"checkbox\"\n   325→              className=\"tag-selector-match-all-checkbox\"\n   326→              checked={matchAll}\n   327→              onChange={(event) => onMatchAllChange?.(event.target.checked)}\n   328→            />\n   329→            Match all tags (AND)\n   330→          </label>\n   331→          <span className=\"tag-selector-match-all-hint\">\n   332→            {matchAll ? 'Entity must have all tags' : 'Entity must have any tag'}\n   333→          </span>\n   334→        </div>\n   335→      )}\n   336→\n   337→      {isOpen && (\n   338→        <div className=\"tag-selector-dropdown\">\n   339→          {canCreateTag && onAddToRegistry && (\n   340→            <div\n   341→              className={`tag-selector-create-option ${highlightedIndex === flatOptions.length - 1 ? 'tag-selector-create-option-highlighted' : ''}`}\n   342→              onClick={() => handleCreateAndSelect(canCreateTag)}\n   343→              onMouseEnter={() => setHighlightedIndex(flatOptions.length - 1)}\n   344→              role=\"button\"\n   345→              tabIndex={0}\n   346→              onKeyDown={(event) => {\n   347→                if (event.key === 'Enter' || event.key === ' ') {\n   348→                  event.currentTarget.click();\n   349→                }\n   350→              }}\n   351→            >\n   352→              <div className=\"tag-selector-create-row\">\n   353→                <span className=\"tag-selector-create-icon\">+</span>\n   354→                <span className=\"tag-selector-create-label\">\n   355→                  Create &quot;<strong>{canCreateTag}</strong>&quot; and add to registry\n   356→                </span>\n   357→              </div>\n   358→            </div>\n   359→          )}\n   360→\n   361→          {Object.keys(groupedTags).length === 0 && !canCreateTag ? (\n   362→            <div className=\"tag-selector-empty-dropdown\">\n   363→              {(() => {\n   364→                if (tagRegistry.length === 0) return 'No tags defined. Type to create a new tag.';\n   365→                if (searchQuery) return 'No matching tags. Press Enter to create.';\n   366→                return 'All tags selected';\n   367→              })()}\n   368→            </div>\n   369→          ) : (\n   370→            Object.entries(groupedTags).map(([category, tags]) => (\n   371→              <div key={category}>\n   372→                <div className={`tag-selector-category-header ${getCategoryClass(category)}`}>{category}</div>\n   373→                {tags.map((tag) => {\n   374→                  const globalIdx = flatOptions.findIndex((option) => option.type === 'existing' && option.tag === tag.tag);\n   375→                  const isHighlighted = globalIdx === highlightedIndex;\n   376→                  return (\n   377→                    <div\n   378→                      key={tag.tag}\n   379→                      className={`tag-selector-option ${isHighlighted ? 'tag-selector-option-highlighted' : ''}`}\n   380→                      onClick={() => handleSelectTag(tag.tag)}\n   381→                      onMouseEnter={() => setHighlightedIndex(globalIdx)}\n   382→                      role=\"button\"\n   383→                      tabIndex={0}\n   384→                      onKeyDown={(event) => {\n   385→                        if (event.key === 'Enter' || event.key === ' ') {\n   386→                          event.currentTarget.click();\n   387→                        }\n   388→                      }}\n   389→                    >\n   390→                      <div className=\"tag-selector-option-row\">\n   391→                        <span className=\"tag-selector-option-name\">\n   392→                          {tag.tag}\n   393→                          {tag.isAxis && <span title=\"Semantic plane axis label\" className=\"tag-selector-axis-indicator\">↔</span>}\n   394→                        </span>\n   395→                        <span className=\"tag-selector-option-meta\">\n   396→                          <span className={`tag-selector-rarity-pill ${getCategoryClass(category)}`}>{tag.rarity}</span>\n   397→                          {renderRarityDots(tag.rarity)}\n   398→                        </span>\n   399→                      </div>\n   400→                      {tag.description && <div className=\"tag-selector-option-description\">{tag.description}</div>}\n   401→                    </div>\n   402→                  );\n   403→                })}\n   404→              </div>\n   405→            ))\n   406→          )}\n   407→        </div>\n   408→      )}\n   409→    </div>\n   410→  );\n   411→}"}]},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"1c293f85-6323-4dd6-9cc2-1b6b6085f30e"}
