{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F5MuMVrVZ5kYm1yWDp3AaW","type":"tool_result","content":"     1→/**\n     2→ * PressureChangesEditor - Editor for pressure delta values\n     3→ *\n     4→ * Displays a list of pressure changes with ability to add, remove, and modify delta values.\n     5→ */\n     6→\n     7→import React from 'react';\n     8→import PropTypes from 'prop-types';\n     9→\n    10→/**\n    11→ * @param {Object} props\n    12→ * @param {Object<string, number>} props.value - Map of pressure ID to delta value\n    13→ * @param {Function} props.onChange - Called when values change\n    14→ * @param {Array<{id: string, name?: string}>} props.pressures - Available pressure definitions\n    15→ * @param {string} [props.label] - Optional custom label (default: \"Pressure Changes\")\n    16→ * @param {string} [props.className] - Additional class names\n    17→ */\n    18→export function PressureChangesEditor({\n    19→  value = {},\n    20→  onChange,\n    21→  pressures,\n    22→  label = 'Pressure Changes',\n    23→  className = '',\n    24→}) {\n    25→  const entries = Object.entries(value);\n    26→\n    27→  const addPressure = (pressureId) => {\n    28→    if (pressureId && !(pressureId in value)) {\n    29→      onChange({ ...value, [pressureId]: 0 });\n    30→    }\n    31→  };\n    32→\n    33→  const updateDelta = (pressureId, delta) => {\n    34→    onChange({ ...value, [pressureId]: parseInt(delta) || 0 });\n    35→  };\n    36→\n    37→  const removePressure = (pressureId) => {\n    38→    const newValue = { ...value };\n    39→    delete newValue[pressureId];\n    40→    onChange(newValue);\n    41→  };\n    42→\n    43→  const availablePressures = (pressures || []).filter((p) => !(p.id in value));\n    44→\n    45→  return (\n    46→    <div className={`form-group mb-xl ${className}`.trim()}>\n    47→      <label className=\"label\">{label}</label>\n    48→      <div className=\"flex flex-col gap-md\">\n    49→        {entries.map(([pressureId, delta]) => (\n    50→          <div key={pressureId} className=\"item-row\">\n    51→            <span className=\"item-row-name\">{pressureId}</span>\n    52→            <input\n    53→              type=\"number\"\n    54→              className=\"input pressure-changes-delta-input\"\n    55→              value={delta}\n    56→              onChange={(e) => updateDelta(pressureId, e.target.value)}\n    57→            />\n    58→            <button\n    59→              className=\"btn-icon btn-icon-danger\"\n    60→              onClick={() => removePressure(pressureId)}\n    61→            >\n    62→              ×\n    63→            </button>\n    64→          </div>\n    65→        ))}\n    66→      </div>\n    67→      {availablePressures.length > 0 && (\n    68→        <select\n    69→          className=\"select mt-md pressure-changes-add-select\"\n    70→          value=\"\"\n    71→          onChange={(e) => addPressure(e.target.value)}\n    72→        >\n    73→          <option value=\"\">+ Add pressure change...</option>\n    74→          {availablePressures.map((p) => (\n    75→            <option key={p.id} value={p.id}>\n    76→              {p.name || p.id}\n    77→            </option>\n    78→          ))}\n    79→        </select>\n    80→      )}\n    81→    </div>\n    82→  );\n    83→}\n    84→\n    85→PressureChangesEditor.propTypes = {\n    86→  value: PropTypes.object,\n    87→  onChange: PropTypes.func.isRequired,\n    88→  pressures: PropTypes.array,\n    89→  label: PropTypes.string,\n    90→  className: PropTypes.string,\n    91→};\n    92→"}]},"parent_tool_use_id":"toolu_01FzRVY2V2nJRXov651T5ucP","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"61fbb570-bda3-4fd4-804a-2f27fbfe8480"}
