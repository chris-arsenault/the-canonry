nts/ChronicleWizard/steps/EntryPointStep.css","content":"/* EntryPointStep styles */\n\n.eps-header {\n  margin-bottom: 16px;\n}\n\n.eps-title {\n  margin: 0 0 8px 0;\n}\n\n.eps-subtitle {\n  margin: 0;\n  color: var(--text-muted);\n  font-size: 13px;\n}\n\n.eps-layout {\n  display: flex;\n  gap: 20px;\n  height: 480px;\n}\n\n.eps-left {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.eps-filter-gap {\n  margin-bottom: 12px;\n}\n\n.eps-sort-row {\n  margin-bottom: 8px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.eps-sort-select {\n  font-size: 11px;\n  padding: 4px 8px;\n}\n\n.eps-checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--eps-label-color, var(--text-secondary));\n  cursor: var(--eps-label-cursor, pointer);\n}\n\n.eps-checkbox-label-muted {\n  color: var(--text-muted);\n}\n\n.eps-checkbox {\n  margin: 0;\n}\n\n.eps-entity-list {\n  flex: 1;\n  overflow-y: auto;\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  min-height: 0;\n}\n\n.eps-empty-list {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.eps-entity-row {\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--border-color);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  transition: background 0.15s ease;\n}\n\n.eps-entity-row-selected {\n  background: var(--accent-color);\n  color: white;\n}\n\n.eps-entity-row-hovered {\n  background: var(--bg-tertiary);\n}\n\n.eps-radio-dot {\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.eps-radio-dot-selected {\n  border: 2px solid white;\n  background: white;\n}\n\n.eps-radio-dot-unselected {\n  border: 2px solid var(--border-color);\n  background: transparent;\n}\n\n.eps-radio-dot-inner {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--accent-color);\n}\n\n.eps-entity-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.eps-entity-name-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.eps-entity-name {\n  font-weight: 500;\n  font-size: 13px;\n}\n\n.eps-kind-badge {\n  padding: 1px 6px;\n  border-radius: 4px;\n  font-size: 9px;\n}\n\n.eps-era-badge {\n  padding: 1px 6px;\n  border-radius: 4px;\n  font-size: 9px;\n  background: var(--eps-era-bg, var(--bg-tertiary));\n  color: var(--eps-era-color, var(--text-muted));\n}\n\n.eps-underused-badge {\n  padding: 1px 6px;\n  border-radius: 4px;\n  font-size: 9px;\n}\n\n.eps-kind-badge-selected {\n  background: rgba(255, 255, 255, 0.2);\n  color: rgba(255, 255, 255, 0.9);\n}\n\n.eps-kind-badge-default {\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n}\n\n.eps-entity-stats {\n  font-size: 11px;\n  margin-top: 2px;\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.eps-entity-stats-selected {\n  color: rgba(255, 255, 255, 0.8);\n}\n\n.eps-entity-stats-default {\n  color: var(--text-muted);\n}\n\n.eps-entity-usage {\n  font-size: 10px;\n  margin-top: 2px;\n}\n\n.eps-entity-usage-selected {\n  color: rgba(255, 255, 255, 0.75);\n}\n\n.eps-entity-usage-default {\n  color: var(--text-muted);\n}\n\n.eps-score-col {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 2px;\n}\n\n.eps-score-pct {\n  font-size: 9px;\n}\n\n.eps-score-pct-selected {\n  color: rgba(255, 255, 255, 0.8);\n}\n\n.eps-score-pct-default {\n  color: var(--text-muted);\n}\n\n.eps-right {\n  width: 220px;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  overflow-y: auto;\n  min-height: 0;\n}\n\n.eps-radar-wrap {\n  display: flex;\n  justify-content: center;\n}\n\n.eps-network-label {\n  font-size: 9px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  margin-bottom: 4px;\n  text-align: center;\n}\n\n.eps-network-wrap {\n  display: flex;\n  justify-content: center;\n}\n\n.eps-inline-stats {\n  display: flex;\n  justify-content: center;\n  gap: 16px;\n  margin-top: 4px;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.eps-detail-usage {\n  margin-top: 6px;\n  text-align: center;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.eps-detail-underused {\n  margin-top: 4px;\n  text-align: center;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.eps-empty-detail {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 8px;\n  border: 1px dashed var(--border-color);\n}\n\n.eps-empty-icon {\n  margin-bottom: 8px;\n  font-size: 32px;\n  opacity: 0.4;\n}\n\n.eps-empty-sub {\n  font-size: 11px;\n  margin-top: 4px;\n}\n\n.eps-selected-summary {\n  margin-top: 16px;\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 8px;\n  border: 1px solid var(--accent-color);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.eps-selected-name {\n  font-weight: 500;\n}\n\n.eps-selected-desc {\n  margin: 4px 0 0 0;\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eps-selected-right {\n  text-align: right;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.eps-candidate-count {\n  font-weight: 500;\n  color: var(--accent-color);\n}\n","numLines":325,"startLine":1,"totalLines":325}}}
