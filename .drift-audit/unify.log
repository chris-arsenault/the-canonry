ius: 4px;\n}\n\n.tps-category-count {\n  font-size: 11px;\n  padding: 2px 6px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  color: var(--text-muted);\n}\n\n.tps-kind-header-right {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.tps-expand-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n}\n\n.tps-expand-icon {\n  font-size: 14px;\n  color: var(--text-muted);\n  transition: transform 0.2s;\n}\n\n.tps-expand-icon-open {\n  transform: rotate(180deg);\n}\n\n.tps-expand-icon-closed {\n  transform: rotate(0deg);\n}\n\n.tps-kind-body {\n  padding: 12px;\n}\n\n.tps-kind-empty {\n  padding: 20px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n.tps-palette-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.tps-palette-item {\n  padding: 10px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n}\n\n.tps-palette-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 6px;\n}\n\n.tps-palette-category {\n  font-weight: 500;\n  font-size: 13px;\n}\n\n.tps-usage-badge {\n  font-size: 10px;\n  padding: 2px 5px;\n  border-radius: 3px;\n}\n\n.tps-usage-badge-used {\n  background: var(--accent-color);\n  color: white;\n}\n\n.tps-usage-badge-unused {\n  background: var(--bg-secondary);\n  color: var(--text-muted);\n}\n\n.tps-palette-description {\n  font-size: 12px;\n  color: var(--text-secondary);\n  margin-bottom: 6px;\n}\n\n.tps-palette-examples {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.tps-binding-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  margin-top: 8px;\n}\n\n.tps-era-tag {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: rgba(168, 85, 247, 0.2);\n  color: #a855f7;\n  border-radius: 3px;\n  border: 1px solid rgba(168, 85, 247, 0.3);\n}\n\n.tps-subtype-tag {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: rgba(59, 130, 246, 0.2);\n  color: #3b82f6;\n  border-radius: 3px;\n  border: 1px solid