ection-drift.js\";\n    27→import noSchemaEditorCssDrift from \"./eslint-rules/no-schema-editor-css-drift.js\";\n    28→import noAppCssBaseDuplication from \"./eslint-rules/no-app-css-base-duplication.js\";\n    29→import noMatrixCssDuplication from \"./eslint-rules/no-matrix-css-duplication.js\";\n    30→import noToggleCssDrift from \"./eslint-rules/no-toggle-css-drift.js\";\n    31→import noVizUtilityDrift from \"./eslint-rules/no-viz-utility-drift.js\";\n    32→import noCosmoEditorDrift from \"./eslint-rules/no-cosmo-editor-drift.js\";\n    33→\n    34→const localPlugin = {\n    35→  rules: {\n    36→    \"max-jsx-props\": maxJsxProps,\n    37→    \"no-inline-styles\": noInlineStyles,\n    38→    \"no-raw-error-div\": noRawErrorDiv,\n    39→    \"no-inline-id-generation\": noInlineIdGeneration,\n    40→    \"no-duplicate-component-css\": noDuplicateComponentCss,\n    41→    \"no-tab-companion-css\": noTabCompanionCss,\n    42→    \"no-cross-app-alias\": noCrossAppAlias,\n    43→    \"no-viz-overlay-drift\": noVizOverlayDrift,\n    44→    \"no-remote-shell-drift\": noRemoteShellDrift,\n    45→    \"no-bulk-shell-drift\": noBulkShellDrift,\n    46→    \"no-panel-css-duplication\": noPanelCssDuplication,\n    47→    \"no-viewer-pattern-drift\": noViewerPatternDrift,\n    48→    \"no-hint-css-duplication\": noHintCssDuplication,\n    49→    \"no-archivist-section-drift\": noArchivistSectionDrift,\n    50→    \"no-version-toolbar-drift\": noVersionToolbarDrift,\n    51→    \"no-dashboard-section-drift\": noDashboardSectionDrift,\n    52→    \"no-schema-editor-css-drift\": noSchemaEditorCssDrift,\n    53→    \"no-app-css-base-duplication\": noAppCssBaseDuplication,\n    54→    \"no-matrix-css-duplication\": noMatrixCssDuplication,\n    55→    \"no-toggle-css-drift\": noToggleCssDrift,\n    56→    \"no-viz-utility-drift\": noVizUtilityDrift,\n    57→    \"no-cosmo-editor-drift\": noCosmoEditorDrift,\n    58→  },\n    59→};\n    60→\n    61→export default tseslint.config