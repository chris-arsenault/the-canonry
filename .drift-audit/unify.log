{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBCUeFBh9ydGcrH3uFNbbn","type":"tool_result","content":"     1→/**\n     2→ * FormGroup - Wrapper for form label + input/control\n     3→ *\n     4→ * Provides consistent styling for form fields.\n     5→ */\n     6→\n     7→import React from 'react';\n     8→\n     9→interface FormGroupProps {\n    10→  label?: string;\n    11→  htmlFor?: string;\n    12→  hint?: string;\n    13→  children?: React.ReactNode;\n    14→  wide?: boolean;\n    15→  className?: string;\n    16→}\n    17→\n    18→interface FormRowProps {\n    19→  children?: React.ReactNode;\n    20→  className?: string;\n    21→}\n    22→\n    23→/**\n    24→ * @param {Object} props\n    25→ * @param {string} [props.label] - Label text\n    26→ * @param {string} [props.htmlFor] - For attribute linking label to input\n    27→ * @param {string} [props.hint] - Help text below the input\n    28→ * @param {React.ReactNode} props.children - Form control (input, select, etc.)\n    29→ * @param {boolean} [props.wide] - If true, spans full width\n    30→ * @param {string} [props.className] - Additional class\n    31→ */\n    32→export function FormGroup({\n    33→  label,\n    34→  htmlFor,\n    35→  hint,\n    36→  children,\n    37→  wide,\n    38→  className = '',\n    39→}: FormGroupProps) {\n    40→  return (\n    41→    <div className={`form-group ${wide ? 'form-group-wide' : ''} ${className}`.trim()}>\n    42→      {label && (\n    43→        <label className=\"label\" htmlFor={htmlFor}>\n    44→          {label}\n    45→        </label>\n    46→      )}\n    47→      {children}\n    48→      {hint && <div className=\"hint\">{hint}</div>}\n    49→    </div>\n    50→  );\n    51→}\n    52→\n    53→/**\n    54→ * FormRow - Horizontal layout for multiple form groups\n    55→ */\n    56→export function FormRow({ children, className = '' }: FormRowProps) {\n    57→  return (\n    58→    <div className={`form-row ${className}`.trim()}>\n    59→      {children}\n    60→    </div>\n    61→  );\n    62→}\n    63→\n    64→export default FormGroup;\n    65→\n    66→"}]},"parent_tool_use_id":"toolu_01MSjwERvzq8tWa6PqUQiEqU","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"16082cf5-7b5f-46bc-830e-a3312f3e7a16"}
