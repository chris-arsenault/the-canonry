 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.crp-synth-header {\n  padding: 12px 16px;\n  background: var(--bg-tertiary);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n}\n\n.crp-synth-header-expanded {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.crp-synth-toggle {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.crp-synth-title {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.crp-synth-meta {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-left: auto;\n}\n\n.crp-synth-body {\n  padding: 16px;\n}\n\n.crp-synth-tabs {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n\n.crp-synth-tab {\n  padding: 6px 14px;\n  font-size: 12px;\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.crp-synth-tab-active {\n  font-weight: 600;\n  background: var(--accent-primary);\n  color: white;\n}\n\n.crp-synth-tab-inactive {\n  font-weight: 400;\n  background: var(--bg-tertiary);\n  color: var(--text-secondary);\n}\n\n.crp-synth-section {\n  margin-bottom: 16px;\n}\n\n.crp-synth-section-label {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n}\n\n.crp-synth-section-text {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.crp-synth-block {\n  font-size: 12px;\n  line-height: 1.6;\n  color: var(--text-primary);\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  white-space: pre-wrap;\n}\n\n.crp-synth-footer {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n  border-top: 1px solid var(--border-color);\n  padding-top: 12px;\n  margin-top: 8px;\n}\n\n/* ========== AssembledContentViewer ========== */\n\n.crp-acv {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.crp-acv-header {\