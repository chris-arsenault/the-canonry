{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NivzYo8bV1be7BkBDHzu97","type":"tool_result","content":"     1→/**\n     2→ * ExpandableCard - A collapsible card with header and body sections\n     3→ *\n     4→ * Used for list items that expand to show detailed content.\n     5→ */\n     6→\n     7→import React, { useCallback } from 'react';\n     8→import PropTypes from 'prop-types';\n     9→\n    10→/**\n    11→ * @param {Object} props\n    12→ * @param {boolean} props.expanded - Whether the card is expanded\n    13→ * @param {Function} props.onToggle - Called when header is clicked. If toggleId is provided, calls onToggle(toggleId).\n    14→ * @param {string} [props.toggleId] - Optional ID passed back to onToggle, enabling stable callbacks in list renders\n    15→ * @param {React.ReactNode} props.title - Main title content\n    16→ * @param {React.ReactNode} [props.subtitle] - Optional subtitle/ID display\n    17→ * @param {React.ReactNode} [props.actions] - Right-side header content (badges, summary)\n    18→ * @param {React.ReactNode} props.children - Body content (shown when expanded)\n    19→ * @param {string} [props.className] - Additional class for the container\n    20→ */\n    21→export function ExpandableCard({\n    22→  expanded,\n    23→  onToggle,\n    24→  toggleId,\n    25→  title,\n    26→  subtitle,\n    27→  actions,\n    28→  children,\n    29→  className = '',\n    30→}) {\n    31→  const handleToggle = useCallback(() => {\n    32→    if (toggleId !== undefined) {\n    33→      onToggle(toggleId);\n    34→    } else {\n    35→      onToggle();\n    36→    }\n    37→  }, [onToggle, toggleId]);\n    38→\n    39→  return (\n    40→    <div className={`expandable-card ${className}`.trim()}>\n    41→      <div className=\"expandable-card-header\" onClick={handleToggle} role=\"button\" tabIndex={0} onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleToggle(); }} >\n    42→        <div className=\"expandable-card-left\">\n    43→          <span\n    44→            className={`expand-icon ${expanded ? 'expand-icon-expanded' : 'expand-icon-collapsed'}`}\n    45→          >\n    46→            ▶\n    47→          </span>\n    48→          <div className=\"expandable-card-title\">\n    49→            <span className=\"expandable-card-name\">{title}</span>\n    50→            {subtitle && <span className=\"expandable-card-id\">{subtitle}</span>}\n    51→          </div>\n    52→        </div>\n    53→        {actions && <div className=\"expandable-card-actions\">{actions}</div>}\n    54→      </div>\n    55→      {expanded && (\n    56→        <div className=\"expandable-card-content\">\n    57→          {children}\n    58→        </div>\n    59→      )}\n    60→    </div>\n    61→  );\n    62→}\n    63→\n    64→export default ExpandableCard;\n    65→\n    66→ExpandableCard.propTypes = {\n    67→  expanded: PropTypes.bool.isRequired,\n    68→  onToggle: PropTypes.func.isRequired,\n    69→  toggleId: PropTypes.string,\n    70→  title: PropTypes.node.isRequired,\n    71→  subtitle: PropTypes.node,\n    72→  actions: PropTypes.node,\n    73→  children: PropTypes.node,\n    74→  className: PropTypes.string,\n    75→};\n    76→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"ad55a77b-319b-4c93-a1f5-25752d0aaf0b"}
