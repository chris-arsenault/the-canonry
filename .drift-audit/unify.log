{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014qQQTDUgs9ecsnjeENgJFe","type":"tool_result","content":"     1→import js from \"@eslint/js\";\n     2→import globals from \"globals\";\n     3→import react from \"eslint-plugin-react\";\n     4→import reactHooks from \"eslint-plugin-react-hooks\";\n     5→import reactRefresh from \"eslint-plugin-react-refresh\";\n     6→import reactPerf from \"eslint-plugin-react-perf\";\n     7→import jsxA11y from \"eslint-plugin-jsx-a11y\";\n     8→import sonarjs from \"eslint-plugin-sonarjs\";\n     9→import prettier from \"eslint-config-prettier\";\n    10→import tseslint from \"typescript-eslint\";\n    11→import maxJsxProps from \"./eslint-rules/max-jsx-props.js\";\n    12→import noInlineStyles from \"./eslint-rules/no-inline-styles.js\";\n    13→import noRawErrorDiv from \"./eslint-rules/no-raw-error-div.js\";\n    14→import noInlineIdGeneration from \"./eslint-rules/no-inline-id-generation.js\";\n    15→import noDuplicateComponentCss from \"./eslint-rules/no-duplicate-component-css.js\";\n    16→import noTabCompanionCss from \"./eslint-rules/no-tab-companion-css.js\";\n    17→import noCrossAppAlias from \"./eslint-rules/no-cross-app-alias.js\";\n    18→import noVizOverlayDrift from \"./eslint-rules/no-viz-overlay-drift.js\";\n    19→\n    20→const localPlugin = {\n    21→  rules: {\n    22→    \"max-jsx-props\": maxJsxProps,\n    23→    \"no-inline-styles\": noInlineStyles,\n    24→    \"no-raw-error-div\": noRawErrorDiv,\n    25→    \"no-inline-id-generation\": noInlineIdGeneration,\n    26→    \"no-duplicate-component-css\": noDuplicateComponentCss,\n    27→    \"no-tab-companion-css\": noTabCompanionCss,\n    28→    \"no-cross-app-alias\": noCrossAppAlias,\n    29→    \"no-viz-overlay-drift\": noVizOverlayDrift,\n    30→  },\n    31→};\n    32→\n    33→export default tseslint.config(\n    34→  {\n    35→    ignores: [\n    36→      \"node_modules/\",\n    37→      \"**/node_modules/\",\n    38→      \"**/dist/\",\n    39→      \"**/build/\",\n    40→      \"**/.turbo/\",\n    41→      \"**/coverage/\",\n    42→      \"infrastructure/\",\n    43→      \"scripts/\",\n    44→      \"**/scripts/\",\n    45→      \"**/*.min.js\",\n    46→      \"**/.__mf__temp/\",\n    47→      \"**/vitest.config.ts\",\n    48→      \"tools/\",\n    49→    ],\n    50→  },\n    51→\n    52→  // Base JS rules + complexity limits (warnings so they show in editor but don't block CI yet)\n    53→  {\n    54→    ...js.configs.recommended,\n    55→    languageOptions: {\n    56→      ecmaVersion: \"latest\",\n    57→      sourceType: \"module\",\n    58→    },\n    59→    rules: {\n    60→      complexity: [\"warn\", 10],\n    61→      \"max-lines\": [\"warn\", { max: 400, skipBlankLines: true, skipComments: true }],\n    62→      \"max-lines-per-function\": [\"warn\", { max: 75, skipBlankLines: true, skipComments: true }],\n    63→      \"max-depth\": [\"warn\", 4],\n    64→    },\n    65→  },\n    66→\n    67→  // TypeScript: recommended type-checked rules\n    68→  ...tseslint.configs.recommendedTypeChecked,\n    69→\n    70→  // TypeScript parser options\n    71→  {\n    72→    languageOptions: {\n    73→      parserOptions: {\n    74→        projectService: true,\n    75→        tsconfigRootDir: import.meta.dirname,\n    76→      },\n    77→    },\n    78→  },\n    79→\n    80→  // Disable type-checked rules for non-TS files (config files, scripts, etc.)\n    81→  {\n    82→    files: [\"**/*.{js,jsx,mjs,cjs}\"],\n    83→    ...tseslint.configs.disableTypeChecked,\n    84→  },\n    85→\n    86→  // Library code: Node.js globals\n    87→  {\n    88→    files: [\n    89→      \"apps/lore-weave/lib/**/*.ts\",\n    90→      \"apps/name-forge/lib/**/*.ts\",\n    91→      \"apps/cosmographer/lib/**/*.ts\",\n    92→      \"packages/*/src/**/*.ts\",\n    93→    ],\n    94→    plugins: {\n    95→      local: localPlugin,\n    96→    },\n    97→    languageOptions: {\n    98→      globals: {\