{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0111rp5crnfYJifR8Poza9dP","type":"tool_result","content":"     1→/**\n     2→ * Shared Components for Canonry MFEs\n     3→ *\n     4→ * Re-exports UI components, form components, hooks, and utilities\n     5→ * that can be shared across all micro-frontends.\n     6→ *\n     7→ * CSS styles are available via: import '@the-canonry/shared-components/styles'\n     8→ */\n     9→\n    10→// Canonry-specific components\n    11→export { default as TagSelector } from './TagSelector.jsx';\n    12→\n    13→// Badge components\n    14→export { ToolUsageBadges } from './components/badges';\n    15→export { DetailUsageBadges } from './components/badges';\n    16→\n    17→// Schema usage utilities\n    18→export {\n    19→  computeUsageMap,\n    20→  computeSchemaUsage,\n    21→  getElementValidation,\n    22→  getUsageSummary,\n    23→  computeTagUsage,\n    24→  getEntityKindUsageSummary,\n    25→  getRelationshipKindUsageSummary,\n    26→} from './utils/schemaUsageMap';\n    27→\n    28→\n    29→// Form components\n    30→export { ReferenceDropdown } from './components/ReferenceDropdown';\n    31→export { ChipSelect } from './components/ChipSelect';\n    32→export { SearchableDropdown } from './components/SearchableDropdown';\n    33→export { LevelSelector, STRENGTH_LEVELS, PROMINENCE_LEVELS } from './components/LevelSelector';\n    34→export { NumberInput } from './components/NumberInput';\n    35→export { LocalTextArea } from './components/LocalTextArea';\n    36→\n    37→// Matrix components\n    38→export { CoverageMatrix } from './components/CoverageMatrix';\n    39→\n    40→// UI components\n    41→export { EnableToggle } from './components/EnableToggle';\n    42→export { IconButton } from './components/IconButton';\n    43→export { InfoBox } from './components/InfoBox';\n    44→export { SectionHeader } from './components/SectionHeader';\n    45→export { EmptyState } from './components/EmptyState';