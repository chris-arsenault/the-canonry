{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018pc2D4sjXdpdbBWfcYdkJg","type":"tool_result","content":"     1→/**\n     2→ * WikiSearch - Full-text search for wiki pages\n     3→ *\n     4→ * Uses fuse.js for fuzzy matching across page titles and content.\n     5→ */\n     6→\n     7→import React, { useMemo, useState, useRef, useEffect } from \"react\";\n     8→import Fuse from \"fuse.js\";\n     9→import type { WikiPage } from \"../types/world.ts\";\n    10→import styles from \"./WikiSearch.module.css\";\n    11→\n    12→interface WikiSearchProps {\n    13→  pages: WikiPage[];\n    14→  query: string;\n    15→  onQueryChange: (query: string) => void;\n    16→  onSelect: (pageId: string) => void;\n    17→  /** Direction to expand dropdown - 'down' (default) or 'up' */\n    18→  expandDirection?: \"down\" | \"up\";\n    19→}\n    20→\n    21→export default function WikiSearch({\n    22→  pages,\n    23→  query,\n    24→  onQueryChange,\n    25→  onSelect,\n    26→  expandDirection = \"down\",\n    27→}: Readonly<WikiSearchProps>) {\n    28→  const [isOpen, setIsOpen] = useState(false);\n    29→  const [selectedIndex, setSelectedIndex] = useState(0);\n    30→  const containerRef = useRef<HTMLDivElement>(null);\n    31→\n    32→  // Build fuse.js search index\n    33→  const fuse = useMemo(() => {\n    34→    return new Fuse(pages, {\n    35→      keys: [\n    36→        { name: \"title\", weight: 2 },\n    37→        { name: \"aliases\", weight: 1.5 },\n    38→        { name: \"content.summary\", weight: 1.2 },\n    39→        { name: \"content.sections.heading\", weight: 0.5 },\n    40→        { name: \"content.sections.content\", weight: 1 },\n    41→      ],\n    42→      threshold: 0.3,\n    43→      includeScore: true,\n    44→      minMatchCharLength: 2,\n    45→    });\n    46→  }, [pages]);\n    47→\n    48→  // Search results\n    49→  const results = useMemo(() => {\n    50→    if (!query || query.length < 2) return [];\n    51→    return fuse.search(query).slice(0, 10);\n    52→  }, [fuse, query]);\n    53→\n    54→  // Handle keyboard navigation\n    55→  const handleKeyDown = (e: React.KeyboardEvent) => {\n    56→    if (!isOpen || results.length === 0) return;\n    57→\n    58→    switch (e.key) {\n    59→      case \"ArrowDown\":\n    60→        e.preventDefault();\n    61→        setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n    62→        break;\n    63→      case \"ArrowUp\":\n    64→        e.preventDefault();\n    65→        setSelectedIndex((i) => Math.max(i - 1, 0));\n    66→        break;\n    67→      case \"Enter\":\n    68→        e.preventDefault();\n    69→        if (results[selectedIndex]) {\n    70→          onSelect(results[selectedIndex].item.id);\n    71→          setIsOpen(false);\n    72→          onQueryChange(\"\");\n    73→        }\n    74→        break;\n    75→      case \"Escape\":\n    76→        setIsOpen(false);\n    77→        break;\n    78→    }\n    79→  };\n    80→\n    81→  // Close dropdown when clicking outside\n    82→  useEffect(() => {\n    83→    const handleClickOutside = (e: MouseEvent) => {\n    84→      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n    85→        setIsOpen(false);\n    86→      }\n    87→    };\n    88→    document.addEventListener(\"mousedown\", handleClickOutside);\n    89→    return () => document.removeEventListener(\"mousedown\", handleClickOutside);\n    90→  }, []);\n    91→\n    92→  // Reset keyboard selection when result set changes\n    93→  useEffect(() => {\n    94→    // eslint-disable-next-line react-hooks/set-state-in-effect -- derived UI selection reset on results refresh\n    95→    setSelectedIndex(0);\n    96→  }, [results]);\n    97→\n    98→  return (\n    99→    <div ref={containerRef} className={styles.container}>\n   100→      <input\n   101→        type=\"text\"\n   102→        placeholder=\"Search...\"\n   103→        value={query}\n   104→        onChange={(e) => {\n   105→          onQueryChange(e.target.value);\n   106→          setIsOpen(true);\n   107→        }}\n   108→        onFocus={() => setIsOpen(true)}\n   109→        onKeyDown={handleKeyDown}\n   110→        className={styles.input}\n   111→      />\n   112→\n   113→      {isOpen && query.length >= 2 && (\n   114→        <div className={expandDirection === \"up\" ? styles.dropdownUp : styles.dropdown}>\n   115→          {results.length > 0 ? (\n   116→            results.map((result, index) => (\n   117→              <button\n   118→                key={result.item.id}\n   119→                className={index === selectedIndex ? styles.resultSelected : styles.result}\n   120→                onClick={() => {\n   121→                  onSelect(result.item.id);\n   122→                  setIsOpen(false);\n   123→                  onQueryChange(\"\");\n   124→                }}\n   125→                onMouseEnter={() => setSelectedIndex(index)}\n   126→              >\n   127→                {result.item.title}\n   128→                <span className={styles.resultType}>{result.item.type}</span>\n   129→              </button>\n   130→            ))\n   131→          ) : (\n   132→            <div className={styles.noResults}>No results found</div>\n   133→          )}\n   134→        </div>\n   135→      )}\n   136→    </div>\n   137→  );\n   138→}\n   139→"}]},"parent_tool_use_id":null,"session_id":"b581011f-7823-4110-9748-054ecf96699a","uuid":"46d6c375-2d48-4c52-8cd8-af872082471d","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/chronicler/webui/src/components/WikiSearch.tsx","content":"/**\n * WikiSearch - Full-text search for wiki pages\n *\n * Uses fuse.js for fuzzy matching across page titles and content.\n */\n\nimport React, { useMemo, useState, useRef, useEffect } from \"react\";\nimport Fuse from \"fuse.js\";\nimport type { WikiPage } from \"../types/world.ts\";\nimport styles from \"./WikiSearch.module.css\";\n\ninterface WikiSearchProps {\n  pages: WikiPage[];\n  query: string;\n  onQueryChange: (query: string) => void;\n  onSelect: (pageId: string) => void;\n  /** Direction to expand dropdown - 'down' (default) or 'up' */\n  expandDirection?: \"down\" | \"up\";\n}\n\nexport default function WikiSearch({\n  pages,\n  query,\n  onQueryChange,\n  onSelect,\n  expandDirection = \"down\",\n}: Readonly<WikiSearchProps>) {\n  const [isOpen, setIsOpen] = useState(false);\n  const [selectedIndex, setSelectedIndex] = useState(0);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Build fuse.js search index\n  const fuse = useMemo(() => {\n    return new Fuse(pages, {\n      keys: [\n        { name: \"title\", weight: 2 },\n        { name: \"aliases\", weight: 1.5 },\n        { name: \"content.summary\", weight: 1.2 },\n        { name: \"content.sections.heading\", weight: 0.5 },\n        { name: \"content.sections.content\", weight: 1 },\n      ],\n      threshold: 0.3,\n      includeScore: true,\n      minMatchCharLength: 2,\n    });\n  }, [pages]);\n\n  // Search results\n  const results = useMemo(() => {\n    if (!query || query.length < 2) return [];\n    return fuse.search(query).slice(0, 10);\n  }, [fuse, query]);\n\n  // Handle keyboard navigation\n  const handleKeyDown = (e: React.KeyboardEvent) => {\n    if (!isOpen || results.length === 0) return;\n\n    switch (e.key) {\n      case \"ArrowDown\":\n        e.preventDefault();\n        setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n        break;\n      case \"ArrowUp\":\n        e.preventDefault();\n        setSelectedIndex((i) => Math.max(i - 1, 0));\n        break;\n      case \"Enter\":\n        e.preventDefault();\n        if (results[selectedIndex]) {\n          onSelect(results[selectedIndex].item.id);\n          setIsOpen(false);\n          onQueryChange(\"\");\n        }\n        break;\n      case \"Escape\":\n        setIsOpen(false);\n        break;\n    }\n  };\n\n  // Close dropdown when clicking outside\n  useEffect(() => {\n    const handleClickOutside = (e: MouseEvent) => {\n      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n        setIsOpen(false);\n      }\n    };\n    document.addEventListener(\"mousedown\", handleClickOutside);\n    return () => document.removeEventListener(\"mousedown\", handleClickOutside);\n  }, []);\n\n  // Reset keyboard selection when result set changes\n  useEffect(() => {\n    // eslint-disable-next-line react-hooks/set-state-in-effect -- derived UI selection reset on results refresh\n    setSelectedIndex(0);\n  }, [results]);\n\n  return (\n    <div ref={containerRef} className={styles.container}>\n      <input\n        type=\"text\"\n        placeholder=\"Search...\"\n        value={query}\n        onChange={(e) => {\n          onQueryChange(e.target.value);\n          setIsOpen(true);\n        }}\n        onFocus={() => setIsOpen(true)}\n        onKeyDown={handleKeyDown}\n        className={styles.input}\n      />\n\n      {isOpen && query.length >= 2 && (\n        <div className={expandDirection === \"up\" ? styles.dropdownUp : styles.dropdown}>\n          {results.length > 0 ? (\n            results.map((result, index) => (\n              <button\n                key={result.item.id}\n                className={index === selectedIndex ? styles.resultSelected : styles.result}\n                onClick={() => {\n                  onSelect(result.item.id);\n                  setIsOpen(false);\n                  onQueryChange(\"\");\n                }}\n                onMouseEnter={() => setSelectedIndex(index)}\n              >\n                {result.item.title}\n                <span className={styles.resultType}>{result.item.type}</span>\n              </button>\n            ))\n          ) : (\n            <div className={styles.noResults}>No results found</div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":139,"startLine":1,"totalLines":139}}}
