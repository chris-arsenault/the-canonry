les\n */\n\n.naming-profile-container {\n  padding: var(--spacing-2xl);\n  max-width: 1600px;\n  margin: 0 auto;\n}\n\n.naming-profile-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: var(--spacing-2xl);\n}\n\n.naming-profile-title {\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.naming-profile-stats {\n  display: flex;\n  gap: var(--spacing-xl);\n  align-items: center;\n}\n\n.naming-profile-stat-item {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n.naming-profile-stat-value {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n}\n\n.naming-profile-content {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-2xl);\n}\n\n.naming-profile-section {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-xl);\n}\n\n.naming-profile-section-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-lg);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.naming-profile-warning-icon {\n  color: var(--color-warning);\n  font-size: var(--font-size-base);\n  font-weight: var(--font-weight-semibold);\n}\n\n.naming-profile-warning-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n}\n\n.naming-profile-warning-item {\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: var(--radius-md);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  display: flex;\n  gap: var(--spacing-md);\n  align-items: flex-start;\n}\n\n.naming-profile-mapping-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--font-size-sm);\n}\n\n.naming-profile-table-header {\n  text-align: left;\n  padding: var(--spacing-md) var(--spacing-lg);\n  color: var(--color-text-muted);\n  font-weight: var(--font-weight-semibold);\n  border-bottom: 1px solid var(--color-border);\n  text-transform: uppercase;\n  font-size: var(--font-size-xs);\n}\n\n.naming-profile-table-row {\n  border-bottom: 1px solid var(--color-border-light);\n  transition: background-color var(--transition-fast);\n}\n\n.naming-profile-table-row:hover {\n  background-color: rgb(59 130 246 / 5%);\n}\n\n.naming-profile-warning-row {\n  background-color: rgb(245 158 11 / 5%);\n}\n\n.naming-profile-table-cell {\n  padding: var(--spacing-md) var(--spacing-lg);\n  color: var(--color-text);\n}\n\n.naming-profile-generator-cell {\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-dim);\n}\n\n.naming-profile-kind-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  background-color: rgb(59 130 246 / 20%);\n  color: #60a5fa;\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  margin-right: var(--spacing-xs);\n}\n\n.naming-profile-kind-badge-transparent {\n  background-color: transparent;\n}\n\n.naming-profile-culture-cell {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.naming-profile-culture-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.naming-profile-badge {\n  display: inline-block;\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n}\n\n.naming-profile-badge-match {\n  background-color: rgb(34 197 94 / 20%);\n  color: var(--color-success);\n}\n\n.naming-profile-badge-missing {\n  background-color: rgb(239 68 68 / 20%);\n  color: var(--color-danger);\n}\n\n.naming-profile-badge-inherited {\n  background-color: rgb(107 114 128 / 20%);\n  col