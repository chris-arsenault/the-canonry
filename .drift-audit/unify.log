{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HTkfo8nHvhygTdrHXyvkjn","type":"tool_result","content":"     1→/**\n     2→ * useBackportFlow - Hook for chronicle lore backport workflows\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Contains:\n     5→ * - assembleContextForChronicle: build full context for a chronicle backport\n     6→ * - backportConfig: modal state for backport entity selection\n     7→ * - handleBackportLore: single-chronicle backport entry point\n     8→ * - handleBackportConfigStart: start backport with selected entities\n     9→ * - handleAcceptBackport: accept and apply backport patches\n    10→ * - handleMarkEntityNotNeeded: mark entities as not needing backport\n    11→ * - Bulk backport state and handlers (delegates to useBulkBackport)\n    12→ */\n    13→\n    14→import { useState, useCallback, useMemo, useRef, useEffect } from \"react\";\n    15→import { useChronicleLoreBackport } from \"./useChronicleLoreBackport\";\n    16→import { useBulkBackport } from \"./useBulkBackport\";\n    17→import * as entityRepo from \"../lib/db/entityRepository\";\n    18→import { useEntityStore } from \"../lib/db/entityStore\";\n    19→import {\n    20→  getChronicle,\n    21→  getChroniclesForSimulation,\n    22→  updateChronicleEntityBackportStatus,\n    23→} from \"../lib/db/chronicleRepository\";\n    24→import { computeBackportProgress } from \"../lib/chronicleTypes\";\n    25→\n    26→// --- Module-level helpers ---\n    27→\n    28→async function buildCastContexts(chronicle, getEntityContextsForRevision) {\n    29→  const roleAssignments = chronicle.roleAssignments || [];\n    30→  const castEntityIds = roleAssignments.map((r) => r.entityId);\n    31→  const baseContexts = await getEntityContextsForRevision(castEntityIds);\n    32→  if (baseContexts.length === 0) return null;\n    33→\n    34→  const primarySet = new Set(roleAssignments.filter((r) => r.isPrimary).map((r) => r.entityId));\n    35→  const castContexts = baseContexts.map((ctx) => ({\n    36→    ...ctx,\n    37→    isPrimary: primarySet.has(ctx.id),\n    38→  }));\n    39→\n    40→  if (chronicle.lens && !castEntityIds.includes(chronicle.lens.entityId)) {\n    41→    const lensContexts = await getEntityContextsForRevision([chronicle.lens.entityId]);\n    42→    if (lensContexts.length > 0) {\n    43→      castContexts.push({ ...lensContexts[0], isLens: true });\n    44→    }\n    45→  }\n    46→\n    47→  return castContexts;\n    48→}\n    49→\n    50→async function appendTertiaryContexts(allContexts, chronicle, getEntityContextsForRevision) {\n    51→  const acceptedTertiary = (chronicle.tertiaryCast || []).filter((e) => e.accepted);\n    52→  if (acceptedTertiary.length === 0) return;\n    53→\n    54→  const existingIds = new Set(allContexts.map((c) => c.id));\n    55→  const tertiaryFiltered = acceptedTertiary.filter((e) => !existingIds.has(e.entityId));\n    56→  const tertiaryIds = tertiaryFiltered.map((e) => e.entityId);\n    57→  if (tertiaryIds.length === 0) return;\n    58→\n    59→  const tertiaryContexts = await getEntityContextsForRevision(tertiaryIds);\n    60→  const tertiaryByEntityId = new Map(tertiaryFiltered.map((t) => [t.entityId, t]));\n    61→  for (const ctx of tertiaryContexts) {\n    62→    const entry = tertiaryByEntityId.get(ctx.id);\n    63→    const matchedAs = entry?.matchedAs;\n    64→    allContexts.push({\n    65→      ...ctx,\n    66→      isTertiary: true,\n    67→      ...(matchedAs && matchedAs !== ctx.name ? { chronicleName: matchedAs } : {}),\n    68→    });\n    69→  }\n    70→}\n    71→\n    72→function buildPerspectiveSynthesisJson(chronicle) {\n    73→  const ps = chronicle.perspectiveSynthesis;\n    74→  if (!ps) return \"\";\n    75→  return JSON.stringify({\n    76→    brief: ps.brief || \"\",\n    77→    facets: ps.facets || [],\n    78→    narrativeVoice: ps.narrativeVoice || {},\n    79→    entityDirectives: ps.entityDirectives || [],\n    80→    suggestedMotifs: ps.suggestedMotifs || [],\n    81→    chronicleFormat: chronicle.format || \"\",\n    82→    ...(chronicle.narrativeDirection ? { narrativeDirection: chronicle.narrativeDirection } : {}),\n    83→  });\n    84→}\n    85→\n    86→async function resolvePerEntityBackportStatus(allContexts, chronicleBackportMap, chronicleId) {\n    87→  const perEntityStatus = {};\n    88→  const unresolvedIds = allContexts\n    89→    .filter((ctx) => !chronicleBackportMap[ctx.id])\n    90→    .map((ctx) => ctx.id);\n    91→  const loadedEntities =\n    92→    unresolvedIds.length > 0 ? await useEntityStore.getState().loadEntities(unresolvedIds) : [];\n    93→  const loadedMap = new Map(loadedEntities.map((e) => [e.id, e]));\n    94→\n    95→  for (const ctx of allContexts) {\n    96→    if (chronicleBackportMap[ctx.id]) {\n    97→      perEntityStatus[ctx.id] = chronicleBackportMap[ctx.id].status;\n    98→      continue;\n    99→    }\n   100→    const entity = loadedMap.get(ctx.id);\n   101→    const hasBackref = (entity?.enrichment?.chronicleBackrefs || []).some(\n   102→      (br) => br.chronicleId === chronicleId\n   103→    );\n   104→    if (hasBackref) {\n   105→      perEntityStatus[ctx.id] = \"backported\";\n   106→    }\n   107→  }\n   108→  return perEntityStatus;\n   109→}\n   110→\n   111→async function assembleChronicleContext(\n   112→  projectId,\n   113→  simulationRunId,\n   114→  chronicleId,\n   115→  getEntityContextsForRevision\n   116→) {\n   117→  if (!projectId || !simulationRunId || !chronicleId) return null;\n   118→  const chronicle = await getChronicle(chronicleId);\n   119→  if (!chronicle?.finalContent) return null;\n   120→  const castContexts = await buildCastContexts(chronicle, getEntityContextsForRevision);\n   121→  if (!castContexts) return null;\n   122→  const allContexts = [...castContexts];\n   123→  await appendTertiaryContexts(allContexts, chronicle, getEntityContextsForRevision);\n   124→  const perspectiveSynthesisJson = buildPerspectiveSynthesisJson(chronicle);\n   125→  const chronicleBackportMap = chronicle.entityBackportStatus || {};\n   126→  const perEntityStatus = await resolvePerEntityBackportStatus(\n   127→    allContexts,\n   128→    chronicleBackportMap,\n   129→    chronicleId\n   130→  );\n   131→  return {\n   132→    chronicleId,\n   133→    chronicleTitle: chronicle.title || \"Untitled Chronicle\",\n   134→    entities: allContexts,\n   135→    chronicleText: chronicle.finalContent,\n   136→    perspectiveSynthesisJson,\n   137→    perEntityStatus,\n   138→  };\n   139→}\n   140→\n   141→async function applyBackportPatches(patches, chronicleId, reloadEntities) {\n   142→  const updatedIds = await entityRepo.applyRevisionPatches(patches, \"lore-backport\");\n   143→  if (chronicleId) {\n   144→    await entityRepo.revalidateBackrefs(patches, { chronicleId });\n   145→  }\n   146→  await reloadEntities(updatedIds);\n   147→}\n   148→\n   149→async function markEntitiesBackported(chronicleId, entityIds, setChronicleRefreshTrigger) {\n   150→  const now = Date.now();\n   151→  const entries = entityIds.map((id) => ({ entityId: id, status: \"backported\", updatedAt: now }));\n   152→  try {\n   153→    await updateChronicleEntityBackportStatus(chronicleId, entries);\n   154→    setChronicleRefreshTrigger((n) => n + 1);\n   155→  } catch (err) {\n   156→    console.warn(\"[Backport] Failed to set entity backport status:\", err);\n   157→  }\n   158→}\n   159→\n   160→async function getEligibleChronicleIds(simRunId) {\n   161→  const allChronicles = await getChroniclesForSimulation(simRunId);\n   162→  return allChronicles\n   163→    .filter((c) => {\n   164→      if (!c.finalContent) return false;\n   165→      const progress = computeBackportProgress(c);\n   166→      return progress.done < progress.total;\n   167→    })\n   168→    .map((c) => {\n   169→      const progress = computeBackportProgress(c);\n   170→      return {\n   171→        chronicleId: c.chronicleId,\n   172→        chronicleTitle: c.title || \"Untitled Chronicle\",\n   173→        pendingCount: progress.total - progress.done,\n   174→      };\n   175→    });\n   176→}\n   177→\n   178→// --- Extracted handler bodies (module-level) ---\n   179→\n   180→function runBackportConfigStart(\n   181→  backportConfig,\n   182→  projectId,\n   183→  simulationRunId,\n   184→  selectedEntityIds,\n   185→  customInstructions,\n   186→  backportSentEntityIdsRef,\n   187→  startBackport,\n   188→  setBackportConfig\n   189→) {\n   190→  if (!backportConfig || !projectId || !simulationRunId) return;\n   191→  const selectedEntities = backportConfig.entities.filter((e) => selectedEntityIds.includes(e.id));\n   192→  if (selectedEntities.length === 0) return;\n   193→  backportSentEntityIdsRef.current = selectedEntityIds;\n   194→  startBackport({\n   195→    projectId,\n   196→    simulationRunId,\n   197→    chronicleId: backportConfig.chronicleId,\n   198→    chronicleText: backportConfig.chronicleText,\n   199→    perspectiveSynthesisJson: backportConfig.perspectiveSynthesisJson,\n   200→    entities: selectedEntities,\n   201→    customInstructions: customInstructions || undefined,\n   202→  });\n   203→  setBackportConfig(null);\n   204→}\n   205→\n   206→async function runAcceptBackport(\n   207→  backportChronicleId,\n   208→  applyAcceptedBackportPatches,\n   209→  reloadEntities,\n   210→  backportSentEntityIdsRef,\n   211→  setChronicleRefreshTrigger\n   212→) {\n   213→  const cId = backportChronicleId;\n   214→  const patches = applyAcceptedBackportPatches();\n   215→  if (!patches?.length) return;\n   216→  await applyBackportPatches(patches, cId, reloadEntities);\n   217→  if (cId) {\n   218→    const sentIds = backportSentEntityIdsRef.current || patches.map((p) => p.entityId);\n   219→    await markEntitiesBackported(cId, sentIds, setChronicleRefreshTrigger);\n   220→    backportSentEntityIdsRef.current = null;\n   221→  }\n   222→}\n   223→\n   224→async function runMarkEntityNotNeeded(\n   225→  backportConfig,\n   226→  entityIds,\n   227→  setBackportConfig,\n   228→  setChronicleRefreshTrigger\n   229→) {\n   230→  if (!backportConfig?.chronicleId) return;\n   231→  const now = Date.now();\n   232→  const entries = entityIds.map((id) => ({ entityId: id, status: \"not_needed\", updatedAt: now }));\n   233→  await updateChronicleEntityBackportStatus(backportConfig.chronicleId, entries);\n   234→  setBackportConfig((prev) => {\n   235→    if (!prev) return null;\n   236→    const updated = { ...prev.perEntityStatus };\n   237→    for (const id of entityIds) updated[id] = \"not_needed\";\n   238→    return { ...prev, perEntityStatus: updated };\n   239→  });\n   240→  setChronicleRefreshTrigger((n) => n + 1);\n   241→}\n   242→\n   243→// --- Bulk backport helper hook ---\n   244→\n   245→function useBulkBackportSetup({\n   246→  assembleContextForChronicle,\n   247→  reloadEntities,\n   248→  setChronicleRefreshTrigger,\n   249→  simulationRunId,\n   250→  projectId,\n   251→}) {\n   252→  const applyBulkPatches = useCallback(\n   253→    async (patches, chronicleId, sentEntityIds) => {\n   254→      if (patches.length > 0) {\n   255→        await applyBackportPatches(patches, chronicleId, reloadEntities);\n   256→      }\n   257→      await markEntitiesBackported(chronicleId, sentEntityIds, setChronicleRefreshTrigger);\n   258→    },\n   259→    [reloadEntities, setChronicleRefreshTrigger]\n   260→  );\n   261→\n   262→  const bulkBackportDeps = useMemo(\n   263→    () => ({\n   264→      assembleContextForChronicle,\n   265→      applyPatches: applyBulkPatches,\n   266→      getEligibleChronicleIds,\n   267→    }),\n   268→    [assembleContextForChronicle, applyBulkPatches]\n   269→  );\n   270→\n   271→  const {\n   272→    progress: bulkBackportProgress,\n   273→    isActive: isBulkBackportActive,\n   274→    prepareBulkBackport,\n   275→    confirmBulkBackport,\n   276→    cancelBulkBackport,\n   277→  } = useBulkBackport(bulkBackportDeps);\n   278→\n   279→  const [showBulkBackportModal, setShowBulkBackportModal] = useState(false);\n   280→\n   281→  const handleStartBulkBackport = useCallback(async () => {\n   282→    if (!simulationRunId || !projectId) return;\n   283→    setShowBulkBackportModal(true);\n   284→    await prepareBulkBackport(simulationRunId, projectId);\n   285→  }, [simulationRunId, projectId, prepareBulkBackport]);\n   286→\n   287→  const handleConfirmBulkBackport = confirmBulkBackport;\n   288→\n   289→  const handleCancelBulkBackport = useCallback(() => {\n   290→    cancelBulkBackport();\n   291→    setShowBulkBackportModal(false);\n   292→  }, [cancelBulkBackport]);\n   293→\n   294→  const handleCloseBulkBackport = useCallback(() => {\n   295→    setShowBulkBackportModal(false);\n   296→  }, []);\n   297→\n   298→  useEffect(() => {\n   299→    if (showBulkBackportModal && bulkBackportProgress.status === \"idle\") {\n   300→      const timer = setTimeout(() => {\n   301→        if (bulkBackportProgress.status === \"idle\") {\n   302→          setShowBulkBackportModal(false);\n   303→          alert(\"No chronicles eligible for backport (all already backported or unpublished).\");\n   304→        }\n   305→      }, 500);\n   306→      return () => clearTimeout(timer);\n   307→    }\n   308→  }, [showBulkBackportModal, bulkBackportProgress.status]);\n   309→\n   310→  return {\n   311→    bulkBackportProgress,\n   312→    isBulkBackportActive,\n   313→    showBulkBackportModal,\n   314→    handleStartBulkBackport,\n   315→    handleConfirmBulkBackport,\n   316→    handleCancelBulkBackport,\n   317→    handleCloseBulkBackport,\n   318→  };\n   319→}\n   320→\n   321→// --- Main hook ---\n   322→\n   323→export function useBackportFlow({\n   324→  projectId,\n   325→  simulationRunId,\n   326→  getEntityContextsForRevision,\n   327→  reloadEntities,\n   328→  setChronicleRefreshTrigger,\n   329→}) {\n   330→  const {\n   331→    run: backportRun,\n   332→    isActive: isBackportActive,\n   333→    chronicleId: backportChronicleId,\n   334→    startBackport,\n   335→    togglePatchDecision: toggleBackportPatchDecision,\n   336→    updateAnchorPhrase: updateBackportAnchorPhrase,\n   337→    applyAccepted: applyAcceptedBackportPatches,\n   338→    cancelBackport,\n   339→  } = useChronicleLoreBackport(getEntityContextsForRevision);\n   340→\n   341→  const assembleContextForChronicle = useCallback(\n   342→    (chronicleId) =>\n   343→      assembleChronicleContext(\n   344→        projectId,\n   345→        simulationRunId,\n   346→        chronicleId,\n   347→        getEntityContextsForRevision\n   348→      ),\n   349→    [projectId, simulationRunId, getEntityContextsForRevision]\n   350→  );\n   351→\n   352→  const [backportConfig, setBackportConfig] = useState(null);\n   353→  const backportSentEntityIdsRef = useRef(null);\n   354→\n   355→  const handleBackportLore = useCallback(\n   356→    async (chronicleId) => {\n   357→      const context = await assembleContextForChronicle(chronicleId);\n   358→      if (!context) {\n   359→        console.warn(\"[Backport] Could not assemble context for chronicle:\", chronicleId);\n   360→        return;\n   361→      }\n   362→      setBackportConfig(context);\n   363→    },\n   364→    [assembleContextForChronicle]\n   365→  );\n   366→\n   367→  const handleBackportConfigStart = useCallback(\n   368→    (selectedEntityIds, customInstructions) => {\n   369→      runBackportConfigStart(\n   370→        backportConfig,\n   371→        projectId,\n   372→        simulationRunId,\n   373→        selectedEntityIds,\n   374→        customInstructions,\n   375→        backportSentEntityIdsRef,\n   376→        startBackport,\n   377→        setBackportConfig\n   378→      );\n   379→    },\n   380→    [backportConfig, projectId, simulationRunId, startBackport]\n   381→  );\n   382→\n   383→  const handleAcceptBackport = useCallback(async () => {\n   384→    await runAcceptBackport(\n   385→      backportChronicleId,\n   386→      applyAcceptedBackportPatches,\n   387→      reloadEntities,\n   388→      backportSentEntityIdsRef,\n   389→      setChronicleRefreshTrigger\n   390→    );\n   391→  }, [\n   392→    applyAcceptedBackportPatches,\n   393→    backportChronicleId,\n   394→    reloadEntities,\n   395→    setChronicleRefreshTrigger,\n   396→  ]);\n   397→\n   398→  const handleMarkEntityNotNeeded = useCallback(\n   399→    async (entityIds) => {\n   400→      await runMarkEntityNotNeeded(\n   401→        backportConfig,\n   402→        entityIds,\n   403→        setBackportConfig,\n   404→        setChronicleRefreshTrigger\n   405→      );\n   406→    },\n   407→    [backportConfig, setChronicleRefreshTrigger]\n   408→  );\n   409→\n   410→  const {\n   411→    bulkBackportProgress,\n   412→    isBulkBackportActive,\n   413→    showBulkBackportModal,\n   414→    handleStartBulkBackport,\n   415→    handleConfirmBulkBackport,\n   416→    handleCancelBulkBackport,\n   417→    handleCloseBulkBackport,\n   418→  } = useBulkBackportSetup({\n   419→    assembleContextForChronicle,\n   420→    reloadEntities,\n   421→    setChronicleRefreshTrigger,\n   422→    simulationRunId,\n   423→    projectId,\n   424→  });\n   425→\n   426→  return {\n   427→    backportRun,\n   428→    isBackportActive,\n   429→    backportChronicleId,\n   430→    toggleBackportPatchDecision,\n   431→    updateBackportAnchorPhrase,\n   432→    cancelBackport,\n   433→    backportConfig,\n   434→    setBackportConfig,\n   435→    handleBackportLore,\n   436→    handleBackportConfigStart,\n   437→    handleAcceptBackport,\n   438→    handleMarkEntityNotNeeded,\n   439→    bulkBackportProgress,\n   440→    isBulkBackportActive,\n   441→    showBulkBackportModal,\n   442→    handleStartBulkBackport,\n   443→    handleConfirmBulkBackport,\n   444→    handleCancelBulkBackport,\n   445→    handleCloseBulkBackport,\n   446→    assembleContextForChronicle,\n   447→  };\n   448→}\n   449→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"e3ac5fc4-d16f-4e84-8a9c-5e42c6466bbc"}
