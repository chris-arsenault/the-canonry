{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018shKxTKnPEx3P6GzEbPzJ8","type":"tool_result","content":"     1→import PropTypes from \"prop-types\";\n     2→import { ErrorMessage } from \"@the-canonry/shared-components\";\n     3→import \"./IlluminatorTabContent.css\";\n     4→import EntityBrowser from \"./EntityBrowser\";\n     5→import ChroniclePanel from \"./ChroniclePanel\";\n     6→import WorldContextEditor from \"./WorldContextEditor\";\n     7→import EntityGuidanceEditor from \"./EntityGuidanceEditor\";\n     8→import VisualIdentityPanel from \"./VisualIdentityPanel\";\n     9→import ActivityPanel from \"./ActivityPanel\";\n    10→import ConfigPanel from \"./ConfigPanel\";\n    11→import CostsPanel from \"./CostsPanel\";\n    12→import StoragePanel from \"./StoragePanel\";\n    13→import TraitPaletteSection from \"./TraitPaletteSection\";\n    14→import StyleLibraryEditor from \"./StyleLibraryEditor\";\n    15→import StaticPagesPanel from \"./StaticPagesPanel\";\n    16→import CoveragePanel from \"./CoveragePanel\";\n    17→import FinalEditTab from \"./FinalEditTab\";\n    18→import EntityCoveragePanel from \"./EntityCoveragePanel\";\n    19→import HistorianConfigEditor from \"./HistorianConfigEditor\";\n    20→import PrePrintPanel from \"./PrePrintPanel\";\n    21→import { isHistorianConfigured } from \"../lib/historianTypes\";\n    22→import { useIlluminatorModals } from \"../lib/db/modalStore\";\n    23→import { useIlluminatorConfigStore } from \"../lib/db/illuminatorConfigStore\";\n    24→import { useEnrichmentQueueStore } from \"../lib/db/enrichmentQueueStore\";\n    25→import { useEraTemporalInfo } from \"../lib/db/indexSelectors\";\n    26→import React from \"react\";\n    27→\n    28→function EntitiesTab({ revisionFlow, historianFlow, ...props }) {\n    29→  return (\n    30→    <div className=\"illuminator-content\">\n    31→      <EntityBrowser\n    32→        worldSchema={props.worldSchema}\n    33→        config={props.config}\n    34→        onConfigChange={props.updateConfig}\n    35→        buildPrompt={props.buildPrompt}\n    36→        getVisualConfig={props.getVisualConfig}\n    37→        styleLibrary={props.styleLibrary}\n    38→        imageGenSettings={props.imageGenSettings}\n    39→        onStartRevision={() => revisionFlow.handleOpenRevisionFilter()}\n    40→        isRevising={revisionFlow.isRevisionActive}\n    41→        onBulkHistorianReview={historianFlow.handleStartBulkHistorianReview}\n    42→        onBulkHistorianEdition={historianFlow.handleStartBulkHistorianEdition}\n    43→        onBulkHistorianClear={historianFlow.handleStartBulkHistorianClear}\n    44→        isBulkHistorianActive={historianFlow.isBulkHistorianActive}\n    45→        onNavigateToTab={props.setActiveTab}\n    46→      />\n    47→    </div>\n    48→  );\n    49→}\n    50→\n    51→function ChronicleTab({ backportFlow, historianFlow, ...props }) {\n    52→  const {\n    53→    projectId,\n    54→    simulationRunId,\n    55→    worldContext,\n    56→    entityGuidance,\n    57→    cultureIdentities,\n    58→    historianConfig,\n    59→  } = useIlluminatorConfigStore();\n    60→  const queue = useEnrichmentQueueStore((s) => s.queue);\n    61→  return (\n    62→    <div className=\"illuminator-content\">\n    63→      <ChroniclePanel\n    64→        worldData={props.worldData}\n    65→        queue={queue}\n    66→        onEnqueue={props.enqueue}\n    67→        onCancel={props.cancel}\n    68→        worldContext={worldContext}\n    69→        projectId={projectId}\n    70→        simulationRunId={simulationRunId}\n    71→        buildPrompt={props.buildPrompt}\n    72→        styleLibrary={props.styleLibrary}\n    73→        imageGenSettings={props.imageGenSettings}\n    74→        entityGuidance={entityGuidance}\n    75→        cultureIdentities={cultureIdentities}\n    76→        onBackportLore={backportFlow.handleBackportLore}\n    77→        onStartBulkBackport={() => backportFlow.handleStartBulkBackport()}\n    78→        isBulkBackportActive={backportFlow.isBulkBackportActive}\n    79→        refreshTrigger={props.chronicleRefreshTrigger}\n    80→        imageModel={props.config.imageModel}\n    81→        onOpenImageSettings={() => useIlluminatorModals.getState().openImageSettings()}\n    82→        onHistorianReview={historianFlow.handleChronicleHistorianReview}\n    83→        isHistorianActive={historianFlow.isHistorianActive}\n    84→        historianConfigured={isHistorianConfigured(historianConfig)}\n    85→        historianConfig={historianConfig}\n    86→        onUpdateHistorianNote={historianFlow.handleUpdateHistorianNote}\n    87→        onRefreshEraSummaries={props.handleRefreshEraSummaries}\n    88→        onNavigateToTab={props.setActiveTab}\n    89→      />\n    90→    </div>\n    91→  );\n    92→}\n    93→\n    94→function CoverageTab(props) {\n    95→  const { worldContext, simulationRunId } = useIlluminatorConfigStore();\n    96→  return (\n    97→    <div className=\"illuminator-content\">\n    98→      <CoveragePanel\n    99→        worldContext={worldContext}\n   100→        simulationRunId={simulationRunId}\n   101→        onWorldContextChange={props.updateWorldContext}\n   102→      />\n   103→      <EntityCoveragePanel simulationRunId={simulationRunId} />\n   104→    </div>\n   105→  );\n   106→}\n   107→\n   108→function ContextTab({ dynamicsFlow, ...props }) {\n   109→  const worldContext = useIlluminatorConfigStore((s) => s.worldContext);\n   110→  const eraTemporalInfo = useEraTemporalInfo();\n   111→  return (\n   112→    <div className=\"illuminator-content\">\n   113→      <WorldContextEditor\n   114→        worldContext={worldContext}\n   115→        onWorldContextChange={props.updateWorldContext}\n   116→        eras={eraTemporalInfo}\n   117→        onGenerateDynamics={dynamicsFlow.handleGenerateDynamics}\n   118→        isGeneratingDynamics={dynamicsFlow.isDynamicsActive}\n   119→      />\n   120→    </div>\n   121→  );\n   122→}\n   123→\n   124→function GuidanceTab(props) {\n   125→  const { worldContext, entityGuidance } = useIlluminatorConfigStore();\n   126→  return (\n   127→    <div className=\"illuminator-content\">\n   128→      <EntityGuidanceEditor\n   129→        entityGuidance={entityGuidance}\n   130→        onEntityGuidanceChange={props.updateEntityGuidance}\n   131→        worldContext={worldContext}\n   132→        worldSchema={props.worldSchema}\n   133→        simulationMetadata={props.simulationMetadata}\n   134→      />\n   135→    </div>\n   136→  );\n   137→}\n   138→\n   139→function IdentityTab(props) {\n   140→  const cultureIdentities = useIlluminatorConfigStore((s) => s.cultureIdentities);\n   141→  return (\n   142→    <div className=\"illuminator-content\">\n   143→      <VisualIdentityPanel\n   144→        cultures={props.worldSchema?.cultures || []}\n   145→        entityKinds={props.worldSchema?.entityKinds || []}\n   146→        cultureIdentities={cultureIdentities}\n   147→        onCultureIdentitiesChange={props.updateCultureIdentities}\n   148→      />\n   149→    </div>\n   150→  );\n   151→}\n   152→\n   153→function StylesTab(props) {\n   154→  return (\n   155→    <div className=\"illuminator-content\">\n   156→      <StyleLibraryEditor\n   157→        styleLibrary={props.styleLibrary}\n   158→        loading={props.styleLibraryLoading}\n   159→        isCustom={props.hasCustomStyleLibrary}\n   160→        onAddArtisticStyle={props.addArtisticStyle}\n   161→        onUpdateArtisticStyle={props.updateArtisticStyle}\n   162→        onDeleteArtisticStyle={props.deleteArtisticStyle}\n   163→        onAddCompositionStyle={props.addCompositionStyle}\n   164→        onUpdateCompositionStyle={props.updateCompositionStyle}\n   165→        onDeleteCompositionStyle={props.deleteCompositionStyle}\n   166→        onAddNarrativeStyle={props.addNarrativeStyle}\n   167→        onUpdateNarrativeStyle={props.updateNarrativeStyle}\n   168→        onDeleteNarrativeStyle={props.deleteNarrativeStyle}\n   169→        onReset={props.resetStyleLibrary}\n   170→        entityKinds={(props.worldSchema?.entityKinds || []).map((k) => k.kind)}\n   171→      />\n   172→    </div>\n   173→  );\n   174→}\n   175→\n   176→function ActivityTab(props) {\n   177→  const { queue, stats } = useEnrichmentQueueStore();\n   178→  return (\n   179→    <div className=\"illuminator-content\">\n   180→      <ActivityPanel\n   181→        queue={queue}\n   182→        stats={stats}\n   183→        onCancel={props.cancel}\n   184→        onRetry={props.retry}\n   185→        onCancelAll={props.cancelAll}\n   186→        onClearCompleted={props.clearCompleted}\n   187→      />\n   188→    </div>\n   189→  );\n   190→}\n   191→\n   192→function TraitsTab(props) {\n   193→  const { projectId, simulationRunId, worldContext } = useIlluminatorConfigStore();\n   194→  const queue = useEnrichmentQueueStore((s) => s.queue);\n   195→  return (\n   196→    <div className=\"illuminator-content\">\n   197→      <TraitPaletteSection\n   198→        projectId={projectId}\n   199→        simulationRunId={simulationRunId}\n   200→        worldContext={worldContext?.description || \"\"}\n   201→        entityKinds={(props.worldSchema?.entityKinds || []).map((k) => k.kind)}\n   202→        subtypesByKind={props.subtypesByKind}\n   203→        eras={props.eraEntities}\n   204→        cultures={(props.worldSchema?.cultures || []).map((c) => ({\n   205→          name: c.name,\n   206→          description: c.description,\n   207→          visualIdentity: c.visualIdentity,\n   208→        }))}\n   209→        enqueue={props.enqueue}\n   210→        queue={queue}\n   211→        isWorkerReady={props.isWorkerReady}\n   212→      />\n   213→    </div>\n   214→  );\n   215→}\n   216→\n   217→function ConfigureTab(props) {\n   218→  return (\n   219→    <div className=\"illuminator-content\">\n   220→      <ConfigPanel\n   221→        config={props.config}\n   222→        onConfigChange={props.updateConfig}\n   223→        worldSchema={props.worldSchema}\n   224→      />\n   225→      <div className=\"illuminator-card\">\n   226→        <div className=\"illuminator-card-header\">\n   227→          <h2 className=\"illuminator-card-title\">Data Sync</h2>\n   228→        </div>\n   229→        <p className=\"itc-sync-hint\">\n   230→          Import simulation output into Dexie. This is manual by design.\n   231→        </p>\n   232→        <div className=\"itc-sync-actions\">\n   233→          <button\n   234→            type=\"button\"\n   235→            className=\"illuminator-btn illuminator-btn-primary\"\n   236→            disabled={props.isDataSyncing || !props.hasHardState}\n   237→            onClick={() => props.handleDataSync(\"patch\")}\n   238→          >\n   239→            {props.isDataSyncing ? \"Importing...\" : \"Patch from Hard State\"}\n   240→          </button>\n   241→          <button\n   242→            type=\"button\"\n   243→            className=\"illuminator-btn illuminator-btn-danger\"\n   244→            disabled={props.isDataSyncing || !props.hasHardState}\n   245→            onClick={() => props.handleDataSync(\"overwrite\")}\n   246→          >\n   247→            Overwrite from Hard State\n   248→          </button>\n   249→        </div>\n   250→        <div className=\"itc-sync-summary\">{props.hardStateSummary}</div>\n   251→        {props.dataSyncStatus && (\n   252→          props.dataSyncStatus.type === \"error\"\n   253→            ? <ErrorMessage message={props.dataSyncStatus.message} className=\"itc-sync-status\" />\n   254→            : <div className=\"itc-sync-status itc-sync-status-success\">{props.dataSyncStatus.message}</div>\n   255→        )}\n   256→      </div>\n   257→    </div>\n   258→  );\n   259→}\n   260→\n   261→function FinalEditTabWrapper() {\n   262→  return (\n   263→    <div className=\"illuminator-content\">\n   264→      <FinalEditTab />\n   265→    </div>\n   266→  );\n   267→}\n   268→\n   269→function PagesTab() {\n   270→  const projectId = useIlluminatorConfigStore((s) => s.projectId);\n   271→  return (\n   272→    <div className=\"illuminator-content\">\n   273→      <StaticPagesPanel projectId={projectId} />\n   274→    </div>\n   275→  );\n   276→}\n   277→\n   278→function CostsTab() {\n   279→  const { projectId, simulationRunId } = useIlluminatorConfigStore();\n   280→  const queue = useEnrichmentQueueStore((s) => s.queue);\n   281→  return (\n   282→    <div className=\"illuminator-content\">\n   283→      <CostsPanel queue={queue} projectId={projectId} simulationRunId={simulationRunId} />\n   284→    </div>\n   285→  );\n   286→}\n   287→\n   288→function StorageTab() {\n   289→  const projectId = useIlluminatorConfigStore((s) => s.projectId);\n   290→  return (\n   291→    <div className=\"illuminator-content\">\n   292→      <StoragePanel projectId={projectId} />\n   293→    </div>\n   294→  );\n   295→}\n   296→\n   297→function HistorianTab(props) {\n   298→  const historianConfig = useIlluminatorConfigStore((s) => s.historianConfig);\n   299→  return (\n   300→    <div className=\"illuminator-content\">\n   301→      <HistorianConfigEditor config={historianConfig} onChange={props.updateHistorianConfig} />\n   302→    </div>\n   303→  );\n   304→}\n   305→\n   306→function PreprintTab() {\n   307→  const { projectId, simulationRunId } = useIlluminatorConfigStore();\n   308→  return (\n   309→    <div className=\"illuminator-content\">\n   310→      <PrePrintPanel projectId={projectId} simulationRunId={simulationRunId} />\n   311→    </div>\n   312→  );\n   313→}\n   314→\n   315→EntitiesTab.propTypes = {\n   316→  revisionFlow: PropTypes.object,\n   317→  historianFlow: PropTypes.object,\n   318→  worldSchema: PropTypes.object,\n   319→  config: PropTypes.object,\n   320→  updateConfig: PropTypes.func,\n   321→  buildPrompt: PropTypes.func,\n   322→  getVisualConfig: PropTypes.func,\n   323→  styleLibrary: PropTypes.object,\n   324→  imageGenSettings: PropTypes.object,\n   325→  setActiveTab: PropTypes.func,\n   326→};\n   327→\n   328→ChronicleTab.propTypes = {\n   329→  backportFlow: PropTypes.object,\n   330→  historianFlow: PropTypes.object,\n   331→  worldData: PropTypes.object,\n   332→  enqueue: PropTypes.func,\n   333→  cancel: PropTypes.func,\n   334→  buildPrompt: PropTypes.func,\n   335→  styleLibrary: PropTypes.object,\n   336→  imageGenSettings: PropTypes.object,\n   337→  chronicleRefreshTrigger: PropTypes.any,\n   338→  config: PropTypes.object,\n   339→  handleRefreshEraSummaries: PropTypes.func,\n   340→  setActiveTab: PropTypes.func,\n   341→};\n   342→\n   343→CoverageTab.propTypes = {\n   344→  updateWorldContext: PropTypes.func,\n   345→};\n   346→\n   347→ContextTab.propTypes = {\n   348→  dynamicsFlow: PropTypes.object,\n   349→  updateWorldContext: PropTypes.func,\n   350→};\n   351→\n   352→GuidanceTab.propTypes = {\n   353→  updateEntityGuidance: PropTypes.func,\n   354→  worldSchema: PropTypes.object,\n   355→  simulationMetadata: PropTypes.object,\n   356→};\n   357→\n   358→IdentityTab.propTypes = {\n   359→  worldSchema: PropTypes.object,\n   360→  updateCultureIdentities: PropTypes.func,\n   361→};\n   362→\n   363→StylesTab.propTypes = {\n   364→  styleLibrary: PropTypes.object,\n   365→  styleLibraryLoading: PropTypes.bool,\n   366→  hasCustomStyleLibrary: PropTypes.bool,\n   367→  addArtisticStyle: PropTypes.func,\n   368→  updateArtisticStyle: PropTypes.func,\n   369→  deleteArtisticStyle: PropTypes.func,\n   370→  addCompositionStyle: PropTypes.func,\n   371→  updateCompositionStyle: PropTypes.func,\n   372→  deleteCompositionStyle: PropTypes.func,\n   373→  addNarrativeStyle: PropTypes.func,\n   374→  updateNarrativeStyle: PropTypes.func,\n   375→  deleteNarrativeStyle: PropTypes.func,\n   376→  resetStyleLibrary: PropTypes.func,\n   377→  worldSchema: PropTypes.object,\n   378→};\n   379→\n   380→ActivityTab.propTypes = {\n   381→  cancel: PropTypes.func,\n   382→  retry: PropTypes.func,\n   383→  cancelAll: PropTypes.func,\n   384→  clearCompleted: PropTypes.func,\n   385→};\n   386→\n   387→TraitsTab.propTypes = {\n   388→  worldSchema: PropTypes.object,\n   389→  subtypesByKind: PropTypes.object,\n   390→  eraEntities: PropTypes.array,\n   391→  enqueue: PropTypes.func,\n   392→  isWorkerReady: PropTypes.bool,\n   393→};\n   394→\n   395→ConfigureTab.propTypes = {\n   396→  config: PropTypes.object,\n   397→  updateConfig: PropTypes.func,\n   398→  worldSchema: PropTypes.object,\n   399→  isDataSyncing: PropTypes.bool,\n   400→  hasHardState: PropTypes.bool,\n   401→  handleDataSync: PropTypes.func,\n   402→  hardStateSummary: PropTypes.node,\n   403→  dataSyncStatus: PropTypes.object,\n   404→};\n   405→\n   406→HistorianTab.propTypes = {\n   407→  updateHistorianConfig: PropTypes.func,\n   408→};\n   409→\n   410→const TAB_COMPONENTS = {\n   411→  entities: EntitiesTab,\n   412→  chronicle: ChronicleTab,\n   413→  coverage: CoverageTab,\n   414→  finaledit: FinalEditTabWrapper,\n   415→  pages: PagesTab,\n   416→  context: ContextTab,\n   417→  guidance: GuidanceTab,\n   418→  identity: IdentityTab,\n   419→  styles: StylesTab,\n   420→  activity: ActivityTab,\n   421→  costs: CostsTab,\n   422→  storage: StorageTab,\n   423→  traits: TraitsTab,\n   424→  configure: ConfigureTab,\n   425→  historian: HistorianTab,\n   426→  preprint: PreprintTab,\n   427→};\n   428→\n   429→export default function IlluminatorTabContent({ activeTab, ...props }) {\n   430→  const TabComponent = TAB_COMPONENTS[activeTab];\n   431→  return TabComponent ? <TabComponent {...props} /> : null;\n   432→}\n   433→\n   434→IlluminatorTabContent.propTypes = {\n   435→  activeTab: PropTypes.string.isRequired,\n   436→};\n   437→"}]},"parent_tool_use_id":"toolu_01E28KJC3ajr97NVeEYUdMVq","session_id":"32340847-edea-48f0-bd01-a0b1ba1c9fbd","uuid":"cbf8bdf6-58c5-46b0-884a-e655658dc8da"}
