{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F4ukKm38eHU4QyyXLz8LLE","type":"tool_result","content":"     1→import { useState, useEffect } from \"react\";\n     2→\n     3→function readPersistedFlag(key) {\n     4→  try {\n     5→    return localStorage.getItem(key) === \"true\";\n     6→  } catch {\n     7→    return false;\n     8→  }\n     9→}\n    10→\n    11→function readPersistedApiKey(keyName) {\n    12→  try {\n    13→    if (localStorage.getItem(\"illuminator:persistApiKeys\") === \"true\") {\n    14→      return localStorage.getItem(keyName) || \"\";\n    15→    }\n    16→  } catch {\n    17→    /* ignored */\n    18→  }\n    19→  return \"\";\n    20→}\n    21→\n    22→export default function useApiKeys() {\n    23→  const [persistApiKeys, setPersistApiKeys] = useState(() =>\n    24→    readPersistedFlag(\"illuminator:persistApiKeys\")\n    25→  );\n    26→  const [anthropicApiKey, setAnthropicApiKey] = useState(() =>\n    27→    readPersistedApiKey(\"illuminator:anthropicApiKey\")\n    28→  );\n    29→  const [openaiApiKey, setOpenaiApiKey] = useState(() =>\n    30→    readPersistedApiKey(\"illuminator:openaiApiKey\")\n    31→  );\n    32→  const [showApiKeyInput, setShowApiKeyInput] = useState(false);\n    33→\n    34→  // Persist API keys when enabled\n    35→  useEffect(() => {\n    36→    try {\n    37→      localStorage.setItem(\"illuminator:persistApiKeys\", persistApiKeys ? \"true\" : \"false\");\n    38→      if (persistApiKeys) {\n    39→        localStorage.setItem(\"illuminator:anthropicApiKey\", anthropicApiKey);\n    40→        localStorage.setItem(\"illuminator:openaiApiKey\", openaiApiKey);\n    41→      } else {\n    42→        localStorage.removeItem(\"illuminator:anthropicApiKey\");\n    43→        localStorage.removeItem(\"illuminator:openaiApiKey\");\n    44→      }\n    45→    } catch {\n    46→      /* ignored */\n    47→    }\n    48→  }, [persistApiKeys, anthropicApiKey, openaiApiKey]);\n    49→\n    50→  const hasAnthropicKey = anthropicApiKey.length > 0;\n    51→  const hasRequiredKeys = hasAnthropicKey;\n    52→\n    53→  return {\n    54→    persistApiKeys,\n    55→    setPersistApiKeys,\n    56→    anthropicApiKey,\n    57→    setAnthropicApiKey,\n    58→    openaiApiKey,\n    59→    setOpenaiApiKey,\n    60→    showApiKeyInput,\n    61→    setShowApiKeyInput,\n    62→    hasAnthropicKey,\n    63→    hasRequiredKeys,\n    64→  };\n    65→}\n    66→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"cfb95a9c-7856-47bc-b382-d7bb62554d12"}
