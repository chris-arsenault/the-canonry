\n.cer-nav {\r\n  padding: 12px;\r\n}\r\n\r\n.cer-nav-button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 10px 12px;\r\n  margin-bottom: 4px;\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  text-align: left;\r\n  border: none;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n  transition: all 0.15s;\r\n  font-family: inherit;\r\n}\r\n\r\n.cer-nav-button-inactive {\r\n  background-color: transparent;\r\n  color: #93c5fd;\r\n}\r\n\r\n.cer-nav-button-inactive:hover {\r\n  background-color: rgba(245, 158, 11, 0.15);\r\n  color: #f59e0b;\r\n}\r\n\r\n.cer-nav-button-active {\r\n  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);\r\n  color: #0a1929;\r\n  font-weight: 600;\r\n}\r\n\r\n.cer-nav-button-content {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  width: 100%;\r\n}\r\n\r\n.cer-status-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.cer-main {\r\n  flex: 1;\r\n  display: flex;\r\n  overflow: hidden;\r\n}\r\n\r\n.cer-content {\r\n  flex: 1;\r\n  padding: 24px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.cer-placeholder {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 100%;\r\n  color: #60a5fa;\r\n  text-align: center;\r\n}\r\n\r\n.cer-placeholder-icon {\r\n  font-size: 48px;\r\n  margin-bottom: 16px;\r\n  opacity: 0.5;\r\n}\r\n\r\n.cer-placeholder-title {\r\n  font-size: 18px;\r\n  font-weight: 500;\r\n  margin-bottom: 8px;\r\n  color: #ffffff;\r\n}\r\n\r\n.cer-placeholder-desc {\r\n  font-size: 14px;\r\n  color: #93c5fd;\r\n  max-width: 400px;\r\n}\r\n"}}
