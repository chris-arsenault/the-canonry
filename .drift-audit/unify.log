14→  display: inline-flex;\n   215→  gap: 4px;\n   216→  flex-wrap: wrap;\n   217→}\n   218→\n   219→.detail-badge {\n   220→  display: inline-flex;\n   221→  align-items: center;\n   222→  padding: 2px 6px;\n   223→  border-radius: var(--radius-sm);\n   224→  font-size: var(--font-size-xs);\n   225→  font-weight: var(--font-weight-medium);\n   226→  cursor: default;\n   227→}\n   228→\n   229→/* Detail badge variants */\n   230→.detail-badge-generator {\n   231→  color: #60a5fa;\n   232→  background-color: rgb(96 165 250 / 15%);\n   233→}\n   234→\n   235→.detail-badge-system {\n   236→  color: #a855f7;\n   237→  background-color: rgb(168 85 247 / 15%);\n   238→}\n   239→\n   240→.detail-badge-action {\n   241→  color: #22c55e;\n   242→  background-color: rgb(34 197 94 / 15%);\n   243→}\n   244→\n   245→.detail-badge-pressure {\n   246→  color: #fbbf24;\n   247→  background-color: rgb(251 191 36 / 15%);\n   248→}\n   249→\n   250→.detail-badge-era {\n   251→  color: #ec4899;\n   252→  background-color: rgb(236 72 153 / 15%);\n   253→}\n   254→\n   255→.detail-badge-orphan {\n   256→  color: var(--color-text-muted);\n   257→  background-color: rgb(107 114 128 / 20%);\n   258→}\n   259→"}]},"parent_tool_use_id":null,"session_id":"012353ca-34db-4cb3-82b9-4cf23efde1ac","uuid":"cba618fc-b53b-4934-bcd0-1a18f53c14b7","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/badge.css","content":"/**\n * Badge component styles\n */\n\n/* Base badge */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-xs);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n  text-transform: uppercase;\n}\n\n/* Badge container */\n.badge-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-lg);\n}\n\n/* Validation badge (pill shape) */\n.badge-validation {\n  padding: 2px 6px;\n  border-radius: 10px;\n  margin-left: var(--spacing-md);\n}\n\n/* Color variants */\n.badge-error {\n  background-color: rgb(239 68 68 / 20%);\n  color: var(--color-danger);\n}\n\n.badge-warning {\n  background-color: rgb(245 158 11 / 20%);\n  color: var(--color-warning);\n}\n\n.badge-success {\n  background-color: rgb(34 197 94 / 15%);\n  color: var(--color-success);\n}\n\n.badge-info {\n  background-color: rgb(59 130 246 / 15%);\n  color: var(--color-text-dim);\n}\n\n.badge-orphan {\n  background-color: rgb(107 114 128 / 20%);\n  color: var(--color-gray);\n}\n\n/* Entity type badges */\n.badge-actor {\n  background-color: rgb(59 130 246 / 20%);\n  color: #60a5fa;\n}\n\n.badge-target {\n  background-color: rgb(168 85 247 / 20%);\n  color: #c084fc;\n}\n\n.badge-pressure {\n  background-color: rgb(245 158 11 / 20%);\n  color: #fbbf24;\n}\n\n/* Era badge */\n.badge-era {\n  background-color: rgb(59 130 246 / 15%);\n  color: #60a5fa;\n  padding: 3px 8px;\n}\n\n.badge-era-icon {\n  opacity: 0.7;\n}\n\n.badge-era-remaining {\n  background-color: transparent;\n}\n\n/* Usage badge */\n.badge-usage {\n  background-color: rgb(34 197 94 / 15%);\n  color: var(--color-success);\n  font-size: var(--font-size-xs);\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n}\n\n/* Compatibility badge */\n.badge-compatibility {\n  background-color: rgb(245 158 11 / 20%);\n  color: var(--color-warning);\n}\n\n/* Count badge (small pill) */\n.badge-count {\n  font-size: var(--font-size-base);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-dark);\n  padding: 2px 8px;\n  border-radius: 10px;\n}\n\n/* Type badge (for system/generator types) */\n.type-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  padding: 4px 10px;\n  border-radius: var(--radius-md);\n}\n\n/* ========================================\n   Tool Usage Badges (cross-tool view)\n   ======================================== */\n\n.tool-badge-container {\n  display: inline-flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.tool-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n  font-size: 11px;\n  font-weight: var(--font-weight-medium);\n  cursor: default;\n  transition: opacity 0.15s;\n  border: 1px solid;\n}\n\n.tool-badge-icon {\n  font-size: 10px;\n}\n\n.tool-badge-label {\n  /* label text */\n}\n\n.tool-badge-count {\n  font-weight: var(--font-weight-semibold);\n  margin-left: 2px;\n}\n\n/* Tool badge variants */\n.tool-badge-nameforge {\n  color: #fbbf24;\n  background-color: rgb(251 191 36 / 15%);\n  border-color: rgb(251 191 36 / 40%);\n}\n\n.tool-badge-seed {\n  color: #60a5fa;\n  background-color: rgb(96 165 250 / 15%);\n  border-color: rgb(96 165 250 / 40%);\n}\n\n.tool-badge-coherence {\n  color: #f59e0b;\n  background-color: rgb(245 158 11 / 15%);\n  border-color: rgb(245 158 11 / 40%);\n}\n\n.tool-badge-loreweave {\n  color: #a78bfa;\n  background-color: rgb(167 139 250 / 15%);\n  border-color: rgb(167 139 250 / 40%);\n}\n\n.tool-badge-generators {\n  color: #34d399;\n  background-color: rgb(52 211 153 / 15%);\n  border-color: rgb(52 211 153 / 40%);\n}\n\n.tool-badge-systems {\n  color: #c084fc;\n  background-color: rgb(192 132 252 / 15%);\n  border-color: rgb(192 132 252 / 40%);\n}\n\n.tool-badge-pressures {\n  color: #fb923c;\n  background-color: rgb(251 146 60 / 15%);\n  border-color: rgb(251 146 60 / 40%);\n}\n\n.tool-badge-axis {\n  color: #22d3ee;\n  background-color: rgb(34 211 238 / 15%);\n  border-color: rgb(34 211 238 / 40%);\n}\n\n/* ========================================\n   Detail Usage Badges (context view)\n   ======================================== */\n\n.detail-badge-container {\n  display: inline-flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.detail-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-medium);\n  cursor: default;\n}\n\n/* Detail badge variants */\n.detail-badge-generator {\n  color: #60a5fa;\n  background-color: rgb(96 165 250 / 15%);\n}\n\n.detail-badge-system {\n  color: #a855f7;\n  background-color: rgb(168 85 247 / 15%);\n}\n\n.detail-badge-action {\n  color: #22c55e;\n  background-color: rgb(34 197 94 / 15%);\n}\n\n.detail-badge-pressure {\n  color: #fbbf24;\n  background-color: rgb(251 191 36 / 15%);\n}\n\n.detail-badge-era {\n  color: #ec4899;\n  background-color: rgb(236 72 153 / 15%);\n}\n\n.detail-badge-orphan {\n  color: var(--color-text-muted);\n  background-color: rgb(107 114 128 / 20%);\n}\n","numLines":259,"startLine":1,"totalLines":259}}}
