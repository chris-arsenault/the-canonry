/\n.srm-diff-section {\n  margin-bottom: 10px;\n}\n\n.srm-diff-label {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--text-muted);\n  margin-bottom: 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.srm-diff-content {\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  font-size: 11px;\n  line-height: 1.8;\n  max-height: 300px;\n  overflow: auto;\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n}\n\n.srm-diff-added {\n  background: rgb(34 197 94 / 20%);\n  color: var(--text-primary);\n  border-radius: 2px;\n  padding: 0 1px;\n  text-decoration: none;\n}\n\n.srm-diff-removed {\n  background: rgb(239 68 68 / 20%);\n  color: var(--text-secondary);\n  border-radius: 2px;\n  padding: 0 1px;\n  text-decoration: line-through;\n}\n\n/* ─── AnchorPhraseEditor ─── */\n.srm-anchor-section {\n  margin-bottom: 10px;\n}\n\n.srm-anchor-label {\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--text-muted);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.srm-anchor-warning {\n  color: var(--warning, #f59e0b);\n  margin-left: 6px;\n  font-weight: 400;\n}\n\n.srm-anchor-edit-row {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n}\n\n.srm-anchor-input {\n  flex: 1;\n  padding: 4px 8px;\n  font-size: 11px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-tertiary);\n  color: var(--text-primary);\n}\n\n.srm-anchor-save-btn {\n  padding: 3px 8px;\n  font-size: 10px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-tertiary);\n  color: var(--text-primary);\n  cursor: pointer;\n}\n\n.srm-anchor-cancel-btn {\n  padding: 3px 8px;\n  font-size: 10px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n  cursor: pointer;\n}\n\n.srm-anchor-display {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 8px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  font-size: 11px;\n}\n\n.srm-anchor-phrase {\n  flex: 1;\n  font-style: italic;\n}\n\n.srm-anchor-phrase-found {\n  color: var(--text-primary);\n}\n\n.srm-anchor-phrase-missing {\n  color: var(--warning, #f59e0b);\n}\n\n.srm-anchor-edit-trigger {\n  padding: 2px 6px;\n  font-size: 9px;\n  border: 1px solid var(--border-color);\n  border-radius: 3px;\n  background: var(--bg-secondary);\n  color: var(--text-muted);\n  cursor: pointer;\n}\n\n/* ─── PatchCard ─── */\n.srm-patch-card {\n  background: var(--bg-secondary);\n  border-radius: 6px;\n  margin-bottom: 6px;\n}\n\n.srm-patch-card[data-accepted=\"true\"] {\n  border-left: 3px solid var(--success-color, #22c55e);\n  opacity: 1;\n}\n\n.srm-patch-card[data-accepted=\"false\"] {\n  border-left: 3px solid var(--text-muted);\n  opacity: 0.5;\n}\n\n.srm-patch-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 12px;\n  cursor: pointer;\n  user-select: none;\n}\n\n.srm-patch-header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.srm-patch-expand-icon {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.srm-patch-entity-name {\n  font-weight: 600;\n  font-size: 12px;\n}\n\n.srm-patch-entity-kind {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.srm-patch-changes-label {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.srm-patch-toggle-btn {\n  padding: 2px 8px;\n  font-size: 10px;\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  cursor: pointer;\n}\n\n.srm-patch-toggle-btn[data-accepted=\"true\"] {\n  background: var(--success-color, #22c55e);\n  color: #fff;\n}\n\n.srm-patch-toggle-btn[data-accepted=\"false\"] {\n  background: var(--bg-tertiary);\n  color: var(--text-secondary);\n}\n\n.srm-patch-expanded {\n  padding: 0 12px 10px;\n}\n\n/* ─── Modal overlay ─── */\n.srm-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgb(0 0 0 / 60%);\n}\n\n.srm-modal {\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  width: 900px;\n  max-width: 95vw;\n  max-height: 90vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* Header */\n.srm-modal-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-shrink: 0;\n}\n\n.srm-modal-title {\n  margin: 0;\n  font-size: 16px;\n}\n\n.srm-modal-culture {\n  font-weight: 400;\n  font-size: 13px;\n  color: var(--text-muted);\n  margin-left: 8px;\n}\n\n.srm-modal-subtitle {\n  margin: 4px 0 0;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.srm-modal-header-right {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.srm-modal-cost {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.srm-cancel-btn {\n  padding: 4px 12px;\n  font-size: 12px;\n}\n\n/* Scrollable content */\n.srm-modal-scroll {\n  flex: 1;\n  overflow: auto;\n  padding: 16px 20px;\n  min-height: 0;\n}\n\n/* Generating state */\n.srm-generating {\n  padding: 40px 12px;\n  font-size: 12px;\n  color: var(--text-muted);\n  text-align: center;\n}\n\n.srm-generating-label {\n  margin-bottom: 8px;\n}\n\n.srm-generating-detail {\n  font-size: 10px;\n}\n\n/* Error */\n.srm-error {\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border-left: 3px solid var(--danger);\n  font-size: 12px;\n  color: var(--danger);\n  margin-bottom: 8px;\n}\n\n/* Patches toolbar */\n.srm-patches-toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n}\n\n.srm-patches-count {\n  font-weight: 600;\n  font-size: 13px;\n}\n\n.srm-patches-accepted {\n  font-weight: 400;\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-left: 8px;\n}\n\n.srm-patches-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.srm-toolbar-btn {\n  padding: 2px 8px;\n  font-size: 10px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-tertiary);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n/* Empty patches */\n.srm-no-patches {\n  padding: 20px 12px;\n  font-size: 12px;\n  color: var(--text-muted);\n  text-align: center;\n}\n\n/* Footer */\n.srm-modal-footer {\n  padding: 12px 20px 16px;\n  border-top: 1px solid var(--border-color);\n  flex-shrink: 0;\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n  align-items: center;\n}\n\n.srm-footer-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","numLines":370,"startLine":1,"totalLines":370}}}
