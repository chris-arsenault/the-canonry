{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014gs8WQz9qYg5kDgRTig5UZ","type":"tool_result","content":"     1→/**\n     2→ * useEditorState - Hook for common editor state management\n     3→ *\n     4→ * Provides standard CRUD operations for list-based editors:\n     5→ * - Selection tracking (selectedIndex, selectedItem)\n     6→ * - Item update/toggle/delete/add handlers\n     7→ *\n     8→ * @example\n     9→ * const {\n    10→ *   selectedIndex, selectedItem,\n    11→ *   handleItemChange, handleToggle, handleDelete, handleAdd,\n    12→ *   handleSelect, handleClose\n    13→ * } = useEditorState(items, onChange, {\n    14→ *   createItem: () => ({ id: `item_${Date.now()}`, name: 'New Item' })\n    15→ * });\n    16→ */\n    17→\n    18→import { useState, useCallback, useEffect } from 'react';\n    19→\n    20→/** A generic record type for items managed by the editor. */\n    21→type EditorItem = Record<string, unknown>;\n    22→\n    23→export interface EditorStateOptions {\n    24→  /** Field name for item ID (default: 'id') */\n    25→  idField?: string;\n    26→  /** Field name for item name (default: 'name') */\n    27→  nameField?: string;\n    28→  /** Factory function to create new items */\n    29→  createItem?: () => EditorItem;\n    30→  /** localStorage key for persisting the selected item ID */\n    31→  persistKey?: string;\n    32→}\n    33→\n    34→export interface EditorStateResult {\n    35→  selectedIndex: number | null;\n    36→  selectedItem: EditorItem | null;\n    37→  handleItemChange: (updated: EditorItem) => void;\n    38→  handleToggle: (item: EditorItem) => void;\n    39→  handleDelete: () => void;\n    40→  handleAdd: (newItem?: EditorItem) => void;\n    41→  handleSelect: (index: number) => void;\n    42→  handleClose: () => void;\n    43→}\n    44→\n    45→function loadStored(key: string | undefined): unknown {\n    46→  if (!key) return null;\n    47→  try {\n    48→    const raw = localStorage.getItem(key);\n    49→    return raw ? JSON.parse(raw) : null;\n    50→  } catch {\n    51→    return null;\n    52→  }\n    53→}\n    54→\n    55→function saveStored(key: string | undefined, value: unknown): void {\n    56→  if (!key) return;\n    57→  try {\n    58→    localStorage.setItem(key, JSON.stringify(value));\n    59→  } catch {\n    60→    // Best-effort only.\n    61→  }\n    62→}\n    63→\n    64→function clearStored(key: string | undefined): void {\n    65→  if (!key) return;\n    66→  try {\n    67→    localStorage.removeItem(key);\n    68→  } catch {\n    69→    // Best-effort only.\n    70→  }\n    71→}\n    72→\n    73→export function useEditorState(\n    74→  items: EditorItem[],\n    75→  onChange: (items: EditorItem[]) => void,\n    76→  options: EditorStateOptions = {},\n    77→): EditorStateResult {\n    78→  const {\n    79→    idField = 'id',\n    80→    nameField = 'name',\n    81→    createItem,\n    82→    persistKey,\n    83→  } = options;\n    84→\n    85→  const [selectedId, setSelectedId] = useState<string | null>(() => {\n    86→    const stored = loadStored(persistKey);\n    87→    return typeof stored === 'string' ? stored : null;\n    88→  });\n    89→\n    90→  // Restore selectedId from storage when persistKey changes\n    91→  useEffect(() => {\n    92→    const stored = loadStored(persistKey);\n    93→    // eslint-disable-next-line react-hooks/set-state-in-effect -- restore persisted selection when key changes\n    94→    setSelectedId(typeof stored === 'string' ? stored : null);\n    95→  }, [persistKey]);\n    96→\n    97→  const resolvedIndex = selectedId ? items.findIndex((item) => item[idField] === selectedId) : -1;\n    98→  const selectedIndex = resolvedIndex >= 0 ? resolvedIndex : null;\n    99→\n   100→  // Derive selected item from index\n   101→  const selectedItem = selectedIndex !== null && selectedIndex < items.length\n   102→    ? items[selectedIndex]\n   103→    : null;\n   104→\n   105→  // Persist selectedId to storage\n   106→  useEffect(() => {\n   107→    if (!persistKey) return;\n   108→    if (selectedId) {\n   109→      saveStored(persistKey, selectedId);\n   110→    } else {\n   111→      clearStored(persistKey);\n   112→    }\n   113→  }, [persistKey, selectedId]);\n   114→\n   115→  // Clear invalid selectedId\n   116→  if (selectedId && selectedIndex === null) {\n   117→    setSelectedId(null);\n   118→  }\n   119→\n   120→  // Update the currently selected item\n   121→  const handleItemChange = useCallback((updated: EditorItem) => {\n   122→    if (selectedIndex !== null && selectedIndex < items.length) {\n   123→      const newItems = [...items];\n   124→      newItems[selectedIndex] = updated;\n   125→      onChange(newItems);\n   126→    }\n   127→  }, [items, onChange, selectedIndex]);\n   128→\n   129→  // Toggle the enabled state of an item\n   130→  const handleToggle = useCallback((item: EditorItem) => {\n   131→    const index = items.findIndex((i) => i[idField] === item[idField]);\n   132→    if (index >= 0) {\n   133→      const newItems = [...items];\n   134→      newItems[index] = { ...item, enabled: item.enabled === false ? true : false };\n   135→      onChange(newItems);\n   136→    }\n   137→  }, [items, onChange, idField]);\n   138→\n   139→  // Delete the currently selected item (with confirmation)\n   140→  const handleDelete = useCallback(() => {\n   141→    if (selectedIndex !== null && selectedItem) {\n   142→      const itemName = (selectedItem[nameField] as string) || (selectedItem[idField] as string);\n   143→      if (confirm(`Delete \"${itemName}\"?`)) {\n   144→        const newItems = [...items];\n   145→        newItems.splice(selectedIndex, 1);\n   146→        onChange(newItems);\n   147→        setSelectedId(null);\n   148→      }\n   149→    }\n   150→  }, [items, onChange, selectedIndex, selectedItem, idField, nameField]);\n   151→\n   152→  // Add a new item (using createItem factory if provided)\n   153→  const handleAdd = useCallback((newItem?: EditorItem) => {\n   154→    const itemToAdd = newItem || (createItem ? createItem() : { [idField]: `item_${Date.now()}` });\n   155→    onChange([...items, itemToAdd]);\n   156→    setSelectedId((itemToAdd[idField] as string) || null);\n   157→  }, [items, onChange, createItem, idField]);\n   158→\n   159→  // Select an item by index\n   160→  const handleSelect = useCallback((index: number) => {\n   161→    const item = items[index];\n   162→    setSelectedId(item ? (item[idField] as string) : null);\n   163→  }, [items, idField]);\n   164→\n   165→  // Close the selection (deselect)\n   166→  const handleClose = useCallback(() => {\n   167→    setSelectedId(null);\n   168→  }, []);\n   169→\n   170→  return {\n   171→    selectedIndex,\n   172→    selectedItem,\n   173→    handleItemChange,\n   174→    handleToggle,\n   175→    handleDelete,\n   176→    handleAdd,\n   177→    handleSelect,\n   178→    handleClose,\n   179→  };\n   180→}\n   181→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"5159a720-aaee-4d49-9f85-70bb7ac67c40"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01V2W4dcNPNiV8DU6RPBQp7a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Q44Zr4eHjqCpsTVCezdYPn","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/hooks/useKeyboardNavigation.ts"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":522,"cache_read_input_tokens":107192,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":522},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"18e675af-3de2-44be-bcfe-635b149ddc16"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q44Zr4eHjqCpsTVCezdYPn","type":"tool_result","content":"     1→import { useCallback, type Dispatch, type SetStateAction } from \"react\";\n     2→\n     3→/** A single Fuse.js-style search result with an `item` containing at least `id`. */\n     4→interface FuseResult {\n     5→  item: { id: string; [key: string]: unknown };\n     6→  [key: string]: unknown;\n     7→}\n     8→\n     9→export interface KeyboardNavigationOptions {\n    10→  /** The current result set (Fuse-style objects with `.item.id`). */\n    11→  results: FuseResult[];\n    12→  /** Currently highlighted index. */\n    13→  selectedIndex: number;\n    14→  /** State setter for the index. */\n    15→  setSelectedIndex: Dispatch<SetStateAction<number>>;\n    16→  /** Called with the selected item's id on Enter. */\n    17→  onSelect: (id: string) => void;\n    18→  /** Called when Escape is pressed. */\n    19→  onEscape: () => void;\n    20→}\n    21→\n    22→/**\n    23→ * Reusable keyboard navigation for search dropdowns.\n    24→ *\n    25→ * Handles ArrowDown/ArrowUp to move selection, Enter to confirm,\n    26→ * and Escape with a caller-supplied callback.\n    27→ *\n    28→ * @returns A stable onKeyDown handler (memoised via useCallback).\n    29→ */\n    30→export function useKeyboardNavigation({\n    31→  results,\n    32→  selectedIndex,\n    33→  setSelectedIndex,\n    34→  onSelect,\n    35→  onEscape,\n    36→}: KeyboardNavigationOptions): (e: React.KeyboardEvent) => void {\n    37→  return useCallback(\n    38→    (e: React.KeyboardEvent) => {\n    39→      if (results.length === 0) return;\n    40→\n    41→      switch (e.key) {\n    42→        case \"ArrowDown\":\n    43→          e.preventDefault();\n    44→          setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n    45→          break;\n    46→        case \"ArrowUp\":\n    47→          e.preventDefault();\n    48→          setSelectedIndex((i) => Math.max(i - 1, 0));\n    49→          break;\n    50→        case \"Enter\":\n    51→          e.preventDefault();\n    52→          if (results[selectedIndex]) onSelect(results[selectedIndex].item.id);\n    53→          break;\n    54→        case \"Escape\":\n    55→          onEscape();\n    56→          break;\n    57→      }\n    58→    },\n    59→    [results, selectedIndex, setSelectedIndex, onSelect, onEscape]\n    60→  );\n    61→}\n    62→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"6a90811a-66c0-465b-823d-acdf05efe3ec"}
