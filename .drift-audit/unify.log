lor-border-light);\n    65→  text-align: left;\n    66→  cursor: pointer;\n    67→  transition: background-color var(--transition-fast);\n    68→}\n    69→\n    70→.result:last-child {\n    71→  border-bottom: none;\n    72→}\n    73→\n    74→.result:hover {\n    75→  background-color: var(--color-bg-tertiary);\n    76→}\n    77→\n    78→.result-selected {\n    79→  composes: result;\n    80→  background-color: var(--color-bg-tertiary);\n    81→}\n    82→\n    83→.result-type {\n    84→  font-size: var(--font-size-xs);\n    85→  color: var(--color-text-muted);\n    86→  margin-left: var(--spacing-sm);\n    87→}\n    88→\n    89→.no-results {\n    90→  padding: var(--spacing-sm);\n    91→  font-size: var(--font-size-sm);\n    92→  color: var(--color-text-muted);\n    93→  text-align: center;\n    94→}\n    95→"}]},"parent_tool_use_id":null,"session_id":"3b5ce8f0-862b-4723-9467-f6e56df17d06","uuid":"38ccd898-5b79-48b1-90e8-581790b41a5f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/chronicler/webui/src/components/WikiSearch.module.css","content":"/**\n * WikiSearch CSS Module\n * Search input with dropdown results\n */\n\n.container {\n  position: relative;\n}\n\n.input {\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  font-family: var(--font-family-ui);\n  background-color: var(--color-bg-tertiary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-text-primary);\n  outline: none;\n  box-sizing: border-box;\n  transition: border-color var(--transition-fast);\n}\n\n.input:focus {\n  border-color: var(--color-accent);\n}\n\n.input::placeholder {\n  color: var(--color-text-muted);\n}\n\n.dropdown {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  margin-top: var(--spacing-xs);\n  background-color: var(--color-bg-secondary);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  max-height: 300px;\n  overflow: auto;\n  z-index: var(--z-dropdown);\n  box-shadow: var(--shadow-lg);\n}\n\n.dropdown-up {\n  composes: dropdown;\n  top: auto;\n  bottom: 100%;\n  margin-top: 0;\n  margin-bottom: var(--spacing-xs);\n}\n\n.result {\n  display: block;\n  width: 100%;\n  padding: var(--spacing-sm) var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  font-family: var(--font-family-ui);\n  color: var(--color-text-primary);\n  background-color: transparent;\n  border: none;\n  border-bottom: 1px solid var(--color-border-light);\n  text-align: left;\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.result:last-child {\n  border-bottom: none;\n}\n\n.result:hover {\n  background-color: var(--color-bg-tertiary);\n}\n\n.result-selected {\n  composes: result;\n  background-color: var(--color-bg-tertiary);\n}\n\n.result-type {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-muted);\n  margin-left: var(--spacing-sm);\n}\n\n.no-results {\n  padding: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  text-align: center;\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
