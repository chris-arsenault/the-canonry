================================================== */\n\n.hmn-anchor-editor {\n  padding: 6px 0;\n  border-top: 1px solid rgb(139 115 85 / 15%);\n  margin-top: 4px;\n}\n\n.hmn-anchor-editor-row {\n  display: flex;\n  gap: 4px;\n  align-items: center;\n}\n\n.hmn-anchor-input {\n  flex: 1;\n  font-size: 11px;\n  padding: 3px 6px;\n  border: 1px solid var(--border-color);\n  border-radius: 3px;\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  font-family: inherit;\n}\n\n.hmn-anchor-save-btn {\n  font-size: 10px;\n  padding: 2px 8px;\n  border: 1px solid var(--border-color);\n  border-radius: 3px;\n  background: transparent;\n  color: var(--text-muted);\n  cursor: default;\n  opacity: 0.5;\n}\n\n.hmn-anchor-save-btn-resolved {\n  background: #8b7355;\n  color: #fff;\n  cursor: pointer;\n  opacity: 1;\n}\n\n.hmn-anchor-cancel-btn {\n  font-size: 10px;\n  padding: 2px 8px;\n  border: 1px solid var(--border-color);\n  border-radius: 3px;\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.hmn-anchor-status {\n  font-size: 10px;\n  margin-top: 3px;\n}\n\n.hmn-anchor-status-resolved {\n  color: #5b7a5e;\n}\n\n.hmn-anchor-status-unresolved {\n  color: #c0392b;\n}\n\n/* ============================================================================\n   NoteItem\n   ============================================================================ */\n\n.hmn-note-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  padding: 6px 10px;\n  background: rgb(139 115 85 / 8%);\n  border-radius: 0 4px 4px 0;\n  margin-bottom: 4px;\n  transition: opacity 0.15s;\n  border-left: 3px solid var(--hmn-note-color);\n}\n\n.hmn-note-item-disabled {\n  background: rgb(139 115 85 / 3%);\n  opacity: 0.5;\n  border-left-color: var(--border-color);\n}\n\n.hmn-display-toggle {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 13px;\n  padding: 0;\n  line-height: 1;\n  flex-shrink: 0;\n  margin-top: 2px;\n  color: var(--hmn-note-color);\n}\n\n.hmn-display-toggle-disabled {\n  color: #8b735560;\n}\n\n.hmn-note-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.hmn-note-header {\n  display: flex;\n  align-items: baseline;\n  gap: 6px;\n  margin-bottom: 2px;\n}\n\n.hmn-type-label {\n  font-size: 9px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  flex-shrink: 0;\n  color: var(--hmn-note-color);\n}\n\n.hmn-type-label-disabled {\n  opacity: 0.6;\n}\n\n.hmn-display-label {\n  font-size: 9px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n}\n\n.hmn-anchor-text {\n  font-size: 10px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  flex: 1;\n}\n\n.hmn-anchor-text-missing {\n  color: #ef4444;\n}\n\n.hmn-anchor-text-normal {\n  color: var(--text-muted);\n}\n\n.hmn-anchor-text-editable {\n  cursor: pointer;\n}\n\n.hmn-anchor-text-readonly {\n  cursor: default;\n}\n\n.hmn-anchor-warning {\n  font-size: 11px;\n  color: #ef4444;\n  margin-top: 4px;\n}\n\n.hmn-note-text {\n  font-size: 12px;\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-style: italic;\n  line-height: 1.5;\n  cursor: pointer;\n}\n\n.hmn-note-text-disabled {\n  color: var(--text-muted);\n}\n\n.hmn-note-text-active {\n  color: var(--text-secondary);\n}\n\n/* ============================================================================\n   Main Component\n   ============================================================================ */\n\n.hmn-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 6px;\n}\n\n.hmn-title {\n  font-size: 11px;\n  font-weight: 600;\n  color: #8b7355;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.hmn-summary {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n","numLines":209,"startLine":1,"totalLines":209}}}
