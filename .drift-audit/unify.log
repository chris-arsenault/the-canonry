{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vx1tzMJmuuRdJrqPFM3TgU","type":"tool_result","content":"     1→/**\n     2→ * useBackportFlow - Hook for chronicle lore backport workflows\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Contains:\n     5→ * - assembleContextForChronicle: build full context for a chronicle backport\n     6→ * - backportConfig: modal state for backport entity selection\n     7→ * - handleBackportLore: single-chronicle backport entry point\n     8→ * - handleBackportConfigStart: start backport with selected entities\n     9→ * - handleAcceptBackport: accept and apply backport patches\n    10→ * - handleMarkEntityNotNeeded: mark entities as not needing backport\n    11→ * - Bulk backport state and handlers (delegates to useBulkBackport)\n    12→ */\n    13→\n    14→import type { Dispatch, MutableRefObject, SetStateAction } from \"react\";\n    15→import { useState, useCallback, useMemo, useRef, useEffect } from \"react\";\n    16→import { useChronicleLoreBackport } from \"./useChronicleLoreBackport\";\n    17→import type { ChronicleLoreBackportConfig } from \"./useChronicleLoreBackport\";\n    18→import { useBulkBackport } from \"./useBulkBackport\";\n    19→import type { BackportContext, BulkBackportProgress } from \"./useBulkBackport\";\n    20→import type { SummaryRevisionRun, SummaryRevisionPatch, RevisionEntityContext } from \"../lib/summaryRevisionTypes\";\n    21→import type { ChronicleRecord, EntityBackportEntry } from \"../lib/chronicleTypes\";\n    22→import * as entityRepo from \"../lib/db/entityRepository\";\n    23→import { useEntityStore } from \"../lib/db/entityStore\";\n    24→import {\n    25→  getChronicle,\n    26→  getChroniclesForSimulation,\n    27→  updateChronicleEntityBackportStatus,\n    28→} from \"../lib/db/chronicleRepository\";\n    29→import { computeBackportProgress } from \"../lib/chronicleTypes\";\n    30→\n    31→// ============================================================================\n    32→// Types\n    33→// ============================================================================\n    34→\n    35→/** Entity context extended with cast role flags */\n    36→interface CastContext extends RevisionEntityContext {\n    37→  isPrimary?: boolean;\n    38→  isLens?: boolean;\n    39→  isTertiary?: boolean;\n    40→  chronicleName?: string;\n    41→}\n    42→\n    43→/** Assembled context for a chronicle's backport config modal */\n    44→export interface BackportConfigContext {\n    45→  chronicleId: string;\n    46→  chronicleTitle: string;\n    47→  entities: CastContext[];\n    48→  chronicleText: string;\n    49→  perspectiveSynthesisJson: string;\n    50→  perEntityStatus: Record<string, string>;\n    51→}\n    52→\n    53→type GetEntityContextsForRevision = (entityIds: string[]) => Promise<RevisionEntityContext[]>;\n    54→type ReloadEntities = (entityIds: string[]) => Promise<void>;\n    55→type SetChronicleRefreshTrigger = Dispatch<SetStateAction<number>>;\n    56→\n    57→export interface UseBackportFlowProps {\n    58→  projectId: string | null;\n    59→  simulationRunId: string | null;\n    60→  getEntityContextsForRevision: GetEntityContextsForRevision;\n    61→  reloadEntities: ReloadEntities;\n    62→  setChronicleRefreshTrigger: SetChronicleRefreshTrigger;\n    63→}\n    64→\n    65→export interface UseBackportFlowReturn {\n    66→  backportRun: SummaryRevisionRun | null;\n    67→  isBackportActive: boolean;\n    68→  backportChronicleId: string | null;\n    69→  toggleBackportPatchDecision: (entityId: string, accepted: boolean) => Promise<void>;\n    70→  updateBackportAnchorPhrase: (entityId: string, anchorPhrase: string) => Promise<void>;\n    71→  cancelBackport: () => void;\n    72→  backportConfig: BackportConfigContext | null;\n    73→  setBackportConfig: Dispatch<SetStateAction<BackportConfigContext | null>>;\n    74→  handleBackportLore: (chronicleId: string) => Promise<void>;\n    75→  handleBackportConfigStart: (selectedEntityIds: string[], customInstructions?: string) => void;\n    76→  handleAcceptBackport: () => Promise<void>;\n    77→  handleMarkEntityNotNeeded: (entityIds: string[]) => Promise<void>;\n    78→  bulkBackportProgress: BulkBackportProgress;\n    79→  isBulkBackportActive: boolean;\n    80→  showBulkBackportModal: boolean;\n    81→  handleStartBulkBackport: () => Promise<void>;\n    82→  handleConfirmBulkBackport: () => void;\n    83→  handleCancelBulkBackport: () => void;\n    84→  handleCloseBulkBackport: () => void;\n    85→  assembleContextForChronicle: (chronicleId: string) => Promise<BackportConfigContext | null>;\n    86→}\n    87→\n    88→// --- Module-level helpers ---\n    89→\n    90→async function buildCastContexts(\n    91→  chronicle: ChronicleRecord,\n    92→  getEntityContextsForRevision: GetEntityContextsForRevision\n    93→): Promise<CastContext[] | null> {\n    94→  const roleAssignments = chronicle.roleAssignments || [];\n    95→  const castEntityIds = roleAssignments.map((r) => r.entityId);\n    96→  const baseContexts = await getEntityContextsForRevision(castEntityIds);\n    97→  if (baseContexts.length === 0) return null;\n    98→\n    99→  const primarySet = new Set(roleAssignments.filter((r) => r.isPrimary).map((r) => r.entityId));\n   100→  const castContexts: CastContext[] = baseContexts.map((ctx) => ({"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"fe0756be-2277-4cf0-abca-daa627a61c35"}
