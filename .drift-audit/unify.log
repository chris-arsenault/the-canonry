{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XRYfp67EUZCAya3PYe1G2m","type":"tool_result","content":"     1→/**\n     2→ * useHistorianCallbacks - Historian annotation, edition, and bulk workflows.\n     3→ * Calls useHistorianEdition, useHistorianReview, and useBulkHistorian internally.\n     4→ */\n     5→\n     6→import { useState, useCallback, useMemo, useRef, useEffect } from \"react\";\n     7→import { useHistorianEdition } from \"./useHistorianEdition\";\n     8→import { useHistorianReview } from \"./useHistorianReview\";\n     9→import { useBulkHistorian } from \"./useBulkHistorian\";\n    10→import { registerHistorianStarters } from \"./useHistorianActions\";\n    11→import { getCallConfig as getLLMCallConfig } from \"../lib/llmModelSettings\";\n    12→import * as entityRepo from \"../lib/db/entityRepository\";\n    13→import { useEntityStore } from \"../lib/db/entityStore\";\n    14→import { useChronicleStore } from \"../lib/db/chronicleStore\";\n    15→import { useIlluminatorConfigStore } from \"../lib/db/illuminatorConfigStore\";\n    16→import {\n    17→  getChronicle,\n    18→  updateChronicleHistorianNotes,\n    19→  computeCorpusFactStrength,\n    20→} from \"../lib/db/chronicleRepository\";\n    21→import { extractReinforcedFactIds } from \"../lib/db/historianRunHelpers\";\n    22→import { isHistorianConfigured } from \"../lib/historianTypes\";\n    23→import {\n    24→  buildHistorianEditionContext,\n    25→  buildHistorianReviewContext,\n    26→  collectPreviousNotes,\n    27→  buildFactCoverageGuidance,\n    28→} from \"../lib/historianContextBuilders\";\n    29→import { updateHistorianRun as updateHistorianRunRecord } from \"../lib/db/historianRepository\";\n    30→\n    31→// --- Module-level helpers ---\n    32→\n    33→function buildCastData(chronicle, castMap) {\n    34→  const castSummaries = (chronicle.roleAssignments || [])\n    35→    .slice(0, 10)\n    36→    .map((ra) => {\n    37→      const entity = castMap.get(ra.entityId);\n    38→      if (!entity) return null;\n    39→      return {\n    40→        name: entity.name,\n    41→        kind: entity.kind,\n    42→        summary: entity.summary || entity.description?.slice(0, 200) || \"\",\n    43→      };\n    44→    })\n    45→    .filter(Boolean);\n    46→\n    47→  const cast = (chronicle.roleAssignments || []).map((ra) => {\n    48→    const entity = castMap.get(ra.entityId);\n    49→    return {\n    50→      entityName: entity?.name || ra.entityId,\n    51→      role: ra.role,\n    52→      kind: entity?.kind || \"unknown\",\n    53→    };\n    54→  });\n    55→\n    56→  return { castSummaries, cast };\n    57→}\n    58→\n    59→async function resolveFactCoverageGuidance(\n    60→  chronicle,\n    61→  worldContext,\n    62→  simulationRunId,\n    63→  corpusStrengthCacheRef\n    64→) {\n    65→  if (!chronicle.factCoverageReport?.entries?.length) return undefined;\n    66→\n    67→  if (corpusStrengthCacheRef.current.runId !== simulationRunId) {\n    68→    corpusStrengthCacheRef.current = {\n    69→      runId: simulationRunId,\n    70→      strength: await computeCorpusFactStrength(simulationRunId),\n    71→    };\n    72→  }\n    73→\n    74→  const constraintFactIds = new Set(\n    75→    (worldContext.canonFactsWithMetadata || [])\n    76→      .filter((f) => f.type === \"generation_constraint\" || f.disabled)\n    77→      .map((f) => f.id)\n    78→  );\n    79→\n    80→  return buildFactCoverageGuidance(\n    81→    chronicle.factCoverageReport,\n    82→    corpusStrengthCacheRef.current.strength,\n    83→    constraintFactIds\n    84→  );\n    85→}\n    86→\n    87→function buildChronicleContextJson(\n    88→  chronicle,\n    89→  castSummaries,\n    90→  cast,\n    91→  worldContext,\n    92→  factCoverageGuidance\n    93→) {\n    94→  return JSON.stringify({\n    95→    chronicleId: chronicle.chronicleId,\n    96→    title: chronicle.title || \"Untitled\",\n    97→    format: chronicle.format,\n    98→    narrativeStyleId: chronicle.narrativeStyleId || \"\",\n    99→    cast,\n   100→    castSummaries,\n   101→    canonFacts: (worldContext.canonFactsWithMetadata || []).map((f) => f.text),\n   102→    worldDynamics: (worldContext.worldDynamics || []).map((d) => d.text),\n   103→    factCoverageGuidance,\n   104→    temporalNarrative: chronicle.perspectiveSynthesis?.temporalNarrative || undefined,\n   105→    focalEra: chronicle.temporalContext?.focalEra\n   106→      ? {\n   107→          name: chronicle.temporalContext.focalEra.name,\n   108→          description: chronicle.temporalContext.focalEra.description,\n   109→        }\n   110→      : undefined,\n   111→    temporalCheckReport: chronicle.temporalCheckReport || undefined,\n   112→  });\n   113→}\n   114→\n   115→async function acceptEntityNotes(targetId, notes, reloadEntities) {\n   116→  await entityRepo.setHistorianNotes(targetId, notes);\n   117→  await reloadEntities([targetId]);\n   118→}\n   119→\n   120→async function acceptChronicleNotes(targetId, notes, historianRun) {\n   121→  try {\n   122→    const prompts =\n   123→      historianRun.systemPrompt && historianRun.userPrompt\n   124→        ? { systemPrompt: historianRun.systemPrompt, userPrompt: historianRun.userPrompt }\n   125→        : undefined;\n   126→    const reinforcedFacts = historianRun.contextJson\n   127→      ? extractReinforcedFactIds(historianRun.contextJson)\n   128→      : undefined;\n   129→    await updateChronicleHistorianNotes(targetId, notes, prompts, reinforcedFacts);\n   130→    await useChronicleStore.getState().refreshChronicle(targetId);\n   131→  } catch (err) {\n   132→    console.error(\"[Historian] Failed to save chronicle notes:\", err);\n   133→  }\n   134→}\n   135→\n   136→async function updateEntityNote(targetId, noteId, updates, reloadEntities) {\n   137→  const entity = await useEntityStore.getState().loadEntity(targetId);\n   138→  if (!entity?.enrichment?.historianNotes) return;\n   139→  const updatedNotes = entity.enrichment.historianNotes.map((n) =>\n   140→    n.noteId === noteId ? { ...n, ...updates } : n\n   141→  );\n   142→  await entityRepo.setHistorianNotes(targetId, updatedNotes);\n   143→  await reloadEntities([targetId]);\n   144→}\n   145→\n   146→async function updateChronicleNote(targetId, noteId, updates) {\n   147→  try {\n   148→    const chronicle = await getChronicle(targetId);\n   149→    if (!chronicle?.historianNotes) return;\n   150→    const updatedNotes = chronicle.historianNotes.map((n) =>\n   151→      n.noteId === noteId ? { ...n, ...updates } : n\n   152→    );\n   153→    await updateChronicleHistorianNotes(targetId, updatedNotes);\n   154→    await useChronicleStore.getState().refreshChronicle(targetId);\n   155→  } catch (err) {\n   156→    console.error(\"[Historian] Failed to update note:\", err);\n   157→  }\n   158→}\n   159→\n   160→function validateChronicleForReview(projectId, simulationRunId, chronicleId, historianConfig) {\n   161→  if (!projectId || !simulationRunId || !chronicleId) return false;\n   162→  return isHistorianConfigured(historianConfig);\n   163→}\n   164→\n   165→function getCastEntityIds(chronicle) {\n   166→  return (chronicle.roleAssignments || []).map((ra) => ra.entityId).filter(Boolean);\n   167→}\n   168→\n   169→function buildChronicleReviewPayload(\n   170→  chronicle,\n   171→  chronicleId,\n   172→  tone,\n   173→  projectId,\n   174→  simulationRunId,\n   175→  contextJson,\n   176→  previousNotesJson,\n   177→  historianConfig\n   178→) {\n   179→  return {\n   180→    projectId,\n   181→    simulationRunId,\n   182→    targetType: \"chronicle\",\n   183→    targetId: chronicleId,\n   184→    targetName: chronicle.title || \"Untitled Chronicle\",\n   185→    sourceText: chronicle.finalContent,\n   186→    contextJson,\n   187→    previousNotesJson,\n   188→    historianConfig,\n   189→    tone: tone || chronicle.assignedTone || \"weary\",\n   190→  };\n   191→}\n   192→\n   193→async function runChronicleHistorianReview({\n   194→  projectId,\n   195→  simulationRunId,\n   196→  chronicleId,\n   197→  tone,\n   198→  worldContext,\n   199→  historianConfig,\n   200→  corpusStrengthCacheRef,\n   201→  startHistorianReview,\n   202→}) {\n   203→  if (!validateChronicleForReview(projectId, simulationRunId, chronicleId, historianConfig)) return;\n   204→  const chronicle = await getChronicle(chronicleId);\n   205→  if (!chronicle?.finalContent || chronicle.status !== \"complete\") return;\n   206→\n   207→  const castEntityIds = getCastEntityIds(chronicle);\n   208→  const castFull = await useEntityStore.getState().loadEntities(castEntityIds);\n   209→  const castMap = new Map(castFull.map((e) => [e.id, e]));\n   210→  const { castSummaries, cast } = buildCastData(chronicle, castMap);\n   211→  const factCoverageGuidance = await resolveFactCoverageGuidance(\n   212→    chronicle,\n   213→    worldContext,\n   214→    simulationRunId,\n   215→    corpusStrengthCacheRef\n   216→  );\n   217→  const contextJson = buildChronicleContextJson(\n   218→    chronicle,\n   219→    castSummaries,\n   220→    cast,\n   221→    worldContext,\n   222→    factCoverageGuidance\n   223→  );\n   224→  const previousNotes = await collectPreviousNotes({ relatedEntityIds: castEntityIds });\n   225→\n   226→  startHistorianReview(\n   227→    buildChronicleReviewPayload(\n   228→      chronicle,\n   229→      chronicleId,\n   230→      tone,\n   231→      projectId,\n   232→      simulationRunId,\n   233→      contextJson,\n   234→      JSON.stringify(previousNotes),\n   235→      historianConfig\n   236→    )\n   237→  );\n   238→}\n   239→\n   240→async function runAcceptHistorianEdition(applyAcceptedPatches, reloadEntities) {\n   241→  const patches = applyAcceptedPatches();\n   242→  if (!patches?.length) return;\n   243→\n   244→  const updatedIds = await entityRepo.applyRevisionPatches(patches, \"historian-edition\");\n   245→  for (const patch of patches) {\n   246→    if (patch.entityId) {\n   247→      await entityRepo.setHistorianNotes(patch.entityId, []);\n   248→    }\n   249→  }\n   250→  await reloadEntities(updatedIds);\n   251→}\n   252→\n   253→async function runAcceptHistorianNotes(historianRun, applyAcceptedNotes, reloadEntities) {\n   254→  const targetId = historianRun?.targetId;\n   255→  const targetType = historianRun?.targetType;\n   256→  const notes = applyAcceptedNotes();\n   257→  if (notes.length === 0) return;\n   258→\n   259→  if (targetType === \"entity\" && targetId) {\n   260→    await acceptEntityNotes(targetId, notes, reloadEntities);\n   261→  } else if (targetType === \"chronicle\" && targetId) {\n   262→    await acceptChronicleNotes(targetId, notes, historianRun);\n   263→  }\n   264→}\n   265→\n   266→function runEditHistorianNoteText(historianRun, noteId, newText) {\n   267→  if (!historianRun) return;\n   268→  const updatedNotes = historianRun.notes.map((n) =>\n   269→    n.noteId === noteId ? { ...n, text: newText } : n\n   270→  );\n   271→  updateHistorianRunRecord(historianRun.runId, { notes: updatedNotes });\n   272→}\n   273→\n   274→async function applyReviewNotesForEntity(entityId, notes) {\n   275→  await entityRepo.setHistorianNotes(entityId, notes);\n   276→}\n   277→\n   278→async function applyEditionPatchesForEntity(patches) {\n   279→  const updatedIds = await entityRepo.applyRevisionPatches(patches, \"historian-edition\");\n   280→  for (const patch of patches) {\n   281→    if (patch.entityId) {\n   282→      await entityRepo.setHistorianNotes(patch.entityId, []);\n   283→    }\n   284→  }\n   285→  return updatedIds;\n   286→}\n   287→\n   288→async function runUpdateHistorianNote(targetType, targetId, noteId, updates, reloadEntities) {\n   289→  if (targetType === \"entity\" && targetId) {\n   290→    await updateEntityNote(targetId, noteId, updates, reloadEntities);\n   291→  } else if (targetType === \"chronicle\" && targetId) {\n   292→    await updateChronicleNote(targetId, noteId, updates);\n   293→  }\n   294→}\n   295→\n   296→// --- Bulk historian helper hook ---\n   297→\n   298→function useBulkHistorianSetup({\n   299→  applyReviewNotesForEntity,\n   300→  applyEditionPatchesForEntity,\n   301→  reloadEntities,\n   302→  entityNavMap,\n   303→}) {\n   304→  const bulkHistorianDeps = useMemo(\n   305→    () => ({\n   306→      buildReviewContext: buildHistorianReviewContext,\n   307→      buildEditionContext: buildHistorianEditionContext,\n   308→      applyReviewNotes: applyReviewNotesForEntity,\n   309→      applyEditionPatches: applyEditionPatchesForEntity,\n   310→      reloadEntities,\n   311→      getEntityNav: (entityId) => entityNavMap.get(entityId),\n   312→    }),\n   313→    [applyReviewNotesForEntity, applyEditionPatchesForEntity, reloadEntities, entityNavMap]\n   314→  );\n   315→\n   316→  const {\n   317→    progress: bulkHistorianProgress,\n   318→    isActive: isBulkHistorianActive,\n   319→    prepareBulkHistorian,\n   320→    confirmBulkHistorian,\n   321→    cancelBulkHistorian,\n   322→    setTone: setBulkHistorianTone,\n   323→  } = useBulkHistorian(bulkHistorianDeps);\n   324→\n   325→  const [showBulkHistorianModal, setShowBulkHistorianModal] = useState(false);\n   326→  const editionMaxTokens = useMemo(() => getLLMCallConfig(\"historian.edition\").maxTokens, []);\n   327→\n   328→  const handleStartBulkHistorianReview = useCallback(\n   329→    (eligibleEntityIds) => {\n   330→      prepareBulkHistorian(\"review\", \"scholarly\", eligibleEntityIds);\n   331→      setShowBulkHistorianModal(true);\n   332→    },\n   333→    [prepareBulkHistorian]\n   334→  );\n   335→\n   336→  const handleStartBulkHistorianEdition = useCallback(\n   337→    (eligibleEntityIds, reEdition) => {\n   338→      prepareBulkHistorian(\"edition\", \"scholarly\", eligibleEntityIds, reEdition);\n   339→      setShowBulkHistorianModal(true);\n   340→    },\n   341→    [prepareBulkHistorian]\n   342→  );\n   343→\n   344→  const handleStartBulkHistorianClear = useCallback(\n   345→    (eligibleEntityIds) => {\n   346→      prepareBulkHistorian(\"clear\", \"scholarly\", eligibleEntityIds);\n   347→      setShowBulkHistorianModal(true);\n   348→    },\n   349→    [prepareBulkHistorian]\n   350→  );\n   351→\n   352→  const handleCancelBulkHistorian = useCallback(() => {\n   353→    cancelBulkHistorian();\n   354→    setShowBulkHistorianModal(false);\n   355→  }, [cancelBulkHistorian]);\n   356→\n   357→  const handleCloseBulkHistorian = useCallback(() => {\n   358→    setShowBulkHistorianModal(false);\n   359→  }, []);\n   360→\n   361→  // Close modal if prepare found no eligible entities\n   362→  useEffect(() => {\n   363→    if (showBulkHistorianModal && bulkHistorianProgress.status === \"idle\") {\n   364→      const timer = setTimeout(() => {\n   365→        if (bulkHistorianProgress.status === \"idle\") {\n   366→          setShowBulkHistorianModal(false);\n   367→        }\n   368→      }, 500);\n   369→      return () => clearTimeout(timer);\n   370→    }\n   371→  }, [showBulkHistorianModal, bulkHistorianProgress.status]);\n   372→\n   373→  return {\n   374→    bulkHistorianProgress,\n   375→    isBulkHistorianActive,\n   376→    showBulkHistorianModal,\n   377→    editionMaxTokens,\n   378→    setBulkHistorianTone,\n   379→    handleStartBulkHistorianReview,\n   380→    handleStartBulkHistorianEdition,\n   381→    handleStartBulkHistorianClear,\n   382→    handleConfirmBulkHistorian: confirmBulkHistorian,\n   383→    handleCancelBulkHistorian,\n   384→    handleCloseBulkHistorian,\n   385→  };\n   386→}\n   387→\n   388→// --- Main hook ---\n   389→\n   390→export function useHistorianCallbacks({\n   391→  projectId,\n   392→  simulationRunId,\n   393→  worldContext,\n   394→  historianConfig,\n   395→  reloadEntities,\n   396→  entityNavMap,\n   397→}) {\n   398→  const {\n   399→    run: historianEditionRun,\n   400→    isActive: isHistorianEditionActive,\n   401→    startHistorianEdition,\n   402→    togglePatchDecision: toggleHistorianEditionPatchDecision,\n   403→    applyAccepted: applyAcceptedHistorianEditionPatches,\n   404→    cancelHistorianEdition,\n   405→  } = useHistorianEdition();\n   406→  const {\n   407→    run: historianRun,\n   408→    isActive: isHistorianActive,\n   409→    startReview: startHistorianReview,\n   410→    toggleNoteDecision: toggleHistorianNoteDecision,\n   411→    applyAccepted: applyAcceptedHistorianNotes,\n   412→    cancelReview: cancelHistorianReview,\n   413→  } = useHistorianReview();\n   414→\n   415→  registerHistorianStarters({ startHistorianEdition, startHistorianReview });\n   416→  useEffect(() => {\n   417→    useIlluminatorConfigStore.getState().setConfig({ isHistorianEditionActive, isHistorianActive });\n   418→  }, [isHistorianEditionActive, isHistorianActive]);\n   419→\n   420→  const handleAcceptHistorianEdition = useCallback(\n   421→    () => runAcceptHistorianEdition(applyAcceptedHistorianEditionPatches, reloadEntities),\n   422→    [applyAcceptedHistorianEditionPatches, reloadEntities]\n   423→  );\n   424→\n   425→  const corpusStrengthCacheRef = useRef({ runId: null, strength: null });\n   426→  const handleChronicleHistorianReview = useCallback(\n   427→    (chronicleId, tone) =>\n   428→      runChronicleHistorianReview({\n   429→        projectId,\n   430→        simulationRunId,\n   431→        chronicleId,\n   432→        tone,\n   433→        worldContext,\n   434→        historianConfig,\n   435→        corpusStrengthCacheRef,\n   436→        startHistorianReview,\n   437→      }),\n   438→    [projectId, simulationRunId, worldContext, historianConfig, startHistorianReview]\n   439→  );\n   440→\n   441→  const {\n   442→    bulkHistorianProgress,\n   443→    isBulkHistorianActive,\n   444→    showBulkHistorianModal,\n   445→    editionMaxTokens,\n   446→    setBulkHistorianTone,\n   447→    handleStartBulkHistorianReview,\n   448→    handleStartBulkHistorianEdition,\n   449→    handleStartBulkHistorianClear,\n   450→    handleConfirmBulkHistorian,\n   451→    handleCancelBulkHistorian,\n   452→    handleCloseBulkHistorian,\n   453→  } = useBulkHistorianSetup({\n   454→    applyReviewNotesForEntity,\n   455→    applyEditionPatchesForEntity,\n   456→    reloadEntities,\n   457→    entityNavMap,\n   458→  });\n   459→\n   460→  const handleAcceptHistorianNotes = useCallback(\n   461→    () => runAcceptHistorianNotes(historianRun, applyAcceptedHistorianNotes, reloadEntities),\n   462→    [applyAcceptedHistorianNotes, historianRun, reloadEntities]\n   463→  );\n   464→  const handleUpdateHistorianNote = useCallback(\n   465→    (targetType, targetId, noteId, updates) =>\n   466→      runUpdateHistorianNote(targetType, targetId, noteId, updates, reloadEntities),\n   467→    [reloadEntities]\n   468→  );\n   469→  const handleEditHistorianNoteText = useCallback(\n   470→    (noteId, newText) => runEditHistorianNoteText(historianRun, noteId, newText),\n   471→    [historianRun]\n   472→  );\n   473→\n   474→  return {\n   475→    historianEditionRun,\n   476→    isHistorianEditionActive,\n   477→    startHistorianEdition,\n   478→    toggleHistorianEditionPatchDecision,\n   479→    handleAcceptHistorianEdition,\n   480→    cancelHistorianEdition,\n   481→    historianRun,\n   482→    isHistorianActive,\n   483→    startHistorianReview,\n   484→    toggleHistorianNoteDecision,\n   485→    cancelHistorianReview,\n   486→    handleAcceptHistorianNotes,\n   487→    handleUpdateHistorianNote,\n   488→    handleEditHistorianNoteText,\n   489→    handleChronicleHistorianReview,\n   490→    bulkHistorianProgress,\n   491→    isBulkHistorianActive,\n   492→    showBulkHistorianModal,\n   493→    editionMaxTokens,\n   494→    setBulkHistorianTone,\n   495→    handleStartBulkHistorianReview,\n   496→    handleStartBulkHistorianEdition,\n   497→    handleStartBulkHistorianClear,\n   498→    handleConfirmBulkHistorian,\n   499→    handleCancelBulkHistorian,\n   500→    handleCloseBulkHistorian,\n   501→  };\n   502→}\n   503→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"a1b7b7f4-0f71-4e00-b5a8-7e13b3f6139e"}
