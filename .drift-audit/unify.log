#f59e0b;\n}\n\n.benm-progress-counts {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Current era detail */\n.benm-current-era {\n  padding: 12px;\n  border-radius: 8px;\n  background: var(--bg-secondary);\n  margin-bottom: 12px;\n}\n\n.benm-current-era-name {\n  font-size: 12px;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.benm-current-era-tone {\n  color: #8b7355;\n  font-size: 13px;\n}\n\n/* Step rows */\n.benm-steps {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.benm-step-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n}\n\n.benm-step-icon {\n  width: 12px;\n  text-align: center;\n  font-weight: 600;\n  font-size: 10px;\n  color: var(--benm-step-color);\n}\n\n.benm-step-label {\n  width: 52px;\n}\n\n.benm-step-label-active {\n  color: var(--text-secondary);\n  font-weight: 600;\n}\n\n.benm-step-label-pending {\n  color: var(--text-muted);\n  font-weight: 400;\n}\n\n.benm-step-active-content {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n/* Mini progress bar in step */\n.benm-step-bar-track {\n  flex: 1;\n  height: 4px;\n  border-radius: 2px;\n  background: var(--bg-primary);\n  overflow: hidden;\n}\n\n.benm-step-bar-fill {\n  height: 100%;\n  border-radius: 2px;\n  background: #f59e0b;\n  transition: width 0.2s ease;\n  width: var(--benm-bar-width);\n}\n\n/* Live counters */\n.benm-step-counters {\n  color: var(--text-muted);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n\n.benm-counter-thinking-label {\n  color: var(--text-muted);\n  opacity: 0.6;\n}\n\n.benm-counter-separator {\n  margin: 0 6px;\n  opacity: 0.3;\n}\n\n.benm-counter-output-label {\n  color: #f59e0b;\n  opacity: 0.8;\n}\n\n.benm-step-done {\n  flex: 1;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* Terminal state messages */\n.benm-terminal-msg {\n  padding: 12px;\n  border-radius: 8px;\n  margin-bottom: 16px;\n  font-size: 12px;\n}\n\n.benm-terminal-msg-complete {\n  background: rgb(16 185 129 / 10%);\n  border: 1px solid rgb(16 185 129 / 20%);\n}\n\n.benm-terminal-msg-cancelled {\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 20%);\n}\n\n.benm-terminal-msg-failed {\n  background: rgb(239 68 68 / 10%);\n  border: 1px solid rgb(239 68 68 / 20%);\n}\n\n/* Cost + words */\n.benm-stats {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-align: right;\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n}\n\n/* Footer */\n.benm-footer {\n  padding: 12px 20px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.benm-footer-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":88,"newStart":1,"newLines":6,"lines":["-/* BulkEraNarrativeModal — bulk era narrative pipeline progress */","+/* BulkEraNarrativeModal — content-specific styles (prefix: benm-)","+ * Overlay, header, footer, terminal, and cost styles are in BulkOperationShell.css */"," ","-/* Overlay backdrop */","-.benm-overlay {","-  position: fixed;","-  inset: 0;","-  background: rgb(0 0 0 / 50%);","-  display: flex;","-  align-items: center;","-  justify-content: center;","-  z-index: 10000;","-}","-","-/* Modal container */","-.benm-modal {","-  background: var(--bg-primary);","-  border-radius: 12px;","-  border: 1px solid var(--border-color);","-  max-width: 95vw;","-  max-height: 85vh;","-  display: flex;","-  flex-direction: column;","-  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);","-  width: var(--benm-modal-width);","-}","-","-/* Header */","-.benm-header {","-  padding: 16px 20px;","-  border-bottom: 1px solid var(--border-color);","-  flex-shrink: 0;","-}","-","-.benm-header-row {","-  display: flex;","-  justify-content: space-between;","-  align-items: center;","-}","-","-.benm-title {","-  margin: 0;","-  font-size: 16px;","-}","-","-.benm