ipKindRef(usageMap, config.contagion.relationshipKind, 'systems', sysRef, {\n   798→      type: 'system', id: sysId, field: 'contagion.relationshipKind', location,\n   799→    });\n   800→  }\n   801→  if (config.contagion?.type === 'tag' && config.contagion.tagPattern) {\n   802→    recordTagRef(usageMap, config.contagion.tagPattern, 'systems', sysRef);\n   803→  }\n   804→  (config.vectors || []).forEach((vector, idx) => {\n   805→    recordRelationshipKindRef(usageMap, vector.relationshipKind, 'systems', sysRef, {\n   806→      type: 'system', id: sysId, field: `vectors[${idx}].relationshipKind`, location,\n   807→    });\n   808→  });\n   809→  scanMutations(config.infectionAction ? [config.infectionAction] : [], usageMap, pressureIds, 'systems', sysRef, {\n   810→    type: 'system', id: sysId, field: 'infectionAction', location,\n   811→  });\n   812→  (config.phaseTransitions || []).forEach((transition, idx) => {\n   813→    scanSelectionRule(transition.selection, usageMap, 'systems', sysRef, {\n   814→      type: 'system', id: sysId, field: `phaseTransitions[${idx}].selection`, location,\n   815→    });\n   816→    if (transition.toStatus) recordStatusRef(usageMap, transition.toStatus, 'systems', sysRef);\n   817→  });\n   818→  if (config.multiSource?.sourceSelection) {\n   819→    scanSelectionRule(config.multiSource.sourceSelection, usageMap, 'systems', sysRef, {\n   820→      type: 'system', id: sysId, field: 'multiSource.sourceSelection', location,\n   821→    });\n   822→  }\n   823→  if (config.multiSource?.immunityTagPrefix) {\n   824→    recordTagRef(usageMap, config.multiSource.immunityTagPrefix, 'systems', sysRef);\n   825→  }\n   826→}\n   827→\n   828→function scanEvolutionSystem(config, usageMap, pressureIds, sysRef, sysId, location) {\n   829→  (config.subtypeBonuses || []).forEach((bonus) => recordSubtypeRef(usageMap, bonus.subtype, 'systems', sysRef));\n   830→  scanMetric(config.metric, usageMap, 'systems', sysRef, {\n   831→    type: 'system', id: sysId, field: 'metric', location,\n   832→  });\n   833→  (config.rules || []).forEach((rule, idx) => {\n   834→    scanMutations(rule?.action ? [rule.action] : [], usageMap, pressureIds, 'systems', sysRef, {\n   835→      type: 'system', id: sysId, field: `rules[${idx}].action`, location,\n   836→    });\n   837→  });\n   838→}\n   839→\n   840→function scanThresholdSystem(config, usageMap, pressureIds, sysRef, sysId, location) {\n   841→  (config.conditions || []).forEach((cond, idx) => {\n   842→    scanCondition(cond, usageMap, pressureIds, 'systems', sysRef, {\n   843→      type: 'system', id: sysId, field: `conditions[${idx}]`, location,\n   844→    });\n   845→  });\n   846→  scanMutations(config.actions || [], usageMap, pressureIds, 'systems', sysRef, {\n   847→    type: 'system', id: sysId, field: 'actions', location,\n   848→  });\n   849→  if (config.clusterRelationshipKind) {\n   850→    recordRelationshipKindRef(usageMap, config.clusterRelationshipKind, 'systems', sysRef, {\n   851→      type: 'system', id: sysId, field: 'clusterRelationshipKind', location,\n   852→    });\n   853→  }\n   854→}\n   855→\n   856→function scanClusterSystem(config, usageMap, pressureIds, sysRef, sysId, location) {\n   857→  (config.clustering?.criteria || []).forEach((crit, idx) => {\n   858→    if (crit.type === 'shared_relationship') {\n   859→      recordRelationshipKindRef(usageMap, crit.relationshipKind, 'systems', sysRef, {\n   860→        type: 'system', id: sysId, field: `clustering.criteria[${idx}].relationshipKind`, location,\n   861→      });\n   862→    }\n   863→  });\n   864→  if (config.metaEntity?.kind) {\n   865→    recordEntityKindRef(usageMap, config.metaEntity.kind, 'systems', sysRef, {\n   866→      type: 'system', id: sysId, field: 'metaEntity.kind', location,\n   867→    });\n   868→  }\n   869→  (config.metaEntity?.additionalTags || []).forEach((tag) => recordTagRef(usageMap, tag, 'systems', sysRef));\n   870→  Object.keys(config.postProcess?.pressureChanges || {}).forEach((pressureId) => {\n   871→    recordPressureRef(usageMap, pressureIds, pressureId, 'systems', sysRef, {\n   872→      type: 'system', id: sysId, field: 'postProcess.pressureChanges', location,\n   873→    });\n   874→  });\n   875→  if (config.postProcess?.governanceRelationship) {\n   876→    recordRelationshipKindRef(usageMap, config.postProcess.governanceRelationship, 'systems', sysRef, {\n   877→      type: 'system', id: sysId, field: 'postProcess.governanceRelationship', location,\n   878→    });\n   879→  }\n   880→  if (config.postProcess?.governanceFactionSubtype) {\n   881→    recordSubtypeRef(usageMap, config.postProcess.governanceFactionSubtype, 'systems', sysRef);\n   882→  }\n   883→}\n   884→\n   885→function scanTagDiffusionSystem(config, usageMap, pressureIds, sysRef, sysId, location) {\n   886→  if (config.connectionKind) {\n   887→    recordRelationshipKindRef(usageMap, config.connectionKind, 'systems', sysRef, {\n   888→      type: 'system', id: sysId, field: 'connectionKind', location,\n   889→    });\n   890→  }\n   891→  (config.convergence?.tags || []).forEach((tag) => recordTagRef(usageMap, tag, 'systems', sysRef));\n   892→  (config.divergence?.tags || []).forEach((tag) => recordTagRef(usageMap, tag, 'systems', sysRef));\n   893→  if (config.divergencePressure?.pressureName) {\n   894→    recordPressureRef(usageMap, pressureIds, config.divergencePressure.pressureName, 'systems', sysRef, {\n   895→      type: 'system', id: sysId, field: 'divergencePressure.pressureName', location,\n   896→    });\n   897→  }\n   898→}\n   899→\n   900→function scanPlaneDiffusionSystem(config, usageMap, sysRef) {\n   901→  if (config.sources?.tagFilter) recordTagRef(usageMap, config.sources.tagFilter, 'systems', sysRef);\n   902→  if (config.sources?.strengthTag) recordTagRef(usageMap, config.sources.strengthTag, 'systems', sysRef);\n   903→  if (config.sinks?.tagFilter) recordTagRef(usageMap, config.sinks.tagFilter, 'systems', sysRef);\n   904→  if (config.sinks?.strengthTag) recordTagRef(usageMap, config.sinks.strengthTag, 'systems', sysRef);\n   905→  (config.outputTags || []).forEach((tagConfig) => recordTagRef(usageMap, tagConfig.tag, 'systems', sysRef));\n   906→  if (config.valueTag) recordTagRef(usageMap, config.valueTag, 'systems', sysRef);\n   907→}\n   908→\n   909→const systemTypeScanners = {\n   910→  graphContagion: scanContagionSystem,\n   911→  connectionEvolution: scanEvolutionSystem,\n   912→  thresholdTrigger: scanThresholdSystem,\n   913→  clusterFormation: scanClusterSystem,\n   914→  tagDiffusion: scanTagDiffusionSystem,\n   915→};\n   916→\n   917→function scanSystemReferences(usageMap, systems, schema, pressures) {\n   918→  const pressureIds = new Set((pressures || []).map(p => p.id));\n   919→\n   920→  (systems || []).forEach(sys => {\n   921→    const sysId = sys.config.id;\n   922→    const sysName = sys.config.name || sysId;\n   923→    const sysRef = { id: sysId, name: sysName };\n   924→    const config = sys.config;\n   925→    const location = `System \"${sysName}\"`;\n   926→\n   927→    scanSelectionRule(config.selection, usageMap, 'systems', sysRef, {\n   928→      type: 'system', id: sysId, field: 'selection', location,\n   929→    });\n   930→\n   931→    Object.keys(config.pressureChanges || {}).forEach((pressureId) => {\n   932→      recordPressureRef(usageMap, pressureIds, pressureId, 'systems', sysRef, {\n   933→        type: 'system', id: sysId, field: 'pressureChanges', location,\n   934→      });\n   935→    });\n   936→\n   937→    const scanner = systemTypeScanners[sys.systemType];\n   938→    if (scanner) {\n   939→      scanner(config, usageMap, pressureIds, sysRef, sysId, location);\n   940→    } else if (sys.systemType === 'planeDiffusion') {\n   941→      scanPlaneDiffusionSystem(config, usageMap, sysRef);\n   942→    }\n   943→  });\n   944→}\n   945→\n   946→function scanActionReferences(usageMap, actions, schema, pressures) {\n   947→  const pressureIds = new Set((pressures || []).map(p => p.id));\n   948→\n   949→  (actions || []).forEach(action => {\n   950→    const actionRef = { id: action.id, name: action.name };\n   951→    const location = `Action \"${action.name || action.id}\"`;\n   952→\n   953→    scanSelectionRule(action.actor?.selection, usageMap, 'actions', actionRef, {\n   954→      type: 'action',\n   955→      id: action.id,\n   956→      field: 'actor.selection',\n   957→      location,\n   958→    });\n   959→\n   960→    (action.actor?.conditions || []).forEach((condition, idx) => {\n   961→      scanCondition(condition, usageMap, pressureIds, 'actions', actionRef, {\n   962→        type: 'action',\n   963→        id: action.id,\n   964→        field: `actor.conditions[${idx}]`,\n   965→        location,\n   966→      });\n   967→    });\n   968→\n   969→    scanVariableSelectionRule(action.actor?.instigator, usageMap, 'actions', actionRef, {\n   970→      type: 'action',\n   971→      id: action.id,\n   972→      field: 'actor.instigator',\n   973→      location,\n   974→    });\n   975→\n   976→    scanSelectionRule(action.targeting, usageMap, 'actions', actionRef, {\n   977→      type: 'action',\n   978→      id: action.id,\n   979→      field: 'targeting',\n   980→      location,\n   981→    });\n   982→\n   983→    scanMutations(action.outcome?.mutations || [], usageMap, pressureIds, 'actions', actionRef, {\n   984→      type: 'action',\n   985→      id: action.id,\n   986→      field: 'outcome.mutations',\n   987→      location,\n   988→    });\n   989→\n   990→    const pressureModifiers = action.probability?.pressureModifiers;\n   991→    if (Array.isArray(pressureModifiers)) {\n   992→      pressureModifiers.forEach((mod) => {\n   993→        recordPressureRef(usageMap, pressureIds, mod?.pressure, 'actions', actionRef, {\n   994→          type: 'action',\n   995→          id: action.id,\n   996→          field: 'probability.pressureModifiers',\n   997→          location,\n   998→        });\n   999→      });"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"b3bd0c93-d7c1-4461-a4d2-d9e683fd9f30"}
