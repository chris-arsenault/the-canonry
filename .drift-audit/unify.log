{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NA8gHDxgfPcu3GqJTnn5ZD","type":"tool_result","content":"     1→/**\n     2→ * Schema Usage Map - Computes bidirectional reference tracking across all config elements\n     3→ *\n     4→ * This utility analyzes the relationships between:\n     5→ * - Schema (entity kinds, relationship kinds, statuses, subtypes, tags)\n     6→ * - Pressures (and their feedback factors)\n     7→ * - Eras (and their generator/system weights)\n     8→ * - Generators (and their entity/relationship references)\n     9→ * - Systems (and their entity/relationship/pressure references)\n    10→ * - Actions (and their actor/target/outcome references)\n    11→ *\n    12→ * Returns a comprehensive map showing:\n    13→ * 1. Where each element is used (forward references)\n    14→ * 2. What each element references (backward references)\n    15→ * 3. Validation status for each reference\n    16→ */\n    17→\n    18→/**\n    19→ * Compute complete usage map for all schema elements\n    20→ */\n    21→export function computeUsageMap(schema, pressures, eras, generators, systems, actions) {\n    22→  const usageMap = {\n    23→    // Schema element usage tracking\n    24→    entityKinds: {},      // { kindId: { generators: [], systems: [], actions: [], pressures: [] } }\n    25→    subtypes: {},         // { subtype: { generators: [], systems: [], actions: [] } }\n    26→    statuses: {},         // { status: { generators: [], systems: [], actions: [] } }\n    27→    relationshipKinds: {},// { kindId: { generators: [], systems: [], actions: [], pressures: [] } }\n    28→    tags: {},             // { tag: { pressures: [], systems: [], generators: [], actions: [] } }\n    29→\n    30→    // Cross-tab reference tracking\n    31→    pressures: {},        // { pressureId: { generators: [], systems: [], actions: [], eras: [] } }\n    32→    generators: {},       // generatorId -> eras with id and weight\n    33→    systems: {},          // systemId -> eras with id and weight\n    34→\n    35→    // Validation results\n    36→    validation: {\n    37→      invalidRefs: [],    // [{ type, id, field, refType, refId, location }]\n    38→      orphans: [],        // [{ type, id, reason }]\n    39→      compatibility: [],  // [{ type, id, field, issue }]\n    40→    }\n    41→  };\n    42→\n    43→  // Initialize from schema\n    44→  initializeFromSchema(usageMap, schema);\n    45→\n    46→  // Initialize pressure tracking\n    47→  initializePressures(usageMap, pressures);\n    48→\n    49→  // Initialize generator/system tracking\n    50→  initializeGeneratorsAndSystems(usageMap, generators, systems);\n    51→\n    52→  // Scan pressures for schema references\n    53→  scanPressureReferences(usageMap, pressures, schema);\n    54→\n    55→  // Scan eras for generator/system references\n    56→  scanEraReferences(usageMap, eras, generators, systems);\n    57→\n    58→  // Scan generators for all references\n    59→  scanGeneratorReferences(usageMap, generators, schema, pressures);\n    60→\n    61→  // Scan systems for all references\n    62→  scanSystemReferences(usageMap, systems, schema, pressures);\n    63→\n    64→  // Scan actions for all references\n    65→  scanActionReferences(usageMap, actions, schema, pressures);\n    66→\n    67→  // Detect orphans (unused elements)\n    68→  detectOrphans(usageMap, schema, pressures, generators, systems);\n    69→\n    70→  // Check relationship compatibility\n    71→  checkRelationshipCompatibility(usageMap, generators, actions, schema);\n    72→\n    73→  return usageMap;\n    74→}\n    75→\n    76→function initializeFromSchema(usageMap, schema) {\n    77→  // Entity kinds\n    78→  (schema?.entityKinds || []).forEach(ek => {\n    79→    usageMap.entityKinds[ek.kind] = { generators: [], systems: [], actions: [], pressures: [] };\n    80→\n    81→    // Subtypes\n    82→    (ek.subtypes || []).forEach(st => {\n    83→      const subtypeId = typeof st === 'string' ? st : st.id;\n    84→      if (!usageMap.subtypes[subtypeId]) {\n    85→        usageMap.subtypes[subtypeId] = { generators: [], systems: [], actions: [] };\n    86→      }\n    87→    });\n    88→\n    89→    // Statuses\n    90→    (ek.statuses || []).forEach(s => {\n    91→      const statusId = typeof s === 'string' ? s : s.id;\n    92→      if (!usageMap.statuses[statusId]) {\n    93→        usageMap.statuses[statusId] = { generators: [], systems: [], actions: [] };\n    94→      }\n    95→    });\n    96→  });\n    97→\n    98→  // Relationship kinds\n    99→  (schema?.relationshipKinds || []).forEach(rk => {\n   100→    usageMap.relationshipKinds[rk.kind] = {"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"c9061d1c-7b2f-498a-88b3-43b2fd9fe1a4"}
