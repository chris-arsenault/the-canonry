m default theme) */\n  --color-accent: #a855f7;\n  --color-accent-light: #c084fc;\n  --gradient-accent: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  font-size: var(--text-base);\n  line-height: 1.5;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}","newString":"/* Arctic Blue Theme — Shared base (backgrounds, borders, text, spacing, fonts, reset) */\n@import \"@the-canonry/shared-components/styles/arctic-theme-base\";\n\n/* Illuminator accent overrides (purple for enrichment/magic) */\n:root {\n  --accent-color: #a855f7;\n  --accent-hover: #c084fc;\n  --purple-accent: #a855f7;\n  --purple-dark: #9333ea;\n\n  /* Buttons */\n  --button-primary: #a855f7;\n  --button-primary-hover: #c084fc;\n\n  /* Canonical overrides for shared-components (accent differs from default theme) */\n  --color-accent: #a855f7;\n  --color-accent-light: #c084fc;\n  --gradient-accent: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);\n}","originalFile":"/* Arctic Blue Theme - Illuminator (with Purple accent for enrichment) */\n:root {\n  /* Backgrounds - Arctic deep blues */\n  --bg-primary: #0a1929;\n  --bg-secondary: #1e3a5f;\n  --bg-tertiary: #2d4a6f;\n  --bg-sidebar: #0c1f2e;\n\n  /* Borders - Blue tinted */\n  --border-color: rgb(59 130 246 / 30%);\n  --border-light: rgb(59 130 246 / 50%);\n\n  /* Text - Ice white tones */\n  --text-color: #fff;\n  --text-secondary: #93c5fd;\n  --text-muted: #60a5fa;\n\n  /* Illuminator accent (purple for enrichment/magic within arctic theme) */\n  --accent-color: #a855f7;\n  --accent-hover: #c084fc;\n\n  /* Arctic theme variables */\n  --arctic-deep: #0a1929;\n  --arctic-dark: #1e3a5f;\n  --arctic-mid: #2d4a6f;\n  --arctic-ice: #3b82f6;\n  --arctic-frost: #60a5fa;\n  --arctic-light: #93c5fd;\n  --purple-accent: #a855f7;\n  --purple-dark: #9333ea;\n\n  /* Consistent spacing scale */\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 12px;\n  --space-lg: 16px;\n  --space-xl: 24px;\n\n  /* Consistent font sizes */\n  --text-xs: 11px;\n  --text-sm: 12px;\n  --text-base: 13px;\n  --text-lg: 14px;\n  --text-xl: 16px;\n  --text-2xl: 20px;\n\n  /* Component colors */\n  --card-bg: var(--bg-secondary);\n  --card-border: var(--border-color);\n  --input-bg: var(--bg-tertiary);\n\n  /* Semantic colors */\n  --danger: #ef4444;\n  --success: #22c55e;\n  --warning: #f59e0b;\n\n  /* Buttons */\n  --button-primary: #a855f7;\n  --button-primary-hover: #c084fc;\n\n  /* Canonical overrides for shared-components (accent differs from default theme) */\n  --color-accent: #a855f7;\n  --color-accent-light: #c084fc;\n  --gradient-accent: linear-gradient(135deg, #a855f7 0%, #c084fc 100%);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family:\n    -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\",\n    \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  font-size: var(--text-base);\n  line-height: 1.5;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n/* Illuminator Container */\n.illuminator-container {\n  display: flex;\n  height: 100%;\n  background: var(--bg-primary);\n}\n\n/* Sidebar */\n.illuminator-sidebar {\n  width: 200px;\n  min-width: 200px;\n  background: var(--bg-sidebar);\n  border-right: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  padding: var(--space-md);\n}\n\n/* Navigation */\n.illuminator-nav {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n  margin-bottom: var(--space-lg);\n}\n\n.illuminator-nav-button {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) var(--space-md);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n  text-align: left;\n}\n\n.illuminator-nav-button:hover {\n  background: var(--bg-secondary);\n  color: var(--text-color);\n}\n\n.illuminator-nav-button.active {\n  background: var(--bg-secondary);\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n/* API Section */\n.illuminator-api-section {\n  margin-top: auto;\n  padding-top: var(--space-lg);\n  border-top: 1px solid var(--border-color);\n}\n\n.illuminator-api-button {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-api-button:hover {\n  background: var(--bg-tertiary);\n}\n\n.illuminator-api-button.active {\n  border-color: var(--success);\n  color: var(--success);\n}\n\n.illuminator-api-dropdown {\n  margin-top: var(--space-sm);\n  padding: var(--space-md);\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n}\n\n.illuminator-api-dropdown-title {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n  margin-bottom: var(--space-xs);\n}\n\n.illuminator-api-dropdown-hint {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  margin-bottom: var(--space-sm);\n}\n\n.illuminator-api-input {\n  width: 100%;\n  padding: var(--space-sm);\n  background: var(--input-bg);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  margin-bottom: var(--space-sm);\n}\n\n.illuminator-api-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n/* Progress Section (sidebar) */\n.illuminator-progress-section {\n  padding: var(--space-md) 0;\n  border-bottom: 1px solid var(--border-color);\n  margin-bottom: var(--space-md);\n}\n\n.illuminator-progress-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  margin-bottom: var(--space-sm);\n}\n\n.illuminator-progress-fill {\n  height: 100%;\n  background: var(--accent-color);\n  border-radius: 3px;\n  transition: width 0.3s ease;\n}\n\n.illuminator-progress-stats {\n  display: flex;\n  gap: var(--space-md);\n  margin-top: var(--space-sm);\n  font-size: var(--text-xs);\n}\n\n/* Main Content */\n.illuminator-main {\n  flex: 1;\n  overflow: hidden;\n  padding: var(--space-lg);\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.illuminator-content {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: auto;\n}\n\n/* Empty State — extends shared EmptyState with full-height layout */\n.illuminator-empty-state {\n  height: 100%;\n}\n\n/* Cards */\n.illuminator-card {\n  background: var(--card-bg);\n  border: 1px solid var(--card-border);\n  border-radius: 6px;\n  padding: var(--space-lg);\n  margin-bottom: var(--space-lg);\n}\n\n.illuminator-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: var(--space-md);\n}\n\n.illuminator-card-title {\n  font-size: var(--text-lg);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n/* Form elements */\n.illuminator-form-group {\n  margin-bottom: var(--space-md);\n}\n\n.illuminator-label {\n  display: block;\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n  margin-bottom: var(--space-xs);\n}\n\n.illuminator-input {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--input-bg);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n}\n\n.illuminator-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.illuminator-select {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--input-bg);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  cursor: pointer;\n}\n\n.illuminator-checkbox-group {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) 0;\n}\n\n.illuminator-checkbox {\n  width: 16px;\n  height: 16px;\n  accent-color: var(--accent-color);\n}\n\n/* Buttons */\n.illuminator-button {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) var(--space-lg);\n  background: var(--button-primary);\n  border: none;\n  border-radius: 4px;\n  color: white;\n  font-size: var(--text-sm);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.15s ease;\n}\n\n.illuminator-button:hover {\n  background: var(--button-primary-hover);\n}\n\n.illuminator-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Queue item styles */\n.illuminator-queue-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  margin-bottom: var(--space-sm);\n}\n\n.illuminator-queue-item-info {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n}\n\n.illuminator-queue-item-name {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--text-color);\n}\n\n.illuminator-queue-item-meta {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-queue-item-status {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.illuminator-status-badge {\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: var(--text-xs);\n  font-weight: 500;\n}\n\n.illuminator-status-pending {\n  background: rgb(156 163 175 / 20%);\n  color: #9ca3af;\n}\n\n.illuminator-status-running {\n  background: rgb(59 130 246 / 20%);\n  color: #3b82f6;\n}\n\n.illuminator-status-complete {\n  background: rgb(34 197 94 / 20%);\n  color: #22c55e;\n}\n\n.illuminator-status-error {\n  background: rgb(239 68 68 / 20%);\n  color: #ef4444;\n}\n\n/* Progress bar */\n.illuminator-progress {\n  width: 100%;\n  height: 8px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.illuminator-progress-bar {\n  height: 100%;\n  background: var(--accent-color);\n  transition: width 0.3s ease;\n  width: var(--pp-bar-width);\n}\n\n/* Entity card in results */\n.illuminator-entity-card {\n  display: flex;\n  gap: var(--space-lg);\n  padding: var(--space-lg);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  margin-bottom: var(--space-md);\n}\n\n.illuminator-entity-image {\n  width: 120px;\n  height: 120px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n\n.illuminator-entity-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.illuminator-entity-details {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.illuminator-entity-name {\n  font-size: var(--text-lg);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.illuminator-entity-kind {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-entity-description {\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n  line-height: 1.6;\n}\n\n.illuminator-entity-actions {\n  display: flex;\n  gap: var(--space-sm);\n  margin-top: auto;\n}\n\n/* Temporary slot warning banner */\n.illuminator-temp-slot-warning {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-md);\n  padding: var(--space-md) var(--space-lg);\n  margin: 0 var(--space-lg) var(--space-lg) var(--space-lg);\n  background: rgb(234 179 8 / 15%);\n  border: 1px solid rgb(234 179 8 / 40%);\n  border-radius: 6px;\n  color: #fcd34d;\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n\n.illuminator-temp-slot-warning-icon {\n  font-size: var(--text-lg);\n  flex-shrink: 0;\n}\n\n.illuminator-temp-slot-warning strong {\n  color: #fef08a;\n}\n\n/* Prompt Preview Panel */\n.illuminator-prompt-tabs {\n  display: flex;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-lg);\n  flex-wrap: wrap;\n}\n\n.illuminator-prompt-tab {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-prompt-tab:hover {\n  background: var(--bg-secondary);\n  border-color: var(--border-light);\n}\n\n.illuminator-prompt-tab.active {\n  background: var(--accent-color);\n  border-color: var(--accent-color);\n  color: white;\n}\n\n.illuminator-prompt-preview {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  padding: var(--space-md);\n  font-family: Monaco, Menlo, \"Ubuntu Mono\", monospace;\n  font-size: var(--text-xs);\n  line-height: 1.6;\n  color: var(--text-secondary);\n  white-space: pre-wrap;\n  overflow-wrap: break-word;\n  overflow-x: auto;\n  margin: 0;\n}\n\n.illuminator-prompt-preview-large {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n/* Context Usage */\n.illuminator-context-usage {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  padding: var(--space-md);\n}\n\n.illuminator-context-usage-title {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n  margin: 0 0 var(--space-md) 0;\n}\n\n.illuminator-context-fields {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.illuminator-context-field {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  font-size: var(--text-xs);\n}\n\n.illuminator-context-field-status {\n  width: 16px;\n  text-align: center;\n  font-weight: bold;\n}\n\n.illuminator-context-field-status.set {\n  color: #4ade80;\n}\n\n.illuminator-context-field-status.missing {\n  color: #f87171;\n}\n\n.illuminator-context-field-name {\n  font-family: Monaco, Menlo, monospace;\n  color: var(--text-color);\n  min-width: 160px;\n}\n\n.illuminator-context-field-desc {\n  color: var(--text-muted);\n  flex: 1;\n}\n\n.illuminator-context-field-warning {\n  background: rgb(234 179 8 / 20%);\n  color: #fcd34d;\n  padding: 2px 6px;\n  border-radius: 3px;\n  font-size: 10px;\n  text-transform: uppercase;\n}\n\n/* Prompt Warning */\n.illuminator-prompt-warning {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-md);\n  padding: var(--space-md) var(--space-lg);\n  margin-top: var(--space-lg);\n  background: rgb(234 179 8 / 15%);\n  border: 1px solid rgb(234 179 8 / 40%);\n  border-radius: 6px;\n  color: #fcd34d;\n  font-size: var(--text-sm);\n  line-height: 1.5;\n}\n\n.illuminator-prompt-warning-icon {\n  font-size: var(--text-lg);\n  flex-shrink: 0;\n}\n\n.illuminator-prompt-warning strong {\n  color: #fef08a;\n}\n\n/* ============================================================================\n   Prompt Template Editor Styles\n   ============================================================================ */\n\n.illuminator-template-editor {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-lg);\n}\n\n/* Kind Selector */\n.illuminator-template-kind-section {\n  margin-top: var(--space-lg);\n  padding-top: var(--space-lg);\n  border-top: 1px solid var(--border-color);\n}\n\n.illuminator-template-kind-header {\n  display: flex;\n  align-items: baseline;\n  gap: var(--space-md);\n  margin-bottom: var(--space-sm);\n}\n\n.illuminator-kind-selector {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-xs);\n}\n\n.illuminator-kind-button {\n  padding: var(--space-xs) var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-xs);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-kind-button:hover {\n  background: var(--bg-secondary);\n  border-color: var(--border-light);\n}\n\n.illuminator-kind-button.active {\n  background: var(--accent-color);\n  border-color: var(--accent-color);\n  color: white;\n}\n\n.illuminator-template-kind-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-md);\n  margin-top: var(--space-sm);\n}\n\n.illuminator-template-kind-badge {\n  display: inline-block;\n  padding: 2px 8px;\n  background: rgb(168 85 247 / 20%);\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  color: var(--accent-color);\n}\n\n.illuminator-template-kind-badge.default {\n  background: rgb(156 163 175 / 20%);\n  color: #9ca3af;\n}\n\n/* Mode Toggle */\n.illuminator-template-mode-toggle {\n  display: flex;\n  gap: 0;\n  margin-top: var(--space-lg);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  overflow: hidden;\n  width: fit-content;\n}\n\n.illuminator-mode-button {\n  padding: var(--space-sm) var(--space-lg);\n  background: transparent;\n  border: none;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-mode-button:hover {\n  background: var(--bg-tertiary);\n}\n\n.illuminator-mode-button.active {\n  background: var(--accent-color);\n  color: white;\n}\n\n/* Template Sections */\n.illuminator-template-sections {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-lg);\n}\n\n.illuminator-template-section {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n}\n\n.illuminator-template-section-header {\n  display: flex;\n  align-items: baseline;\n  gap: var(--space-md);\n}\n\n.illuminator-template-section-hint {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-template-textarea {\n  width: 100%;\n  padding: var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  line-height: 1.6;\n  resize: vertical;\n  min-height: 80px;\n}\n\n.illuminator-template-textarea:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.illuminator-template-textarea:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.illuminator-template-textarea-large {\n  min-height: 200px;\n}\n\n/* Template Variables */\n.illuminator-template-variables {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-top: var(--space-sm);\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n}\n\n.illuminator-template-variables code {\n  padding: 2px 6px;\n  background: rgb(168 85 247 / 15%);\n  border-radius: 3px;\n  font-family: Monaco, Menlo, \"Ubuntu Mono\", monospace;\n  font-size: var(--text-xs);\n  color: var(--accent-hover);\n}\n\n/* Override Notice */\n.illuminator-template-override-notice {\n  padding: var(--space-md);\n  background: rgb(234 179 8 / 10%);\n  border: 1px solid rgb(234 179 8 / 30%);\n  border-radius: 6px;\n  color: #fcd34d;\n  font-size: var(--text-sm);\n  text-align: center;\n}\n\n/* Full Template Badge */\n.illuminator-template-full-badge {\n  padding: 2px 8px;\n  background: rgb(168 85 247 / 20%);\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  color: var(--accent-color);\n}\n\n/* Visual Generation Steps Section */\n.illuminator-template-visual-steps {\n  margin-top: var(--space-lg);\n  border-top: 1px solid var(--border-color);\n  padding-top: var(--space-md);\n}\n\n.illuminator-template-visual-steps-toggle {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-template-visual-steps-toggle:hover {\n  background: var(--bg-secondary);\n  color: var(--text-primary);\n}\n\n.illuminator-template-visual-steps-hint {\n  margin-left: auto;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-template-visual-steps-content {\n  margin-top: var(--space-md);\n  padding: var(--space-md);\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.illuminator-template-visual-steps-info {\n  padding: var(--space-sm) var(--space-md);\n  background: rgb(96 165 250 / 10%);\n  border: 1px solid rgb(96 165 250 / 20%);\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  line-height: 1.5;\n}\n\n/* Button Link */\n.illuminator-button-link {\n  background: none;\n  border: none;\n  padding: 0;\n  color: var(--accent-color);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  text-decoration: underline;\n  text-decoration-style: dotted;\n}\n\n.illuminator-button-link:hover {\n  color: var(--accent-hover);\n  text-decoration-style: solid;\n}\n\n/* Preview Entity Info */\n.illuminator-preview-entity-info {\n  display: flex;\n  gap: var(--space-sm);\n  margin-top: var(--space-md);\n  padding-top: var(--space-md);\n  border-top: 1px solid var(--border-color);\n}\n\n.illuminator-preview-entity-badge {\n  padding: 2px 8px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n}\n\n/* Card subtitle */\n.illuminator-card-subtitle {\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n/* ============================================================================\n   Style Library Editor Styles\n   ============================================================================ */\n\n/* Style Grid */\n.illuminator-style-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: var(--space-md);\n}\n\n/* Style Card */\n.illuminator-style-card {\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  padding: var(--space-md);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.illuminator-style-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: var(--space-sm);\n}\n\n.illuminator-style-card-title {\n  font-size: var(--text-lg);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.illuminator-style-card-actions {\n  display: flex;\n  gap: var(--space-xs);\n  flex-shrink: 0;\n}\n\n.illuminator-style-card-description {\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n}\n\n.illuminator-style-card-prompt {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  font-style: italic;\n  padding: var(--space-sm);\n  background: rgb(0 0 0 / 20%);\n  border-radius: 4px;\n}\n\n.illuminator-style-card-prompt strong {\n  font-style: normal;\n  color: var(--text-secondary);\n}\n\n.illuminator-style-card-keywords {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-xs);\n}\n\n.illuminator-style-keyword {\n  padding: 2px 8px;\n  background: rgb(168 85 247 / 15%);\n  border-radius: 3px;\n  font-size: var(--text-xs);\n  color: var(--accent-hover);\n}\n\n.illuminator-style-card-kinds {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-style-card-kinds strong {\n  color: var(--text-secondary);\n}\n\n/* Generic Button Styles */\n.illuminator-btn {\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.illuminator-btn:hover {\n  background: var(--bg-secondary);\n  border-color: var(--border-light);\n}\n\n.illuminator-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.illuminator-btn-primary {\n  background: var(--button-primary);\n  border-color: var(--button-primary);\n  color: white;\n}\n\n.illuminator-btn-primary:hover {\n  background: var(--button-primary-hover);\n  border-color: var(--button-primary-hover);\n}\n\n.illuminator-btn-danger {\n  color: var(--danger);\n}\n\n.illuminator-btn-danger:hover {\n  background: rgb(239 68 68 / 15%);\n  border-color: var(--danger);\n}\n\n.illuminator-btn-icon {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n}\n\n/* Modal Styles */\n.illuminator-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 80%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 9999;\n  padding: var(--space-xl);\n}\n\n.illuminator-modal {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  width: 100%;\n  max-width: 500px;\n  max-height: 90vh;\n  overflow-y: auto;\n  box-shadow: 0 8px 32px rgb(0 0 0 / 50%);\n}\n\n.illuminator-modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--space-lg);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.illuminator-modal-header h3 {\n  margin: 0;\n  font-size: var(--text-xl);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.illuminator-modal-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--text-muted);\n  cursor: pointer;\n  padding: 0;\n  line-height: 1;\n}\n\n.illuminator-modal-close:hover {\n  color: var(--text-color);\n}\n\n.illuminator-modal-body {\n  padding: var(--space-lg);\n}\n\n.illuminator-modal-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--space-sm);\n  padding-top: var(--space-lg);\n  margin-top: var(--space-lg);\n  border-top: 1px solid var(--border-color);\n}\n\n/* Textarea for modal */\n.illuminator-textarea {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--input-bg);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  font-family: inherit;\n  resize: vertical;\n  min-height: 80px;\n}\n\n.illuminator-textarea:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n/* Checkbox Grid */\n.illuminator-checkbox-grid {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-sm);\n}\n\n.illuminator-checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: var(--space-xs);\n  padding: var(--space-xs) var(--space-sm);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.illuminator-checkbox-label:has(input:checked) {\n  background: rgb(168 85 247 / 15%);\n  border-color: var(--accent-color);\n  color: var(--accent-hover);\n}\n\n/* Visual Identity Editor */\n.illuminator-visual-identity-editor {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.illuminator-visual-identity-entries {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.illuminator-visual-identity-entry {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.illuminator-visual-identity-key {\n  min-width: 100px;\n  padding: var(--space-xs) var(--space-sm);\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  text-transform: uppercase;\n  color: var(--accent-color);\n}\n\n.illuminator-visual-identity-add {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding-top: var(--space-sm);\n  border-top: 1px solid var(--border-color);\n}\n\n.illuminator-visual-identity-entry.is-empty {\n  background: rgb(239 68 68 / 5%);\n  border-radius: 4px;\n  padding: 4px;\n  margin: -4px;\n}\n\n.illuminator-input.warning {\n  border-color: var(--warning-color, #f59e0b);\n  background: rgb(245 158 11 / 5%);\n}\n\n.illuminator-input.warning::placeholder {\n  color: var(--warning-color, #f59e0b);\n  opacity: 0.7;\n}\n\n/* Warning badge for cultures with missing values */\n.illuminator-warning-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 16px;\n  height: 16px;\n  padding: 0 4px;\n  margin-left: 6px;\n  background: var(--warning-color, #f59e0b);\n  color: white;\n  font-size: 10px;\n  font-weight: 600;\n  border-radius: 8px;\n}\n\n.illuminator-kind-button.has-warning:not(.active) {\n  border-color: var(--warning-color, #f59e0b);\n}\n\n/* Delete confirmation buttons */\n.illuminator-delete-confirm {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.illuminator-button-small {\n  padding: 2px 8px;\n  font-size: 11px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.illuminator-button-small:hover {\n  background: var(--bg-secondary);\n}\n\n.illuminator-button-small.danger {\n  background: rgb(239 68 68 / 10%);\n  border-color: var(--error-color);\n  color: var(--error-color);\n}\n\n.illuminator-button-small.danger:hover {\n  background: rgb(239 68 68 / 20%);\n}\n\n/* Collapsible Identity Section */\n.illuminator-identity-section {\n  margin-bottom: var(--space-md);\n}\n\n.illuminator-identity-section:last-child {\n  margin-bottom: 0;\n}\n\n.illuminator-identity-section-header {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-sm);\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: var(--bg-tertiary);\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.illuminator-identity-section-header:hover {\n  background: rgb(59 130 246 / 20%);\n}\n\n.illuminator-identity-section-toggle {\n  font-family: monospace;\n  font-weight: bold;\n  color: var(--text-muted);\n  width: 12px;\n  flex-shrink: 0;\n}\n\n.illuminator-identity-section-title {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n  margin: 0;\n}\n\n.illuminator-identity-section-subtitle {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.illuminator-identity-section-content {\n  padding: var(--space-md);\n  border-left: 2px solid var(--border-color);\n  margin-left: 6px;\n  margin-top: var(--space-sm);\n}\n\n/* ============================================================================\n   LLM Call Configuration Panel - Compact Table Layout\n   ============================================================================ */\n\n.llm-config-panel {\n  padding: var(--space-md);\n}\n\n.llm-config-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: var(--space-md);\n}\n\n.llm-config-title-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.llm-config-override-count {\n  font-size: var(--text-xs);\n  color: var(--accent-color);\n  background: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: 10px;\n}\n\n.llm-config-reset-all {\n  padding: 4px 10px;\n  font-size: var(--text-xs);\n  background: transparent;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.llm-config-reset-all:hover {\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n.llm-table-container {\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.llm-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--text-sm);\n}\n\n.llm-table-header {\n  background: var(--bg-tertiary);\n}\n\n.llm-table-th {\n  padding: 8px 12px;\n  text-align: left;\n  font-weight: 600;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.llm-table-th-label {\n  width: 28%;\n}\n\n.llm-table-th-model {\n  width: 14%;\n}\n\n.llm-table-th-thinking {\n  width: 12%;\n}\n\n.llm-table-th-temp {\n  width: 10%;\n}\n\n.llm-table-th-top-p {\n  width: 12%;\n}\n\n.llm-table-th-max {\n  width: 16%;\n}\n\n.llm-table-th-action {\n  width: 8%;\n  text-align: center;\n}\n\n.llm-table-category-row {\n  background: var(--bg-secondary);\n}\n\n.llm-table-category-cell {\n  padding: 6px 12px;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  color: var(--accent-color);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.llm-table-row {\n  transition: background 0.1s ease;\n}\n\n.llm-table-row:hover {\n  background: var(--bg-tertiary);\n}\n\n.llm-table-row-last {\n  /* Last row in category before next category header */\n}\n\n.llm-table-cell {\n  padding: 6px 12px;\n  border-bottom: 1px solid var(--border-subtle);\n  vertical-align: middle;\n}\n\n.llm-table-row-last .llm-table-cell {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.llm-table-cell-label {\n  cursor: help;\n}\n\n.llm-table-label-text {\n  color: var(--text-color);\n}\n\n.llm-table-modified-dot {\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  background: var(--accent-color);\n  border-radius: 50%;\n  margin-left: 6px;\n  vertical-align: middle;\n}\n\n.llm-table-cell-model,\n.llm-table-cell-thinking,\n.llm-table-cell-temp,\n.llm-table-cell-top-p,\n.llm-table-cell-max {\n  padding: 4px 8px;\n}\n\n.llm-table-select {\n  width: 100%;\n  padding: 4px 8px;\n  font-size: var(--text-xs);\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  cursor: pointer;\n}\n\n.llm-table-select:hover {\n  border-color: var(--border-light);\n}\n\n.llm-table-select:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.llm-table-select:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.llm-table-input {\n  width: 100%;\n  padding: 4px 6px;\n  font-size: var(--text-xs);\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n}\n\n.llm-table-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.llm-table-cell-placeholder {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.llm-table-top-p-group {\n  display: flex;\n  gap: 6px;\n}\n\n.llm-table-top-p-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  width: 50%;\n}\n\n.llm-table-top-p-label {\n  font-size: 10px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.llm-table-cell-action {\n  text-align: center;\n  padding: 4px;\n}\n\n.llm-table-reset-btn {\n  width: 22px;\n  height: 22px;\n  padding: 0;\n  font-size: 14px;\n  line-height: 1;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.llm-table-reset-btn:hover {\n  background: rgb(239 68 68 / 10%);\n  border-color: rgb(239 68 68 / 30%);\n  color: #ef4444;\n}\n\n.llm-config-footer {\n  display: flex;\n  justify-content: space-between;\n  margin-top: var(--space-sm);\n  padding-top: var(--space-sm);\n}\n\n.llm-config-hint {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n/* Secondary button style */\n.illuminator-button-secondary {\n  background: transparent;\n  border: 1px solid var(--border-color);\n  color: var(--text-secondary);\n}\n\n.illuminator-button-secondary:hover {\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n/* ============================================================================\n * Static Pages Panel Styles\n * ============================================================================ */\n\n.static-pages-panel {\n  display: flex;\n  height: 100%;\n  gap: var(--space-md);\n}\n\n.static-pages-sidebar {\n  width: 280px;\n  flex-shrink: 0;\n  background: var(--bg-secondary);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n}\n\n.static-pages-sidebar-header {\n  padding: var(--space-sm) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.static-pages-sidebar-header h3 {\n  margin: 0;\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.static-pages-list {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-xs);\n}\n\n.static-pages-empty {\n  padding: var(--space-md);\n  text-align: center;\n  color: var(--text-muted);\n  font-size: var(--text-xs);\n}\n\n.static-pages-list-item {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 4px;\n  width: 100%;\n  padding: var(--space-sm) var(--space-sm);\n  margin-bottom: 4px;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: var(--radius-sm);\n  text-align: left;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.static-pages-list-item:hover {\n  background: var(--bg-tertiary);\n  border-color: var(--border-color);\n}\n\n.static-pages-list-item.selected {\n  background: rgb(139 92 246 / 10%);\n  border-color: var(--accent-color);\n}\n\n.static-pages-list-title {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--text-color);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 100%;\n}\n\n.static-pages-list-meta {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.static-pages-status-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--text-muted);\n}\n\n.static-pages-status-dot.published {\n  background: #10b981;\n}\n\n.static-pages-status-dot.draft {\n  background: #f59e0b;\n}\n\n.static-pages-editor-area {\n  flex: 1;\n  min-width: 0;\n}\n\n.static-pages-loading {\n  padding: var(--space-xl);\n  text-align: center;\n  color: var(--text-muted);\n}\n\n/* Static Page Editor */\n\n.static-page-editor {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  background: var(--bg-secondary);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-color);\n}\n\n.static-page-editor-header {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-sm) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.static-page-title-input {\n  flex: 1;\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-md);\n  font-weight: 600;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: var(--radius-sm);\n  color: var(--text-color);\n}\n\n.static-page-title-input:hover {\n  border-color: var(--border-color);\n}\n\n.static-page-title-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n  background: var(--bg-tertiary);\n}\n\n.static-page-editor-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-xs);\n}\n\n.static-page-status-badge {\n  padding: 2px 8px;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  border-radius: 10px;\n  text-transform: uppercase;\n}\n\n.static-page-status-badge.published {\n  background: rgb(16 185 129 / 15%);\n  color: #10b981;\n}\n\n.static-page-status-badge.draft {\n  background: rgb(245 158 11 / 15%);\n  color: #f59e0b;\n}\n\n.static-page-dirty-indicator {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n.static-page-button {\n  padding: 6px 12px;\n  font-size: var(--text-xs);\n  font-weight: 500;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.static-page-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.static-page-button:hover:not(:disabled) {\n  border-color: var(--border-light);\n  color: var(--text-color);\n}\n\n.static-page-button.primary {\n  background: var(--accent-color);\n  border-color: var(--accent-color);\n  color: white;\n}\n\n.static-page-button.primary:hover:not(:disabled) {\n  background: var(--accent-hover);\n}\n\n.static-page-button.danger {\n  color: #ef4444;\n}\n\n.static-page-button.danger:hover:not(:disabled) {\n  background: rgb(239 68 68 / 10%);\n  border-color: rgb(239 68 68 / 30%);\n}\n\n.static-page-summary-section {\n  padding: var(--space-xs) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.static-page-summary-label {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.static-page-summary-input {\n  flex: 1;\n  padding: 4px 8px;\n  font-size: var(--text-xs);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-color);\n}\n\n.static-page-summary-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.static-page-toolbar {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  padding: var(--space-xs) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-tertiary);\n}\n\n.static-page-toolbar-button {\n  padding: 4px 10px;\n  font-size: var(--text-xs);\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.static-page-toolbar-button:hover {\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n.static-page-toolbar-hint {\n  margin-left: auto;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.static-page-toolbar-hint code {\n  background: var(--bg-secondary);\n  padding: 2px 4px;\n  border-radius: 3px;\n  font-family: var(--font-mono);\n}\n\n.static-page-editor-container {\n  flex: 1;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.static-page-editor-container .w-md-editor {\n  height: 100% !important;\n  background: var(--bg-primary) !important;\n  border: none !important;\n  border-radius: 0 !important;\n}\n\n.static-page-editor-container .w-md-editor-text-pre,\n.static-page-editor-container .w-md-editor-text-input,\n.static-page-editor-container .w-md-editor-text {\n  font-family: var(--font-mono) !important;\n  font-size: var(--text-sm) !important;\n}\n\n.static-page-editor-container .w-md-editor-preview {\n  background: var(--bg-secondary) !important;\n}\n\n.static-page-editor-container .wmde-markdown {\n  background: var(--bg-secondary) !important;\n  color: var(--text-color) !important;\n}\n\n.static-page-editor-footer {\n  display: flex;\n  justify-content: space-between;\n  padding: var(--space-xs) var(--space-md);\n  border-top: 1px solid var(--border-color);\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.static-page-editor-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  background: var(--bg-secondary);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-color);\n  text-align: center;\n  padding: var(--space-xl);\n}\n\n.static-page-editor-empty-icon {\n  font-size: 48px;\n  margin-bottom: var(--space-md);\n  opacity: 0.5;\n}\n\n.static-page-editor-empty-title {\n  font-size: var(--text-md);\n  font-weight: 600;\n  color: var(--text-color);\n  margin-bottom: var(--space-xs);\n}\n\n.static-page-editor-empty-desc {\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n/* Modal styles for pickers */\n\n.static-page-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 60%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.static-page-modal {\n  width: 500px;\n  max-width: 90vw;\n  max-height: 80vh;\n  background: var(--bg-secondary);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 40px rgb(0 0 0 / 40%);\n}\n\n/* ImageRefPicker modal sizing (structure provided by ModalShell) */\n.modal.image-picker-modal {\n  width: 700px;\n  max-width: 90vw;\n  height: auto;\n  max-height: 85vh;\n}\n\n.image-picker-toolbar {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n}\n\n.static-page-modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--space-sm) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.static-page-modal-header h3 {\n  margin: 0;\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-color);\n}\n\n.static-page-modal-close {\n  width: 28px;\n  height: 28px;\n  background: transparent;\n  border: none;\n  font-size: 20px;\n  color: var(--text-muted);\n  cursor: pointer;\n  border-radius: var(--radius-sm);\n}\n\n.static-page-modal-close:hover {\n  background: var(--bg-tertiary);\n  color: var(--text-color);\n}\n\n.static-page-modal-body {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-md);\n}\n\n.static-page-search-input {\n  width: 100%;\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-sm);\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-color);\n  margin-bottom: var(--space-sm);\n}\n\n.static-page-search-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n/* EntityLinkPicker modal sizing (structure provided by ModalShell) */\n.modal.entity-link-picker-modal {\n  width: 500px;\n  max-width: 90vw;\n  height: auto;\n  max-height: 80vh;\n}\n\n/* Entity link picker list */\n\n.entity-link-list {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.entity-link-empty {\n  padding: var(--space-md);\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.entity-link-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  width: 100%;\n  padding: var(--space-xs) var(--space-sm);\n  margin-bottom: 4px;\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  text-align: left;\n  transition: all 0.15s ease;\n}\n\n.entity-link-item:hover {\n  background: var(--bg-tertiary);\n  border-color: var(--border-color);\n}\n\n.entity-link-name {\n  font-size: var(--text-sm);\n  font-weight: 500;\n  color: var(--text-color);\n}\n\n.entity-link-meta {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n/* Image picker grid */\n\n.image-picker-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n  gap: var(--space-sm);\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n.image-picker-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: var(--space-xs);\n  background: var(--bg-tertiary);\n  border: 2px solid transparent;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.image-picker-item:hover {\n  border-color: var(--border-light);\n}\n\n.image-picker-item.selected {\n  border-color: var(--accent-color);\n  background: rgb(139 92 246 / 10%);\n}\n\n.image-picker-thumb {\n  width: 80px;\n  height: 80px;\n  object-fit: cover;\n  border-radius: var(--radius-sm);\n}\n\n.image-picker-label {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  margin-top: 4px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 100%;\n}\n\n.image-picker-loading,\n.image-picker-empty {\n  padding: var(--space-xl);\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.image-picker-placeholder {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n  font-size: var(--text-xs);\n}\n\n.image-picker-load-more {\n  width: 100%;\n  margin-top: var(--space-sm);\n}\n\n.image-picker-count {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  margin-left: auto;\n  margin-right: var(--space-sm);\n}\n\n.image-picker-caption-section {\n  margin-top: var(--space-md);\n  padding-top: var(--space-md);\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  align-items: flex-end;\n  gap: var(--space-sm);\n}\n\n.image-picker-caption-label {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n/* =============================================================================\n   Pre-Print Panel\n   ============================================================================= */\n\n.preprint-panel {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.preprint-subtabs {\n  display: flex;\n  gap: var(--space-xs);\n  padding: var(--space-sm) var(--space-md);\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n  flex-shrink: 0;\n}\n\n.preprint-subtab {\n  padding: var(--space-xs) var(--space-md);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.preprint-subtab:hover {\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n.preprint-subtab.active {\n  background: var(--bg-primary);\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n.preprint-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-lg);\n}\n\n/* Action Buttons */\n.preprint-action-button {\n  padding: var(--space-sm) var(--space-lg);\n  background: var(--accent-color);\n  color: white;\n  border: none;\n  border-radius: 4px;\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: opacity 0.15s ease;\n}\n\n.preprint-action-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.preprint-action-button:hover:not(:disabled) {\n  opacity: 0.9;\n}\n\n.preprint-action-button.small {\n  padding: var(--space-xs) var(--space-sm);\n  font-size: var(--text-xs);\n}\n\n.preprint-action-button.danger {\n  background: #ef4444;\n}\n\n/* Stats View */\n.preprint-stats-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-xl);\n  text-align: center;\n}\n\n.preprint-stats {\n  max-width: 700px;\n}\n\n.preprint-stats-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: var(--space-lg);\n}\n\n.preprint-stats-hero {\n  text-align: center;\n  padding: var(--space-lg) 0;\n  margin-bottom: var(--space-md);\n}\n\n.preprint-stats-hero-number {\n  font-size: 48px;\n  font-weight: 700;\n  color: var(--accent-color);\n  font-family: var(--font-mono, monospace);\n}\n\n.preprint-stats-hero-label {\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n  margin-top: var(--space-xs);\n}\n\n.preprint-stats-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 6px 0;\n  font-size: var(--text-sm);\n  color: var(--text-color);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.preprint-stats-row.total {\n  font-weight: 600;\n}\n\n.preprint-stats-value {\n  font-family: var(--font-mono, monospace);\n  color: var(--text-secondary);\n}\n\n.preprint-stats-subsection {\n  font-size: var(--text-xs);\n  font-weight: 600;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: var(--space-sm) 0 var(--space-xs);\n  margin-top: var(--space-sm);\n}\n\n.preprint-stats-table {\n  font-size: var(--text-sm);\n}\n\n.preprint-stats-table-header {\n  display: grid;\n  grid-template-columns: 1fr 80px 80px 80px;\n  gap: var(--space-sm);\n  padding: var(--space-xs) 0;\n  font-weight: 600;\n  font-size: var(--text-xs);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--text-secondary);\n  border-bottom: 2px solid var(--border-color);\n}\n\n.preprint-stats-table-row {\n  display: grid;\n  grid-template-columns: 1fr 80px 80px 80px;\n  gap: var(--space-sm);\n  padding: 6px 0;\n  border-bottom: 1px solid var(--border-color);\n  color: var(--text-color);\n}\n\n.preprint-stats-table-row .preprint-stats-value {\n  text-align: right;\n}\n\n.preprint-completeness-dot {\n  font-size: 12px;\n}\n\n/* Tree View */\n.preprint-tree-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: var(--space-xl);\n  text-align: center;\n}\n\n.preprint-tree-layout {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n}\n\n.preprint-tree-toolbar {\n  display: flex;\n  gap: var(--space-xs);\n  padding: var(--space-sm) 0;\n  margin-bottom: var(--space-sm);\n  flex-shrink: 0;\n}\n\n/* Two-pane split layout */\n.preprint-tree-split {\n  display: flex;\n  flex: 1;\n  min-height: 0;\n  gap: var(--space-md);\n}\n\n.preprint-tree-left {\n  flex: 0 0 45%;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  min-width: 0;\n}\n\n.preprint-tree-right {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  min-width: 0;\n}\n\n.preprint-tree-container {\n  flex: 1;\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-md, 6px);\n  background: var(--bg-primary);\n  overflow: hidden;\n}\n\n.preprint-tree-container.drop-ready {\n  border-color: var(--accent-color);\n}\n\n.preprint-tree-container.drop-hover {\n  background: color-mix(in srgb, var(--accent-color) 5%, transparent);\n}\n\n.preprint-tree-node {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 2px 8px;\n  cursor: pointer;\n  user-select: none;\n  font-size: var(--text-sm);\n  color: var(--text-color);\n  border-radius: 3px;\n}\n\n.preprint-tree-node:hover {\n  background: var(--bg-secondary);\n}\n\n.preprint-tree-node.selected {\n  background: color-mix(in srgb, var(--accent-color) 15%, transparent);\n}\n\n.preprint-tree-node-icon {\n  flex-shrink: 0;\n  width: 20px;\n  text-align: center;\n  font-size: 13px;\n}\n\n.preprint-tree-node-name {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.preprint-tree-node-edit {\n  flex: 1;\n  background: var(--bg-primary);\n  border: 1px solid var(--accent-color);\n  border-radius: 3px;\n  padding: 1px 4px;\n  font-size: var(--text-sm);\n  color: var(--text-color);\n  outline: none;\n}\n\n.preprint-tree-node-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n  font-size: var(--text-xs);\n}\n\n.preprint-tree-node-wc {\n  font-family: var(--font-mono, monospace);\n  color: var(--text-secondary);\n}\n\n.preprint-tree-node-ic {\n  color: var(--text-secondary);\n}\n\n.preprint-tree-node-status {\n  font-size: 10px;\n}\n\n/* Input */\n.preprint-input {\n  width: 100%;\n  padding: var(--space-sm);\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  outline: none;\n}\n\n.preprint-input:focus {\n  border-color: var(--accent-color);\n}\n\n/* Modal */\n.preprint-modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 50%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.preprint-modal {\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  padding: var(--space-lg);\n  min-width: 320px;\n  max-width: 500px;\n}\n\n.preprint-modal.picker {\n  max-width: 600px;\n  max-height: 80vh;\n  display: flex;\n  flex-direction: column;\n}\n\n.preprint-modal h3 {\n  margin: 0 0 var(--space-md);\n  font-size: var(--text-lg);\n  color: var(--text-color);\n}\n\n.preprint-modal-actions {\n  display: flex;\n  gap: var(--space-sm);\n  justify-content: flex-end;\n  margin-top: var(--space-md);\n}\n\n/* Content Picker */\n.preprint-picker-list {\n  flex: 1;\n  overflow-y: auto;\n  max-height: 400px;\n  margin-top: var(--space-sm);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n}\n\n.preprint-picker-item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  width: 100%;\n  padding: var(--space-sm);\n  background: transparent;\n  border: none;\n  border-bottom: 1px solid var(--border-color);\n  color: var(--text-color);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  text-align: left;\n}\n\n.preprint-picker-item:hover {\n  background: var(--bg-secondary);\n}\n\n.preprint-picker-item:last-child {\n  border-bottom: none;\n}\n\n.preprint-picker-item-icon {\n  flex-shrink: 0;\n  width: 20px;\n  text-align: center;\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.preprint-picker-item-name {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.preprint-picker-item-sub {\n  flex-shrink: 0;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n}\n\n/* Content Palette (right pane) */\n.preprint-palette {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-md, 6px);\n  background: var(--bg-primary);\n  overflow: hidden;\n}\n\n.preprint-palette-controls {\n  flex-shrink: 0;\n  padding: var(--space-sm);\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-xs);\n}\n\n.preprint-palette-search {\n  width: 100%;\n  padding: 4px 8px;\n  font-size: var(--text-sm);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n.preprint-palette-search:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n.preprint-palette-filters {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.preprint-palette-chip {\n  padding: 2px 8px;\n  font-size: var(--text-xs);\n  border: 1px solid var(--border-color);\n  border-radius: 12px;\n  background: transparent;\n  color: var(--text-secondary);\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.preprint-palette-chip:hover {\n  background: var(--bg-secondary);\n  color: var(--text-color);\n}\n\n.preprint-palette-chip.active {\n  background: color-mix(in srgb, var(--accent-color) 15%, transparent);\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n.preprint-palette-sort {\n  margin-left: auto;\n  padding: 2px 4px;\n  font-size: var(--text-xs);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  background: var(--bg-primary);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.preprint-palette-list {\n  flex: 1;\n  overflow-y: auto;\n  min-height: 0;\n}\n\n.preprint-palette-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px var(--space-sm);\n  border-bottom: 1px solid color-mix(in srgb, var(--border-color) 50%, transparent);\n  cursor: grab;\n  font-size: var(--text-sm);\n  color: var(--text-color);\n}\n\n.preprint-palette-item:hover {\n  background: var(--bg-secondary);\n}\n\n.preprint-palette-item:active {\n  cursor: grabbing;\n}\n\n.preprint-palette-item.disabled {\n  cursor: default;\n  opacity: 0.5;\n}\n\n.preprint-palette-item.disabled:hover {\n  background: transparent;\n}\n\n.preprint-palette-item.dragging {\n  opacity: 0.4;\n  background: color-mix(in srgb, var(--accent-color) 8%, transparent);\n}\n\n.preprint-palette-item-icon {\n  flex-shrink: 0;\n  width: 18px;\n  text-align: center;\n  font-size: 11px;\n  color: var(--text-secondary);\n}\n\n.preprint-palette-item-name {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n\n.preprint-palette-item-sub {\n  flex-shrink: 0;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  max-width: 120px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.preprint-palette-item-wc {\n  flex-shrink: 0;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  font-variant-numeric: tabular-nums;\n  min-width: 40px;\n  text-align: right;\n}\n\n.preprint-palette-empty {\n  padding: var(--space-lg);\n  text-align: center;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n}\n\n.preprint-palette-footer {\n  flex-shrink: 0;\n  padding: 4px var(--space-sm);\n  border-top: 1px solid var(--border-color);\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n}\n\n.preprint-palette-hint {\n  font-style: italic;\n}\n\n/* Export View */\n.preprint-export {\n  max-width: 700px;\n}\n\n.preprint-export-config {\n  margin-bottom: var(--space-lg);\n}\n\n.preprint-export-format-selector {\n  display: flex;\n  gap: var(--space-sm);\n}\n\n.preprint-export-format-option {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-sm);\n  flex: 1;\n  padding: var(--space-sm) var(--space-md);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-md, 6px);\n  cursor: pointer;\n  background: transparent;\n  transition:\n    border-color 0.15s,\n    background 0.15s;\n}\n\n.preprint-export-format-option:hover {\n  background: var(--bg-secondary);\n}\n\n.preprint-export-format-option.active {\n  border-color: var(--accent-color);\n  background: color-mix(in srgb, var(--accent-color) 8%, transparent);\n}\n\n.preprint-export-format-option input[type=\"radio\"] {\n  margin-top: 3px;\n  accent-color: var(--accent-color);\n}\n\n.preprint-export-format-label {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.preprint-export-format-label strong {\n  font-size: var(--text-sm);\n  color: var(--text-color);\n}\n\n.preprint-export-format-label span {\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n}\n\n.preprint-export-select,\n.preprint-export-input {\n  padding: 3px 6px;\n  font-size: var(--text-xs);\n  background: var(--bg-primary);\n  color: var(--text-color);\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm, 4px);\n  min-width: 140px;\n}\n\n.preprint-export-input {\n  min-width: 180px;\n}\n\n.preprint-export-select:focus,\n.preprint-export-input:focus {\n  outline: none;\n  border-color: var(--accent-color);\n}\n\n/* ============================================================================\n   Chronicle Workspace\n   ============================================================================ */\n\n.chronicle-workspace {\n  display: flex;\n  flex-direction: column;\n  max-width: 900px;\n  height: 100%;\n}\n\n.chronicle-workspace-header {\n  position: sticky;\n  top: 0;\n  z-index: 5;\n  background: var(--bg-primary);\n  padding: var(--space-md) var(--space-lg);\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: var(--space-md);\n  flex-shrink: 0;\n}\n\n.chronicle-workspace-header-info h3 {\n  margin: 0;\n  font-size: var(--text-xl);\n}\n\n.chronicle-workspace-header-stats {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n\n.chronicle-workspace-header-actions {\n  display: flex;\n  gap: var(--space-sm);\n  align-items: center;\n  flex-shrink: 0;\n}\n\n.workspace-subtabs {\n  display: flex;\n  gap: var(--space-xs);\n  padding: var(--space-sm) var(--space-lg);\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-secondary);\n  flex-shrink: 0;\n}\n\n.workspace-subtab {\n  padding: var(--space-xs) var(--space-md);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.workspace-subtab:hover {\n  background: var(--bg-primary);\n  color: var(--text-color);\n}\n\n.workspace-subtab.active {\n  background: var(--bg-primary);\n  border-color: var(--accent-color);\n  color: var(--accent-color);\n}\n\n.workspace-subtab.right-aligned {\n  margin-left: auto;\n  opacity: 0.7;\n}\n\n.workspace-subtab.right-aligned.active {\n  opacity: 1;\n}\n\n.workspace-tab-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: var(--space-lg);\n}\n\n.workspace-overflow-menu {\n  position: relative;\n}\n\n.workspace-overflow-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  margin-top: 4px;\n  min-width: 160px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  box-shadow: 0 8px 24px rgb(0 0 0 / 30%);\n  z-index: 10;\n  padding: 4px;\n}\n\n.workspace-overflow-item {\n  display: block;\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  background: transparent;\n  border: none;\n  border-radius: 4px;\n  color: var(--text-secondary);\n  font-size: var(--text-sm);\n  cursor: pointer;\n  text-align: left;\n  transition: background 0.1s ease;\n}\n\n.workspace-overflow-item:hover {\n  background: var(--bg-tertiary);\n  color: var(--text-color);\n}\n\n/* Coverage matrix */\n.illuminator-coverage-summary {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  padding: 0 16px 12px;\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.illuminator-coverage-table {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: auto;\n  background: var(--bg-secondary);\n  margin: 0 16px 16px;\n  max-height: 60vh;\n}\n\n.illuminator-coverage-table table {\n  width: max-content;\n  min-width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n}\n\n.illuminator-coverage-table th,\n.illuminator-coverage-table td {\n  border-bottom: 1px solid var(--border-color);\n  border-right: 1px solid var(--border-color);\n  padding: 4px 6px;\n  font-size: 10px;\n  text-align: center;\n  background: var(--bg-secondary);\n}\n\n.illuminator-coverage-table th {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  background: var(--bg-tertiary);\n  font-weight: 600;\n  min-width: 60px;\n}\n\n.illuminator-coverage-sticky {\n  position: sticky;\n  left: 0;\n  z-index: 3;\n  background: var(--bg-secondary);\n  text-align: left;\n  min-width: 180px;\n  max-width: 240px;\n}\n\n.illuminator-coverage-table th.illuminator-coverage-sticky {\n  background: var(--bg-tertiary);\n  z-index: 4;\n}\n\n.illuminator-coverage-fact-header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  justify-content: center;\n}\n\n.illuminator-coverage-fact-id {\n  max-width: 110px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.illuminator-coverage-required {\n  font-size: 9px;\n  padding: 1px 4px;\n  border-radius: 3px;\n  background: var(--accent-primary);\n  color: white;\n}\n\n.illuminator-coverage-chronicle-title {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-primary);\n  margin-bottom: 2px;\n}\n\n.illuminator-coverage-chronicle-meta {\n  font-size: 10px;\n  color: var(--text-muted);\n  font-family: monospace;\n}\n\n.illuminator-coverage-hit,\n.illuminator-coverage-miss {\n  display: inline-block;\n  width: 12px;\n  height: 12px;\n  border-radius: 999px;\n}\n\n.illuminator-coverage-hit {\n  background: var(--success, #22c55e);\n  border: 1px solid rgb(0 0 0 / 30%);\n  box-shadow: 0 0 0 1px rgb(0 0 0 / 25%);\n}\n\n.illuminator-coverage-miss {\n  border: 1px solid rgb(148 163 184 / 50%);\n  background: rgb(15 23 42 / 20%);\n  opacity: 0.5;\n}\n\n.illuminator-coverage-toggle-col {\n  min-width: 56px;\n}\n\n.illuminator-coverage-unparsed-col {\n  min-width: 70px;\n}\n\n.illuminator-coverage-total-col {\n  font-weight: 600;\n  background: var(--bg-tertiary);\n}\n\n.illuminator-coverage-total-row td {\n  background: var(--bg-tertiary);\n  font-weight: 600;\n}\n\n.illuminator-coverage-row-disabled td {\n  opacity: 0.5;\n}\n\n/* ── Entity Coverage Tables ────────────────────────────────────────── */\n\n.entity-coverage-table {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: auto;\n  background: var(--bg-secondary);\n  margin: 0 8px 8px;\n  max-height: 420px;\n}\n\n.entity-coverage-table table {\n  width: max-content;\n  min-width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n}\n\n.entity-coverage-table th,\n.entity-coverage-table td {\n  border-bottom: 1px solid var(--border-color);\n  padding: 5px 10px;\n  font-size: 12px;\n  white-space: nowrap;\n  background: var(--bg-secondary);\n}\n\n.entity-coverage-table th {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  background: var(--bg-tertiary);\n  font-size: 10px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  color: var(--text-muted);\n  cursor: pointer;\n  user-select: none;\n}\n\n.entity-coverage-table th.ec-active {\n  color: var(--text-primary);\n}\n\n.entity-coverage-table th.ec-no-sort {\n  cursor: default;\n}\n\n.entity-coverage-table th.ec-right,\n.entity-coverage-table td.ec-right {\n  text-align: right;\n}\n\n.entity-coverage-table td.ec-name {\n  font-weight: 500;\n  color: var(--text-primary);\n  max-width: 240px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.entity-coverage-table td.ec-muted {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.entity-coverage-table td.ec-center {\n  text-align: center;\n}\n\n.entity-coverage-table .ec-empty td {\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 11px;\n  padding: 12px 10px;\n}\n\n.illuminator-coverage-table td:last-child,\n.illuminator-coverage-table th:last-child {\n  border-right: none;\n}\n\n.illuminator-coverage-table tr:last-child td {\n  border-bottom: none;\n}\n\n.entity-coverage-table tr:last-child td {\n  border-bottom: none;\n}\n\n/* ── Entity Coverage 2-column Grid ───────────────────────────────── */\n\n.ec-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n\n.ec-grid-cell {\n  min-width: 0; /* prevent table content from blowing out grid column */\n}\n\n/* ── Page Layout Editor ─────────────────────────────────────────── */\n\n.preprint-layout-editor {\n  padding: var(--space-sm);\n  border-top: 1px solid var(--border-color);\n}\n\n.preprint-layout-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: var(--space-sm);\n}\n\n.preprint-layout-title {\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n\n.preprint-layout-clear {\n  flex-shrink: 0;\n  padding: 2px 8px;\n  font-size: var(--text-xs);\n  background: transparent;\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.preprint-layout-clear:hover {\n  border-color: var(--text-secondary);\n  color: var(--text-primary);\n}\n\n.preprint-layout-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.preprint-layout-row {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.preprint-layout-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.preprint-layout-label-block {\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  font-weight: 500;\n}\n\n.preprint-layout-select {\n  width: 100%;\n  padding: 3px 6px;\n  font-size: var(--text-xs);\n  background: var(--bg-input, var(--bg-secondary));\n  border: 1px solid var(--border-color);\n  border-radius: var(--radius-sm);\n  color: var(--text-primary);\n}\n\n.preprint-layout-text {\n  font-size: var(--text-xs) !important;\n  padding: 3px 6px !important;\n}\n\n.preprint-layout-actions {\n  margin-top: var(--space-sm);\n  display: flex;\n  justify-content: flex-end;\n}\n\n.preprint-layout-save {\n  padding: 4px 16px;\n  font-size: var(--text-xs);\n  font-weight: 600;\n  background: var(--accent-color, #c49a5c);\n  border: none;\n  border-radius: var(--radius-sm);\n  color: var(--bg-primary, #1a1814);\n  cursor: pointer;\n}\n\n.preprint-layout-save:hover {\n  filter: brightness(1.1);\n}\n\n.preprint-layout-loading {\n  font-size: var(--text-xs);\n  color: var(--text-secondary);\n  padding: var(--space-sm);\n}\n","structuredPatch":[{"oldStart":1,"oldLines":59,"newStart":1,"newLines":13,"lines":["-/* Arctic Blue Theme - Illuminator (with Purple accent for enrichment) */","-:root {","-  /* Backgrounds - Arctic deep blues */","-  --bg-primary: #0a1929;","-  --bg-secondary: #1e3a5f;","-  --bg-tertiary: #2d4a6f;","-  --bg-sidebar: #0c1f2e;","+/* Arctic Blue Theme — Shared base (backgrounds, borders, text, spacing, fonts, reset) */","+@import \"@the-canonry/shared-components/styles/arctic-theme-base\";"," ","-  /* Borders - Blue tinted */","-  --border-color: rgb(59 130 246 / 30%);","-  --border-light: rgb(59 130 246 / 50%);","-","-  /* Text - Ice white tones */","-  --text-color: #fff;","-  --text-secondary: #93c5fd;","-  --text-muted: #60a5fa;","-","-  /* Illuminator accent (purple for enrichment/magic within arctic theme) */","+/* Illuminator accent overrides (purple for enrichment/magic) */","+:root {","   --accent-color: #a855f7;","   --accent-hover: #c084fc;","-","-  /* Arctic theme variables */","-  --arctic-deep: #0a1929;","-  --arctic-dark: #1e3a5f;","-  --arctic-mid: #2d4a6f;","-  --arctic-ice: #3b82f6;","-  --arctic-frost: #60a5fa;","-  --arctic-light: #93c5fd;","   --purple-accent: #a855f7;","   --purple-dark: #9333ea;"," ","-  /* Consistent spacing scale */","-  --space-xs: 4px;","-  --space-sm: 8px;","-  --space-md: 12px;","-  --space-lg: 16px;","-  --space-xl: 24px;","-","-  /* Consistent