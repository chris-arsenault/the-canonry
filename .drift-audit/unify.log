color: var(--text-muted);\n   166→}\n   167→\n   168→/* Failed state */\n   169→.chm-failed {\n   170→  text-align: center;\n   171→  padding: 20px 0;\n   172→}\n   173→\n   174→.chm-failed-msg {\n   175→  font-size: 14px;\n   176→  color: #ef4444;\n   177→  margin-bottom: 8px;\n   178→}\n   179→\n   180→.chm-failed-error {\n   181→  font-size: 12px;\n   182→  color: var(--text-muted);\n   183→  margin-bottom: 16px;\n   184→}\n   185→\n   186→/* Review state */\n   187→.chm-review-hint {\n   188→  font-size: 12px;\n   189→  color: var(--text-muted);\n   190→  margin-bottom: 12px;\n   191→}\n   192→\n   193→.chm-assignments {\n   194→  display: flex;\n   195→  flex-direction: column;\n   196→  gap: 8px;\n   197→}\n   198→\n   199→.chm-assignment-card {\n   200→  padding: 10px 12px;\n   201→  background: var(--bg-primary);\n   202→  border: 1px solid var(--border-color);\n   203→  border-radius: 6px;\n   204→}\n   205→\n   206→.chm-assignment-row {\n   207→  display: flex;\n   208→  align-items: center;\n   209→  gap: 10px;\n   210→}\n   211→\n   212→.chm-year-input {\n   213→  width: 60px;\n   214→  padding: 4px 6px;\n   215→  font-size: 13px;\n   216→  font-weight: 600;\n   217→  text-align: center;\n   218→  background: var(--bg-tertiary);\n   219→  border: 1px solid var(--border-color);\n   220→  border-radius: 4px;\n   221→  color: var(--text-primary);\n   222→}\n   223→\n   224→.chm-assignment-title {\n   225→  font-size: 13px;\n   226→  flex: 1;\n   227→}\n   228→\n   229→.chm-reasoning-btn {\n   230→  background: none;\n   231→  border: none;\n   232→  cursor: pointer;\n   233→  font-size: 11px;\n   234→  color: var(--text-muted);\n   235→  padding: 2px 4px;\n   236→}\n   237→\n   238→.chm-reasoning-text {\n   239→  margin-top: 6px;\n   240→  padding-top: 6px;\n   241→  border-top: 1px solid var(--border-color);\n   242→  font-size: 12px;\n   243→  color: var(--text-muted);\n   244→  font-style: italic;\n   245→}\n   246→\n   247→/* Footer */\n   248→.chm-footer {\n   249→  padding: 12px 20px;\n   250→  border-top: 1px solid var(--border-color);\n   251→  display: flex;\n   252→  justify-content: flex-end;\n   253→  gap: 8px;\n   254→}\n   255→\n   256→.chm-apply-btn {\n   257→  background: var(--accent-primary);\n   258→  color: #fff;\n   259→  font-weight: 600;\n   260→}\n   261→"}]},"parent_tool_use_id":null,"session_id":"9f489ea2-964b-4b12-9123-73dad996ade9","uuid":"a3570324-19d2-4365-926c-95cf897ed386","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/ChronologyModal.css","content":"/* ChronologyModal — chm- prefix */\n\n.chm-overlay {\n  position: fixed;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n  background: rgb(0 0 0 / 50%);\n}\n\n.chm-dialog {\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 12px;\n  width: 600px;\n  max-height: 80vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* Header */\n.chm-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.chm-header-title {\n  font-weight: 600;\n  font-size: 15px;\n}\n\n.chm-close-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 18px;\n  color: var(--text-muted);\n  padding: 4px;\n}\n\n/* Body */\n.chm-body {\n  padding: 20px;\n  overflow: auto;\n  flex: 1;\n}\n\n/* Setup */\n.chm-field {\n  margin-bottom: 16px;\n}\n\n.chm-field-label {\n  display: block;\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 6px;\n}\n\n.chm-era-select {\n  width: 100%;\n  font-size: 13px;\n}\n\n.chm-list-header {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 6px;\n  display: flex;\n  justify-content: space-between;\n}\n\n.chm-list-header-right {\n  text-transform: none;\n  font-weight: 400;\n}\n\n.chm-chronicle-list {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n  max-height: 300px;\n  overflow-y: auto;\n}\n\n.chm-chronicle-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 12px;\n  font-size: 12px;\n}\n\n.chm-chronicle-row-bordered {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.chm-prep-icon {\n  font-size: 10px;\n  flex-shrink: 0;\n  width: 12px;\n  text-align: center;\n}\n\n.chm-prep-icon-ready {\n  color: #8b7355;\n}\n\n.chm-prep-icon-none {\n  color: var(--text-muted);\n}\n\n.chm-chronicle-name {\n  flex: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.chm-era-year {\n  font-size: 10px;\n  color: var(--text-muted);\n  flex-shrink: 0;\n}\n\n.chm-start-btn {\n  width: 100%;\n  padding: 10px;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n.chm-start-btn-active {\n  background: var(--accent-primary);\n  color: #fff;\n  opacity: 1;\n}\n\n.chm-start-btn-disabled {\n  opacity: 0.5;\n}\n\n/* Generating state */\n.chm-generating {\n  text-align: center;\n  padding: 40px 0;\n}\n\n.chm-generating-msg {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-bottom: 8px;\n}\n\n.chm-generating-target {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Failed state */\n.chm-failed {\n  text-align: center;\n  padding: 20px 0;\n}\n\n.chm-failed-msg {\n  font-size: 14px;\n  color: #ef4444;\n  margin-bottom: 8px;\n}\n\n.chm-failed-error {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 16px;\n}\n\n/* Review state */\n.chm-review-hint {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 12px;\n}\n\n.chm-assignments {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.chm-assignment-card {\n  padding: 10px 12px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n}\n\n.chm-assignment-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.chm-year-input {\n  width: 60px;\n  padding: 4px 6px;\n  font-size: 13px;\n  font-weight: 600;\n  text-align: center;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  color: var(--text-primary);\n}\n\n.chm-assignment-title {\n  font-size: 13px;\n  flex: 1;\n}\n\n.chm-reasoning-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 11px;\n  color: var(--text-muted);\n  padding: 2px 4px;\n}\n\n.chm-reasoning-text {\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid var(--border-color);\n  font-size: 12px;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* Footer */\n.chm-footer {\n  padding: 12px 20px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.chm-apply-btn {\n  background: var(--accent-primary);\n  color: #fff;\n  font-weight: 600;\n}\n","numLines":261,"startLine":1,"totalLines":261}}}
