x {\n    68→  background-color: rgb(59 130 246 / 10%);\n    69→  border: 1px solid rgb(59 130 246 / 30%);\n    70→  border-radius: var(--radius-lg);\n    71→  padding: var(--spacing-lg) var(--spacing-xl);\n    72→  margin-bottom: var(--spacing-xl);\n    73→  font-size: var(--font-size-sm);\n    74→  color: var(--color-text-muted);\n    75→  line-height: var(--line-height-normal);\n    76→}\n    77→\n    78→.info-box-placement {\n    79→  margin-bottom: var(--spacing-md);\n    80→}\n    81→\n    82→.info-box-title {\n    83→  font-size: var(--font-size-base);\n    84→  font-weight: var(--font-weight-semibold);\n    85→  color: var(--color-text-dim);\n    86→  margin-bottom: var(--spacing-xs);\n    87→}\n    88→\n    89→.info-box-text {\n    90→  font-size: var(--font-size-md);\n    91→  color: var(--color-text-muted);\n    92→  line-height: var(--line-height-normal);\n    93→}\n    94→\n    95→/* Category section */\n    96→.category-section {\n    97→  margin-bottom: var(--spacing-2xl);\n    98→}\n    99→\n   100→.category-header {\n   101→  display: flex;\n   102→  align-items: center;\n   103→  gap: var(--spacing-lg);\n   104→  padding: var(--spacing-lg) var(--spacing-xl);\n   105→  background-color: var(--color-bg-card);\n   106→  border-radius: var(--radius-lg);\n   107→  border: 1px solid var(--color-border);\n   108→  cursor: pointer;\n   109→  margin-bottom: var(--spacing-lg);\n   110→  transition: all var(--transition-fast);\n   111→}\n   112→\n   113→.category-header:hover {\n   114→  border-color: var(--color-accent);\n   115→}\n   116→\n   117→.category-icon {\n   118→  font-size: var(--font-size-2xl);\n   119→}\n   120→\n   121→.category-title {\n   122→  flex: 1;\n   123→  font-size: 15px;\n   124→  font-weight: var(--font-weight-semibold);\n   125→  color: var(--color-text);\n   126→}\n   127→\n   128→.category-expand {\n   129→  font-size: var(--font-size-base);\n   130→  color: var(--color-text-muted);\n   131→  transition: transform var(--transition