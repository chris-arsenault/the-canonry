0-d91bb975f470","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/WorldContextEditor.css","content":"/* WorldContextEditor.css — co-located styles for WorldContextEditor.jsx */\n\n/* =========================================================================\n   Shared patterns\n   ========================================================================= */\n\n.wce-field-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: block;\n  margin-bottom: 4px;\n}\n\n.wce-field-label-mb6 {\n  margin-bottom: 6px;\n}\n\n.wce-description-text {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 12px;\n}\n\n.wce-input-sm {\n  font-size: 12px;\n}\n\n.wce-remove-btn {\n  background: none;\n  border: none;\n  color: var(--danger);\n  cursor: pointer;\n  padding: 2px 6px;\n  font-size: 14px;\n}\n\n.wce-remove-btn-sm {\n  font-size: 13px;\n}\n\n/* =========================================================================\n   FactCard\n   ========================================================================= */\n\n.wce-fact-card {\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n  margin-bottom: 8px;\n  overflow: hidden;\n}\n\n.wce-fact-card-disabled {\n  opacity: 0.5;\n}\n\n.wce-fact-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 12px;\n  cursor: pointer;\n}\n\n.wce-fact-chevron {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.wce-fact-id {\n  font-size: 11px;\n  font-family: monospace;\n  color: var(--accent-color);\n  min-width: 120px;\n}\n\n.wce-fact-preview {\n  flex: 1;\n  font-size: 12px;\n  color: var(--text-secondary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wce-fact-type-badge {\n  font-size: 10px;\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.wce-fact-type-badge-truth {\n  background: var(--bg-secondary);\n  color: var(--text-muted);\n}\n\n.wce-fact-type-badge-constraint {\n  background: var(--warning-bg, #4a3f00);\n  color: var(--warning, #ffc107);\n}\n\n.wce-fact-status-badge {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n}\n\n.wce-fact-status-badge-required {\n  color: var(--accent-color);\n}\n\n.wce-fact-status-badge-disabled {\n  color: var(--text-muted);\n}\n\n/* Expanded detail panel */\n.wce-fact-detail {\n  padding: 12px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.wce-fact-detail-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: 10px;\n}\n\n.wce-checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n}\n\n.wce-checkbox-text {\n  color: var(--text-secondary);\n}\n\n/* =========================================================================\n   FactsEditor — add row\n   ========================================================================= */\n\n.wce-add-row {\n  display: flex;\n  gap: 8px;\n  margin-top: 12px;\n}\n\n.wce-add-input {\n  flex: 1;\n  font-size: 12px;\n}\n\n/* =========================================================================\n   WorldDynamicCard\n   ========================================================================= */\n\n.wce-dynamic-card {\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n  margin-bottom: 8px;\n  overflow: hidden;\n}\n\n.wce-dynamic-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 12px;\n  cursor: pointer;\n}\n\n.wce-dynamic-chevron {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.wce-dynamic-id {\n  font-size: 11px;\n  font-family: monospace;\n  color: var(--accent-color);\n  min-width: 120px;\n}\n\n.wce-dynamic-preview {\n  flex: 1;\n  font-size: 12px;\n  color: var(--text-secondary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wce-dynamic-scope-badge {\n  font-size: 10px;\n  padding: 2px 6px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  color: var(--text-muted);\n}\n\n/* Dynamic detail panel */\n.wce-dynamic-detail {\n  padding: 12px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.wce-dynamic-detail-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n}\n\n/* Era override card */\n.wce-override-card {\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  padding: 8px 10px;\n  margin-bottom: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.wce-override-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 6px;\n}\n\n.wce-override-era-name {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--accent-color);\n}\n\n.wce-override-replace-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  margin-left: auto;\n}\n\n/* Add override row */\n.wce-add-override-row {\n  display: flex;\n  gap: 8px;\n  margin-top: 4px;\n}\n\n.wce-add-override-select {\n  flex: 1;\n  font-size: 12px;\n}\n\n.wce-add-override-btn {\n  font-size: 12px;\n}\n\n/* =========================================================================\n   ToneFragmentsEditor\n   ========================================================================= */\n\n.wce-tone-layout {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.wce-tone-core-label {\n  font-size: 12px;\n  font-weight: 500;\n  display: block;\n  margin-bottom: 6px;\n}\n\n.wce-tone-note {\n  font-size: 11px;\n  color: var(--text-muted);\n  padding: 10px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n}\n\n/* =========================================================================\n   EditableList\n   ========================================================================= */\n\n.wce-editable-list-add {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n.wce-editable-list-add-input {\n  flex: 1;\n}\n\n.wce-editable-list-items {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.wce-editable-list-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  font-size: 12px;\n}\n\n.wce-editable-list-item-text {\n  flex: 1;\n}\n\n.wce-editable-list-remove {\n  background: none;\n  border: none;\n  color: var(--danger);\n  cursor: pointer;\n  padding: 2px 6px;\n}\n\n/* =========================================================================\n   Main component — info banner\n   ========================================================================= */\n\n.wce-info-banner {\n  padding: 12px 16px;\n  margin-bottom: 16px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border-left: 3px solid var(--accent-color);\n}\n\n.wce-info-banner-title {\n  font-weight: 500;\n  margin-bottom: 4px;\n}\n\n.wce-info-banner-desc {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* =========================================================================\n   Chronicle Generation section\n   ========================================================================= */\n\n.wce-section-divider {\n  margin-top: 24px;\n  padding-top: 24px;\n  border-top: 2px solid var(--accent-color);\n}\n\n.wce-section-header {\n  margin-bottom: 16px;\n}\n\n.wce-section-title {\n  font-size: 16px;\n  font-weight: 600;\n  margin: 0;\n}\n\n.wce-section-subtitle {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 4px;\n}\n\n/* Facet range */\n.wce-facet-range-row {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.wce-facet-range-input {\n  max-width: 100px;\n}\n\n.wce-facet-range-separator {\n  color: var(--text-muted);\n}\n\n.wce-facet-range-hint {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 6px;\n}\n\n/* World Dynamics header with flex actions */\n.wce-dynamics-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.wce-dynamics-actions {\n  display: flex;\n  gap: 6px;\n}\n\n.wce-dynamics-btn {\n  padding: 4px 12px;\n  font-size: 11px;\n}\n\n/* Textarea dynamic size presets */\n.wce-textarea-description {\n  min-height: 100px;\n  resize: vertical;\n}\n\n.wce-textarea-tone {\n  min-height: 80px;\n  resize: vertical;\n}\n\n.wce-textarea-compact {\n  min-height: 60px;\n  resize: vertical;\n  font-size: 12px;\n}\n\n.wce-textarea-compact-short {\n  min-height: 40px;\n}\n\n.wce-textarea-core-tone {\n  min-height: 200px;\n  resize: vertical;\n  font-size: 12px;\n}\n\n/* Override form group */\n.wce-form-group-mb16 {\n  margin-bottom: 16px;\n}\n","numLines":454,"startLine":1,"totalLines":454}}}
