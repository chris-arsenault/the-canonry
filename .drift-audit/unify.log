{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019hQz7SuJt2wpyeGzSRouMj","type":"tool_result","content":"     1→/**\n     2→ * ToolUsageBadges - Cross-tool usage badges\n     3→ *\n     4→ * Shows badges indicating where an item is used across different tools:\n     5→ * - Name Forge (naming profiles)\n     6→ * - Seed (seed entities)\n     7→ * - Coherence (coherence engine)\n     8→ * - Lore Weave (simulation)\n     9→ */\n    10→\n    11→import React from 'react';\n    12→\n    13→interface ToolBadgeConfig {\n    14→  label: string;\n    15→  icon: string;\n    16→  className: string;\n    17→  tooltip: string;\n    18→}\n    19→\n    20→interface ToolUsageBadgesProps {\n    21→  usage?: Record<string, number>;\n    22→  compact?: boolean;\n    23→  showZero?: boolean;\n    24→}\n    25→\n    26→// Badge configurations for different tool types\n    27→const BADGE_CONFIG: Record<string, ToolBadgeConfig> = {\n    28→  nameforge: {\n    29→    label: 'Name Forge',\n    30→    icon: '\\u270E',\n    31→    className: 'tool-badge-nameforge',\n    32→    tooltip: 'Used in Name Forge profiles',\n    33→  },\n    34→  seed: {\n    35→    label: 'Seed',\n    36→    icon: '\\u25C9',\n    37→    className: 'tool-badge-seed',\n    38→    tooltip: 'Used in seed entities',\n    39→  },\n    40→  generators: {\n    41→    label: 'Gen',\n    42→    icon: '\\u2728', // sparkles\n    43→    className: 'tool-badge-generators',\n    44→    tooltip: 'Used in generators (creation, applicability, effects)',\n    45→  },\n    46→  systems: {\n    47→    label: 'Sys',\n    48→    icon: '\\u2699', // gear\n    49→    className: 'tool-badge-systems',\n    50→    tooltip: 'Used in systems (tag diffusion, triggers)',\n    51→  },\n    52→  pressures: {\n    53→    label: 'Pres',\n    54→    icon: '\\u2191', // up arrow\n    55→    className: 'tool-badge-pressures',\n    56→    tooltip: 'Used in pressure feedback factors',\n    57→  },\n    58→  axis: {\n    59→    label: 'Axis',\n    60→    icon: '\\u2194', // left-right arrow\n    61→    className: 'tool-badge-axis',\n    62→    tooltip: 'Semantic plane axis label',\n    63→  },\n    64→  coherence: {\n    65→    label: 'Coherence',\n    66→    icon: '\\u2699',\n    67→    className: 'tool-badge-coherence',\n    68→    tooltip: 'Used in Coherence Engine',\n    69→  },\n    70→  loreweave: {\n    71→    label: 'Lore Weave',\n    72→    icon: '\\u25C8',\n    73→    className: 'tool-badge-loreweave',\n    74→    tooltip: 'Used in Lore Weave',\n    75→  },\n    76→};\n    77→\n    78→export function ToolUsageBadges({ usage = {}, compact = false, showZero = false }: ToolUsageBadgesProps) {\n    79→  const badges = Object.entries(usage)\n    80→    .filter(([_type, count]) => showZero || count > 0)\n    81→    .filter(([type]) => BADGE_CONFIG[type]);\n    82→\n    83→  if (badges.length === 0) {\n    84→    return null;\n    85→  }\n    86→\n    87→  return (\n    88→    <div className=\"tool-badge-container\">\n    89→      {badges.map(([type, count]) => {\n    90→        const config = BADGE_CONFIG[type];\n    91→        return (\n    92→          <span\n    93→            key={type}\n    94→            className={`tool-badge ${config.className}`}\n    95→            title={`${config.tooltip}${count > 1 ? ' (' + count + ' uses)' : ''}`}\n    96→          >\n    97→            <span className=\"tool-badge-icon\">{config.icon}</span>\n    98→            {!compact && <span className=\"tool-badge-label\">{config.label}</span>}\n    99→            {count > 1 && <span className=\"tool-badge-count\">&times;{count}</span>}\n   100→          </span>\n   101→        );\n   102→      })}\n   103→    </div>\n   104→  );\n   105→}\n   106→\n   107→export default ToolUsageBadges;\n   108→"}]},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"2f8fa98b-5c2e-48b7-bfce-6cc14c4e7bd6"}
