{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AKWj4W9cdFnjXFonBZkTU8","type":"tool_result","content":"     1→/**\n     2→ * useImageGenSettings - Global image generation settings hook\n     3→ *\n     4→ * Centralizes all image generation preferences (style, composition, palette,\n     5→ * size, quality, culture) in localStorage so they persist across tab navigation\n     6→ * and page refresh. Used by the ImageSettingsDrawer and consumed by\n     7→ * EntityBrowser, ChroniclePanel, and worker tasks.\n     8→ */\n     9→\n    10→import { useState, useCallback, useEffect, useRef } from \"react\";\n    11→\n    12→export interface ImageGenSettings {\n    13→  artisticStyleId: string;\n    14→  compositionStyleId: string;\n    15→  colorPaletteId: string;\n    16→  imageSize: string;\n    17→  imageQuality: string;\n    18→  selectedCultureId: string;\n    19→  collapsedSections: string[];\n    20→}\n    21→\n    22→const STORAGE_KEY = \"illuminator:imageGenSettings\";\n    23→const LEGACY_STYLE_KEY = \"illuminator:styleSelection\";\n    24→\n    25→const DEFAULTS: ImageGenSettings = {\n    26→  artisticStyleId: \"random\",\n    27→  compositionStyleId: \"random\",\n    28→  colorPaletteId: \"random\",\n    29→  imageSize: \"auto\",\n    30→  imageQuality: \"auto\",\n    31→  selectedCultureId: \"\",\n    32→  collapsedSections: [],\n    33→};\n    34→\n    35→function loadSettings(): ImageGenSettings {\n    36→  try {\n    37→    const saved = localStorage.getItem(STORAGE_KEY);\n    38→    if (saved) {\n    39→      return { ...DEFAULTS, ...(JSON.parse(saved) as Partial<ImageGenSettings>) };\n    40→    }\n    41→\n    42→    // Migrate from legacy styleSelection key\n    43→    const legacyStyle = localStorage.getItem(LEGACY_STYLE_KEY);\n    44→    if (legacyStyle) {\n    45→      const parsed = JSON.parse(legacyStyle) as Partial<ImageGenSettings>;\n    46→      const migrated: ImageGenSettings = {\n    47→        ...DEFAULTS,\n    48→        artisticStyleId: parsed.artisticStyleId || DEFAULTS.artisticStyleId,\n    49→        compositionStyleId: parsed.compositionStyleId || DEFAULTS.compositionStyleId,\n    50→        colorPaletteId: parsed.colorPaletteId || DEFAULTS.colorPaletteId,"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"00834352-1e8f-449d-a497-7952a8afb351"}
