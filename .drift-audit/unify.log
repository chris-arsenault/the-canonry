{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VxzP98UFzhAv4uJnvhRfxC","type":"tool_result","content":"     1→import { useCallback } from \"react\";\n     2→\n     3→/**\n     4→ * Reusable keyboard navigation for search dropdowns.\n     5→ *\n     6→ * Handles ArrowDown/ArrowUp to move selection, Enter to confirm,\n     7→ * and Escape with a caller-supplied callback.\n     8→ *\n     9→ * @param {object} opts\n    10→ * @param {Array}    opts.results        - The current result set (Fuse-style objects with `.item.id`).\n    11→ * @param {number}   opts.selectedIndex  - Currently highlighted index.\n    12→ * @param {Function} opts.setSelectedIndex - State setter for the index.\n    13→ * @param {Function} opts.onSelect       - Called with the selected item's id on Enter.\n    14→ * @param {Function} opts.onEscape       - Called when Escape is pressed.\n    15→ * @returns {Function} A stable onKeyDown handler (memoised via useCallback).\n    16→ */\n    17→export function useKeyboardNavigation({\n    18→  results,\n    19→  selectedIndex,\n    20→  setSelectedIndex,\n    21→  onSelect,\n    22→  onEscape,\n    23→}) {\n    24→  return useCallback(\n    25→    (e) => {\n    26→      if (results.length === 0) return;\n    27→\n    28→      switch (e.key) {\n    29→        case \"ArrowDown\":\n    30→          e.preventDefault();\n    31→          setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n    32→          break;\n    33→        case \"ArrowUp\":\n    34→          e.preventDefault();\n    35→          setSelectedIndex((i) => Math.max(i - 1, 0));\n    36→          break;\n    37→        case \"Enter\":\n    38→          e.preventDefault();\n    39→          if (results[selectedIndex]) onSelect(results[selectedIndex].item.id);\n    40→          break;\n    41→        case \"Escape\":\n    42→          onEscape();\n    43→          break;\n    44→      }\n    45→    },\n    46→    [results, selectedIndex, setSelectedIndex, onSelect, onEscape]\n    47→  );\n    48→}\n    49→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"dcc0defe-1c73-4a9b-a8da-b68e065fcdfa"}
