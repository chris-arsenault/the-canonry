 flex;\n  gap: 12px;\n  flex-wrap: wrap;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.tre-usage-inputs {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.tre-usage-number {\n  width: 60px;\n  padding: 4px 6px;\n  text-align: center;\n}\n\n.tre-merge-label {\n  margin-left: 8px;\n}\n\n.tre-merge-select {\n  width: auto;\n  padding: 2px 6px;\n  font-size: 12px;\n}\n\n.tre-grid-3col {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n}\n\n.tre-section-label {\n  margin-bottom: 6px;\n}\n\n.tre-chip-section {\n  margin-bottom: 4px;\n}\n\n.tre-chip-compact {\n  padding: 4px 8px;\n  font-size: 12px;\n}\n\n.tre-chip-framework {\n  pointer-events: none;\n  opacity: 0.6;\n}\n\n.tre-chip-remove-sm {\n  font-size: 14px;\n}\n\n.tre-add-select {\n  width: auto;\n  padding: 2px 6px;\n  font-size: 12px;\n  min-width: 80px;\n}\n\n.tre-conflicts-label {\n  margin-bottom: 6px;\n  color: var(--color-danger);\n}\n\n.tre-chip-conflict {\n  padding: 4px 8px;\n  font-size: 12px;\n  background-color: rgba(239, 68, 68, 0.2);\n}\n","structuredPatch":[{"oldStart":72,"oldLines":11,"newStart":72,"newLines":6,"lines":["   cursor: pointer;"," }"," ","-.tre-checkbox {","-  width: 14px;","-  height: 14px;","-}","-"," .tre-description-wrapper {","   margin-bottom: 12px;"," }"]}],"userModified":false,"replaceAll":false}}
