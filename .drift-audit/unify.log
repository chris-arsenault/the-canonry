{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3d3jGkGrTkiD56GtChXWL","type":"tool_result","content":"useApiKeys.js\nuseBackportFlow.js\nuseBulkBackport.ts\nuseBulkHistorian.ts\nuseChronicleActions.ts\nuseChronicleGeneration.ts\nuseChronicleLoreBackport.ts\nuseChronicleQueueWatcher.ts\nuseConfigSync.js\nuseDataSync.js\nuseDynamicsFlow.js\nuseDynamicsGeneration.ts\nuseEnrichmentQueue.ts\nuseEntityCrud.ts\nuseEntityGuidanceSync.js\nuseEraNarrative.ts\nuseFactCoverage.ts\nuseHistorianActions.ts\nuseHistorianCallbacks.js\nuseHistorianChronology.ts\nuseHistorianConfigSync.js\nuseHistorianEdition.ts\nuseHistorianReview.ts\nuseIlluminatorSetup.js\nuseImageGenSettings.ts\nusePromptBuilder.js\nuseRevisionFlow.js\nuseSlotManagement.js\nuseStyleLibrary.ts\nuseSummaryRevision.ts\nuseToneRanking.ts\nuseWorldContextSync.js","is_error":false}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"89561171-43e4-42ef-a6e1-4f1261e46c17"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01BRRdTuQm7naWSgy4Zbhczq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CjEcumtMGPoBrumFptgyyF","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/hooks/usePromptBuilder.js"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":399,"cache_read_input_tokens":31518,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":399},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"49a0c8cb-0778-402f-837b-f3224facb752"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CjEcumtMGPoBrumFptgyyF","type":"tool_result","content":"     1→/**\n     2→ * usePromptBuilder - Hook for building entity description and image prompts\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Contains:\n     5→ * - getVisualConfig: resolve visual config for an entity from guidance\n     6→ * - buildPrompt: build description or image prompts using guidance + culture identities\n     7→ *\n     8→ * Complex logic is extracted into module-level functions to keep\n     9→ * cognitive complexity of each callback under 10.\n    10→ */\n    11→\n    12→import { useCallback } from \"react\";\n    13→import {\n    14→  buildDescriptionPromptFromGuidance,\n    15→  buildImagePromptFromGuidance,\n    16→  getVisualConfigFromGuidance,\n    17→} from \"../lib/promptBuilders\";\n    18→import { resolveStyleSelection } from \"../components/StyleSelector\";\n    19→import { prominenceLabelFromScale, getEntityEvents, getEntityEffects } from \"@canonry/world-schema\";\n    20→\n    21→// --- Module-level helpers to reduce callback complexity ---\n    22→\n    23→/**\n    24→ * Resolve the eraId for an entity.\n    25→ */\n    26→function resolveEntityEraId(entity) {\n    27→  if (!entity) return undefined;\n    28→  if (typeof entity.eraId === \"string\" && entity.eraId) return entity.eraId;\n    29→  return undefined;\n    30→}\n    31→\n    32→/**\n    33→ * Build the relationships array for an entity prompt context.\n    34→ */\n    35→function buildRelationshipsForPrompt(entity, relationshipsByEntity, entityNavMap) {\n    36→  return (relationshipsByEntity.get(entity.id) || []).slice(0, 8).map((rel) => {\n    37→    const targetId = rel.src === entity.id ? rel.dst : rel.src;\n    38→    const target = entityNavMap.get(targetId);\n    39→    return {\n    40→      kind: rel.kind,\n    41→      targetName: target?.name || targetId,\n    42→      targetKind: target?.kind || \"unknown\",\n    43→      targetSubtype: target?.subtype,\n    44→      strength: rel.strength,\n    45→    };\n    46→  });\n    47→}\n    48→\n    49→function resolveVisualFields(entity) {\n    50→  const text = entity.enrichment?.text;\n    51→  return { visualThesis: text?.visualThesis || \"\", visualTraits: text?.visualTraits || [] };\n    52→}\n    53→\n    54→function buildEntityFields(entity) {\n    55→  return {\n    56→    id: entity.id,\n    57→    name: entity.name,\n    58→    kind: entity.kind,\n    59→    subtype: entity.subtype,\n    60→    culture: entity.culture || \"\",\n    61→    status: entity.status || \"active\",\n    62→    summary: entity.summary || \"\",\n    63→    description: entity.description || \"\",\n    64→    tags: entity.tags || {},\n    65→    ...resolveVisualFields(entity),\n    66→  };\n    67→}\n    68→\n    69→function buildEntityContext(entity, params) {\n    70→  const { relationshipsByEntity, entityNavMap, prominenceScale, currentEra, prominentByCulture } =\n    71→    params;\n    72→  return {\n    73→    entity: {\n    74→      ...buildEntityFields(entity),\n    75→      prominence: prominenceLabelFromScale(entity.prominence, prominenceScale),\n    76→    },\n    77→    relationships: buildRelationshipsForPrompt(entity, relationshipsByEntity, entityNavMap),\n    78→    era: { name: currentEra?.name || \"\", description: currentEra?.description },\n    79→    entityAge: \"established\",\n    80→    culturalPeers: (prominentByCulture[entity.culture] || [])\n    81→      .filter((peer) => peer.id !== entity.id)\n    82→      .slice(0, 3)\n    83→      .map((peer) => peer.name),\n    84→  };\n    85→}\n    86→\n    87→/**\n    88→ * Build a description prompt for an entity (module-level, no closure deps).\n    89→ */\n    90→function buildEntityDescriptionPrompt(entity, params) {\n    91→  const {\n    92→    entityGuidance,\n    93→    cultureIdentities,\n    94→    worldContext,\n    95→    relationshipsByEntity,\n    96→    entityNavMap,\n    97→    prominenceScale,\n    98→    currentEra,\n    99→    narrativeEvents,\n   100→    prominentByCulture,\n   101→    config,\n   102→  } = params;\n   103→\n   104→  const entityContext = buildEntityContext(entity, {\n   105→    relationshipsByEntity,\n   106→    entityNavMap,\n   107→    prominenceScale,\n   108→    currentEra,\n   109→    prominentByCulture,\n   110→  });\n   111→\n   112→  // Get entity events from narrative history (filtered by significance)\n   113→  const entityEvents = getEntityEvents(narrativeEvents, {\n   114→    entityId: entity.id,\n   115→    minSignificance: config.minEventSignificance ?? 0.25,\n   116→    excludeProminenceOnly: true,\n   117→    limit: 10, // Cap at 10 events to avoid prompt bloat\n   118→  });\n   119→\n   120→  // Add events to entity context (use era name instead of tick)\n   121→  entityContext.events = entityEvents.map((e) => {\n   122→    const eraEntity = entityNavMap.get(e.era);\n   123→    const eraName = eraEntity?.name || e.era;\n   124→    return {\n   125→      era: eraName,\n   126→      description: e.description,\n   127→      significance: e.significance,\n   128→      effects: getEntityEffects(e, entity.id).map((eff) => ({\n   129→        type: eff.type,\n   130→        description: eff.description,\n   131→      })),\n   132→    };\n   133→  });\n   134→\n   135→  return buildDescriptionPromptFromGuidance(\n   136→    entityGuidance,\n   137→    cultureIdentities,\n   138→    worldContext,\n   139→    entityContext\n   140→  );\n   141→}\n   142→\n   143→/**\n   144→ * Build an image prompt for an entity (module-level, no closure deps).\n   145→ */\n   146→function buildEntityImagePrompt(entity, params) {\n   147→  const {\n   148→    entityGuidance,\n   149→    cultureIdentities,\n   150→    worldContext,\n   151→    relationshipsByEntity,\n   152→    entityNavMap,\n   153→    prominenceScale,\n   154→    currentEra,\n   155→    prominentByCulture,\n   156→    styleSelection,\n   157→    worldSchema,\n   158→    styleLibrary,\n   159→  } = params;\n   160→\n   161→  const entityContext = buildEntityContext(entity, {\n   162→    relationshipsByEntity,\n   163→    entityNavMap,\n   164→    prominenceScale,\n   165→    currentEra,\n   166→    prominentByCulture,\n   167→  });\n   168→\n   169→  // Resolve style selection for this entity\n   170→  const resolvedStyle = resolveStyleSelection({\n   171→    selection: styleSelection,\n   172→    entityCultureId: entity.culture,\n   173→    entityKind: entity.kind,\n   174→    cultures: worldSchema?.cultures || [],\n   175→    styleLibrary,\n   176→  });\n   177→\n   178→  // Build style info for the prompt\n   179→  const styleInfo = {\n   180→    artisticPromptFragment: resolvedStyle.artisticStyle?.promptFragment,\n   181→    compositionPromptFragment: resolvedStyle.compositionStyle?.promptFragment,\n   182→    colorPalettePromptFragment: resolvedStyle.colorPalette?.promptFragment,\n   183→    cultureKeywords: resolvedStyle.cultureKeywords,\n   184→  };\n   185→\n   186→  return buildImagePromptFromGuidance(\n   187→    entityGuidance,\n   188→    cultureIdentities,\n   189→    worldContext,\n   190→    entityContext,\n   191→    styleInfo\n   192→  );\n   193→}\n   194→\n   195→// --- Main hook ---\n   196→\n   197→export function usePromptBuilder({\n   198→  entityGuidance,\n   199→  cultureIdentities,\n   200→  worldContext,\n   201→  relationshipsByEntity,\n   202→  entityNavMap,\n   203→  currentEra,\n   204→  narrativeEvents,\n   205→  prominentByCulture,\n   206→  styleSelection,\n   207→  worldSchema,\n   208→  config,\n   209→  prominenceScale,\n   210→  styleLibrary,\n   211→  eraTemporalInfo,\n   212→  eraTemporalInfoByKey,\n   213→}) {\n   214→  // Get visual config for an entity (thesis/traits prompts, avoid elements, era)\n   215→  const getVisualConfig = useCallback(\n   216→    (entity) => {\n   217→      const visualConfig = getVisualConfigFromGuidance(entityGuidance, entity.kind);\n   218→\n   219→      const entityEraId = resolveEntityEraId(entity);\n   220→      const entityFocalEra = entityEraId ? eraTemporalInfoByKey.get(entityEraId) : undefined;\n   221→      const entityAllEras = eraTemporalInfo.length > 0 ? eraTemporalInfo : undefined;\n   222→\n   223→      return {\n   224→        ...visualConfig,\n   225→        entityEraId,\n   226→        entityFocalEra,\n   227→        entityAllEras,\n   228→      };\n   229→    },\n   230→    [entityGuidance, eraTemporalInfo, eraTemporalInfoByKey]\n   231→  );\n   232→\n   233→  // Build prompt for entity using EntityGuidance and CultureIdentities directly\n   234→  const buildPrompt = useCallback(\n   235→    (entity, type) => {\n   236→      const params = {\n   237→        entityGuidance,\n   238→        cultureIdentities,\n   239→        worldContext,\n   240→        relationshipsByEntity,\n   241→        entityNavMap,\n   242→        prominenceScale,\n   243→        currentEra,\n   244→        narrativeEvents,\n   245→        prominentByCulture,\n   246→        styleSelection,\n   247→        worldSchema,\n   248→        styleLibrary,\n   249→        config,\n   250→      };\n   251→\n   252→      if (type === \"description\") {\n   253→        return buildEntityDescriptionPrompt(entity, params);\n   254→      }\n   255→      if (type === \"image\") {\n   256→        return buildEntityImagePrompt(entity, params);\n   257→      }\n   258→      return `Describe ${entity.name}, a ${entity.subtype} ${entity.kind}.`;\n   259→    },\n   260→    [\n   261→      worldContext,\n   262→      entityGuidance,\n   263→      cultureIdentities,\n   264→      relationshipsByEntity,\n   265→      entityNavMap,\n   266→      currentEra,\n   267→      narrativeEvents,\n   268→      prominentByCulture,\n   269→      styleSelection,\n   270→      worldSchema,\n   271→      styleLibrary,\n   272→      config,\n   273→      prominenceScale,\n   274→    ]\n   275→  );\n   276→\n   277→  return { buildPrompt, getVisualConfig };\n   278→}\n   279→"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"b1106639-0755-4d07-8e8c-7a61b111893e"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01BRRdTuQm7naWSgy4Zbhczq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014uNzoEFK4MPUV6sfTr8eka","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/hooks/useDynamicsFlow.js"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":399,"cache_read_input_tokens":31518,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":399},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"78cdd5fd-5446-4b94-9896-d1ad36c6b698"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014uNzoEFK4MPUV6sfTr8eka","type":"tool_result","content":"     1→/**\n     2→ * useDynamicsFlow - Hook for world dynamics generation workflow\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Contains:\n     5→ * - handleDynamicsAccepted: merge proposed dynamics into worldContext\n     6→ * - handleGenerateDynamics: launch dynamics generation with full context\n     7→ * - Delegates to useDynamicsGeneration for the LLM multi-turn flow\n     8→ */\n     9→\n    10→import { useCallback } from \"react\";\n    11→import { useDynamicsGeneration } from \"./useDynamicsGeneration\";\n    12→import * as entityRepo from \"../lib/db/entityRepository\";\n    13→import { getPublishedStaticPagesForProject } from \"../lib/db/staticPageRepository\";\n    14→\n    15→// --- Module-level helpers ---\n    16→\n    17→const buildSchemaContext = (schema) => {\n    18→  if (!schema) return \"\";\n    19→  const sections = [];\n    20→  if (schema.entityKinds?.length) {\n    21→    sections.push(\"Entity Kinds: \" + schema.entityKinds.map((k) => k.kind).join(\", \"));\n    22→  }\n    23→  if (schema.relationshipKinds?.length) {\n    24→    sections.push(\"Relationship Kinds: \" + schema.relationshipKinds.map((k) => k.kind).join(\", \"));\n    25→  }\n    26→  if (schema.cultures?.length) {\n    27→    sections.push(\"Cultures: \" + schema.cultures.map((c) => c.name || c.id).join(\", \"));\n    28→  }\n    29→  return sections.join(\"\\n\");\n    30→};\n    31→\n    32→/**\n    33→ * Map proposed dynamics into the worldDynamics format.\n    34→ */\n    35→function mapProposedDynamics(proposedDynamics) {\n    36→  return proposedDynamics.map((d, i) => ({\n    37→    id: `dyn_gen_${Date.now()}_${i}`,\n    38→    text: d.text,\n    39→    cultures: d.cultures?.length ? d.cultures : undefined,\n    40→    kinds: d.kinds?.length ? d.kinds : undefined,\n    41→    eraOverrides:\n    42→      d.eraOverrides && Object.keys(d.eraOverrides).length > 0 ? d.eraOverrides : undefined,\n    43→  }));\n    44→}\n    45→\n    46→/**\n    47→ * Load static pages context for dynamics prompt.\n    48→ */\n    49→async function loadStaticPagesContext(projectId) {\n    50→  try {\n    51→    const pages = await getPublishedStaticPagesForProject(projectId);\n    52→    if (pages.length > 0) {\n    53→      return pages.map((p) => `## ${p.title}\\n\\n${p.content}`).join(\"\\n\\n---\\n\\n\");\n    54→    }\n    55→  } catch (err) {\n    56→    console.warn(\"[Dynamics] Failed to load static pages:\", err);\n    57→  }\n    58→  return \"\";\n    59→}\n    60→\n    61→/**\n    62→ * Build entity context array for dynamics generation.\n    63→ */\n    64→function buildEntityContexts(allEntities) {\n    65→  return allEntities.map((e) => ({\n    66→    id: e.id,\n    67→    name: e.name,\n    68→    kind: e.kind,\n    69→    subtype: e.subtype || \"\",\n    70→    culture: e.culture || \"\",\n    71→    status: e.status || \"\",\n    72→    summary: e.summary || \"\",\n    73→    description: e.description || \"\",\n    74→    tags: e.tags || {},\n    75→    eraId: e.eraId,\n    76→  }));\n    77→}\n    78→\n    79→/**\n    80→ * Build relationships payload with resolved names.\n    81→ */\n    82→function buildRelationshipsPayload(relationships, entityNavMap) {\n    83→  return relationships.map((r) => ({\n    84→    src: r.src,\n    85→    dst: r.dst,\n    86→    kind: r.kind,\n    87→    weight: r.weight ?? r.strength,\n    88→    srcName: entityNavMap.get(r.src)?.name || r.src,\n    89→    dstName: entityNavMap.get(r.dst)?.name || r.dst,\n    90→  }));\n    91→}\n    92→\n    93→// --- Main hook ---\n    94→\n    95→export function useDynamicsFlow({\n    96→  projectId,\n    97→  simulationRunId,\n    98→  worldContext,\n    99→  worldSchema,\n   100→  entityNavMap,\n   101→  relationships,\n   102→  updateWorldContext,\n   103→}) {\n   104→  // Handle accepted dynamics from LLM\n   105→  const handleDynamicsAccepted = useCallback(\n   106→    (proposedDynamics) => {\n   107→      if (!proposedDynamics?.length) return;\n   108→      const newDynamics = mapProposedDynamics(proposedDynamics);\n   109→      const existing = worldContext?.worldDynamics || [];\n   110→      updateWorldContext({ worldDynamics: [...existing, ...newDynamics] });\n   111→    },\n   112→    [worldContext, updateWorldContext]\n   113→  );\n   114→\n   115→  const {\n   116→    run: dynamicsRun,\n   117→    isActive: isDynamicsActive,\n   118→    startGeneration: startDynamicsGeneration,\n   119→    submitFeedback: submitDynamicsFeedback,\n   120→    acceptDynamics,\n   121→    cancelGeneration: cancelDynamicsGeneration,\n   122→  } = useDynamicsGeneration(handleDynamicsAccepted);\n   123→\n   124→  // Launch dynamics generation with full world context\n   125→  const handleGenerateDynamics = useCallback(async () => {\n   126→    if (!projectId || !simulationRunId) return;\n   127→\n   128→    const staticPagesContext = await loadStaticPagesContext(projectId);\n   129→    const schemaContext = buildSchemaContext(worldSchema);\n   130→\n   131→    // Build entity context -- load full entities from Dexie (needs description, tags)\n   132→    const allEntities = await entityRepo.getEntitiesForRun(simulationRunId);\n   133→    const entityContexts = buildEntityContexts(allEntities);\n   134→    const relationshipsPayload = buildRelationshipsPayload(relationships, entityNavMap);\n   135→\n   136→    startDynamicsGeneration({\n   137→      projectId,\n   138→      simulationRunId,\n   139→      staticPagesContext,\n   140→      schemaContext,\n   141→      entities: entityContexts,\n   142→      relationships: relationshipsPayload,\n   143→    });\n   144→  }, [\n   145→    projectId,\n   146→    simulationRunId,\n   147→    worldSchema,\n   148→    entityNavMap,\n   149→    relationships,\n   150→    startDynamicsGeneration,\n   151→  ]);\n   152→\n   153→  return {\n   154→    dynamicsRun,\n   155→    isDynamicsActive,\n   156→    handleGenerateDynamics,\n   157→    submitDynamicsFeedback,\n   158→    acceptDynamics,\n   159→    cancelDynamicsGeneration,\n   160→  };\n   161→}\n   162→"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"3b611b09-4fec-441c-945d-3bfdc76bf9bf"}
