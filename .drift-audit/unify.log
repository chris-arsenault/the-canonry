d);\n   233→  gap: var(--spacing-sm);\n   234→}\n   235→\n   236→.condition-editor-header {\n   237→  display: flex;\n   238→  gap: var(--spacing-md);\n   239→  align-items: center;\n   240→}\n   241→\n   242→.condition-editor-header > *:first-child {\n   243→  flex: 1;\n   244→}\n   245→\n   246→.condition-editor-body {\n   247→  padding-top: var(--spacing-sm);\n   248→}\n   249→\n   250→.type-selector {\n   251→  gap: var(--spacing-sm);\n   252→  margin-top: var(--spacing-xs);\n   253→}\n   254→\n   255→.type-pill {\n   256→  gap: var(--spacing-xs);\n   257→  padding: var(--spacing-sm) var(--spacing-md);\n   258→  border-radius: var(--radius-md);\n   259→  font-size: var(--font-size-sm);\n   260→}\n   261→\n   262→.type-pill-icon {\n   263→  font-size: var(--font-size-lg);\n   264→}\n   265→\n   266→.type-description {\n   267→  margin-top: var(--spacing-sm);\n   268→}\n   269→"}]},"parent_tool_use_id":null,"session_id":"3b5ce8f0-862b-4723-9467-f6e56df17d06","uuid":"9dfd1e26-0301-48c1-bcec-e30f5c293ffc","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/styles/components/compact-overrides.css","content":"/**\n * Coherence Engine compact overrides\n *\n * These override shared-components base styles with tighter spacing\n * appropriate for the configuration editor's information-dense layout.\n * Shared-components CSS is loaded first (in CoherenceEngineRemote.jsx);\n * these rules override only the properties that differ.\n */\n\n/* Buttons: tighter padding for dense config forms */\n.btn-primary,\n.btn-secondary,\n.btn-danger {\n  padding: 8px 14px;\n}\n\n.add-card {\n  gap: var(--spacing-sm);\n  padding: 10px;\n  font-size: var(--font-size-sm);\n  border: 1px dashed var(--color-border);\n  border-radius: var(--radius-lg);\n}\n\n.btn-tab {\n  gap: var(--spacing-md);\n  padding: 10px 12px;\n  font-size: var(--font-size-md);\n  border-radius: var(--radius-md);\n}\n\n.btn-tab .btn-tab-icon {\n  font-size: var(--font-size-lg);\n  line-height: 1;\n}\n\n/* Modal: tighter padding */\n.modal-header {\n  padding: 14px 20px;\n}\n\n.modal-body-single {\n  padding: var(--spacing-xl);\n}\n\n.modal-content {\n  padding: var(--spacing-xl);\n  background-color: var(--color-bg-elevated);\n}\n\n.modal-footer {\n  padding: var(--spacing-lg) var(--spacing-xl);\n}\n\n/* Toggle: smaller for compact forms */\n.toggle {\n  width: 30px;\n  height: 16px;\n  border-radius: 8px;\n}\n\n.toggle-knob {\n  width: 12px;\n  height: 12px;\n}\n\n.toggle-on .toggle-knob {\n  transform: translateX(14px);\n}\n\n.toggle-container {\n  gap: var(--spacing-sm);\n}\n\n.toggle-label {\n  font-size: var(--font-size-sm);\n}\n\n/* Section: tighter spacing for dense config layout */\n.section {\n  margin-bottom: 20px;\n}\n\n.section-header {\n  margin-bottom: var(--spacing-md);\n}\n\n.section-title {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n  gap: var(--spacing-sm);\n}\n\n.section-icon {\n  font-size: var(--font-size-lg);\n  line-height: 1;\n}\n\n.section-count {\n  font-size: var(--font-size-xs);\n  padding: 1px 6px;\n  color: var(--color-text-dim);\n  font-weight: var(--font-weight-medium);\n}\n\n.nested-section {\n  padding: 10px;\n  background-color: var(--color-bg-nested);\n  border-radius: var(--radius-md);\n  margin-top: 10px;\n}\n\n.nested-title {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: var(--spacing-sm);\n}\n\n.info-box {\n  padding: var(--spacing-md) var(--spacing-lg);\n  margin-bottom: var(--spacing-lg);\n}\n\n.category-header {\n  gap: var(--spacing-md);\n  padding: 10px 14px;\n  margin-bottom: var(--spacing-md);\n}\n\n/* Form: compact sizing for dense config forms */\n.form-group,\n.input-group {\n  gap: var(--spacing-xs);\n}\n\n.form-grid {\n  gap: var(--spacing-lg);\n}\n\n.label {\n  font-size: var(--font-size-xs);\n  letter-spacing: 0.4px;\n}\n\n.form-help-text {\n  font-size: var(--font-size-xs);\n  margin-bottom: var(--spacing-sm);\n}\n\n.alert {\n  padding: var(--spacing-sm) var(--spacing-md);\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-xs);\n  margin-top: var(--spacing-sm);\n}\n\n.input {\n  padding: 6px 8px;\n  font-size: var(--font-size-md);\n  border-radius: var(--radius-md);\n}\n\n.textarea {\n  padding: 6px 8px;\n  font-size: var(--font-size-md);\n  border-radius: var(--radius-md);\n  min-height: 60px;\n}\n\n.select {\n  padding: 6px 8px;\n  font-size: var(--font-size-md);\n  border-radius: var(--radius-md);\n}\n\n.checkbox {\n  width: 14px;\n  height: 14px;\n  flex-shrink: 0;\n}\n\n.checkbox-label {\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n}\n\n.slider {\n  height: 4px;\n  border-radius: 2px;\n}\n\n.slider-row {\n  gap: var(--spacing-md);\n}\n\n.slider-value {\n  font-size: var(--font-size-md);\n  min-width: 32px;\n}\n\n.chip-container {\n  gap: var(--spacing-xs);\n}\n\n.chip {\n  gap: var(--spacing-xs);\n  padding: 3px 8px;\n  font-size: var(--font-size-xs);\n}\n\n.chip-remove {\n  font-size: var(--font-size-sm);\n}\n\n.chip-container-input {\n  padding: 4px;\n  min-height: 30px;\n}\n\n.chip-input {\n  min-width: 80px;\n  padding: 2px 4px;\n  font-size: var(--font-size-sm);\n}\n\n.condition-editor {\n  padding: 8px 12px;\n  background-color: var(--color-bg-nested);\n  gap: var(--spacing-sm);\n}\n\n.condition-editor-header {\n  display: flex;\n  gap: var(--spacing-md);\n  align-items: center;\n}\n\n.condition-editor-header > *:first-child {\n  flex: 1;\n}\n\n.condition-editor-body {\n  padding-top: var(--spacing-sm);\n}\n\n.type-selector {\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-xs);\n}\n\n.type-pill {\n  gap: var(--spacing-xs);\n  padding: var(--spacing-sm) var(--spacing-md);\n  border-radius: var(--radius-md);\n  font-size: var(--font-size-sm);\n}\n\n.type-pill-icon {\n  font-size: var(--font-size-lg);\n}\n\n.type-description {\n  margin-top: var(--spacing-sm);\n}\n","numLines":269,"startLine":1,"totalLines":269}}}
