{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Eccgo8eDigerCy5yFtxBuH","type":"tool_result","content":"     1→/* BulkOperationShell - shared bulk operation modal styles */\n     2→\n     3→/* Overlay */\n     4→.bulk-overlay {\n     5→  position: fixed;\n     6→  inset: 0;\n     7→  background: rgb(0 0 0 / 50%);\n     8→  display: flex;\n     9→  align-items: center;\n    10→  justify-content: center;\n    11→  z-index: 10000;\n    12→}\n    13→\n    14→/* Dialog */\n    15→.bulk-dialog {\n    16→  background: var(--bg-primary);\n    17→  border-radius: 12px;\n    18→  border: 1px solid var(--border-color);\n    19→  width: var(--bulk-dialog-width, 480px);\n    20→  max-width: 95vw;\n    21→  max-height: 85vh;\n    22→  display: flex;\n    23→  flex-direction: column;\n    24→  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n    25→}\n    26→\n    27→/* Header */\n    28→.bulk-header {\n    29→  padding: 16px 20px;\n    30→  border-bottom: 1px solid var(--border-color);\n    31→  flex-shrink: 0;\n    32→}\n    33→\n    34→.bulk-header-row {\n    35→  display: flex;\n    36→  justify-content: space-between;\n    37→  align-items: center;\n    38→}\n    39→\n    40→.bulk-title {\n    41→  margin: 0;\n    42→  font-size: 16px;\n    43→}\n    44→\n    45→.bulk-header-actions {\n    46→  display: flex;\n    47→  align-items: center;\n    48→  gap: 8px;\n    49→}\n    50→\n    51→.bulk-minimize-btn {\n    52→  padding: 2px 8px;\n    53→  font-size: 11px;\n    54→}\n    55→\n    56→/* Status label */\n    57→.bulk-status {\n    58→  font-size: 12px;\n    59→  font-weight: 500;\n    60→  color: var(--text-muted);\n    61→}\n    62→\n    63→.bulk-status-complete { color: #10b981; }\n    64→.bulk-status-failed { color: #ef4444; }\n    65→.bulk-status-cancelled { color: #f59e0b; }\n    66→\n    67→/* Body */\n    68→.bulk-body {\n    69→  padding: 20px;\n    70→}\n    71→\n    72→.bulk-body-confirming {\n    73→  overflow-y: auto;\n    74→  flex: 1;\n    75→  min-height: 0;\n    76→}\n    77→\n    78→/* Progress bar */\n    79→.bulk-progress-section {\n    80→  margin-bottom: 16px;\n    81→}\n    82→\n    83→.bulk-progress-header {\n    84→  display: flex;\n    85→  justify-content: space-between;\n    86→  align-items: baseline;\n    87→  margin-bottom: 6px;\n    88→}\n    89→\n    90→.bulk-progress-label {\n    91→  font-size: 13px;\n    92→  font-weight: 500;\n    93→}\n    94→\n    95→.bulk-progress-pct {\n    96→  font-size: 12px;\n    97→  color: var(--text-muted);\n    98→}\n    99→\n   100→.bulk-progress-track {\n   101→  height: 8px;\n   102→  border-radius: 4px;\n   103→  background: var(--bg-secondary);\n   104→  overflow: hidden;\n   105→  margin-bottom: 6px;\n   106→}\n   107→\n   108→.bulk-progress-fill {\n   109→  height: 100%;\n   110→  border-radius: 4px;\n   111→  transition: width 0.3s ease;\n   112→  width: var(--bulk-progress-width);\n   113→}\n   114→\n   115→.bulk-progress-fill-ok { background: #10b981; }\n   116→.bulk-progress-fill-failed { background: #ef4444; }\n   117→.bulk-progress-fill-cancelled { background: #f59e0b; }\n   118→\n   119→/* Terminal messages */\n   120→.bulk-terminal-msg {\n   121→  padding: 12px;\n   122→  border-radius: 8px;\n   123→  margin-bottom: 16px;\n   124→  font-size: 12px;\n   125→}\n   126→\n   127→.bulk-terminal-msg-complete {\n   128→  background: rgb(16 185 129 / 10%);\n   129→  border: 1px solid rgb(16 185 129 / 20%);\n   130→}\n   131→\n   132→.bulk-terminal-msg-cancelled {\n   133→  background: rgb(245 158 11 / 10%);\n   134→  border: 1px solid rgb(245 158 11 / 20%);\n   135→}\n   136→\n   137→.bulk-terminal-msg-failed {\n   138→  background: rgb(239 68 68 / 10%);\n   139→  border: 1px solid rgb(239 68 68 / 20%);\n   140→}\n   141→\n   142→/* Failed items */\n   143→.bulk-failed-section {\n   144→  margin-top: 12px;\n   145→}\n   146→\n   147→.bulk-failed-label {\n   148→  font-size: 11px;\n   149→  color: var(--text-muted);\n   150→  text-transform: uppercase;\n   151→  font-weight: 600;\n   152→  margin-bottom: 6px;\n   153→}\n   154→\n   155→.bulk-failed-list {\n   156→  border: 1px solid var(--border-color);\n   157→  border-radius: 8px;\n   158→  overflow: hidden;\n   159→  max-height: 200px;\n   160→  overflow-y: auto;\n   161→}\n   162→\n   163→.bulk-failed-item {\n   164→  padding: 6px 12px;\n   165→  border-bottom: 1px solid var(--border-color);\n   166→  display: flex;\n   167→  justify-content: space-between;\n   168→  align-items: center;\n   169→  gap: 8px;\n   170→}\n   171→\n   172→.bulk-failed-item:last-child {\n   173→  border-bottom: none;\n   174→}\n   175→\n   176→.bulk-failed-item-title {\n   177→  font-size: 12px;\n   178→  overflow: hidden;\n   179→  text-overflow: ellipsis;\n   180→  white-space: nowrap;\n   181→  min-width: 0;\n   182→}\n   183→\n   184→.bulk-failed-item-error {\n   185→  font-size: 11px;\n   186→  color: #ef4444;\n   187→  flex-shrink: 0;\n   188→}\n   189→\n   190→/* Cost */\n   191→.bulk-cost {\n   192→  font-size: 11px;\n   193→  color: var(--text-muted);\n   194→  text-align: right;\n   195→}\n   196→\n   197→/* Footer */\n   198→.bulk-footer {\n   199→  padding: 12px 20px;\n   200→  border-top: 1px solid var(--border-color);\n   201→  display: flex;\n   202→  justify-content: flex-end;\n   203→  gap: 8px;\n   204→  flex-shrink: 0;\n   205→}\n   206→\n   207→.bulk-footer-btn {\n   208→  padding: 6px 16px;\n   209→  font-size: 12px;\n   210→}\n   211→\n   212→/* Shared content patterns */\n   213→.bulk-info-box {\n   214→  padding: 10px 12px;\n   215→  margin-bottom: 12px;\n   216→  border-radius: 8px;\n   217→  background: var(--bg-secondary);\n   218→  font-size: 11px;\n   219→  color: var(--text-secondary);\n   220→  line-height: 1.5;\n   221→}\n   222→\n   223→.bulk-item-list-section {\n   224→  margin-bottom: 12px;\n   225→}\n   226→\n   227→.bulk-section-label {\n   228→  font-size: 11px;\n   229→  color: var(--text-muted);\n   230→  text-transform: uppercase;\n   231→  font-weight: 600;\n   232→  margin-bottom: 8px;\n   233→}\n   234→\n   235→.bulk-item-list {\n   236→  border: 1px solid var(--border-color);\n   237→  border-radius: 8px;\n   238→  overflow: hidden;\n   239→  max-height: 400px;\n   240→  overflow-y: auto;\n   241→}\n   242→\n   243→.bulk-item-list-entry {\n   244→  padding: 6px 12px;\n   245→  border-bottom: 1px solid var(--border-color);\n   246→  font-size: 12px;\n   247→  overflow: hidden;\n   248→  text-overflow: ellipsis;\n   249→  white-space: nowrap;\n   250→}\n   251→\n   252→.bulk-item-list-entry:last-child {\n   253→  border-bottom: none;\n   254→}\n   255→\n   256→.bulk-current-item {\n   257→  margin-bottom: 12px;\n   258→}\n   259→\n   260→.bulk-current-item-title {\n   261→  font-size: 13px;\n   262→  font-weight: 500;\n   263→  margin-bottom: 2px;\n   264→}\n   265→\n   266→.bulk-current-item-sub {\n   267→  font-size: 11px;\n   268→  color: var(--text-muted);\n   269→}\n   270→\n   271→.bulk-progress-detail {\n   272→  font-size: 11px;\n   273→  color: var(--text-muted);\n   274→}\n   275→\n   276→.bulk-failed-inline {\n   277→  color: #ef4444;\n   278→}\n   279→"}]},"parent_tool_use_id":null,"session_id":"9f489ea2-964b-4b12-9123-73dad996ade9","uuid":"1ba3884e-4c23-4313-955b-a2769937d434","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BulkOperationShell.css","content":"/* BulkOperationShell - shared bulk operation modal styles */\n\n/* Overlay */\n.bulk-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgb(0 0 0 / 50%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 10000;\n}\n\n/* Dialog */\n.bulk-dialog {\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  width: var(--bulk-dialog-width, 480px);\n  max-width: 95vw;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* Header */\n.bulk-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  flex-shrink: 0;\n}\n\n.bulk-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.bulk-title {\n  margin: 0;\n  font-size: 16px;\n}\n\n.bulk-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.bulk-minimize-btn {\n  padding: 2px 8px;\n  font-size: 11px;\n}\n\n/* Status label */\n.bulk-status {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--text-muted);\n}\n\n.bulk-status-complete { color: #10b981; }\n.bulk-status-failed { color: #ef4444; }\n.bulk-status-cancelled { color: #f59e0b; }\n\n/* Body */\n.bulk-body {\n  padding: 20px;\n}\n\n.bulk-body-confirming {\n  overflow-y: auto;\n  flex: 1;\n  min-height: 0;\n}\n\n/* Progress bar */\n.bulk-progress-section {\n  margin-bottom: 16px;\n}\n\n.bulk-progress-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin-bottom: 6px;\n}\n\n.bulk-progress-label {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.bulk-progress-pct {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.bulk-progress-track {\n  height: 8px;\n  border-radius: 4px;\n  background: var(--bg-secondary);\n  overflow: hidden;\n  margin-bottom: 6px;\n}\n\n.bulk-progress-fill {\n  height: 100%;\n  border-radius: 4px;\n  transition: width 0.3s ease;\n  width: var(--bulk-progress-width);\n}\n\n.bulk-progress-fill-ok { background: #10b981; }\n.bulk-progress-fill-failed { background: #ef4444; }\n.bulk-progress-fill-cancelled { background: #f59e0b; }\n\n/* Terminal messages */\n.bulk-terminal-msg {\n  padding: 12px;\n  border-radius: 8px;\n  margin-bottom: 16px;\n  font-size: 12px;\n}\n\n.bulk-terminal-msg-complete {\n  background: rgb(16 185 129 / 10%);\n  border: 1px solid rgb(16 185 129 / 20%);\n}\n\n.bulk-terminal-msg-cancelled {\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 20%);\n}\n\n.bulk-terminal-msg-failed {\n  background: rgb(239 68 68 / 10%);\n  border: 1px solid rgb(239 68 68 / 20%);\n}\n\n/* Failed items */\n.bulk-failed-section {\n  margin-top: 12px;\n}\n\n.bulk-failed-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.bulk-failed-list {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n  max-height: 200px;\n  overflow-y: auto;\n}\n\n.bulk-failed-item {\n  padding: 6px 12px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n}\n\n.bulk-failed-item:last-child {\n  border-bottom: none;\n}\n\n.bulk-failed-item-title {\n  font-size: 12px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n\n.bulk-failed-item-error {\n  font-size: 11px;\n  color: #ef4444;\n  flex-shrink: 0;\n}\n\n/* Cost */\n.bulk-cost {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-align: right;\n}\n\n/* Footer */\n.bulk-footer {\n  padding: 12px 20px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.bulk-footer-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n\n/* Shared content patterns */\n.bulk-info-box {\n  padding: 10px 12px;\n  margin-bottom: 12px;\n  border-radius: 8px;\n  background: var(--bg-secondary);\n  font-size: 11px;\n  color: var(--text-secondary);\n  line-height: 1.5;\n}\n\n.bulk-item-list-section {\n  margin-bottom: 12px;\n}\n\n.bulk-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 8px;\n}\n\n.bulk-item-list {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.bulk-item-list-entry {\n  padding: 6px 12px;\n  border-bottom: 1px solid var(--border-color);\n  font-size: 12px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.bulk-item-list-entry:last-child {\n  border-bottom: none;\n}\n\n.bulk-current-item {\n  margin-bottom: 12px;\n}\n\n.bulk-current-item-title {\n  font-size: 13px;\n  font-weight: 500;\n  margin-bottom: 2px;\n}\n\n.bulk-current-item-sub {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.bulk-progress-detail {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.bulk-failed-inline {\n  color: #ef4444;\n}\n","numLines":279,"startLine":1,"totalLines":279}}}
