{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Apx4p7fdMBFmmqhLSKkYz1","type":"tool_result","content":"     1→/**\n     2→ * useEnrichmentQueue - UI-side queue management with multiple workers\n     3→ *\n     4→ * This hook manages the enrichment queue in the UI thread.\n     5→ * Workers are pure executors - this hook handles:\n     6→ * - Queue state (pending, running, completed, errored items)\n     7→ * - Distributing tasks to workers based on estimated workload\n     8→ * - Receiving results and updating entity state\n     9→ * - Progress tracking\n    10→ *\n    11→ * Task distribution uses \"soonest available\" estimation:\n    12→ * workload = num_text_tasks + (10 * num_image_tasks)\n    13→ * Images take ~10x longer than text, so they count more.\n    14→ */\n    15→\n    16→import { useState, useCallback, useRef, useEffect } from \"react\";\n    17→import type {\n    18→  QueueItem,\n    19→  EnrichmentTaskPayload,\n    20→  WorkerTask,\n    21→  EntityEnrichment,\n    22→  ApplyEnrichmentOutput,\n    23→} from \"../lib/enrichmentTypes\";\n    24→import { applyEnrichmentResult } from \"../lib/enrichmentTypes\";\n    25→import type { WorkerConfig, WorkerOutbound } from \"../workers/enrichment.worker\";\n    26→import { createWorkerPool, resetWorkerPool, type WorkerHandle } from \"../lib/workerFactory\";\n    27→import { getResolvedLLMCallSettings, type ResolvedLLMCallSettings } from \"../lib/llmModelSettings\";\n    28→import type { LLMCallType } from \"../lib/llmCallTypes\";\n    29→import type { EnrichmentType } from \"../lib/enrichmentTypes\";\n    30→import { useThinkingStore } from \"../lib/db/thinkingStore\";\n    31→import { executeBrowserTask } from \"../lib/browserTaskExecutor\";\n    32→\n    33→/**\n    34→ * Map enrichment task types to their primary LLM call type.\n    35→ * Used to look up the runInBrowser flag for execution context decisions.\n    36→ */\n    37→const TASK_PRIMARY_CALL_TYPE: Partial<Record<EnrichmentType, LLMCallType>> = {\n    38→  description: \"description.narrative\",\n    39→  visualThesis: \"description.visualThesis\",\n    40→  image: \"image.promptFormatting\",\n    41→  entityChronicle: \"chronicle.generation\",\n    42→  paletteExpansion: \"palette.expansion\",\n    43→  dynamicsGeneration: \"dynamics.generation\",\n    44→  summaryRevision: \"revision.summary\",\n    45→  chronicleLoreBackport: \"revision.loreBackport\",\n    46→  historianEdition: \"historian.edition\",\n    47→  historianReview: \"historian.entityReview\",\n    48→  historianChronology: \"historian.chronology\",\n    49→  historianPrep: \"historian.prep\",\n    50→  eraNarrative: \"historian.eraNarrative.threads\",\n    51→  motifVariation: \"historian.motifVariation\",\n    52→  factCoverage: \"chronicle.factCoverage\",\n    53→  toneRanking: \"chronicle.toneRanking\",\n    54→  bulkToneRanking: \"chronicle.bulkToneRanking\",\n    55→};\n    56→\n    57→function shouldRunInBrowser(taskType: string, settings: ResolvedLLMCallSettings): boolean {\n    58→  const callType = TASK_PRIMARY_CALL_TYPE[taskType as EnrichmentType];\n    59→  if (!callType) return false;\n    60→  return settings[callType]?.runInBrowser ?? false;\n    61→}\n    62→\n    63→export interface EnrichedEntity {\n    64→  id: string;\n    65→  name: string;\n    66→  kind: string;\n    67→  subtype: string;\n    68→  prominence: string;\n    69→  culture: string;\n    70→  status: string;\n    71→  description: string;\n    72→  summary?: string;\n    73→  narrativeHint?: string;\n    74→  lockedSummary?: boolean;\n    75→  tags: Record<string, unknown>;\n    76→  createdAt?: number;\n    77→  enrichment?: EntityEnrichment;\n    78→}\n    79→\n    80→export interface QueueStats {"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"bf39c021-5cac-41d3-bc2f-1364464cb1f6"}
