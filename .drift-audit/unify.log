{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EPp8KWx37Z5LDLTyUpaWfm","type":"tool_result","content":"     1→/**\n     2→ * EraBadges - Displays era usage badges for items\n     3→ */\n     4→\n     5→import React from 'react';\n     6→\n     7→interface Era {\n     8→  id: string;\n     9→  name?: string;\n    10→}\n    11→\n    12→interface EraBadgesProps {\n    13→  eras?: Era[];\n    14→  maxVisible?: number;\n    15→  className?: string;\n    16→}\n    17→\n    18→const ERA_ICON = '🕰️';\n    19→\n    20→/**\n    21→ * @param {Object} props\n    22→ * @param {Array} props.eras - Array of era objects with id and name\n    23→ * @param {number} props.maxVisible - Maximum number of badges to show (default 3)\n    24→ * @param {string} [props.className] - Additional class names\n    25→ */\n    26→export function EraBadges({ eras = [], maxVisible = 3, className = '' }: EraBadgesProps) {\n    27→  if (!eras.length) return null;\n    28→\n    29→  const visible = eras.slice(0, maxVisible);\n    30→  const remaining = eras.length - maxVisible;\n    31→\n    32→  return (\n    33→    <div className={`chip-container mt-md ${className}`.trim()}>\n    34→      {visible.map((era) => (\n    35→        <span key={era.id} className=\"badge badge-era\">\n    36→          <span className=\"badge-era-icon\">{ERA_ICON}</span> {era.name || era.id}\n    37→        </span>\n    38→      ))}\n    39→      {remaining > 0 && (\n    40→        <span className=\"badge badge-era badge-era-remaining\">\n    41→          +{remaining} more\n    42→        </span>\n    43→      )}\n    44→    </div>\n    45→  );\n    46→}\n    47→"}]},"parent_tool_use_id":"toolu_01FzRVY2V2nJRXov651T5ucP","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"03ff3d63-4125-4e44-8925-2a36597c9e3f"}
