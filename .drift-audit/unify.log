-.tv3d-legend-footer {\r","-  background: rgba(255, 215, 0, 0.05);\r","-}\r","-\r","-/* Legend swatch with dynamic color */\r","-.tv3d-legend-swatch {\r","-  background-color: var(--tv3d-swatch-color);\r","-}\r","-\r","-/* Era swatch (non-round, golden) */\r","-.tv3d-era-swatch {\r","-  background-color: #FFD700;\r","-}\r","-\r","-/* Era link indicator */\r","-.tv3d-era-link {\r","-  background-color: #FFD700;\r","-}\r","-\r","-/* Controls hint panel */\r","-.tv3d-controls {\r","-  background: linear-gradient(135deg, rgba(50, 40, 20, 0.95) 0%, rgba(20, 15, 5, 0.95) 100%);\r","-}\r","-\r","-.tv3d-controls-header {\r","-  background: rgba(255, 215, 0, 0.1);\r","-}\r","+/* TimelineView3D Component Styles — component-specific only.","+ * Shared overlay panel styles live in visualization-overlay.css.","+ */","+","+/* Era swatch (non-round, golden) */","+.tv3d-era-swatch {","+  background-color: #FFD700;","+}","+","+/* Era link indicator */","+.tv3d-era-link {","+  background-color: #FFD700;","+}"]}],"originalFile":"/* TimelineView3D Component Styles */\r\n\r\n/* WebGL fallback container */\r\n.tv3d-no-webgl {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: #0a1929;\r\n  color: #93c5fd;\r\n}\r\n\r\n.tv3d-no-webgl-inner {\r\n  text-align: center;\r\n  max-width: 400px;\r\n}\r\n\r\n.tv3d-no-webgl-icon {\r\n  font-size: 48px;\r\n  margin-bottom: 16px;\r\n  opacity: 0.5;\r\n}\r\n\r\n.tv3d-no-webgl-title {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  color: #fff;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.tv3d-no-webgl-message {\r\n  font-size: 13px;\r\n}\r\n\r\n/* Main container */\r\n.tv3d-container {\r\n  position: absolute;\r\n  inset: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Legend panel */\r\n.tv3d-legend {\r\n  background: linear-gradient(135deg, rgba(50, 40, 20, 0.95) 0%, rgba(20, 15, 5, 0.95) 100%);\r\n}\r\n\r\n.tv3d-legend-header {\r\n  background: rgba(255, 215, 0, 0.1);\r\n}\r\n\r\n.tv3d-legend-footer {\r\n  background: rgba(255, 215, 0, 0.05);\r\n}\r\n\r\n/* Legend swatch with dynamic color */\r\n.tv3d-legend-swatch {\r\n  background-color: var(--tv3d-swatch-color);\r\n}\r\n\r\n/* Era swatch (non-round, golden) */\r\n.tv3d-era-swatch {\r\n  background-color: #FFD700;\r\n}\r\n\r\n/* Era link indicator */\r\n.tv3d-era-link {\r\n  background-color: #FFD700;\r\n}\r\n\r\n/* Controls hint panel */\r\n.tv3d-controls {\r\n  background: linear-gradient(135deg, rgba(50, 40, 20, 0.95) 0%, rgba(20, 15, 5, 0.95) 100%);\r\n}\r\n\r\n.tv3d-controls-header {\r\n  background: rgba(255, 215, 0, 0.1);\r\n}\r\n"}}
