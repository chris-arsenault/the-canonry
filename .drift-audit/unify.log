card {\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  text-align: center;\n}\n\n.storage-panel-stat-value {\n  font-size: 24px;\n  font-weight: 600;\n}\n\n.storage-panel-stat-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ─── Per-project breakdown ─── */\n.storage-panel-project-breakdown {\n  margin-top: 12px;\n}\n\n.storage-panel-project-breakdown-title {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n\n.storage-panel-project-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.storage-panel-project-item {\n  padding: 6px 10px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  font-size: 11px;\n}\n\n.storage-panel-project-name {\n  font-weight: 500;\n}\n\n.storage-panel-project-stats {\n  color: var(--text-muted);\n  margin-left: 6px;\n}\n\n/* ─── Browse header ─── */\n.storage-panel-browse-count {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ─── Filters row ─── */\n.storage-panel-filters-row {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 12px;\n  align-items: center;\n}\n\n.storage-panel-filter-select {\n  width: auto;\n  min-width: 150px;\n}\n\n.storage-panel-page-size-group {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.storage-panel-page-size-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.storage-panel-page-size-select {\n  width: auto;\n  min-width: 80px;\n}\n\n/* ─── Selection actions ─── */\n.storage-panel-selection-actions {\n  display: flex;\n  gap: 8px;\n  margin-left: auto;\n}\n\n.storage-panel-selected-count {\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.storage-panel-delete-selected-btn {\n  padding: 4px 8px;\n  font-size: 11px;\n  background: #ef4444;\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.storage-panel-clear-btn {\n  font-size: 11px;\n}\n\n/* ─── Select all row ─── */\n.storage-panel-select-all-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 0;\n  border-bottom: 1px solid var(--border-color);\n  margin-bottom: 12px;\n}\n\n.storage-panel-checkbox {\n  cursor: pointer;\n}\n\n.storage-panel-select-all-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ─── Pagination ─── */\n.storage-panel-pagination {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 0;\n  margin-bottom: 12px;\n}\n\n.storage-panel-page-info {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.storage-panel-page-btns {\n  display: flex;\n  gap: 6px;\n}\n\n/* ─── Empty / no images ─── */\n.storage-panel-empty {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n/* ─── Image grid ─── */\n.storage-panel-image-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: 12px;\n}\n\n.storage-panel-image-card {\n  position: relative;\n  background: var(--bg-tertiary);\n  border-radius: 8px;\n  overflow: hidden;\n  border: 2px solid transparent;\n}\n\n.storage-panel-image-card[data-selected=\"true\"] {\n  border-color: var(--accent-color);\n}\n\n/* Checkbox overlay */\n.storage-panel-card-checkbox {\n  position: absolute;\n  top: 6px;\n  left: 6px;\n  z-index: 1;\n}\n\n/* Thumbnail container */\n.storage-panel-thumbnail-container {\n  width: 100%;\n  padding-top: 100%;\n  position: relative;\n  cursor: pointer;\n}\n\n.storage-panel-thumbnail-img {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.storage-panel-thumbnail-placeholder {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text-muted);\n  font-size: 11px;\n}\n\n/* Info section */\n.storage-panel-card-info {\n  padding: 8px;\n}\n\n.storage-panel-card-name {\n  font-size: 11px;\n  font-weight: 500;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.storage-panel-card-meta {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* Actions */\n.storage-panel-card-actions {\n  display: flex;\n  gap: 4px;\n  margin-top: 6px;\n}\n\n.storage-panel-download-btn {\n  flex: 1;\n  padding: 4px;\n  font-size: 10px;\n}\n\n.storage-panel-delete-btn {\n  padding: 4px 8px;\n  font-size: 10px;\n  background: transparent;\n  border: 1px solid #ef4444;\n  color: #ef4444;\n  border-radius: 4px;\n  cursor: pointer;\n}\n","numLines":282,"startLine":1,"totalLines":282}}}
