{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01WmgQgayzLy2FZRMR3Ta3Li","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0187xvoBXowHKPagcxdee3su","name":"Write","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/viewer.css","content":"/**\n * Viewer utility styles\n *\n * Common structural patterns shared across read-only viewer pages\n * (dependency-viewer, naming-profile-viewer, validation editor, etc.).\n *\n * Components can compose these classes directly or use them as a\n * reference for component-specific implementations. Over time,\n * component-prefixed classes (e.g. .dependency-viewer-section) should\n * migrate to use these shared classes instead.\n */\n\n/* ==========================================================================\n   Page layout\n   ========================================================================== */\n\n.viewer-container {\n  padding: var(--spacing-2xl);\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n.viewer-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: var(--spacing-2xl);\n}\n\n.viewer-title {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-2xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n/* ==========================================================================\n   Collapsible section card\n   ========================================================================== */\n\n.viewer-section {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  margin-bottom: var(--spacing-xl);\n  overflow: hidden;\n}\n\n.viewer-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--spacing-lg) var(--spacing-xl);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.viewer-section-header:hover {\n  background-color: rgb(59 130 246 / 5%);\n}\n\n.viewer-section-title {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.viewer-section-count {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-dark);\n  padding: 2px 8px;\n  border-radius: 10px;\n  margin-left: var(--spacing-sm);\n}\n\n.viewer-section-content {\n  padding: var(--spacing-md) var(--spacing-xl) var(--spacing-xl);\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-sm);\n}\n\n/* ==========================================================================\n   Expand/collapse icon\n   ========================================================================== */\n\n.viewer-expand-icon {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  transition: transform var(--transition-fast);\n}\n\n.viewer-expand-icon-open {\n  transform: rotate(180deg);\n}\n\n/* ==========================================================================\n   Data rows inside sections\n   ========================================================================== */\n\n.viewer-item-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-md);\n  border: 1px solid var(--color-border-light);\n}\n\n.viewer-item-name {\n  font-size: var(--font-size-md);\n  color: var(--color-text-dim);\n  font-weight: var(--font-weight-medium);\n}\n\n/* ==========================================================================\n   Inline badges (used-by indicators, status badges)\n   ========================================================================== */\n\n.viewer-badge {\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n  text-transform: lowercase;\n}\n\n.viewer-badge-list {\n  display: flex;\n  gap: var(--spacing-sm);\n  flex-wrap: wrap;\n}\n\n/* ==========================================================================\n   Legend row (color-coded key for section types)\n   ========================================================================== */\n\n.viewer-legend {\n  display: flex;\n  gap: var(--spacing-xl);\n  align-items: center;\n}\n\n.viewer-legend-item {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n.viewer-legend-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n\n/* ==========================================================================\n   Table layout (for mapping/reference tables)\n   ========================================================================== */\n\n.viewer-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: var(--font-size-sm);\n}\n\n.viewer-table-header {\n  text-align: left;\n  padding: var(--spacing-md) var(--spacing-lg);\n  color: var(--color-text-muted);\n  font-weight: var(--font-weight-semibold);\n  border-bottom: 1px solid var(--color-border);\n  text-transform: uppercase;\n  font-size: var(--font-size-xs);\n}\n\n.viewer-table-row {\n  border-bottom: 1px solid var(--color-border-light);\n  transition: background-color var(--transition-fast);\n}\n\n.viewer-table-row:hover {\n  background-color: rgb(59 130 246 / 5%);\n}\n\n.viewer-table-cell {\n  padding: var(--spacing-md) var(--spacing-lg);\n  color: var(--color-text);\n}\n\n/* ==========================================================================\n   Empty state\n   ========================================================================== */\n\n.viewer-empty-state {\n  text-align: center;\n  padding: var(--spacing-4xl);\n  color: var(--color-text-muted);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":413,"cache_read_input_tokens":105025,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":413},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"4f674cf0-9f5a-4696-8008-0664523e53e2","uuid":"3972ef48-5db1-4c0a-8cfe-be5c3c458983"}
