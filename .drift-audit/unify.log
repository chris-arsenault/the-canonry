{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018oSecsuUrSnfZ2VtQAbaPA","type":"tool_result","content":"     1→import { useState, useCallback, useEffect, useRef } from \"react\";\n     2→import { DEFAULT_HISTORIAN_CONFIG, isHistorianConfigured } from \"../lib/historianTypes\";\n     3→\n     4→const LEGACY_HISTORIAN_CONFIG_KEY = \"illuminator:historianConfig\";\n     5→\n     6→function readLegacyHistorianConfig() {\n     7→  try {\n     8→    const stored = localStorage.getItem(LEGACY_HISTORIAN_CONFIG_KEY);\n     9→    if (stored) return JSON.parse(stored);\n    10→  } catch {\n    11→    /* ignored */\n    12→  }\n    13→  return null;\n    14→}\n    15→\n    16→function resolveInitialHistorianConfig(externalConfig) {\n    17→  if (externalConfig) return externalConfig;\n    18→  const legacy = readLegacyHistorianConfig();\n    19→  return legacy || DEFAULT_HISTORIAN_CONFIG;\n    20→}\n    21→\n    22→function resolveExternalChange(externalConfig, hasMigrated) {\n    23→  if (externalConfig) return { config: externalConfig, migrated: hasMigrated };\n    24→  if (!hasMigrated) {\n    25→    const legacy = readLegacyHistorianConfig();\n    26→    if (legacy && isHistorianConfigured(legacy)) {\n    27→      return { config: legacy, migrated: true };\n    28→    }\n    29→  }\n    30→  return { config: DEFAULT_HISTORIAN_CONFIG, migrated: hasMigrated };\n    31→}\n    32→\n    33→export default function useHistorianConfigSync({\n    34→  externalHistorianConfig,\n    35→  onHistorianConfigChange,\n    36→}) {\n    37→  const [localHistorianConfig, setLocalHistorianConfig] = useState(() =>\n    38→    resolveInitialHistorianConfig(externalHistorianConfig)\n    39→  );\n    40→  const [hasMigrated, setHasMigrated] = useState(false);\n    41→  const pendingHistorianConfigRef = useRef(localHistorianConfig);\n    42→\n    43→  // Detect external changes during render (no ref access)\n    44→  const [prevExternal, setPrevExternal] = useState(externalHistorianConfig);\n    45→  if (externalHistorianConfig !== prevExternal) {\n    46→    setPrevExternal(externalHistorianConfig);\n    47→    if (externalHistorianConfig !== undefined) {\n    48→      const resolved = resolveExternalChange(externalHistorianConfig, hasMigrated);\n    49→      setLocalHistorianConfig(resolved.config);\n    50→      if (resolved.migrated !== hasMigrated) setHasMigrated(resolved.migrated);\n    51→    }\n    52→  }\n    53→\n    54→  // Ref + side effects in effect (legacy migration, cleanup)\n    55→  useEffect(() => {\n    56→    if (externalHistorianConfig === undefined) return;\n    57→    const resolved = resolveExternalChange(externalHistorianConfig, hasMigrated);\n    58→    pendingHistorianConfigRef.current = resolved.config;\n    59→    if (resolved.migrated && !externalHistorianConfig) {\n    60→      if (onHistorianConfigChange) onHistorianConfigChange(resolved.config);\n    61→      try {\n    62→        localStorage.removeItem(LEGACY_HISTORIAN_CONFIG_KEY);\n    63→      } catch {\n    64→        /* ignored */\n    65→      }\n    66→    }\n    67→  }, [externalHistorianConfig, onHistorianConfigChange, hasMigrated]);\n    68→\n    69→  const historianConfigSyncTimeoutRef = useRef(null);\n    70→  const updateHistorianConfig = useCallback(\n    71→    (next) => {\n    72→      setLocalHistorianConfig(next);\n    73→      pendingHistorianConfigRef.current = next;\n    74→      if (!onHistorianConfigChange) return;\n    75→      if (historianConfigSyncTimeoutRef.current)\n    76→        clearTimeout(historianConfigSyncTimeoutRef.current);\n    77→      historianConfigSyncTimeoutRef.current = setTimeout(() => {\n    78→        onHistorianConfigChange(pendingHistorianConfigRef.current);\n    79→        historianConfigSyncTimeoutRef.current = null;\n    80→      }, 300);\n    81→    },\n    82→    [onHistorianConfigChange]\n    83→  );\n    84→\n    85→  return { historianConfig: localHistorianConfig, updateHistorianConfig };\n    86→}\n    87→"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"692ebb27-65c8-4aa6-b7ee-ba0b28ba8d5b"}
