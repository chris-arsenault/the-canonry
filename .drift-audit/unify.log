{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VN5SxqXVhvb3HMRMMtS1zB","type":"tool_result","content":"     1→/**\n     2→ * EpochTimeline - Shows recent epochs and pressure gauges with detailed breakdowns\n     3→ */\n     4→\n     5→import React, { useState } from \"react\";\n     6→import PropTypes from \"prop-types\";\n     7→import \"./EpochTimeline.css\";\n     8→\n     9→function formatEpochEra(era) {\n    10→  if (!era) return \"Unknown era\";\n    11→  const startName = era.start?.name || \"Unknown era\";\n    12→  const endName = era.end?.name || startName;\n    13→  if (!era.transitions || era.transitions.length === 0 || startName === endName) {\n    14→    return endName;\n    15→  }\n    16→  return `${startName} → ${endName}`;\n    17→}\n    18→\n    19→/**\n    20→ * PressureTooltip - Shows detailed breakdown of a pressure's sources\n    21→ * Now displays cumulative data across the entire epoch\n    22→ */\n    23→function PressureTooltip({ detail, discreteModifications, tickCount }) {\n    24→  if (!detail) return null;\n    25→\n    26→  const { breakdown } = detail;\n    27→  const relevantMods = discreteModifications?.filter((m) => m.pressureId === detail.id) || [];\n    28→\n    29→  // Group discrete modifications by source type\n    30→  const groupedMods = {};\n    31→  for (const mod of relevantMods) {\n    32→    const key = mod.source.type;\n    33→    if (!groupedMods[key]) {\n    34→      groupedMods[key] = [];\n    35→    }\n    36→    groupedMods[key].push(mod);\n    37→  }\n    38→\n    39→  // Format a number with sign\n    40→  const fmt = (n) => (n >= 0 ? `+${n.toFixed(2)}` : n.toFixed(2));\n    41→\n    42→  // Calculate totals by source type\n    43→  const modTotals = {};\n    44→  for (const [type, mods] of Object.entries(groupedMods)) {\n    45→    modTotals[type] = mods.reduce((sum, m) => sum + m.delta, 0);\n    46→  }\n    47→\n    48→  return (\n    49→    <div className=\"lw-pressure-tooltip\">\n    50→      <div className=\"lw-tooltip-header\">\n    51→        <strong>{detail.name}</strong>\n    52→        <span className=\"lw-tooltip-value\">\n    53→          {detail.previousValue.toFixed(1)} → {detail.newValue.toFixed(1)}\n    54→        </span>\n    55→      </div>\n    56→      {tickCount && <div className=\"lw-tooltip-epoch-info\">Cumulative over {tickCount} ticks</div>}\n    57→\n    58→      <div className=\"lw-tooltip-section\">\n    59→        <div className=\"lw-tooltip-subtitle\">Feedback (cumulative)</div>\n    60→        {breakdown.positiveFeedback.length === 0 && breakdown.negativeFeedback.length === 0 && (\n    61→          <div className=\"lw-tooltip-row lw-tooltip-empty\">\n    62→            <span>No feedback factors defined</span>\n    63→          </div>\n    64→        )}\n    65→        {breakdown.positiveFeedback.map((f, i) => (\n    66→          <div key={`pos-${i}`} className=\"lw-tooltip-row\">\n    67→            <span title={`${f.type}: avg raw=${f.rawValue.toFixed(2)}, coef=${f.coefficient}`}>\n    68→              ↑ {f.label}\n    69→            </span>\n    70→            <span className=\"positive\">{fmt(f.contribution)}</span>\n    71→          </div>\n    72→        ))}\n    73→        {breakdown.negativeFeedback.map((f, i) => (\n    74→          <div key={`neg-${i}`} className=\"lw-tooltip-row\">\n    75→            <span title={`${f.type}: avg raw=${f.rawValue.toFixed(2)}, coef=${f.coefficient}`}>\n    76→              ↓ {f.label}\n    77→            </span>\n    78→            <span className=\"negative\">-{f.contribution.toFixed(2)}</span>\n    79→          </div>\n    80→        ))}\n    81→        <div className=\"lw-tooltip-row lw-tooltip-subtotal\">\n    82→          <span>Net feedback (before scaling)</span>\n    83→          <span>{fmt(breakdown.feedbackTotal)}</span>\n    84→        </div>\n    85→        {breakdown.homeostasis !== undefined && breakdown.homeostasis !== 0 && (\n    86→          <div className=\"lw-tooltip-row\">\n    87→            <span>Homeostatic pull</span>\n    88→            <span className={breakdown.homeostaticDelta >= 0 ? \"positive\" : \"negative\"}>\n    89→              {fmt(breakdown.homeostaticDelta)}\n    90→            </span>\n    91→          </div>\n    92→        )}\n    93→      </div>\n    94→\n    95→      <div className=\"lw-tooltip-section\">\n    96→        <div className=\"lw-tooltip-subtitle\">Modifiers (cumulative)</div>\n    97→        <div className=\"lw-tooltip-row\">\n    98→          <span>Growth scaling (diminishing returns)</span>\n    99→          <span>×{breakdown.growthScaling.toFixed(2)}</span>\n   100→        </div>\n   101→        {breakdown.eraModifier !== 1.0 && (\n   102→          <div className=\"lw-tooltip-row\">\n   103→            <span>Era modifier</span>\n   104→            <span>×{breakdown.eraModifier.toFixed(2)}</span>\n   105→          </div>\n   106→        )}\n   107→      </div>\n   108→\n   109→      {Object.keys(groupedMods).length > 0 && (\n   110→        <div className=\"lw-tooltip-section\">\n   111→          <div className=\"lw-tooltip-subtitle\">Discrete Changes</div>\n   112→          {Object.entries(groupedMods).map(([type, mods]) => (\n   113→            <div key={type} className=\"lw-tooltip-mod-group\">\n   114→              <div className=\"lw-tooltip-row lw-tooltip-mod-header\">\n   115→                <span>\n   116→                  {type} ({mods.length})\n   117→                </span>\n   118→                <span className={modTotals[type] >= 0 ? \"positive\" : \"negative\"}>\n   119→                  {fmt(modTotals[type])}\n   120→                </span>\n   121→              </div>\n   122→              {mods.slice(0, 3).map((mod, i) => (\n   123→                <div key={i} className=\"lw-tooltip-row lw-tooltip-mod-detail\">\n   124→                  <span>\n   125→                    {mod.source.templateId || mod.source.systemId || mod.source.eraId || \"unknown\"}\n   126→                  </span>\n   127→                  <span className={mod.delta >= 0 ? \"positive\" : \"negative\"}>{fmt(mod.delta)}</span>\n   128→                </div>\n   129→              ))}\n   130→              {mods.length > 3 && (\n   131→                <div className=\"lw-tooltip-row lw-tooltip-mod-detail\">\n   132→                  <span>... and {mods.length - 3} more</span>\n   133→                </div>\n   134→              )}\n   135→            </div>\n   136→          ))}\n   137→        </div>\n   138→      )}\n   139→\n   140→      <div className=\"lw-tooltip-section lw-tooltip-final\">\n   141→        <div className=\"lw-tooltip-row\">\n   142→          <span>Total raw delta (feedback + homeostasis)</span>\n   143→          <span>{fmt(breakdown.rawDelta)}</span>\n   144→        </div>\n   145→        <div className=\"lw-tooltip-row\">\n   146→          <span>Smoothed delta (max ±2/tick × {tickCount || \"?\"} ticks)</span>\n   147→          <span className={breakdown.smoothedDelta >= 0 ? \"positive\" : \"negative\"}>\n   148→            {fmt(breakdown.smoothedDelta)}\n   149→          </span>\n   150→        </div>\n   151→        <div className=\"lw-tooltip-row lw-tooltip-actual-change\">\n   152→          <span>Actual epoch change</span>\n   153→          <span className={detail.delta >= 0 ? \"positive\" : \"negative\"}>\n   154→            <strong>{fmt(detail.delta)}</strong>\n   155→          </span>\n   156→        </div>\n   157→      </div>\n   158→    </div>\n   159→  );\n   160→}\n   161→\n   162→/**\n   163→ * PressureGauge - Individual pressure with hover details\n   164→ */\n   165→function PressureGauge({ name, value, detail, discreteModifications, tickCount }) {\n   166→  const [showTooltip, setShowTooltip] = useState(false);\n   167→\n   168→  return (\n   169→    <div\n   170→      className=\"lw-pressure-gauge et-gauge-interactive\"\n   171→      onMouseEnter={() => setShowTooltip(true)}\n   172→      onMouseLeave={() => setShowTooltip(false)}\n   173→    >\n   174→      <span className=\"lw-pressure-name\">{name}</span>\n   175→      <div className=\"lw-pressure-bar\">\n   176→        <div\n   177→          className=\"lw-pressure-fill et-pressure-fill\"\n   178→          style={{\n   179→            '--et-pressure-fill-width': `${Math.min(100, value)}%`,\n   180→            '--et-pressure-fill-color': (() => {\n   181→              if (value > 70) return \"var(--lw-danger)\";\n   182→              if (value > 40) return \"var(--lw-warning)\";\n   183→              return \"var(--lw-success)\";\n   184→            })(),\n   185→          }}\n   186→        />\n   187→      </div>\n   188→      <span className=\"lw-pressure-value\">\n   189→        {value.toFixed(0)}\n   190→        {detail && (\n   191→          <span className={`lw-pressure-delta ${detail.delta >= 0 ? \"positive\" : \"negative\"}`}>\n   192→            {detail.delta >= 0 ? \"↑\" : \"↓\"}\n   193→          </span>\n   194→        )}\n   195→      </span>\n   196→      {showTooltip && detail && (\n   197→        <PressureTooltip\n   198→          detail={detail}\n   199→          discreteModifications={discreteModifications}\n   200→          tickCount={tickCount}\n   201→        />\n   202→      )}\n   203→    </div>\n   204→  );\n   205→}\n   206→\n   207→export default function EpochTimeline({\n   208→  epochStats,\n   209→  currentEpoch,\n   210→  pressures,\n   211→  pressureDetails,\n   212→  reachability,\n   213→}) {\n   214→  const recentEpochs = epochStats.slice(-5).reverse();\n   215→\n   216→  // Build a map of pressure details by ID for easy lookup\n   217→  const detailsMap = new Map();\n   218→  if (pressureDetails?.pressures) {\n   219→    for (const p of pressureDetails.pressures) {\n   220→      detailsMap.set(p.id, p);\n   221→    }\n   222→  }\n   223→\n   224→  const connectedComponents = reachability?.connectedComponents;\n   225→  const fullyConnectedTick = reachability?.fullyConnectedTick ?? null;\n   226→  const disconnectedClustersValue =\n   227→    typeof connectedComponents === \"number\" ? connectedComponents.toLocaleString() : \"--\";\n   228→  let fullyConnectedValue = \"--\";\n   229→  if (reachability) {\n   230→    fullyConnectedValue = fullyConnectedTick === null ? \"never\" : fullyConnectedTick.toLocaleString();\n   231→  }\n   232→  const clusterValueColor =\n   233→    typeof connectedComponents === \"number\" && connectedComponents > 1\n   234→      ? \"var(--lw-danger)\"\n   235→      : undefined;\n   236→\n   237→  return (\n   238→    <div className=\"lw-panel\">\n   239→      <div className=\"lw-panel-header\">\n   240→        <div className=\"lw-panel-title\">\n   241→          <span>⏱</span>\n   242→          Epoch Timeline\n   243→        </div>\n   244→        {currentEpoch && (\n   245→          <span className=\"et-era-label\">\n   246→            Era: {currentEpoch.era.name}\n   247→          </span>\n   248→        )}\n   249→      </div>\n   250→      <div className=\"lw-panel-content\">\n   251→        {recentEpochs.length === 0 ? (\n   252→          <div className=\"lw-empty-state\">\n   253→            <span className=\"lw-empty-icon\">⏳</span>\n   254→            <span>No epochs completed yet</span>\n   255→          </div>\n   256→        ) : (\n   257→          <>\n   258→            <div className=\"lw-timeline\">\n   259→              {recentEpochs.map((epoch, i) => (\n   260→                <div\n   261→                  key={epoch.epoch}\n   262→                  className={`lw-timeline-item ${i === 0 ? \"active\" : \"\"} et-timeline-opacity`}\n   263→                  style={{ '--et-timeline-opacity': i === 0 ? 1 : 0.7 }}\n   264→                >\n   265→                  <div className={`lw-timeline-icon ${i === 0 ? \"active\" : \"\"}`}>{epoch.epoch}</div>\n   266→                  <div className=\"lw-timeline-content\">\n   267→                    <div className=\"lw-timeline-title\">{formatEpochEra(epoch.era)}</div>\n   268→                    <div className=\"lw-timeline-subtitle\">\n   269→                      +{epoch.entitiesCreated} entities • +{epoch.relationshipsCreated} relations\n   270→                    </div>\n   271→                  </div>\n   272→                </div>\n   273→              ))}\n   274→            </div>\n   275→\n   276→            {/* Pressure Gauges with hover details */}\n   277→            {pressures && Object.keys(pressures).length > 0 && (\n   278→              <div className=\"et-section-spacer\">\n   279→                <div className=\"et-section-label\">\n   280→                  Current Pressures\n   281→                  {pressureDetails && (\n   282→                    <span className=\"et-section-label-hint\">\n   283→                      (hover for epoch details\n   284→                      {pressureDetails.ticksAggregated\n   285→                        ? `, ${pressureDetails.ticksAggregated} ticks`\n   286→                        : \"\"}\n   287→                      )\n   288→                    </span>\n   289→                  )}\n   290→                </div>\n   291→                <div className=\"lw-flex-col lw-gap-sm\">\n   292→                  {Object.entries(pressures).map(([name, value]) => (\n   293→                    <PressureGauge\n   294→                      key={name}\n   295→                      name={name}\n   296→                      value={value}\n   297→                      detail={detailsMap.get(name)}\n   298→                      discreteModifications={pressureDetails?.discreteModifications}\n   299→                      tickCount={pressureDetails?.ticksAggregated}\n   300→                    />\n   301→                  ))}\n   302→                </div>\n   303→              </div>\n   304→            )}\n   305→\n   306→            <div className=\"et-section-spacer\">\n   307→              <div className=\"et-section-label\">\n   308→                Graph Connectivity\n   309→              </div>\n   310→              <div className=\"lw-flex-col lw-gap-sm\">\n   311→                <div className=\"et-metric-row\">\n   312→                  <span>Disconnected clusters</span>\n   313→                  <span className=\"et-cluster-value\" style={{ '--et-cluster-value-color': clusterValueColor }}>{disconnectedClustersValue}</span>\n   314→                </div>\n   315→                <div className=\"et-metric-row\">\n   316→                  <span>Fully connected tick</span>\n   317→                  <span className=\"et-connected-value\">{fullyConnectedValue}</span>\n   318→                </div>\n   319→              </div>\n   320→            </div>\n   321→          </>\n   322→        )}\n   323→      </div>\n   324→    </div>\n   325→  );\n   326→}\n   327→\n   328→PressureTooltip.propTypes = {\n   329→  detail: PropTypes.object,\n   330→  discreteModifications: PropTypes.array,\n   331→  tickCount: PropTypes.number,\n   332→};\n   333→\n   334→PressureGauge.propTypes = {\n   335→  name: PropTypes.string,\n   336→  value: PropTypes.number,\n   337→  detail: PropTypes.object,\n   338→  discreteModifications: PropTypes.array,\n   339→  tickCount: PropTypes.number,\n   340→};\n   341→\n   342→EpochTimeline.propTypes = {\n   343→  epochStats: PropTypes.array,\n   344→  currentEpoch: PropTypes.object,\n   345→  pressures: PropTypes.object,\n   346→  pressureDetails: PropTypes.object,\n   347→  reachability: PropTypes.object,\n   348→};\n   349→"}]},"parent_tool_use_id":null,"session_id":"d7d177e3-e480-46d9-92de-1155938b93f7","uuid":"683bfcd6-b9ff-457d-890f-489fbb3d50ba","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/lore-weave/webui/src/components/dashboard/EpochTimeline.jsx","content":"/**\n * EpochTimeline - Shows recent epochs and pressure gauges with detailed breakdowns\n */\n\nimport React, { useState } from \"react\";\nimport PropTypes from \"prop-types\";\nimport \"./EpochTimeline.css\";\n\nfunction formatEpochEra(era) {\n  if (!era) return \"Unknown era\";\n  const startName = era.start?.name || \"Unknown era\";\n  const endName = era.end?.name || startName;\n  if (!era.transitions || era.transitions.length === 0 || startName === endName) {\n    return endName;\n  }\n  return `${startName} → ${endName}`;\n}\n\n/**\n * PressureTooltip - Shows detailed breakdown of a pressure's sources\n * Now displays cumulative data across the entire epoch\n */\nfunction PressureTooltip({ detail, discreteModifications, tickCount }) {\n  if (!detail) return null;\n\n  const { breakdown } = detail;\n  const relevantMods = discreteModifications?.filter((m) => m.pressureId === detail.id) || [];\n\n  // Group discrete modifications by source type\n  const groupedMods = {};\n  for (const mod of relevantMods) {\n    const key = mod.source.type;\n    if (!groupedMods[key]) {\n      groupedMods[key] = [];\n    }\n    groupedMods[key].push(mod);\n  }\n\n  // Format a number with sign\n  const fmt = (n) => (n >= 0 ? `+${n.toFixed(2)}` : n.toFixed(2));\n\n  // Calculate totals by source type\n  const modTotals = {};\n  for (const [type, mods] of Object.entries(groupedMods)) {\n    modTotals[type] = mods.reduce((sum, m) => sum + m.delta, 0);\n  }\n\n  return (\n    <div className=\"lw-pressure-tooltip\">\n      <div className=\"lw-tooltip-header\">\n        <strong>{detail.name}</strong>\n        <span className=\"lw-tooltip-value\">\n          {detail.previousValue.toFixed(1)} → {detail.newValue.toFixed(1)}\n        </span>\n      </div>\n      {tickCount && <div className=\"lw-tooltip-epoch-info\">Cumulative over {tickCount} ticks</div>}\n\n      <div className=\"lw-tooltip-section\">\n        <div className=\"lw-tooltip-subtitle\">Feedback (cumulative)</div>\n        {breakdown.positiveFeedback.length === 0 && breakdown.negativeFeedback.length === 0 && (\n          <div className=\"lw-tooltip-row lw-tooltip-empty\">\n            <span>No feedback factors defined</span>\n          </div>\n        )}\n        {breakdown.positiveFeedback.map((f, i) => (\n          <div key={`pos-${i}`} className=\"lw-tooltip-row\">\n            <span title={`${f.type}: avg raw=${f.rawValue.toFixed(2)}, coef=${f.coefficient}`}>\n              ↑ {f.label}\n            </span>\n            <span className=\"positive\">{fmt(f.contribution)}</span>\n          </div>\n        ))}\n        {breakdown.negativeFeedback.map((f, i) => (\n          <div key={`neg-${i}`} className=\"lw-tooltip-row\">\n            <span title={`${f.type}: avg raw=${f.rawValue.toFixed(2)}, coef=${f.coefficient}`}>\n              ↓ {f.label}\n            </span>\n            <span className=\"negative\">-{f.contribution.toFixed(2)}</span>\n          </div>\n        ))}\n        <div className=\"lw-tooltip-row lw-tooltip-subtotal\">\n          <span>Net feedback (before scaling)</span>\n          <span>{fmt(breakdown.feedbackTotal)}</span>\n        </div>\n        {breakdown.homeostasis !== undefined && breakdown.homeostasis !== 0 && (\n          <div className=\"lw-tooltip-row\">\n            <span>Homeostatic pull</span>\n            <span className={breakdown.homeostaticDelta >= 0 ? \"positive\" : \"negative\"}>\n              {fmt(breakdown.homeostaticDelta)}\n            </span>\n          </div>\n        )}\n      </div>\n\n      <div className=\"lw-tooltip-section\">\n        <div className=\"lw-tooltip-subtitle\">Modifiers (cumulative)</div>\n        <div className=\"lw-tooltip-row\">\n          <span>Growth scaling (diminishing returns)</span>\n          <span>×{breakdown.growthScaling.toFixed(2)}</span>\n        </div>\n        {breakdown.eraModifier !== 1.0 && (\n          <div className=\"lw-tooltip-row\">\n            <span>Era modifier</span>\n            <span>×{breakdown.eraModifier.toFixed(2)}</span>\n          </div>\n        )}\n      </div>\n\n      {Object.keys(groupedMods).length > 0 && (\n        <div className=\"lw-tooltip-section\">\n          <div className=\"lw-tooltip-subtitle\">Discrete Changes</div>\n          {Object.entries(groupedMods).map(([type, mods]) => (\n            <div key={type} className=\"lw-tooltip-mod-group\">\n              <div className=\"lw-tooltip-row lw-tooltip-mod-header\">\n                <span>\n                  {type} ({mods.length})\n                </span>\n                <span className={modTotals[type] >= 0 ? \"positive\" : \"negative\"}>\n                  {fmt(modTotals[type])}\n                </span>\n              </div>\n              {mods.slice(0, 3).map((mod, i) => (\n                <div key={i} className=\"lw-tooltip-row lw-tooltip-mod-detail\">\n                  <span>\n                    {mod.source.templateId || mod.source.systemId || mod.source.eraId || \"unknown\"}\n                  </span>\n                  <span className={mod.delta >= 0 ? \"positive\" : \"negative\"}>{fmt(mod.delta)}</span>\n                </div>\n              ))}\n              {mods.length > 3 && (\n                <div className=\"lw-tooltip-row lw-tooltip-mod-detail\">\n                  <span>... and {mods.length - 3} more</span>\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      )}\n\n      <div className=\"lw-tooltip-section lw-tooltip-final\">\n        <div className=\"lw-tooltip-row\">\n          <span>Total raw delta (feedback + homeostasis)</span>\n          <span>{fmt(breakdown.rawDelta)}</span>\n        </div>\n        <div className=\"lw-tooltip-row\">\n          <span>Smoothed delta (max ±2/tick × {tickCount || \"?\"} ticks)</span>\n          <span className={breakdown.smoothedDelta >= 0 ? \"positive\" : \"negative\"}>\n            {fmt(breakdown.smoothedDelta)}\n          </span>\n        </div>\n        <div className=\"lw-tooltip-row lw-tooltip-actual-change\">\n          <span>Actual epoch change</span>\n          <span className={detail.delta >= 0 ? \"positive\" : \"negative\"}>\n            <strong>{fmt(detail.delta)}</strong>\n          </span>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/**\n * PressureGauge - Individual pressure with hover details\n */\nfunction PressureGauge({ name, value, detail, discreteModifications, tickCount }) {\n  const [showTooltip, setShowTooltip] = useState(false);\n\n  return (\n    <div\n      className=\"lw-pressure-gauge et-gauge-interactive\"\n      onMouseEnter={() => setShowTooltip(true)}\n      onMouseLeave={() => setShowTooltip(false)}\n    >\n      <span className=\"lw-pressure-name\">{name}</span>\n      <div className=\"lw-pressure-bar\">\n        <div\n          className=\"lw-pressure-fill et-pressure-fill\"\n          style={{\n            '--et-pressure-fill-width': `${Math.min(100, value)}%`,\n            '--et-pressure-fill-color': (() => {\n              if (value > 70) return \"var(--lw-danger)\";\n              if (value > 40) return \"var(--lw-warning)\";\n              return \"var(--lw-success)\";\n            })(),\n          }}\n        />\n      </div>\n      <span className=\"lw-pressure-value\">\n        {value.toFixed(0)}\n        {detail && (\n          <span className={`lw-pressure-delta ${detail.delta >= 0 ? \"positive\" : \"negative\"}`}>\n            {detail.delta >= 0 ? \"↑\" : \"↓\"}\n          </span>\n        )}\n      </span>\n      {showTooltip && detail && (\n        <PressureTooltip\n          detail={detail}\n          discreteModifications={discreteModifications}\n          tickCount={tickCount}\n        />\n      )}\n    </div>\n  );\n}\n\nexport default function EpochTimeline({\n  epochStats,\n  currentEpoch,\n  pressures,\n  pressureDetails,\n  reachability,\n}) {\n  const recentEpochs = epochStats.slice(-5).reverse();\n\n  // Build a map of pressure details by ID for easy lookup\n  const detailsMap = new Map();\n  if (pressureDetails?.pressures) {\n    for (const p of pressureDetails.pressures) {\n      detailsMap.set(p.id, p);\n    }\n  }\n\n  const connectedComponents = reachability?.connectedComponents;\n  const fullyConnectedTick = reachability?.fullyConnectedTick ?? null;\n  const disconnectedClustersValue =\n    typeof connectedComponents === \"number\" ? connectedComponents.toLocaleString() : \"--\";\n  let fullyConnectedValue = \"--\";\n  if (reachability) {\n    fullyConnectedValue = fullyConnectedTick === null ? \"never\" : fullyConnectedTick.toLocaleString();\n  }\n  const clusterValueColor =\n    typeof connectedComponents === \"number\" && connectedComponents > 1\n      ? \"var(--lw-danger)\"\n      : undefined;\n\n  return (\n    <div className=\"lw-panel\">\n      <div className=\"lw-panel-header\">\n        <div className=\"lw-panel-title\">\n          <span>⏱</span>\n          Epoch Timeline\n        </div>\n        {currentEpoch && (\n          <span className=\"et-era-label\">\n            Era: {currentEpoch.era.name}\n          </span>\n        )}\n      </div>\n      <div className=\"lw-panel-content\">\n        {recentEpochs.length === 0 ? (\n          <div className=\"lw-empty-state\">\n            <span className=\"lw-empty-icon\">⏳</span>\n            <span>No epochs completed yet</span>\n          </div>\n        ) : (\n          <>\n            <div className=\"lw-timeline\">\n              {recentEpochs.map((epoch, i) => (\n                <div\n                  key={epoch.epoch}\n                  className={`lw-timeline-item ${i === 0 ? \"active\" : \"\"} et-timeline-opacity`}\n                  style={{ '--et-timeline-opacity': i === 0 ? 1 : 0.7 }}\n                >\n                  <div className={`lw-timeline-icon ${i === 0 ? \"active\" : \"\"}`}>{epoch.epoch}</div>\n                  <div className=\"lw-timeline-content\">\n                    <div className=\"lw-timeline-title\">{formatEpochEra(epoch.era)}</div>\n                    <div className=\"lw-timeline-subtitle\">\n                      +{epoch.entitiesCreated} entities • +{epoch.relationshipsCreated} relations\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            {/* Pressure Gauges with hover details */}\n            {pressures && Object.keys(pressures).length > 0 && (\n              <div className=\"et-section-spacer\">\n                <div className=\"et-section-label\">\n                  Current Pressures\n                  {pressureDetails && (\n                    <span className=\"et-section-label-hint\">\n                      (hover for epoch details\n                      {pressureDetails.ticksAggregated\n                        ? `, ${pressureDetails.ticksAggregated} ticks`\n                        : \"\"}\n                      )\n                    </span>\n                  )}\n                </div>\n                <div className=\"lw-flex-col lw-gap-sm\">\n                  {Object.entries(pressures).map(([name, value]) => (\n                    <PressureGauge\n                      key={name}\n                      name={name}\n                      value={value}\n                      detail={detailsMap.get(name)}\n                      discreteModifications={pressureDetails?.discreteModifications}\n                      tickCount={pressureDetails?.ticksAggregated}\n                    />\n                  ))}\n                </div>\n              </div>\n            )}\n\n            <div className=\"et-section-spacer\">\n              <div className=\"et-section-label\">\n                Graph Connectivity\n              </div>\n              <div className=\"lw-flex-col lw-gap-sm\">\n                <div className=\"et-metric-row\">\n                  <span>Disconnected clusters</span>\n                  <span className=\"et-cluster-value\" style={{ '--et-cluster-value-color': clusterValueColor }}>{disconnectedClustersValue}</span>\n                </div>\n                <div className=\"et-metric-row\">\n                  <span>Fully connected tick</span>\n                  <span className=\"et-connected-value\">{fullyConnectedValue}</span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </div>\n  );\n}\n\nPressureTooltip.propTypes = {\n  detail: PropTypes.object,\n  discreteModifications: PropTypes.array,\n  tickCount: PropTypes.number,\n};\n\nPressureGauge.propTypes = {\n  name: PropTypes.string,\n  value: PropTypes.number,\n  detail: PropTypes.object,\n  discreteModifications: PropTypes.array,\n  tickCount: PropTypes.number,\n};\n\nEpochTimeline.propTypes = {\n  epochStats: PropTypes.array,\n  currentEpoch: PropTypes.object,\n  pressures: PropTypes.object,\n  pressureDetails: PropTypes.object,\n  reachability: PropTypes.object,\n};\n","numLines":349,"startLine":1,"totalLines":349}}}
