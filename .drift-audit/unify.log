{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NA6xhfs4LzgpSp2C6YCREm","type":"tool_result","content":"     1→/**\n     2→ * ErrorBoundary - Catches render errors in child component trees\n     3→ *\n     4→ * Displays a recovery UI with the error message and a retry button.\n     5→ * Intended for wrapping MFE remote entry points so a single module\n     6→ * failure doesn't crash the entire host application.\n     7→ */\n     8→\n     9→import React from \"react\";\n    10→import PropTypes from \"prop-types\";\n    11→\n    12→export class ErrorBoundary extends React.Component {\n    13→  constructor(props) {\n    14→    super(props);\n    15→    this.state = { error: null };\n    16→  }\n    17→\n    18→  static getDerivedStateFromError(error) {\n    19→    return { error };\n    20→  }\n    21→\n    22→  handleRetry = () => {\n    23→    this.setState({ error: null });\n    24→  };\n    25→\n    26→  render() {\n    27→    if (this.state.error) {\n    28→      return (\n    29→        <div className={`error-boundary ${this.props.className || \"\"}`.trim()}>\n    30→          <div className=\"error-boundary-icon\">!</div>\n    31→          <div className=\"error-boundary-title\">\n    32→            {this.props.title || \"Something went wrong\"}\n    33→          </div>\n    34→          <div className=\"error-boundary-message\">\n    35→            {this.state.error.message || \"An unexpected error occurred.\"}\n    36→          </div>\n    37→          <button\n    38→            className=\"error-boundary-retry\"\n    39→            onClick={this.handleRetry}\n    40→          >\n    41→            Retry\n    42→          </button>\n    43→        </div>\n    44→      );\n    45→    }\n    46→    return this.props.children;\n    47→  }\n    48→}\n    49→\n    50→export default ErrorBoundary;\n    51→\n    52→ErrorBoundary.propTypes = {\n    53→  children: PropTypes.node.isRequired,\n    54→  title: PropTypes.string,\n    55→  className: PropTypes.string,\n    56→};\n    57→"}]},"parent_tool_use_id":null,"session_id":"2a207061-1c30-40ba-a375-5d0443f621d8","uuid":"29185f64-ebb9-4dd5-a0fe-ea5a9c2af5bc","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/ErrorBoundary.jsx","content":"/**\n * ErrorBoundary - Catches render errors in child component trees\n *\n * Displays a recovery UI with the error message and a retry button.\n * Intended for wrapping MFE remote entry points so a single module\n * failure doesn't crash the entire host application.\n */\n\nimport React from \"react\";\nimport PropTypes from \"prop-types\";\n\nexport class ErrorBoundary extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = { error: null };\n  }\n\n  static getDerivedStateFromError(error) {\n    return { error };\n  }\n\n  handleRetry = () => {\n    this.setState({ error: null });\n  };\n\n  render() {\n    if (this.state.error) {\n      return (\n        <div className={`error-boundary ${this.props.className || \"\"}`.trim()}>\n          <div className=\"error-boundary-icon\">!</div>\n          <div className=\"error-boundary-title\">\n            {this.props.title || \"Something went wrong\"}\n          </div>\n          <div className=\"error-boundary-message\">\n            {this.state.error.message || \"An unexpected error occurred.\"}\n          </div>\n          <button\n            className=\"error-boundary-retry\"\n            onClick={this.handleRetry}\n          >\n            Retry\n          </button>\n        </div>\n      );\n    }\n    return this.props.children;\n  }\n}\n\nexport default ErrorBoundary;\n\nErrorBoundary.propTypes = {\n  children: PropTypes.node.isRequired,\n  title: PropTypes.string,\n  className: PropTypes.string,\n};\n","numLines":57,"startLine":1,"totalLines":57}}}
