{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018oUVSGDAvmSsVm54toXgQ9","type":"tool_result","content":"     1→/**\n     2→ * NumberInput - Reusable number input that properly handles negative numbers\n     3→ *\n     4→ * Fixes the common bug where typing a minus sign is blocked because the\n     5→ * onChange handler immediately parses and rejects \"-\" as invalid.\n     6→ *\n     7→ * Uses internal string state during editing, only parsing to number on blur\n     8→ * or when the full value is valid. Tracks focus state to prevent parent\n     9→ * re-renders from disrupting user input.\n    10→ */\n    11→\n    12→import React, { useState, useCallback } from 'react';\n    13→\n    14→interface NumberInputProps extends Omit<React.InputHTMLAttributes<HTMLInputElement>, 'value' | 'onChange' | 'step'> {\n    15→  value?: number | null;\n    16→  onChange: (value: number | undefined) => void;\n    17→  className?: string;\n    18→  min?: number;\n    19→  max?: number;\n    20→  step?: number | string;\n    21→  placeholder?: string;\n    22→  allowEmpty?: boolean;\n    23→  integer?: boolean;\n    24→  disabled?: boolean;\n    25→}\n    26→\n    27→function formatValue(val: number | null | undefined | string): string {\n    28→  if (val === undefined || val === null || val === '') return '';\n    29→  return String(val);\n    30→}\n    31→\n    32→/**\n    33→ * @param {Object} props\n    34→ * @param {number|undefined|null} props.value - The numeric value\n    35→ * @param {Function} props.onChange - Called with the parsed number when valid\n    36→ * @param {string} [props.className] - CSS class for the input\n    37→ * @param {number} [props.min] - Minimum value\n    38→ * @param {number} [props.max] - Maximum value\n    39→ * @param {number|string} [props.step] - Step value for increment/decrement\n    40→ * @param {string} [props.placeholder] - Placeholder text\n    41→ * @param {boolean} [props.allowEmpty] - If true, empty string calls onChange(undefined)\n    42→ * @param {boolean} [props.integer] - If true, only allow integers\n    43→ * @param {boolean} [props.disabled] - Disable the input\n    44→ */\n    45→export function NumberInput({\n    46→  value,\n    47→  onChange,\n    48→  className = 'input',\n    49→  min,\n    50→  max,\n    51→  step: _step,\n    52→  placeholder,\n    53→  allowEmpty = false,\n    54→  integer = false,\n    55→  disabled = false,\n    56→  ...rest\n    57→}: NumberInputProps) {\n    58→  const externalDisplayValue = formatValue(value);\n    59→  // Internal string state for editing\n    60→  const [localValue, setLocalValue] = useState(() => externalDisplayValue);\n    61→  // Track focus in state so render can safely choose draft vs external value\n    62→  const [isFocused, setIsFocused] = useState(false);\n    63→\n    64→  const parseValue = useCallback((str) => {\n    65→    if (str === '' || str === '-' || str === '.' || str === '-.') {\n    66→      return null; // Intermediate state, not a valid number yet\n    67→    }\n    68→    const parsed = integer ? parseInt(str, 10) : parseFloat(str);\n    69→    if (isNaN(parsed)) return null;\n    70→    return parsed;\n    71→  }, [integer]);\n    72→\n    73→  const handleFocus = useCallback(() => {\n    74→    setLocalValue(externalDisplayValue);\n    75→    setIsFocused(true);\n    76→  }, [externalDisplayValue]);\n    77→\n    78→  const handleChange = useCallback((e) => {\n    79→    const newValue = e.target.value;\n    80→\n    81→    // Allow empty, minus sign, decimal point, or any numeric pattern\n    82→    // This regex allows intermediate states like \"-\", \".\", \"-.\", \"1.\", \"-1.\"\n    83→    /* eslint-disable sonarjs/slow-regex -- short user input (single number field value) */\n    84→    const validPattern = integer\n    85→      ? /^-?\\d*$/  // Integer: optional minus, digits only\n    86→      : /^-?\\d*\\.?\\d*$/; // Float: optional minus, digits, optional decimal, more digits\n    87→    /* eslint-enable sonarjs/slow-regex */\n    88→\n    89→    if (!validPattern.test(newValue)) {\n    90→      return; // Reject invalid characters\n    91→    }\n    92→\n    93→    setLocalValue(newValue);\n    94→\n    95→    // Try to parse and update parent if it's a complete valid number\n    96→    const parsed = parseValue(newValue);\n    97→    if (parsed !== null) {\n    98→      // Apply min/max constraints\n    99→      let constrained = parsed;\n   100→      if (min !== undefined && constrained < min) constrained = min;\n   101→      if (max !== undefined && constrained > max) constrained = max;\n   102→      onChange(constrained);\n   103→    } else if (allowEmpty && newValue === '') {\n   104→      onChange(undefined);\n   105→    }\n   106→  }, [onChange, min, max, allowEmpty, integer, parseValue]);\n   107→\n   108→  const handleBlur = useCallback(() => {\n   109→    setIsFocused(false);\n   110→\n   111→    // On blur, ensure the display value matches the actual value\n   112→    const parsed = parseValue(localValue);\n   113→    if (parsed !== null) {\n   114→      // Apply constraints and update\n   115→      let constrained = parsed;\n   116→      if (min !== undefined && constrained < min) constrained = min;\n   117→      if (max !== undefined && constrained > max) constrained = max;\n   118→      setLocalValue(formatValue(constrained));\n   119→      onChange(constrained);\n   120→    } else if (allowEmpty && localValue === '') {\n   121→      onChange(undefined);\n   122→    } else {\n   123→      // Revert to the parent's value if local is invalid\n   124→      setLocalValue(externalDisplayValue);\n   125→    }\n   126→  }, [allowEmpty, externalDisplayValue, localValue, max, min, onChange, parseValue]);\n   127→\n   128→  return (\n   129→    <input\n   130→      type=\"text\"\n   131→      inputMode=\"numeric\"\n   132→      value={isFocused ? localValue : externalDisplayValue}\n   133→      onChange={handleChange}\n   134→      onFocus={handleFocus}\n   135→      onBlur={handleBlur}\n   136→      className={className}\n   137→      placeholder={placeholder}\n   138→      disabled={disabled}\n   139→      {...rest}\n   140→    />\n   141→  );\n   142→}\n   143→\n   144→export default NumberInput;\n   145→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"f13e1584-1e67-4538-8eed-ce4d15b33f56"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PBSqwsVtorAmnUk3Jk9xoK","type":"tool_result","content":"     1→/**\n     2→ * PressureChangesEditor - Editor for pressure delta values\n     3→ *\n     4→ * Displays a list of pressure changes with ability to add, remove, and modify delta values.\n     5→ */\n     6→\n     7→import React from 'react';\n     8→\n     9→interface PressureDefinition {\n    10→  id: string;\n    11→  name?: string;\n    12→}\n    13→\n    14→interface PressureChangesEditorProps {\n    15→  value?: Record<string, number>;\n    16→  onChange: (value: Record<string, number>) => void;\n    17→  pressures?: PressureDefinition[];\n    18→  label?: string;\n    19→  className?: string;\n    20→}\n    21→\n    22→/**\n    23→ * @param {Object} props\n    24→ * @param {Object<string, number>} props.value - Map of pressure ID to delta value\n    25→ * @param {Function} props.onChange - Called when values change\n    26→ * @param {Array<{id: string, name?: string}>} props.pressures - Available pressure definitions\n    27→ * @param {string} [props.label] - Optional custom label (default: \"Pressure Changes\")\n    28→ * @param {string} [props.className] - Additional class names\n    29→ */\n    30→export function PressureChangesEditor({\n    31→  value = {},\n    32→  onChange,\n    33→  pressures,\n    34→  label = 'Pressure Changes',\n    35→  className = '',\n    36→}: PressureChangesEditorProps) {\n    37→  const entries = Object.entries(value);\n    38→\n    39→  const addPressure = (pressureId) => {\n    40→    if (pressureId && !(pressureId in value)) {\n    41→      onChange({ ...value, [pressureId]: 0 });\n    42→    }\n    43→  };\n    44→\n    45→  const updateDelta = (pressureId, delta) => {\n    46→    onChange({ ...value, [pressureId]: parseInt(delta) || 0 });\n    47→  };\n    48→\n    49→  const removePressure = (pressureId) => {\n    50→    const newValue = { ...value };\n    51→    delete newValue[pressureId];\n    52→    onChange(newValue);\n    53→  };\n    54→\n    55→  const availablePressures = (pressures || []).filter((p) => !(p.id in value));\n    56→\n    57→  return (\n    58→    <div className={`form-group mb-xl ${className}`.trim()}>\n    59→      <label className=\"label\">{label}</label>\n    60→      <div className=\"flex flex-col gap-md\">\n    61→        {entries.map(([pressureId, delta]) => (\n    62→          <div key={pressureId} className=\"item-row\">\n    63→            <span className=\"item-row-name\">{pressureId}</span>\n    64→            <input\n    65→              type=\"number\"\n    66→              className=\"input pressure-changes-delta-input\"\n    67→              value={delta}\n    68→              onChange={(e) => updateDelta(pressureId, e.target.value)}\n    69→            />\n    70→            <button\n    71→              className=\"btn-icon btn-icon-danger\"\n    72→              onClick={() => removePressure(pressureId)}\n    73→            >\n    74→              ×\n    75→            </button>\n    76→          </div>\n    77→        ))}\n    78→      </div>\n    79→      {availablePressures.length > 0 && (\n    80→        <select\n    81→          className=\"select mt-md pressure-changes-add-select\"\n    82→          value=\"\"\n    83→          onChange={(e) => addPressure(e.target.value)}\n    84→        >\n    85→          <option value=\"\">+ Add pressure change...</option>\n    86→          {availablePressures.map((p) => (\n    87→            <option key={p.id} value={p.id}>\n    88→              {p.name || p.id}\n    89→            </option>\n    90→          ))}\n    91→        </select>\n    92→      )}\n    93→    </div>\n    94→  );\n    95→}\n    96→"}]},"parent_tool_use_id":"toolu_01FzRVY2V2nJRXov651T5ucP","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"1b15dc77-2c23-446c-9e49-1948e920f39f"}
