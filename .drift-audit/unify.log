nk: 0;\n}\n\n.toggle-on {\n  background-color: var(--color-success);\n}\n\n.toggle-disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Toggle knob */\n.toggle-knob {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  width: 16px;\n  height: 16px;\n  border-radius: var(--radius-full);\n  background-color: #fff;\n  transition: transform var(--transition-normal);\n}\n\n.toggle-on .toggle-knob {\n  transform: translateX(16px);\n}\n\n/* Toggle with label */\n.toggle-container {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-lg);\n}\n\n.toggle-label {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n}\n","numLines":53,"startLine":1,"totalLines":53}}}
