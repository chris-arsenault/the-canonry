r(--line-height-relaxed);\n   120→  color: var(--color-purple-100);\n   121→  font-style: italic;\n   122→}\n   123→"}]},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"f2fe8aee-b5d7-4d97-a1df-a175b73d3033","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/ChainLinkSection.css","content":"/* ChainLinkSection Component Styles */\n\n.chain-link-section {\n  margin-top: var(--spacing-xl);\n  border: 2px solid var(--color-bg-purple-border);\n  border-radius: var(--radius-lg);\n  background: linear-gradient(135deg, rgb(139 92 246 / 5%) 0%, rgb(124 58 237 / 5%) 100%);\n  overflow: hidden;\n}\n\n.chain-link-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background: linear-gradient(135deg, rgb(139 92 246 / 15%) 0%, rgb(124 58 237 / 15%) 100%);\n  border-bottom: 1px solid rgb(139 92 246 / 20%);\n}\n\n.chain-link-icon {\n  font-size: var(--font-size-lg);\n  line-height: 1;\n}\n\n.chain-link-title {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-purple-300);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.chain-link-flow {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background: rgb(139 92 246 / 8%);\n  border-bottom: 1px solid rgb(139 92 246 / 15%);\n  font-size: var(--font-size-xs);\n}\n\n.chain-link-location {\n  padding: 2px var(--spacing-md);\n  background: rgb(139 92 246 / 20%);\n  border: 1px solid rgb(139 92 246 / 30%);\n  border-radius: var(--radius-sm);\n  color: var(--color-purple-200);\n  font-weight: var(--font-weight-semibold);\n  font-family: var(--font-mono);\n}\n\n.chain-link-arrow {\n  color: var(--color-purple-400);\n  font-weight: var(--font-weight-bold);\n  font-size: var(--font-size-base);\n}\n\n.chain-link-theme {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-sm) var(--spacing-lg);\n  background: rgb(139 92 246 / 5%);\n  border-bottom: 1px solid rgb(139 92 246 / 15%);\n  font-size: var(--font-size-xs);\n}\n\n.chain-link-theme-label {\n  color: var(--color-purple-400);\n  font-weight: var(--font-weight-semibold);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.chain-link-theme-badge {\n  padding: 2px var(--spacing-md);\n  background: rgb(167 139 250 / 20%);\n  border: 1px solid rgb(167 139 250 / 30%);\n  border-radius: var(--radius-2xl);\n  color: var(--color-purple-200);\n  font-weight: var(--font-weight-semibold);\n  text-transform: capitalize;\n}\n\n.chain-link-content {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1px;\n  background: rgb(139 92 246 / 15%);\n}\n\n.chain-link-observation,\n.chain-link-clue {\n  padding: var(--spacing-lg);\n  background: var(--color-bg-deep-60);\n}\n\n.chain-link-observation {\n  background: rgb(30 27 75 / 30%);\n}\n\n.chain-link-clue {\n  background: rgb(55 48 163 / 15%);\n}\n\n.chain-link-section-label {\n  font-size: var(--font-size-2xs);\n  font-weight: var(--font-weight-bold);\n  color: var(--color-purple-400);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: var(--spacing-sm);\n}\n\n.chain-link-text {\n  font-family: var(--font-serif);\n  font-size: var(--font-size-sm);\n  line-height: var(--line-height-relaxed);\n  color: var(--color-purple-100);\n  font-style: italic;\n}\n","numLines":123,"startLine":1,"totalLines":123}}}
