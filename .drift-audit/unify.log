{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015MFC9KrLFM25FJA8HEvfdq","type":"tool_result","content":"     1→import React, { useRef } from \"react\";\n     2→import type { EraNarrativeLore } from \"../types/world.ts\";\n     3→import \"./EraNarrative.css\";\n     4→\n     5→interface EraNarrativeProps {\n     6→  lore: EraNarrativeLore;\n     7→  onClose: () => void;\n     8→}\n     9→\n    10→export default function EraNarrative({ lore, onClose }: Readonly<EraNarrativeProps>) {\n    11→  const mouseDownOnOverlay = useRef(false);\n    12→\n    13→  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    14→    mouseDownOnOverlay.current = e.target === e.currentTarget;\n    15→  };\n    16→\n    17→  const handleOverlayClick = (e: React.MouseEvent) => {\n    18→    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n    19→      onClose();\n    20→    }\n    21→  };\n    22→  // Extract title from the text (first sentence or before colon)\n    23→  const titleMatch = lore.text.match(/^([^:.]+)[:.]/) || lore.text.match(/^(.{0,50})/);\n    24→  const title = titleMatch ? titleMatch[1].trim() : \"Era Transition\";\n    25→  const narrative = lore.text;\n    26→\n    27→  return (\n    28→    <div\n    29→      className=\"era-narrative-overlay\"\n    30→      onMouseDown={handleOverlayMouseDown}\n    31→      onClick={handleOverlayClick}\n    32→      role=\"button\"\n    33→      tabIndex={0}\n    34→      onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n    35→    >\n    36→      <div className=\"era-narrative-modal\">\n    37→        <div className=\"era-narrative-header\">\n    38→          <div className=\"era-narrative-icon\">⚔️</div>\n    39→          <h2 className=\"era-narrative-title\">{title}</h2>\n    40→          <div className=\"era-narrative-icon\">⚔️</div>\n    41→        </div>\n    42→\n    43→        <div className=\"era-narrative-transition\">\n    44→          <span className=\"era-narrative-era era-narrative-era-from\">{lore.metadata.from}</span>\n    45→          <span className=\"era-narrative-arrow\">→</span>\n    46→          <span className=\"era-narrative-era era-narrative-era-to\">{lore.metadata.to}</span>\n    47→        </div>\n    48→\n    49→        <div className=\"era-narrative-content\">{narrative}</div>\n    50→\n    51→        <div className=\"era-narrative-footer\">\n    52→          <span className=\"era-narrative-tick\">Tick {lore.metadata.tick}</span>\n    53→          <button onClick={onClose} className=\"era-narrative-close\">\n    54→            Close\n    55→          </button>\n    56→        </div>\n    57→      </div>\n    58→    </div>\n    59→  );\n    60→}\n    61→"}]},"parent_tool_use_id":null,"session_id":"63b294a3-cb88-4d6f-836a-2de3de08695c","uuid":"cc18f7ba-3b29-4c43-af9c-9d79169b294e","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/archivist/webui/src/components/EraNarrative.tsx","content":"import React, { useRef } from \"react\";\nimport type { EraNarrativeLore } from \"../types/world.ts\";\nimport \"./EraNarrative.css\";\n\ninterface EraNarrativeProps {\n  lore: EraNarrativeLore;\n  onClose: () => void;\n}\n\nexport default function EraNarrative({ lore, onClose }: Readonly<EraNarrativeProps>) {\n  const mouseDownOnOverlay = useRef(false);\n\n  const handleOverlayMouseDown = (e: React.MouseEvent) => {\n    mouseDownOnOverlay.current = e.target === e.currentTarget;\n  };\n\n  const handleOverlayClick = (e: React.MouseEvent) => {\n    if (mouseDownOnOverlay.current && e.target === e.currentTarget) {\n      onClose();\n    }\n  };\n  // Extract title from the text (first sentence or before colon)\n  const titleMatch = lore.text.match(/^([^:.]+)[:.]/) || lore.text.match(/^(.{0,50})/);\n  const title = titleMatch ? titleMatch[1].trim() : \"Era Transition\";\n  const narrative = lore.text;\n\n  return (\n    <div\n      className=\"era-narrative-overlay\"\n      onMouseDown={handleOverlayMouseDown}\n      onClick={handleOverlayClick}\n      role=\"button\"\n      tabIndex={0}\n      onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") handleOverlayClick(e); }}\n    >\n      <div className=\"era-narrative-modal\">\n        <div className=\"era-narrative-header\">\n          <div className=\"era-narrative-icon\">⚔️</div>\n          <h2 className=\"era-narrative-title\">{title}</h2>\n          <div className=\"era-narrative-icon\">⚔️</div>\n        </div>\n\n        <div className=\"era-narrative-transition\">\n          <span className=\"era-narrative-era era-narrative-era-from\">{lore.metadata.from}</span>\n          <span className=\"era-narrative-arrow\">→</span>\n          <span className=\"era-narrative-era era-narrative-era-to\">{lore.metadata.to}</span>\n        </div>\n\n        <div className=\"era-narrative-content\">{narrative}</div>\n\n        <div className=\"era-narrative-footer\">\n          <span className=\"era-narrative-tick\">Tick {lore.metadata.tick}</span>\n          <button onClick={onClose} className=\"era-narrative-close\">\n            Close\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":61,"startLine":1,"totalLines":61}}}
