le {\n  font-size: var(--font-size-3xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-lg);\n  margin-bottom: var(--spacing-md);\n}\n\n.validation-subtitle {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin: 0;\n}\n\n.validation-status-badge {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-semibold);\n  padding: 4px 12px;\n  border-radius: var(--radius-pill);\n  text-transform: uppercase;\n}\n\n.validation-status-clean {\n  background-color: rgb(34 197 94 / 20%);\n  color: var(--color-success);\n}\n\n.validation-status-warning {\n  background-color: rgb(245 158 11 / 20%);\n  color: var(--color-warning);\n}\n\n.validation-status-error {\n  background-color: rgb(239 68 68 / 20%);\n  color: var(--color-danger);\n}\n\n.validation-export-row {\n  display: flex;\n  gap: var(--spacing-md);\n}\n\n.validation-export-button {\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  color: var(--color-text-dim);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.validation-export-button:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.validation-summary-cards {\n  display: grid;\n  gap: var(--spacing-xl);\n  margin-bottom: var(--spacing-2xl);\n}\n\n.validation-summary-cards-4 {\n  grid-template-columns: repeat(4, 1fr);\n}\n\n.validation-summary-card {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-xl);\n  text-align: center;\n}\n\n.validation-summary-value {\n  font-size: var(--font-size-3xl);\n  font-weight: var(--font-weight-semibold);\n  margin-bottom: var(--spacing-sm);\n}\n\n.validation-summary-label {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.validation-clean-state {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-4xl);\n  text-align: center;\n  margin-bottom: var(--spacing-2xl);\n}\n\n.validation-clean-icon {\n  font-size: 48px;\n  color: var(--color-success);\n  margin-bottom: var(--spacing-lg);\n}\n\n.validation-clean-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-md);\n}\n\n.validation-clean-message {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n}\n\n.validation-section {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-xl);\n  margin-bottom: var(--spacing-2xl);\n}\n\n.validation-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--spacing-xl);\n}\n\n.validation-section-title {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.validation-section-count {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-dark);\n  padding: 2px 8px;\n  border-radius: 10px;\n}\n\n.validation-issue-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-lg);\n}\n\n.validation-issue-card {\n  background-color: var(--color-bg-dark);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-md);\n  overflow: hidden;\n}\n\n.validation-issue-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-lg);\n  padding: var(--spacing-lg) var(--spacing-xl);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.validation-issue-header:hover {\n  background-color: rgb(59 130 246 / 5%);\n}\n\n.validation-issue-icon {\n  font-size: var(--font-size-lg);\n  flex-shrink: 0;\n}\n\n.validation-issue-title {\n  flex: 1;\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n}\n\n.validation-issue-count {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg);\n  padding: 2px 8px;\n  border-radius: 10px;\n}\n\n.validation-issue-severity {\n  font-size: var(--font-size-xs);\n  font-weight: var(--font-weight-semibold);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n  text-transform: uppercase;\n}\n\n.validation-issue-expand-icon {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  transition: transform var(--transition-fast);\n  flex-shrink: 0;\n}\n\n.validation-issue-content {\n  padding: 0 var(--spacing-xl) var(--spacing-xl);\n  border-top: 1px solid var(--color-border-light);\n}\n\n.validation-issue-message {\n  padding: var(--spacing-lg);\n  background-color: rgb(59 130 246 / 5%);\n  border-left: 3px solid var(--color-info);\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  margin-bottom: var(--spacing-lg);\n  margin-top: var(--spacing-lg);\n}\n\n.validation-affected-items {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-md);\n}\n\n.validation-affected-item {\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.validation-affected-item:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.validation-detail-row {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-muted);\n  padding-left: var(--spacing-lg);\n  margin-top: var(--spacing-xs);\n}\n\n.validation-rule-info {\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  padding: var(--spacing-xl);\n}\n\n.validation-rule-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-lg);\n}\n\n.validation-rule-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.validation-rule-item {\n  display: flex;\n  gap: var(--spacing-md);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  line-height: var(--line-height-normal);\n  margin-bottom: var(--spacing-lg);\n}\n\n.validation-rule-item:last-child {\n  margin-bottom: 0;\n}\n\n.validation-rule-bullet {\n  font-size: 8px;\n  flex-shrink: 0;\n  margin-top: 6px;\n}\n","numLines":310,"startLine":1,"totalLines":310}}}
