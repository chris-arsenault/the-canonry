-section:last-child {\n   413→  border-bottom: none;\n   414→}\n   415→\n   416→.transitions-mini-header {\n   417→  display: flex;\n   418→  align-items: center;\n   419→  gap: var(--spacing-sm);\n   420→  margin-bottom: var(--spacing-sm);\n   421→}\n   422→\n   423→.transitions-mini-icon {\n   424→  font-size: var(--font-size-sm);\n   425→  color: var(--color-text-dim);\n   426→}\n   427→\n   428→.transitions-mini-title {\n   429→  font-size: var(--font-size-sm);\n   430→  font-weight: var(--font-weight-medium);\n   431→  color: var(--color-text-secondary);\n   432→  text-transform: uppercase;\n   433→  letter-spacing: 0.5px;\n   434→}\n   435→\n   436→.transitions-mini-count {\n   437→  margin-left: auto;\n   438→  font-size: var(--font-size-xs);\n   439→  color: var(--color-text-muted);\n   440→  background-color: var(--color-bg-card);\n   441→  padding: 2px 8px;\n   442→  border-radius: var(--radius-pill);\n   443→}\n   444→\n   445→.transitions-mini-content {\n   446→  padding-left: var(--spacing-sm);\n   447→}\n   448→\n   449→.transitions-mini-empty {\n   450→  font-size: var(--font-size-sm);\n   451→  color: var(--color-text-muted);\n   452→  font-style: italic;\n   453→  padding: var(--spacing-sm) 0;\n   454→}\n   455→\n   456→.transitions-add-effect {\n   457→  margin-top: var(--spacing-sm);\n   458→}\n   459→\n   460→/* Responsive: stack on smaller screens */\n   461→@media (width <= 900px) {\n   462→  .transitions-grid {\n   463→    grid-template-columns: 1fr;\n   464→    gap: var(--spacing-md);\n   465→  }\n   466→\n   467→  .transitions-divider {\n   468→    display: none;\n   469→  }\n   470→}\n   471→"}]},"parent_tool_use_id":null,"session_id":"4f674cf0-9f5a-4696-8008-0664523e53e2","uuid":"0ba03403-78f7-4d39-8142-d8a85ff5288f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/card.css","content":"/**\n * Card component styles\n */\n\n/* Base card */\n.card {\n  background-color: var(--color-bg-card);\n  border-radius: var(--radius-2xl);\n  border: 1px solid var(--color-border);\n  padding: 20px;\n  transition: all var(--transition-normal);\n  position: relative;\n}\n\n.card-clickable {\n  cursor: pointer;\n}\n\n.card-clickable:hover {\n  border-color: var(--color-accent);\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-card-hover);\n}\n\n.card-disabled {\n  opacity: 0.5;\n}\n\n/* Card header */\n.card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: var(--spacing-lg);\n}\n\n.card-title {\n  font-size: var(--font-size-xl);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n  margin-bottom: var(--spacing-xs);\n}\n\n.card-id {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  font-family: monospace;\n  background-color: var(--color-bg-dark);\n  padding: 2px 6px;\n  border-radius: var(--radius-sm);\n}\n\n.card-desc {\n  font-size: var(--font-size-md);\n  color: var(--color-text-muted);\n  margin-top: var(--spacing-md);\n  line-height: var(--line-height-snug);\n}\n\n/* Add card (dashed border style) */\n.add-card {\n  background-color: transparent;\n  border-radius: var(--radius-2xl);\n  border: 2px dashed var(--color-border);\n  padding: 40px 20px;\n  cursor: pointer;\n  transition: all var(--transition-normal);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  color: var(--color-text-dim);\n  min-height: 140px;\n}\n\n.add-card:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.add-card-icon {\n  font-size: 24px;\n}\n\n/* Item card (collapsible) */\n.item-card {\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-xl);\n  border: 1px solid var(--color-border-light);\n  margin-bottom: var(--spacing-lg);\n  overflow: hidden;\n}\n\n.item-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: var(--spacing-lg) var(--spacing-xl);\n  background-color: var(--color-bg-card);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.item-card-header:hover,\n.item-card-header-hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.item-card-icon {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-md);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-xl);\n  background-color: rgb(59 130 246 / 20%);\n  flex-shrink: 0;\n}\n\n.item-card-icon-variable {\n  background-color: rgb(168 85 247 / 20%);\n}\n\n.item-card-icon-relationship {\n  background-color: rgb(20 184 166 / 20%);\n}\n\n.item-card-icon-creation {\n  background-color: rgb(245 158 11 / 20%);\n}\n\n.item-card-info {\n  flex: 1;\n  min-width: 0;\n  margin-left: var(--spacing-lg);\n}\n\n.item-card-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.item-card-subtitle {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n  margin-top: var(--spacing-xs);\n}\n\n.item-card-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n}\n\n.item-card-body {\n  padding: var(--spacing-xl);\n}\n\n/* Variable/entity references */\n.variable-ref,\n.entity-ref {\n  font-family: monospace;\n  font-size: var(--font-size-lg);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n/* Relationship visualization */\n.rel-visual {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  flex: 1;\n}\n\n.rel-ref {\n  font-family: monospace;\n  font-size: var(--font-size-md);\n  color: var(--color-purple);\n  background-color: rgb(168 85 247 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-arrow {\n  color: var(--color-text-dim);\n  font-size: var(--font-size-lg);\n}\n\n.rel-kind {\n  font-size: var(--font-size-md);\n  color: var(--color-teal);\n  background-color: rgb(20 184 166 / 15%);\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.rel-bidirectional {\n  font-size: var(--font-size-lg);\n  color: var(--color-accent);\n  margin-left: var(--spacing-sm);\n}\n\n/* Add form (inline add) */\n.add-form {\n  background-color: var(--color-bg-card);\n  padding: var(--spacing-xl);\n}\n\n.add-form-fields {\n  display: flex;\n  align-items: flex-end;\n  gap: var(--spacing-lg);\n}\n\n\n/* Card stats row */\n.card-stats {\n  display: flex;\n  gap: var(--spacing-xl);\n  margin: var(--spacing-lg) 0;\n  flex-wrap: wrap;\n}\n\n.card-stat {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n/* Card badges container */\n.card-badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-sm);\n  margin-top: var(--spacing-md);\n}\n\n/* Card validation states */\n.card-error {\n  border-color: var(--color-danger);\n}\n\n.card-warning {\n  border-color: var(--color-warning);\n}\n\n/* Card inline badges */\n.card-error-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(239 68 68 / 20%);\n  color: #fca5a5;\n}\n\n.card-usage-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(59 130 246 / 20%);\n  color: #93c5fd;\n}\n\n.card-orphan-badge {\n  font-size: var(--font-size-xs);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n  background-color: rgb(156 163 175 / 20%);\n  color: #d1d5db;\n}\n\n/* Card footer */\n.card-footer {\n  margin-top: var(--spacing-2xl);\n  padding-top: var(--spacing-xl);\n  border-top: 1px solid var(--color-border-light);\n}\n\n/* Stat total (secondary count display) */\n.stat-total {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-normal);\n  color: var(--color-text-dim);\n}\n\n/* Weights accordion (used in Eras for generator/system weights) */\n.weights-accordion {\n  margin-top: var(--spacing-xl);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n}\n\n.weights-accordion-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-dark);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.weights-accordion-header:hover {\n  background-color: rgb(59 130 246 / 10%);\n}\n\n.weights-accordion-header.expanded {\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.weights-accordion-icon {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n  transition: transform var(--transition-fast);\n}\n\n.weights-accordion-title {\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text);\n}\n\n.weights-accordion-summary {\n  margin-left: auto;\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n}\n\n.weights-accordion-content {\n  padding: var(--spacing-lg);\n  background-color: var(--color-bg-card);\n}\n\n/* Transitions Grid - Two-column layout for entry/exit */\n.transitions-grid {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: var(--spacing-lg);\n  margin-top: var(--spacing-xl);\n}\n\n.transitions-column {\n  background-color: var(--color-bg-dark);\n  border-radius: var(--radius-lg);\n  border: 1px solid var(--color-border-light);\n  overflow: hidden;\n}\n\n.transitions-column-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: var(--spacing-md) var(--spacing-lg);\n  background-color: var(--color-bg-card);\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.transitions-entry .transitions-column-header {\n  border-left: 3px solid var(--color-success);\n}\n\n.transitions-exit .transitions-column-header {\n  border-left: 3px solid var(--color-accent);\n}\n\n.transitions-column-icon {\n  font-size: var(--font-size-lg);\n}\n\n.transitions-column-title {\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-semibold);\n  color: var(--color-text);\n}\n\n.transitions-column-subtitle {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  margin-left: auto;\n}\n\n.transitions-divider {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: var(--spacing-lg) 0;\n}\n\n.transitions-arrow {\n  font-size: 24px;\n  color: var(--color-text-dim);\n}\n\n/* Mini sections within transitions columns */\n.transitions-mini-section {\n  padding: var(--spacing-md) var(--spacing-lg);\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.transitions-mini-section:last-child {\n  border-bottom: none;\n}\n\n.transitions-mini-header {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  margin-bottom: var(--spacing-sm);\n}\n\n.transitions-mini-icon {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-dim);\n}\n\n.transitions-mini-title {\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  color: var(--color-text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.transitions-mini-count {\n  margin-left: auto;\n  font-size: var(--font-size-xs);\n  color: var(--color-text-muted);\n  background-color: var(--color-bg-card);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n}\n\n.transitions-mini-content {\n  padding-left: var(--spacing-sm);\n}\n\n.transitions-mini-empty {\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  font-style: italic;\n  padding: var(--spacing-sm) 0;\n}\n\n.transitions-add-effect {\n  margin-top: var(--spacing-sm);\n}\n\n/* Responsive: stack on smaller screens */\n@media (width <= 900px) {\n  .transitions-grid {\n    grid-template-columns: 1fr;\n    gap: var(--spacing-md);\n  }\n\n  .transitions-divider {\n    display: none;\n  }\n}\n","numLines":471,"startLine":1,"totalLines":471}}}
