4px 0 0;\n   250→  font-size: 10px;\n   251→  color: var(--text-muted);\n   252→}\n   253→\n   254→/* Footer */\n   255→.bcm-footer {\n   256→  padding: 12px 20px 16px;\n   257→  border-top: 1px solid var(--border-color);\n   258→  display: flex;\n   259→  gap: 8px;\n   260→  justify-content: flex-end;\n   261→  flex-shrink: 0;\n   262→}\n   263→\n   264→.bcm-footer-btn {\n   265→  padding: 6px 16px;\n   266→  font-size: 12px;\n   267→}\n   268→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"1209f9ea-771d-4ffe-b488-dc3ebe807f4c","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BackportConfigModal.css","content":"/* BackportConfigModal — bcm- prefix */\n\n.bcm-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgb(0 0 0 / 60%);\n}\n\n.bcm-dialog {\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  width: 500px;\n  max-width: 95vw;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgb(0 0 0 / 30%);\n}\n\n/* Header */\n.bcm-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  flex-shrink: 0;\n}\n\n.bcm-title {\n  margin: 0;\n  font-size: 16px;\n}\n\n.bcm-subtitle-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 4px;\n}\n\n.bcm-chronicle-title {\n  margin: 0;\n  font-size: 11px;\n  color: var(--text-muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  flex: 1;\n}\n\n.bcm-progress {\n  font-size: 11px;\n  font-weight: 500;\n  white-space: nowrap;\n  margin-left: 8px;\n  color: var(--bcm-progress-color);\n}\n\n/* Body */\n.bcm-body {\n  padding: 16px 20px;\n  overflow-y: auto;\n  flex: 1;\n  min-height: 0;\n}\n\n.bcm-section {\n  margin-bottom: 16px;\n}\n\n.bcm-section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n\n.bcm-section-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n}\n\n.bcm-action-group {\n  display: flex;\n  gap: 8px;\n}\n\n.bcm-text-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  font-size: 11px;\n  padding: 0;\n}\n\n.bcm-text-btn-tertiary {\n  color: #8b5cf6;\n}\n\n.bcm-text-btn-accent {\n  color: var(--accent-color);\n}\n\n.bcm-entity-list {\n  background: var(--bg-secondary);\n  border-radius: 6px;\n  padding: 8px 12px;\n  max-height: 240px;\n  overflow-y: auto;\n}\n\n/* Entity row */\n.bcm-entity-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 0;\n  font-size: 12px;\n}\n\n.bcm-entity-row-locked {\n  opacity: 0.6;\n}\n\n.bcm-status-icon {\n  width: 13px;\n  text-align: center;\n  font-size: 11px;\n}\n\n.bcm-status-icon-done {\n  color: #10b981;\n}\n\n.bcm-status-icon-skipped {\n  color: var(--text-muted);\n}\n\n.bcm-checkbox {\n  cursor: pointer;\n}\n\n.bcm-entity-name {\n  flex: 1;\n}\n\n.bcm-entity-name-clickable {\n  cursor: pointer;\n}\n\n.bcm-entity-name-locked {\n  cursor: default;\n}\n\n.bcm-entity-kind {\n  color: var(--text-muted);\n  margin-left: 6px;\n}\n\n/* Status tags */\n.bcm-tag {\n  font-size: 9px;\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.bcm-tag-done {\n  background: rgb(16 185 129 / 15%);\n  color: #10b981;\n}\n\n.bcm-tag-skipped {\n  background: rgb(107 114 128 / 15%);\n  color: var(--text-muted);\n}\n\n.bcm-tag-lens {\n  background: rgb(139 92 246 / 15%);\n  color: #8b5cf6;\n}\n\n.bcm-tag-tertiary {\n  background: rgb(245 158 11 / 15%);\n  color: #f59e0b;\n}\n\n.bcm-skip-btn {\n  background: none;\n  border: none;\n  color: var(--text-muted);\n  cursor: pointer;\n  font-size: 10px;\n  padding: 1px 4px;\n  opacity: 0.7;\n}\n\n.bcm-skip-btn:hover {\n  opacity: 1;\n}\n\n/* Dividers */\n.bcm-divider {\n  border-top: 1px solid var(--border-color);\n  margin-top: 4px;\n  padding-top: 4px;\n}\n\n.bcm-tertiary-label {\n  font-size: 9px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  font-weight: 600;\n  margin-bottom: 2px;\n}\n\n/* Custom instructions */\n.bcm-instructions-label {\n  display: block;\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.bcm-textarea {\n  width: 100%;\n  padding: 8px 10px;\n  font-size: 12px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-primary);\n  resize: vertical;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n\n.bcm-instructions-hint {\n  margin: 4px 0 0;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* Footer */\n.bcm-footer {\n  padding: 12px 20px 16px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  gap: 8px;\n  justify-content: flex-end;\n  flex-shrink: 0;\n}\n\n.bcm-footer-btn {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","numLines":268,"startLine":1,"totalLines":268}}}
