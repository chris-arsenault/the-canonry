{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NsZBqBCJw8MBpeqpxE85eM","type":"tool_result","content":"     1→/**\n     2→ * BulkOperationShell - Shared wrapper for bulk operation modals\n     3→ *\n     4→ * Handles the identical structural parts of all bulk modals:\n     5→ * - Overlay + dialog with dynamic width\n     6→ * - Header with title, minimize button, status text\n     7→ * - Floating pill lifecycle (minimize, update, cleanup)\n     8→ * - Footer button logic (confirm/cancel/close)\n     9→ * - Phase detection (confirming → running → terminal)\n    10→ *\n    11→ * Each bulk modal provides:\n    12→ * - pillId, title, tabId for pill identity\n    13→ * - confirmLabel for the confirm button text\n    14→ * - statusText for the header status display\n    15→ * - children for phase-specific body content\n    16→ */\n    17→\n    18→import React, { useEffect } from \"react\";\n    19→import PropTypes from \"prop-types\";\n    20→import { useFloatingPillStore } from \"../lib/db/floatingPillStore\";\n    21→import { ErrorMessage } from \"@the-canonry/shared-components\";\n    22→import \"./BulkOperationShell.css\";\n    23→const STATUS_COLORS = {\n    24→  running: \"#f59e0b\",\n    25→  complete: \"#10b981\",\n    26→  failed: \"#ef4444\",\n    27→  cancelled: \"#f59e0b\"\n    28→};\n    29→function getStatusColor(status) {\n    30→  return STATUS_COLORS[status] || \"#6b7280\";\n    31→}\n    32→export default function BulkOperationShell({\n    33→  pillId,\n    34→  title,\n    35→  tabId = \"chronicle\",\n    36→  progress,\n    37→  onConfirm,\n    38→  onCancel,\n    39→  onClose,\n    40→  confirmLabel,\n    41→  statusText,\n    42→  pillStatusText,\n    43→  confirmWidth = \"540px\",\n    44→  processWidth = \"480px\",\n    45→  children\n    46→}) {\n    47→  const isMinimized = useFloatingPillStore(s => s.isMinimized(pillId));\n    48→  const progressStatus = progress?.status;\n    49→\n    50→  // Update pill when minimized\n    51→  useEffect(() => {\n    52→    if (!isMinimized || !progress) return;\n    53→    useFloatingPillStore.getState().updatePill(pillId, {\n    54→      statusText: pillStatusText || progressStatus,\n    55→      statusColor: getStatusColor(progressStatus)\n    56→    });\n    57→  }, [isMinimized, progress, progressStatus, pillId, pillStatusText]);\n    58→\n    59→  // Clean up pill when idle\n    60→  useEffect(() => {\n    61→    if (!progress || progressStatus === \"idle\") {\n    62→      useFloatingPillStore.getState().remove(pillId);\n    63→    }\n    64→  }, [progress, progressStatus, pillId]);\n    65→  if (!progress || progress.status === \"idle\") return null;\n    66→  if (isMinimized) return null;\n    67→  const isConfirming = progress.status === \"confirming\";\n    68→  const isTerminal = progress.status === \"complete\" || progress.status === \"cancelled\" || progress.status === \"failed\";\n    69→  const handleMinimize = () => {\n    70→    useFloatingPillStore.getState().minimize({\n    71→      id: pillId,\n    72→      label: title,\n    73→      statusText: pillStatusText || progressStatus,\n    74→      statusColor: getStatusColor(progressStatus),\n    75→      tabId\n    76→    });\n    77→  };\n    78→  return <div className=\"bulk-overlay\">\n    79→      <div className=\"bulk-dialog\" style={{\n    80→      \"--bulk-dialog-width\": isConfirming ? confirmWidth : processWidth\n    81→    }}>\n    82→        {/* Header */}\n    83→        <div className=\"bulk-header\">\n    84→          <div className=\"bulk-header-row\">\n    85→            <h2 className=\"bulk-title\">{title}</h2>\n    86→            <div className=\"bulk-header-actions\">\n    87→              {!isConfirming && <button onClick={handleMinimize} className=\"illuminator-button bulk-minimize-btn\" title=\"Minimize to pill\">\n    88→                  ―\n    89→                </button>}\n    90→              <span className={`bulk-status bulk-status-${progress.status}`}>\n    91→                {statusText}\n    92→              </span>\n    93→            </div>\n    94→          </div>\n    95→        </div>\n    96→\n    97→        {/* Body */}\n    98→        <div className={`bulk-body ${isConfirming ? \"bulk-body-confirming\" : \"bulk-body-processing\"}`}>\n    99→          {children}\n   100→        </div>\n   101→\n   102→        {/* Footer */}\n   103→        <div className=\"bulk-footer\">\n   104→          {isConfirming && <>\n   105→              <button onClick={onCancel} className=\"illuminator-button bulk-footer-btn\">\n   106→                Cancel\n   107→              </button>\n   108→              <button onClick={onConfirm} className=\"illuminator-button illuminator-button-primary bulk-footer-btn\">\n   109→                {confirmLabel}\n   110→              </button>\n   111→            </>}\n   112→          {!isConfirming && !isTerminal && <button onClick={onCancel} className=\"illuminator-button bulk-footer-btn\">\n   113→              Cancel\n   114→            </button>}\n   115→          {isTerminal && <button onClick={onClose} className=\"illuminator-button bulk-footer-btn\">\n   116→              Close\n   117→            </button>}\n   118→        </div>\n   119→      </div>\n   120→    </div>;\n   121→}\n   122→\n   123→/**\n   124→ * Shared progress bar component for bulk operations\n   125→ */\n   126→export function BulkProgressBar({\n   127→  processed,\n   128→  total,\n   129→  status\n   130→}) {\n   131→  const pct = total > 0 ? Math.round(processed / total * 100) : 0;\n   132→  let fillClass = \"bulk-progress-fill-ok\";\n   133→  if (status === \"failed\") fillClass = \"bulk-progress-fill-failed\";else if (status === \"cancelled\") fillClass = \"bulk-progress-fill-cancelled\";\n   134→  return <div className=\"bulk-progress-section\">\n   135→      <div className=\"bulk-progress-header\">\n   136→        <span className=\"bulk-progress-label\">\n   137→          {Math.min(processed + 1, total)} / {total}\n   138→        </span>\n   139→        <span className=\"bulk-progress-pct\">{pct}%</span>\n   140→      </div>\n   141→      <div className=\"bulk-progress-track\">\n   142→        <div className={`bulk-progress-fill ${fillClass}`} style={{\n   143→        \"--bulk-progress-width\": `${pct}%`\n   144→      }} />\n   145→      </div>\n   146→    </div>;\n   147→}\n   148→\n   149→/**\n   150→ * Shared terminal message component for bulk operations\n   151→ */\n   152→export function BulkTerminalMessage({\n   153→  status,\n   154→  children\n   155→}) {\n   156→  return <div className={`bulk-terminal-msg bulk-terminal-msg-${status}`}>\n   157→      {children}\n   158→    </div>;\n   159→}\n   160→\n   161→/**\n   162→ * Shared failed items list component for bulk operations\n   163→ */\n   164→export function BulkFailedList({\n   165→  items,\n   166→  labelKey = \"title\",\n   167→  errorKey = \"error\"\n   168→}) {\n   169→  if (!items || items.length === 0) return null;\n   170→  return <div className=\"bulk-failed-section\">\n   171→      <div className=\"bulk-failed-label\">Failed ({items.length})</div>\n   172→      <div className=\"bulk-failed-list\">\n   173→        {items.map((item, i) => <ErrorMessage\n   174→            key={item.id || item.chronicleId || item.entityId || i}\n   175→            title={item[labelKey]}\n   176→            message={item[errorKey]}\n   177→            className=\"bulk-failed-item\"\n   178→          />)}\n   179→      </div>\n   180→    </div>;\n   181→}\n   182→\n   183→/**\n   184→ * Shared cost display for bulk operations\n   185→ */\n   186→export function BulkCost({\n   187→  cost\n   188→}) {\n   189→  if (!cost || cost <= 0) return null;\n   190→  return <div className=\"bulk-cost\">Cost: ${cost.toFixed(4)}</div>;\n   191→}\n   192→BulkOperationShell.propTypes = {\n   193→  pillId: PropTypes.string.isRequired,\n   194→  title: PropTypes.string.isRequired,\n   195→  tabId: PropTypes.string,\n   196→  progress: PropTypes.object,\n   197→  onConfirm: PropTypes.func.isRequired,\n   198→  onCancel: PropTypes.func.isRequired,\n   199→  onClose: PropTypes.func.isRequired,\n   200→  confirmLabel: PropTypes.string.isRequired,\n   201→  statusText: PropTypes.string,\n   202→  pillStatusText: PropTypes.string,\n   203→  confirmWidth: PropTypes.string,\n   204→  processWidth: PropTypes.string,\n   205→  children: PropTypes.node\n   206→};\n   207→BulkProgressBar.propTypes = {\n   208→  processed: PropTypes.number.isRequired,\n   209→  total: PropTypes.number.isRequired,\n   210→  status: PropTypes.string\n   211→};\n   212→BulkTerminalMessage.propTypes = {\n   213→  status: PropTypes.string.isRequired,\n   214→  children: PropTypes.node\n   215→};\n   216→BulkFailedList.propTypes = {\n   217→  items: PropTypes.array,\n   218→  labelKey: PropTypes.string,\n   219→  errorKey: PropTypes.string\n   220→};\n   221→BulkCost.propTypes = {\n   222→  cost: PropTypes.number\n   223→};\n   224→"}]},"parent_tool_use_id":null,"session_id":"9f489ea2-964b-4b12-9123-73dad996ade9","uuid":"dc5d6feb-7d9e-4ac6-b062-3bfab83b2ab6","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BulkOperationShell.jsx","content":"/**\n * BulkOperationShell - Shared wrapper for bulk operation modals\n *\n * Handles the identical structural parts of all bulk modals:\n * - Overlay + dialog with dynamic width\n * - Header with title, minimize button, status text\n * - Floating pill lifecycle (minimize, update, cleanup)\n * - Footer button logic (confirm/cancel/close)\n * - Phase detection (confirming → running → terminal)\n *\n * Each bulk modal provides:\n * - pillId, title, tabId for pill identity\n * - confirmLabel for the confirm button text\n * - statusText for the header status display\n * - children for phase-specific body content\n */\n\nimport React, { useEffect } from \"react\";\nimport PropTypes from \"prop-types\";\nimport { useFloatingPillStore } from \"../lib/db/floatingPillStore\";\nimport { ErrorMessage } from \"@the-canonry/shared-components\";\nimport \"./BulkOperationShell.css\";\nconst STATUS_COLORS = {\n  running: \"#f59e0b\",\n  complete: \"#10b981\",\n  failed: \"#ef4444\",\n  cancelled: \"#f59e0b\"\n};\nfunction getStatusColor(status) {\n  return STATUS_COLORS[status] || \"#6b7280\";\n}\nexport default function BulkOperationShell({\n  pillId,\n  title,\n  tabId = \"chronicle\",\n  progress,\n  onConfirm,\n  onCancel,\n  onClose,\n  confirmLabel,\n  statusText,\n  pillStatusText,\n  confirmWidth = \"540px\",\n  processWidth = \"480px\",\n  children\n}) {\n  const isMinimized = useFloatingPillStore(s => s.isMinimized(pillId));\n  const progressStatus = progress?.status;\n\n  // Update pill when minimized\n  useEffect(() => {\n    if (!isMinimized || !progress) return;\n    useFloatingPillStore.getState().updatePill(pillId, {\n      statusText: pillStatusText || progressStatus,\n      statusColor: getStatusColor(progressStatus)\n    });\n  }, [isMinimized, progress, progressStatus, pillId, pillStatusText]);\n\n  // Clean up pill when idle\n  useEffect(() => {\n    if (!progress || progressStatus === \"idle\") {\n      useFloatingPillStore.getState().remove(pillId);\n    }\n  }, [progress, progressStatus, pillId]);\n  if (!progress || progress.status === \"idle\") return null;\n  if (isMinimized) return null;\n  const isConfirming = progress.status === \"confirming\";\n  const isTerminal = progress.status === \"complete\" || progress.status === \"cancelled\" || progress.status === \"failed\";\n  const handleMinimize = () => {\n    useFloatingPillStore.getState().minimize({\n      id: pillId,\n      label: title,\n      statusText: pillStatusText || progressStatus,\n      statusColor: getStatusColor(progressStatus),\n      tabId\n    });\n  };\n  return <div className=\"bulk-overlay\">\n      <div className=\"bulk-dialog\" style={{\n      \"--bulk-dialog-width\": isConfirming ? confirmWidth : processWidth\n    }}>\n        {/* Header */}\n        <div className=\"bulk-header\">\n          <div className=\"bulk-header-row\">\n            <h2 className=\"bulk-title\">{title}</h2>\n            <div className=\"bulk-header-actions\">\n              {!isConfirming && <button onClick={handleMinimize} className=\"illuminator-button bulk-minimize-btn\" title=\"Minimize to pill\">\n                  ―\n                </button>}\n              <span className={`bulk-status bulk-status-${progress.status}`}>\n                {statusText}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Body */}\n        <div className={`bulk-body ${isConfirming ? \"bulk-body-confirming\" : \"bulk-body-processing\"}`}>\n          {children}\n        </div>\n\n        {/* Footer */}\n        <div className=\"bulk-footer\">\n          {isConfirming && <>\n              <button onClick={onCancel} className=\"illuminator-button bulk-footer-btn\">\n                Cancel\n              </button>\n              <button onClick={onConfirm} className=\"illuminator-button illuminator-button-primary bulk-footer-btn\">\n                {confirmLabel}\n              </button>\n            </>}\n          {!isConfirming && !isTerminal && <button onClick={onCancel} className=\"illuminator-button bulk-footer-btn\">\n              Cancel\n            </button>}\n          {isTerminal && <button onClick={onClose} className=\"illuminator-button bulk-footer-btn\">\n              Close\n            </button>}\n        </div>\n      </div>\n    </div>;\n}\n\n/**\n * Shared progress bar component for bulk operations\n */\nexport function BulkProgressBar({\n  processed,\n  total,\n  status\n}) {\n  const pct = total > 0 ? Math.round(processed / total * 100) : 0;\n  let fillClass = \"bulk-progress-fill-ok\";\n  if (status === \"failed\") fillClass = \"bulk-progress-fill-failed\";else if (status === \"cancelled\") fillClass = \"bulk-progress-fill-cancelled\";\n  return <div className=\"bulk-progress-section\">\n      <div className=\"bulk-progress-header\">\n        <span className=\"bulk-progress-label\">\n          {Math.min(processed + 1, total)} / {total}\n        </span>\n        <span className=\"bulk-progress-pct\">{pct}%</span>\n      </div>\n      <div className=\"bulk-progress-track\">\n        <div className={`bulk-progress-fill ${fillClass}`} style={{\n        \"--bulk-progress-width\": `${pct}%`\n      }} />\n      </div>\n    </div>;\n}\n\n/**\n * Shared terminal message component for bulk operations\n */\nexport function BulkTerminalMessage({\n  status,\n  children\n}) {\n  return <div className={`bulk-terminal-msg bulk-terminal-msg-${status}`}>\n      {children}\n    </div>;\n}\n\n/**\n * Shared failed items list component for bulk operations\n */\nexport function BulkFailedList({\n  items,\n  labelKey = \"title\",\n  errorKey = \"error\"\n}) {\n  if (!items || items.length === 0) return null;\n  return <div className=\"bulk-failed-section\">\n      <div className=\"bulk-failed-label\">Failed ({items.length})</div>\n      <div className=\"bulk-failed-list\">\n        {items.map((item, i) => <ErrorMessage\n            key={item.id || item.chronicleId || item.entityId || i}\n            title={item[labelKey]}\n            message={item[errorKey]}\n            className=\"bulk-failed-item\"\n          />)}\n      </div>\n    </div>;\n}\n\n/**\n * Shared cost display for bulk operations\n */\nexport function BulkCost({\n  cost\n}) {\n  if (!cost || cost <= 0) return null;\n  return <div className=\"bulk-cost\">Cost: ${cost.toFixed(4)}</div>;\n}\nBulkOperationShell.propTypes = {\n  pillId: PropTypes.string.isRequired,\n  title: PropTypes.string.isRequired,\n  tabId: PropTypes.string,\n  progress: PropTypes.object,\n  onConfirm: PropTypes.func.isRequired,\n  onCancel: PropTypes.func.isRequired,\n  onClose: PropTypes.func.isRequired,\n  confirmLabel: PropTypes.string.isRequired,\n  statusText: PropTypes.string,\n  pillStatusText: PropTypes.string,\n  confirmWidth: PropTypes.string,\n  processWidth: PropTypes.string,\n  children: PropTypes.node\n};\nBulkProgressBar.propTypes = {\n  processed: PropTypes.number.isRequired,\n  total: PropTypes.number.isRequired,\n  status: PropTypes.string\n};\nBulkTerminalMessage.propTypes = {\n  status: PropTypes.string.isRequired,\n  children: PropTypes.node\n};\nBulkFailedList.propTypes = {\n  items: PropTypes.array,\n  labelKey: PropTypes.string,\n  errorKey: PropTypes.string\n};\nBulkCost.propTypes = {\n  cost: PropTypes.number\n};\n","numLines":224,"startLine":1,"totalLines":224}}}
