{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011KEYMCwkmzhqCxaMZs6rDH","type":"tool_result","content":"     1→/**\n     2→ * NumberInput - Reusable number input that properly handles negative numbers\n     3→ *\n     4→ * Fixes the common bug where typing a minus sign is blocked because the\n     5→ * onChange handler immediately parses and rejects \"-\" as invalid.\n     6→ *\n     7→ * Uses internal string state during editing, only parsing to number on blur\n     8→ * or when the full value is valid. Tracks focus state to prevent parent\n     9→ * re-renders from disrupting user input.\n    10→ */\n    11→\n    12→import React, { useState, useCallback } from 'react';\n    13→import PropTypes from 'prop-types';\n    14→\n    15→function formatValue(val) {\n    16→  if (val === undefined || val === null || val === '') return '';\n    17→  return String(val);\n    18→}\n    19→\n    20→/**\n    21→ * @param {Object} props\n    22→ * @param {number|undefined|null} props.value - The numeric value\n    23→ * @param {Function} props.onChange - Called with the parsed number when valid\n    24→ * @param {string} [props.className] - CSS class for the input\n    25→ * @param {number} [props.min] - Minimum value\n    26→ * @param {number} [props.max] - Maximum value\n    27→ * @param {number|string} [props.step] - Step value for increment/decrement\n    28→ * @param {string} [props.placeholder] - Placeholder text\n    29→ * @param {boolean} [props.allowEmpty] - If true, empty string calls onChange(undefined)\n    30→ * @param {boolean} [props.integer] - If true, only allow integers\n    31→ * @param {boolean} [props.disabled] - Disable the input\n    32→ */\n    33→export function NumberInput({\n    34→  value,\n    35→  onChange,\n    36→  className = 'input',\n    37→  min,\n    38→  max,\n    39→  step: _step,\n    40→  placeholder,\n    41→  allowEmpty = false,\n    42→  integer = false,\n    43→  disabled = false,\n    44→  ...rest\n    45→}) {\n    46→  const externalDisplayValue = formatValue(value);\n    47→  // Internal string state for editing\n    48→  const [localValue, setLocalValue] = useState(() => externalDisplayValue);\n    49→  // Track focus in state so render can safely choose draft vs external value\n    50→  const [isFocused, setIsFocused] = useState(false);\n    51→\n    52→  const parseValue = useCallback((str) => {\n    53→    if (str === '' || str === '-' || str === '.' || str === '-.') {\n    54→      return null; // Intermediate state, not a valid number yet\n    55→    }\n    56→    const parsed = integer ? parseInt(str, 10) : parseFloat(str);\n    57→    if (isNaN(parsed)) return null;\n    58→    return parsed;\n    59→  }, [integer]);\n    60→\n    61→  const handleFocus = useCallback(() => {\n    62→    setLocalValue(externalDisplayValue);\n    63→    setIsFocused(true);\n    64→  }, [externalDisplayValue]);\n    65→\n    66→  const handleChange = useCallback((e) => {\n    67→    const newValue = e.target.value;\n    68→\n    69→    // Allow empty, minus sign, decimal point, or any numeric pattern\n    70→    // This regex allows intermediate states like \"-\", \".\", \"-.\", \"1.\", \"-1.\"\n    71→    /* eslint-disable sonarjs/slow-regex -- short user input (single number field value) */\n    72→    const validPattern = integer\n    73→      ? /^-?\\d*$/  // Integer: optional minus, digits only\n    74→      : /^-?\\d*\\.?\\d*$/; // Float: optional minus, digits, optional decimal, more digits\n    75→    /* eslint-enable sonarjs/slow-regex */\n    76→\n    77→    if (!validPattern.test(newValue)) {\n    78→      return; // Reject invalid characters\n    79→    }\n    80→\n    81→    setLocalValue(newValue);\n    82→\n    83→    // Try to parse and update parent if it's a complete valid number\n    84→    const parsed = parseValue(newValue);\n    85→    if (parsed !== null) {\n    86→      // Apply min/max constraints\n    87→      let constrained = parsed;\n    88→      if (min !== undefined && constrained < min) constrained = min;\n    89→      if (max !== undefined && constrained > max) constrained = max;\n    90→      onChange(constrained);\n    91→    } else if (allowEmpty && newValue === '') {\n    92→      onChange(undefined);\n    93→    }\n    94→  }, [onChange, min, max, allowEmpty, integer, parseValue]);\n    95→\n    96→  const handleBlur = useCallback(() => {\n    97→    setIsFocused(false);\n    98→\n    99→    // On blur, ensure the display value matches the actual value\n   100→    const parsed = parseValue(localValue);\n   101→    if (parsed !== null) {\n   102→      // Apply constraints and update\n   103→      let constrained = parsed;\n   104→      if (min !== undefined && constrained < min) constrained = min;\n   105→      if (max !== undefined && constrained > max) constrained = max;\n   106→      setLocalValue(formatValue(constrained));\n   107→      onChange(constrained);\n   108→    } else if (allowEmpty && localValue === '') {\n   109→      onChange(undefined);\n   110→    } else {\n   111→      // Revert to the parent's value if local is invalid\n   112→      setLocalValue(externalDisplayValue);\n   113→    }\n   114→  }, [allowEmpty, externalDisplayValue, localValue, max, min, onChange, parseValue]);\n   115→\n   116→  return (\n   117→    <input\n   118→      type=\"text\"\n   119→      inputMode=\"numeric\"\n   120→      value={isFocused ? localValue : externalDisplayValue}\n   121→      onChange={handleChange}\n   122→      onFocus={handleFocus}\n   123→      onBlur={handleBlur}\n   124→      className={className}\n   125→      placeholder={placeholder}\n   126→      disabled={disabled}\n   127→      {...rest}\n   128→    />\n   129→  );\n   130→}\n   131→\n   132→export default NumberInput;\n   133→\n   134→NumberInput.propTypes = {\n   135→  value: PropTypes.number,\n   136→  onChange: PropTypes.func.isRequired,\n   137→  className: PropTypes.string,\n   138→  min: PropTypes.number,\n   139→  max: PropTypes.number,\n   140→  step: PropTypes.oneOfType([PropTypes.number, PropTypes.string]),\n   141→  placeholder: PropTypes.string,\n   142→  allowEmpty: PropTypes.bool,\n   143→  integer: PropTypes.bool,\n   144→  disabled: PropTypes.bool,\n   145→};\n   146→"}]},"parent_tool_use_id":"toolu_01DXHnyHJoT74nhx47Xbmsts","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"7bd42024-cbc4-454d-8d74-890c07da5d2e"}
