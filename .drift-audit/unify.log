color: var(--text-muted);\n    84→}\n    85→\n    86→.ipm-grid {\n    87→  display: grid;\n    88→  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n    89→  gap: 12px;\n    90→}\n    91→\n    92→/* Image card */\n    93→.ipm-card {\n    94→  position: relative;\n    95→  background: var(--bg-tertiary);\n    96→  border-radius: 8px;\n    97→  overflow: hidden;\n    98→  cursor: pointer;\n    99→  border: 2px solid transparent;\n   100→}\n   101→\n   102→.ipm-card-selected {\n   103→  border-color: var(--accent-color);\n   104→}\n   105→\n   106→.ipm-card-current {\n   107→  border-color: var(--success);\n   108→  opacity: 0.7;\n   109→}\n   110→\n   111→.ipm-current-badge {\n   112→  position: absolute;\n   113→  top: 6px;\n   114→  right: 6px;\n   115→  z-index: 1;\n   116→  padding: 2px 6px;\n   117→  background: var(--success);\n   118→  color: white;\n   119→  border-radius: 3px;\n   120→  font-size: 9px;\n   121→  font-weight: 600;\n   122→}\n   123→\n   124→.ipm-thumbnail-wrapper {\n   125→  width: 100%;\n   126→  padding-top: 100%;\n   127→  position: relative;\n   128→}\n   129→\n   130→.ipm-card-info {\n   131→  padding: 8px;\n   132→}\n   133→\n   134→.ipm-card-name {\n   135→  font-size: 11px;\n   136→  font-weight: 500;\n   137→  white-space: nowrap;\n   138→  overflow: hidden;\n   139→  text-overflow: ellipsis;\n   140→}\n   141→\n   142→.ipm-card-meta {\n   143→  font-size: 10px;\n   144→  color: var(--text-muted);\n   145→}\n   146→\n   147→.ipm-card-prompt {\n   148→  margin-top: 6px;\n   149→  padding: 4px 6px;\n   150→  background: rgb(0 0 0 / 20%);\n   151→  border-radius: 4px;\n   152→  font-size: 9px;\n   153→  color: var(--text-muted);\n   154→  overflow: hidden;\n   155→  cursor: pointer;\n   156→  transition: max-height 0.2s ease;\n   157→}\n   158→\n   159→.ipm-card-prompt-collapsed {\n   160→  max-height: 40px;\n   161→}\n   162→\n   163→.ipm-card-prompt-expanded {\n   164→  max-height: 200px;\n   165→}\n   166→\n   167→/* Foo