active {\n  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);\n  color: #0a1929;\n  font-weight: 600;\n}\n\n.cer-nav-button-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n}\n\n.cer-status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.cer-main {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n.cer-content {\n  flex: 1;\n  padding: 24px;\n  overflow-y: auto;\n}\n\n.cer-placeholder {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  color: #60a5fa;\n  text-align: center;\n}\n\n.cer-placeholder-icon {\n  font-size: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n.cer-placeholder-title {\n  font-size: 18px;\n  font-weight: 500;\n  margin-bottom: 8px;\n  color: #ffffff;\n}\n\n.cer-placeholder-desc {\n  font-size: 14px;\n  color: #93c5fd;\n  max-width: 400px;\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
