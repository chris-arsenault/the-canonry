{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SPAqVdbaugDVkHi3ucHU3h","type":"tool_result","content":"     1→import React, { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n     2→import PropTypes from \"prop-types\";\n     3→import Fuse from \"fuse.js\";\n     4→import {\n     5→  getChronicles,\n     6→  getEntities,\n     7→  getSlotRecord,\n     8→  getStaticPages,\n     9→} from \"@the-canonry/world-store\";\n    10→\n    11→function staticPageToSearchEntry(page) {\n    12→  if (!page?.pageId) return null;\n    13→  if ((page.status || \"published\") !== \"published\") return null;\n    14→  return {\n    15→    id: page.pageId,\n    16→    title: page.title || page.pageId,\n    17→    type: \"page\",\n    18→    content: { summary: page.summary || \"\" },\n    19→  };\n    20→}\n    21→\n    22→function chronicleToSearchEntry(chronicle) {\n    23→  if (!chronicle?.chronicleId) return null;\n    24→  if (chronicle.status !== \"complete\" || !chronicle.acceptedAt) return null;\n    25→  return {\n    26→    id: chronicle.chronicleId,\n    27→    title: chronicle.title || chronicle.chronicleId,\n    28→    type: \"chronicle\",\n    29→    content: { summary: chronicle.summary || \"\" },\n    30→  };\n    31→}\n    32→\n    33→function entityToSearchEntry(entity) {\n    34→  if (!entity?.id || !entity.name || entity.kind === \"era\") return null;\n    35→  return {\n    36→    id: entity.id,\n    37→    title: entity.name,\n    38→    type: entity.kind || \"entity\",\n    39→    content: { summary: entity.description || entity.summary || \"\" },\n    40→  };\n    41→}\n    42→\n    43→async function loadPageIndex(projectId, slotIndex) {\n    44→  const slot = await getSlotRecord(projectId, slotIndex);\n    45→  const simulationRunId = slot?.simulationRunId || null;\n    46→  if (!simulationRunId) return [];\n    47→\n    48→  const [entities, chronicles, staticPages] = await Promise.all([\n    49→    getEntities(simulationRunId),\n    50→    getChronicles(simulationRunId),\n    51→    getStaticPages(projectId),\n    52→  ]);\n    53→\n    54→  return [\n    55→    ...staticPages.map(staticPageToSearchEntry),\n    56→    ...chronicles.map(chronicleToSearchEntry),\n    57→    ...entities.map(entityToSearchEntry),\n    58→  ].filter(Boolean);\n    59→}\n    60→\n    61→function useSearchIndex(projectId, slotIndex, dexieSeededAt) {\n    62→  const [pages, setPages] = useState([]);\n    63→  const [isIndexLoading, setIsIndexLoading] = useState(false);\n    64→\n    65→  useEffect(() => {\n    66→    if (!projectId || typeof slotIndex !== \"number\") return;\n    67→\n    68→    let cancelled = false;\n    69→    queueMicrotask(() => {\n    70→      if (!cancelled) setIsIndexLoading(true);\n    71→    });\n    72→    (async () => {\n    73→      try {\n    74→        const result = await loadPageIndex(projectId, slotIndex);\n    75→        if (!cancelled) setPages(result);\n    76→      } catch (err) {\n    77→        console.error(\"[viewer] Failed to build header search index:\", err);\n    78→        if (!cancelled) setPages([]);\n    79→      } finally {\n    80→        if (!cancelled) setIsIndexLoading(false);\n    81→      }\n    82→    })();\n    83→\n    84→    return () => {\n    85→      cancelled = true;\n    86→    };\n    87→  }, [projectId, slotIndex, dexieSeededAt]);\n    88→\n    89→  return { pages, isIndexLoading };\n    90→}\n    91→\n    92→function useKeyboardNavigation(results, selectedIndex, setSelectedIndex, onSelect) {\n    93→  return useCallback(\n    94→    (e) => {\n    95→      if (results.length === 0) return;\n    96→\n    97→      switch (e.key) {\n    98→        case \"ArrowDown\":\n    99→          e.preventDefault();\n   100→          setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n   101→          break;\n   102→        case \"ArrowUp\":\n   103→          e.preventDefault();\n   104→          setSelectedIndex((i) => Math.max(i - 1, 0));\n   105→          break;\n   106→        case \"Enter\":\n   107→          e.preventDefault();\n   108→          if (results[selectedIndex]) onSelect(results[selectedIndex].item.id);\n   109→          break;\n   110→        case \"Escape\":\n   111→          onSelect(null);\n   112→          break;\n   113→      }\n   114→    },\n   115→    [results, selectedIndex, setSelectedIndex, onSelect]\n   116→  );\n   117→}\n   118→\n   119→export default function HeaderSearch({ projectId, slotIndex, dexieSeededAt, onNavigate }) {\n   120→  const [query, setQuery] = useState(\"\");\n   121→  const [isOpen, setIsOpen] = useState(false);\n   122→  const [selectedIndex, setSelectedIndex] = useState(0);\n   123→  const containerRef = useRef(null);\n   124→  const { pages, isIndexLoading } = useSearchIndex(projectId, slotIndex, dexieSeededAt);\n   125→\n   126→  const fuse = useMemo(\n   127→    () =>\n   128→      new Fuse(pages, {\n   129→        keys: [\n   130→          { name: \"title\", weight: 2 },\n   131→          { name: \"content.summary\", weight: 1 },\n   132→        ],\n   133→        threshold: 0.3,\n   134→        includeScore: true,\n   135→        minMatchCharLength: 2,\n   136→      }),\n   137→    [pages]\n   138→  );\n   139→\n   140→  const results = useMemo(() => {\n   141→    if (!query || query.length < 2) return [];\n   142→    return fuse.search(query).slice(0, 8);\n   143→  }, [fuse, query]);\n   144→\n   145→  const handleSelect = useCallback(\n   146→    (id) => {\n   147→      if (id) onNavigate(id);\n   148→      setIsOpen(false);\n   149→      setQuery(\"\");\n   150→    },\n   151→    [onNavigate]\n   152→  );\n   153→\n   154→  const handleKeyDown = useKeyboardNavigation(\n   155→    results,\n   156→    selectedIndex,\n   157→    setSelectedIndex,\n   158→    handleSelect\n   159→  );\n   160→\n   161→  useEffect(() => {\n   162→    const onClickOutside = (e) => {\n   163→      if (containerRef.current && !containerRef.current.contains(e.target)) setIsOpen(false);\n   164→    };\n   165→    document.addEventListener(\"mousedown\", onClickOutside);\n   166→    return () => document.removeEventListener(\"mousedown\", onClickOutside);\n   167→  }, []);\n   168→\n   169→  return (\n   170→    <div className=\"header-search\" ref={containerRef}>\n   171→      <input\n   172→        type=\"text\"\n   173→        className=\"header-search-input\"\n   174→        placeholder=\"Search wiki...\"\n   175→        value={query}\n   176→        onChange={(e) => {\n   177→          setQuery(e.target.value);\n   178→          setSelectedIndex(0);\n   179→          setIsOpen(true);\n   180→        }}\n   181→        onFocus={() => setIsOpen(true)}\n   182→        onKeyDown={(e) => {\n   183→          if (isOpen) handleKeyDown(e);\n   184→        }}\n   185→      />\n   186→      {isOpen && query.length >= 2 && (\n   187→        <div className=\"header-search-dropdown\">\n   188→          {results.length > 0 ? (\n   189→            results.map((result, index) => (\n   190→              <button\n   191→                key={result.item.id}\n   192→                type=\"button\"\n   193→                className={`header-search-result ${index === selectedIndex ? \"selected\" : \"\"}`}\n   194→                onClick={() => handleSelect(result.item.id)}\n   195→                onMouseEnter={() => setSelectedIndex(index)}\n   196→              >\n   197→                <span className=\"header-search-result-title\">{result.item.title}</span>\n   198→                <span className=\"header-search-result-type\">{result.item.type}</span>\n   199→              </button>\n   200→            ))\n   201→          ) : (\n   202→            <div className=\"header-search-no-results\">\n   203→              {isIndexLoading ? \"Indexing pages...\" : \"No results found\"}\n   204→            </div>\n   205→          )}\n   206→        </div>\n   207→      )}\n   208→    </div>\n   209→  );\n   210→}\n   211→\n   212→HeaderSearch.propTypes = {\n   213→  projectId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   214→  slotIndex: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   215→  dexieSeededAt: PropTypes.any,\n   216→  onNavigate: PropTypes.func,\n   217→};\n   218→"}]},"parent_tool_use_id":null,"session_id":"b581011f-7823-4110-9748-054ecf96699a","uuid":"ba9a51bc-e576-4797-ba6e-8606120af370","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/viewer/webui/src/HeaderSearch.jsx","content":"import React, { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\nimport PropTypes from \"prop-types\";\nimport Fuse from \"fuse.js\";\nimport {\n  getChronicles,\n  getEntities,\n  getSlotRecord,\n  getStaticPages,\n} from \"@the-canonry/world-store\";\n\nfunction staticPageToSearchEntry(page) {\n  if (!page?.pageId) return null;\n  if ((page.status || \"published\") !== \"published\") return null;\n  return {\n    id: page.pageId,\n    title: page.title || page.pageId,\n    type: \"page\",\n    content: { summary: page.summary || \"\" },\n  };\n}\n\nfunction chronicleToSearchEntry(chronicle) {\n  if (!chronicle?.chronicleId) return null;\n  if (chronicle.status !== \"complete\" || !chronicle.acceptedAt) return null;\n  return {\n    id: chronicle.chronicleId,\n    title: chronicle.title || chronicle.chronicleId,\n    type: \"chronicle\",\n    content: { summary: chronicle.summary || \"\" },\n  };\n}\n\nfunction entityToSearchEntry(entity) {\n  if (!entity?.id || !entity.name || entity.kind === \"era\") return null;\n  return {\n    id: entity.id,\n    title: entity.name,\n    type: entity.kind || \"entity\",\n    content: { summary: entity.description || entity.summary || \"\" },\n  };\n}\n\nasync function loadPageIndex(projectId, slotIndex) {\n  const slot = await getSlotRecord(projectId, slotIndex);\n  const simulationRunId = slot?.simulationRunId || null;\n  if (!simulationRunId) return [];\n\n  const [entities, chronicles, staticPages] = await Promise.all([\n    getEntities(simulationRunId),\n    getChronicles(simulationRunId),\n    getStaticPages(projectId),\n  ]);\n\n  return [\n    ...staticPages.map(staticPageToSearchEntry),\n    ...chronicles.map(chronicleToSearchEntry),\n    ...entities.map(entityToSearchEntry),\n  ].filter(Boolean);\n}\n\nfunction useSearchIndex(projectId, slotIndex, dexieSeededAt) {\n  const [pages, setPages] = useState([]);\n  const [isIndexLoading, setIsIndexLoading] = useState(false);\n\n  useEffect(() => {\n    if (!projectId || typeof slotIndex !== \"number\") return;\n\n    let cancelled = false;\n    queueMicrotask(() => {\n      if (!cancelled) setIsIndexLoading(true);\n    });\n    (async () => {\n      try {\n        const result = await loadPageIndex(projectId, slotIndex);\n        if (!cancelled) setPages(result);\n      } catch (err) {\n        console.error(\"[viewer] Failed to build header search index:\", err);\n        if (!cancelled) setPages([]);\n      } finally {\n        if (!cancelled) setIsIndexLoading(false);\n      }\n    })();\n\n    return () => {\n      cancelled = true;\n    };\n  }, [projectId, slotIndex, dexieSeededAt]);\n\n  return { pages, isIndexLoading };\n}\n\nfunction useKeyboardNavigation(results, selectedIndex, setSelectedIndex, onSelect) {\n  return useCallback(\n    (e) => {\n      if (results.length === 0) return;\n\n      switch (e.key) {\n        case \"ArrowDown\":\n          e.preventDefault();\n          setSelectedIndex((i) => Math.min(i + 1, results.length - 1));\n          break;\n        case \"ArrowUp\":\n          e.preventDefault();\n          setSelectedIndex((i) => Math.max(i - 1, 0));\n          break;\n        case \"Enter\":\n          e.preventDefault();\n          if (results[selectedIndex]) onSelect(results[selectedIndex].item.id);\n          break;\n        case \"Escape\":\n          onSelect(null);\n          break;\n      }\n    },\n    [results, selectedIndex, setSelectedIndex, onSelect]\n  );\n}\n\nexport default function HeaderSearch({ projectId, slotIndex, dexieSeededAt, onNavigate }) {\n  const [query, setQuery] = useState(\"\");\n  const [isOpen, setIsOpen] = useState(false);\n  const [selectedIndex, setSelectedIndex] = useState(0);\n  const containerRef = useRef(null);\n  const { pages, isIndexLoading } = useSearchIndex(projectId, slotIndex, dexieSeededAt);\n\n  const fuse = useMemo(\n    () =>\n      new Fuse(pages, {\n        keys: [\n          { name: \"title\", weight: 2 },\n          { name: \"content.summary\", weight: 1 },\n        ],\n        threshold: 0.3,\n        includeScore: true,\n        minMatchCharLength: 2,\n      }),\n    [pages]\n  );\n\n  const results = useMemo(() => {\n    if (!query || query.length < 2) return [];\n    return fuse.search(query).slice(0, 8);\n  }, [fuse, query]);\n\n  const handleSelect = useCallback(\n    (id) => {\n      if (id) onNavigate(id);\n      setIsOpen(false);\n      setQuery(\"\");\n    },\n    [onNavigate]\n  );\n\n  const handleKeyDown = useKeyboardNavigation(\n    results,\n    selectedIndex,\n    setSelectedIndex,\n    handleSelect\n  );\n\n  useEffect(() => {\n    const onClickOutside = (e) => {\n      if (containerRef.current && !containerRef.current.contains(e.target)) setIsOpen(false);\n    };\n    document.addEventListener(\"mousedown\", onClickOutside);\n    return () => document.removeEventListener(\"mousedown\", onClickOutside);\n  }, []);\n\n  return (\n    <div className=\"header-search\" ref={containerRef}>\n      <input\n        type=\"text\"\n        className=\"header-search-input\"\n        placeholder=\"Search wiki...\"\n        value={query}\n        onChange={(e) => {\n          setQuery(e.target.value);\n          setSelectedIndex(0);\n          setIsOpen(true);\n        }}\n        onFocus={() => setIsOpen(true)}\n        onKeyDown={(e) => {\n          if (isOpen) handleKeyDown(e);\n        }}\n      />\n      {isOpen && query.length >= 2 && (\n        <div className=\"header-search-dropdown\">\n          {results.length > 0 ? (\n            results.map((result, index) => (\n              <button\n                key={result.item.id}\n                type=\"button\"\n                className={`header-search-result ${index === selectedIndex ? \"selected\" : \"\"}`}\n                onClick={() => handleSelect(result.item.id)}\n                onMouseEnter={() => setSelectedIndex(index)}\n              >\n                <span className=\"header-search-result-title\">{result.item.title}</span>\n                <span className=\"header-search-result-type\">{result.item.type}</span>\n              </button>\n            ))\n          ) : (\n            <div className=\"header-search-no-results\">\n              {isIndexLoading ? \"Indexing pages...\" : \"No results found\"}\n            </div>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n\nHeaderSearch.propTypes = {\n  projectId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  slotIndex: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  dexieSeededAt: PropTypes.any,\n  onNavigate: PropTypes.func,\n};\n","numLines":218,"startLine":1,"totalLines":218}}}
