: 11px;\n  cursor: pointer;\n}\n\n/* === EnrichmentQueue main === */\n\n.eq-header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.eq-api-warning {\n  padding: 12px;\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: 4px;\n  margin-bottom: 16px;\n  font-size: 12px;\n  color: var(--warning);\n}\n\n.eq-filters {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 16px;\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n}\n\n.eq-filter-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: block;\n  margin-bottom: 4px;\n}\n\n.eq-filter-select {\n  width: 120px;\n}\n\n.eq-filter-summary {\n  margin-left: auto;\n  align-self: flex-end;\n}\n\n.eq-filter-summary-text {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eq-empty {\n  text-align: center;\n  padding: 40px;\n  color: var(--text-muted);\n}\n\n.eq-selection-bar {\n  position: sticky;\n  bottom: 16px;\n}\n\n.eq-selection-count {\n  font-size: 13px;\n}\n\n.eq-selection-actions {\n  display: flex;\n  gap: 8px;\n}\n","structuredPatch":[{"oldStart":131,"oldLines":9,"newStart":131,"newLines":7,"lines":[" }"," "," .eq-empty {","-  text-align: center;","   padding: 40px;","-  color: var(--text-muted);"," }"," "," .eq-selection-bar {"]}],"userModified":false,"replaceAll":false}}
