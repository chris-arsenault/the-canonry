{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PnaZRRBCxKSi6Zq2KoLFGU","type":"tool_result","content":"     1→/**\n     2→ * useDynamicsFlow - Hook for world dynamics generation workflow\n     3→ *\n     4→ * Extracted from IlluminatorRemote. Contains:\n     5→ * - handleDynamicsAccepted: merge proposed dynamics into worldContext\n     6→ * - handleGenerateDynamics: launch dynamics generation with full context\n     7→ * - Delegates to useDynamicsGeneration for the LLM multi-turn flow\n     8→ */\n     9→\n    10→import { useCallback } from \"react\";\n    11→import { useDynamicsGeneration } from \"./useDynamicsGeneration\";\n    12→import * as entityRepo from \"../lib/db/entityRepository\";\n    13→import { getPublishedStaticPagesForProject } from \"../lib/db/staticPageRepository\";\n    14→\n    15→// --- Module-level helpers ---\n    16→\n    17→const buildSchemaContext = (schema) => {\n    18→  if (!schema) return \"\";\n    19→  const sections = [];\n    20→  if (schema.entityKinds?.length) {\n    21→    sections.push(\"Entity Kinds: \" + schema.entityKinds.map((k) => k.kind).join(\", \"));\n    22→  }\n    23→  if (schema.relationshipKinds?.length) {\n    24→    sections.push(\"Relationship Kinds: \" + schema.relationshipKinds.map((k) => k.kind).join(\", \"));\n    25→  }\n    26→  if (schema.cultures?.length) {\n    27→    sections.push(\"Cultures: \" + schema.cultures.map((c) => c.name || c.id).join(\", \"));\n    28→  }\n    29→  return sections.join(\"\\n\");\n    30→};\n    31→\n    32→/**\n    33→ * Map proposed dynamics into the worldDynamics format.\n    34→ */\n    35→function mapProposedDynamics(proposedDynamics) {\n    36→  return proposedDynamics.map((d, i) => ({\n    37→    id: `dyn_gen_${Date.now()}_${i}`,\n    38→    text: d.text,\n    39→    cultures: d.cultures?.length ? d.cultures : undefined,\n    40→    kinds: d.kinds?.length ? d.kinds : undefined,\n    41→    eraOverrides:\n    42→      d.eraOverrides && Object.keys(d.eraOverrides).length > 0 ? d.eraOverrides : undefined,\n    43→  }));\n    44→}\n    45→\n    46→/**\n    47→ * Load static pages context for dynamics prompt.\n    48→ */\n    49→async function loadStaticPagesContext(projectId) {\n    50→  try {\n    51→    const pages = await getPublishedStaticPagesForProject(projectId);\n    52→    if (pages.length > 0) {\n    53→      return pages.map((p) => `## ${p.title}\\n\\n${p.content}`).join(\"\\n\\n---\\n\\n\");\n    54→    }\n    55→  } catch (err) {\n    56→    console.warn(\"[Dynamics] Failed to load static pages:\", err);\n    57→  }\n    58→  return \"\";\n    59→}\n    60→\n    61→/**\n    62→ * Build entity context array for dynamics generation.\n    63→ */\n    64→function buildEntityContexts(allEntities) {\n    65→  return allEntities.map((e) => ({\n    66→    id: e.id,\n    67→    name: e.name,\n    68→    kind: e.kind,\n    69→    subtype: e.subtype || \"\",\n    70→    culture: e.culture || \"\",\n    71→    status: e.status || \"\",\n    72→    summary: e.summary || \"\",\n    73→    description: e.description || \"\",\n    74→    tags: e.tags || {},\n    75→    eraId: e.eraId,\n    76→  }));\n    77→}\n    78→\n    79→/**\n    80→ * Build relationships payload with resolved names.\n    81→ */\n    82→function buildRelationshipsPayload(relationships, entityNavMap) {\n    83→  return relationships.map((r) => ({\n    84→    src: r.src,\n    85→    dst: r.dst,\n    86→    kind: r.kind,\n    87→    weight: r.weight ?? r.strength,\n    88→    srcName: entityNavMap.get(r.src)?.name || r.src,\n    89→    dstName: entityNavMap.get(r.dst)?.name || r.dst,\n    90→  }));\n    91→}\n    92→\n    93→// --- Main hook ---\n    94→\n    95→export function useDynamicsFlow({\n    96→  projectId,\n    97→  simulationRunId,\n    98→  worldContext,\n    99→  worldSchema,\n   100→  entityNavMap,\n   101→  relationships,\n   102→  updateWorldContext,\n   103→}) {\n   104→  // Handle accepted dynamics from LLM\n   105→  const handleDynamicsAccepted = useCallback(\n   106→    (proposedDynamics) => {\n   107→      if (!proposedDynamics?.length) return;\n   108→      const newDynamics = mapProposedDynamics(proposedDynamics);\n   109→      const existing = worldContext?.worldDynamics || [];\n   110→      updateWorldContext({ worldDynamics: [...existing, ...newDynamics] });\n   111→    },\n   112→    [worldContext, updateWorldContext]\n   113→  );\n   114→\n   115→  const {\n   116→    run: dynamicsRun,\n   117→    isActive: isDynamicsActive,\n   118→    startGeneration: startDynamicsGeneration,\n   119→    submitFeedback: submitDynamicsFeedback,\n   120→    acceptDynamics,\n   121→    cancelGeneration: cancelDynamicsGeneration,\n   122→  } = useDynamicsGeneration(handleDynamicsAccepted);\n   123→\n   124→  // Launch dynamics generation with full world context\n   125→  const handleGenerateDynamics = useCallback(async () => {\n   126→    if (!projectId || !simulationRunId) return;\n   127→\n   128→    const staticPagesContext = await loadStaticPagesContext(projectId);\n   129→    const schemaContext = buildSchemaContext(worldSchema);\n   130→\n   131→    // Build entity context -- load full entities from Dexie (needs description, tags)\n   132→    const allEntities = await entityRepo.getEntitiesForRun(simulationRunId);\n   133→    const entityContexts = buildEntityContexts(allEntities);\n   134→    const relationshipsPayload = buildRelationshipsPayload(relationships, entityNavMap);\n   135→\n   136→    startDynamicsGeneration({\n   137→      projectId,\n   138→      simulationRunId,\n   139→      staticPagesContext,\n   140→      schemaContext,\n   141→      entities: entityContexts,\n   142→      relationships: relationshipsPayload,\n   143→    });\n   144→  }, [\n   145→    projectId,\n   146→    simulationRunId,\n   147→    worldSchema,\n   148→    entityNavMap,\n   149→    relationships,\n   150→    startDynamicsGeneration,\n   151→  ]);\n   152→\n   153→  return {\n   154→    dynamicsRun,\n   155→    isDynamicsActive,\n   156→    handleGenerateDynamics,\n   157→    submitDynamicsFeedback,\n   158→    acceptDynamics,\n   159→    cancelDynamicsGeneration,\n   160→  };\n   161→}\n   162→"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"231024d1-f67a-4b6e-83fa-23f5a2dd1890"}
