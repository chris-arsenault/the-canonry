→}\n   244→\n   245→.benm-counter-output-label {\n   246→  color: #f59e0b;\n   247→  opacity: 0.8;\n   248→}\n   249→\n   250→.benm-step-done {\n   251→  flex: 1;\n   252→  font-size: 10px;\n   253→  color: var(--text-muted);\n   254→}\n   255→\n   256→/* Cost + words */\n   257→.benm-stats {\n   258→  font-size: 11px;\n   259→  color: var(--text-muted);\n   260→  text-align: right;\n   261→  display: flex;\n   262→  justify-content: flex-end;\n   263→  gap: 12px;\n   264→}\n   265→"}]},"parent_tool_use_id":null,"session_id":"9f489ea2-964b-4b12-9123-73dad996ade9","uuid":"91c442d3-975c-4e4b-bc14-dbca66676356","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BulkEraNarrativeModal.css","content":"/* BulkEraNarrativeModal — content-specific styles (prefix: benm-)\n * Overlay, header, footer, terminal, and cost styles are in BulkOperationShell.css */\n\n/* Era list section */\n.benm-era-section {\n  margin-bottom: 12px;\n}\n\n.benm-era-list {\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  overflow: hidden;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.benm-era-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 12px;\n  font-size: 12px;\n}\n\n.benm-era-row-bordered {\n  border-bottom: 1px solid var(--border-color);\n}\n\n.benm-era-row-info {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n}\n\n.benm-era-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.benm-era-row-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.benm-era-prepped {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.benm-era-existing {\n  font-size: 10px;\n  color: #3b82f6;\n}\n\n/* Per-era tone selector */\n.benm-tone-selector {\n  display: flex;\n  gap: 2px;\n}\n\n.benm-tone-btn {\n  width: 18px;\n  height: 18px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n  border-radius: 3px;\n  cursor: pointer;\n  font-size: 10px;\n  line-height: 1;\n}\n\n.benm-tone-btn-default {\n  border: 1px solid transparent;\n  background: transparent;\n  color: var(--text-muted);\n}\n\n.benm-tone-btn-selected {\n  border: 1px solid #8b7355;\n  background: rgb(139 115 85 / 15%);\n  color: #8b7355;\n}\n\n/* Progress section */\n.benm-progress-section {\n  margin-bottom: 16px;\n}\n\n.benm-progress-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin-bottom: 6px;\n}\n\n.benm-progress-era-label {\n  font-size: 13px;\n  font-weight: 500;\n}\n\n.benm-progress-percent {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Progress bar */\n.benm-progress-track {\n  height: 8px;\n  border-radius: 4px;\n  background: var(--bg-secondary);\n  overflow: hidden;\n  margin-bottom: 6px;\n}\n\n.benm-progress-fill {\n  height: 100%;\n  border-radius: 4px;\n  transition: width 0.3s ease;\n  width: var(--benm-progress-width);\n}\n\n.benm-progress-fill-complete {\n  background: #10b981;\n}\n\n.benm-progress-fill-failed {\n  background: #ef4444;\n}\n\n.benm-progress-fill-cancelled {\n  background: #f59e0b;\n}\n\n.benm-progress-counts {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Current era detail */\n.benm-current-era {\n  padding: 12px;\n  border-radius: 8px;\n  background: var(--bg-secondary);\n  margin-bottom: 12px;\n}\n\n.benm-current-era-name {\n  font-size: 12px;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.benm-current-era-tone {\n  color: #8b7355;\n  font-size: 13px;\n}\n\n/* Step rows */\n.benm-steps {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.benm-step-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 11px;\n}\n\n.benm-step-icon {\n  width: 12px;\n  text-align: center;\n  font-weight: 600;\n  font-size: 10px;\n  color: var(--benm-step-color);\n}\n\n.benm-step-label {\n  width: 52px;\n}\n\n.benm-step-label-active {\n  color: var(--text-secondary);\n  font-weight: 600;\n}\n\n.benm-step-label-pending {\n  color: var(--text-muted);\n  font-weight: 400;\n}\n\n.benm-step-active-content {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n/* Mini progress bar in step */\n.benm-step-bar-track {\n  flex: 1;\n  height: 4px;\n  border-radius: 2px;\n  background: var(--bg-primary);\n  overflow: hidden;\n}\n\n.benm-step-bar-fill {\n  height: 100%;\n  border-radius: 2px;\n  background: #f59e0b;\n  transition: width 0.2s ease;\n  width: var(--benm-bar-width);\n}\n\n/* Live counters */\n.benm-step-counters {\n  color: var(--text-muted);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n\n.benm-counter-thinking-label {\n  color: var(--text-muted);\n  opacity: 0.6;\n}\n\n.benm-counter-separator {\n  margin: 0 6px;\n  opacity: 0.3;\n}\n\n.benm-counter-output-label {\n  color: #f59e0b;\n  opacity: 0.8;\n}\n\n.benm-step-done {\n  flex: 1;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n/* Cost + words */\n.benm-stats {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-align: right;\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n}\n","numLines":265,"startLine":1,"totalLines":265}}}
