{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YYsnjK9eARTVFiR18AoWdD","type":"tool_result","content":"     1→/**\n     2→ * Shared components for all editor modules\n     3→ *\n     4→ * These components use CSS classes from styles/index.css.\n     5→ */\n     6→\n     7→// Form components\n     8→export { ReferenceDropdown } from './ReferenceDropdown';\n     9→export { ChipSelect } from './ChipSelect';\n    10→export { SearchableDropdown } from './SearchableDropdown';\n    11→export { LevelSelector, STRENGTH_LEVELS, PROMINENCE_LEVELS } from './LevelSelector';\n    12→export { NumberInput } from './NumberInput';\n    13→export { LocalTextArea } from './LocalTextArea';\n    14→\n    15→// UI components\n    16→export { EnableToggle } from './EnableToggle';\n    17→export { IconButton } from './IconButton';\n    18→export { InfoBox } from './InfoBox';\n    19→export { SectionHeader } from './SectionHeader';\n    20→export { EmptyState } from './EmptyState';\n    21→export { CategorySection } from './CategorySection';\n    22→export { AddCard } from './AddCard';\n    23→export { AddItemButton } from './AddItemButton';\n    24→export { ModalShell } from './ModalShell';\n    25→export { ErrorBoundary } from './ErrorBoundary';\n    26→export { ErrorMessage } from './ErrorMessage';\n    27→export { ItemRow } from './ItemRow';\n    28→export { PressureChangesEditor } from './PressureChangesEditor';\n    29→\n    30→// Validation display\n    31→export { ErrorBadge, OrphanBadge, TabValidationBadge } from './ValidationBadge';\n    32→export { EraBadges } from './EraBadges';\n    33→\n    34→// Chronicle seed viewer\n    35→export { default as ChronicleSeedViewer, SeedModal, ExpandableSeedSection } from './ChronicleSeedViewer';\n    36→\n    37→// Hooks\n    38→export { useLocalInputState } from './hooks/useLocalInputState';\n    39→export { useEditorState } from './hooks/useEditorState';\n    40→export { useKeyboardNavigation } from './hooks/useKe