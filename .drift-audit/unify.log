search {\n  width: 200px;\n}\n\n.sstep-defaults-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-left: auto;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.sstep-scroll {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.sstep-group-heading {\n  margin: 0 0 12px 0;\n  color: var(--text-muted);\n  font-size: 11px;\n  text-transform: uppercase;\n}\n\n.sstep-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n  gap: 12px;\n}\n\n.sstep-grid-mb {\n  margin-bottom: 20px;\n}\n\n.sstep-empty {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.sstep-selected-detail {\n  margin-top: 20px;\n  padding: 16px;\n  background: var(--bg-tertiary);\n  border-radius: 8px;\n  border: 1px solid var(--accent-color);\n}\n\n.sstep-selected-name {\n  margin: 0 0 8px 0;\n}\n\n.sstep-format-badge {\n  margin-left: 8px;\n  padding: 2px 6px;\n  color: white;\n  border-radius: 4px;\n  font-size: 10px;\n  text-transform: uppercase;\n}\n\n.sstep-format-badge-story {\n  background: var(--accent-color);\n}\n\n.sstep-format-badge-document {\n  background: var(--warning);\n}\n\n.sstep-selected-desc {\n  margin: 0 0 12px 0;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.sstep-usage-info {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 12px;\n}\n\n.sstep-roles-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n}\n\n.sstep-roles-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 6px;\n}\n\n.sstep-role-chip {\n  padding: 4px 8px;\n  background: var(--bg-secondary);\n  border-radius: 4px;\n  font-size: 11px;\n}\n\n.sstep-role-count {\n  color: var(--text-muted);\n  margin-left: 4px;\n}\n\n/* StyleCard styles */\n\n.sstep-card {\n  padding: 12px;\n  background: var(--bg-secondary);\n  border-radius: 8px;\n  border: 2px solid transparent;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.sstep-card-selected {\n  border-color: var(--accent-color);\n}\n\n.sstep-card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  margin-bottom: 6px;\n  gap: 8px;\n}\n\n.sstep-card-name {\n  font-weight: 500;\n  font-size: 13px;\n  flex: 1;\n}\n\n.sstep-card-badges {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.sstep-card-usage-badge {\n  font-size: 9px;\n  padding: 2px 6px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  text-transform: uppercase;\n  color: var(--sstep-usage-color, var(--text-muted));\n}\n\n.sstep-card-format-badge {\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-size: 9px;\n  text-transform: uppercase;\n}\n\n.sstep-card-format-story {\n  background: rgba(99, 102, 241, 0.2);\n  color: var(--accent-color);\n}\n\n.sstep-card-format-document {\n  background: rgba(245, 158, 11, 0.2);\n  color: var(--warning);\n}\n\n.sstep-card-desc {\n  margin: 0 0 8px 0;\n  font-size: 11px;\n  color: var(--text-muted);\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.sstep-card-footer {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.sstep-card-role-count {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.sstep-card-tag {\n  padding: 1px 4px;\n  background: var(--bg-tertiary);\n  border-radius: 3px;\n  font-size: 9px;\n  color: var(--text-muted);\n}\n","numLines":221,"startLine":1,"totalLines":221}}}
