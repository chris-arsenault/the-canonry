n\n.dmw-entity-group-header {\n  padding: 8px 12px;\n  background: var(--bg-secondary);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  user-select: none;\n}\n\n.dmw-expand-icon {\n  font-size: 10px;\n  color: var(--text-muted);\n  width: 10px;\n  flex-shrink: 0;\n}\n\n.dmw-entity-name {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--text-primary);\n}\n\n.dmw-candidate-count {\n  font-size: 10px;\n  color: var(--text-muted);\n  margin-left: auto;\n}\n\n.dmw-accept-count {\n  font-size: 10px;\n  color: #22c55e;\n}\n\n.dmw-reject-count {\n  font-size: 10px;\n  color: #ef4444;\n}\n\n.dmw-bulk-accept-btn {\n  background: none;\n  border: none;\n  color: #22c55e;\n  font-size: 10px;\n  cursor: pointer;\n  padding: 0 4px;\n}\n\n.dmw-bulk-reject-btn {\n  background: none;\n  border: none;\n  color: #ef4444;\n  font-size: 10px;\n  cursor: pointer;\n  padding: 0 4px;\n}\n\n.dmw-entity-group-body {\n  padding: 6px 8px;\n}\n\n/* Modal */\n.dmw-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(0, 0, 0, 0.6);\n}\n\n.dmw-card {\n  background: var(--bg-primary);\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  width: 820px;\n  max-width: 95vw;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);\n}\n\n.dmw-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-shrink: 0;\n}\n\n.dmw-title {\n  margin: 0;\n  font-size: 16px;\n}\n\n.dmw-subtitle {\n  margin: 4px 0 0;\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.dmw-cancel-btn {\n  padding: 4px 12px;\n  font-size: 12px;\n}\n\n.dmw-body {\n  flex: 1;\n  overflow: auto;\n  padding: 16px 20px;\n  min-height: 0;\n}\n\n.dmw-scan-layout {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.dmw-target-phrase-box {\n  padding: 12px 16px;\n  background: var(--bg-tertiary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n}\n\n.dmw-target-phrase-label {\n  font-size: 12px;\n  font-weight: 500;\n  margin-bottom: 6px;\n}\n\n.dmw-target-phrase-value {\n  font-size: 13px;\n  font-family: monospace;\n  color: var(--text-primary);\n}\n\n.dmw-scan-description {\n  margin: 0;\n  font-size: 11px;\n  color: var(--text-muted);\n  line-height: 1.6;\n}\n\n.dmw-centered-phase {\n  text-align: center;\n  padding: 40px 0;\n}\n\n.dmw-phase-title {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-bottom: 8px;\n}\n\n.dmw-phase-subtitle {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.dmw-confirm-summary {\n  margin-bottom: 12px;\n  padding: 8px 14px;\n  background: var(--bg-secondary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n  font-size: 12px;\n}\n\n.dmw-error-text {\n  margin-top: 12px;\n  font-size: 12px;\n  color: #ef4444;\n}\n\n.dmw-empty-state {\n  text-align: center;\n  padding: 30px 0;\n  color: var(--text-muted);\n  font-size: 13px;\n}\n\n/* Review phase */\n.dmw-review-bar {\n  margin-bottom: 12px;\n  padding: 8px 14px;\n  background: var(--bg-secondary);\n  border-radius: 6px;\n  border: 1px solid var(--border-color);\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  flex-wrap: wrap;\n  font-size: 12px;\n}\n\n.dmw-review-separator {\n  color: var(--text-muted);\n}\n\n.dmw-review-accept-count {\n  color: #22c55e;\n}\n\n.dmw-review-skip-count {\n  color: #ef4444;\n}\n\n.dmw-review-generated-count {\n  color: var(--text-muted);\n}\n\n.dmw-review-spacer {\n  flex: 1;\n}\n\n.dmw-accept-all-btn {\n  background: none;\n  border: none;\n  color: #22c55e;\n  font-size: 10px;\n  cursor: pointer;\n  text-decoration: underline;\n}\n\n.dmw-reject-all-btn {\n  background: none;\n  border: none;\n  color: #ef4444;\n  font-size: 10px;\n  cursor: pointer;\n  text-decoration: underline;\n}\n\n.dmw-review-error {\n  margin-bottom: 12px;\n  padding: 8px 14px;\n  background: rgba(239, 68, 68, 0.1);\n  border-radius: 6px;\n  border: 1px solid rgba(239, 68, 68, 0.3);\n  font-size: 11px;\n  color: #ef4444;\n}\n\n.dmw-done-subtitle {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 8px;\n}\n\n/* Footer */\n.dmw-footer {\n  padding: 12px 20px;\n  border-top: 1px solid var(--border-color);\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.dmw-footer-btn {\n  padding: 6px 20px;\n  font-size: 12px;\n}\n\n.dmw-footer-btn-secondary {\n  padding: 6px 16px;\n  font-size: 12px;\n}\n","numLines":345,"startLine":1,"totalLines":345}}}
