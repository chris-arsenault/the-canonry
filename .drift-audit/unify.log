{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015UQBGdiKossj9VLJw2aARK","type":"tool_result","content":"     1→/**\n     2→ * FormGroup - Wrapper for form label + input/control\n     3→ *\n     4→ * Provides consistent styling for form fields.\n     5→ */\n     6→\n     7→import React from 'react';\n     8→import PropTypes from 'prop-types';\n     9→\n    10→/**\n    11→ * @param {Object} props\n    12→ * @param {string} [props.label] - Label text\n    13→ * @param {string} [props.htmlFor] - For attribute linking label to input\n    14→ * @param {string} [props.hint] - Help text below the input\n    15→ * @param {React.ReactNode} props.children - Form control (input, select, etc.)\n    16→ * @param {boolean} [props.wide] - If true, spans full width\n    17→ * @param {string} [props.className] - Additional class\n    18→ */\n    19→export function FormGroup({\n    20→  label,\n    21→  htmlFor,\n    22→  hint,\n    23→  children,\n    24→  wide,\n    25→  className = '',\n    26→}) {\n    27→  return (\n    28→    <div className={`form-group ${wide ? 'form-group-wide' : ''} ${className}`.trim()}>\n    29→      {label && (\n    30→        <label className=\"label\" htmlFor={htmlFor}>\n    31→          {label}\n    32→        </label>\n    33→      )}\n    34→      {children}\n    35→      {hint && <div className=\"hint\">{hint}</div>}\n    36→    </div>\n    37→  );\n    38→}\n    39→\n    40→/**\n    41→ * FormRow - Horizontal layout for multiple form groups\n    42→ */\n    43→export function FormRow({ children, className = '' }) {\n    44→  return (\n    45→    <div className={`form-row ${className}`.trim()}>\n    46→      {children}\n    47→    </div>\n    48→  );\n    49→}\n    50→\n    51→export default FormGroup;\n    52→\n    53→FormGroup.propTypes = {\n    54→  label: PropTypes.string,\n    55→  htmlFor: PropTypes.string,\n    56→  hint: PropTypes.string,\n    57→  children: PropTypes.node,\n    58→  wide: PropTypes.bool,\n    59→  