{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FGxvqx1MR6jKkVc9jzsMSX","type":"tool_result","content":"     1→/**\n     2→ * ErrorBoundary - Catches render errors in child component trees\n     3→ *\n     4→ * Displays a recovery UI with the error message and a retry button.\n     5→ * Intended for wrapping MFE remote entry points so a single module\n     6→ * failure doesn't crash the entire host application.\n     7→ */\n     8→\n     9→import React from \"react\";\n    10→\n    11→interface ErrorBoundaryProps {\n    12→  children: React.ReactNode;\n    13→  title?: string;\n    14→  className?: string;\n    15→}\n    16→\n    17→interface ErrorBoundaryState {\n    18→  error: Error | null;\n    19→}\n    20→\n    21→export class ErrorBoundary extends React.Component<ErrorBoundaryProps, ErrorBoundaryState> {\n    22→  constructor(props: ErrorBoundaryProps) {\n    23→    super(props);\n    24→    this.state = { error: null };\n    25→  }\n    26→\n    27→  static getDerivedStateFromError(error: Error) {\n    28→    return { error };\n    29→  }\n    30→\n    31→  handleRetry = () => {\n    32→    this.setState({ error: null });\n    33→  };\n    34→\n    35→  render() {\n    36→    if (this.state.error) {\n    37→      return (\n    38→        <div className={`empty-state error-boundary ${this.props.className || \"\"}`.trim()}>\n    39→          <div className=\"error-boundary-icon\">!</div>\n    40→          <div className=\"empty-state-title\">\n    41→            {this.props.title || \"Something went wrong\"}\n    42→          </div>\n    43→          <div className=\"empty-state-desc error-boundary-message\">\n    44→            {this.state.error.message || \"An unexpected error occurred.\"}\n    45→          </div>\n    46→          <button\n    47→            className=\"error-boundary-retry\"\n    48→            onClick={this.handleRetry}\n    49→          >\n    50→            Retry\n    51→          </button>\n    52→        </div>\n    53→      );\n    54→    }\n    55→    return this.props.children;\n    56→  }\n    57→}\n    58→\n    59→export default ErrorBoundary;\n    60→\n    61→"}]},"parent_tool_use_id":"toolu_01MSjwERvzq8tWa6PqUQiEqU","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"8f9d0a60-2bf7-49be-b917-e9f6accbca01"}
