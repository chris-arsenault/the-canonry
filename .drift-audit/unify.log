{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KevRvpTQm1cb5XeQ7nmLxW","type":"tool_result","content":"     1→/**\n     2→ * VariablesTab - Define intermediate entity selections for actions\n     3→ */\n     4→\n     5→import React, { useState } from \"react\";\n     6→import PropTypes from \"prop-types\";\n     7→import VariableSelectionEditor from \"../../shared/VariableSelectionEditor\";\n     8→import \"./VariablesTab.css\";\n     9→\n    10→/**\n    11→ * Safely display a value that should be a string.\n    12→ * If it's an object, log a warning and return a fallback.\n    13→ */\n    14→function safeDisplay(value, fallback = \"?\", label = \"value\") {\n    15→  if (value === null || value === undefined) return fallback;\n    16→  if (typeof value === \"object\") {\n    17→    console.warn(`[VariablesTab] Expected string for ${label} but got object:`, value);\n    18→    return `[object]`;\n    19→  }\n    20→  return String(value);\n    21→}\n    22→\n    23→// ============================================================================\n    24→// VariableCard - Individual variable editor card\n    25→// ============================================================================\n    26→\n    27→function VariableCard({ name, config, onChange, onRemove, schema, availableRefs = [] }) {\n    28→  const [expanded, setExpanded] = useState(false);\n    29→  const [hovering, setHovering] = useState(false);\n    30→\n    31→  // Handle the nested select structure: { select: { from, kind, pickStrategy, ... }, required }\n    32→  const selectConfig = config.select || {};\n    33→  const isRequired = config.required || false;\n    34→\n    35→  const updateRequired = (value) => {\n    36→    onChange({ ...config, required: value });\n    37→  };\n    38→\n    39→  // Display info\n    40→  const displayMode =\n    41→    selectConfig.from && typeof selectConfig.from === \"object\"\n    42→      ? \"Related entities\"\n    43→      : selectConfig.kind || \"Not configured\";\n    44→  const displayStrategy = safeDisplay(selectConfig.pickStrategy, \"Not set\", \"pickStrategy\");\n    45→  const filterCount = (selectConfig.filters || []).length;\n    46→\n    47→  return (\n    48→    <div className=\"item-card\">\n    49→      <div\n    50→        className={`item-card-header ${hovering ? \"item-card-header-hover\" : \"\"}`}\n    51→        onClick={() => setExpanded(!expanded)}\n    52→        onMouseEnter={() => setHovering(true)}\n    53→        onMouseLeave={() => setHovering(false)}\n    54→        role=\"button\"\n    55→        tabIndex={0}\n    56→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n    57→      >\n    58→        <div className=\"item-card-icon item-card-icon-variable\">📦</div>\n    59→        <div className=\"item-card-info\">\n    60→          <div className=\"item-card-title\">\n    61→            <span className=\"variable-ref\">{name}</span>\n    62→            {isRequired && (\n    63→              <span className=\"badge badge-warning avt-required-badge\">\n    64→                Required\n    65→              </span>\n    66→            )}\n    67→          </div>\n    68→          <div className=\"item-card-subtitle\">\n    69→            {displayMode} • {displayStrategy}\n    70→            {filterCount > 0 && (\n    71→              <span className=\"ml-xs\">\n    72→                • {filterCount} filter{filterCount > 1 ? \"s\" : \"\"}\n    73→              </span>\n    74→            )}\n    75→          </div>\n    76→        </div>\n    77→        <div className=\"item-card-actions\">\n    78→          <button className=\"btn-icon\">{expanded ? \"▲\" : \"▼\"}</button>\n    79→          <button\n    80→            className=\"btn-icon btn-icon-danger\"\n    81→            onClick={(e) => {\n    82→              e.stopPropagation();\n    83→              onRemove();\n    84→            }}\n    85→          >\n    86→            ×\n    87→          </button>\n    88→        </div>\n    89→      </div>\n    90→\n    91→      {expanded && (\n    92→        <div className=\"item-card-body\">\n    93→          {/* Required checkbox */}\n    94→          <div className=\"mb-xl\">\n    95→            <label className=\"avt-checkbox-label\">\n    96→              <input\n    97→                type=\"checkbox\"\n    98→                checked={isRequired}\n    99→                onChange={(e) => updateRequired(e.target.checked)}\n   100→              />\n   101→              <span className=\"label mb-0\">\n   102→                Required\n   103→              </span>\n   104→              <span className=\"text-muted avt-required-hint\">\n   105→                (Action won&apos;t execute unless this variable resolves)\n   106→              </span>\n   107→            </label>\n   108→          </div>\n   109→\n   110→\n   111→          <VariableSelectionEditor\n   112→            value={selectConfig}\n   113→            onChange={(updated) => onChange({ ...config, select: updated })}\n   114→            schema={schema}\n   115→            availableRefs={availableRefs}\n   116→          />\n   117→        </div>\n   118→      )}\n   119→    </div>\n   120→  );\n   121→}\n   122→\n   123→VariableCard.propTypes = {\n   124→  name: PropTypes.string.isRequired,\n   125→  config: PropTypes.object.isRequired,\n   126→  onChange: PropTypes.func.isRequired,\n   127→  onRemove: PropTypes.func.isRequired,\n   128→  schema: PropTypes.object,\n   129→  availableRefs: PropTypes.array,\n   130→};\n   131→\n   132→// ============================================================================\n   133→// VariablesTab - Main tab component\n   134→// ============================================================================\n   135→\n   136→/**\n   137→ * @param {Object} props\n   138→ * @param {Object} props.action - The action being edited\n   139→ * @param {Function} props.onChange - Callback when action changes\n   140→ * @param {Object} props.schema - Domain schema\n   141→ */\n   142→export function VariablesTab({ action, onChange, schema }) {\n   143→  const variables = action.variables || {};\n   144→  const [newVarName, setNewVarName] = useState(\"\");\n   145→  const [showAddForm, setShowAddForm] = useState(false);\n   146→\n   147→  // Build available refs for relationship queries (actor, instigator, target, target2 + other vars)\n   148→  const buildAvailableRefs = (excludeVar) => {\n   149→    const refs = [\"$actor\", \"$instigator\", \"$target\", \"$target2\"];\n   150→    Object.keys(variables).forEach((v) => {\n   151→      if (v !== excludeVar) refs.push(v);\n   152→    });\n   153→    return refs;\n   154→  };\n   155→\n   156→  const handleAddVariable = () => {\n   157→    if (!newVarName.trim()) return;\n   158→    // Ensure the name starts with $\n   159→    const name = newVarName.startsWith(\"$\") ? newVarName : `$${newVarName}`;\n   160→    // Create with empty required fields - validation will flag them\n   161→    onChange({\n   162→      ...action,\n   163→      variables: {\n   164→        ...variables,\n   165→        [name]: { select: { from: \"graph\", kind: \"\", pickStrategy: \"\" } },\n   166→      },\n   167→    });\n   168→    setNewVarName(\"\");\n   169→    setShowAddForm(false);\n   170→  };\n   171→\n   172→  const varEntries = Object.entries(variables);\n   173→\n   174→  return (\n   175→    <div>\n   176→      <div className=\"section\">\n   177→        <div className=\"section-title\">Variables</div>\n   178→\n   179→        <div className=\"info-box\">\n   180→          <div className=\"info-box-title\">What are variables?</div>\n   181→          <div className=\"info-box-text\">\n   182→            Variables let you select additional entities from the graph to use in mutations. For\n   183→            example, you might select a <code className=\"inline-code\">$victimFaction</code> to\n   184→            create an enemy relationship with, or an <code className=\"inline-code\">$artifact</code>{\" \"}\n   185→            to modify. Variables are resolved after <code className=\"inline-code\">$actor</code> and{\" \"}\n   186→            <code className=\"inline-code\">$target</code> are chosen.\n   187→          </div>\n   188→        </div>\n   189→\n   190→        {varEntries.length === 0 && !showAddForm ? (\n   191→          <div className=\"empty-state\">\n   192→            <div className=\"empty-state-icon\">📦</div>\n   193→            <div className=\"empty-state-title\">No variables defined</div>\n   194→            <div className=\"empty-state-desc\">\n   195→              Add variables to select additional entities for use in mutations.\n   196→            </div>\n   197→          </div>\n   198→        ) : (\n   199→          varEntries.map(([name, config]) => (\n   200→            <VariableCard\n   201→              key={name}\n   202→              name={name}\n   203→              config={config}\n   204→              onChange={(updated) =>\n   205→                onChange({ ...action, variables: { ...variables, [name]: updated } })\n   206→              }\n   207→              onRemove={() => {\n   208→                const newVars = { ...variables };\n   209→                delete newVars[name];\n   210→                onChange({ ...action, variables: newVars });\n   211→              }}\n   212→              schema={schema}\n   213→              availableRefs={buildAvailableRefs(name)}\n   214→            />\n   215→          ))\n   216→        )}\n   217→\n   218→        {showAddForm ? (\n   219→          <div className=\"item-card add-form\">\n   220→            <div className=\"add-form-fields\">\n   221→              <div className=\"flex-1\">\n   222→                <label htmlFor=\"variable-name\" className=\"label\">Variable Name</label>\n   223→                <input id=\"variable-name\"\n   224→                  type=\"text\"\n   225→                  value={newVarName}\n   226→                  onChange={(e) => setNewVarName(e.target.value.replace(/[^a-zA-Z0-9_$]/g, \"\"))}\n   227→                  className=\"input\"\n   228→                  placeholder=\"$myVariable\"\n   229→                  // eslint-disable-next-line jsx-a11y/no-autofocus\n   230→                  autoFocus\n   231→                />\n   232→              </div>\n   233→              <button\n   234→                className=\"btn btn-primary\"\n   235→                onClick={handleAddVariable}\n   236→                disabled={!newVarName.trim()}\n   237→              >\n   238→                Add\n   239→              </button>\n   240→              <button\n   241→                className=\"btn btn-secondary\"\n   242→                onClick={() => {\n   243→                  setShowAddForm(false);\n   244→                  setNewVarName(\"\");\n   245→                }}\n   246→              >\n   247→                Cancel\n   248→              </button>\n   249→            </div>\n   250→          </div>\n   251→        ) : (\n   252→          <button className=\"btn-add\" onClick={() => setShowAddForm(true)}>\n   253→            + Add Variable\n   254→          </button>\n   255→        )}\n   256→      </div>\n   257→    </div>\n   258→  );\n   259→}\n   260→\n   261→VariablesTab.propTypes = {\n   262→  action: PropTypes.object.isRequired,\n   263→  onChange: PropTypes.func.isRequired,\n   264→  schema: PropTypes.object,\n   265→};\n   266→\n   267→export default VariablesTab;\n   268→"}]},"parent_tool_use_id":null,"session_id":"20d8db96-9940-458a-8101-1376b9d882e0","uuid":"ee44c839-c380-48be-8ba1-fccaa58b308c","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/components/actions/tabs/VariablesTab.jsx","content":"/**\n * VariablesTab - Define intermediate entity selections for actions\n */\n\nimport React, { useState } from \"react\";\nimport PropTypes from \"prop-types\";\nimport VariableSelectionEditor from \"../../shared/VariableSelectionEditor\";\nimport \"./VariablesTab.css\";\n\n/**\n * Safely display a value that should be a string.\n * If it's an object, log a warning and return a fallback.\n */\nfunction safeDisplay(value, fallback = \"?\", label = \"value\") {\n  if (value === null || value === undefined) return fallback;\n  if (typeof value === \"object\") {\n    console.warn(`[VariablesTab] Expected string for ${label} but got object:`, value);\n    return `[object]`;\n  }\n  return String(value);\n}\n\n// ============================================================================\n// VariableCard - Individual variable editor card\n// ============================================================================\n\nfunction VariableCard({ name, config, onChange, onRemove, schema, availableRefs = [] }) {\n  const [expanded, setExpanded] = useState(false);\n  const [hovering, setHovering] = useState(false);\n\n  // Handle the nested select structure: { select: { from, kind, pickStrategy, ... }, required }\n  const selectConfig = config.select || {};\n  const isRequired = config.required || false;\n\n  const updateRequired = (value) => {\n    onChange({ ...config, required: value });\n  };\n\n  // Display info\n  const displayMode =\n    selectConfig.from && typeof selectConfig.from === \"object\"\n      ? \"Related entities\"\n      : selectConfig.kind || \"Not configured\";\n  const displayStrategy = safeDisplay(selectConfig.pickStrategy, \"Not set\", \"pickStrategy\");\n  const filterCount = (selectConfig.filters || []).length;\n\n  return (\n    <div className=\"item-card\">\n      <div\n        className={`item-card-header ${hovering ? \"item-card-header-hover\" : \"\"}`}\n        onClick={() => setExpanded(!expanded)}\n        onMouseEnter={() => setHovering(true)}\n        onMouseLeave={() => setHovering(false)}\n        role=\"button\"\n        tabIndex={0}\n        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n      >\n        <div className=\"item-card-icon item-card-icon-variable\">📦</div>\n        <div className=\"item-card-info\">\n          <div className=\"item-card-title\">\n            <span className=\"variable-ref\">{name}</span>\n            {isRequired && (\n              <span className=\"badge badge-warning avt-required-badge\">\n                Required\n              </span>\n            )}\n          </div>\n          <div className=\"item-card-subtitle\">\n            {displayMode} • {displayStrategy}\n            {filterCount > 0 && (\n              <span className=\"ml-xs\">\n                • {filterCount} filter{filterCount > 1 ? \"s\" : \"\"}\n              </span>\n            )}\n          </div>\n        </div>\n        <div className=\"item-card-actions\">\n          <button className=\"btn-icon\">{expanded ? \"▲\" : \"▼\"}</button>\n          <button\n            className=\"btn-icon btn-icon-danger\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onRemove();\n            }}\n          >\n            ×\n          </button>\n        </div>\n      </div>\n\n      {expanded && (\n        <div className=\"item-card-body\">\n          {/* Required checkbox */}\n          <div className=\"mb-xl\">\n            <label className=\"avt-checkbox-label\">\n              <input\n                type=\"checkbox\"\n                checked={isRequired}\n                onChange={(e) => updateRequired(e.target.checked)}\n              />\n              <span className=\"label mb-0\">\n                Required\n              </span>\n              <span className=\"text-muted avt-required-hint\">\n                (Action won&apos;t execute unless this variable resolves)\n              </span>\n            </label>\n          </div>\n\n\n          <VariableSelectionEditor\n            value={selectConfig}\n            onChange={(updated) => onChange({ ...config, select: updated })}\n            schema={schema}\n            availableRefs={availableRefs}\n          />\n        </div>\n      )}\n    </div>\n  );\n}\n\nVariableCard.propTypes = {\n  name: PropTypes.string.isRequired,\n  config: PropTypes.object.isRequired,\n  onChange: PropTypes.func.isRequired,\n  onRemove: PropTypes.func.isRequired,\n  schema: PropTypes.object,\n  availableRefs: PropTypes.array,\n};\n\n// ============================================================================\n// VariablesTab - Main tab component\n// ============================================================================\n\n/**\n * @param {Object} props\n * @param {Object} props.action - The action being edited\n * @param {Function} props.onChange - Callback when action changes\n * @param {Object} props.schema - Domain schema\n */\nexport function VariablesTab({ action, onChange, schema }) {\n  const variables = action.variables || {};\n  const [newVarName, setNewVarName] = useState(\"\");\n  const [showAddForm, setShowAddForm] = useState(false);\n\n  // Build available refs for relationship queries (actor, instigator, target, target2 + other vars)\n  const buildAvailableRefs = (excludeVar) => {\n    const refs = [\"$actor\", \"$instigator\", \"$target\", \"$target2\"];\n    Object.keys(variables).forEach((v) => {\n      if (v !== excludeVar) refs.push(v);\n    });\n    return refs;\n  };\n\n  const handleAddVariable = () => {\n    if (!newVarName.trim()) return;\n    // Ensure the name starts with $\n    const name = newVarName.startsWith(\"$\") ? newVarName : `$${newVarName}`;\n    // Create with empty required fields - validation will flag them\n    onChange({\n      ...action,\n      variables: {\n        ...variables,\n        [name]: { select: { from: \"graph\", kind: \"\", pickStrategy: \"\" } },\n      },\n    });\n    setNewVarName(\"\");\n    setShowAddForm(false);\n  };\n\n  const varEntries = Object.entries(variables);\n\n  return (\n    <div>\n      <div className=\"section\">\n        <div className=\"section-title\">Variables</div>\n\n        <div className=\"info-box\">\n          <div className=\"info-box-title\">What are variables?</div>\n          <div className=\"info-box-text\">\n            Variables let you select additional entities from the graph to use in mutations. For\n            example, you might select a <code className=\"inline-code\">$victimFaction</code> to\n            create an enemy relationship with, or an <code className=\"inline-code\">$artifact</code>{\" \"}\n            to modify. Variables are resolved after <code className=\"inline-code\">$actor</code> and{\" \"}\n            <code className=\"inline-code\">$target</code> are chosen.\n          </div>\n        </div>\n\n        {varEntries.length === 0 && !showAddForm ? (\n          <div className=\"empty-state\">\n            <div className=\"empty-state-icon\">📦</div>\n            <div className=\"empty-state-title\">No variables defined</div>\n            <div className=\"empty-state-desc\">\n              Add variables to select additional entities for use in mutations.\n            </div>\n          </div>\n        ) : (\n          varEntries.map(([name, config]) => (\n            <VariableCard\n              key={name}\n              name={name}\n              config={config}\n              onChange={(updated) =>\n                onChange({ ...action, variables: { ...variables, [name]: updated } })\n              }\n              onRemove={() => {\n                const newVars = { ...variables };\n                delete newVars[name];\n                onChange({ ...action, variables: newVars });\n              }}\n              schema={schema}\n              availableRefs={buildAvailableRefs(name)}\n            />\n          ))\n        )}\n\n        {showAddForm ? (\n          <div className=\"item-card add-form\">\n            <div className=\"add-form-fields\">\n              <div className=\"flex-1\">\n                <label htmlFor=\"variable-name\" className=\"label\">Variable Name</label>\n                <input id=\"variable-name\"\n                  type=\"text\"\n                  value={newVarName}\n                  onChange={(e) => setNewVarName(e.target.value.replace(/[^a-zA-Z0-9_$]/g, \"\"))}\n                  className=\"input\"\n                  placeholder=\"$myVariable\"\n                  // eslint-disable-next-line jsx-a11y/no-autofocus\n                  autoFocus\n                />\n              </div>\n              <button\n                className=\"btn btn-primary\"\n                onClick={handleAddVariable}\n                disabled={!newVarName.trim()}\n              >\n                Add\n              </button>\n              <button\n                className=\"btn btn-secondary\"\n                onClick={() => {\n                  setShowAddForm(false);\n                  setNewVarName(\"\");\n                }}\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        ) : (\n          <button className=\"btn-add\" onClick={() => setShowAddForm(true)}>\n            + Add Variable\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n\nVariablesTab.propTypes = {\n  action: PropTypes.object.isRequired,\n  onChange: PropTypes.func.isRequired,\n  schema: PropTypes.object,\n};\n\nexport default VariablesTab;\n","numLines":268,"startLine":1,"totalLines":268}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01WexDPEpcyTNAued5inxmpf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BZnKs7y8Vcy5Y9o27ppUeg","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/components/systems/tabs/ThresholdTriggerTab.jsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":444,"cache_read_input_tokens":50535,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":444},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"20d8db96-9940-458a-8101-1376b9d882e0","uuid":"1c75d141-6c94-41f8-9325-084bfcc5ccc2"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BZnKs7y8Vcy5Y9o27ppUeg","type":"tool_result","content":"     1→/**\n     2→ * ThresholdTriggerTab - Configuration for threshold trigger systems\n     3→ */\n     4→\n     5→import React, { useState } from \"react\";\n     6→import PropTypes from \"prop-types\";\n     7→import { CLUSTER_MODES } from \"../constants\";\n     8→import { ReferenceDropdown, NumberInput, LocalTextArea } from \"../../shared\";\n     9→import VariableSelectionEditor from \"../../shared/VariableSelectionEditor\";\n    10→import { ApplicabilityRuleCard } from \"../../generators/applicability/ApplicabilityRuleCard\";\n    11→import { AddRuleButton } from \"../../generators/applicability/AddRuleButton\";\n    12→import { createNewRule } from \"../../generators/applicability/createNewRule\";\n    13→import MutationCard, { DEFAULT_MUTATION_TYPES } from \"../../shared/MutationCard\";\n    14→import \"./ThresholdTriggerTab.css\";\n    15→\n    16→// ============================================================================\n    17→// VariableCard - Individual variable editor card (reused pattern from generators)\n    18→// ============================================================================\n    19→\n    20→function VariableCard({ name, config, onChange, onRemove, schema, availableRefs = [] }) {\n    21→  const [expanded, setExpanded] = useState(false);\n    22→  const [hovering, setHovering] = useState(false);\n    23→\n    24→  const selectConfig = config.select || {};\n    25→  const isRequired = config.required || false;\n    26→\n    27→  const updateRequired = (value) => {\n    28→    onChange({ ...config, required: value });\n    29→  };\n    30→\n    31→  // Determine display mode\n    32→  const getDisplayMode = () => {\n    33→    if (!selectConfig.from || selectConfig.from === \"graph\") {\n    34→      return selectConfig.kind || \"Not configured\";\n    35→    }\n    36→    if (typeof selectConfig.from === \"object\" && \"path\" in selectConfig.from) {\n    37→      const stepCount = selectConfig.from.path?.length || 0;\n    38→      return `Path traversal (${stepCount} step${stepCount !== 1 ? \"s\" : \"\"})`;\n    39→    }\n    40→    return \"Related entities\";\n    41→  };\n    42→  const displayMode = getDisplayMode();\n    43→  const displayStrategy = selectConfig.pickStrategy || \"Not set\";\n    44→  const filterCount = (selectConfig.filters || []).length;\n    45→\n    46→  return (\n    47→    <div className=\"item-card\">\n    48→      <div\n    49→        className={`item-card-header ${hovering ? \"item-card-header-hover\" : \"\"}`}\n    50→        onClick={() => setExpanded(!expanded)}\n    51→        onMouseEnter={() => setHovering(true)}\n    52→        onMouseLeave={() => setHovering(false)}\n    53→        role=\"button\"\n    54→        tabIndex={0}\n    55→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n    56→      >\n    57→        <div className=\"item-card-icon item-card-icon-variable\">📦</div>\n    58→        <div className=\"item-card-info\">\n    59→          <div className=\"item-card-title\">\n    60→            <span className=\"variable-ref\">{name}</span>\n    61→            {isRequired && (\n    62→              <span className=\"badge badge-warning ttt-required-badge\">\n    63→                Required\n    64→              </span>\n    65→            )}\n    66→          </div>\n    67→          <div className=\"item-card-subtitle\">\n    68→            {displayMode} • {displayStrategy}\n    69→            {filterCount > 0 && (\n    70→              <span className=\"ml-xs\">\n    71→                • {filterCount} filter{filterCount > 1 ? \"s\" : \"\"}\n    72→              </span>\n    73→            )}\n    74→          </div>\n    75→        </div>\n    76→        <div className=\"item-card-actions\">\n    77→          <button className=\"btn-icon\">{expanded ? \"▲\" : \"▼\"}</button>\n    78→          <button\n    79→            className=\"btn-icon btn-icon-danger\"\n    80→            onClick={(e) => {\n    81→              e.stopPropagation();\n    82→              onRemove();\n    83→            }}\n    84→          >\n    85→            ×\n    86→          </button>\n    87→        </div>\n    88→      </div>\n    89→\n    90→      {expanded && (\n    91→        <div className=\"item-card-body\">\n    92→          <div className=\"mb-xl\">\n    93→            <label className=\"ttt-checkbox-label\">\n    94→              <input\n    95→                type=\"checkbox\"\n    96→                checked={isRequired}\n    97→                onChange={(e) => updateRequired(e.target.checked)}\n    98→              />\n    99→              <span className=\"label mb-0\">\n   100→                Required\n   101→              </span>\n   102→              <span className=\"text-muted ttt-required-hint\">\n   103→                (Entity is skipped if this variable can&apos;t be resolved)\n   104→              </span>\n   105→            </label>\n   106→          </div>\n   107→\n   108→\n   109→          <VariableSelectionEditor\n   110→            value={selectConfig}\n   111→            onChange={(updated) => onChange({ ...config, select: updated })}\n   112→            schema={schema}\n   113→            availableRefs={availableRefs}\n   114→          />\n   115→        </div>\n   116→      )}\n   117→    </div>\n   118→  );\n   119→}\n   120→\n   121→VariableCard.propTypes = {\n   122→  name: PropTypes.string.isRequired,\n   123→  config: PropTypes.object.isRequired,\n   124→  onChange: PropTypes.func.isRequired,\n   125→  onRemove: PropTypes.func.isRequired,\n   126→  schema: PropTypes.object,\n   127→  availableRefs: PropTypes.array,\n   128→};\n   129→\n   130→const TRIGGER_MUTATION_TYPES = DEFAULT_MUTATION_TYPES;\n   131→\n   132→/**\n   133→ * @param {Object} props\n   134→ * @param {Object} props.system - The system being edited\n   135→ * @param {Function} props.onChange - Called when system changes\n   136→ * @param {Object} props.schema - Domain schema\n   137→ * @param {Array} props.pressures - Pressure definitions\n   138→ */\n   139→export function ThresholdTriggerTab({ system, onChange, schema, pressures }) {\n   140→  const config = system.config;\n   141→  const [newVarName, setNewVarName] = useState(\"\");\n   142→  const [showAddVarForm, setShowAddVarForm] = useState(false);\n   143→\n   144→  const relationshipKindOptions = (schema?.relationshipKinds || []).map((rk) => ({\n   145→    value: rk.kind,\n   146→    label: rk.description || rk.kind,\n   147→  }));\n   148→\n   149→  const updateConfig = (field, value) => {\n   150→    onChange({ ...system, config: { ...config, [field]: value } });\n   151→  };\n   152→\n   153→  // Conditions\n   154→  const conditions = config.conditions || [];\n   155→\n   156→  const addCondition = (type) => {\n   157→    const newRule = createNewRule(type, pressures);\n   158→    updateConfig(\"conditions\", [...conditions, newRule]);\n   159→  };\n   160→\n   161→  const updateCondition = (index, cond) => {\n   162→    const newConditions = [...conditions];\n   163→    newConditions[index] = cond;\n   164→    updateConfig(\"conditions\", newConditions);\n   165→  };\n   166→\n   167→  const removeCondition = (index) => {\n   168→    updateConfig(\n   169→      \"conditions\",\n   170→      conditions.filter((_, i) => i !== index)\n   171→    );\n   172→  };\n   173→\n   174→  // Variables\n   175→  const variables = config.variables || {};\n   176→\n   177→  const buildAvailableRefs = (excludeVar) => {\n   178→    const refs = [\"$self\"];\n   179→    Object.keys(variables).forEach((v) => {\n   180→      if (v !== excludeVar) refs.push(v);\n   181→    });\n   182→    return refs;\n   183→  };\n   184→\n   185→  const handleAddVariable = () => {\n   186→    if (!newVarName.trim()) return;\n   187→    const name = newVarName.startsWith(\"$\") ? newVarName : `$${newVarName}`;\n   188→    updateConfig(\"variables\", {\n   189→      ...variables,\n   190→      [name]: { select: { from: \"graph\", kind: \"\", pickStrategy: \"random\" } },\n   191→    });\n   192→    setNewVarName(\"\");\n   193→    setShowAddVarForm(false);\n   194→  };\n   195→\n   196→  const updateVariable = (name, config) => {\n   197→    updateConfig(\"variables\", { ...variables, [name]: config });\n   198→  };\n   199→\n   200→  const removeVariable = (name) => {\n   201→    const newVars = { ...variables };\n   202→    delete newVars[name];\n   203→    updateConfig(\"variables\", newVars);\n   204→  };\n   205→\n   206→  // Build entity options for actions (include defined variables)\n   207→  const entityOptions = [\n   208→    { value: \"$self\", label: \"$self\" },\n   209→    { value: \"$member\", label: \"$member\" },\n   210→    { value: \"$member2\", label: \"$member2\" },\n   211→    ...Object.keys(variables).map((v) => ({ value: v, label: v })),\n   212→  ];\n   213→\n   214→  // Actions (mutations)\n   215→  const actions = config.actions || [];\n   216→\n   217→  const createAction = (type) => {\n   218→    const defaultPressure = pressures?.[0]?.id || \"\";\n   219→    switch (type) {\n   220→      case \"modify_pressure\":\n   221→        return { type: \"modify_pressure\", pressureId: defaultPressure, delta: 0 };\n   222→      case \"set_tag\":\n   223→        return { type: \"set_tag\", entity: \"$self\", tag: \"\", value: true };\n   224→      case \"remove_tag\":\n   225→        return { type: \"remove_tag\", entity: \"$self\", tag: \"\" };\n   226→      case \"change_status\":\n   227→        return { type: \"change_status\", entity: \"$self\", newStatus: \"\" };\n   228→      case \"adjust_prominence\":\n   229→        return { type: \"adjust_prominence\", entity: \"$self\", delta: 0.25 };\n   230→      case \"archive_relationship\":\n   231→        return {\n   232→          type: \"archive_relationship\",\n   233→          entity: \"$self\",\n   234→          relationshipKind: \"\",\n   235→          direction: \"both\",\n   236→        };\n   237→      case \"adjust_relationship_strength\":\n   238→        return {\n   239→          type: \"adjust_relationship_strength\",\n   240→          kind: \"\",\n   241→          src: \"$self\",\n   242→          dst: \"$self\",\n   243→          delta: 0.1,\n   244→        };\n   245→      case \"transfer_relationship\":\n   246→        return {\n   247→          type: \"transfer_relationship\",\n   248→          entity: \"$self\",\n   249→          relationshipKind: \"\",\n   250→          from: \"$self\",\n   251→          to: \"$self\",\n   252→        };\n   253→      case \"update_rate_limit\":\n   254→        return { type: \"update_rate_limit\" };\n   255→      case \"for_each_related\":\n   256→        return { type: \"for_each_related\", relationship: \"\", direction: \"both\", actions: [] };\n   257→      case \"conditional\":\n   258→        return {\n   259→          type: \"conditional\",\n   260→          condition: { type: \"random_chance\", chance: 0.5 },\n   261→          thenActions: [],\n   262→          elseActions: [],\n   263→        };\n   264→      case \"create_relationship\":\n   265→      default:\n   266→        return { type: \"create_relationship\", kind: \"\", src: \"$self\", dst: \"$self\", strength: 0.5 };\n   267→    }\n   268→  };\n   269→\n   270→  const addAction = (type) => {\n   271→    updateConfig(\"actions\", [...actions, createAction(type)]);\n   272→  };\n   273→\n   274→  const updateAction = (index, action) => {\n   275→    const newActions = [...actions];\n   276→    newActions[index] = action;\n   277→    updateConfig(\"actions\", newActions);\n   278→  };\n   279→\n   280→  const removeAction = (index) => {\n   281→    updateConfig(\n   282→      \"actions\",\n   283→      actions.filter((_, i) => i !== index)\n   284→    );\n   285→  };\n   286→\n   287→  return (\n   288→    <div>\n   289→      <div className=\"section\">\n   290→        <div className=\"section-title\">Conditions ({conditions.length})</div>\n   291→        <div className=\"section-desc\">\n   292→          All conditions must pass for an entity to be included in the trigger.\n   293→        </div>\n   294→\n   295→        {conditions.length === 0 ? (\n   296→          <div className=\"empty-state-compact\">No conditions defined.</div>\n   297→        ) : (\n   298→          conditions.map((cond, index) => (\n   299→            <ApplicabilityRuleCard\n   300→              key={index}\n   301→              rule={cond}\n   302→              onChange={(c) => updateCondition(index, c)}\n   303→              onRemove={() => removeCondition(index)}\n   304→              schema={schema}\n   305→              pressures={pressures}\n   306→            />\n   307→          ))\n   308→        )}\n   309→\n   310→        <AddRuleButton onAdd={addCondition} />\n   311→      </div>\n   312→\n   313→      <div className=\"section\">\n   314→        <div className=\"section-title\">Variables ({Object.keys(variables).length})</div>\n   315→        <div className=\"section-desc\">\n   316→          Variables select additional entities from the graph to use in actions. Referenced as{\" \"}\n   317→          <code className=\"inline-code\">$varName</code> in action entity fields.\n   318→        </div>\n   319→\n   320→        {Object.keys(variables).length === 0 && !showAddVarForm ? (\n   321→          <div className=\"empty-state-compact\">No variables defined.</div>\n   322→        ) : (\n   323→          Object.entries(variables).map(([name, varConfig]) => (\n   324→            <VariableCard\n   325→              key={name}\n   326→              name={name}\n   327→              config={varConfig}\n   328→              onChange={(updated) => updateVariable(name, updated)}\n   329→              onRemove={() => removeVariable(name)}\n   330→              schema={schema}\n   331→              availableRefs={buildAvailableRefs(name)}\n   332→            />\n   333→          ))\n   334→        )}\n   335→\n   336→        {showAddVarForm ? (\n   337→          <div className=\"item-card add-form\">\n   338→            <div className=\"add-form-fields\">\n   339→              <div className=\"flex-1\">\n   340→                <label htmlFor=\"variable-name\" className=\"label\">Variable Name</label>\n   341→                <input id=\"variable-name\"\n   342→                  type=\"text\"\n   343→                  value={newVarName}\n   344→                  onChange={(e) => setNewVarName(e.target.value.replace(/[^a-zA-Z0-9_$]/g, \"\"))}\n   345→                  className=\"input\"\n   346→                  placeholder=\"$myVariable\"\n   347→                  // eslint-disable-next-line jsx-a11y/no-autofocus\n   348→                  autoFocus\n   349→                />\n   350→              </div>\n   351→              <button\n   352→                className=\"btn btn-primary\"\n   353→                onClick={handleAddVariable}\n   354→                disabled={!newVarName.trim()}\n   355→              >\n   356→                Add\n   357→              </button>\n   358→              <button\n   359→                className=\"btn btn-secondary\"\n   360→                onClick={() => {\n   361→                  setShowAddVarForm(false);\n   362→                  setNewVarName(\"\");\n   363→                }}\n   364→              >\n   365→                Cancel\n   366→              </button>\n   367→            </div>\n   368→          </div>\n   369→        ) : (\n   370→          <button className=\"btn-add\" onClick={() => setShowAddVarForm(true)}>\n   371→            + Add Variable\n   372→          </button>\n   373→        )}\n   374→      </div>\n   375→\n   376→      <div className=\"section\">\n   377→        <div className=\"section-title\">Actions ({actions.length})</div>\n   378→        <div className=\"section-desc\">\n   379→          Mutations applied to each matching entity (or clusters when configured).\n   380→        </div>\n   381→\n   382→        {actions.map((actionItem, index) => (\n   383→          <div key={index} className=\"mb-lg\">\n   384→            <MutationCard\n   385→              mutation={actionItem}\n   386→              onChange={(a) => updateAction(index, a)}\n   387→              onRemove={() => removeAction(index)}\n   388→              schema={schema}\n   389→              pressures={pressures}\n   390→              entityOptions={entityOptions}\n   391→              typeOptions={TRIGGER_MUTATION_TYPES}\n   392→              createMutation={createAction}\n   393→              titlePrefix=\"Action\"\n   394→            />\n   395→            {actionItem.type === \"create_relationship\" && (\n   396→              <label className=\"checkbox-label mt-md\">\n   397→                <input\n   398→                  type=\"checkbox\"\n   399→                  checked={actionItem.betweenMatching || false}\n   400→                  onChange={(e) =>\n   401→                    updateAction(index, { ...actionItem, betweenMatching: e.target.checked })\n   402→                  }\n   403→                  className=\"checkbox\"\n   404→                />\n   405→                Between matching entities\n   406→              </label>\n   407→            )}\n   408→          </div>\n   409→        ))}\n   410→\n   411→        <div className=\"form-group mt-lg\">\n   412→          <select\n   413→            className=\"select\"\n   414→            value=\"\"\n   415→            onChange={(e) => {\n   416→              if (!e.target.value) return;\n   417→              addAction(e.target.value);\n   418→            }}\n   419→          >\n   420→            <option value=\"\">+ Add action...</option>\n   421→            {TRIGGER_MUTATION_TYPES.map((opt) => (\n   422→              <option key={opt.value} value={opt.value}>\n   423→                {opt.label}\n   424→              </option>\n   425→            ))}\n   426→          </select>\n   427→        </div>\n   428→      </div>\n   429→\n   430→      <div className=\"section\">\n   431→        <div className=\"section-title\">Clustering</div>\n   432→        <div className=\"form-grid\">\n   433→          <ReferenceDropdown\n   434→            label=\"Cluster Mode\"\n   435→            value={config.clusterMode || \"individual\"}\n   436→            onChange={(v) => updateConfig(\"clusterMode\", v)}\n   437→            options={CLUSTER_MODES}\n   438→          />\n   439→          {config.clusterMode === \"by_relationship\" && (\n   440→            <>\n   441→              <ReferenceDropdown\n   442→                label=\"Cluster Relationship\"\n   443→                value={config.clusterRelationshipKind}\n   444→                onChange={(v) => updateConfig(\"clusterRelationshipKind\", v)}\n   445→                options={relationshipKindOptions}\n   446→              />\n   447→              <div className=\"form-group\">\n   448→                <label className=\"label\">Min Cluster Size\n   449→                <NumberInput\n   450→                  value={config.minClusterSize}\n   451→                  onChange={(v) => updateConfig(\"minClusterSize\", v)}\n   452→                  min={1}\n   453→                  integer\n   454→                  allowEmpty\n   455→                />\n   456→                </label>\n   457→              </div>\n   458→            </>\n   459→          )}\n   460→        </div>\n   461→      </div>\n   462→\n   463→      <div className=\"section\">\n   464→        <div className=\"section-title\">Narration Template</div>\n   465→        <div className=\"section-desc mb-md text-xs\">\n   466→          Syntax: {\"{$self.field}\"}, {\"{$varName.field}\"}, {\"{field|fallback}\"}.\n   467→        </div>\n   468→        <LocalTextArea\n   469→          value={config.narrationTemplate || \"\"}\n   470→          onChange={(value) => updateConfig(\"narrationTemplate\", value || undefined)}\n   471→          placeholder=\"e.g., {$self.name} reached a critical threshold and transformed.\"\n   472→          rows={2}\n   473→        />\n   474→      </div>\n   475→    </div>\n   476→  );\n   477→}\n   478→\n   479→ThresholdTriggerTab.propTypes = {\n   480→  system: PropTypes.object.isRequired,\n   481→  onChange: PropTypes.func.isRequired,\n   482→  schema: PropTypes.object,\n   483→  pressures: PropTypes.array,\n   484→};\n   485→"}]},"parent_tool_use_id":null,"session_id":"20d8db96-9940-458a-8101-1376b9d882e0","uuid":"345d7c85-5013-414e-ac94-8514ad084285","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/components/systems/tabs/ThresholdTriggerTab.jsx","content":"/**\n * ThresholdTriggerTab - Configuration for threshold trigger systems\n */\n\nimport React, { useState } from \"react\";\nimport PropTypes from \"prop-types\";\nimport { CLUSTER_MODES } from \"../constants\";\nimport { ReferenceDropdown, NumberInput, LocalTextArea } from \"../../shared\";\nimport VariableSelectionEditor from \"../../shared/VariableSelectionEditor\";\nimport { ApplicabilityRuleCard } from \"../../generators/applicability/ApplicabilityRuleCard\";\nimport { AddRuleButton } from \"../../generators/applicability/AddRuleButton\";\nimport { createNewRule } from \"../../generators/applicability/createNewRule\";\nimport MutationCard, { DEFAULT_MUTATION_TYPES } from \"../../shared/MutationCard\";\nimport \"./ThresholdTriggerTab.css\";\n\n// ============================================================================\n// VariableCard - Individual variable editor card (reused pattern from generators)\n// ============================================================================\n\nfunction VariableCard({ name, config, onChange, onRemove, schema, availableRefs = [] }) {\n  const [expanded, setExpanded] = useState(false);\n  const [hovering, setHovering] = useState(false);\n\n  const selectConfig = config.select || {};\n  const isRequired = config.required || false;\n\n  const updateRequired = (value) => {\n    onChange({ ...config, required: value });\n  };\n\n  // Determine display mode\n  const getDisplayMode = () => {\n    if (!selectConfig.from || selectConfig.from === \"graph\") {\n      return selectConfig.kind || \"Not configured\";\n    }\n    if (typeof selectConfig.from === \"object\" && \"path\" in selectConfig.from) {\n      const stepCount = selectConfig.from.path?.length || 0;\n      return `Path traversal (${stepCount} step${stepCount !== 1 ? \"s\" : \"\"})`;\n    }\n    return \"Related entities\";\n  };\n  const displayMode = getDisplayMode();\n  const displayStrategy = selectConfig.pickStrategy || \"Not set\";\n  const filterCount = (selectConfig.filters || []).length;\n\n  return (\n    <div className=\"item-card\">\n      <div\n        className={`item-card-header ${hovering ? \"item-card-header-hover\" : \"\"}`}\n        onClick={() => setExpanded(!expanded)}\n        onMouseEnter={() => setHovering(true)}\n        onMouseLeave={() => setHovering(false)}\n        role=\"button\"\n        tabIndex={0}\n        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n      >\n        <div className=\"item-card-icon item-card-icon-variable\">📦</div>\n        <div className=\"item-card-info\">\n          <div className=\"item-card-title\">\n            <span className=\"variable-ref\">{name}</span>\n            {isRequired && (\n              <span className=\"badge badge-warning ttt-required-badge\">\n                Required\n              </span>\n            )}\n          </div>\n          <div className=\"item-card-subtitle\">\n            {displayMode} • {displayStrategy}\n            {filterCount > 0 && (\n              <span className=\"ml-xs\">\n                • {filterCount} filter{filterCount > 1 ? \"s\" : \"\"}\n              </span>\n            )}\n          </div>\n        </div>\n        <div className=\"item-card-actions\">\n          <button className=\"btn-icon\">{expanded ? \"▲\" : \"▼\"}</button>\n          <button\n            className=\"btn-icon btn-icon-danger\"\n            onClick={(e) => {\n              e.stopPropagation();\n              onRemove();\n            }}\n          >\n            ×\n          </button>\n        </div>\n      </div>\n\n      {expanded && (\n        <div className=\"item-card-body\">\n          <div className=\"mb-xl\">\n            <label className=\"ttt-checkbox-label\">\n              <input\n                type=\"checkbox\"\n                checked={isRequired}\n                onChange={(e) => updateRequired(e.target.checked)}\n              />\n              <span className=\"label mb-0\">\n                Required\n              </span>\n              <span className=\"text-muted ttt-required-hint\">\n                (Entity is skipped if this variable can&apos;t be resolved)\n              </span>\n            </label>\n          </div>\n\n\n          <VariableSelectionEditor\n            value={selectConfig}\n            onChange={(updated) => onChange({ ...config, select: updated })}\n            schema={schema}\n            availableRefs={availableRefs}\n          />\n        </div>\n      )}\n    </div>\n  );\n}\n\nVariableCard.propTypes = {\n  name: PropTypes.string.isRequired,\n  config: PropTypes.object.isRequired,\n  onChange: PropTypes.func.isRequired,\n  onRemove: PropTypes.func.isRequired,\n  schema: PropTypes.object,\n  availableRefs: PropTypes.array,\n};\n\nconst TRIGGER_MUTATION_TYPES = DEFAULT_MUTATION_TYPES;\n\n/**\n * @param {Object} props\n * @param {Object} props.system - The system being edited\n * @param {Function} props.onChange - Called when system changes\n * @param {Object} props.schema - Domain schema\n * @param {Array} props.pressures - Pressure definitions\n */\nexport function ThresholdTriggerTab({ system, onChange, schema, pressures }) {\n  const config = system.config;\n  const [newVarName, setNewVarName] = useState(\"\");\n  const [showAddVarForm, setShowAddVarForm] = useState(false);\n\n  const relationshipKindOptions = (schema?.relationshipKinds || []).map((rk) => ({\n    value: rk.kind,\n    label: rk.description || rk.kind,\n  }));\n\n  const updateConfig = (field, value) => {\n    onChange({ ...system, config: { ...config, [field]: value } });\n  };\n\n  // Conditions\n  const conditions = config.conditions || [];\n\n  const addCondition = (type) => {\n    const newRule = createNewRule(type, pressures);\n    updateConfig(\"conditions\", [...conditions, newRule]);\n  };\n\n  const updateCondition = (index, cond) => {\n    const newConditions = [...conditions];\n    newConditions[index] = cond;\n    updateConfig(\"conditions\", newConditions);\n  };\n\n  const removeCondition = (index) => {\n    updateConfig(\n      \"conditions\",\n      conditions.filter((_, i) => i !== index)\n    );\n  };\n\n  // Variables\n  const variables = config.variables || {};\n\n  const buildAvailableRefs = (excludeVar) => {\n    const refs = [\"$self\"];\n    Object.keys(variables).forEach((v) => {\n      if (v !== excludeVar) refs.push(v);\n    });\n    return refs;\n  };\n\n  const handleAddVariable = () => {\n    if (!newVarName.trim()) return;\n    const name = newVarName.startsWith(\"$\") ? newVarName : `$${newVarName}`;\n    updateConfig(\"variables\", {\n      ...variables,\n      [name]: { select: { from: \"graph\", kind: \"\", pickStrategy: \"random\" } },\n    });\n    setNewVarName(\"\");\n    setShowAddVarForm(false);\n  };\n\n  const updateVariable = (name, config) => {\n    updateConfig(\"variables\", { ...variables, [name]: config });\n  };\n\n  const removeVariable = (name) => {\n    const newVars = { ...variables };\n    delete newVars[name];\n    updateConfig(\"variables\", newVars);\n  };\n\n  // Build entity options for actions (include defined variables)\n  const entityOptions = [\n    { value: \"$self\", label: \"$self\" },\n    { value: \"$member\", label: \"$member\" },\n    { value: \"$member2\", label: \"$member2\" },\n    ...Object.keys(variables).map((v) => ({ value: v, label: v })),\n  ];\n\n  // Actions (mutations)\n  const actions = config.actions || [];\n\n  const createAction = (type) => {\n    const defaultPressure = pressures?.[0]?.id || \"\";\n    switch (type) {\n      case \"modify_pressure\":\n        return { type: \"modify_pressure\", pressureId: defaultPressure, delta: 0 };\n      case \"set_tag\":\n        return { type: \"set_tag\", entity: \"$self\", tag: \"\", value: true };\n      case \"remove_tag\":\n        return { type: \"remove_tag\", entity: \"$self\", tag: \"\" };\n      case \"change_status\":\n        return { type: \"change_status\", entity: \"$self\", newStatus: \"\" };\n      case \"adjust_prominence\":\n        return { type: \"adjust_prominence\", entity: \"$self\", delta: 0.25 };\n      case \"archive_relationship\":\n        return {\n          type: \"archive_relationship\",\n          entity: \"$self\",\n          relationshipKind: \"\",\n          direction: \"both\",\n        };\n      case \"adjust_relationship_strength\":\n        return {\n          type: \"adjust_relationship_strength\",\n          kind: \"\",\n          src: \"$self\",\n          dst: \"$self\",\n          delta: 0.1,\n        };\n      case \"transfer_relationship\":\n        return {\n          type: \"transfer_relationship\",\n          entity: \"$self\",\n          relationshipKind: \"\",\n          from: \"$self\",\n          to: \"$self\",\n        };\n      case \"update_rate_limit\":\n        return { type: \"update_rate_limit\" };\n      case \"for_each_related\":\n        return { type: \"for_each_related\", relationship: \"\", direction: \"both\", actions: [] };\n      case \"conditional\":\n        return {\n          type: \"conditional\",\n          condition: { type: \"random_chance\", chance: 0.5 },\n          thenActions: [],\n          elseActions: [],\n        };\n      case \"create_relationship\":\n      default:\n        return { type: \"create_relationship\", kind: \"\", src: \"$self\", dst: \"$self\", strength: 0.5 };\n    }\n  };\n\n  const addAction = (type) => {\n    updateConfig(\"actions\", [...actions, createAction(type)]);\n  };\n\n  const updateAction = (index, action) => {\n    const newActions = [...actions];\n    newActions[index] = action;\n    updateConfig(\"actions\", newActions);\n  };\n\n  const removeAction = (index) => {\n    updateConfig(\n      \"actions\",\n      actions.filter((_, i) => i !== index)\n    );\n  };\n\n  return (\n    <div>\n      <div className=\"section\">\n        <div className=\"section-title\">Conditions ({conditions.length})</div>\n        <div className=\"section-desc\">\n          All conditions must pass for an entity to be included in the trigger.\n        </div>\n\n        {conditions.length === 0 ? (\n          <div className=\"empty-state-compact\">No conditions defined.</div>\n        ) : (\n          conditions.map((cond, index) => (\n            <ApplicabilityRuleCard\n              key={index}\n              rule={cond}\n              onChange={(c) => updateCondition(index, c)}\n              onRemove={() => removeCondition(index)}\n              schema={schema}\n              pressures={pressures}\n            />\n          ))\n        )}\n\n        <AddRuleButton onAdd={addCondition} />\n      </div>\n\n      <div className=\"section\">\n        <div className=\"section-title\">Variables ({Object.keys(variables).length})</div>\n        <div className=\"section-desc\">\n          Variables select additional entities from the graph to use in actions. Referenced as{\" \"}\n          <code className=\"inline-code\">$varName</code> in action entity fields.\n        </div>\n\n        {Object.keys(variables).length === 0 && !showAddVarForm ? (\n          <div className=\"empty-state-compact\">No variables defined.</div>\n        ) : (\n          Object.entries(variables).map(([name, varConfig]) => (\n            <VariableCard\n              key={name}\n              name={name}\n              config={varConfig}\n              onChange={(updated) => updateVariable(name, updated)}\n              onRemove={() => removeVariable(name)}\n              schema={schema}\n              availableRefs={buildAvailableRefs(name)}\n            />\n          ))\n        )}\n\n        {showAddVarForm ? (\n          <div className=\"item-card add-form\">\n            <div className=\"add-form-fields\">\n              <div className=\"flex-1\">\n                <label htmlFor=\"variable-name\" className=\"label\">Variable Name</label>\n                <input id=\"variable-name\"\n                  type=\"text\"\n                  value={newVarName}\n                  onChange={(e) => setNewVarName(e.target.value.replace(/[^a-zA-Z0-9_$]/g, \"\"))}\n                  className=\"input\"\n                  placeholder=\"$myVariable\"\n                  // eslint-disable-next-line jsx-a11y/no-autofocus\n                  autoFocus\n                />\n              </div>\n              <button\n                className=\"btn btn-primary\"\n                onClick={handleAddVariable}\n                disabled={!newVarName.trim()}\n              >\n                Add\n              </button>\n              <button\n                className=\"btn btn-secondary\"\n                onClick={() => {\n                  setShowAddVarForm(false);\n                  setNewVarName(\"\");\n                }}\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        ) : (\n          <button className=\"btn-add\" onClick={() => setShowAddVarForm(true)}>\n            + Add Variable\n          </button>\n        )}\n      </div>\n\n      <div className=\"section\">\n        <div className=\"section-title\">Actions ({actions.length})</div>\n        <div className=\"section-desc\">\n          Mutations applied to each matching entity (or clusters when configured).\n        </div>\n\n        {actions.map((actionItem, index) => (\n          <div key={index} className=\"mb-lg\">\n            <MutationCard\n              mutation={actionItem}\n              onChange={(a) => updateAction(index, a)}\n              onRemove={() => removeAction(index)}\n              schema={schema}\n              pressures={pressures}\n              entityOptions={entityOptions}\n              typeOptions={TRIGGER_MUTATION_TYPES}\n              createMutation={createAction}\n              titlePrefix=\"Action\"\n            />\n            {actionItem.type === \"create_relationship\" && (\n              <label className=\"checkbox-label mt-md\">\n                <input\n                  type=\"checkbox\"\n                  checked={actionItem.betweenMatching || false}\n                  onChange={(e) =>\n                    updateAction(index, { ...actionItem, betweenMatching: e.target.checked })\n                  }\n                  className=\"checkbox\"\n                />\n                Between matching entities\n              </label>\n            )}\n          </div>\n        ))}\n\n        <div className=\"form-group mt-lg\">\n          <select\n            className=\"select\"\n            value=\"\"\n            onChange={(e) => {\n              if (!e.target.value) return;\n              addAction(e.target.value);\n            }}\n          >\n            <option value=\"\">+ Add action...</option>\n            {TRIGGER_MUTATION_TYPES.map((opt) => (\n              <option key={opt.value} value={opt.value}>\n                {opt.label}\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      <div className=\"section\">\n        <div className=\"section-title\">Clustering</div>\n        <div className=\"form-grid\">\n          <ReferenceDropdown\n            label=\"Cluster Mode\"\n            value={config.clusterMode || \"individual\"}\n            onChange={(v) => updateConfig(\"clusterMode\", v)}\n            options={CLUSTER_MODES}\n          />\n          {config.clusterMode === \"by_relationship\" && (\n            <>\n              <ReferenceDropdown\n                label=\"Cluster Relationship\"\n                value={config.clusterRelationshipKind}\n                onChange={(v) => updateConfig(\"clusterRelationshipKind\", v)}\n                options={relationshipKindOptions}\n              />\n              <div className=\"form-group\">\n                <label className=\"label\">Min Cluster Size\n                <NumberInput\n                  value={config.minClusterSize}\n                  onChange={(v) => updateConfig(\"minClusterSize\", v)}\n                  min={1}\n                  integer\n                  allowEmpty\n                />\n                </label>\n              </div>\n            </>\n          )}\n        </div>\n      </div>\n\n      <div className=\"section\">\n        <div className=\"section-title\">Narration Template</div>\n        <div className=\"section-desc mb-md text-xs\">\n          Syntax: {\"{$self.field}\"}, {\"{$varName.field}\"}, {\"{field|fallback}\"}.\n        </div>\n        <LocalTextArea\n          value={config.narrationTemplate || \"\"}\n          onChange={(value) => updateConfig(\"narrationTemplate\", value || undefined)}\n          placeholder=\"e.g., {$self.name} reached a critical threshold and transformed.\"\n          rows={2}\n        />\n      </div>\n    </div>\n  );\n}\n\nThresholdTriggerTab.propTypes = {\n  system: PropTypes.object.isRequired,\n  onChange: PropTypes.func.isRequired,\n  schema: PropTypes.object,\n  pressures: PropTypes.array,\n};\n","numLines":485,"startLine":1,"totalLines":485}}}
