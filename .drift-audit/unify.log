314,"newLines":8,"lines":[" ","             <div className=\"axr-input-row\">","               <div className=\"axr-input-half\">","-                <div className=\"axr-form-group\">","-                  <label className=\"axr-label\">Low Tag (0)","+                <div className=\"cosmo-form-group\">","+                  <label className=\"cosmo-label\">Low Tag (0)","                   <TagSelector","                     tagRegistry={tagRegistry}","                     value={formData.lowTag ? [formData.lowTag] : []}"]},{"oldStart":328,"oldLines":8,"newStart":328,"newLines":8,"lines":["                 </div>","               </div>","               <div className=\"axr-input-half\">","-                <div className=\"axr-form-group\">","-                  <label className=\"axr-label\">High Tag (100)","+                <div className=\"cosmo-form-group\">","+                  <label className=\"cosmo-label\">High Tag (100)","                   <TagSelector","                     tagRegistry={tagRegistry}","                     value={formData.highTag ? [formData.highTag] : []}"]},{"oldStart":343,"oldLines":17,"newStart":343,"newLines":17,"lines":["               </div>","             </div>"," ","-            <div className=\"axr-hint\">","+            <div className=\"cosmo-hint\">","               Tags will be auto-created in the registry with isAxis=true and set as mutually","               exclusive.","             </div>"," ","-            <div className=\"axr-modal-actions\">","-              <button className=\"axr-cancel-button\" onClick={closeModal}>","+            <div className=\"cosmo-modal-actions\">","+              <button className=\"cosmo-cancel-btn\" onClick={closeModal}>","                 Cancel","               </button>","               <button","-                className=\"axr-save-button\"","+                className=\"cosmo-save-btn axr-save-button\"","                 style={{ '--axr-save-opacity': formData.name && formData.lowTag && 