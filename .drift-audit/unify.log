{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012qYsYcCW27hmWPSoGPHbUo","type":"tool_result","content":"     1→/**\n     2→ * useEditorState - Hook for common editor state management\n     3→ *\n     4→ * Provides standard CRUD operations for list-based editors:\n     5→ * - Selection tracking (selectedIndex, selectedItem)\n     6→ * - Item update/toggle/delete/add handlers\n     7→ *\n     8→ * @param {Array} items - Array of items being edited\n     9→ * @param {Function} onChange - Callback when items array changes\n    10→ * @param {Object} options - Optional configuration\n    11→ * @param {string} options.idField - Field name for item ID (default: 'id')\n    12→ * @param {string} options.nameField - Field name for item name (default: 'name')\n    13→ * @param {Function} options.createItem - Factory function to create new items\n    14→ *\n    15→ * @returns {Object} Editor state and handlers\n    16→ *\n    17→ * @example\n    18→ * const {\n    19→ *   selectedIndex, selectedItem,\n    20→ *   handleItemChange, handleToggle, handleDelete, handleAdd,\n    21→ *   handleSelect, handleClose\n    22→ * } = useEditorState(items, onChange, {\n    23→ *   createItem: () => ({ id: `item_${Date.now()}`, name: 'New Item' })\n    24→ * });\n    25→ */\n    26→\n    27→import { useState, useCallback, useEffect } from 'react';\n    28→\n    29→function loadStored(key) {\n    30→  if (!key) return null;\n    31→  try {\n    32→    const raw = localStorage.getItem(key);\n    33→    return raw ? JSON.parse(raw) : null;\n    34→  } catch {\n    35→    return null;\n    36→  }\n    37→}\n    38→\n    39→function saveStored(key, value) {\n    40→  if (!key) return;\n    41→  try {\n    42→    localStorage.setItem(key, JSON.stringify(value));\n    43→  } catch {\n    44→    // Best-effort only.\n    45→  }\n    46→}\n    47→\n    48→function clearStored(key) {\n    49→  if (!key) return;\n    50→  try {\n    51→    localStorage.removeItem(key);\n    52→  } catch {\n    53→    // Best-effort only.\n    54→  }\n    55→}\n    56→\n    57→export function useEditorState(items, onChange, options = {}) {\n    58→  const {\n    59→    idField = 'id',\n    60→    nameField = 'name',\n    61→    createItem,\n    62→    persistKey,\n    63→  } = options;\n    64→\n    65→  const [selectedId, setSelectedId] = useState(() => {\n    66→    const stored = loadStored(persistKey);\n    67→    return typeof stored === 'string' ? stored : null;\n    68→  });\n    69→\n    70→  // Restore selectedId from storage when persistKey changes\n    71→  useEffect(() => {\n    72→    const stored = loadStored(persistKey);\n    73→    // eslint-disable-next-line react-hooks/set-state-in-effect -- restore persisted selection when key changes\n    74→    setSelectedId(typeof stored === 'string' ? stored : null);\n    75→  }, [persistKey]);\n    76→\n    77→  const resolvedIndex = selectedId ? items.findIndex((item) => item[idField] === selectedId) : -1;\n    78→  const selectedIndex = resolvedIndex >= 0 ? resolvedIndex : null;\n    79→\n    80→  // Derive selected item from index\n    81→  const selectedItem = selectedIndex !== null && selectedIndex < items.length\n    82→    ? items[selectedIndex]\n    83→    : null;\n    84→\n    85→  // Persist selectedId to storage\n    86→  useEffect(() => {\n    87→    if (!persistKey) return;\n    88→    if (selectedId) {\n    89→      saveStored(persistKey, selectedId);\n    90→    } else {\n    91→      clearStored(persistKey);\n    92→    }\n    93→  }, [persistKey, selectedId]);\n    94→\n    95→  // Clear invalid selectedId\n    96→  if (selectedId && selectedIndex === null) {\n    97→    setSelectedId(null);\n    98→  }\n    99→\n   100→  // Update the currently selected item\n   101→  const handleItemChange = useCallback((updated) => {\n   102→    if (selectedIndex !== null && selectedIndex < items.length) {\n   103→      const newItems = [...items];\n   104→      newItems[selectedIndex] = updated;\n   105→      onChange(newItems);\n   106→    }\n   107→  }, [items, onChange, selectedIndex]);\n   108→\n   109→  // Toggle the enabled state of an item\n   110→  const handleToggle = useCallback((item) => {\n   111→    const index = items.findIndex((i) => i[idField] === item[idField]);\n   112→    if (index >= 0) {\n   113→      const newItems = [...items];\n   114→      newItems[index] = { ...item, enabled: item.enabled === false ? true : false };\n   115→      onChange(newItems);\n   116→    }\n   117→  }, [items, onChange, idField]);\n   118→\n   119→  // Delete the currently selected item (with confirmation)\n   120→  const handleDelete = useCallback(() => {\n   121→    if (selectedIndex !== null && selectedItem) {\n   122→      const itemName = selectedItem[nameField] || selectedItem[idField];\n   123→      if (confirm(`Delete \"${itemName}\"?`)) {\n   124→        const newItems = [...items];\n   125→        newItems.splice(selectedIndex, 1);\n   126→        onChange(newItems);\n   127→        setSelectedId(null);\n   128→      }\n   129→    }\n   130→  }, [items, onChange, selectedIndex, selectedItem, idField, nameField]);\n   131→\n   132→  // Add a new item (using createItem factory if provided)\n   133→  const handleAdd = useCallback((newItem) => {\n   134→    const itemToAdd = newItem || (createItem ? createItem() : { [idField]: `item_${Date.now()}` });\n   135→    onChange([...items, itemToAdd]);\n   136→    setSelectedId(itemToAdd[idField] || null);\n   137→  }, [items, onChange, createItem, idField]);\n   138→\n   139→  // Select an item by index\n   140→  const handleSelect = useCallback((index) => {\n   141→    const item = items[index];\n   142→    setSelectedId(item ? item[idField] : null);\n   143→  }, [items, idField]);\n   144→\n   145→  // Close the selection (deselect)\n   146→  const handleClose = useCallback(() => {\n   147→    setSelectedId(null);\n   148→  }, []);\n   149→\n   150→  return {\n   151→    selectedIndex,\n   152→    selectedItem,\n   153→    handleItemChange,\n   154→    handleToggle,\n   155→    handleDelete,\n   156→    handleAdd,\n   157→    handleSelect,\n   158→    handleClose,\n   159→  };\n   160→}\n   161→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"91cd0044-0c6f-4cb5-9b91-77565e6d713e"}
