"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/EnrichmentQueue.css","content":"/* EnrichmentQueue - Task list with entity-level controls */\n\n/* === EntityTaskGroup === */\n\n.eq-group {\n  margin-bottom: 8px;\n  border: 1px solid var(--border-color);\n  border-radius: 4px;\n  overflow: hidden;\n}\n\n.eq-group-header {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 12px;\n  background: var(--bg-tertiary);\n  border: none;\n  color: var(--text-color);\n  cursor: pointer;\n  text-align: left;\n}\n\n.eq-group-arrow {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eq-group-info {\n  flex: 1;\n}\n\n.eq-group-name {\n  font-weight: 500;\n}\n\n.eq-group-meta {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-left: 8px;\n}\n\n.eq-group-count {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n.eq-group-error {\n  color: var(--danger);\n  margin-left: 4px;\n}\n\n.eq-group-tasks {\n  padding: 8px 12px;\n  background: var(--bg-secondary);\n}\n\n.eq-task-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 0;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.eq-task-row:last-child {\n  border-bottom: none;\n}\n\n.eq-task-label {\n  flex: 1;\n  font-size: 12px;\n}\n\n.eq-task-run-btn {\n  padding: 2px 8px;\n  background: var(--accent-color);\n  border: none;\n  border-radius: 3px;\n  color: white;\n  font-size: 11px;\n  cursor: pointer;\n}\n\n/* === EnrichmentQueue main === */\n\n.eq-header-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.eq-api-warning {\n  padding: 12px;\n  background: rgb(245 158 11 / 10%);\n  border: 1px solid rgb(245 158 11 / 30%);\n  border-radius: 4px;\n  margin-bottom: 16px;\n  font-size: 12px;\n  color: var(--warning);\n}\n\n.eq-filters {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 16px;\n  padding: 12px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n}\n\n.eq-filter-label {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: block;\n  margin-bottom: 4px;\n}\n\n.eq-filter-select {\n  width: 120px;\n}\n\n.eq-filter-summary {\n  margin-left: auto;\n  align-self: flex-end;\n}\n\n.eq-filter-summary-text {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eq-empty {\n  text-align: center;\n  padding: 40px;\n  color: var(--text-muted);\n}\n\n.eq-selection-bar {\n  position: sticky;\n  bottom: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--accent-color);\n  border-radius: 6px;\n}\n\n.eq-selection-count {\n  font-size: 13px;\n}\n\n.eq-selection-actions {\n  display: flex;\n  gap: 8px;\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
