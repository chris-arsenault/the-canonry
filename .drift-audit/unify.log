{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0113TGfRXVfpCPzf2kGFk1zX","type":"tool_result","content":"     1→/**\n     2→ * Illuminator Database — Dexie schema\n     3→ *\n     4→ * Single canonical store for ALL Illuminator persistence.\n     5→ * v1: entities + narrativeEvents (entity enrichment DAL)\n     6→ * v2: chronicles, images, costs, traits, run stores, static pages, styles\n     7→ */\n     8→\n     9→import Dexie, { type Table } from \"dexie\";\n    10→import type {\n    11→  WorldEntity,\n    12→  WorldRelationship,\n    13→  NarrativeEvent,\n    14→  CanonrySchemaSlice,\n    15→  CoordinateState,\n    16→} from \"@canonry/world-schema\";\n    17→import type { EntityEnrichment } from \"../enrichmentTypes\";\n    18→import type { ChronicleRecord } from \"../chronicleTypes\";\n    19→import type { ImageRecord, ImageType, ImageAspect, ImageBlobRecord } from \"../imageTypes\";\n    20→import type { CostRecord, CostType, CostRecordInput, CostSummary } from \"../costTypes\";\n    21→import type { TraitPalette, UsedTraitRecord, PaletteItem, TraitGuidance } from \"../traitTypes\";\n    22→import type { HistorianRun } from \"../historianTypes\";\n    23→import type { EraNarrativeRecord } from \"../eraNarrativeTypes\";\n    24→import type { SummaryRevisionRun } from \"../summaryRevisionTypes\";\n    25→import type { DynamicsRun } from \"../dynamicsGenerationTypes\";\n    26→import type { StaticPage, StaticPageStatus } from \"../staticPageTypes\";\n    27→import type { StyleLibrary } from \"@canonry/world-schema\";\n    28→import type { ContentTreeState, PageLayoutOverride } from \"../preprint/prePrintTypes\";\n    29→import type { RunIndexRecord } from \"./indexTypes\";\n    30→\n    31→// ---------------------------------------------------------------------------\n    32→// Types — entities + events (v1)\n    33→// ---------------------------------------------------------------------------\n    34→\n    35→/**\n    36→ * Full entity record stored in Dexie.\n    37→ * Extends WorldEntity with the enrichment sub-object that Illuminator manages.\n    38→ */\n    39→export interface PersistedEntity extends WorldEntity {\n    40→  /** Scoped to simulation run — entities are meaningless across runs */\n    41→  simulationRunId: string;\n    42→  /** Illuminator-managed enrichment data */\n    43→  enrichment?: EntityEnrichment;\n    44→}\n    45→\n    46→/**\n    47→ * Full narrative event record stored in Dexie.\n    48→ * Extends NarrativeEvent with simulationRunId for scoping.\n    49→ */\n    50→export interface PersistedNarrativeEvent extends NarrativeEvent {\n    51→  simulationRunId: string;\n    52→}\n    53→\n    54→/**\n    55→ * Slot-level simulation metadata (discrete fields only).\n    56→ */\n    57→export interface SimulationSlotRecord {\n    58→  projectId: string;\n    59→  slotIndex: number;\n    60→  simulationRunId?: string | null;\n    61→  finalTick?: number | null;\n    62→  finalEraId?: string | null;\n    63→  label?: string | null;\n    64→  isTemporary?: boolean | null;\n    65→  updatedAt: number;\n    66→}\n    67→\n    68→export interface WorldSchemaRecord {\n    69→  projectId: string;\n    70→  schema: CanonrySchemaSlice;\n    71→  updatedAt: number;\n    72→}\n    73→\n    74→export interface CoordinateStateRecord {\n    75→  simulationRunId: string;\n    76→  coordinateState: CoordinateState;\n    77→  updatedAt: number;\n    78→}\n    79→\n    80→/**\n    81→ * Full relationship record stored in Dexie.\n    82→ * Extends WorldRelationship with simulationRunId for scoping.\n    83→ */\n    84→export interface PersistedRelationship extends WorldRelationship {\n    85→  simulationRunId: string;\n    86→}\n    87→\n    88→// ---------------------------------------------------------------------------\n    89→// Types — style library (v2)\n    90→// ---------------------------------------------------------------------------\n    91→\n    92→export interface StyleLibraryRecord {\n    93→  id: string;\n    94→  library: StyleLibrary;\n    95→  savedAt: number;\n    96→}\n    97→\n    98→// ---------------------------------------------------------------------------\n    99→// Re-exports for repository consumers\n   100→// ---------------------------------------------------------------------------"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"d021181b-7220-4cdd-8a0e-e3936db551d8"}
