{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCka3oQJy8WWyK4tq7Xnd3","type":"tool_result","content":"     1→/**\n     2→ * WeightMatrixEditor - Spreadsheet-style grid for managing generator/system weights across eras\n     3→ *\n     4→ * Features:\n     5→ * - Toggle between Generators and Systems view\n     6→ * - Heatmap coloring (darker = higher weight)\n     7→ * - Inline cell editing\n     8→ * - Bulk actions: apply to all eras, copy/paste rows\n     9→ * - Filter by name/tag\n    10→ * - Visual indicators for unassigned items\n    11→ */\n    12→\n    13→import React, { useState, useMemo, useCallback, useRef } from \"react\";\n    14→import PropTypes from \"prop-types\";\n    15→import { NumberInput } from \"../shared\";\n    16→import \"./WeightMatrixEditor.css\";\n    17→\n    18→// Weight levels for heatmap coloring\n    19→\n    20→const getHeatBucket = value => {\n    21→  if (value === 0 || value === undefined || value === null) return \"none\";\n    22→  if (value <= 2.5) return \"low\";\n    23→  if (value <= 5) return \"mid\";\n    24→  if (value <= 7.5) return \"high\";\n    25→  return \"max\";\n    26→};\n    27→export default function WeightMatrixEditor({\n    28→  generators = [],\n    29→  systems = [],\n    30→  eras = [],\n    31→  onErasChange\n    32→}) {\n    33→  const [viewMode, setViewMode] = useState(\"generators\"); // 'generators' | 'systems'\n    34→  const [searchQuery, setSearchQuery] = useState(\"\");\n    35→  const [editingCell, setEditingCell] = useState(null); // shape: rowId + eraId\n    36→  const [editValue, setEditValue] = useState(\"\");\n    37→  const [selectedRows, setSelectedRows] = useState(new Set());\n    38→  const [copiedRow, setCopiedRow] = useState(null); // { id, weights: { eraId: value } }\n    39→  const inputRef = useRef(null);\n    40→\n    41→  // Get current items based on view mode\n    42→  const items = useMemo(() => {\n    43→    const source = viewMode === \"generators\" ? generators : systems;\n    44→    return source.map(item => ({\n    45→      id: viewMode === \"generators\" ? item.id : item.config.id,\n    46→      name: viewMode === \"generators\" ? item.name || item.id : item.config.name || item.config.id,\n    47→      type: viewMode === \"generators\" ? \"generator\" : item.systemType\n    48→    }));\n    49→  }, [viewMode, generators, systems]);\n    50→\n    51→  // Detect orphaned references - IDs in eras that don't exist in generators/systems\n    52→  const orphanedReferences = useMemo(() => {\n    53→    const generatorIds = new Set(generators.map(g => g.id));\n    54→    const systemIds = new Set(systems.map(s => s.config.id));\n    55→    const orphanedGenerators = [];\n    56→    const orphanedSystems = [];\n    57→    eras.forEach(era => {\n    58→      // Check template weights\n    59→      Object.keys(era.templateWeights || {}).forEach(id => {\n    60→        if (!generatorIds.has(id)) {\n    61→          orphanedGenerators.push({\n    62→            id,\n    63→            eraId: era.id,\n    64→            eraName: era.name\n    65→          });\n    66→        }\n    67→      });\n    68→\n    69→      // Check system modifiers\n    70→      Object.keys(era.systemModifiers || {}).forEach(id => {\n    71→        if (!systemIds.has(id)) {\n    72→          orphanedSystems.push({\n    73→            id,\n    74→            eraId: era.id,\n    75→            eraName: era.name\n    76→          });\n    77→        }\n    78→      });\n    79→    });\n    80→    return {\n    81→      generators: orphanedGenerators,\n    82→      systems: orphanedSystems\n    83→    };\n    84→  }, [eras, generators, systems]);\n    85→\n    86→  // Count total orphans\n    87→  const totalOrphans = orphanedReferences.generators.length + orphanedReferences.systems.length;\n    88→\n    89→  // Clean up all orphaned references\n    90→  const cleanupOrphanedReferences = useCallback(() => {\n    91→    const generatorIds = new Set(generators.map(g => g.id));\n    92→    const systemIds = new Set(systems.map(s => s.config.id));\n    93→    const newEras = eras.map(era => {\n    94→      const newTemplateWeights = {\n    95→        ...era.templateWeights\n    96→      };\n    97→      const newSystemModifiers = {\n    98→        ...era.systemModifiers\n    99→      };\n   100→\n   101→      // Remove orphaned generator references\n   102→      Object.keys(newTemplateWeights).forEach(id => {\n   103→        if (!generatorIds.has(id)) {\n   104→          delete newTemplateWeights[id];\n   105→        }\n   106→      });\n   107→\n   108→      // Remove orphaned system references\n   109→      Object.keys(newSystemModifiers).forEach(id => {\n   110→        if (!systemIds.has(id)) {\n   111→          delete newSystemModifiers[id];\n   112→        }\n   113→      });\n   114→      return {\n   115→        ...era,\n   116→        templateWeights: newTemplateWeights,\n   117→        systemModifiers: newSystemModifiers\n   118→      };\n   119→    });\n   120→    onErasChange(newEras);\n   121→  }, [eras, generators, systems, onErasChange]);\n   122→\n   123→  // Filter items by search\n   124→  const filteredItems = useMemo(() => {\n   125→    if (!searchQuery) return items;\n   126→    const query = searchQuery.toLowerCase();\n   127→    return items.filter(item => item.id.toLowerCase().includes(query) || item.name.toLowerCase().includes(query));\n   128→  }, [items, searchQuery]);\n   129→\n   130→  // Get weight for an item in an era\n   131→  const getWeight = useCallback((itemId, eraId) => {\n   132→    const era = eras.find(e => e.id === eraId);\n   133→    if (!era) return null;\n   134→    const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n   135→    return weights?.[itemId] ?? null;\n   136→  }, [eras, viewMode]);\n   137→\n   138→  // Set weight for an item in an era\n   139→  const setWeight = useCallback((itemId, eraId, value) => {\n   140→    const newEras = eras.map(era => {\n   141→      if (era.id !== eraId) return era;\n   142→      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n   143→      const weights = {\n   144→        ...era[weightsKey]\n   145→      };\n   146→      if (value === null || value === \"\" || value === undefined) {\n   147→        delete weights[itemId];\n   148→      } else {\n   149→        weights[itemId] = parseFloat(value) || 0;\n   150→      }\n   151→      return {\n   152→        ...era,\n   153→        [weightsKey]: weights\n   154→      };\n   155→    });\n   156→    onErasChange(newEras);\n   157→  }, [eras, viewMode, onErasChange]);\n   158→\n   159→  // Handle cell click to start editing\n   160→  const handleCellClick = (rowId, eraId) => {\n   161→    const currentValue = getWeight(rowId, eraId);\n   162→    setEditingCell({\n   163→      rowId,\n   164→      eraId\n   165→    });\n   166→    setEditValue(currentValue !== null ? String(currentValue) : \"\");\n   167→    setTimeout(() => inputRef.current?.select(), 0);\n   168→  };\n   169→\n   170→  // Handle cell edit completion\n   171→  const handleCellBlur = () => {\n   172→    if (editingCell) {\n   173→      const value = editValue.trim();\n   174→      if (value === \"\") {\n   175→        setWeight(editingCell.rowId, editingCell.eraId, null);\n   176→      } else {\n   177→        const numValue = parseFloat(value);\n   178→        if (!isNaN(numValue)) {\n   179→          setWeight(editingCell.rowId, editingCell.eraId, numValue);\n   180→        }\n   181→      }\n   182→      setEditingCell(null);\n   183→    }\n   184→  };\n   185→\n   186→  // Handle keyboard navigation\n   187→  const handleKeyDown = e => {\n   188→    if (e.key === \"Enter\" || e.key === \"Tab\") {\n   189→      e.preventDefault();\n   190→      handleCellBlur();\n   191→    } else if (e.key === \"Escape\") {\n   192→      setEditingCell(null);\n   193→    }\n   194→  };\n   195→\n   196→  // Apply weight to all eras for a row\n   197→  const applyToAllEras = (itemId, value) => {\n   198→    const newEras = eras.map(era => {\n   199→      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n   200→      const weights = {\n   201→        ...era[weightsKey]\n   202→      };\n   203→      if (value === null || value === 0) {\n   204→        delete weights[itemId];\n   205→      } else {\n   206→        weights[itemId] = value;\n   207→      }\n   208→      return {\n   209→        ...era,\n   210→        [weightsKey]: weights\n   211→      };\n   212→    });\n   213→    onErasChange(newEras);\n   214→  };\n   215→\n   216→  // Copy row weights\n   217→  const copyRow = itemId => {\n   218→    const weights = {};\n   219→    eras.forEach(era => {\n   220→      const value = getWeight(itemId, era.id);\n   221→      if (value !== null) {\n   222→        weights[era.id] = value;\n   223→      }\n   224→    });\n   225→    setCopiedRow({\n   226→      id: itemId,\n   227→      weights\n   228→    });\n   229→  };\n   230→\n   231→  // Paste row weights\n   232→  const pasteRow = targetItemId => {\n   233→    if (!copiedRow) return;\n   234→    const newEras = eras.map(era => {\n   235→      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n   236→      const weights = {\n   237→        ...era[weightsKey]\n   238→      };\n   239→      if (copiedRow.weights[era.id] !== undefined) {\n   240→        weights[targetItemId] = copiedRow.weights[era.id];\n   241→      } else {\n   242→        delete weights[targetItemId];\n   243→      }\n   244→      return {\n   245→        ...era,\n   246→        [weightsKey]: weights\n   247→      };\n   248→    });\n   249→    onErasChange(newEras);\n   250→  };\n   251→\n   252→  // Remove from all eras\n   253→  const removeFromAllEras = itemId => {\n   254→    const newEras = eras.map(era => {\n   255→      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n   256→      const weights = {\n   257→        ...era[weightsKey]\n   258→      };\n   259→      delete weights[itemId];\n   260→      return {\n   261→        ...era,\n   262→        [weightsKey]: weights\n   263→      };\n   264→    });\n   265→    onErasChange(newEras);\n   266→  };\n   267→\n   268→  // Check if item is used in any era\n   269→  const isUsedInAnyEra = itemId => {\n   270→    return eras.some(era => {\n   271→      const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n   272→      return weights?.[itemId] !== undefined && weights[itemId] !== null;\n   273→    });\n   274→  };\n   275→\n   276→  // Count eras where item is active\n   277→  const countActiveEras = itemId => {\n   278→    return eras.filter(era => {\n   279→      const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n   280→      return weights?.[itemId] > 0;\n   281→    }).length;\n   282→  };\n   283→\n   284→  // Quick set weight for bulk operations\n   285→  const [quickSetValue, setQuickSetValue] = useState(1);\n   286→  const handleQuickSetSelected = () => {\n   287→    const value = quickSetValue ?? 0;\n   288→    selectedRows.forEach(itemId => {\n   289→      applyToAllEras(itemId, value);\n   290→    });\n   291→    setSelectedRows(new Set());\n   292→  };\n   293→  const toggleRowSelection = itemId => {\n   294→    const newSelection = new Set(selectedRows);\n   295→    if (newSelection.has(itemId)) {\n   296→      newSelection.delete(itemId);\n   297→    } else {\n   298→      newSelection.add(itemId);\n   299→    }\n   300→    setSelectedRows(newSelection);\n   301→  };\n   302→  const selectAllRows = () => {\n   303→    if (selectedRows.size === filteredItems.length) {\n   304→      setSelectedRows(new Set());\n   305→    } else {\n   306→      setSelectedRows(new Set(filteredItems.map(i => i.id)));\n   307→    }\n   308→  };\n   309→  return <div className=\"weight-matrix-editor\">\n   310→      <div className=\"header\">\n   311→        <h1 className=\"title\">Weight Matrix</h1>\n   312→        <p className=\"subtitle\">\n   313→          Manage {viewMode} weights across all eras in a spreadsheet view. Click any cell to edit,\n   314→          or use row actions for bulk operations.\n   315→        </p>\n   316→      </div>\n   317→\n   318→      {/* Orphaned References Warning */}\n   319→      {totalOrphans > 0 && <div className=\"orphan-warning\">\n   320→          <div className=\"orphan-warning-content\">\n   321→            <span className=\"orphan-warning-icon\">⚠️</span>\n   322→            <div className=\"orphan-warning-text\">\n   323→              <strong>\n   324→                {totalOrphans} orphaned reference{totalOrphans !== 1 ? \"s\" : \"\"} detected\n   325→              </strong>\n   326→              <span className=\"orphan-warning-details\">\n   327→                {orphanedReferences.generators.length > 0 && <span>\n   328→                    {orphanedReferences.generators.length} deleted generator\n   329→                    {orphanedReferences.generators.length !== 1 ? \"s\" : \"\"}\n   330→                  </span>}\n   331→                {orphanedReferences.generators.length > 0 && orphanedReferences.systems.length > 0 && \", \"}\n   332→                {orphanedReferences.systems.length > 0 && <span>\n   333→                    {orphanedReferences.systems.length} deleted system\n   334→                    {orphanedReferences.systems.length !== 1 ? \"s\" : \"\"}\n   335→                  </span>}\n   336→                {\" still referenced in eras\"}\n   337→              </span>\n   338→            </div>\n   339→          </div>\n   340→          <button className=\"btn btn-warning\" onClick={cleanupOrphanedReferences}>\n   341→            Clean Up All\n   342→          </button>\n   343→        </div>}\n   344→\n   345→      {/* Toolbar */}\n   346→      <div className=\"matrix-toolbar\">\n   347→        <div className=\"toolbar-left\">\n   348→          {/* View Mode Toggle */}\n   349→          <div className=\"view-toggle\">\n   350→            <button className={`toggle-btn ${viewMode === \"generators\" ? \"active\" : \"\"}`} onClick={() => setViewMode(\"generators\")}>\n   351→              Generators ({generators.length})\n   352→              {orphanedReferences.generators.length > 0 && viewMode !== \"generators\" && <span className=\"orphan-badge\">{orphanedReferences.generators.length}</span>}\n   353→            </button>\n   354→            <button className={`toggle-btn ${viewMode === \"systems\" ? \"active\" : \"\"}`} onClick={() => setViewMode(\"systems\")}>\n   355→              Systems ({systems.length})\n   356→              {orphanedReferences.systems.length > 0 && viewMode !== \"systems\" && <span className=\"orphan-badge\">{orphanedReferences.systems.length}</span>}\n   357→            </button>\n   358→          </div>\n   359→\n   360→          {/* Search */}\n   361→          <input type=\"text\" className=\"matrix-search\" placeholder=\"Search...\" value={searchQuery} onChange={e => setSearchQuery(e.target.value)} />\n   362→        </div>\n   363→\n   364→        <div className=\"toolbar-right\">\n   365→          {/* Bulk Actions */}\n   366→          {selectedRows.size > 0 && <div className=\"bulk-actions\">\n   367→              <span className=\"selection-count\">{selectedRows.size} selected</span>\n   368→              <NumberInput className=\"quick-set-input\" value={quickSetValue} onChange={setQuickSetValue} min={0} max={10} step={0.1} />\n   369→              <button className=\"btn btn-secondary\" onClick={handleQuickSetSelected}>\n   370→                Set All Eras\n   371→              </button>\n   372→              <button className=\"btn btn-ghost\" onClick={() => setSelectedRows(new Set())}>\n   373→                Clear\n   374→              </button>\n   375→            </div>}\n   376→\n   377→          {/* Paste indicator */}\n   378→          {copiedRow && <span className=\"copied-indicator\">Copied: {copiedRow.id}</span>}\n   379→        </div>\n   380→      </div>\n   381→\n   382→      {/* Matrix Grid */}\n   383→      <div className=\"matrix-container\">\n   384→        <table className=\"matrix-table\">\n   385→          <thead>\n   386→            <tr>\n   387→              <th className=\"checkbox-col\">\n   388→                <input type=\"checkbox\" checked={selectedRows.size === filteredItems.length && filteredItems.length > 0} onChange={selectAllRows} />\n   389→              </th>\n   390→              <th className=\"name-col\">{viewMode === \"generators\" ? \"Generator\" : \"System\"}</th>\n   391→              <th className=\"status-col\">Eras</th>\n   392→              {eras.map(era => <th key={era.id} className=\"era-col\" title={era.summary || era.name}>\n   393→                  {era.name || era.id}\n   394→                </th>)}\n   395→              <th className=\"actions-col\">Actions</th>\n   396→            </tr>\n   397→          </thead>\n   398→          <tbody>\n   399→            {filteredItems.length === 0 ? <tr>\n   400→                <td colSpan={eras.length + 4} className=\"empty-row\">\n   401→                  {searchQuery ? `No ${viewMode} match \"${searchQuery}\"` : `No ${viewMode} defined`}\n   402→                </td>\n   403→              </tr> : filteredItems.map(item => {\n   404→            const isUsed = isUsedInAnyEra(item.id);\n   405→            const activeCount = countActiveEras(item.id);\n   406→            return <tr key={item.id} className={`matrix-row ${!isUsed ? \"unused\" : \"\"} ${selectedRows.has(item.id) ? \"selected\" : \"\"}`}>\n   407→                    <td className=\"checkbox-col\">\n   408→                      <input type=\"checkbox\" checked={selectedRows.has(item.id)} onChange={() => toggleRowSelection(item.id)} />\n   409→                    </td>\n   410→                    <td className=\"name-col\">\n   411→                      <span className=\"item-name\" title={item.id}>\n   412→                        {item.name}\n   413→                      </span>\n   414→                      {item.type && viewMode === \"systems\" && <span className=\"item-type\">{item.type}</span>}\n   415→                    </td>\n   416→                    <td className=\"status-col\">\n   417→                      <span className={`era-count ${activeCount === 0 ? \"zero\" : \"\"}`}>\n   418→                        {activeCount}/{eras.length}\n   419→                      </span>\n   420→                    </td>\n   421→                    {eras.map(era => {\n   422→                const weight = getWeight(item.id, era.id);\n   423→                const isEditing = editingCell?.rowId === item.id && editingCell?.eraId === era.id;\n   424→                return <td key={era.id} className={`weight-cell weight-cell-${getHeatBucket(weight)} ${weight === null ? \"empty\" : \"\"}`} onClick={() => handleCellClick(item.id, era.id)}>\n   425→                          {isEditing ? <input ref={inputRef} type=\"text\" className=\"cell-input\" value={editValue} onChange={e => setEditValue(e.target.value)} onBlur={handleCellBlur} onKeyDown={handleKeyDown}\n   426→                  // eslint-disable-next-line jsx-a11y/no-autofocus\n   427→                  autoFocus /> : <span className={`cell-value cell-value-${weight === 0 || weight === undefined || weight === null ? \"muted\" : \"active\"}`}>\n   428→                              {weight !== null ? weight : \"-\"}\n   429→                            </span>}\n   430→                        </td>;\n   431→              })}\n   432→                    <td className=\"actions-col\">\n   433→                      <div className=\"row-actions\">\n   434→                        <button className=\"action-btn\" onClick={() => applyToAllEras(item.id, 1)} title=\"Add to all eras (weight 1)\">\n   435→                          +All\n   436→                        </button>\n   437→                        <button className=\"action-btn\" onClick={() => copyRow(item.id)} title=\"Copy weights\">\n   438→                          Copy\n   439→                        </button>\n   440→                        {copiedRow && copiedRow.id !== item.id && <button className=\"action-btn\" onClick={() => pasteRow(item.id)} title=\"Paste weights\">\n   441→                            Paste\n   442→                          </button>}\n   443→                        <button className=\"action-btn danger\" onClick={() => removeFromAllEras(item.id)} title=\"Remove from all eras\">\n   444→                          Clear\n   445→                        </button>\n   446→                      </div>\n   447→                    </td>\n   448→                  </tr>;\n   449→          })}\n   450→          </tbody>\n   451→        </table>\n   452→      </div>\n   453→\n   454→      {/* Legend */}\n   455→      <div className=\"matrix-legend\">\n   456→        <span className=\"legend-label\">Weight:</span>\n   457→        <div className=\"legend-scale\">\n   458→          <span className=\"legend-item weight-cell-none\">\n   459→            0\n   460→          </span>\n   461→          <span className=\"legend-item weight-cell-low\">\n   462→            2.5\n   463→          </span>\n   464→          <span className=\"legend-item weight-cell-mid\">\n   465→            5\n   466→          </span>\n   467→          <span className=\"legend-item weight-cell-high\">\n   468→            7.5\n   469→          </span>\n   470→          <span className=\"legend-item weight-cell-max\">\n   471→            10\n   472→          </span>\n   473→        </div>\n   474→        <span className=\"legend-note\">Click cell to edit. &quot;-&quot; = not assigned.</span>\n   475→      </div>\n   476→    </div>;\n   477→}\n   478→WeightMatrixEditor.propTypes = {\n   479→  generators: PropTypes.array,\n   480→  systems: PropTypes.array,\n   481→  eras: PropTypes.array,\n   482→  onErasChange: PropTypes.func.isRequired\n   483→};\n   484→"}]},"parent_tool_use_id":null,"session_id":"1e25f0ac-8e93-4dfd-8fc9-5da30702dc9f","uuid":"43a2e88f-9b41-4e55-909b-a90fd96a0d14","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/components/weight-matrix/WeightMatrixEditor.jsx","content":"/**\n * WeightMatrixEditor - Spreadsheet-style grid for managing generator/system weights across eras\n *\n * Features:\n * - Toggle between Generators and Systems view\n * - Heatmap coloring (darker = higher weight)\n * - Inline cell editing\n * - Bulk actions: apply to all eras, copy/paste rows\n * - Filter by name/tag\n * - Visual indicators for unassigned items\n */\n\nimport React, { useState, useMemo, useCallback, useRef } from \"react\";\nimport PropTypes from \"prop-types\";\nimport { NumberInput } from \"../shared\";\nimport \"./WeightMatrixEditor.css\";\n\n// Weight levels for heatmap coloring\n\nconst getHeatBucket = value => {\n  if (value === 0 || value === undefined || value === null) return \"none\";\n  if (value <= 2.5) return \"low\";\n  if (value <= 5) return \"mid\";\n  if (value <= 7.5) return \"high\";\n  return \"max\";\n};\nexport default function WeightMatrixEditor({\n  generators = [],\n  systems = [],\n  eras = [],\n  onErasChange\n}) {\n  const [viewMode, setViewMode] = useState(\"generators\"); // 'generators' | 'systems'\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [editingCell, setEditingCell] = useState(null); // shape: rowId + eraId\n  const [editValue, setEditValue] = useState(\"\");\n  const [selectedRows, setSelectedRows] = useState(new Set());\n  const [copiedRow, setCopiedRow] = useState(null); // { id, weights: { eraId: value } }\n  const inputRef = useRef(null);\n\n  // Get current items based on view mode\n  const items = useMemo(() => {\n    const source = viewMode === \"generators\" ? generators : systems;\n    return source.map(item => ({\n      id: viewMode === \"generators\" ? item.id : item.config.id,\n      name: viewMode === \"generators\" ? item.name || item.id : item.config.name || item.config.id,\n      type: viewMode === \"generators\" ? \"generator\" : item.systemType\n    }));\n  }, [viewMode, generators, systems]);\n\n  // Detect orphaned references - IDs in eras that don't exist in generators/systems\n  const orphanedReferences = useMemo(() => {\n    const generatorIds = new Set(generators.map(g => g.id));\n    const systemIds = new Set(systems.map(s => s.config.id));\n    const orphanedGenerators = [];\n    const orphanedSystems = [];\n    eras.forEach(era => {\n      // Check template weights\n      Object.keys(era.templateWeights || {}).forEach(id => {\n        if (!generatorIds.has(id)) {\n          orphanedGenerators.push({\n            id,\n            eraId: era.id,\n            eraName: era.name\n          });\n        }\n      });\n\n      // Check system modifiers\n      Object.keys(era.systemModifiers || {}).forEach(id => {\n        if (!systemIds.has(id)) {\n          orphanedSystems.push({\n            id,\n            eraId: era.id,\n            eraName: era.name\n          });\n        }\n      });\n    });\n    return {\n      generators: orphanedGenerators,\n      systems: orphanedSystems\n    };\n  }, [eras, generators, systems]);\n\n  // Count total orphans\n  const totalOrphans = orphanedReferences.generators.length + orphanedReferences.systems.length;\n\n  // Clean up all orphaned references\n  const cleanupOrphanedReferences = useCallback(() => {\n    const generatorIds = new Set(generators.map(g => g.id));\n    const systemIds = new Set(systems.map(s => s.config.id));\n    const newEras = eras.map(era => {\n      const newTemplateWeights = {\n        ...era.templateWeights\n      };\n      const newSystemModifiers = {\n        ...era.systemModifiers\n      };\n\n      // Remove orphaned generator references\n      Object.keys(newTemplateWeights).forEach(id => {\n        if (!generatorIds.has(id)) {\n          delete newTemplateWeights[id];\n        }\n      });\n\n      // Remove orphaned system references\n      Object.keys(newSystemModifiers).forEach(id => {\n        if (!systemIds.has(id)) {\n          delete newSystemModifiers[id];\n        }\n      });\n      return {\n        ...era,\n        templateWeights: newTemplateWeights,\n        systemModifiers: newSystemModifiers\n      };\n    });\n    onErasChange(newEras);\n  }, [eras, generators, systems, onErasChange]);\n\n  // Filter items by search\n  const filteredItems = useMemo(() => {\n    if (!searchQuery) return items;\n    const query = searchQuery.toLowerCase();\n    return items.filter(item => item.id.toLowerCase().includes(query) || item.name.toLowerCase().includes(query));\n  }, [items, searchQuery]);\n\n  // Get weight for an item in an era\n  const getWeight = useCallback((itemId, eraId) => {\n    const era = eras.find(e => e.id === eraId);\n    if (!era) return null;\n    const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n    return weights?.[itemId] ?? null;\n  }, [eras, viewMode]);\n\n  // Set weight for an item in an era\n  const setWeight = useCallback((itemId, eraId, value) => {\n    const newEras = eras.map(era => {\n      if (era.id !== eraId) return era;\n      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n      const weights = {\n        ...era[weightsKey]\n      };\n      if (value === null || value === \"\" || value === undefined) {\n        delete weights[itemId];\n      } else {\n        weights[itemId] = parseFloat(value) || 0;\n      }\n      return {\n        ...era,\n        [weightsKey]: weights\n      };\n    });\n    onErasChange(newEras);\n  }, [eras, viewMode, onErasChange]);\n\n  // Handle cell click to start editing\n  const handleCellClick = (rowId, eraId) => {\n    const currentValue = getWeight(rowId, eraId);\n    setEditingCell({\n      rowId,\n      eraId\n    });\n    setEditValue(currentValue !== null ? String(currentValue) : \"\");\n    setTimeout(() => inputRef.current?.select(), 0);\n  };\n\n  // Handle cell edit completion\n  const handleCellBlur = () => {\n    if (editingCell) {\n      const value = editValue.trim();\n      if (value === \"\") {\n        setWeight(editingCell.rowId, editingCell.eraId, null);\n      } else {\n        const numValue = parseFloat(value);\n        if (!isNaN(numValue)) {\n          setWeight(editingCell.rowId, editingCell.eraId, numValue);\n        }\n      }\n      setEditingCell(null);\n    }\n  };\n\n  // Handle keyboard navigation\n  const handleKeyDown = e => {\n    if (e.key === \"Enter\" || e.key === \"Tab\") {\n      e.preventDefault();\n      handleCellBlur();\n    } else if (e.key === \"Escape\") {\n      setEditingCell(null);\n    }\n  };\n\n  // Apply weight to all eras for a row\n  const applyToAllEras = (itemId, value) => {\n    const newEras = eras.map(era => {\n      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n      const weights = {\n        ...era[weightsKey]\n      };\n      if (value === null || value === 0) {\n        delete weights[itemId];\n      } else {\n        weights[itemId] = value;\n      }\n      return {\n        ...era,\n        [weightsKey]: weights\n      };\n    });\n    onErasChange(newEras);\n  };\n\n  // Copy row weights\n  const copyRow = itemId => {\n    const weights = {};\n    eras.forEach(era => {\n      const value = getWeight(itemId, era.id);\n      if (value !== null) {\n        weights[era.id] = value;\n      }\n    });\n    setCopiedRow({\n      id: itemId,\n      weights\n    });\n  };\n\n  // Paste row weights\n  const pasteRow = targetItemId => {\n    if (!copiedRow) return;\n    const newEras = eras.map(era => {\n      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n      const weights = {\n        ...era[weightsKey]\n      };\n      if (copiedRow.weights[era.id] !== undefined) {\n        weights[targetItemId] = copiedRow.weights[era.id];\n      } else {\n        delete weights[targetItemId];\n      }\n      return {\n        ...era,\n        [weightsKey]: weights\n      };\n    });\n    onErasChange(newEras);\n  };\n\n  // Remove from all eras\n  const removeFromAllEras = itemId => {\n    const newEras = eras.map(era => {\n      const weightsKey = viewMode === \"generators\" ? \"templateWeights\" : \"systemModifiers\";\n      const weights = {\n        ...era[weightsKey]\n      };\n      delete weights[itemId];\n      return {\n        ...era,\n        [weightsKey]: weights\n      };\n    });\n    onErasChange(newEras);\n  };\n\n  // Check if item is used in any era\n  const isUsedInAnyEra = itemId => {\n    return eras.some(era => {\n      const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n      return weights?.[itemId] !== undefined && weights[itemId] !== null;\n    });\n  };\n\n  // Count eras where item is active\n  const countActiveEras = itemId => {\n    return eras.filter(era => {\n      const weights = viewMode === \"generators\" ? era.templateWeights : era.systemModifiers;\n      return weights?.[itemId] > 0;\n    }).length;\n  };\n\n  // Quick set weight for bulk operations\n  const [quickSetValue, setQuickSetValue] = useState(1);\n  const handleQuickSetSelected = () => {\n    const value = quickSetValue ?? 0;\n    selectedRows.forEach(itemId => {\n      applyToAllEras(itemId, value);\n    });\n    setSelectedRows(new Set());\n  };\n  const toggleRowSelection = itemId => {\n    const newSelection = new Set(selectedRows);\n    if (newSelection.has(itemId)) {\n      newSelection.delete(itemId);\n    } else {\n      newSelection.add(itemId);\n    }\n    setSelectedRows(newSelection);\n  };\n  const selectAllRows = () => {\n    if (selectedRows.size === filteredItems.length) {\n      setSelectedRows(new Set());\n    } else {\n      setSelectedRows(new Set(filteredItems.map(i => i.id)));\n    }\n  };\n  return <div className=\"weight-matrix-editor\">\n      <div className=\"header\">\n        <h1 className=\"title\">Weight Matrix</h1>\n        <p className=\"subtitle\">\n          Manage {viewMode} weights across all eras in a spreadsheet view. Click any cell to edit,\n          or use row actions for bulk operations.\n        </p>\n      </div>\n\n      {/* Orphaned References Warning */}\n      {totalOrphans > 0 && <div className=\"orphan-warning\">\n          <div className=\"orphan-warning-content\">\n            <span className=\"orphan-warning-icon\">⚠️</span>\n            <div className=\"orphan-warning-text\">\n              <strong>\n                {totalOrphans} orphaned reference{totalOrphans !== 1 ? \"s\" : \"\"} detected\n              </strong>\n              <span className=\"orphan-warning-details\">\n                {orphanedReferences.generators.length > 0 && <span>\n                    {orphanedReferences.generators.length} deleted generator\n                    {orphanedReferences.generators.length !== 1 ? \"s\" : \"\"}\n                  </span>}\n                {orphanedReferences.generators.length > 0 && orphanedReferences.systems.length > 0 && \", \"}\n                {orphanedReferences.systems.length > 0 && <span>\n                    {orphanedReferences.systems.length} deleted system\n                    {orphanedReferences.systems.length !== 1 ? \"s\" : \"\"}\n                  </span>}\n                {\" still referenced in eras\"}\n              </span>\n            </div>\n          </div>\n          <button className=\"btn btn-warning\" onClick={cleanupOrphanedReferences}>\n            Clean Up All\n          </button>\n        </div>}\n\n      {/* Toolbar */}\n      <div className=\"matrix-toolbar\">\n        <div className=\"toolbar-left\">\n          {/* View Mode Toggle */}\n          <div className=\"view-toggle\">\n            <button className={`toggle-btn ${viewMode === \"generators\" ? \"active\" : \"\"}`} onClick={() => setViewMode(\"generators\")}>\n              Generators ({generators.length})\n              {orphanedReferences.generators.length > 0 && viewMode !== \"generators\" && <span className=\"orphan-badge\">{orphanedReferences.generators.length}</span>}\n            </button>\n            <button className={`toggle-btn ${viewMode === \"systems\" ? \"active\" : \"\"}`} onClick={() => setViewMode(\"systems\")}>\n              Systems ({systems.length})\n              {orphanedReferences.systems.length > 0 && viewMode !== \"systems\" && <span className=\"orphan-badge\">{orphanedReferences.systems.length}</span>}\n            </button>\n          </div>\n\n          {/* Search */}\n          <input type=\"text\" className=\"matrix-search\" placeholder=\"Search...\" value={searchQuery} onChange={e => setSearchQuery(e.target.value)} />\n        </div>\n\n        <div className=\"toolbar-right\">\n          {/* Bulk Actions */}\n          {selectedRows.size > 0 && <div className=\"bulk-actions\">\n              <span className=\"selection-count\">{selectedRows.size} selected</span>\n              <NumberInput className=\"quick-set-input\" value={quickSetValue} onChange={setQuickSetValue} min={0} max={10} step={0.1} />\n              <button className=\"btn btn-secondary\" onClick={handleQuickSetSelected}>\n                Set All Eras\n              </button>\n              <button className=\"btn btn-ghost\" onClick={() => setSelectedRows(new Set())}>\n                Clear\n              </button>\n            </div>}\n\n          {/* Paste indicator */}\n          {copiedRow && <span className=\"copied-indicator\">Copied: {copiedRow.id}</span>}\n        </div>\n      </div>\n\n      {/* Matrix Grid */}\n      <div className=\"matrix-container\">\n        <table className=\"matrix-table\">\n          <thead>\n            <tr>\n              <th className=\"checkbox-col\">\n                <input type=\"checkbox\" checked={selectedRows.size === filteredItems.length && filteredItems.length > 0} onChange={selectAllRows} />\n              </th>\n              <th className=\"name-col\">{viewMode === \"generators\" ? \"Generator\" : \"System\"}</th>\n              <th className=\"status-col\">Eras</th>\n              {eras.map(era => <th key={era.id} className=\"era-col\" title={era.summary || era.name}>\n                  {era.name || era.id}\n                </th>)}\n              <th className=\"actions-col\">Actions</th>\n            </tr>\n          </thead>\n          <tbody>\n            {filteredItems.length === 0 ? <tr>\n                <td colSpan={eras.length + 4} className=\"empty-row\">\n                  {searchQuery ? `No ${viewMode} match \"${searchQuery}\"` : `No ${viewMode} defined`}\n                </td>\n              </tr> : filteredItems.map(item => {\n            const isUsed = isUsedInAnyEra(item.id);\n            const activeCount = countActiveEras(item.id);\n            return <tr key={item.id} className={`matrix-row ${!isUsed ? \"unused\" : \"\"} ${selectedRows.has(item.id) ? \"selected\" : \"\"}`}>\n                    <td className=\"checkbox-col\">\n                      <input type=\"checkbox\" checked={selectedRows.has(item.id)} onChange={() => toggleRowSelection(item.id)} />\n                    </td>\n                    <td className=\"name-col\">\n                      <span className=\"item-name\" title={item.id}>\n                        {item.name}\n                      </span>\n                      {item.type && viewMode === \"systems\" && <span className=\"item-type\">{item.type}</span>}\n                    </td>\n                    <td className=\"status-col\">\n                      <span className={`era-count ${activeCount === 0 ? \"zero\" : \"\"}`}>\n                        {activeCount}/{eras.length}\n                      </span>\n                    </td>\n                    {eras.map(era => {\n                const weight = getWeight(item.id, era.id);\n                const isEditing = editingCell?.rowId === item.id && editingCell?.eraId === era.id;\n                return <td key={era.id} className={`weight-cell weight-cell-${getHeatBucket(weight)} ${weight === null ? \"empty\" : \"\"}`} onClick={() => handleCellClick(item.id, era.id)}>\n                          {isEditing ? <input ref={inputRef} type=\"text\" className=\"cell-input\" value={editValue} onChange={e => setEditValue(e.target.value)} onBlur={handleCellBlur} onKeyDown={handleKeyDown}\n                  // eslint-disable-next-line jsx-a11y/no-autofocus\n                  autoFocus /> : <span className={`cell-value cell-value-${weight === 0 || weight === undefined || weight === null ? \"muted\" : \"active\"}`}>\n                              {weight !== null ? weight : \"-\"}\n                            </span>}\n                        </td>;\n              })}\n                    <td className=\"actions-col\">\n                      <div className=\"row-actions\">\n                        <button className=\"action-btn\" onClick={() => applyToAllEras(item.id, 1)} title=\"Add to all eras (weight 1)\">\n                          +All\n                        </button>\n                        <button className=\"action-btn\" onClick={() => copyRow(item.id)} title=\"Copy weights\">\n                          Copy\n                        </button>\n                        {copiedRow && copiedRow.id !== item.id && <button className=\"action-btn\" onClick={() => pasteRow(item.id)} title=\"Paste weights\">\n                            Paste\n                          </button>}\n                        <button className=\"action-btn danger\" onClick={() => removeFromAllEras(item.id)} title=\"Remove from all eras\">\n                          Clear\n                        </button>\n                      </div>\n                    </td>\n                  </tr>;\n          })}\n          </tbody>\n        </table>\n      </div>\n\n      {/* Legend */}\n      <div className=\"matrix-legend\">\n        <span className=\"legend-label\">Weight:</span>\n        <div className=\"legend-scale\">\n          <span className=\"legend-item weight-cell-none\">\n            0\n          </span>\n          <span className=\"legend-item weight-cell-low\">\n            2.5\n          </span>\n          <span className=\"legend-item weight-cell-mid\">\n            5\n          </span>\n          <span className=\"legend-item weight-cell-high\">\n            7.5\n          </span>\n          <span className=\"legend-item weight-cell-max\">\n            10\n          </span>\n        </div>\n        <span className=\"legend-note\">Click cell to edit. &quot;-&quot; = not assigned.</span>\n      </div>\n    </div>;\n}\nWeightMatrixEditor.propTypes = {\n  generators: PropTypes.array,\n  systems: PropTypes.array,\n  eras: PropTypes.array,\n  onErasChange: PropTypes.func.isRequired\n};\n","numLines":484,"startLine":1,"totalLines":484}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01TckCYZCMT6nZdvr87Uz7ZG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JMK2noc4ZudckdsoMVLYhb","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/CoverageMatrix/CoverageMatrix.jsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1745,"cache_read_input_tokens":70279,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1745},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"1e25f0ac-8e93-4dfd-8fc9-5da30702dc9f","uuid":"8c045724-7cee-43de-8ae0-b5a9f1f55035"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JMK2noc4ZudckdsoMVLYhb","type":"tool_result","content":"     1→/**\n     2→ * CoverageMatrix - Generic matrix component for visualizing coverage/relationships\n     3→ *\n     4→ * A reusable spreadsheet-style grid that shows relationships between two sets of items.\n     5→ * Used for:\n     6→ * - Profiles × Entity Kinds (Name Forge)\n     7→ * - Relationship Kinds × Entity Kinds (Canonry)\n     8→ * - And other coverage/relationship visualizations\n     9→ *\n    10→ * Props:\n    11→ * - rows: Array of row items with { id, label, group?, groupLabel?, metadata? }\n    12→ * - columns: Array of column items (strings or { id, label })\n    13→ * - getCellValue: (rowId, columnId) => 'none' | 'primary' | 'secondary' | 'both' | custom string\n    14→ * - getCellDisplay: (value, rowId, columnId) => { icon, className, title }\n    15→ * - onRowClick: (rowId, row) => void\n    16→ * - onCellClick: (rowId, columnId, value) => void\n    17→ * - title: string\n    18→ * - subtitle: string\n    19→ * - stats: Array of { label, value, variant? }\n    20→ * - legend: Array of { icon, label, className }\n    21→ * - searchPlaceholder: string\n    22→ * - groupByField: string (optional, groups rows by this field)\n    23→ * - columnHeaderClass: (columnId) => string (optional, for styling column headers)\n    24→ */\n    25→\n    26→import React, { useState, useMemo, useCallback } from 'react';\n    27→import PropTypes from 'prop-types';\n    28→import './CoverageMatrix.css';\n    29→\n    30→function MatrixRow({ row, idx, groupId, groupLabel, columns, getCellValue, displayFn, onRowClick, onCellClick }) {\n    31→  const handleCellClick = useCallback((e, colId, value) => {\n    32→    if (onCellClick) {\n    33→      e.stopPropagation();\n    34→      onCellClick(row.id, colId, value);\n    35→    }\n    36→  }, [onCellClick, row.id]);\n    37→\n    38→  return (\n    39→    <tr\n    40→      className={`cm-row ${onRowClick ? 'clickable' : ''}`}\n    41→      onClick={() => onRowClick?.(row.id, row)}\n    42→    >\n    43→      <td className=\"cm-group-col\">\n    44→        {idx === 0 && groupId !== '_ungrouped' ? (\n    45→          <span className=\"cm-group-name\">{groupLabel}</span>\n    46→        ) : null}\n    47→      </td>\n    48→      <td className=\"cm-label-col\">\n    49→        <span className=\"cm-item-label\">{row.label}</span>\n    50→      </td>\n    51→      <td className=\"cm-status-col\">\n    52→        {row.statusBadges?.map((badge, i) => (\n    53→          <span key={i} className={`cm-badge ${badge.variant || ''}`}>\n    54→            {badge.label}\n    55→          </span>\n    56→        ))}\n    57→      </td>\n    58→      {columns.map((col) => {\n    59→        const value = getCellValue(row.id, col.id, row);\n    60→        const display = displayFn(value, row.id, col.id);\n    61→        return (\n    62→          <td\n    63→            key={col.id}\n    64→            className={`cm-cell ${display.className || ''}`}\n    65→            title={display.title}\n    66→            onClick={(e) => handleCellClick(e, col.id, value)}\n    67→          >\n    68→            <span className=\"cm-cell-icon\">{display.icon}</span>\n    69→          </td>\n    70→        );\n    71→      })}\n    72→    </tr>\n    73→  );\n    74→}\n    75→\n    76→MatrixRow.propTypes = {\n    77→  row: PropTypes.object.isRequired,\n    78→  idx: PropTypes.number.isRequired,\n    79→  groupId: PropTypes.string.isRequired,\n    80→  groupLabel: PropTypes.string.isRequired,\n    81→  columns: PropTypes.array.isRequired,\n    82→  getCellValue: PropTypes.func.isRequired,\n    83→  displayFn: PropTypes.func.isRequired,\n    84→  onRowClick: PropTypes.func,\n    85→  onCellClick: PropTypes.func,\n    86→};\n    87→\n    88→export default function CoverageMatrix({\n    89→  rows = [],\n    90→  columns = [],\n    91→  getCellValue,\n    92→  getCellDisplay,\n    93→  onRowClick,\n    94→  onCellClick,\n    95→  title = 'Coverage Matrix',\n    96→  subtitle = '',\n    97→  stats = [],\n    98→  legend = [],\n    99→  searchPlaceholder = 'Search...',\n   100→  groupByField = 'group',\n   101→  columnHeaderClass,\n   102→  emptyMessage = 'No data to display.',\n   103→  filterOptions = [],\n   104→}) {\n   105→  const [searchQuery, setSearchQuery] = useState('');\n   106→  const [activeFilter, setActiveFilter] = useState(null);\n   107→\n   108→  // Normalize columns to { id, label } format\n   109→  const normalizedColumns = useMemo(() => {\n   110→    return columns.map((col) =>\n   111→      typeof col === 'string' ? { id: col, label: col } : col\n   112→    );\n   113→  }, [columns]);\n   114→\n   115→  // Filter rows by search\n   116→  const filteredRows = useMemo(() => {\n   117→    let result = rows;\n   118→\n   119→    if (searchQuery) {\n   120→      const query = searchQuery.toLowerCase();\n   121→      result = result.filter(\n   122→        (row) =>\n   123→          row.id.toLowerCase().includes(query) ||\n   124→          row.label.toLowerCase().includes(query) ||\n   125→          (row.groupLabel && row.groupLabel.toLowerCase().includes(query))\n   126→      );\n   127→    }\n   128→\n   129→    if (activeFilter && filterOptions.length > 0) {\n   130→      const filterDef = filterOptions.find((f) => f.id === activeFilter);\n   131→      if (filterDef?.filter) {\n   132→        result = result.filter(filterDef.filter);\n   133→      }\n   134→    }\n   135→\n   136→    return result;\n   137→  }, [rows, searchQuery, activeFilter, filterOptions]);\n   138→\n   139→  // Group rows if groupByField is specified\n   140→  const groupedRows = useMemo(() => {\n   141→    if (!groupByField) {\n   142→      return { _ungrouped: { label: '', rows: filteredRows } };\n   143→    }\n   144→\n   145→    const groups = {};\n   146→    filteredRows.forEach((row) => {\n   147→      const groupId = row[groupByField] || '_ungrouped';\n   148→      const groupLabel = row.groupLabel || groupId;\n   149→      if (!groups[groupId]) {\n   150→        groups[groupId] = { label: groupLabel, rows: [] };\n   151→      }\n   152→      groups[groupId].rows.push(row);\n   153→    });\n   154→    return groups;\n   155→  }, [filteredRows, groupByField]);\n   156→\n   157→  // Default cell display function\n   158→  const defaultGetCellDisplay = (value) => {\n   159→    switch (value) {\n   160→      case 'primary':\n   161→        return { icon: '✓', className: 'primary', title: 'Primary' };\n   162→      case 'secondary':\n   163→        return { icon: '○', className: 'secondary', title: 'Secondary' };\n   164→      case 'both':\n   165→        return { icon: '◉', className: 'both', title: 'Both' };\n   166→      case 'none':\n   167→      default:\n   168→        return { icon: '-', className: 'none', title: 'None' };\n   169→    }\n   170→  };\n   171→\n   172→  const displayFn = getCellDisplay || defaultGetCellDisplay;\n   173→\n   174→  return (\n   175→    <div className=\"coverage-matrix\">\n   176→      {/* Header */}\n   177→      <div className=\"cm-header\">\n   178→        <h2 className=\"cm-title\">{title}</h2>\n   179→        {subtitle && <p className=\"cm-subtitle\">{subtitle}</p>}\n   180→      </div>\n   181→\n   182→      {/* Stats Bar */}\n   183→      {stats.length > 0 && (\n   184→        <div className=\"cm-stats\">\n   185→          {stats.map((stat, idx) => (\n   186→            <div key={idx} className={`cm-stat ${stat.variant || ''}`}>\n   187→              <span className=\"cm-stat-value\">{stat.value}</span>\n   188→              <span className=\"cm-stat-label\">{stat.label}</span>\n   189→            </div>\n   190→          ))}\n   191→        </div>\n   192→      )}\n   193→\n   194→      {/* Toolbar */}\n   195→      <div className=\"cm-toolbar\">\n   196→        <input\n   197→          type=\"text\"\n   198→          className=\"cm-search\"\n   199→          placeholder={searchPlaceholder}\n   200→          value={searchQuery}\n   201→          onChange={(e) => setSearchQuery(e.target.value)}\n   202→        />\n   203→        {filterOptions.length > 0 && (\n   204→          <div className=\"cm-filters\">\n   205→            {filterOptions.map((filter) => (\n   206→              <button\n   207→                key={filter.id}\n   208→                className={`cm-filter-btn ${activeFilter === filter.id ? 'active' : ''}`}\n   209→                onClick={() =>\n   210→                  setActiveFilter(activeFilter === filter.id ? null : filter.id)\n   211→                }\n   212→              >\n   213→                {filter.label}\n   214→              </button>\n   215→            ))}\n   216→          </div>\n   217→        )}\n   218→      </div>\n   219→\n   220→      {/* Matrix Grid */}\n   221→      <div className=\"cm-container\">\n   222→        {(normalizedColumns.length === 0 || rows.length === 0) && (\n   223→          <div className=\"cm-empty\">{emptyMessage}</div>\n   224→        )}\n   225→        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length === 0 && (\n   226→          <div className=\"cm-empty\">No items match the current filters.</div>\n   227→        )}\n   228→        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length > 0 && (\n   229→          <table className=\"cm-table\">\n   230→            <thead>\n   231→              <tr>\n   232→                <th className=\"cm-group-col\">Group</th>\n   233→                <th className=\"cm-label-col\">Name</th>\n   234→                <th className=\"cm-status-col\">Status</th>\n   235→                {normalizedColumns.map((col) => (\n   236→                  <th\n   237→                    key={col.id}\n   238→                    className={`cm-data-col ${columnHeaderClass?.(col.id) || ''}`}\n   239→                    title={col.label}\n   240→                  >\n   241→                    {col.label}\n   242→                  </th>\n   243→                ))}\n   244→              </tr>\n   245→            </thead>\n   246→            <tbody>\n   247→              {Object.entries(groupedRows).map(([groupId, { label: groupLabel, rows: groupRows }]) =>\n   248→                groupRows.map((row, idx) => (\n   249→                  <MatrixRow\n   250→                    key={row.id}\n   251→                    row={row}\n   252→                    idx={idx}\n   253→                    groupId={groupId}\n   254→                    groupLabel={groupLabel}\n   255→                    columns={normalizedColumns}\n   256→                    getCellValue={getCellValue}\n   257→                    displayFn={displayFn}\n   258→                    onRowClick={onRowClick}\n   259→                    onCellClick={onCellClick}\n   260→                  />\n   261→                ))\n   262→              )}\n   263→            </tbody>\n   264→          </table>\n   265→        )}\n   266→      </div>\n   267→\n   268→      {/* Legend */}\n   269→      {legend.length > 0 && (\n   270→        <div className=\"cm-legend\">\n   271→          {legend.map((item, idx) => (\n   272→            <span key={idx} className=\"cm-legend-item\">\n   273→              <span className={`cm-cell-icon sample ${item.className || ''}`}>\n   274→                {item.icon}\n   275→              </span>\n   276→              {item.label}\n   277→            </span>\n   278→          ))}\n   279→        </div>\n   280→      )}\n   281→    </div>\n   282→  );\n   283→}\n   284→\n   285→CoverageMatrix.propTypes = {\n   286→  rows: PropTypes.array,\n   287→  columns: PropTypes.array,\n   288→  getCellValue: PropTypes.func.isRequired,\n   289→  getCellDisplay: PropTypes.func,\n   290→  onRowClick: PropTypes.func,\n   291→  onCellClick: PropTypes.func,\n   292→  title: PropTypes.string,\n   293→  subtitle: PropTypes.string,\n   294→  stats: PropTypes.array,\n   295→  legend: PropTypes.array,\n   296→  searchPlaceholder: PropTypes.string,\n   297→  groupByField: PropTypes.string,\n   298→  columnHeaderClass: PropTypes.func,\n   299→  emptyMessage: PropTypes.string,\n   300→  filterOptions: PropTypes.array,\n   301→};\n   302→"}]},"parent_tool_use_id":null,"session_id":"1e25f0ac-8e93-4dfd-8fc9-5da30702dc9f","uuid":"2e6bdbb4-3c10-4cf2-9bc9-71fe014f6f3f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/CoverageMatrix/CoverageMatrix.jsx","content":"/**\n * CoverageMatrix - Generic matrix component for visualizing coverage/relationships\n *\n * A reusable spreadsheet-style grid that shows relationships between two sets of items.\n * Used for:\n * - Profiles × Entity Kinds (Name Forge)\n * - Relationship Kinds × Entity Kinds (Canonry)\n * - And other coverage/relationship visualizations\n *\n * Props:\n * - rows: Array of row items with { id, label, group?, groupLabel?, metadata? }\n * - columns: Array of column items (strings or { id, label })\n * - getCellValue: (rowId, columnId) => 'none' | 'primary' | 'secondary' | 'both' | custom string\n * - getCellDisplay: (value, rowId, columnId) => { icon, className, title }\n * - onRowClick: (rowId, row) => void\n * - onCellClick: (rowId, columnId, value) => void\n * - title: string\n * - subtitle: string\n * - stats: Array of { label, value, variant? }\n * - legend: Array of { icon, label, className }\n * - searchPlaceholder: string\n * - groupByField: string (optional, groups rows by this field)\n * - columnHeaderClass: (columnId) => string (optional, for styling column headers)\n */\n\nimport React, { useState, useMemo, useCallback } from 'react';\nimport PropTypes from 'prop-types';\nimport './CoverageMatrix.css';\n\nfunction MatrixRow({ row, idx, groupId, groupLabel, columns, getCellValue, displayFn, onRowClick, onCellClick }) {\n  const handleCellClick = useCallback((e, colId, value) => {\n    if (onCellClick) {\n      e.stopPropagation();\n      onCellClick(row.id, colId, value);\n    }\n  }, [onCellClick, row.id]);\n\n  return (\n    <tr\n      className={`cm-row ${onRowClick ? 'clickable' : ''}`}\n      onClick={() => onRowClick?.(row.id, row)}\n    >\n      <td className=\"cm-group-col\">\n        {idx === 0 && groupId !== '_ungrouped' ? (\n          <span className=\"cm-group-name\">{groupLabel}</span>\n        ) : null}\n      </td>\n      <td className=\"cm-label-col\">\n        <span className=\"cm-item-label\">{row.label}</span>\n      </td>\n      <td className=\"cm-status-col\">\n        {row.statusBadges?.map((badge, i) => (\n          <span key={i} className={`cm-badge ${badge.variant || ''}`}>\n            {badge.label}\n          </span>\n        ))}\n      </td>\n      {columns.map((col) => {\n        const value = getCellValue(row.id, col.id, row);\n        const display = displayFn(value, row.id, col.id);\n        return (\n          <td\n            key={col.id}\n            className={`cm-cell ${display.className || ''}`}\n            title={display.title}\n            onClick={(e) => handleCellClick(e, col.id, value)}\n          >\n            <span className=\"cm-cell-icon\">{display.icon}</span>\n          </td>\n        );\n      })}\n    </tr>\n  );\n}\n\nMatrixRow.propTypes = {\n  row: PropTypes.object.isRequired,\n  idx: PropTypes.number.isRequired,\n  groupId: PropTypes.string.isRequired,\n  groupLabel: PropTypes.string.isRequired,\n  columns: PropTypes.array.isRequired,\n  getCellValue: PropTypes.func.isRequired,\n  displayFn: PropTypes.func.isRequired,\n  onRowClick: PropTypes.func,\n  onCellClick: PropTypes.func,\n};\n\nexport default function CoverageMatrix({\n  rows = [],\n  columns = [],\n  getCellValue,\n  getCellDisplay,\n  onRowClick,\n  onCellClick,\n  title = 'Coverage Matrix',\n  subtitle = '',\n  stats = [],\n  legend = [],\n  searchPlaceholder = 'Search...',\n  groupByField = 'group',\n  columnHeaderClass,\n  emptyMessage = 'No data to display.',\n  filterOptions = [],\n}) {\n  const [searchQuery, setSearchQuery] = useState('');\n  const [activeFilter, setActiveFilter] = useState(null);\n\n  // Normalize columns to { id, label } format\n  const normalizedColumns = useMemo(() => {\n    return columns.map((col) =>\n      typeof col === 'string' ? { id: col, label: col } : col\n    );\n  }, [columns]);\n\n  // Filter rows by search\n  const filteredRows = useMemo(() => {\n    let result = rows;\n\n    if (searchQuery) {\n      const query = searchQuery.toLowerCase();\n      result = result.filter(\n        (row) =>\n          row.id.toLowerCase().includes(query) ||\n          row.label.toLowerCase().includes(query) ||\n          (row.groupLabel && row.groupLabel.toLowerCase().includes(query))\n      );\n    }\n\n    if (activeFilter && filterOptions.length > 0) {\n      const filterDef = filterOptions.find((f) => f.id === activeFilter);\n      if (filterDef?.filter) {\n        result = result.filter(filterDef.filter);\n      }\n    }\n\n    return result;\n  }, [rows, searchQuery, activeFilter, filterOptions]);\n\n  // Group rows if groupByField is specified\n  const groupedRows = useMemo(() => {\n    if (!groupByField) {\n      return { _ungrouped: { label: '', rows: filteredRows } };\n    }\n\n    const groups = {};\n    filteredRows.forEach((row) => {\n      const groupId = row[groupByField] || '_ungrouped';\n      const groupLabel = row.groupLabel || groupId;\n      if (!groups[groupId]) {\n        groups[groupId] = { label: groupLabel, rows: [] };\n      }\n      groups[groupId].rows.push(row);\n    });\n    return groups;\n  }, [filteredRows, groupByField]);\n\n  // Default cell display function\n  const defaultGetCellDisplay = (value) => {\n    switch (value) {\n      case 'primary':\n        return { icon: '✓', className: 'primary', title: 'Primary' };\n      case 'secondary':\n        return { icon: '○', className: 'secondary', title: 'Secondary' };\n      case 'both':\n        return { icon: '◉', className: 'both', title: 'Both' };\n      case 'none':\n      default:\n        return { icon: '-', className: 'none', title: 'None' };\n    }\n  };\n\n  const displayFn = getCellDisplay || defaultGetCellDisplay;\n\n  return (\n    <div className=\"coverage-matrix\">\n      {/* Header */}\n      <div className=\"cm-header\">\n        <h2 className=\"cm-title\">{title}</h2>\n        {subtitle && <p className=\"cm-subtitle\">{subtitle}</p>}\n      </div>\n\n      {/* Stats Bar */}\n      {stats.length > 0 && (\n        <div className=\"cm-stats\">\n          {stats.map((stat, idx) => (\n            <div key={idx} className={`cm-stat ${stat.variant || ''}`}>\n              <span className=\"cm-stat-value\">{stat.value}</span>\n              <span className=\"cm-stat-label\">{stat.label}</span>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Toolbar */}\n      <div className=\"cm-toolbar\">\n        <input\n          type=\"text\"\n          className=\"cm-search\"\n          placeholder={searchPlaceholder}\n          value={searchQuery}\n          onChange={(e) => setSearchQuery(e.target.value)}\n        />\n        {filterOptions.length > 0 && (\n          <div className=\"cm-filters\">\n            {filterOptions.map((filter) => (\n              <button\n                key={filter.id}\n                className={`cm-filter-btn ${activeFilter === filter.id ? 'active' : ''}`}\n                onClick={() =>\n                  setActiveFilter(activeFilter === filter.id ? null : filter.id)\n                }\n              >\n                {filter.label}\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Matrix Grid */}\n      <div className=\"cm-container\">\n        {(normalizedColumns.length === 0 || rows.length === 0) && (\n          <div className=\"cm-empty\">{emptyMessage}</div>\n        )}\n        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length === 0 && (\n          <div className=\"cm-empty\">No items match the current filters.</div>\n        )}\n        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length > 0 && (\n          <table className=\"cm-table\">\n            <thead>\n              <tr>\n                <th className=\"cm-group-col\">Group</th>\n                <th className=\"cm-label-col\">Name</th>\n                <th className=\"cm-status-col\">Status</th>\n                {normalizedColumns.map((col) => (\n                  <th\n                    key={col.id}\n                    className={`cm-data-col ${columnHeaderClass?.(col.id) || ''}`}\n                    title={col.label}\n                  >\n                    {col.label}\n                  </th>\n                ))}\n              </tr>\n            </thead>\n            <tbody>\n              {Object.entries(groupedRows).map(([groupId, { label: groupLabel, rows: groupRows }]) =>\n                groupRows.map((row, idx) => (\n                  <MatrixRow\n                    key={row.id}\n                    row={row}\n                    idx={idx}\n                    groupId={groupId}\n                    groupLabel={groupLabel}\n                    columns={normalizedColumns}\n                    getCellValue={getCellValue}\n                    displayFn={displayFn}\n                    onRowClick={onRowClick}\n                    onCellClick={onCellClick}\n                  />\n                ))\n              )}\n            </tbody>\n          </table>\n        )}\n      </div>\n\n      {/* Legend */}\n      {legend.length > 0 && (\n        <div className=\"cm-legend\">\n          {legend.map((item, idx) => (\n            <span key={idx} className=\"cm-legend-item\">\n              <span className={`cm-cell-icon sample ${item.className || ''}`}>\n                {item.icon}\n              </span>\n              {item.label}\n            </span>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\nCoverageMatrix.propTypes = {\n  rows: PropTypes.array,\n  columns: PropTypes.array,\n  getCellValue: PropTypes.func.isRequired,\n  getCellDisplay: PropTypes.func,\n  onRowClick: PropTypes.func,\n  onCellClick: PropTypes.func,\n  title: PropTypes.string,\n  subtitle: PropTypes.string,\n  stats: PropTypes.array,\n  legend: PropTypes.array,\n  searchPlaceholder: PropTypes.string,\n  groupByField: PropTypes.string,\n  columnHeaderClass: PropTypes.func,\n  emptyMessage: PropTypes.string,\n  filterOptions: PropTypes.array,\n};\n","numLines":302,"startLine":1,"totalLines":302}}}
