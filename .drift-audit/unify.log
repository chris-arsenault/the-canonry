{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TtC4gt4hQ3NH1LuXfZtyPd","type":"tool_result","content":"     1→/**\n     2→ * StyleSelector - Select artistic, composition, and color palette styles for image generation\n     3→ *\n     4→ * Three dropdowns for style selection:\n     5→ * - Artistic style (oil painting, watercolor, digital art, etc.)\n     6→ * - Composition style (portrait, full body, establishing shot, etc.)\n     7→ * - Color palette (warm earth, jewel tones, sunset fire, etc.)\n     8→ *\n     9→ * Supports:\n    10→ * - \"Random\" option (default) - picks a random style at generation time\n    11→ * - \"None\" - no style/composition constraint, let the prompt decide\n    12→ */\n    13→\n    14→import React, { useMemo, useId } from \"react\";\n    15→import PropTypes from \"prop-types\";\n    16→import { DEFAULT_RANDOM_EXCLUSIONS } from \"@canonry/world-schema\";\n    17→import \"./StyleSelector.css\";\n    18→\n    19→const RANDOM_ID = \"random\";\n    20→const NONE_ID = \"none\";\n    21→\n    22→/**\n    23→ * Category display names for grouping compositions\n    24→ */\n    25→const CATEGORY_LABELS = {\n    26→  character: \"Character\",\n    27→  collective: \"Collective\",\n    28→  place: \"Place\",\n    29→  object: \"Object\",\n    30→  concept: \"Concept\",\n    31→  power: \"Power\",\n    32→  era: \"Era\",\n    33→  event: \"Event\",\n    34→};\n    35→\n    36→/**\n    37→ * Order for displaying category groups\n    38→ */\n    39→const CATEGORY_ORDER = [\n    40→  \"character\",\n    41→  \"collective\",\n    42→  \"place\",\n    43→  \"object\",\n    44→  \"concept\",\n    45→  \"power\",\n    46→  \"era\",\n    47→  \"event\",\n    48→];\n    49→\n    50→/**\n    51→ * Group composition styles by targetCategory\n    52→ * Returns an array of { category, label, styles } objects in display order\n    53→ */\n    54→function groupCompositionsByCategory(styles) {\n    55→  const grouped = new Map();\n    56→  const uncategorized = [];\n    57→\n    58→  for (const style of styles) {\n    59→    const category = style.targetCategory;\n    60→    if (category && CATEGORY_LABELS[category]) {\n    61→      if (!grouped.has(category)) {\n    62→        grouped.set(category, []);\n    63→      }\n    64→      grouped.get(category).push(style);\n    65→    } else {\n    66→      uncategorized.push(style);\n    67→    }\n    68→  }\n    69→\n    70→  // Build result in category order\n    71→  const result = [];\n    72→  for (const category of CATEGORY_ORDER) {\n    73→    const categoryStyles = grouped.get(category);\n    74→    if (categoryStyles && categoryStyles.length > 0) {\n    75→      result.push({\n    76→        category,\n    77→        label: CATEGORY_LABELS[category],\n    78→        styles: categoryStyles,\n    79→      });\n    80→    }\n    81→  }\n    82→\n    83→  // Add uncategorized at the end if any\n    84→  if (uncategorized.length > 0) {\n    85→    result.push({\n    86→      category: \"other\",\n    87→      label: \"Other\",\n    88→      styles: uncategorized,\n    89→    });\n    90→  }\n    91→\n    92→  return result;\n    93→}\n    94→\n    95→export default function StyleSelector({\n    96→  styleLibrary,\n    97→  selectedArtisticStyleId,\n    98→  selectedCompositionStyleId,\n    99→  selectedColorPaletteId,\n   100→  onArtisticStyleChange,\n   101→  onCompositionStyleChange,\n   102→  onColorPaletteChange,\n   103→  entityKind,\n   104→  compact = false,\n   105→}) {\n   106→  const compositionId = useId();\n   107→  const artisticStyles = styleLibrary?.artisticStyles || [];\n   108→  const compositionStyles = styleLibrary?.compositionStyles || [];\n   109→  const colorPalettes = styleLibrary?.colorPalettes || [];\n   110→\n   111→  // Filter composition styles based on entity kind (legacy suitableForKinds)\n   112→  const filteredCompositionStyles = useMemo(() => {\n   113→    if (!entityKind) {\n   114→      return compositionStyles;\n   115→    }\n   116→    return compositionStyles.filter(\n   117→      (s) =>\n   118→        !s.suitableForKinds ||\n   119→        s.suitableForKinds.length === 0 ||\n   120→        s.suitableForKinds.includes(entityKind)\n   121→    );\n   122→  }, [compositionStyles, entityKind]);\n   123→\n   124→  // Group compositions by targetCategory for organized display\n   125→  const groupedCompositions = useMemo(() => {\n   126→    return groupCompositionsByCategory(filteredCompositionStyles);\n   127→  }, [filteredCompositionStyles]);\n   128→\n   129→  const selectedArtistic = artisticStyles.find((s) => s.id === selectedArtisticStyleId);\n   130→  const selectedComposition = compositionStyles.find((s) => s.id === selectedCompositionStyleId);\n   131→  const selectedColorPalette = colorPalettes.find((s) => s.id === selectedColorPaletteId);\n   132→\n   133→  if (compact) {\n   134→    return (\n   135→      <div className=\"stsel-compact\">\n   136→        <span className=\"stsel-compact-label\">Style:</span>\n   137→        <select\n   138→          value={selectedArtisticStyleId || RANDOM_ID}\n   139→          onChange={(e) => onArtisticStyleChange(e.target.value || RANDOM_ID)}\n   140→          className=\"illuminator-select stsel-compact-select\"\n   141→          title={selectedArtistic?.description || \"Select artistic style\"}\n   142→        >\n   143→          <option value={RANDOM_ID}>Random</option>\n   144→          <option value={NONE_ID}>None</option>\n   145→          {artisticStyles.map((style) => (\n   146→            <option key={style.id} value={style.id}>\n   147→              {style.name}\n   148→            </option>\n   149→          ))}\n   150→        </select>\n   151→\n   152→        <select\n   153→          value={selectedCompositionStyleId || RANDOM_ID}\n   154→          onChange={(e) => onCompositionStyleChange(e.target.value || RANDOM_ID)}\n   155→          className=\"illuminator-select stsel-compact-select\"\n   156→          title={selectedComposition?.description || \"Select composition style\"}\n   157→        >\n   158→          <option value={RANDOM_ID}>Random</option>\n   159→          <option value={NONE_ID}>None</option>\n   160→          {groupedCompositions.map((group) => (\n   161→            <optgroup key={group.category} label={group.label}>\n   162→              {group.styles.map((style) => (\n   163→                <option key={style.id} value={style.id}>\n   164→                  {style.name}\n   165→                </option>\n   166→              ))}\n   167→            </optgroup>\n   168→          ))}\n   169→        </select>\n   170→\n   171→        <select\n   172→          value={selectedColorPaletteId || RANDOM_ID}\n   173→          onChange={(e) => onColorPaletteChange(e.target.value || RANDOM_ID)}\n   174→          className=\"illuminator-select stsel-compact-select\"\n   175→          title={selectedColorPalette?.description || \"Select color palette\"}\n   176→        >\n   177→          <option value={RANDOM_ID}>Random</option>\n   178→          <option value={NONE_ID}>None</option>\n   179→          {colorPalettes.map((palette) => (\n   180→            <option key={palette.id} value={palette.id}>\n   181→              {palette.name}\n   182→            </option>\n   183→          ))}\n   184→        </select>\n   185→      </div>\n   186→    );\n   187→  }\n   188→\n   189→  return (\n   190→    <div className=\"stsel-grid\">\n   191→      {/* Artistic Style */}\n   192→      <div>\n   193→        <label htmlFor=\"artistic-style\" className=\"stsel-label\">Artistic Style</label>\n   194→        <select id=\"artistic-style\"\n   195→          value={selectedArtisticStyleId || RANDOM_ID}\n   196→          onChange={(e) => onArtisticStyleChange(e.target.value || RANDOM_ID)}\n   197→          className=\"illuminator-select\"\n   198→        >\n   199→          <option value={RANDOM_ID}>Random</option>\n   200→          <option value={NONE_ID}>None</option>\n   201→          {artisticStyles.map((style) => (\n   202→            <option key={style.id} value={style.id}>\n   203→              {style.name}\n   204→            </option>\n   205→          ))}\n   206→        </select>\n   207→        {selectedArtistic && (\n   208→          <div className=\"stsel-description\">{selectedArtistic.description}</div>\n   209→        )}\n   210→      </div>\n   211→\n   212→      {/* Composition Style */}\n   213→      <div>\n   214→        <label htmlFor={compositionId} className=\"stsel-label\">\n   215→          Composition Style{entityKind && ` (for ${entityKind})`}\n   216→        </label>\n   217→        <select id={compositionId}\n   218→          value={selectedCompositionStyleId || RANDOM_ID}\n   219→          onChange={(e) => onCompositionStyleChange(e.target.value || RANDOM_ID)}\n   220→          className=\"illuminator-select\"\n   221→        >\n   222→          <option value={RANDOM_ID}>Random</option>\n   223→          <option value={NONE_ID}>None</option>\n   224→          {groupedCompositions.map((group) => (\n   225→            <optgroup key={group.category} label={group.label}>\n   226→              {group.styles.map((style) => (\n   227→                <option key={style.id} value={style.id}>\n   228→                  {style.name}\n   229→                </option>\n   230→              ))}\n   231→            </optgroup>\n   232→          ))}\n   233→        </select>\n   234→        {selectedComposition && (\n   235→          <div className=\"stsel-description\">{selectedComposition.description}</div>\n   236→        )}\n   237→      </div>\n   238→\n   239→      {/* Color Palette */}\n   240→      <div>\n   241→        <label htmlFor=\"color-palette\" className=\"stsel-label\">Color Palette</label>\n   242→        <select id=\"color-palette\"\n   243→          value={selectedColorPaletteId || RANDOM_ID}\n   244→          onChange={(e) => onColorPaletteChange(e.target.value || RANDOM_ID)}\n   245→          className=\"illuminator-select\"\n   246→        >\n   247→          <option value={RANDOM_ID}>Random</option>\n   248→          <option value={NONE_ID}>None</option>\n   249→          {colorPalettes.map((palette) => (\n   250→            <option key={palette.id} value={palette.id}>\n   251→              {palette.name}\n   252→            </option>\n   253→          ))}\n   254→        </select>\n   255→        {selectedColorPalette && (\n   256→          <div className=\"stsel-description\">{selectedColorPalette.description}</div>\n   257→        )}\n   258→      </div>\n   259→    </div>\n   260→  );\n   261→}\n   262→\n   263→/**\n   264→ * Pick a random element from an array\n   265→ * Uses crypto.getRandomValues for better randomness in rapid succession\n   266→ */\n   267→function pickRandom(arr) {\n   268→  if (!arr || arr.length === 0) return null;\n   269→  const randomBuffer = new Uint32Array(1);\n   270→  crypto.getRandomValues(randomBuffer);\n   271→  const randomValue = randomBuffer[0] / (0xffffffff + 1);\n   272→  return arr[Math.floor(randomValue * arr.length)];\n   273→}\n   274→\n   275→/**\n   276→ * Resolve style selection to actual style definitions\n   277→ * Handles culture defaults, random selection, exclusion filtering, and fallbacks\n   278→ */\n   279→export function resolveStyleSelection({\n   280→  selection,\n   281→  entityCultureId,\n   282→  entityKind,\n   283→  cultures,\n   284→  styleLibrary,\n   285→  exclusionRules = DEFAULT_RANDOM_EXCLUSIONS,\n   286→}) {\n   287→  const result = {\n   288→    artisticStyle: null,\n   289→    compositionStyle: null,\n   290→    colorPalette: null,\n   291→    cultureKeywords: [],\n   292→  };\n   293→\n   294→  if (!styleLibrary) return result;\n   295→\n   296→  const artisticStyles = styleLibrary.artisticStyles || [];\n   297→  const compositionStyles = styleLibrary.compositionStyles || [];\n   298→  const colorPalettes = styleLibrary.colorPalettes || [];\n   299→  const rules = exclusionRules || [];\n   300→\n   301→  // Filter composition styles by entity kind\n   302→  const filteredCompositionStyles = entityKind\n   303→    ? compositionStyles.filter(\n   304→        (s) =>\n   305→          !s.suitableForKinds ||\n   306→          s.suitableForKinds.length === 0 ||\n   307→          s.suitableForKinds.includes(entityKind)\n   308→      )\n   309→    : compositionStyles;\n   310→\n   311→  const styleIsRandom = selection.artisticStyleId === RANDOM_ID || !selection.artisticStyleId;\n   312→  const compIsRandom = selection.compositionStyleId === RANDOM_ID || !selection.compositionStyleId;\n   313→\n   314→  if (\n   315→    styleIsRandom &&\n   316→    compIsRandom &&\n   317→    selection.artisticStyleId !== NONE_ID &&\n   318→    selection.compositionStyleId !== NONE_ID\n   319→  ) {\n   320→    // Both random: pick composition first, then filter styles for that composition\n   321→    result.compositionStyle = pickRandom(filteredCompositionStyles);\n   322→    if (result.compositionStyle && rules.length > 0) {\n   323→      const filteredStyles = filterByExclusion(\n   324→        artisticStyles,\n   325→        result.compositionStyle.id,\n   326→        rules,\n   327→        artisticStyles,\n   328→        compositionStyles,\n   329→        \"style\"\n   330→      );\n   331→      result.artisticStyle = pickRandom(filteredStyles);\n   332→    } else {\n   333→      result.artisticStyle = pickRandom(artisticStyles);\n   334→    }\n   335→  } else {\n   336→    // Resolve artistic style\n   337→    if (selection.artisticStyleId === NONE_ID) {\n   338→      result.artisticStyle = null;\n   339→    } else if (styleIsRandom) {\n   340→      // Style is random, composition is fixed — filter styles for fixed composition\n   341→      const fixedCompId = selection.compositionStyleId;\n   342→      if (fixedCompId && fixedCompId !== NONE_ID && rules.length > 0) {\n   343→        const filteredStyles = filterByExclusion(\n   344→          artisticStyles,\n   345→          fixedCompId,\n   346→          rules,\n   347→          artisticStyles,\n   348→          compositionStyles,\n   349→          \"style\"\n   350→        );\n   351→        result.artisticStyle = pickRandom(filteredStyles);\n   352→      } else {\n   353→        result.artisticStyle = pickRandom(artisticStyles);\n   354→      }\n   355→    } else {\n   356→      result.artisticStyle = artisticStyles.find((s) => s.id === selection.artisticStyleId);\n   357→    }\n   358→\n   359→    // Resolve composition style\n   360→    if (selection.compositionStyleId === NONE_ID) {\n   361→      result.compositionStyle = null;\n   362→    } else if (compIsRandom) {\n   363→      // Composition is random, style is fixed — filter compositions for fixed style\n   364→      const fixedStyleId = selection.artisticStyleId;\n   365→      if (fixedStyleId && fixedStyleId !== NONE_ID && rules.length > 0) {\n   366→        const filteredComps = filterByExclusion(\n   367→          filteredCompositionStyles,\n   368→          fixedStyleId,\n   369→          rules,\n   370→          artisticStyles,\n   371→          compositionStyles,\n   372→          \"composition\"\n   373→        );\n   374→        result.compositionStyle = pickRandom(filteredComps);\n   375→      } else {\n   376→        result.compositionStyle = pickRandom(filteredCompositionStyles);\n   377→      }\n   378→    } else {\n   379→      result.compositionStyle = compositionStyles.find(\n   380→        (s) => s.id === selection.compositionStyleId\n   381→      );\n   382→    }\n   383→  }\n   384→\n   385→  // Resolve color palette (no culture default for palettes)\n   386→  if (selection.colorPaletteId === NONE_ID) {\n   387→    result.colorPalette = null;\n   388→  } else if (selection.colorPaletteId === RANDOM_ID || !selection.colorPaletteId) {\n   389→    result.colorPalette = pickRandom(colorPalettes);\n   390→  } else {\n   391→    result.colorPalette = colorPalettes.find((p) => p.id === selection.colorPaletteId);\n   392→  }\n   393→\n   394→  // Get culture style keywords\n   395→  const culture = cultures?.find((c) => c.id === entityCultureId);\n   396→  if (culture?.styleKeywords?.length > 0) {\n   397→    result.cultureKeywords = culture.styleKeywords;\n   398→  }\n   399→\n   400→  return result;\n   401→}\n   402→\n   403→/**\n   404→ * Filter items by exclusion rules.\n   405→ * axis: 'style' means we're filtering styles given a fixed compositionId,\n   406→ *        'composition' means we're filtering compositions given a fixed styleId.\n   407→ */\n   408→function filterByExclusion(items, fixedId, rules, artisticStyles, compositionStyles, axis) {\n   409→  return items.filter((item) => {\n   410→    const styleId = axis === \"style\" ? item.id : fixedId;\n   411→    const compId = axis === \"style\" ? fixedId : item.id;\n   412→    return !isExcludedPairLocal(styleId, compId, rules, artisticStyles, compositionStyles);\n   413→  });\n   414→}\n   415→\n   416→/**\n   417→ * Local JS implementation of isExcludedPair (avoids importing TS from world-schema at runtime).\n   418→ */\n   419→function isExcludedPairLocal(styleId, compositionId, rules, artisticStyles, compositionStyles) {\n   420→  for (const rule of rules) {\n   421→    const excludedStyles = expandPatterns(rule.styles, artisticStyles, (s) => s.category);\n   422→    const excludedComps = expandPatterns(\n   423→      rule.compositions,\n   424→      compositionStyles,\n   425→      (c) => c.targetCategory\n   426→    );\n   427→    if (excludedStyles.has(styleId) && excludedComps.has(compositionId)) {\n   428→      if (rule.allow?.some(([s, c]) => s === styleId && c === compositionId)) {\n   429→        continue;\n   430→      }\n   431→      return true;\n   432→    }\n   433→  }\n   434→  return false;\n   435→}\n   436→\n   437→function expandPatterns(patterns, items, getCategoryFn) {\n   438→  const ids = new Set();\n   439→  for (const pattern of patterns) {\n   440→    if (pattern.startsWith(\"cat:\")) {\n   441→      const cat = pattern.slice(4);\n   442→      for (const item of items) {\n   443→        if (getCategoryFn(item) === cat) {\n   444→          ids.add(item.id);\n   445→        }\n   446→      }\n   447→    } else {\n   448→      ids.add(pattern);\n   449→    }\n   450→  }\n   451→  return ids;\n   452→}\n   453→\n   454→StyleSelector.propTypes = {\n   455→  styleLibrary: PropTypes.object,\n   456→  selectedArtisticStyleId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   457→  selectedCompositionStyleId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   458→  selectedColorPaletteId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   459→  onArtisticStyleChange: PropTypes.func,\n   460→  onCompositionStyleChange: PropTypes.func,\n   461→  onColorPaletteChange: PropTypes.func,\n   462→  entityKind: PropTypes.string,\n   463→  compact: PropTypes.bool,\n   464→};\n   465→\n   466→export { RANDOM_ID, NONE_ID };\n   467→"}]},"parent_tool_use_id":"toolu_01E28KJC3ajr97NVeEYUdMVq","session_id":"32340847-edea-48f0-bd01-a0b1ba1c9fbd","uuid":"be9f510a-ce8d-4f94-8a8e-4b47271fd2aa"}
