{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N67tCqmPKcZubecNBUBEjM","type":"tool_result","content":"     1→/**\n     2→ * ChronicleSeedViewer - Displays chronicle generation context/seed data\n     3→ *\n     4→ * Unified component used by:\n     5→ * - Chronicler wiki pages (modal view, with temporal context)\n     6→ * - Illuminator validation UI (expandable section, with narrative direction)\n     7→ */\n     8→\n     9→import React, { useState } from \"react\";\n    10→import \"./ChronicleSeedViewer.css\";\n    11→\n    12→interface ChronicleRoleAssignment {\n    13→  role: string;\n    14→  entityId: string;\n    15→  entityName: string;\n    16→  entityKind: string;\n    17→  isPrimary: boolean;\n    18→}\n    19→\n    20→interface ChronicleTemporalContext {\n    21→  focalEra?: { id: string; name: string; summary?: string };\n    22→  chronicleTickRange?: [number, number];\n    23→  temporalScope?: string;\n    24→  isMultiEra?: boolean;\n    25→  touchedEraIds?: string[];\n    26→  temporalDescription?: string;\n    27→}\n    28→\n    29→interface ChronicleSeedData {\n    30→  narrativeStyleId: string;\n    31→  narrativeStyleName?: string;\n    32→  entrypointId?: string;\n    33→  entrypointName?: string;\n    34→  narrativeDirection?: string;\n    35→  roleAssignments: ChronicleRoleAssignment[];\n    36→  selectedEventIds: string[];\n    37→  selectedRelationshipIds: string[];\n    38→  temporalContext?: ChronicleTemporalContext;\n    39→}\n    40→\n    41→interface ChronicleSeedViewerProps {\n    42→  seed: ChronicleSeedData;\n    43→  eventNames?: Map<string, string>;\n    44→  relationshipLabels?: Map<string, string>;\n    45→}\n    46→\n    47→interface ExpandableSeedSectionProps {\n    48→  seed: ChronicleSeedData;\n    49→  eventNames?: Map<string, string>;\n    50→  relationshipLabels?: Map<string, string>;\n    51→  defaultExpanded?: boolean;\n    52→}\n    53→\n    54→interface SeedModalProps {\n    55→  isOpen: boolean;\n    56→  onClose: (e?: React.MouseEvent | React.KeyboardEvent) => void;\n    57→  seed: ChronicleSeedData;\n    58→  eventNames?: Map<string, string>;\n    59→  relationshipLabels?: Map<string, string>;\n    60→  title?: string;\n    61→}\n    62→export default function ChronicleSeedViewer({\n    63→  seed,\n    64→  eventNames,\n    65→  relationshipLabels,\n    66→}: ChronicleSeedViewerProps) {\n    67→  const primaryRoles = seed.roleAssignments.filter((r) => r.isPrimary);\n    68→  const supportingRoles = seed.roleAssignments.filter((r) => !r.isPrimary);\n    69→\n    70→  return (\n    71→    <div className=\"csv-container\">\n    72→      {/* Style & Entry Point */}\n    73→      <div className=\"csv-section\">\n    74→        <div className=\"csv-section-title\">Generation Settings</div>\n    75→        <div className=\"csv-field\">\n    76→          <span className=\"csv-field-label\">Style:</span>\n    77→          <span className=\"csv-field-value\">{seed.narrativeStyleName || seed.narrativeStyleId}</span>\n    78→        </div>\n    79→        {seed.entrypointId && (\n    80→          <div className=\"csv-field\">\n    81→            <span className=\"csv-field-label\">Entry Point:</span>\n    82→            <span className=\"csv-field-value\">{seed.entrypointName || seed.entrypointId}</span>\n    83→          </div>\n    84→        )}\n    85→        {seed.narrativeDirection && (\n    86→          <div className=\"csv-narrative-direction-wrapper\">\n    87→            <div className=\"csv-narrative-direction-label\">\n    88→              Narrative Direction:\n    89→            </div>\n    90→            <div\n    91→              className=\"csv-narrative-direction-body\"\n    92→              title=\"Click to copy\"\n    93→              onClick={() => void navigator.clipboard.writeText(seed.narrativeDirection)}\n    94→              role=\"button\"\n    95→              tabIndex={0}\n    96→              onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n    97→            >\n    98→              {seed.narrativeDirection}\n    99→            </div>\n   100→          </div>\n   101→        )}\n   102→      </div>\n   103→\n   104→      {/* Role Assignments */}\n   105→      <div className=\"csv-section\">\n   106→        <div className=\"csv-section-title\">Cast ({seed.roleAssignments.length} entities)</div>\n   107→        {seed.roleAssignments.length === 0 ? (\n   108→          <div className=\"csv-empty-state\">No roles assigned</div>\n   109→        ) : (\n   110→          <div className=\"csv-role-list\">\n   111→            {primaryRoles.map((role, i) => (\n   112→              <div key={`primary-${i}`} className=\"csv-role-item\">\n   113→                <span className=\"csv-primary-role-badge\">{role.role}</span>\n   114→                <span className=\"csv-entity-name\">{role.entityName}</span>\n   115→                <span className=\"csv-entity-kind\">({role.entityKind})</span>\n   116→              </div>\n   117→            ))}\n   118→            {supportingRoles.map((role, i) => (\n   119→              <div key={`supporting-${i}`} className=\"csv-role-item\">\n   120→                <span className=\"csv-supporting-role-badge\">{role.role}</span>\n   121→                <span className=\"csv-entity-name\">{role.entityName}</span>\n   122→                <span className=\"csv-entity-kind\">({role.entityKind})</span>\n   123→              </div>\n   124→            ))}\n   125→          </div>\n   126→        )}\n   127→      </div>\n   128→\n   129→      {/* Temporal Context (optional, used by chronicler) */}\n   130→      {seed.temporalContext && (\n   131→        <div className=\"csv-section\">\n   132→          <div className=\"csv-section-title\">Temporal Context</div>\n   133→          <div className=\"csv-field\">\n   134→            <span className=\"csv-field-label\">Focal Era:</span>\n   135→            <span className=\"csv-field-value\">\n   136→              {seed.temporalContext.focalEra?.name || \"Unknown\"}\n   137→            </span>\n   138→          </div>\n   139→          {seed.temporalContext.focalEra?.summary && (\n   140→            <div className=\"csv-field\">\n   141→              <span className=\"csv-field-label\">Era Summary:</span>\n   142→              <span className=\"csv-field-value\">{seed.temporalContext.focalEra.summary}</span>\n   143→            </div>\n   144→          )}\n   145→          {seed.temporalContext.temporalDescription && (\n   146→            <div className=\"csv-field\">\n   147→              <span className=\"csv-field-label\">Scope:</span>\n   148→              <span className=\"csv-field-value\">\n   149→                {seed.temporalContext.temporalDescription}\n   150→              </span>\n   151→            </div>\n   152→          )}\n   153→          {seed.temporalContext.chronicleTickRange && (\n   154→            <div className=\"csv-field\">\n   155→              <span className=\"csv-field-label\">Ticks:</span>\n   156→              <span className=\"csv-field-value\">\n   157→                {seed.temporalContext.chronicleTickRange[0]}&ndash;\n   158→                {seed.temporalContext.chronicleTickRange[1]}\n   159→              </span>\n   160→            </div>\n   161→          )}\n   162→          {typeof seed.temporalContext.isMultiEra === \"boolean\" && (\n   163→            <div className=\"csv-field\">\n   164→              <span className=\"csv-field-label\">Multi-era:</span>\n   165→              <span className=\"csv-field-value\">\n   166→                {seed.temporalContext.isMultiEra ? \"Yes\" : \"No\"}\n   167→              </span>\n   168→            </div>\n   169→          )}\n   170→          {seed.temporalContext.touchedEraIds?.length ? (\n   171→            <div>\n   172→              <div className=\"csv-field-label-spaced\">Touched Eras:</div>\n   173→              <div className=\"csv-id-list\">\n   174→                {seed.temporalContext.touchedEraIds.map((id) => (\n   175→                  <span key={id} className=\"csv-id-tag\">\n   176→                    {id}\n   177→                  </span>\n   178→                ))}\n   179→              </div>\n   180→            </div>\n   181→          ) : null}\n   182→        </div>\n   183→      )}\n   184→\n   185→      {/* Selected Events */}\n   186→      <div className=\"csv-section\">\n   187→        <div className=\"csv-section-title\">Events ({seed.selectedEventIds.length})</div>\n   188→        {seed.selectedEventIds.length === 0 ? (\n   189→          <div className=\"csv-empty-state\">No events selected</div>\n   190→        ) : (\n   191→          <div className=\"csv-id-list\">\n   192→            {seed.selectedEventIds.map((id, i) => (\n   193→              <span key={i} className=\"csv-id-tag\">\n   194→                {eventNames?.get(id) || id}\n   195→              </span>\n   196→            ))}\n   197→          </div>\n   198→        )}\n   199→      </div>\n   200→\n   201→      {/* Selected Relationships */}\n   202→      <div className=\"csv-section\">\n   203→        <div className=\"csv-section-title\">Relationships ({seed.selectedRelationshipIds.length})</div>\n   204→        {seed.selectedRelationshipIds.length === 0 ? (\n   205→          <div className=\"csv-empty-state\">No relationships selected</div>\n   206→        ) : (\n   207→          <div className=\"csv-id-list\">\n   208→            {seed.selectedRelationshipIds.map((id, i) => (\n   209→              <span key={i} className=\"csv-id-tag\">\n   210→                {relationshipLabels?.get(id) || id}\n   211→              </span>\n   212→            ))}\n   213→          </div>\n   214→        )}\n   215→      </div>\n   216→    </div>\n   217→  );\n   218→}\n   219→\n   220→/**\n   221→ * Expandable wrapper for use in validation UI\n   222→ */\n   223→export function ExpandableSeedSection({\n   224→  seed,\n   225→  eventNames,\n   226→  relationshipLabels,\n   227→  defaultExpanded = false,\n   228→}: ExpandableSeedSectionProps) {\n   229→  const [expanded, setExpanded] = useState(defaultExpanded);\n   230→\n   231→  return (\n   232→    <div\n   233→      className=\"csv-expandable-container\"\n   234→    >\n   235→      <button\n   236→        onClick={() => setExpanded(!expanded)}\n   237→        className=\"csv-expandable-button\"\n   238→      >\n   239→        <span>Generation Context</span>\n   240→        <span className=\"csv-expandable-meta\">\n   241→          {expanded ? \"\\u25BC\" : \"\\u25B6\"} {seed.roleAssignments.length} roles, {seed.selectedEventIds.length}{\" \"}\n   242→          events\n   243→        </span>\n   244→      </button>\n   245→      {expanded && (\n   246→        <div className=\"csv-expandable-content\">\n   247→          <ChronicleSeedViewer\n   248→            seed={seed}\n   249→            eventNames={eventNames}\n   250→            relationshipLabels={relationshipLabels}\n   251→          />\n   252→        </div>\n   253→      )}\n   254→    </div>\n   255→  );\n   256→}\n   257→\n   258→/**\n   259→ * Modal wrapper for use in chronicler wiki pages\n   260→ */\n   261→export function SeedModal({\n   262→  isOpen,\n   263→  onClose,\n   264→  seed,\n   265→  eventNames,\n   266→  relationshipLabels,\n   267→  title = \"Generation Context\",\n   268→}: SeedModalProps) {\n   269→  if (!isOpen) return null;\n   270→\n   271→  return (\n   272→    <div\n   273→      className=\"csv-modal-overlay\"\n   274→      onClick={onClose}\n   275→      role=\"button\"\n   276→      tabIndex={0}\n   277→      onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") onClose(e); }}\n   278→    >\n   279→      <div\n   280→        className=\"csv-modal-dialog\"\n   281→        onClick={(e) => e.stopPropagation()}\n   282→        role=\"button\"\n   283→        tabIndex={0}\n   284→        onKeyDown={(e) => { if (e.key === \"Enter\" || e.key === \" \") e.currentTarget.click(); }}\n   285→      >\n   286→        {/* Header */}\n   287→        <div className=\"csv-modal-header\">\n   288→          <h3 className=\"csv-modal-title\">{title}</h3>\n   289→          <button\n   290→            onClick={onClose}\n   291→            className=\"csv-modal-close-button\"\n   292→          >\n   293→            &times;\n   294→          </button>\n   295→        </div>\n   296→\n   297→        {/* Content */}\n   298→        <div className=\"csv-modal-body\">\n   299→          <ChronicleSeedViewer\n   300→            seed={seed}\n   301→            eventNames={eventNames}\n   302→            relationshipLabels={relationshipLabels}\n   303→          />\n   304→        </div>\n   305→\n   306→        {/* Footer */}\n   307→        <div className=\"csv-modal-footer\">\n   308→          <button\n   309→            onClick={onClose}\n   310→            className=\"csv-modal-footer-button\"\n   311→          >\n   312→            Close\n   313→          </button>\n   314→        </div>\n   315→      </div>\n   316→    </div>\n   317→  );\n   318→}\n   319→"}]},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"e7ea8ece-bdc2-4d89-98aa-22c47099e5ea"}
