{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HCYXER1fGZnz2gZ5ZEqiS2","type":"tool_result","content":"     1→/**\n     2→ * useChronicleQueueWatcher - Bridges the enrichment queue to the chronicle store.\n     3→ *\n     4→ * Watches for chronicle-related task completions (chronicle generation + chronicle images)\n     5→ * and triggers targeted refreshChronicle() calls on the Zustand store.\n     6→ *\n     7→ * Also handles retries by allowing tasks to be processed again if they return\n     8→ * to queued/running after an error.\n     9→ */\n    10→\n    11→import { useEffect, useRef } from \"react\";\n    12→import type { QueueItem } from \"../lib/enrichmentTypes\";\n    13→import { useChronicleStore } from \"../lib/db/chronicleStore\";\n    14→import {\n    15→  updateChronicleCoverImageStatus,\n    16→  updateChronicleImageRef,\n    17→} from \"../lib/db/chronicleRepository\";\n    18→import {\n    19→  updateEraNarrativeCoverImageStatus,\n    20→  updateEraNarrativeImageRefStatus,\n    21→} from \"../lib/db/eraNarrativeRepository\";\n    22→\n    23→type ProcessedStatus = \"complete\" | \"error\";\n    24→\n    25→export function useChronicleQueueWatcher(queue: QueueItem[]): void {\n    26→  const processedRef = useRef<Map<string, ProcessedStatus>>(new Map());\n    27→  const activeRef = useRef(true);\n    28→\n    29→  useEffect(() => {\n    30→    activeRef.current = true;"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"7993f3c7-09b6-429d-a85d-9cc481c9618a"}
