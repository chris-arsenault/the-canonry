/\n    78→\n    79→.bie-picker {\n    80→  margin-bottom: 8px;\n    81→}\n    82→\n    83→.bie-section-label {\n    84→  font-size: 10px;\n    85→  color: rgb(255 255 255 / 50%);\n    86→  margin-bottom: 4px;\n    87→  text-transform: uppercase;\n    88→  letter-spacing: 0.5px;\n    89→}\n    90→\n    91→.bie-picker-grid {\n    92→  display: flex;\n    93→  gap: 6px;\n    94→  flex-wrap: wrap;\n    95→  align-items: center;\n    96→}\n    97→\n    98→.bie-none-btn {\n    99→  width: 60px;\n   100→  height: 60px;\n   101→  border-radius: 6px;\n   102→  padding: 0;\n   103→  cursor: pointer;\n   104→  background: rgb(255 255 255 / 5%);\n   105→  font-size: 10px;\n   106→  flex-shrink: 0;\n   107→}\n   108→\n   109→.bie-none-btn-selected {\n   110→  border: 2px solid #3b82f6;\n   111→  color: #3b82f6;\n   112→}\n   113→\n   114→.bie-none-btn-unselected {\n   115→  border: 2px solid rgb(255 255 255 / 20%);\n   116→  color: rgb(255 255 255 / 40%);\n   117→}\n   118→\n   119→/* Size + Alignment controls */\n   120→\n   121→.bie-controls {\n   122→  display: flex;\n   123→  gap: 12px;\n   124→  align-items: center;\n   125→}\n   126→\n   127→.bie-control-label {\n   128→  font-size: 10px;\n   129→  color: rgb(255 255 255 / 50%);\n   130→  text-transform: uppercase;\n   131→  letter-spacing: 0.5px;\n   132→  margin-right: 6px;\n   133→}\n   134→\n   135→.bie-size-select {\n   136→  background: rgb(255 255 255 / 10%);\n   137→  border: 1px solid rgb(255 255 255 / 20%);\n   138→  border-radius: 4px;\n   139→  color: rgb(255 255 255 / 90%);\n   140→  padding: 4px 8px;\n   141→  font-size: 12px;\n   142→}\n   143→\n   144→.bie-align-btn {\n   145→  color: rgb(255 255 255 / 90%);\n   146→  padding: 4px 10px;\n   147→  font-size: 12px;\n   148→  cursor: pointer;\n   149→}\n   150→\n   151→.bie-align-btn-left {\n   152→  border-radius: 4px 0 0 4px;\n   153→}\n   154→\n   155→.bie-align-btn-right {\n   156→  border-radius: 0 4px 4px 0;\n   157→}\n   158→\n   159→.bie-align-btn-active {\n   160→  background: rgb(59 130 246 / 30%);\n   161→  border: 1px solid rgb(59 130 246 / 50%);\n   162→}\n   163→\n   164→.bie-align-btn-inactive {\n   165→  background: rgb(255 255 255 / 10%);\n   166→  border: 1px solid rgb(255 255 255 / 20%);\n   167→}\n   168→\n   169→/* Legacy indicator */\n   170→\n   171→.bie-legacy-hint {\n   172→  font-size: 10px;\n   173→  color: rgb(255 255 255 / 30%);\n   174→  margin-top: 4px;\n   175→  font-style: italic;\n   176→}\n   177→\n   178→/* === BackrefImageEditor main === */\n   179→\n   180→.bie-wrapper {\n   181→  margin-bottom: 16px;\n   182→}\n   183→\n   184→.bie-rows-container-collapsed {\n   185→  margin-top: 8px;\n   186→}\n   187→\n   188→.bie-rows-container-expanded {\n   189→  margin-top: 0;\n   190→}\n   191→\n   192→.bie-heading {\n   193→  font-size: 11px;\n   194→  color: var(--text-muted);\n   195→  margin-bottom: 8px;\n   196→  text-transform: uppercase;\n   197→  letter-spacing: 0.5px;\n   198→}\n   199→\n   200→.bie-toggle-btn {\n   201→  display: flex;\n   202→  align-items: center;\n   203→  gap: 6px;\n   204→  width: 100%;\n   205→  background: rgb(255 255 255 / 5%);\n   206→  border: 1px solid rgb(255 255 255 / 10%);\n   207→  border-radius: 4px;\n   208→  padding: 8px 10px;\n   209→  color: rgb(255 255 255 / 80%);\n   210→  font-size: 12px;\n   211→  cursor: pointer;\n   212→  text-align: left;\n   213→}\n   214→\n   215→.bie-toggle-arrow {\n   216→  font-size: 10px;\n   217→  transition: transform 0.2s ease;\n   218→}\n   219→\n   220→.bie-toggle-arrow-expanded {\n   221→  transform: rotate(90deg);\n   222→}\n   223→\n   224→.bie-toggle-arrow-collapsed {\n   225→  transform: rotate(0deg);\n   226→}\n   227→\n   228→.bie-toggle-label {\n   229→  flex: 1;\n   230→}\n   231→"}]},"parent_tool_use_id":null,"session_id":"7b5b64fd-02b5-4d0c-8463-5e560f74a8b2","uuid":"3933d10e-7aa2-4270-b11d-2c8300f48698","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/BackrefImageEditor.css","content":"/* BackrefImageEditor - Entity-centric editor for chronicle backref images */\n\n/* === ImageThumbnail === */\n\n.bie-thumbnail {\n  width: 60px;\n  height: 60px;\n  border-radius: 6px;\n  padding: 0;\n  cursor: pointer;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n\n.bie-thumbnail-selected {\n  border: 2px solid #3b82f6;\n}\n\n.bie-thumbnail-unselected {\n  border: 2px solid rgb(255 255 255 / 20%);\n}\n\n.bie-thumbnail-has-image {\n  background: transparent;\n}\n\n.bie-thumbnail-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgb(255 255 255 / 5%);\n  font-size: 10px;\n  color: rgb(255 255 255 / 40%);\n}\n\n.bie-thumbnail-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* === BackrefRow === */\n\n.bie-row-missing {\n  padding: 8px;\n  color: rgb(255 255 255 / 40%);\n  font-size: 12px;\n  font-style: italic;\n}\n\n.bie-row {\n  padding: 12px;\n  background: rgb(255 255 255 / 3%);\n  border-radius: 6px;\n  margin-bottom: 8px;\n}\n\n.bie-row-header {\n  margin-bottom: 8px;\n}\n\n.bie-row-title {\n  font-size: 13px;\n  color: rgb(255 255 255 / 90%);\n  font-weight: 500;\n}\n\n.bie-row-anchor {\n  font-size: 11px;\n  color: rgb(255 255 255 / 50%);\n  margin-top: 2px;\n  font-style: italic;\n}\n\n/* Image picker */\n\n.bie-picker {\n  margin-bottom: 8px;\n}\n\n.bie-section-label {\n  font-size: 10px;\n  color: rgb(255 255 255 / 50%);\n  margin-bottom: 4px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.bie-picker-grid {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n\n.bie-none-btn {\n  width: 60px;\n  height: 60px;\n  border-radius: 6px;\n  padding: 0;\n  cursor: pointer;\n  background: rgb(255 255 255 / 5%);\n  font-size: 10px;\n  flex-shrink: 0;\n}\n\n.bie-none-btn-selected {\n  border: 2px solid #3b82f6;\n  color: #3b82f6;\n}\n\n.bie-none-btn-unselected {\n  border: 2px solid rgb(255 255 255 / 20%);\n  color: rgb(255 255 255 / 40%);\n}\n\n/* Size + Alignment controls */\n\n.bie-controls {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n}\n\n.bie-control-label {\n  font-size: 10px;\n  color: rgb(255 255 255 / 50%);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-right: 6px;\n}\n\n.bie-size-select {\n  background: rgb(255 255 255 / 10%);\n  border: 1px solid rgb(255 255 255 / 20%);\n  border-radius: 4px;\n  color: rgb(255 255 255 / 90%);\n  padding: 4px 8px;\n  font-size: 12px;\n}\n\n.bie-align-btn {\n  color: rgb(255 255 255 / 90%);\n  padding: 4px 10px;\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.bie-align-btn-left {\n  border-radius: 4px 0 0 4px;\n}\n\n.bie-align-btn-right {\n  border-radius: 0 4px 4px 0;\n}\n\n.bie-align-btn-active {\n  background: rgb(59 130 246 / 30%);\n  border: 1px solid rgb(59 130 246 / 50%);\n}\n\n.bie-align-btn-inactive {\n  background: rgb(255 255 255 / 10%);\n  border: 1px solid rgb(255 255 255 / 20%);\n}\n\n/* Legacy indicator */\n\n.bie-legacy-hint {\n  font-size: 10px;\n  color: rgb(255 255 255 / 30%);\n  margin-top: 4px;\n  font-style: italic;\n}\n\n/* === BackrefImageEditor main === */\n\n.bie-wrapper {\n  margin-bottom: 16px;\n}\n\n.bie-rows-container-collapsed {\n  margin-top: 8px;\n}\n\n.bie-rows-container-expanded {\n  margin-top: 0;\n}\n\n.bie-heading {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.bie-toggle-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  width: 100%;\n  background: rgb(255 255 255 / 5%);\n  border: 1px solid rgb(255 255 255 / 10%);\n  border-radius: 4px;\n  padding: 8px 10px;\n  color: rgb(255 255 255 / 80%);\n  font-size: 12px;\n  cursor: pointer;\n  text-align: left;\n}\n\n.bie-toggle-arrow {\n  font-size: 10px;\n  transition: transform 0.2s ease;\n}\n\n.bie-toggle-arrow-expanded {\n  transform: rotate(90deg);\n}\n\n.bie-toggle-arrow-collapsed {\n  transform: rotate(0deg);\n}\n\n.bie-toggle-label {\n  flex: 1;\n}\n","numLines":231,"startLine":1,"totalLines":231}}}
