{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012rJQk2e4HJ8bqoMyQMPjnJ","type":"tool_result","content":"     1→/**\n     2→ * useStyleLibrary Hook\n     3→ *\n     4→ * Manages loading and saving the style library from IndexedDB.\n     5→ * Loads defaults from world-schema if no custom library exists.\n     6→ */\n     7→\n     8→import { useState, useEffect, useCallback } from \"react\";\n     9→import { createDefaultStyleLibrary } from \"@canonry/world-schema\";\n    10→import type {\n    11→  StyleLibrary,\n    12→  ArtisticStyle,\n    13→  CompositionStyle,\n    14→  NarrativeStyle,\n    15→} from \"@canonry/world-schema\";\n    16→import { loadStyleLibrary, saveStyleLibrary, resetStyleLibrary } from \"../lib/db/styleRepository\";\n    17→\n    18→export interface UseStyleLibraryReturn {\n    19→  /** Current style library */\n    20→  styleLibrary: StyleLibrary;\n    21→  /** Whether the library is still loading */\n    22→  loading: boolean;\n    23→  /** Whether using custom (saved) library vs defaults */\n    24→  isCustom: boolean;\n    25→  /** Save the entire library */\n    26→  save: (library: StyleLibrary) => Promise<void>;\n    27→  /** Reset to defaults (deletes custom library) */\n    28→  reset: () => Promise<void>;\n    29→  /** Add a new artistic style */\n    30→  addArtisticStyle: (style: ArtisticStyle) => Promise<void>;\n    31→  /** Update an artistic style */\n    32→  updateArtisticStyle: (id: string, updates: Partial<ArtisticStyle>) => Promise<void>;\n    33→  /** Delete an artistic style */\n    34→  deleteArtisticStyle: (id: string) => Promise<void>;\n    35→  /** Add a new composition style */\n    36→  addCompositionStyle: (style: CompositionStyle) => Promise<void>;\n    37→  /** Update a composition style */\n    38→  updateCompositionStyle: (id: string, updates: Partial<CompositionStyle>) => Promise<void>;\n    39→  /** Delete a composition style */\n    40→  deleteCompositionStyle: (id: string) => Promise<void>;\n    41→  /** Add a new narrative style */\n    42→  addNarrativeStyle: (style: NarrativeStyle) => Promise<void>;\n    43→  /** Update a narrative style */\n    44→  updateNarrativeStyle: (id: string, updates: Partial<NarrativeStyle>) => Promise<void>;\n    45→  /** Delete a narrative style */\n    46→  deleteNarrativeStyle: (id: string) => Promise<void>;\n    47→}\n    48→\n    49→export function useStyleLibrary(): UseStyleLibraryReturn {\n    50→  const [styleLibrary, setStyleLibrary] = useState<StyleLibrary>(() => createDefaultStyleLibrary());\n    51→  const [loading, setLoading] = useState(true);\n    52→  const [isCustom, setIsCustom] = useState(false);\n    53→\n    54→  // Load style library on mount\n    55→  useEffect(() => {\n    56→    async function load() {\n    57→      try {\n    58→        const stored = await loadStyleLibrary();\n    59→        if (stored) {\n    60→          setStyleLibrary(stored);"}]},"parent_tool_use_id":"toolu_01Wo8tpDCEa6S6saPSgXZFWc","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"eaa732b2-79ff-471a-ad13-bb8e23e43c02"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wpq78sxBRGMG8CXJsTi8Nz","type":"tool_result","content":"     1→/**\n     2→ * Prompt Templates System - Redesigned\n     3→ *\n     4→ * Simplified approach:\n     5→ * - WorldContext: Just essentials (name, description, canon facts, tone)\n     6→ * - EntityContext: Built dynamically from actual graph data (relationships, peers, era)\n     7→ * - Prompts that USE this data effectively\n     8→ */\n     9→\n    10→// =============================================================================\n    11→// Types\n    12→// =============================================================================\n    13→\n    14→/**\n    15→ * Style information for image generation\n    16→ */\n    17→export interface StyleInfo {\n    18→  /** Artistic style prompt fragment (e.g., \"oil painting style, rich textures...\") */\n    19→  artisticPromptFragment?: string;\n    20→  /** Composition style prompt fragment (e.g., \"portrait composition, head and shoulders...\") */\n    21→  compositionPromptFragment?: string;\n    22→  /** Color palette prompt fragment (e.g., \"warm earth tones: terracotta, amber, ochre...\") */\n    23→  colorPalettePromptFragment?: string;\n    24→  /** Additional culture-specific style keywords */\n    25→  cultureKeywords?: string[];\n    26→  /**\n    27→   * Visual identity entries from culture, filtered by entity kind's visualIdentityKeys.\n    28→   * e.g., { \"ATTIRE\": \"fur parkas with bone jewelry\", \"SPECIES\": \"emperor penguins\" }\n    29→   */\n    30→  visualIdentity?: Record<string, string>;\n    31→}\n    32→\n    33→/**\n    34→ * Descriptive information for text generation\n    35→ */\n    36→export interface DescriptiveInfo {\n    37→  /**\n    38→   * Descriptive identity entries from culture, filtered by entity kind's descriptiveIdentityKeys.\n    39→   * e.g., { \"VALUES\": \"harmony, patience\", \"SPEECH\": \"formal, archaic dialect\" }\n    40→   */"}]},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"0f52e861-672d-412a-9afd-8bdf7b630dba"}
