{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y5tppyVMC3J1MTzH2KgBDa","type":"tool_result","content":"     1→import { defineConfig } from \"vite\";\n     2→import react from \"@vitejs/plugin-react\";\n     3→import { federation } from \"@module-federation/vite\";\n     4→import { resolve } from \"node:path\";\n     5→import { federationOnWarn, sharedDeps } from \"../../../config/federation.js\";\n     6→\n     7→// Illuminator is an MFE remote for The Canonry shell.\n     8→// To use Illuminator, run The Canonry (apps/canonry/webui).\n     9→\n    10→export default defineConfig({\n    11→  resolve: {\n    12→    alias: {\n    13→      \"@lib\": resolve(__dirname, \"../lib\"),\n    14→    },\n    15→  },\n    16→  plugins: [\n    17→    react(),\n    18→    federation({\n    19→      name: \"illuminator\",\n    20→      filename: \"remoteEntry.js\",\n    21→      manifest: true,\n    22→      exposes: {\n    23→        \"./IlluminatorRemote\": \"./src/IlluminatorRemote.jsx\",\n    24→        \"./entityRepository\": \"./src/lib/db/entityRepository.ts\",\n    25→        \"./eventRepository\": \"./src/lib/db/eventRepository.ts\",\n    26→        \"./relationshipRepository\": \"./src/lib/db/relationshipRepository.ts\",\n    27→        \"./coordinateStateRepository\": \"./src/lib/db/coordinateStateRepository.ts\",\n    28→        \"./schemaRepository\": \"./src/lib/db/schemaRepository.ts\",\n    29→      },\n    30→      shared: sharedDeps(\"zustand\", \"@the-canonry/image-store\"),\n    31→    }),\n    32→  ],\n    33→  // Base path - use /illuminator/ in dev (via proxy) and production\n    34→  base: \"/illuminator/\",\n    35→  build: {\n    36→    target: \"esnext\",\n    37→    minify: false,\n    38→    rollupOptions: {\n    39→      onwarn: federationOnWarn,\n    40→    },\n    41→  },\n    42→  worker: {\n    43→    format: \"es\",\n    44→  },\n    45→  server: {\n    46→    port: 5006,\n    47→    strictPort: true,\n    48→  },\n    