{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013W3QKYm7EB71qSaYVNvphn","type":"tool_result","content":"     1→/**\n     2→ * CostsPanel - Cost tracking and breakdown view\n     3→ *\n     4→ * Shows:\n     5→ * - Running totals by type (text, image, chronicle)\n     6→ * - Breakdown by model\n     7→ * - Simulation costs, project costs, all-time costs (from IndexedDB)\n     8→ *\n     9→ * Costs are tracked independently in IndexedDB and never deleted when\n    10→ * entities/chronicles are regenerated.\n    11→ */\n    12→\n    13→import React, { useMemo, useEffect, useState, useCallback } from \"react\";\n    14→import PropTypes from \"prop-types\";\n    15→import { formatCost } from \"../lib/costEstimation\";\n    16→import {\n    17→  getCostsForSimulation,\n    18→  getCostsForProject,\n    19→  getAllCosts,\n    20→  summarizeCosts,\n    21→  clearAllCosts,\n    22→} from \"../lib/db/costRepository\";\n    23→import \"./CostsPanel.css\";\n    24→\n    25→function CostCard({ title, children }) {\n    26→  return (\n    27→    <div className=\"illuminator-card\">\n    28→      <div className=\"illuminator-card-header\">\n    29→        <h2 className=\"illuminator-card-title\">{title}</h2>\n    30→      </div>\n    31→      {children}\n    32→    </div>\n    33→  );\n    34→}\n    35→\n    36→CostCard.propTypes = {\n    37→  title: PropTypes.string,\n    38→  children: PropTypes.node,\n    39→};\n    40→\n    41→function CostRow({ label, value, isTotal, isEstimated }) {\n    42→  return (\n    43→    <div className={`cpanel-row ${isTotal ? \"cpanel-row-total\" : \"\"}`}>\n    44→      <span>{label}</span>\n    45→      <span className=\"cpanel-row-value\">\n    46→        {isEstimated && \"~\"}\n    47→        {formatCost(value)}\n    48→      </span>\n    49→    </div>\n    50→  );\n    51→}\n    52→\n    53→CostRow.propTypes = {\n    54→  label: PropTypes.string,\n    55→  value: PropTypes.any,\n    56→  isTotal: PropTypes.bool,\n    57→  isEstimated: PropTypes.bool,\n    58→};\n    59→\n    60→// Group cost types into categories\n    61→function categorizeCosts(summary) {\n    62→  const text = {\n    63→    actual: 0,\n    64→    count: 0,\n    65→  };\n    66→  const image = {\n    67→    actual: 0,\n    68→    count: 0,\n    69→  };\n    70→  const chronicle = {\n    71→    actual: 0,\n    72→    count: 0,\n    73→  };\n    74→  const dynamics = {\n    75→    actual: 0,\n    76→    count: 0,\n    77→  };\n    78→  const revision = {\n    79→    actual: 0,\n    80→    count: 0,\n    81→  };\n    82→\n    83→  const textTypes = [\"description\"];\n    84→  const imageTypes = [\"image\", \"imagePrompt\"];\n    85→  const chronicleTypes = [\n    86→    \"chronicleValidation\",\n    87→    \"chronicleRevision\",\n    88→    \"chronicleSummary\",\n    89→    \"chronicleImageRefs\",\n    90→    \"chronicleV2\",\n    91→  ];\n    92→  const dynamicsTypes = [\"dynamicsGeneration\"];\n    93→  const revisionTypes = [\"summaryRevision\"];\n    94→\n    95→  for (const [type, data] of Object.entries(summary.byType)) {\n    96→    if (textTypes.includes(type)) {\n    97→      text.actual += data.actual;\n    98→      text.count += data.count;\n    99→    } else if (imageTypes.includes(type)) {\n   100→      image.actual += data.actual;\n   101→      image.count += data.count;\n   102→    } else if (chronicleTypes.includes(type)) {\n   103→      chronicle.actual += data.actual;\n   104→      chronicle.count += data.count;\n   105→    } else if (dynamicsTypes.includes(type)) {\n   106→      dynamics.actual += data.actual;\n   107→      dynamics.count += data.count;\n   108→    } else if (revisionTypes.includes(type)) {\n   109→      revision.actual += data.actual;\n   110→      revision.count += data.count;\n   111→    }\n   112→  }\n   113→\n   114→  return { text, image, chronicle, dynamics, revision };\n   115→}\n   116→\n   117→export default function CostsPanel({ queue, projectId, simulationRunId }) {\n   118→  // Cost data from IndexedDB\n   119→  const [simulationCosts, setSimulationCosts] = useState(null);\n   120→  const [projectCosts, setProjectCosts] = useState(null);\n   121→  const [allTimeCosts, setAllTimeCosts] = useState(null);\n   122→  const [refreshTrigger, setRefreshTrigger] = useState(0);\n   123→\n   124→  // Track running tasks to know when to refresh\n   125→  const runningTaskCount = useMemo(() => {\n   126→    return queue.filter((item) => item.status === \"queued\" || item.status === \"running\").length;\n   127→  }, [queue]);\n   128→\n   129→  // Fetch costs from IndexedDB\n   130→  const fetchCosts = useCallback(async () => {\n   131→    try {\n   132→      // All-time costs\n   133→      const allRecords = await getAllCosts();\n   134→      setAllTimeCosts(summarizeCosts(allRecords));\n   135→\n   136→      // Project costs\n   137→      if (projectId) {\n   138→        const projectRecords = await getCostsForProject(projectId);\n   139→        setProjectCosts(summarizeCosts(projectRecords));\n   140→      } else {\n   141→        setProjectCosts(null);\n   142→      }\n   143→\n   144→      // Simulation costs\n   145→      if (simulationRunId) {\n   146→        const simRecords = await getCostsForSimulation(simulationRunId);\n   147→        setSimulationCosts(summarizeCosts(simRecords));\n   148→      } else {\n   149→        setSimulationCosts(null);\n   150→      }\n   151→    } catch (err) {\n   152→      console.error(\"[CostsPanel] Failed to fetch costs:\", err);\n   153→    }\n   154→  }, [projectId, simulationRunId]);\n   155→\n   156→  // Fetch on mount and when dependencies change\n   157→  useEffect(() => {\n   158→    fetchCosts();\n   159→  }, [fetchCosts, refreshTrigger]);\n   160→\n   161→  // Refresh when queue changes (tasks complete)\n   162→  useEffect(() => {\n   163→    // Only refresh when queue length decreases (task completed)\n   164→    const timer = setTimeout(() => {\n   165→      setRefreshTrigger((prev) => prev + 1);\n   166→    }, 500);\n   167→    return () => clearTimeout(timer);\n   168→  }, [queue.length, runningTaskCount]);\n   169→\n   170→  // Calculate pending queue costs (estimated)\n   171→  const queueCosts = useMemo(() => {\n   172→    let textEstimated = 0;\n   173→    let imageEstimated = 0;\n   174→    let chronicleEstimated = 0;\n   175→\n   176→    for (const item of queue) {\n   177→      if (item.status === \"complete\") continue;\n   178→      if (item.estimatedCost) {\n   179→        if (item.type === \"image\") {\n   180→          imageEstimated += item.estimatedCost;\n   181→        } else if (item.type === \"entityChronicle\") {\n   182→          chronicleEstimated += item.estimatedCost;\n   183→        } else {\n   184→          textEstimated += item.estimatedCost;\n   185→        }\n   186→      } else if (item.type === \"entityChronicle\" && item.status !== \"complete\") {\n   187→        // Estimate chronicle cost if not available (~$0.05-0.15 per chronicle depending on length)\n   188→        chronicleEstimated += 0.08;\n   189→      }\n   190→    }\n   191→\n   192→    return {\n   193→      textEstimated,\n   194→      imageEstimated,\n   195→      chronicleEstimated,\n   196→      total: textEstimated + imageEstimated + chronicleEstimated,\n   197→    };\n   198→  }, [queue]);\n   199→\n   200→  // Categorize costs for display\n   201→  const simCategorized = simulationCosts ? categorizeCosts(simulationCosts) : null;\n   202→  const projCategorized = projectCosts ? categorizeCosts(projectCosts) : null;\n   203→  const allCategorized = allTimeCosts ? categorizeCosts(allTimeCosts) : null;\n   204→\n   205→  const handleClearHistory = async () => {\n   206→    if (confirm(\"Clear all cost history? This cannot be undone.\")) {\n   207→      await clearAllCosts();\n   208→      setRefreshTrigger((prev) => prev + 1);\n   209→    }\n   210→  };\n   211→\n   212→  return (\n   213→    <div>\n   214→      {/* Current Simulation */}\n   215→      {simCategorized && (\n   216→        <CostCard title=\"Current Simulation\">\n   217→          <div className=\"cpanel-section-hint\">Costs from this simulation run.</div>\n   218→          <CostRow label=\"Text generations\" value={simCategorized.text.actual} />\n   219→          <CostRow\n   220→            label={`  \\u2514 ${simCategorized.text.count} requests`}\n   221→            value={simCategorized.text.actual}\n   222→          />\n   223→          <CostRow label=\"Image generations\" value={simCategorized.image.actual} />\n   224→          <CostRow\n   225→            label={`  \\u2514 ${simCategorized.image.count} images`}\n   226→            value={simCategorized.image.actual}\n   227→          />\n   228→          <CostRow label=\"Chronicle generations\" value={simCategorized.chronicle.actual} />\n   229→          <CostRow\n   230→            label={`  \\u2514 ${simCategorized.chronicle.count} steps`}\n   231→            value={simCategorized.chronicle.actual}\n   232→          />\n   233→          <CostRow label=\"Dynamics generation\" value={simCategorized.dynamics.actual} />\n   234→          <CostRow\n   235→            label={`  \\u2514 ${simCategorized.dynamics.count} turns`}\n   236→            value={simCategorized.dynamics.actual}\n   237→          />\n   238→          <CostRow label=\"Summary revision\" value={simCategorized.revision.actual} />\n   239→          <CostRow\n   240→            label={`  \\u2514 ${simCategorized.revision.count} batches`}\n   241→            value={simCategorized.revision.actual}\n   242→          />\n   243→          <CostRow label=\"Simulation Total\" value={simulationCosts.totalActual} isTotal />\n   244→        </CostCard>\n   245→      )}\n   246→\n   247→      {/* Pending Queue */}\n   248→      {queueCosts.total > 0 && (\n   249→        <CostCard title=\"Pending Queue (Estimated)\">\n   250→          <div className=\"cpanel-section-hint\">\n   251→            Estimated costs for queued tasks not yet completed.\n   252→          </div>\n   253→          <CostRow label=\"Text generations\" value={queueCosts.textEstimated} isEstimated />\n   254→          <CostRow label=\"Image generations\" value={queueCosts.imageEstimated} isEstimated />\n   255→          <CostRow\n   256→            label=\"Chronicle generations\"\n   257→            value={queueCosts.chronicleEstimated}\n   258→            isEstimated\n   259→          />\n   260→          <CostRow label=\"Queue Total\" value={queueCosts.total} isTotal isEstimated />\n   261→        </CostCard>\n   262→      )}\n   263→\n   264→      {/* By Model */}\n   265→      {simulationCosts && Object.keys(simulationCosts.byModel).length > 0 && (\n   266→        <CostCard title=\"By Model (Simulation)\">\n   267→          <div className=\"cpanel-section-hint\">Cost breakdown by model used.</div>\n   268→          {Object.entries(simulationCosts.byModel)\n   269→            .sort((a, b) => b[1].actual - a[1].actual)\n   270→            .map(([model, data]) => (\n   271→              <CostRow key={model} label={model} value={data.actual} />\n   272→            ))}\n   273→        </CostCard>\n   274→      )}\n   275→\n   276→      {/* Project Total */}\n   277→      {projCategorized && (\n   278→        <CostCard title=\"Project Total\">\n   279→          <div className=\"cpanel-section-hint\">\n   280→            Accumulated costs for this project across all simulations.\n   281→          </div>\n   282→          <CostRow label=\"Text generations\" value={projCategorized.text.actual} />\n   283→          <CostRow label=\"Image generations\" value={projCategorized.image.actual} />\n   284→          <CostRow label=\"Chronicle generations\" value={projCategorized.chronicle.actual} />\n   285→          <CostRow label=\"Project Total\" value={projectCosts.totalActual} isTotal />\n   286→        </CostCard>\n   287→      )}\n   288→\n   289→      {/* All Time */}\n   290→      {allCategorized && (\n   291→        <CostCard title=\"All Time Total\">\n   292→          <div className=\"cpanel-section-hint\">\n   293→            Accumulated costs across all projects and sessions.\n   294→          </div>\n   295→          <CostRow label=\"Text generations\" value={allCategorized.text.actual} />\n   296→          <CostRow label=\"Image generations\" value={allCategorized.image.actual} />\n   297→          <CostRow label=\"Chronicle generations\" value={allCategorized.chronicle.actual} />\n   298→          <CostRow label=\"All Time Total\" value={allTimeCosts.totalActual} isTotal />\n   299→          <CostRow\n   300→            label={`  \\u2514 ${allTimeCosts.count} total records`}\n   301→            value={allTimeCosts.totalActual}\n   302→          />\n   303→\n   304→          <button\n   305→            onClick={() => void handleClearHistory()}\n   306→            className=\"illuminator-button-link cpanel-clear-button\"\n   307→          >\n   308→            Clear History\n   309→          </button>\n   310→        </CostCard>\n   311→      )}\n   312→\n   313→      {/* Empty state */}\n   314→      {!simulationCosts && !allTimeCosts && queueCosts.total === 0 && (\n   315→        <CostCard title=\"Cost Tracking\">\n   316→          <div className=\"cpanel-empty-hint\">\n   317→            No costs recorded yet. Costs will appear here as you generate content.\n   318→          </div>\n   319→        </CostCard>\n   320→      )}\n   321→    </div>\n   322→  );\n   323→}\n   324→\n   325→CostsPanel.propTypes = {\n   326→  queue: PropTypes.array,\n   327→  projectId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   328→  simulationRunId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n   329→};\n   330→"}]},"parent_tool_use_id":null,"session_id":"32340847-edea-48f0-bd01-a0b1ba1c9fbd","uuid":"618c1480-2dc2-4dec-805e-cd3d8b1716aa","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/CostsPanel.jsx","content":"/**\n * CostsPanel - Cost tracking and breakdown view\n *\n * Shows:\n * - Running totals by type (text, image, chronicle)\n * - Breakdown by model\n * - Simulation costs, project costs, all-time costs (from IndexedDB)\n *\n * Costs are tracked independently in IndexedDB and never deleted when\n * entities/chronicles are regenerated.\n */\n\nimport React, { useMemo, useEffect, useState, useCallback } from \"react\";\nimport PropTypes from \"prop-types\";\nimport { formatCost } from \"../lib/costEstimation\";\nimport {\n  getCostsForSimulation,\n  getCostsForProject,\n  getAllCosts,\n  summarizeCosts,\n  clearAllCosts,\n} from \"../lib/db/costRepository\";\nimport \"./CostsPanel.css\";\n\nfunction CostCard({ title, children }) {\n  return (\n    <div className=\"illuminator-card\">\n      <div className=\"illuminator-card-header\">\n        <h2 className=\"illuminator-card-title\">{title}</h2>\n      </div>\n      {children}\n    </div>\n  );\n}\n\nCostCard.propTypes = {\n  title: PropTypes.string,\n  children: PropTypes.node,\n};\n\nfunction CostRow({ label, value, isTotal, isEstimated }) {\n  return (\n    <div className={`cpanel-row ${isTotal ? \"cpanel-row-total\" : \"\"}`}>\n      <span>{label}</span>\n      <span className=\"cpanel-row-value\">\n        {isEstimated && \"~\"}\n        {formatCost(value)}\n      </span>\n    </div>\n  );\n}\n\nCostRow.propTypes = {\n  label: PropTypes.string,\n  value: PropTypes.any,\n  isTotal: PropTypes.bool,\n  isEstimated: PropTypes.bool,\n};\n\n// Group cost types into categories\nfunction categorizeCosts(summary) {\n  const text = {\n    actual: 0,\n    count: 0,\n  };\n  const image = {\n    actual: 0,\n    count: 0,\n  };\n  const chronicle = {\n    actual: 0,\n    count: 0,\n  };\n  const dynamics = {\n    actual: 0,\n    count: 0,\n  };\n  const revision = {\n    actual: 0,\n    count: 0,\n  };\n\n  const textTypes = [\"description\"];\n  const imageTypes = [\"image\", \"imagePrompt\"];\n  const chronicleTypes = [\n    \"chronicleValidation\",\n    \"chronicleRevision\",\n    \"chronicleSummary\",\n    \"chronicleImageRefs\",\n    \"chronicleV2\",\n  ];\n  const dynamicsTypes = [\"dynamicsGeneration\"];\n  const revisionTypes = [\"summaryRevision\"];\n\n  for (const [type, data] of Object.entries(summary.byType)) {\n    if (textTypes.includes(type)) {\n      text.actual += data.actual;\n      text.count += data.count;\n    } else if (imageTypes.includes(type)) {\n      image.actual += data.actual;\n      image.count += data.count;\n    } else if (chronicleTypes.includes(type)) {\n      chronicle.actual += data.actual;\n      chronicle.count += data.count;\n    } else if (dynamicsTypes.includes(type)) {\n      dynamics.actual += data.actual;\n      dynamics.count += data.count;\n    } else if (revisionTypes.includes(type)) {\n      revision.actual += data.actual;\n      revision.count += data.count;\n    }\n  }\n\n  return { text, image, chronicle, dynamics, revision };\n}\n\nexport default function CostsPanel({ queue, projectId, simulationRunId }) {\n  // Cost data from IndexedDB\n  const [simulationCosts, setSimulationCosts] = useState(null);\n  const [projectCosts, setProjectCosts] = useState(null);\n  const [allTimeCosts, setAllTimeCosts] = useState(null);\n  const [refreshTrigger, setRefreshTrigger] = useState(0);\n\n  // Track running tasks to know when to refresh\n  const runningTaskCount = useMemo(() => {\n    return queue.filter((item) => item.status === \"queued\" || item.status === \"running\").length;\n  }, [queue]);\n\n  // Fetch costs from IndexedDB\n  const fetchCosts = useCallback(async () => {\n    try {\n      // All-time costs\n      const allRecords = await getAllCosts();\n      setAllTimeCosts(summarizeCosts(allRecords));\n\n      // Project costs\n      if (projectId) {\n        const projectRecords = await getCostsForProject(projectId);\n        setProjectCosts(summarizeCosts(projectRecords));\n      } else {\n        setProjectCosts(null);\n      }\n\n      // Simulation costs\n      if (simulationRunId) {\n        const simRecords = await getCostsForSimulation(simulationRunId);\n        setSimulationCosts(summarizeCosts(simRecords));\n      } else {\n        setSimulationCosts(null);\n      }\n    } catch (err) {\n      console.error(\"[CostsPanel] Failed to fetch costs:\", err);\n    }\n  }, [projectId, simulationRunId]);\n\n  // Fetch on mount and when dependencies change\n  useEffect(() => {\n    fetchCosts();\n  }, [fetchCosts, refreshTrigger]);\n\n  // Refresh when queue changes (tasks complete)\n  useEffect(() => {\n    // Only refresh when queue length decreases (task completed)\n    const timer = setTimeout(() => {\n      setRefreshTrigger((prev) => prev + 1);\n    }, 500);\n    return () => clearTimeout(timer);\n  }, [queue.length, runningTaskCount]);\n\n  // Calculate pending queue costs (estimated)\n  const queueCosts = useMemo(() => {\n    let textEstimated = 0;\n    let imageEstimated = 0;\n    let chronicleEstimated = 0;\n\n    for (const item of queue) {\n      if (item.status === \"complete\") continue;\n      if (item.estimatedCost) {\n        if (item.type === \"image\") {\n          imageEstimated += item.estimatedCost;\n        } else if (item.type === \"entityChronicle\") {\n          chronicleEstimated += item.estimatedCost;\n        } else {\n          textEstimated += item.estimatedCost;\n        }\n      } else if (item.type === \"entityChronicle\" && item.status !== \"complete\") {\n        // Estimate chronicle cost if not available (~$0.05-0.15 per chronicle depending on length)\n        chronicleEstimated += 0.08;\n      }\n    }\n\n    return {\n      textEstimated,\n      imageEstimated,\n      chronicleEstimated,\n      total: textEstimated + imageEstimated + chronicleEstimated,\n    };\n  }, [queue]);\n\n  // Categorize costs for display\n  const simCategorized = simulationCosts ? categorizeCosts(simulationCosts) : null;\n  const projCategorized = projectCosts ? categorizeCosts(projectCosts) : null;\n  const allCategorized = allTimeCosts ? categorizeCosts(allTimeCosts) : null;\n\n  const handleClearHistory = async () => {\n    if (confirm(\"Clear all cost history? This cannot be undone.\")) {\n      await clearAllCosts();\n      setRefreshTrigger((prev) => prev + 1);\n    }\n  };\n\n  return (\n    <div>\n      {/* Current Simulation */}\n      {simCategorized && (\n        <CostCard title=\"Current Simulation\">\n          <div className=\"cpanel-section-hint\">Costs from this simulation run.</div>\n          <CostRow label=\"Text generations\" value={simCategorized.text.actual} />\n          <CostRow\n            label={`  \\u2514 ${simCategorized.text.count} requests`}\n            value={simCategorized.text.actual}\n          />\n          <CostRow label=\"Image generations\" value={simCategorized.image.actual} />\n          <CostRow\n            label={`  \\u2514 ${simCategorized.image.count} images`}\n            value={simCategorized.image.actual}\n          />\n          <CostRow label=\"Chronicle generations\" value={simCategorized.chronicle.actual} />\n          <CostRow\n            label={`  \\u2514 ${simCategorized.chronicle.count} steps`}\n            value={simCategorized.chronicle.actual}\n          />\n          <CostRow label=\"Dynamics generation\" value={simCategorized.dynamics.actual} />\n          <CostRow\n            label={`  \\u2514 ${simCategorized.dynamics.count} turns`}\n            value={simCategorized.dynamics.actual}\n          />\n          <CostRow label=\"Summary revision\" value={simCategorized.revision.actual} />\n          <CostRow\n            label={`  \\u2514 ${simCategorized.revision.count} batches`}\n            value={simCategorized.revision.actual}\n          />\n          <CostRow label=\"Simulation Total\" value={simulationCosts.totalActual} isTotal />\n        </CostCard>\n      )}\n\n      {/* Pending Queue */}\n      {queueCosts.total > 0 && (\n        <CostCard title=\"Pending Queue (Estimated)\">\n          <div className=\"cpanel-section-hint\">\n            Estimated costs for queued tasks not yet completed.\n          </div>\n          <CostRow label=\"Text generations\" value={queueCosts.textEstimated} isEstimated />\n          <CostRow label=\"Image generations\" value={queueCosts.imageEstimated} isEstimated />\n          <CostRow\n            label=\"Chronicle generations\"\n            value={queueCosts.chronicleEstimated}\n            isEstimated\n          />\n          <CostRow label=\"Queue Total\" value={queueCosts.total} isTotal isEstimated />\n        </CostCard>\n      )}\n\n      {/* By Model */}\n      {simulationCosts && Object.keys(simulationCosts.byModel).length > 0 && (\n        <CostCard title=\"By Model (Simulation)\">\n          <div className=\"cpanel-section-hint\">Cost breakdown by model used.</div>\n          {Object.entries(simulationCosts.byModel)\n            .sort((a, b) => b[1].actual - a[1].actual)\n            .map(([model, data]) => (\n              <CostRow key={model} label={model} value={data.actual} />\n            ))}\n        </CostCard>\n      )}\n\n      {/* Project Total */}\n      {projCategorized && (\n        <CostCard title=\"Project Total\">\n          <div className=\"cpanel-section-hint\">\n            Accumulated costs for this project across all simulations.\n          </div>\n          <CostRow label=\"Text generations\" value={projCategorized.text.actual} />\n          <CostRow label=\"Image generations\" value={projCategorized.image.actual} />\n          <CostRow label=\"Chronicle generations\" value={projCategorized.chronicle.actual} />\n          <CostRow label=\"Project Total\" value={projectCosts.totalActual} isTotal />\n        </CostCard>\n      )}\n\n      {/* All Time */}\n      {allCategorized && (\n        <CostCard title=\"All Time Total\">\n          <div className=\"cpanel-section-hint\">\n            Accumulated costs across all projects and sessions.\n          </div>\n          <CostRow label=\"Text generations\" value={allCategorized.text.actual} />\n          <CostRow label=\"Image generations\" value={allCategorized.image.actual} />\n          <CostRow label=\"Chronicle generations\" value={allCategorized.chronicle.actual} />\n          <CostRow label=\"All Time Total\" value={allTimeCosts.totalActual} isTotal />\n          <CostRow\n            label={`  \\u2514 ${allTimeCosts.count} total records`}\n            value={allTimeCosts.totalActual}\n          />\n\n          <button\n            onClick={() => void handleClearHistory()}\n            className=\"illuminator-button-link cpanel-clear-button\"\n          >\n            Clear History\n          </button>\n        </CostCard>\n      )}\n\n      {/* Empty state */}\n      {!simulationCosts && !allTimeCosts && queueCosts.total === 0 && (\n        <CostCard title=\"Cost Tracking\">\n          <div className=\"cpanel-empty-hint\">\n            No costs recorded yet. Costs will appear here as you generate content.\n          </div>\n        </CostCard>\n      )}\n    </div>\n  );\n}\n\nCostsPanel.propTypes = {\n  queue: PropTypes.array,\n  projectId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n  simulationRunId: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),\n};\n","numLines":330,"startLine":1,"totalLines":330}}}
