ianSetup({\n  applyReviewNotesForEntity,\n  applyEditionPatchesForEntity,\n  reloadEntities,\n  entityNavMap,\n}: BulkHistorianSetupProps): BulkHistorianSetupReturn {\n  const bulkHistorianDeps = useMemo(\n    () => ({\n      buildReviewContext: buildHistorianReviewContext,\n      buildEditionContext: buildHistorianEditionContext,\n      applyReviewNotes: applyReviewNotesForEntity,\n      applyEditionPatches: applyEditionPatchesForEntity,\n      reloadEntities,\n      getEntityNav: (entityId: string) => entityNavMap.get(entityId),\n    }),\n    [applyReviewNotesForEntity, applyEditionPatchesForEntity, reloadEntities, entityNavMap]\n  );"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":273,"cache_read_input_tokens":122968,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":273},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"14dbfbe3-6096-48ba-a3f8-d2acd1ea5980"}
