":7,"oldLines":63,"newStart":11,"newLines":24,"lines":["   flex-wrap: wrap;"," }"," ","+/* Compose with: ilu-compact-select */"," .cvs-select-version {","-  width: auto;","   min-width: 240px;","-  font-size: 12px;","-  padding: 4px 6px;"," }"," ","+/* Compose with: ilu-compact-select */"," .cvs-select-compare {","-  width: auto;","   min-width: 160px;","-  font-size: 12px;","-  padding: 4px 6px;"," }"," ","-.cvs-active-badge {","-  font-size: 11px;","-  padding: 2px 8px;","-  background: rgb(16 185 129 / 15%);","-  color: #10b981;","-  border-radius: 999px;","-  font-weight: 500;","-}","-","-.cvs-btn-make-active {","-  padding: 6px 12px;","-  font-size: 11px;","-  background: var(--bg-tertiary);","-  border: 1px solid var(--border-color);","-  border-radius: 6px;","-  color: var(--text-secondary);","-  cursor: pointer;","-}","-","-.cvs-btn-make-active:disabled {","-  cursor: not-allowed;","-  opacity: 0.6;","-}","-","+/* Compose with: ilu-action-btn-sm — adds transition for confirm animation */"," .cvs-btn-delete {","-  padding: 6px 12px;","-  font-size: 11px;","-  background: var(--bg-tertiary);","-  border: 1px solid var(--border-color);","-  border-radius: 6px;","-  color: var(--text-muted);","-  cursor: pointer;","   transition:","     background 0.15s,","     color 0.15s,","     border-color 0.15s;"," }"," ","-.cvs-btn-delete:disabled {","-  cursor: not-allowed;","-  opacity: 0.6;","-}","-"," .cvs-btn-delete-confirming {","   background: var(--error-color, #ef4444);","   border-color: var(--error-color, #ef4444);"]}],"originalFile":"/* ChronicleVersionSelector.css -- co-located styles for ChronicleVersionSelector.jsx */\n\n.cvs-container {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.cvs-select-version {\n  width: auto;\n  min-width: 240px;\n  font-size: 12px;\n  padding: 4px 6px;\n}\n\n.cvs-select-compare {\n  width: auto;\n  min-width: 160px;\n  font-size: 12px;\n  padding: 4px 6px;\n}\n\n.cvs-active-badge {\n  font-size: 11px;\n  padding: 2px 8px;\n  background: rgb(16 185 129 / 15%);\n  color: #10b981;\n  border-radius: 999px;\n  font-weight: 500;\n}\n\n.cvs-btn-make-active {\n  padding: 6px 12px;\n  font-size: 11px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-secondary);\n  cursor: pointer;\n}\n\n.cvs-btn-make-active:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.cvs-btn-delete {\n  padding: 6px 12px;\n  font-size: 11px;\n  background: var(--bg-tertiary);\n  border: 1px solid var(--border-color);\n  border-radius: 6px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition:\n    background 0.15s,\n    color 0.15s,\n    border-color 0.15s;\n}\n\n.cvs-btn-delete:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.cvs-btn-delete-confirming {\n  background: var(--error-color, #ef4444);\n  border-color: var(--error-color, #ef4444);\n  color: #fff;\n}\n"}}
