→  border-radius: var(--radius-sm);\n    68→  color: var(--color-text);\n    69→  font-size: var(--font-size-sm);\n    70→  outline: none;\n    71→}\n    72→\n    73→.dropdown-search-input:focus {\n    74→  border-color: var(--color-accent);\n    75→}\n    76→\n    77→/* Options list */\n    78→.dropdown-options {\n    79→  overflow-y: auto;\n    80→  flex: 1;\n    81→}\n    82→\n    83→.dropdown-option {\n    84→  padding: 6px var(--spacing-md);\n    85→  cursor: pointer;\n    86→  font-size: var(--font-size-sm);\n    87→  color: var(--color-text);\n    88→  transition: background-color 0.1s;\n    89→  display: flex;\n    90→  justify-content: space-between;\n    91→  align-items: center;\n    92→}\n    93→\n    94→.dropdown-option:hover {\n    95→  background-color: rgb(59 130 246 / 20%);\n    96→}\n    97→\n    98→.dropdown-option-selected {\n    99→  background-color: rgb(59 130 246 / 30%);\n   100→}\n   101→\n   102→.dropdown-option-meta {\n   103→  font-size: var(--font-size-xs);\n   104→  color: var(--color-text-dim);\n   105→}\n   106→\n   107→.dropdown-empty {\n   108→  padding: var(--spacing-md);\n   109→  text-align: center;\n   110→  color: var(--color-text-dim);\n   111→  font-size: var(--font-size-sm);\n   112→}\n   113→\n   114→/* Menu item (for type selection menus etc) */\n   115→.dropdown-menu-item {\n   116→  display: flex;\n   117→  align-items: center;\n   118→  gap: var(--spacing-sm);\n   119→  padding: 6px var(--spacing-md);\n   120→  cursor: pointer;\n   121→  transition: background-color var(--transition-fast);\n   122→}\n   123→\n   124→.dropdown-menu-item:hover {\n   125→  background-color: rgb(59 130 246 / 15%);\n   126→}\n   127→\n   128→.dropdown-menu-icon {\n   129→  width: 22px;\n   130→  height: 22px;\n   131→  border-radius: var(--radius-sm);\n   132→  display: flex;\n   133→  align-items: center;\n   134→  justify-content: center;\n   135→  font-size: var(--font-size-sm);\n   136→  flex-shrink: 0;\n   137→  line-height: 1;\n   138→}\n   139→\n   140→.dropdown-menu-label {\n   141→  font-size: var(--font-size-sm);\n   142→  color: var(--color-text);\n   143→}\n   144→\n   145→/* Upward dropdown variant - opens above the trigger */\n   146→.dropdown-menu-up {\n   147→  top: auto;\n   148→  bottom: 100%;\n   149→  margin-top: 0;\n   150→  margin-bottom: var(--spacing-xs);\n   151→}\n   152→"}]},"parent_tool_use_id":null,"session_id":"3b5ce8f0-862b-4723-9467-f6e56df17d06","uuid":"73db5f86-92f0-4d3b-acf6-0cc8a2a65ad8","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/styles/components/dropdown.css","content":"/**\n * Searchable dropdown styles\n */\n\n/* Dropdown container */\n.dropdown {\n  position: relative;\n}\n\n/* Trigger button */\n.dropdown-trigger {\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 8px;\n  background-color: var(--color-bg-dark);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-text);\n  font-size: var(--font-size-sm);\n}\n\n.dropdown-trigger:hover {\n  border-color: var(--color-border);\n}\n\n.dropdown-trigger-placeholder {\n  color: var(--color-text-dim);\n}\n\n.dropdown-arrow {\n  color: var(--color-text-dim);\n  font-size: 8px;\n  margin-left: var(--spacing-sm);\n}\n\n/* Dropdown menu */\n.dropdown-menu {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  margin-top: 2px;\n  background-color: var(--color-bg-dark);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  box-shadow: 0 8px 20px rgb(0 0 0 / 30%);\n  z-index: var(--z-dropdown);\n  max-height: 240px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Search box */\n.dropdown-search {\n  padding: var(--spacing-sm);\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.dropdown-search-input {\n  width: 100%;\n  padding: 5px 8px;\n  background-color: var(--color-bg);\n  border: 1px solid var(--color-border-light);\n  border-radius: var(--radius-sm);\n  color: var(--color-text);\n  font-size: var(--font-size-sm);\n  outline: none;\n}\n\n.dropdown-search-input:focus {\n  border-color: var(--color-accent);\n}\n\n/* Options list */\n.dropdown-options {\n  overflow-y: auto;\n  flex: 1;\n}\n\n.dropdown-option {\n  padding: 6px var(--spacing-md);\n  cursor: pointer;\n  font-size: var(--font-size-sm);\n  color: var(--color-text);\n  transition: background-color 0.1s;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.dropdown-option:hover {\n  background-color: rgb(59 130 246 / 20%);\n}\n\n.dropdown-option-selected {\n  background-color: rgb(59 130 246 / 30%);\n}\n\n.dropdown-option-meta {\n  font-size: var(--font-size-xs);\n  color: var(--color-text-dim);\n}\n\n.dropdown-empty {\n  padding: var(--spacing-md);\n  text-align: center;\n  color: var(--color-text-dim);\n  font-size: var(--font-size-sm);\n}\n\n/* Menu item (for type selection menus etc) */\n.dropdown-menu-item {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  padding: 6px var(--spacing-md);\n  cursor: pointer;\n  transition: background-color var(--transition-fast);\n}\n\n.dropdown-menu-item:hover {\n  background-color: rgb(59 130 246 / 15%);\n}\n\n.dropdown-menu-icon {\n  width: 22px;\n  height: 22px;\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: var(--font-size-sm);\n  flex-shrink: 0;\n  line-height: 1;\n}\n\n.dropdown-menu-label {\n  font-size: var(--font-size-sm);\n  color: var(--color-text);\n}\n\n/* Upward dropdown variant - opens above the trigger */\n.dropdown-menu-up {\n  top: auto;\n  bottom: 100%;\n  margin-top: 0;\n  margin-bottom: var(--spacing-xs);\n}\n","numLines":152,"startLine":1,"totalLines":152}}}
