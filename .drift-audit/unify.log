{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PoGJfxMLiy3bdS5LHmg3c8","type":"tool_result","content":"     1→/**\n     2→ * Shared Components for Canonry MFEs\n     3→ *\n     4→ * Re-exports UI components, form components, hooks, and utilities\n     5→ * that can be shared across all micro-frontends.\n     6→ *\n     7→ * CSS styles are available via: import '@the-canonry/shared-components/styles'\n     8→ */\n     9→\n    10→// Canonry-specific components\n    11→export { default as TagSelector } from './TagSelector.tsx';\n    12→\n    13→// Badge components\n    14→export { ToolUsageBadges } from './components/badges';\n    15→export { DetailUsageBadges } from './components/badges';\n    16→\n    17→// Schema usage utilities\n    18→export {\n    19→  computeUsageMap,\n    20→  computeSchemaUsage,\n    21→  getElementValidation,\n    22→  getUsageSummary,\n    23→  computeTagUsage,\n    24→  getEntityKindUsageSummary,\n    25→  getRelationshipKindUsageSummary,\n    26→} from './utils/schemaUsageMap';\n    27→\n    28→\n    29→// Form components\n    30→export { ReferenceDropdown } from './components/ReferenceDropdown';\n    31→export { ChipSelect } from './components/ChipSelect';\n    32→export { SearchableDropdown } from './components/SearchableDropdown';\n    33→export { LevelSelector, STRENGTH_LEVELS, PROMINENCE_LEVELS } from './components/LevelSelector';\n    34→export { NumberInput } from './components/NumberInput';\n    35→export { LocalTextArea } from './components/LocalTextArea';\n    36→\n    37→// Matrix components\n    38→export { CoverageMatrix } from './components/CoverageMatrix';\n    39→\n    40→// UI components\n    41→export { EnableToggle } from './components/EnableToggle';\n    42→export { IconButton } from './components/IconButton';\n    43→export { InfoBox } from './components/InfoBox';\n    44→export { SectionHeader } from './components/SectionHeader';\n    45→export { EmptyState } from './components/EmptyState';\n    46→export { CategorySection } from './components/CategorySection';\n    47→export { AddCard } from './components/AddCard';\n    48→export { AddItemButton } from './components/AddItemButton';\n    49→export { ModalShell } from './components/ModalShell';\n    50→export { ItemRow } from './components/ItemRow';\n    51→export { PressureChangesEditor } from './components/PressureChangesEditor';\n    52→export { ExpandableCard } from './components/ExpandableCard';\n    53→export { FormGroup, FormRow } from './components/FormGroup';\n    54→\n    55→// Validation display\n    56→export { ErrorBadge, OrphanBadge, TabValidationBadge } from './components/ValidationBadge';\n    57→export { EraBadges } from './components/EraBadges';\n    58→\n    59→// Chronicle seed viewer\n    60→export { default as ChronicleSeedViewer, SeedModal, ExpandableSeedSection } from './components/ChronicleSeedViewer';\n    61→\n    62→// Hooks\n    63→export { useLocalInputState } from './components/hooks/useLocalInputState';\n    64→export { useEditorState } from './components/hooks/useEditorState';\n    65→export { useKeyboardNavigation } from './components/hooks/useKeyboardNavigation';\n    66→\n    67→// Constants\n    68→export * from './constants';\n    69→"}]},"parent_tool_use_id":"toolu_013FSwbEV6QNKaRJ7a5qd8hC","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"59fb25e0-2d8e-4474-87bc-83aa5a5215d4"}
