-selector {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-md);\n}\n\n.level-selector-dots {\n  display: flex;\n  gap: var(--spacing-xs);\n}\n\n.level-selector-dot {\n  width: 12px;\n  height: 12px;\n  border-radius: var(--radius-full);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n  border: 2px solid transparent;\n  position: relative;\n  overflow: hidden;\n  background-color: var(--color-bg-card);\n}\n\n.level-selector-dot:hover {\n  transform: scale(1.2);\n}\n\n.level-selector-dot-fill {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  border-radius: var(--radius-full);\n  transition: height var(--transition-fast);\n}\n\n.level-selector-input {\n  width: 52px;\n  padding: 4px 6px;\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  color: var(--color-text);\n  text-align: center;\n  outline: none;\n}\n\n.level-selector-input:focus {\n  border-color: var(--color-accent);\n}\n","numLines":57,"startLine":1,"totalLines":57}}}
