e: 11px;\n   389→  color: var(--text-muted);\n   390→  display: block;\n   391→  margin-top: 4px;\n   392→}\n   393→\n   394→/* Quick actions */\n   395→.eb-quick-actions {\n   396→  display: flex;\n   397→  gap: 8px;\n   398→  flex-wrap: wrap;\n   399→}\n   400→\n   401→/* Selection actions bar */\n   402→.eb-selection-bar {\n   403→  display: flex;\n   404→  align-items: center;\n   405→  gap: 12px;\n   406→  padding: 12px 16px;\n   407→  margin-bottom: 16px;\n   408→  background: var(--bg-secondary);\n   409→  border: 1px solid var(--accent-color);\n   410→  border-radius: 6px;\n   411→  flex-wrap: wrap;\n   412→  flex-shrink: 0;\n   413→}\n   414→\n   415→.eb-selection-count {\n   416→  font-size: 13px;\n   417→}\n   418→\n   419→.eb-selection-btn {\n   420→  padding: 6px 12px;\n   421→  font-size: 12px;\n   422→}\n   423→\n   424→.eb-selection-clear {\n   425→  margin-left: auto;\n   426→}\n   427→\n   428→/* Entity list card */\n   429→.eb-list-card {\n   430→  padding: 0;\n   431→  flex: 1;\n   432→  min-height: 0;\n   433→  display: flex;\n   434→  flex-direction: column;\n   435→}\n   436→\n   437→/* Header row */\n   438→.eb-list-header {\n   439→  display: flex;\n   440→  align-items: center;\n   441→  gap: 12px;\n   442→  padding: 8px 12px;\n   443→  border-bottom: 1px solid var(--border-color);\n   444→  background: var(--bg-tertiary);\n   445→  flex-shrink: 0;\n   446→}\n   447→\n   448→.eb-list-header input {\n   449→  cursor: pointer;\n   450→}\n   451→\n   452→.eb-list-header-label {\n   453→  font-size: 12px;\n   454→  color: var(--text-muted);\n   455→}\n   456→\n   457→/* Scrollable entity list */\n   458→.eb-list-scroll {\n   459→  flex: 1;\n   460→  overflow-y: auto;\n   461→  min-height: 0;\n   462→}\n   463→\n   464→.eb-list-empty {\n   465→  padding: 40px;\n   466→  text-align: center;\n   467→  color: var(--text-muted);\n   468→}\n   469→\n   470→.eb-list-loading {\n   471→  padding: 16px;\n   472→  text-align: center;\n   473→  color: var(--text-muted);\n   474→  font-size: 12px;\n   475→}\n   476→\n   477→/* Settings card shrink */\n   478→.eb-settings-card {\n   479→  flex-shrink: 0;\n   480→}\n   481→"}]},"parent_tool_use_id":null,"session_id":"7b5b64fd-02b5-4d0c-8463-5e560f74a8b2","uuid":"c848ded3-99aa-4ea3-833d-a7b1c262016f","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/illuminator/webui/src/components/EntityBrowser.css","content":"/* EntityBrowser.css - Extracted from inline styles */\n\n/* ==========================================================================\n   HighlightMatch\n   ========================================================================== */\n\n.eb-highlight {\n  background: rgb(245 158 11 / 25%);\n  color: var(--text-primary);\n  font-weight: 600;\n  border-radius: 2px;\n  padding: 0 1px;\n}\n\n/* ==========================================================================\n   ImageThumbnail\n   ========================================================================== */\n\n.eb-thumb {\n  width: 80px;\n  height: 80px;\n  border-radius: 4px;\n  background: var(--bg-tertiary);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text-muted);\n  font-size: 10px;\n}\n\n.eb-thumb-clickable {\n  cursor: pointer;\n}\n\n.eb-thumb-img {\n  width: 80px;\n  height: 80px;\n  object-fit: cover;\n  border-radius: 4px;\n}\n\n/* ==========================================================================\n   EnrichmentStatusBadge\n   ========================================================================== */\n\n.eb-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 500;\n}\n\n.eb-badge-missing {\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n}\n\n.eb-badge-queued {\n  background: #3b82f6;\n  color: white;\n}\n\n.eb-badge-running {\n  background: #f59e0b;\n  color: white;\n}\n\n.eb-badge-complete {\n  background: #10b981;\n  color: white;\n}\n\n.eb-badge-error {\n  background: #ef4444;\n  color: white;\n}\n\n.eb-badge-disabled {\n  background: var(--bg-tertiary);\n  color: var(--text-muted);\n  opacity: 0.5;\n}\n\n.eb-badge-cost {\n  opacity: 0.8;\n  margin-left: 2px;\n}\n\n/* ==========================================================================\n   EntityRow\n   ========================================================================== */\n\n.eb-row {\n  display: grid;\n  grid-template-columns: 32px 1fr auto;\n  gap: 12px;\n  padding: 12px;\n  border-bottom: 1px solid var(--border-color);\n  align-items: start;\n}\n\n.eb-row-checkbox {\n  padding-top: 2px;\n}\n\n.eb-row-checkbox input {\n  cursor: pointer;\n}\n\n.eb-row-name {\n  font-weight: 500;\n  margin-bottom: 4px;\n  cursor: pointer;\n  color: var(--accent-color);\n}\n\n.eb-row-meta {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.eb-row-edition-count {\n  font-size: 10px;\n}\n\n.eb-row-edition-count-many {\n  color: #10b981;\n}\n\n.eb-row-edition-count-few {\n  color: #f59e0b;\n}\n\n/* Inline action buttons that also use .illuminator-button get padding/font overrides */\n.eb-row-btn-sm {\n  padding: 2px 8px;\n  font-size: 10px;\n}\n\n.eb-row-btn-sm-danger {\n  color: #ef4444;\n}\n\n/* Content row: description and image side by side */\n.eb-row-content {\n  display: flex;\n  gap: 12px;\n}\n\n.eb-row-summary {\n  flex: 1;\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 8px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  max-height: 80px;\n  overflow: hidden;\n  cursor: pointer;\n}\n\n/* Actions column */\n.eb-row-actions {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  align-items: flex-end;\n}\n\n.eb-row-action-group {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.eb-row-action-group-wrap {\n  flex-wrap: wrap;\n}\n\n.eb-row-needs-desc {\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.eb-row-action-btn {\n  padding: 4px 8px;\n  font-size: 11px;\n}\n\n/* ==========================================================================\n   EntityBrowser - Main layout\n   ========================================================================== */\n\n.eb {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  min-height: 0;\n}\n\n.eb-entity-count {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eb-add-entity-btn {\n  padding: 4px 10px;\n  font-size: 11px;\n  margin-left: 8px;\n}\n\n/* Search bar */\n.eb-search-wrap {\n  position: relative;\n  margin-bottom: 10px;\n}\n\n.eb-search-row {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n}\n\n.eb-search-input {\n  flex: 1;\n  padding: 6px 10px;\n  font-size: 12px;\n  box-sizing: border-box;\n}\n\n.eb-search-text-label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: var(--text-muted);\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n/* Search dropdown */\n.eb-search-dropdown {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  margin-top: 4px;\n  background: var(--bg-primary);\n  border: 1px solid var(--border-color);\n  border-radius: 8px;\n  box-shadow: 0 8px 32px rgb(0 0 0 / 30%);\n  z-index: 200;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.eb-search-empty {\n  padding: 16px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n.eb-search-count {\n  padding: 6px 12px;\n  font-size: 10px;\n  color: var(--text-muted);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.eb-search-result {\n  padding: 8px 12px;\n  cursor: pointer;\n  border-bottom: 1px solid var(--border-color);\n}\n\n.eb-search-result:hover {\n  background: var(--bg-tertiary);\n}\n\n.eb-search-result-name {\n  font-size: 13px;\n  color: var(--text-primary);\n  margin-bottom: 2px;\n}\n\n.eb-search-result-kind {\n  margin-left: 6px;\n  font-size: 10px;\n  color: var(--text-muted);\n}\n\n.eb-search-match-row {\n  font-size: 11px;\n  color: var(--text-muted);\n  margin-top: 1px;\n}\n\n.eb-search-match-field {\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  margin-right: 6px;\n  color: var(--text-muted);\n  opacity: 0.7;\n}\n\n.eb-search-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 199;\n}\n\n/* Filters grid */\n.eb-filters {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));\n  gap: 8px;\n  margin-bottom: 12px;\n}\n\n.eb-hide-completed-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  cursor: pointer;\n  padding: 6px 8px;\n}\n\n/* Enrichment settings bar */\n.eb-enrichment-settings {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 8px 12px;\n  background: var(--bg-tertiary);\n  border-radius: 4px;\n  margin-bottom: 12px;\n  flex-wrap: wrap;\n}\n\n.eb-enrichment-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.eb-enrichment-select {\n  width: auto;\n  min-width: 100px;\n}\n\n.eb-enrichment-hint {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* Min Event Significance */\n.eb-event-significance {\n  margin-bottom: 12px;\n}\n\n.eb-event-significance-label {\n  display: block;\n  margin-bottom: 4px;\n  font-size: 12px;\n  color: var(--text-secondary);\n}\n\n.eb-event-significance-select {\n  width: 100%;\n  padding: 6px 8px;\n  border-radius: 4px;\n  border: 1px solid var(--border-color);\n  background: var(--bg-primary);\n  color: var(--text-primary);\n  font-size: 13px;\n}\n\n.eb-event-significance-hint {\n  font-size: 11px;\n  color: var(--text-muted);\n  display: block;\n  margin-top: 4px;\n}\n\n/* Quick actions */\n.eb-quick-actions {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n/* Selection actions bar */\n.eb-selection-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 16px;\n  margin-bottom: 16px;\n  background: var(--bg-secondary);\n  border: 1px solid var(--accent-color);\n  border-radius: 6px;\n  flex-wrap: wrap;\n  flex-shrink: 0;\n}\n\n.eb-selection-count {\n  font-size: 13px;\n}\n\n.eb-selection-btn {\n  padding: 6px 12px;\n  font-size: 12px;\n}\n\n.eb-selection-clear {\n  margin-left: auto;\n}\n\n/* Entity list card */\n.eb-list-card {\n  padding: 0;\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n/* Header row */\n.eb-list-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--border-color);\n  background: var(--bg-tertiary);\n  flex-shrink: 0;\n}\n\n.eb-list-header input {\n  cursor: pointer;\n}\n\n.eb-list-header-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Scrollable entity list */\n.eb-list-scroll {\n  flex: 1;\n  overflow-y: auto;\n  min-height: 0;\n}\n\n.eb-list-empty {\n  padding: 40px;\n  text-align: center;\n  color: var(--text-muted);\n}\n\n.eb-list-loading {\n  padding: 16px;\n  text-align: center;\n  color: var(--text-muted);\n  font-size: 12px;\n}\n\n/* Settings card shrink */\n.eb-settings-card {\n  flex-shrink: 0;\n}\n","numLines":481,"startLine":1,"totalLines":481}}}
