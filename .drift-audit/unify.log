ties: CultureIdentities) => void;\n}\n\n// ============================================================================\n// Hook\n// ============================================================================\n\nexport default function useEntityGuidanceSync({\n  externalEntityGuidance,\n  onEntityGuidanceChange,\n  externalCultureIdentities,\n  onCultureIdentitiesChange,\n}: UseEntityGuidanceSyncProps): UseEntityGuidanceSyncReturn {\n  const [localEntityGuidance, setLocalEntityGuidance] = useState<EntityGuidance>(createDefaultEntityGuidance);\n  const [localCultureIdentities, setLocalCultureIdentities] = useState<CultureIdentities>(\n    createDefaultCultureIdentities\n  );\n  const pendingEntityGuidanceRef = useRef<EntityGuidance>(localEntityGuidance);\n  const pendingCultureIdentitiesRef = useRef<CultureIdentities>(localCultureIdentities);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1461,"cache_read_input_tokens":78000,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1461},"output_tokens":24,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_012c2KGLXcyo6imx9xax9A55","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"2f8c7ef4-9ec6-42d4-9487-c97674676be8"}
