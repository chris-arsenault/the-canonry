{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGX336UwZQJrZo4Qz6VesZ","type":"tool_result","content":"     1→/**\n     2→ * CoherenceEngineRemote - Module Federation entry point for Coherence Engine\n     3→ *\n     4→ * This component is loaded by The Canonry shell and receives:\n     5→ * - schema: Read-only world schema (entityKinds, relationshipKinds, cultures)\n     6→ * - eras: Array of era configurations\n     7→ * - onErasChange: Callback when eras are modified\n     8→ * - activeSection: Current navigation section\n     9→ * - onSectionChange: Callback when navigation changes\n    10→ *\n    11→ * The Coherence Engine provides configuration and validation tools for\n    12→ * world simulation parameters: pressures, eras, generators, actions, and systems.\n    13→ */\n    14→\n    15→import React, { useMemo } from \"react\";\n    16→import PropTypes from \"prop-types\";\n    17→import \"@the-canonry/shared-components/styles\";\n    18→import \"./styles/index.css\";\n    19→import \"./CoherenceEngineRemote.css\";\n    20→import { ErasEditor } from \"./components/eras\";\n    21→import PressuresEditor from \"./components/PressuresEditor\";\n    22→import GeneratorsEditor from \"./components/GeneratorsEditor\";\n    23→import ActionsEditor from \"./components/ActionsEditor\";\n    24→import SystemsEditor from \"./components/SystemsEditor\";\n    25→import ValidationEditor, { getValidationStatus } from \"./components/ValidationEditor\";\n    26→import { WeightMatrixEditor } from \"./components/weight-matrix\";\n    27→import CausalLoopEditor from \"./components/CausalLoopEditor\";\n    28→import { computeUsageMap } from \"@the-canonry/shared-components\";\n    29→\n    30→const TABS = [\n    31→  { id: \"validation\", label: \"Validation\" },\n    32→  { id: \"causal\", label: \"Causal Loop\" },\n    33→  { id: \"pressures\", label: \"Pressures\" },\n    34→  { id: \"eras\", label: \"Eras\" },\n    35→  { id: \"matrix\", label: \"Weight Matrix\" },\n    36→  { id: \"generators\", label: \"Generators\" },\n    37→  { id: \"actions\", label: \"Actions\" },\n    38→  { id: \"systems\", label: \"Systems\" },\n    39→];\n    40→\n    41→// Validation status colors\n    42→const STATUS_COLORS = {\n    43→  clean: \"#22c55e\",\n    44→  warning: \"#f59e0b\",\n    45→  error: \"#ef4444\",\n    46→};\n    47→\n    48→// Placeholder descriptions for each section\n    49→const SECTION_INFO = {\n    50→  validation: {\n    51→    title: \"Validation\",\n    52→    description:\n    53→      \"Pre-run validation checks for your world configuration. View and fix issues before running the simulation.\",\n    54→  },\n    55→  causal: {\n    56→    title: \"Causal Loop Diagram\",\n    57→    description:\n    58→      \"Visualize feedback relationships between pressures, generators, systems, and entity kinds. Identify reinforcing and balancing loops.\",\n    59→  },\n    60→  pressures: {\n    61→    title: \"Pressures\",\n    62→    description:\n    63→      \"Configure environmental and social pressures that drive world evolution. Pressures create constraints and opportunities that shape entity behavior.\",\n    64→  },\n    65→  eras: {\n    66→    title: \"Eras\",\n    67→    description:\n    68→      \"Define historical eras and their characteristics. Eras determine which templates and systems are active during different phases of world generation.\",\n    69→  },\n    70→  matrix: {\n    71→    title: \"Weight Matrix\",\n    72→    description:\n    73→      \"Spreadsheet view for managing generator and system weights across all eras. Quickly assign weights, copy configurations, and identify gaps.\",\n    74→  },\n    75→  generators: {\n    76→    title: \"Generators\",\n    77→    description:\n    78→      \"Configure entity generators (growth templates) that populate the world. Each generator creates entities with specific characteristics and relationships.\",\n    79→  },\n    80→  actions: {\n    81→    title: \"Actions\",\n    82→    description:\n    83→      \"Define the action domains available to entities. Actions determine how entities interact with each other and the world.\",\n    84→  },\n    85→  systems: {\n    86→    title: \"Systems\",\n    87→    description:\n    88→      \"Configure simulation systems that run during the simulation phase. Systems create relationships and modify entity states based on world conditions.\",\n    89→  },\n    90→};\n    91→\n    92→export default function CoherenceEngineRemote({\n    93→  projectId,\n    94→  schema,\n    95→  eras = [],\n    96→  onErasChange,\n    97→  pressures = [],\n    98→  onPressuresChange,\n    99→  generators = [],\n   100→  onGeneratorsChange,\n   101→  actions = [],\n   102→  onActionsChange,\n   103→  systems = [],\n   104→  onSystemsChange,\n   105→  activeSection,\n   106→  onSectionChange,\n   107→}) {\n   108→  // Use passed-in section or default to 'validation'\n   109→  const activeTab = activeSection || \"validation\";\n   110→  const setActiveTab = onSectionChange || (() => {});\n   111→\n   112→  const currentSection = SECTION_INFO[activeTab] || SECTION_INFO.validation;\n   113→\n   114→  // Compute usage map for cross-reference tracking and validation (must be before validationStatus)\n   115→  const usageMap = useMemo(\n   116→    () => computeUsageMap(schema, pressures, eras, generators, systems, actions),\n   117→    [schema, pressures, eras, generators, systems, actions]\n   118→  );\n   119→\n   120→  // Calculate validation status for the nav indicator (uses usageMap)\n   121→  const validationStatus = useMemo(\n   122→    () => getValidationStatus(usageMap, schema, eras, pressures, generators, systems),\n   123→    [usageMap, schema, eras, pressures, generators, systems]\n   124→  );\n   125→\n   126→  // Navigate to generators tab and optionally select a specific generator\n   127→  const handleNavigateToGenerator = (_generatorId) => {\n   128→    setActiveTab(\"generators\");\n   129→    // NOOP: generator expansion not yet implemented\n   130→  };\n   131→\n   132→  const renderContent = () => {\n   133→    switch (activeTab) {\n   134→      case \"validation\":\n   135→        return (\n   136→          <ValidationEditor\n   137→            schema={schema}\n   138→            eras={eras}\n   139→            pressures={pressures}\n   140→            generators={generators}\n   141→            systems={systems}\n   142→            actions={actions}\n   143→            usageMap={usageMap}\n   144→            onNavigateToGenerator={handleNavigateToGenerator}\n   145→          />\n   146→        );\n   147→      case \"causal\":\n   148→        return (\n   149→          <CausalLoopEditor\n   150→            pressures={pressures}\n   151→            generators={generators}\n   152→            systems={systems}\n   153→            actions={actions}\n   154→            schema={schema}\n   155→            usageMap={usageMap}\n   156→          />\n   157→        );\n   158→      case \"pressures\":\n   159→        return (\n   160→          <PressuresEditor\n   161→            projectId={projectId}\n   162→            pressures={pressures}\n   163→            onChange={onPressuresChange || (() => {})}\n   164→            schema={schema}\n   165→            usageMap={usageMap}\n   166→          />\n   167→        );\n   168→      case \"eras\":\n   169→        return (\n   170→          <ErasEditor\n   171→            eras={eras}\n   172→            onChange={onErasChange || (() => {})}\n   173→            generators={generators}\n   174→            systems={systems}\n   175→            pressures={pressures}\n   176→            schema={schema}\n   177→            usageMap={usageMap}\n   178→          />\n   179→        );\n   180→      case \"matrix\":\n   181→        return (\n   182→          <WeightMatrixEditor\n   183→            generators={generators}\n   184→            systems={systems}\n   185→            eras={eras}\n   186→            onErasChange={onErasChange || (() => {})}\n   187→          />\n   188→        );\n   189→      case \"generators\":\n   190→        return (\n   191→          <GeneratorsEditor\n   192→            projectId={projectId}\n   193→            generators={generators}\n   194→            onChange={onGeneratorsChange || (() => {})}\n   195→            schema={schema}\n   196→            pressures={pressures}\n   197→            eras={eras}\n   198→            usageMap={usageMap}\n   199→          />\n   200→        );\n   201→      case \"actions\":\n   202→        return (\n   203→          <ActionsEditor\n   204→            projectId={projectId}\n   205→            actions={actions}\n   206→            onChange={onActionsChange || (() => {})}\n   207→            schema={schema}\n   208→            pressures={pressures}\n   209→            usageMap={usageMap}\n   210→          />\n   211→        );\n   212→      case \"systems\":\n   213→        return (\n   214→          <SystemsEditor\n   215→            projectId={projectId}\n   216→            systems={systems}\n   217→            onChange={onSystemsChange || (() => {})}\n   218→            schema={schema}\n   219→            pressures={pressures}\n   220→            usageMap={usageMap}\n   221→          />\n   222→        );\n   223→      default:\n   224→        return (\n   225→          <div className=\"cer-placeholder\">\n   226→            <div className=\"cer-placeholder-icon\"></div>\n   227→            <div className=\"cer-placeholder-title\">{currentSection.title}</div>\n   228→            <div className=\"cer-placeholder-desc\">{currentSection.description}</div>\n   229→          </div>\n   230→        );\n   231→    }\n   232→  };\n   233→\n   234→  return (\n   235→    <div className=\"cer-container\">\n   236→      {/* Left sidebar with nav */}\n   237→      <div className=\"cer-sidebar\">\n   238→        <nav className=\"cer-nav\">\n   239→          {TABS.map((tab) => {\n   240→            // Show status indicator for validation tab\n   241→            const showStatus = tab.id === \"validation\";\n   242→            const statusColor = STATUS_COLORS[validationStatus.status];\n   243→\n   244→            return (\n   245→              <button\n   246→                key={tab.id}\n   247→                onClick={() => setActiveTab(tab.id)}\n   248→                className={`cer-nav-button ${activeTab === tab.id ? \"cer-nav-button-active\" : \"cer-nav-button-inactive\"}`}\n   249→              >\n   250→                <span className=\"cer-nav-button-content\">\n   251→                  <span>{tab.label}</span>\n   252→                  {showStatus && (\n   253→                    <span\n   254→                      className=\"cer-status-dot\"\n   255→                      // eslint-disable-next-line local/no-inline-styles -- dynamic color from validation status\n   256→                      style={{ '--cer-status-color': statusColor, backgroundColor: 'var(--cer-status-color)' }}\n   257→                      title={(() => {\n   258→                        if (validationStatus.status === \"clean\") return \"All validations passed\";\n   259→                        const plural = validationStatus.totalIssues === 1 ? \"\" : \"s\";\n   260→                        return `${validationStatus.totalIssues} issue${plural}`;\n   261→                      })()}\n   262→                    />\n   263→                  )}\n   264→                </span>\n   265→              </button>\n   266→            );\n   267→          })}\n   268→        </nav>\n   269→      </div>\n   270→\n   271→      {/* Main content area */}\n   272→      <div className=\"cer-main\">\n   273→        <div className=\"cer-content\">{renderContent()}</div>\n   274→      </div>\n   275→    </div>\n   276→  );\n   277→}\n   278→\n   279→CoherenceEngineRemote.propTypes = {\n   280→  projectId: PropTypes.string,\n   281→  schema: PropTypes.object,\n   282→  eras: PropTypes.array,\n   283→  onErasChange: PropTypes.func,\n   284→  pressures: PropTypes.array,\n   285→  onPressuresChange: PropTypes.func,\n   286→  generators: PropTypes.array,\n   287→  onGeneratorsChange: PropTypes.func,\n   288→  actions: PropTypes.array,\n   289→  onActionsChange: PropTypes.func,\n   290→  systems: PropTypes.array,\n   291→  onSystemsChange: PropTypes.func,\n   292→  activeSection: PropTypes.string,\n   293→  onSectionChange: PropTypes.func,\n   294→};\n   295→"}]},"parent_tool_use_id":null,"session_id":"812a01ec-29f8-4366-9586-7e3a066a23eb","uuid":"f47d6e66-c240-486f-b611-a6f44246fc6b","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/apps/coherence-engine/webui/src/CoherenceEngineRemote.jsx","content":"/**\n * CoherenceEngineRemote - Module Federation entry point for Coherence Engine\n *\n * This component is loaded by The Canonry shell and receives:\n * - schema: Read-only world schema (entityKinds, relationshipKinds, cultures)\n * - eras: Array of era configurations\n * - onErasChange: Callback when eras are modified\n * - activeSection: Current navigation section\n * - onSectionChange: Callback when navigation changes\n *\n * The Coherence Engine provides configuration and validation tools for\n * world simulation parameters: pressures, eras, generators, actions, and systems.\n */\n\nimport React, { useMemo } from \"react\";\nimport PropTypes from \"prop-types\";\nimport \"@the-canonry/shared-components/styles\";\nimport \"./styles/index.css\";\nimport \"./CoherenceEngineRemote.css\";\nimport { ErasEditor } from \"./components/eras\";\nimport PressuresEditor from \"./components/PressuresEditor\";\nimport GeneratorsEditor from \"./components/GeneratorsEditor\";\nimport ActionsEditor from \"./components/ActionsEditor\";\nimport SystemsEditor from \"./components/SystemsEditor\";\nimport ValidationEditor, { getValidationStatus } from \"./components/ValidationEditor\";\nimport { WeightMatrixEditor } from \"./components/weight-matrix\";\nimport CausalLoopEditor from \"./components/CausalLoopEditor\";\nimport { computeUsageMap } from \"@the-canonry/shared-components\";\n\nconst TABS = [\n  { id: \"validation\", label: \"Validation\" },\n  { id: \"causal\", label: \"Causal Loop\" },\n  { id: \"pressures\", label: \"Pressures\" },\n  { id: \"eras\", label: \"Eras\" },\n  { id: \"matrix\", label: \"Weight Matrix\" },\n  { id: \"generators\", label: \"Generators\" },\n  { id: \"actions\", label: \"Actions\" },\n  { id: \"systems\", label: \"Systems\" },\n];\n\n// Validation status colors\nconst STATUS_COLORS = {\n  clean: \"#22c55e\",\n  warning: \"#f59e0b\",\n  error: \"#ef4444\",\n};\n\n// Placeholder descriptions for each section\nconst SECTION_INFO = {\n  validation: {\n    title: \"Validation\",\n    description:\n      \"Pre-run validation checks for your world configuration. View and fix issues before running the simulation.\",\n  },\n  causal: {\n    title: \"Causal Loop Diagram\",\n    description:\n      \"Visualize feedback relationships between pressures, generators, systems, and entity kinds. Identify reinforcing and balancing loops.\",\n  },\n  pressures: {\n    title: \"Pressures\",\n    description:\n      \"Configure environmental and social pressures that drive world evolution. Pressures create constraints and opportunities that shape entity behavior.\",\n  },\n  eras: {\n    title: \"Eras\",\n    description:\n      \"Define historical eras and their characteristics. Eras determine which templates and systems are active during different phases of world generation.\",\n  },\n  matrix: {\n    title: \"Weight Matrix\",\n    description:\n      \"Spreadsheet view for managing generator and system weights across all eras. Quickly assign weights, copy configurations, and identify gaps.\",\n  },\n  generators: {\n    title: \"Generators\",\n    description:\n      \"Configure entity generators (growth templates) that populate the world. Each generator creates entities with specific characteristics and relationships.\",\n  },\n  actions: {\n    title: \"Actions\",\n    description:\n      \"Define the action domains available to entities. Actions determine how entities interact with each other and the world.\",\n  },\n  systems: {\n    title: \"Systems\",\n    description:\n      \"Configure simulation systems that run during the simulation phase. Systems create relationships and modify entity states based on world conditions.\",\n  },\n};\n\nexport default function CoherenceEngineRemote({\n  projectId,\n  schema,\n  eras = [],\n  onErasChange,\n  pressures = [],\n  onPressuresChange,\n  generators = [],\n  onGeneratorsChange,\n  actions = [],\n  onActionsChange,\n  systems = [],\n  onSystemsChange,\n  activeSection,\n  onSectionChange,\n}) {\n  // Use passed-in section or default to 'validation'\n  const activeTab = activeSection || \"validation\";\n  const setActiveTab = onSectionChange || (() => {});\n\n  const currentSection = SECTION_INFO[activeTab] || SECTION_INFO.validation;\n\n  // Compute usage map for cross-reference tracking and validation (must be before validationStatus)\n  const usageMap = useMemo(\n    () => computeUsageMap(schema, pressures, eras, generators, systems, actions),\n    [schema, pressures, eras, generators, systems, actions]\n  );\n\n  // Calculate validation status for the nav indicator (uses usageMap)\n  const validationStatus = useMemo(\n    () => getValidationStatus(usageMap, schema, eras, pressures, generators, systems),\n    [usageMap, schema, eras, pressures, generators, systems]\n  );\n\n  // Navigate to generators tab and optionally select a specific generator\n  const handleNavigateToGenerator = (_generatorId) => {\n    setActiveTab(\"generators\");\n    // NOOP: generator expansion not yet implemented\n  };\n\n  const renderContent = () => {\n    switch (activeTab) {\n      case \"validation\":\n        return (\n          <ValidationEditor\n            schema={schema}\n            eras={eras}\n            pressures={pressures}\n            generators={generators}\n            systems={systems}\n            actions={actions}\n            usageMap={usageMap}\n            onNavigateToGenerator={handleNavigateToGenerator}\n          />\n        );\n      case \"causal\":\n        return (\n          <CausalLoopEditor\n            pressures={pressures}\n            generators={generators}\n            systems={systems}\n            actions={actions}\n            schema={schema}\n            usageMap={usageMap}\n          />\n        );\n      case \"pressures\":\n        return (\n          <PressuresEditor\n            projectId={projectId}\n            pressures={pressures}\n            onChange={onPressuresChange || (() => {})}\n            schema={schema}\n            usageMap={usageMap}\n          />\n        );\n      case \"eras\":\n        return (\n          <ErasEditor\n            eras={eras}\n            onChange={onErasChange || (() => {})}\n            generators={generators}\n            systems={systems}\n            pressures={pressures}\n            schema={schema}\n            usageMap={usageMap}\n          />\n        );\n      case \"matrix\":\n        return (\n          <WeightMatrixEditor\n            generators={generators}\n            systems={systems}\n            eras={eras}\n            onErasChange={onErasChange || (() => {})}\n          />\n        );\n      case \"generators\":\n        return (\n          <GeneratorsEditor\n            projectId={projectId}\n            generators={generators}\n            onChange={onGeneratorsChange || (() => {})}\n            schema={schema}\n            pressures={pressures}\n            eras={eras}\n            usageMap={usageMap}\n          />\n        );\n      case \"actions\":\n        return (\n          <ActionsEditor\n            projectId={projectId}\n            actions={actions}\n            onChange={onActionsChange || (() => {})}\n            schema={schema}\n            pressures={pressures}\n            usageMap={usageMap}\n          />\n        );\n      case \"systems\":\n        return (\n          <SystemsEditor\n            projectId={projectId}\n            systems={systems}\n            onChange={onSystemsChange || (() => {})}\n            schema={schema}\n            pressures={pressures}\n            usageMap={usageMap}\n          />\n        );\n      default:\n        return (\n          <div className=\"cer-placeholder\">\n            <div className=\"cer-placeholder-icon\"></div>\n            <div className=\"cer-placeholder-title\">{currentSection.title}</div>\n            <div className=\"cer-placeholder-desc\">{currentSection.description}</div>\n          </div>\n        );\n    }\n  };\n\n  return (\n    <div className=\"cer-container\">\n      {/* Left sidebar with nav */}\n      <div className=\"cer-sidebar\">\n        <nav className=\"cer-nav\">\n          {TABS.map((tab) => {\n            // Show status indicator for validation tab\n            const showStatus = tab.id === \"validation\";\n            const statusColor = STATUS_COLORS[validationStatus.status];\n\n            return (\n              <button\n                key={tab.id}\n                onClick={() => setActiveTab(tab.id)}\n                className={`cer-nav-button ${activeTab === tab.id ? \"cer-nav-button-active\" : \"cer-nav-button-inactive\"}`}\n              >\n                <span className=\"cer-nav-button-content\">\n                  <span>{tab.label}</span>\n                  {showStatus && (\n                    <span\n                      className=\"cer-status-dot\"\n                      // eslint-disable-next-line local/no-inline-styles -- dynamic color from validation status\n                      style={{ '--cer-status-color': statusColor, backgroundColor: 'var(--cer-status-color)' }}\n                      title={(() => {\n                        if (validationStatus.status === \"clean\") return \"All validations passed\";\n                        const plural = validationStatus.totalIssues === 1 ? \"\" : \"s\";\n                        return `${validationStatus.totalIssues} issue${plural}`;\n                      })()}\n                    />\n                  )}\n                </span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Main content area */}\n      <div className=\"cer-main\">\n        <div className=\"cer-content\">{renderContent()}</div>\n      </div>\n    </div>\n  );\n}\n\nCoherenceEngineRemote.propTypes = {\n  projectId: PropTypes.string,\n  schema: PropTypes.object,\n  eras: PropTypes.array,\n  onErasChange: PropTypes.func,\n  pressures: PropTypes.array,\n  onPressuresChange: PropTypes.func,\n  generators: PropTypes.array,\n  onGeneratorsChange: PropTypes.func,\n  actions: PropTypes.array,\n  onActionsChange: PropTypes.func,\n  systems: PropTypes.array,\n  onSystemsChange: PropTypes.func,\n  activeSection: PropTypes.string,\n  onSectionChange: PropTypes.func,\n};\n","numLines":295,"startLine":1,"totalLines":295}}}
