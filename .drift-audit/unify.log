{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P4TQ6ZnAHucC7Qh7cSkYbW","type":"tool_result","content":"     1→/**\n     2→ * CoverageMatrix - Generic matrix component for visualizing coverage/relationships\n     3→ *\n     4→ * A reusable spreadsheet-style grid that shows relationships between two sets of items.\n     5→ * Used for:\n     6→ * - Profiles × Entity Kinds (Name Forge)\n     7→ * - Relationship Kinds × Entity Kinds (Canonry)\n     8→ * - And other coverage/relationship visualizations\n     9→ *\n    10→ * Props:\n    11→ * - rows: Array of row items with { id, label, group?, groupLabel?, metadata? }\n    12→ * - columns: Array of column items (strings or { id, label })\n    13→ * - getCellValue: (rowId, columnId) => 'none' | 'primary' | 'secondary' | 'both' | custom string\n    14→ * - getCellDisplay: (value, rowId, columnId) => { icon, className, title }\n    15→ * - onRowClick: (rowId, row) => void\n    16→ * - onCellClick: (rowId, columnId, value) => void\n    17→ * - title: string\n    18→ * - subtitle: string\n    19→ * - stats: Array of { label, value, variant? }\n    20→ * - legend: Array of { icon, label, className }\n    21→ * - searchPlaceholder: string\n    22→ * - groupByField: string (optional, groups rows by this field)\n    23→ * - columnHeaderClass: (columnId) => string (optional, for styling column headers)\n    24→ */\n    25→\n    26→import React, { useState, useMemo, useCallback } from 'react';\n    27→import './CoverageMatrix.css';\n    28→\n    29→interface StatusBadge {\n    30→  label: string;\n    31→  variant?: string;\n    32→}\n    33→\n    34→interface MatrixRowData {\n    35→  id: string;\n    36→  label: string;\n    37→  group?: string;\n    38→  groupLabel?: string;\n    39→  statusBadges?: StatusBadge[];\n    40→  [key: string]: unknown;\n    41→}\n    42→\n    43→interface MatrixColumn {\n    44→  id: string;\n    45→  label: string;\n    46→}\n    47→\n    48→interface CellDisplay {\n    49→  icon: string;\n    50→  className?: string;\n    51→  title: string;\n    52→}\n    53→\n    54→interface StatItem {\n    55→  label: string;\n    56→  value: string | number;\n    57→  variant?: string;\n    58→}\n    59→\n    60→interface LegendItem {\n    61→  icon: string;\n    62→  label: string;\n    63→  className?: string;\n    64→}\n    65→\n    66→interface FilterOption {\n    67→  id: string;\n    68→  label: string;\n    69→  filter?: (row: MatrixRowData) => boolean;\n    70→}\n    71→\n    72→interface MatrixRowProps {\n    73→  row: MatrixRowData;\n    74→  idx: number;\n    75→  groupId: string;\n    76→  groupLabel: string;\n    77→  columns: MatrixColumn[];\n    78→  getCellValue: (rowId: string, columnId: string, row: MatrixRowData) => string;\n    79→  displayFn: (value: string, rowId: string, columnId: string) => CellDisplay;\n    80→  onRowClick?: (rowId: string, row: MatrixRowData) => void;\n    81→  onCellClick?: (rowId: string, columnId: string, value: string) => void;\n    82→}\n    83→\n    84→interface CoverageMatrixProps {\n    85→  rows?: MatrixRowData[];\n    86→  columns?: (string | MatrixColumn)[];\n    87→  getCellValue: (rowId: string, columnId: string, row: MatrixRowData) => string;\n    88→  getCellDisplay?: (value: string, rowId: string, columnId: string) => CellDisplay;\n    89→  onRowClick?: (rowId: string, row: MatrixRowData) => void;\n    90→  onCellClick?: (rowId: string, columnId: string, value: string) => void;\n    91→  title?: string;\n    92→  subtitle?: string;\n    93→  stats?: StatItem[];\n    94→  legend?: LegendItem[];\n    95→  searchPlaceholder?: string;\n    96→  groupByField?: string;\n    97→  columnHeaderClass?: (columnId: string) => string;\n    98→  emptyMessage?: string;\n    99→  filterOptions?: FilterOption[];\n   100→}\n   101→\n   102→function MatrixRow({ row, idx, groupId, groupLabel, columns, getCellValue, displayFn, onRowClick, onCellClick }: MatrixRowProps) {\n   103→  const handleCellClick = useCallback((e: React.MouseEvent, colId: string, value: string) => {\n   104→    if (onCellClick) {\n   105→      e.stopPropagation();\n   106→      onCellClick(row.id, colId, value);\n   107→    }\n   108→  }, [onCellClick, row.id]);\n   109→\n   110→  return (\n   111→    <tr\n   112→      className={`mat-row cm-row ${onRowClick ? 'clickable' : ''}`}\n   113→      onClick={() => onRowClick?.(row.id, row)}\n   114→    >\n   115→      <td className=\"cm-group-col\">\n   116→        {idx === 0 && groupId !== '_ungrouped' ? (\n   117→          <span className=\"cm-group-name\">{groupLabel}</span>\n   118→        ) : null}\n   119→      </td>\n   120→      <td className=\"cm-label-col\">\n   121→        <span className=\"cm-item-label\">{row.label}</span>\n   122→      </td>\n   123→      <td className=\"cm-status-col\">\n   124→        {row.statusBadges?.map((badge, i) => (\n   125→          <span key={i} className={`cm-badge ${badge.variant || ''}`}>\n   126→            {badge.label}\n   127→          </span>\n   128→        ))}\n   129→      </td>\n   130→      {columns.map((col) => {\n   131→        const value = getCellValue(row.id, col.id, row);\n   132→        const display = displayFn(value, row.id, col.id);\n   133→        return (\n   134→          <td\n   135→            key={col.id}\n   136→            className={`cm-cell ${display.className || ''}`}\n   137→            title={display.title}\n   138→            onClick={(e) => handleCellClick(e, col.id, value)}\n   139→          >\n   140→            <span className=\"cm-cell-icon\">{display.icon}</span>\n   141→          </td>\n   142→        );\n   143→      })}\n   144→    </tr>\n   145→  );\n   146→}\n   147→\n   148→export default function CoverageMatrix({\n   149→  rows = [],\n   150→  columns = [],\n   151→  getCellValue,\n   152→  getCellDisplay,\n   153→  onRowClick,\n   154→  onCellClick,\n   155→  title = 'Coverage Matrix',\n   156→  subtitle = '',\n   157→  stats = [],\n   158→  legend = [],\n   159→  searchPlaceholder = 'Search...',\n   160→  groupByField = 'group',\n   161→  columnHeaderClass,\n   162→  emptyMessage = 'No data to display.',\n   163→  filterOptions = [],\n   164→}: CoverageMatrixProps) {\n   165→  const [searchQuery, setSearchQuery] = useState('');\n   166→  const [activeFilter, setActiveFilter] = useState<string | null>(null);\n   167→\n   168→  // Normalize columns to { id, label } format\n   169→  const normalizedColumns = useMemo((): MatrixColumn[] => {\n   170→    return columns.map((col) =>\n   171→      typeof col === 'string' ? { id: col, label: col } : col\n   172→    );\n   173→  }, [columns]);\n   174→\n   175→  // Filter rows by search\n   176→  const filteredRows = useMemo(() => {\n   177→    let result = rows;\n   178→\n   179→    if (searchQuery) {\n   180→      const query = searchQuery.toLowerCase();\n   181→      result = result.filter(\n   182→        (row) =>\n   183→          row.id.toLowerCase().includes(query) ||\n   184→          row.label.toLowerCase().includes(query) ||\n   185→          (row.groupLabel && row.groupLabel.toLowerCase().includes(query))\n   186→      );\n   187→    }\n   188→\n   189→    if (activeFilter && filterOptions.length > 0) {\n   190→      const filterDef = filterOptions.find((f) => f.id === activeFilter);\n   191→      if (filterDef?.filter) {\n   192→        result = result.filter(filterDef.filter);\n   193→      }\n   194→    }\n   195→\n   196→    return result;\n   197→  }, [rows, searchQuery, activeFilter, filterOptions]);\n   198→\n   199→  // Group rows if groupByField is specified\n   200→  const groupedRows = useMemo(() => {\n   201→    if (!groupByField) {\n   202→      return { _ungrouped: { label: '', rows: filteredRows } };\n   203→    }\n   204→\n   205→    const groups: Record<string, { label: string; rows: MatrixRowData[] }> = {};\n   206→    filteredRows.forEach((row) => {\n   207→      const groupId = (row[groupByField] as string) || '_ungrouped';\n   208→      const groupLabel = row.groupLabel || groupId;\n   209→      if (!groups[groupId]) {\n   210→        groups[groupId] = { label: groupLabel, rows: [] };\n   211→      }\n   212→      groups[groupId].rows.push(row);\n   213→    });\n   214→    return groups;\n   215→  }, [filteredRows, groupByField]);\n   216→\n   217→  // Default cell display function\n   218→  const defaultGetCellDisplay = (value: string): CellDisplay => {\n   219→    switch (value) {\n   220→      case 'primary':\n   221→        return { icon: '✓', className: 'primary', title: 'Primary' };\n   222→      case 'secondary':\n   223→        return { icon: '○', className: 'secondary', title: 'Secondary' };\n   224→      case 'both':\n   225→        return { icon: '◉', className: 'both', title: 'Both' };\n   226→      case 'none':\n   227→      default:\n   228→        return { icon: '-', className: 'none', title: 'None' };\n   229→    }\n   230→  };\n   231→\n   232→  const displayFn = getCellDisplay || defaultGetCellDisplay;\n   233→\n   234→  return (\n   235→    <div className=\"mat-layout coverage-matrix\">\n   236→      {/* Header */}\n   237→      <div className=\"cm-header\">\n   238→        <h2 className=\"cm-title\">{title}</h2>\n   239→        {subtitle && <p className=\"cm-subtitle\">{subtitle}</p>}\n   240→      </div>\n   241→\n   242→      {/* Stats Bar */}\n   243→      {stats.length > 0 && (\n   244→        <div className=\"cm-stats\">\n   245→          {stats.map((stat, idx) => (\n   246→            <div key={idx} className={`cm-stat ${stat.variant || ''}`}>\n   247→              <span className=\"cm-stat-value\">{stat.value}</span>\n   248→              <span className=\"cm-stat-label\">{stat.label}</span>\n   249→            </div>\n   250→          ))}\n   251→        </div>\n   252→      )}\n   253→\n   254→      {/* Toolbar */}\n   255→      <div className=\"mat-toolbar cm-toolbar\">\n   256→        <input\n   257→          type=\"text\"\n   258→          className=\"mat-search cm-search\"\n   259→          placeholder={searchPlaceholder}\n   260→          value={searchQuery}\n   261→          onChange={(e) => setSearchQuery(e.target.value)}\n   262→        />\n   263→        {filterOptions.length > 0 && (\n   264→          <div className=\"cm-filters\">\n   265→            {filterOptions.map((filter) => (\n   266→              <button\n   267→                key={filter.id}\n   268→                className={`cm-filter-btn ${activeFilter === filter.id ? 'active' : ''}`}\n   269→                onClick={() =>\n   270→                  setActiveFilter(activeFilter === filter.id ? null : filter.id)\n   271→                }\n   272→              >\n   273→                {filter.label}\n   274→              </button>\n   275→            ))}\n   276→          </div>\n   277→        )}\n   278→      </div>\n   279→\n   280→      {/* Matrix Grid */}\n   281→      <div className=\"mat-scroll-area cm-container\">\n   282→        {(normalizedColumns.length === 0 || rows.length === 0) && (\n   283→          <div className=\"cm-empty\">{emptyMessage}</div>\n   284→        )}\n   285→        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length === 0 && (\n   286→          <div className=\"cm-empty\">No items match the current filters.</div>\n   287→        )}\n   288→        {normalizedColumns.length > 0 && rows.length > 0 && filteredRows.length > 0 && (\n   289→          <table className=\"mat-table cm-table\">\n   290→            <thead>\n   291→              <tr>\n   292→                <th className=\"cm-group-col\">Group</th>\n   293→                <th className=\"cm-label-col\">Name</th>\n   294→                <th className=\"cm-status-col\">Status</th>\n   295→                {normalizedColumns.map((col) => (\n   296→                  <th\n   297→                    key={col.id}\n   298→                    className={`cm-data-col ${columnHeaderClass?.(col.id) || ''}`}\n   299→                    title={col.label}\n   300→                  >\n   301→                    {col.label}\n   302→                  </th>\n   303→                ))}\n   304→              </tr>\n   305→            </thead>\n   306→            <tbody>\n   307→              {Object.entries(groupedRows).map(([groupId, { label: groupLabel, rows: groupRows }]) =>\n   308→                groupRows.map((row, idx) => (\n   309→                  <MatrixRow\n   310→                    key={row.id}\n   311→                    row={row}\n   312→                    idx={idx}\n   313→                    groupId={groupId}\n   314→                    groupLabel={groupLabel}\n   315→                    columns={normalizedColumns}\n   316→                    getCellValue={getCellValue}\n   317→                    displayFn={displayFn}\n   318→                    onRowClick={onRowClick}\n   319→                    onCellClick={onCellClick}\n   320→                  />\n   321→                ))\n   322→              )}\n   323→            </tbody>\n   324→          </table>\n   325→        )}\n   326→      </div>\n   327→\n   328→      {/* Legend */}\n   329→      {legend.length > 0 && (\n   330→        <div className=\"mat-legend cm-legend\">\n   331→          {legend.map((item, idx) => (\n   332→            <span key={idx} className=\"cm-legend-item\">\n   333→              <span className={`cm-cell-icon sample ${item.className || ''}`}>\n   334→                {item.icon}\n   335→              </span>\n   336→              {item.label}\n   337→            </span>\n   338→          ))}\n   339→        </div>\n   340→      )}\n   341→    </div>\n   342→  );\n   343→}\n   344→"}]},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"1ee39977-6def-49e6-be71-09fb3fd03b10"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01WBBUHqzgwwrCfa6J1bvgyU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DntGMi5ijNw1p69GzWequT","name":"Read","input":{"file_path":"/home/tsonu/src/the-canonry/packages/shared-components/src/components/badges/DetailUsageBadges.tsx"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":256,"cache_read_input_tokens":62482,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":256},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"aa6e9f45-617a-46e5-8700-d3e22e300594"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DntGMi5ijNw1p69GzWequT","type":"tool_result","content":"     1→/**\n     2→ * DetailUsageBadges - Context-specific usage badges\n     3→ *\n     4→ * Shows badges indicating which configuration elements reference an item:\n     5→ * - Generators (gen)\n     6→ * - Systems (sys)\n     7→ * - Actions (act)\n     8→ * - Pressures (pres)\n     9→ * - Eras (era)\n    10→ */\n    11→\n    12→import React from 'react';\n    13→\n    14→interface BadgeConfig {\n    15→  label: string;\n    16→  labelPlural?: string;\n    17→  className: string;\n    18→  tooltip: string;\n    19→}\n    20→\n    21→interface DetailUsageBadgesProps {\n    22→  usage?: Record<string, string[]>;\n    23→  showOrphan?: boolean;\n    24→}\n    25→\n    26→// Badge configurations for detail types\n    27→const BADGE_CONFIG: Record<string, BadgeConfig> = {\n    28→  generators: {\n    29→    label: 'gen',\n    30→    className: 'detail-badge-generator',\n    31→    tooltip: 'Referenced by generators',\n    32→  },\n    33→  systems: {\n    34→    label: 'sys',\n    35→    className: 'detail-badge-system',\n    36→    tooltip: 'Referenced by systems',\n    37→  },\n    38→  actions: {\n    39→    label: 'act',\n    40→    className: 'detail-badge-action',\n    41→    tooltip: 'Referenced by actions',\n    42→  },\n    43→  pressures: {\n    44→    label: 'pres',\n    45→    className: 'detail-badge-pressure',\n    46→    tooltip: 'Referenced by pressures',\n    47→  },\n    48→  eras: {\n    49→    label: 'era',\n    50→    labelPlural: 'eras',\n    51→    className: 'detail-badge-era',\n    52→    tooltip: 'Referenced in eras',\n    53→  },\n    54→};\n    55→\n    56→export function DetailUsageBadges({ usage = {}, showOrphan = true }: DetailUsageBadgesProps) {\n    57→  const badges: React.ReactNode[] = [];\n    58→\n    59→  for (const [type, config] of Object.entries(BADGE_CONFIG)) {\n    60→    const items = usage[type];\n    61→    if (items?.length > 0) {\n    62→      const count = items.length;\n    63→      const label = type === 'eras' && count !== 1 ? config.labelPlural : config.label;\n    64→      badges.push(\n    65→        <span\n    66→          key={type}\n    67→          className={`detail-badge ${config.className}`}\n    68→          title={`${config.tooltip}: ${items.join(', ')}`}\n    69→        >\n    70→          {count} {label}\n    71→        </span>\n    72→      );\n    73→    }\n    74→  }\n    75→\n    76→  if (badges.length === 0) {\n    77→    if (showOrphan) {\n    78→      return <span className=\"detail-badge detail-badge-orphan\">Not used</span>;\n    79→    }\n    80→    return null;\n    81→  }\n    82→\n    83→  return <div className=\"detail-badge-container\">{badges}</div>;\n    84→}\n    85→\n    86→export default DetailUsageBadges;\n    87→"}]},"parent_tool_use_id":"toolu_01Q69ZBuaPsjdWi3vG3vJ4Bs","session_id":"e54c7e2e-0d44-4856-a582-afde6e85abbc","uuid":"21f58ae6-204f-4b84-867e-fbfffebc8bef"}
