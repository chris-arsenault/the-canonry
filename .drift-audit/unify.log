{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tzN7ukmVxLfWNrwNBEXEk","type":"tool_result","content":"     1→/**\n     2→ * Button component styles\n     3→ */\n     4→\n     5→/* Base button reset */\n     6→.btn {\n     7→  display: inline-flex;\n     8→  align-items: center;\n     9→  justify-content: center;\n    10→  gap: var(--spacing-md);\n    11→  font-family: inherit;\n    12→  font-size: var(--font-size-md);\n    13→  font-weight: var(--font-weight-medium);\n    14→  border-radius: var(--radius-md);\n    15→  cursor: pointer;\n    16→  transition: all var(--transition-fast);\n    17→  border: none;\n    18→  outline: none;\n    19→}\n    20→\n    21→.btn:disabled {\n    22→  opacity: 0.5;\n    23→  cursor: not-allowed;\n    24→}\n    25→\n    26→/* Primary button (accent gradient) */\n    27→.btn-primary {\n    28→  padding: 10px 16px;\n    29→  background: var(--gradient-accent);\n    30→  color: var(--color-bg-dark);\n    31→}\n    32→\n    33→.btn-primary:hover:not(:disabled) {\n    34→  filter: brightness(1.1);\n    35→}\n    36→\n    37→/* Secondary button */\n    38→.btn-secondary {\n    39→  padding: 10px 16px;\n    40→  background-color: var(--color-bg-card);\n    41→  border: 1px solid var(--color-border);\n    42→  color: var(--color-text-muted);\n    43→}\n    44→\n    45→.btn-secondary:hover:not(:disabled) {\n    46→  border-color: var(--color-accent);\n    47→  color: var(--color-accent);\n    48→}\n    49→\n    50→/* Danger button */\n    51→.btn-danger {\n    52→  padding: 10px 16px;\n    53→  background-color: rgb(239 68 68 / 10%);\n    54→  border: 1px solid var(--color-danger);\n    55→  color: var(--color-danger);\n    56→}\n    57→\n    58→.btn-danger:hover:not(:disabled) {\n    59→  background-color: rgb(239 68 68 / 20%);\n    60→}\n    61→\n    62→/* Icon button */\n    63→.btn-icon {\n    64→  padding: var(--spacing-sm);\n    65→  font-size: var(--font-size-lg);\n    66→  background-color: transparent;\n    67→  border: none;\n    68→  border-radius: var(--radius-md);\n    69→  color: var(--color-text-dim);\n    70→}\n    71→\n    72→.btn-icon:hover:not(:disabled) {\n    73→  background-color: rgb(96 165 250 / 15%);\n    74→  color: var(--color-text-muted);\n    75→}\n    76→\n    77→.btn-icon-danger {\n    78→  color: var(--color-danger);\n    79→}\n    80→\n    81→.btn-icon-danger:hover:not(:disabled) {\n    82→  background-color: rgb(239 68 68 / 15%);\n    83→  color: var(--color-danger);\n    84→}\n    85→\n    86→/* Add item button (dashed border) */\n    87→.btn-add {\n    88→  display: flex;\n    89→  align-items: center;\n    90→  justify-content: center;\n    91→  gap: var(--spacing-md);\n    92→  width: 100%;\n    93→  padding: 14px;\n    94→  font-size: var(--font-size-md);\n    95→  font-weight: var(--font-weight-medium);\n    96→  background-color: transparent;\n    97→  border: 2px dashed var(--color-border);\n    98→  border-radius: var(--radius-xl);\n    99→  color: var(--color-text-dim);\n   100→}\n   101→\n   102→.btn-add:hover:not(:disabled) {\n   103→  border-color: var(--color-accent);\n   104→  color: var(--color-accent);\n   105→  background-color: rgb(245 158 11 / 5%);\n   106→}\n   107→\n   108→/* Close button */\n   109→.btn-close {\n   110→  background: none;\n   111→  border: none;\n   112→  font-size: 24px;\n   113→  color: var(--color-text-dim);\n   114→  padding: 4px 8px;\n   115→  border-radius: var(--radius-sm);\n   116→}\n   117→\n   118→.btn-close:hover {\n   119→  color: var(--color-text);\n   120→  background-color: rgb(255 255 255 / 10%);\n   121→}\n   122→\n   123→/* Tab button */\n   124→.btn-tab {\n   125→  display: flex;\n   126→  align-items: center;\n   127→  gap: 10px;\n   128→  padding: 12px 14px;\n   129→  font-size: var(--font-size-lg);\n   130→  font-weight: var(--font-weight-medium);\n   131→  border: none;\n   132→  border-radius: var(--radius-lg);\n   133→  text-align: left;\n   134→  width: 100%;\n   135→  background-color: transparent;\n   136→  color: var(--color-text-muted);\n   137→}\n   138→\n   139→.btn-tab:hover:not(.btn-tab-active) {\n   140→  background-color: rgb(245 158 11 / 15%);\n   141→  color: var(--color-accent);\n   142→}\n   143→\n   144→.btn-tab-active {\n   145→  background: var(--gradient-accent);\n   146→  color: var(--color-bg-dark);\n   147→}\n   148→\n   149→.btn-tab-icon {\n   150→  font-size: var(--font-size-xl);\n   151→}\n   152→\n   153→/* Category toggle button */\n   154→.btn-toggle-category {\n   155→  display: flex;\n   156→  align-items: center;\n   157→  gap: var(--spacing-sm);\n   158→  font-size: var(--font-size-sm);\n   159→  color: var(--color-text-muted);\n   160→  padding: 4px 10px;\n   161→  border-radius: var(--radius-sm);\n   162→  border: 1px solid var(--color-border);\n   163→  background-color: transparent;\n   164→}\n   165→\n   166→.btn-toggle-category:hover {\n   167→  border-color: var(--color-accent);\n   168→  color: var(--color-accent);\n   169→}\n   170→\n   171→.btn-toggle-category-active {\n   172→  background-color: rgb(34 197 94 / 15%);\n   173→  border-color: var(--color-success);\n   174→  color: var(--color-success);\n   175→}\n   176→\n   177→/* Remove button (text style) */\n   178→.button-remove {\n   179→  padding: 4px 10px;\n   180→  font-size: var(--font-size-sm);\n   181→  font-weight: var(--font-weight-medium);\n   182→  background-color: transparent;\n   183→  border: 1px solid rgb(239 68 68 / 30%);\n   184→  border-radius: var(--radius-md);\n   185→  color: #fca5a5;\n   186→  cursor: pointer;\n   187→  transition: all var(--transition-fast);\n   188→}\n   189→\n   190→.button-remove:hover {\n   191→  background-color: rgb(239 68 68 / 15%);\n   192→  border-color: var(--color-danger);\n   193→  color: var(--color-danger);\n   194→}\n   195→\n   196→/* Micro remove button (for compact constraint cards) */\n   197→.button,\n   198→.button-remove-micro {\n   199→  padding: 2px 8px;\n   200→  font-size: var(--font-size-sm);\n   201→  font-weight: var(--font-weight-medium);\n   202→  background-color: transparent;\n   203→  border: 1px solid var(--color-border);\n   204→  border-radius: var(--radius-sm);\n   205→  color: var(--color-text-dim);\n   206→  cursor: pointer;\n   207→  transition: all var(--transition-fast);\n   208→}\n   209→\n   210→.button-remove-micro:hover {\n   211→  background-color: rgb(239 68 68 / 15%);\n   212→  border-color: var(--color-danger);\n   213→  color: var(--color-danger);\n   214→}\n   215→"}]},"parent_tool_use_id":null,"session_id":"05755054-80c6-4cf5-a504-7682615d2e55","uuid":"7a35345c-373e-4d9d-904b-10738369e4fc","tool_use_result":{"type":"text","file":{"filePath":"/home/tsonu/src/the-canonry/packages/shared-components/src/styles/components/button.css","content":"/**\n * Button component styles\n */\n\n/* Base button reset */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  font-family: inherit;\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n  border: none;\n  outline: none;\n}\n\n.btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n/* Primary button (accent gradient) */\n.btn-primary {\n  padding: 10px 16px;\n  background: var(--gradient-accent);\n  color: var(--color-bg-dark);\n}\n\n.btn-primary:hover:not(:disabled) {\n  filter: brightness(1.1);\n}\n\n/* Secondary button */\n.btn-secondary {\n  padding: 10px 16px;\n  background-color: var(--color-bg-card);\n  border: 1px solid var(--color-border);\n  color: var(--color-text-muted);\n}\n\n.btn-secondary:hover:not(:disabled) {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n/* Danger button */\n.btn-danger {\n  padding: 10px 16px;\n  background-color: rgb(239 68 68 / 10%);\n  border: 1px solid var(--color-danger);\n  color: var(--color-danger);\n}\n\n.btn-danger:hover:not(:disabled) {\n  background-color: rgb(239 68 68 / 20%);\n}\n\n/* Icon button */\n.btn-icon {\n  padding: var(--spacing-sm);\n  font-size: var(--font-size-lg);\n  background-color: transparent;\n  border: none;\n  border-radius: var(--radius-md);\n  color: var(--color-text-dim);\n}\n\n.btn-icon:hover:not(:disabled) {\n  background-color: rgb(96 165 250 / 15%);\n  color: var(--color-text-muted);\n}\n\n.btn-icon-danger {\n  color: var(--color-danger);\n}\n\n.btn-icon-danger:hover:not(:disabled) {\n  background-color: rgb(239 68 68 / 15%);\n  color: var(--color-danger);\n}\n\n/* Add item button (dashed border) */\n.btn-add {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-md);\n  width: 100%;\n  padding: 14px;\n  font-size: var(--font-size-md);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 2px dashed var(--color-border);\n  border-radius: var(--radius-xl);\n  color: var(--color-text-dim);\n}\n\n.btn-add:hover:not(:disabled) {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n  background-color: rgb(245 158 11 / 5%);\n}\n\n/* Close button */\n.btn-close {\n  background: none;\n  border: none;\n  font-size: 24px;\n  color: var(--color-text-dim);\n  padding: 4px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.btn-close:hover {\n  color: var(--color-text);\n  background-color: rgb(255 255 255 / 10%);\n}\n\n/* Tab button */\n.btn-tab {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 14px;\n  font-size: var(--font-size-lg);\n  font-weight: var(--font-weight-medium);\n  border: none;\n  border-radius: var(--radius-lg);\n  text-align: left;\n  width: 100%;\n  background-color: transparent;\n  color: var(--color-text-muted);\n}\n\n.btn-tab:hover:not(.btn-tab-active) {\n  background-color: rgb(245 158 11 / 15%);\n  color: var(--color-accent);\n}\n\n.btn-tab-active {\n  background: var(--gradient-accent);\n  color: var(--color-bg-dark);\n}\n\n.btn-tab-icon {\n  font-size: var(--font-size-xl);\n}\n\n/* Category toggle button */\n.btn-toggle-category {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-sm);\n  font-size: var(--font-size-sm);\n  color: var(--color-text-muted);\n  padding: 4px 10px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--color-border);\n  background-color: transparent;\n}\n\n.btn-toggle-category:hover {\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.btn-toggle-category-active {\n  background-color: rgb(34 197 94 / 15%);\n  border-color: var(--color-success);\n  color: var(--color-success);\n}\n\n/* Remove button (text style) */\n.button-remove {\n  padding: 4px 10px;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 1px solid rgb(239 68 68 / 30%);\n  border-radius: var(--radius-md);\n  color: #fca5a5;\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.button-remove:hover {\n  background-color: rgb(239 68 68 / 15%);\n  border-color: var(--color-danger);\n  color: var(--color-danger);\n}\n\n/* Micro remove button (for compact constraint cards) */\n.button,\n.button-remove-micro {\n  padding: 2px 8px;\n  font-size: var(--font-size-sm);\n  font-weight: var(--font-weight-medium);\n  background-color: transparent;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  color: var(--color-text-dim);\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.button-remove-micro:hover {\n  background-color: rgb(239 68 68 / 15%);\n  border-color: var(--color-danger);\n  color: var(--color-danger);\n}\n","numLines":215,"startLine":1,"totalLines":215}}}
