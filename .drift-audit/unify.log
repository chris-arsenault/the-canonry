ces\n   584→    if (factor.tag) {\n   585→      if (!usageMap.tags[factor.tag]) {\n   586→        usageMap.tags[factor.tag] = { pressures: [], systems: [], generators: [], actions: [] };\n   587→      }\n   588→      usageMap.tags[factor.tag].pressures.push({ id: pressure.id, factor: factor.type });\n   589→    }\n   590→\n   591→    // Track tags array (tag_count factor type)\n   592→    if (factor.tags && Array.isArray(factor.tags)) {\n   593→      factor.tags.forEach(tag => {\n   594→        if (!usageMap.tags[tag]) {\n   595→          usageMap.tags[tag] = { pressures: [], systems: [], generators: [], actions: [] };\n   596→        }\n   597→        usageMap.tags[tag].pressures.push({ id: pressure.id, factor: factor.type });\n   598→      });\n   599→    }\n   600→\n   601→    // Track as feedback source/sink\n   602→    if (usageMap.pressures[pressure.id]) {\n   603→      if (isPositive) {\n   604→        usageMap.pressures[pressure.id].feedbackSources.push(factor);\n   605→      } else {\n   606→        usageMap.pressures[pressure.id].feedbackSinks.push(factor);\n   607→      }\n   608→    }\n   609→  });\n   610→}\n   611→\n   612→function scanPressureReferences(usageMap, pressures, _schema) {\n   613→  (pressures || []).forEach(pressure => {\n   614→    scanFeedbackFactors(usageMap, pressure, pressure.growth?.positiveFeedback, true);\n   615→    scanFeedbackFactors(usageMap, pressure, pressure.growth?.negativeFeedback, false);\n   616→  });\n   617→}\n   618→\n   619→function scanEraReferences(usageMap, eras, generators, systems) {\n   620→  const generatorIds = new Set((generators || []).map(g => g.id));\n   621→  const systemIds = new Set((systems || []).map(s => s.config.id));\n   622→  const pressureIds = new Set(Object.keys(usageMap.pressures || {}));\n   623→\n   624→  (eras || []).forEach(era => {\n   625→    const eraRef = { id: era.id, name: era.name };\n   626→\n   627→    // Track generator references\n   628→    Object.entries(era.templateWeights 